;; BMC / YC 成熟度スコアの **算術の正本**（ADR-2607021700 の rubric、移行は
;; ADR-2608158000）。`kotoba/pure` プロファイル — capability ゼロ、effect ゼロ。
;;
;; 参照実装は `70-tools/bmc/src/gftd/score.cljc` の同名関数群で、CLI・render・
;; allocate はそこを読む。両者が全 case で 1 の位まで一致することを fleet gate
;; `root-score-core` が毎回見る。**食い違ったらこの kernel が正しく、cljc を直す。**
;;
;; ## 何がここに在り、何が cljc に残るか
;;
;; ここに在るのは「値をどう点にするか」だけ —— 次元の算術と、複合スコアの
;; 加重平均。canvas の索引・仮説の列挙・render・投影・allocate は cljc に残る
;; （決定核はスカラと文字列で表せる**判断**に限る、という CLAUDE.md の移行単位）。
;; 反復の順序は host が持ち、算術はすべてここが持つ。
;;
;; ## なぜ整数 basis point か
;;
;; `90-docs/system-dynamics/kotoba/itonami_maturity_kernel.kotoba` と同じ理由で、
;; 同じスケール（**10000 bp = 1.0**、i64）を使う。要点だけ再掲する:
;;
;;   1. f32/f64 の丸めは実行環境依存なので「同じ入力で同じ点数」が runtime を
;;      またいで保証できない。成熟度スコアは公開・監査される数値である。
;;   2. パリティ gate を ε 無しの**完全一致**で書ける。ε 比較は「どこまで
;;      ズレてよいか」を誰かが決めることになり、その判断が検査から漏れる。
;;   3. この kernel は capability ゼロで収まる。i64 と `quot` だけで足りる。
;;
;; さらにこの kernel の側の事情として、**比較が i64 でしかできない**
;; （`<` に `:f64` を渡すと `expression type mismatch: expected i64, got f64` で
;; コンパイルが落ちる。2026-08-15 実測）ので、閾値を持つ `completeness-bp` は
;; そもそも浮動小数では書けない。
;;
;; 除算は `quot`（切り捨て）。**端数は常に下側に倒れる**（甘い側に倒れない）。
;; 0–5 の次元は**その最大値に対する bp** で運ぶ: 5.0 → 10000、2.0 → 4000、
;; 1.5 → 3000。複合スコア（0–100 点）は **1.0 に対する bp**: 100 点 → 10000。
;;
;; ## 加重平均のアキュムレータが pair ではない理由（2026-08-15 実測）
;;
;; maturity kernel は `pair` をアキュムレータにして `acc-init` / `acc-step` /
;; `acc-mean` を持つ。**この kernel では pair をハンドルとして host に返せない。**
;; 実測: `(defn acc-init [] :i64 (pair 0 0))` はコンパイルは通るが、
;; コンパイル済み `:js-kotoba-v1` artifact 経由で呼ぶと戻り値の marshalling が
;; **`invalid-i64` で trap する**（`pair` を関数の *中* で使う分には動く ——
;; 同じ artifact の `(pair-first (pair 4 5))` は 4 を返す）。
;; maturity 側の parity harness が引数ゼロの関数を生成して KIR インタプリタで
;; 回しているのはこのためで、あちらは host にハンドルを渡していない。
;;
;; fleet ノードに kotoba ツールチェーンは無い（配られるのは **この repo の
;; tree だけ**で `orgs/` の amu は入らない）ので、gate は artifact を import して
;; 呼ぶしかない。したがってアキュムレータは **(分子, 分母) の 2 本の i64 に
;; 平坦化**する。意味は maturity の `acc-step` / `acc-mean` と同一 ——
;; 重み付き和と、分母が空なら 0。名前だけが 1 個から 2 個に割れている。
;;
;; ## 測っていない次元を 0 として混ぜない（ADR-2607203000）
;;
;; アキュムレータは**踏んだ次元だけ**分母に入る。0 として混ぜると「測っていない」が
;; 「悪い」に化ける。現行の `score.cljc` は未記録の facts を `(get f k 0)` で
;; 0 点として混ぜており（`render-datoms` が `:dim/recorded?` でそれを申告して
;; いる）、この移行はその挙動を**変えない** —— 直すなら別の決定として直す。
;; ここで言えるのは、この形なら「混ぜない」が書ける、ということだけ。
(ns score-core
  (:export [clamp-bp ratio-bp rubric-bp
            acc-num acc-den acc-mean
            completeness-bp hypothesis-bp status-bp
            design-weight traction-weight]))

;; --- 基本 -------------------------------------------------------------------

(defn clamp-bp [x :i64] :i64
  (if (< x 0) 0 (if (< 10000 x) 10000 x)))

;; 比率を bp に。den<1 なら 0（未測定でなく「分母が無い」）。10000 で頭打ち。
(defn ratio-bp [num :i64 den :i64] :i64
  (if (< den 1) 0 (clamp-bp (quot (* 10000 num) den))))

;; 0–5 の rubric 値を bp に。**引数は 1/10 単位**（5.0 → 50、1.5 → 15）。
;; host が小数を持ち込まずに済ませるための単位で、`status-bp` の 1.5 も
;; これで表せる。50 を超える値は 10000 に張り付く（rubric の上限は 5.0）。
(defn rubric-bp [tenths :i64] :i64
  (clamp-bp (* tenths 200)))

;; --- 加重平均（平坦化アキュムレータ） ---------------------------------------
;; host は num/den を 2 本の i64 として持ち回り、次元 1 つにつき
;; `acc-num` と `acc-den` を 1 回ずつ呼ぶ。重み w は rubric が決める整数。

(defn acc-num [num :i64 v :i64 w :i64] :i64
  (+ num (* v w)))

(defn acc-den [den :i64 w :i64] :i64
  (+ den w))

(defn acc-mean [num :i64 den :i64] :i64
  (if (< den 1) 0 (clamp-bp (quot num den))))

;; --- 複合スコアの重み -------------------------------------------------------
;; YC bench は design 6 次元 50% + traction 3 次元 50%。次元数が 6 対 3 なので、
;; 「traction を 2 倍の重みで加重平均する」と言うのと同じ:
;;
;;   50*(Σd/30) + 50*(Σt/15)          … 0–100 点
;;   = (Σd + 2Σt) / 12                 … 0–5 の平均
;;   = (Σd_bp + 2Σt_bp) / (6*1 + 3*2)  … bp の加重平均
;;
;; BMC は 5 次元の単純平均（重み 1）:
;;
;;   100*(Σ/25) = Σ/5 … 0–100 点は Σ_bp/5 = 5 次元の平均 bp
;;
;; **つまり複合スコアは 2 つとも「次元 bp の加重平均」ちょうどである。**
;; 専用の合成関数を置かないのは、置くと同じ判断の 2 実装ができるため。
(defn design-weight [] :i64 1)

(defn traction-weight [] :i64 2)

;; --- 自動判定の 3 次元 ------------------------------------------------------

;; 9 block が揃い、平均 item 数が薄くないか。5*(blocks/9)、平均 item 数が 2 未満で
;; -1.0、0 で床。bp では ratio-bp(blocks,9) から 2000 を引いて clamp。
;;
;; 平均の判定を割り算でやらない —— `items/blocks < 2` は `items < 2*blocks` と
;; 同値で、後者なら切り捨ての向きを考えなくてよい。blocks=0 のときは
;; `0 < 0` が偽なので減点されないが、`ratio-bp(0,9)` が 0 なので結果は 0 で、
;; 浮動小数版（0 - 1 を max 0 で床）と一致する。
(defn completeness-bp [blocks :i64 items :i64] :i64
  (if (< items (* 2 blocks))
    (clamp-bp (- (ratio-bp blocks 9) 2000))
    (ratio-bp blocks 9)))

;; riskiest 仮説が gate つきで定義されているか。gate 無し=2.0、無定義=0。
;; 件数で受けるのは、host が「gate 付き riskiest が 1 件でもあるか」を
;; bool ではなく数えた結果として渡すため（bare `:bool` 引数は interpreter 側に
;; 既知の穴がある。compiler ADR 0219）。
(defn hypothesis-bp [gated :i64 total :i64] :i64
  (if (< 0 gated) 10000 (if (< 0 total) 4000 0)))

;; 検証状態（ledger fold 済の hyp status）。untested=0 / measuring=1.5 /
;; blocked=0 / moot=0 / refuted=2.0（学習）/ validated=5.0。知らない綴りは 0。
;;
;; measuring は 2026-07-17 追加: gate が機械測定可能で距離を読み続けている状態は
;; untested より前進（計器なしと同じ 0 にするのは不誠実）。validated に届かない
;; 限り 5 には上げない。
;;
;; 文字列の等値は `string=?`。`string=` は `operation has no admitted lowering`
;; になる（2026-08-15 実測）。
(defn status-bp [status :string] :i64
  (if (string=? status "untested") 0
      (if (string=? status "measuring") 3000
          (if (string=? status "blocked") 0
              (if (string=? status "moot") 0
                  (if (string=? status "refuted") 4000
                      (if (string=? status "validated") 10000 0)))))))
