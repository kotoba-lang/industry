;; BMC gate evaluator（ADR-2607022100）が下す **判定そのものの正本**。
;; `kotoba/pure` プロファイル — capability ゼロ、effect ゼロ。
;;
;; ## 何がここに在るか
;;
;; 「測った値と閾値と演算子から、その仮説が validated / measuring / blocked の
;; どれなのか」と「その状態を**もう一度提案してよいか**」だけ。参照実装は
;; `70-tools/bmc/src/gftd/gate.cljc` の同名関数で、両者の完全一致を fleet gate
;; `root-gate-core` が毎回見る（ADR-2608159300）。**食い違ったらこの kernel が
;; 正しく、cljc を直す**
;; （`scripts/kotoba/fabric_actor_core.kotoba` / `manifest/org-id.kotoba` と同じ分担）。
;;
;; ここに無いもの（host に残る）: `gate-specs` という表そのもの、metrics map の
;; `get-in`、canvas item の重複除去、提案 map の組み立て、evidence 文の日本語。
;; 決定核は scalar で表せる**判断**に限る、という CLAUDE.md の移行単位に従う。
;;
;; ## 数の表現 — 整数 basis point（10000 = 1.0）
;;
;; 比較は i64 のみ（`>=` に `:f64` を渡すと `expression type mismatch: expected
;; i64, got f64` でコンパイルが落ちる。2026-08-15 実測）。ところが gate-specs の
;; 閾値は 0.02 / 0.04 / 0.1 / 0.3 / 1.0 という小数である。したがって **host が
;; 測定値と閾値の両方を bp へスケールしてから**ここへ渡す。スケール規約は
;; `90-docs/system-dynamics/kotoba/itonami_maturity_kernel.kotoba` と同じ
;; 10000 = 1.0。この kernel は除算をしないので `quot` の切り捨て規則は現れない。
;;
;; ## 欠測を 0 にしない（ADR-2608136000）
;;
;; 「測れなかった」を 0 bp として渡すと、`>= 0.02` の gate では **落第として
;; 測定済み**に見え、`>= 0`（`:hyp/nexus-x402-agent-demand` は `:> 0`）の gate
;; では**合格**に見える。どちらも「測れなかった」とは読めない。so:
;;
;;   - 値は `[-9000000000000000, 9000000000000000]` の閉区間だけを admit する。
;;   - 範囲外は **absent**（欠測）として扱い、判定は `blocked` になる。
;;   - host は測れなかった欄に `absent-bp`（= -9007199254740991 =
;;     JS の `Number.MIN_SAFE_INTEGER`）を入れる。実在の値と衝突しない。
;;
;; **なぜ 2^53-1 なのか。** host は cljs でも動き、そこでは i64 が JS の
;; double を経由する。2^53 を超える整数は正確に往復しないので、admit する幅も
;; 番兵もそこに収める（ADR-2608122000 が数える host↔guest 非対称の一種で、
;; JVM だけ緑になる形の穴を最初から塞いでおく）。
;;
;; ## 「答えられなかった」を 0 でも 1 でもない値にする
;;
;; 演算子コードが 1..5 のどれでもないとき、この kernel は `-2` を返す。
;; `blocked`(0) と綴ると **spec の打ち間違いが「計器が無い」に化ける**。
;; host は -2 を受け取ったら例外にする（既存の `case` が未知の op で
;; IllegalArgumentException を投げていたのと同じ扱い）。
;;
;; ## 実測した言語側の制約
;;
;; - arity 上限 5（`:intentional-security-constraint`）。ここは最大 3。
;; - `and` / `or` は i64 を返すので短絡は入れ子の `if` で書く。
;; - `throw` / `try` は使えない。だから戻り値のコードで区別する。
(ns gate-core
  (:export [op-ge op-gt op-le op-lt op-eq
            code-unanswerable code-absent code-unmet code-met
            verdict-blocked verdict-measuring verdict-validated
            status-untested status-measuring status-validated
            absent-bp max-abs-bp value-admitted
            clause-code code-verdict clause-verdict
            all-init all-step all-verdict
            should-propose]))

;; --- 語彙（host と共有する数。片方だけ変えると gate が落ちる） ---------------

;; 演算子。`gate-specs` の `:op` を host が引く表の値と 1 対 1。
;; `:=` と `:==` はどちらも `op-eq` —— 参照実装の `op-fn` が両方 `==` に
;; 落としていたのを、そのまま写している。
(defn op-ge [] :i64 1)
(defn op-gt [] :i64 2)
(defn op-le [] :i64 3)
(defn op-lt [] :i64 4)
(defn op-eq [] :i64 5)

;; 1 節の判定結果。**-2 と -1 を分けているのが要点** —— 前者は「問いを立てられ
;; なかった」、後者は「問いは立ったが測れなかった」。
(defn code-unanswerable [] :i64 -2)
(defn code-absent [] :i64 -1)
(defn code-unmet [] :i64 0)
(defn code-met [] :i64 1)

;; 仮説の判定。host 側の `:blocked` / `:measuring` / `:validated` と 1 対 1。
(defn verdict-blocked [] :i64 0)
(defn verdict-measuring [] :i64 1)
(defn verdict-validated [] :i64 2)

;; 仮説が既に持っている状態の順位。**この 3 つは全順序**であり、再提案規則は
;; その上の単調性でしかない（下記 `should-propose`）。
(defn status-untested [] :i64 0)
(defn status-measuring [] :i64 1)
(defn status-validated [] :i64 2)

;; --- 欠測 -------------------------------------------------------------------

;; host が「その欄を数にできなかった」ことを渡す番兵。nil・非数値・NaN・
;; ±Inf・admit 範囲外は全部これになる。
(defn absent-bp [] :i64 -9007199254740991)

(defn max-abs-bp [] :i64 9000000000000000)

;; 比較してよい値か。**番兵と等しいかだけを見ない** —— 範囲外の値はどれも
;; 信用しない。番兵が 1 つ増えても、host の丸めが暴走しても、ここで止まる。
(defn value-admitted [x :i64] :i64
  (if (< x (- 0 (max-abs-bp)))
    0
    (if (< (max-abs-bp) x) 0 1)))

;; --- 1 節の判定 --------------------------------------------------------------

;; `lhs op rhs`。**節（measured vs threshold）と cross-metric 比較（lhs vs rhs）は
;; 同じ判断**なので関数を分けない —— 分ければ、片方だけ直る 2 実装をこの kernel の
;; 中に作ることになる。違うのは host 側の「数をどこから読むか」だけ。
;;
;; `>=` を `(if (< lhs rhs) 0 1)` と書いているのは `<` と `=` しか使わないため。
;; 境界（lhs = rhs）で `>=` は 1、`>` は 0 になる —— そこが両者の唯一の差で、
;; case 表はそこを名指しで踏む。
(defn clause-code [lhs :i64 op :i64 rhs :i64] :i64
  (if (< (value-admitted lhs) 1)
    -1
    (if (< (value-admitted rhs) 1)
      -1
      (if (= op 1)
        (if (< lhs rhs) 0 1)
        (if (= op 2)
          (if (< rhs lhs) 1 0)
          (if (= op 3)
            (if (< rhs lhs) 0 1)
            (if (= op 4)
              (if (< lhs rhs) 1 0)
              (if (= op 5)
                (if (= lhs rhs) 1 0)
                -2))))))))

;; 節の結果 → 仮説の判定。met なら validated、未達なら measuring、欠測なら
;; blocked。それ以外（-2 や、host が壊れて渡してきた未知のコード）は -2 ——
;; **既定を blocked にしない**。未知のコードを「計器が無い」と綴ると、
;; seam が壊れたことが運用上ふつうの状態に化ける。
(defn code-verdict [c :i64] :i64
  (if (= c 1)
    2
    (if (= c 0)
      1
      (if (= c -1) 0 -2))))

(defn clause-verdict [lhs :i64 op :i64 rhs :i64] :i64
  (code-verdict (clause-code lhs op rhs)))

;; --- `:all`（節の連言） ------------------------------------------------------
;;
;; アキュムレータは判定コードそのもの（i64）。pair を使わないのは、compile 済み
;; artifact では **1 呼び出し 1 instance** でハンドルが跨げないため（fuel は
;; instance ごとに尽きる）。i64 なら host が持ち回れる。
;;
;; 吸収順は **-2 > blocked > measuring > validated**。
;; 参照実装の `(some #(not (:measurable %)) rs)` が `every? :met` より先に
;; 効くのと同じ順序で、1 節でも欠測なら他が全部達していても blocked。

(defn all-init [] :i64 2)

(defn all-step [acc :i64 c :i64] :i64
  (if (= acc -2)
    -2
    (if (= c -2)
      -2
      (if (= acc 0)
        0
        (if (= c -1)
          0
          (if (= c 0) 1 acc))))))

;; **節が 0 本の `:all` を validated と綴らない。** 参照実装は
;; `(every? :met [])` = true でそのまま validated を返していた —— 節を書き忘れた
;; spec が「機械測定で gate 到達」として ledger に昇格 event を積む形である。
;; 今日の gate-specs に空の `:all` は無いので現れないが、evidence floor を
;; 判定に当てたもの（ADR-2608136000）として塞いでおく。
(defn all-verdict [acc :i64 n :i64] :i64
  (if (< n 1) 0 acc))

;; --- 再提案規則 --------------------------------------------------------------

;; 「既に持っている状態を、もう一度提案しない」。参照実装では
;; `(when (not= :validated (:hyp/status h)) …)` と
;; `(when (and (not= :measuring …) (not= :validated …)) …)` の 2 本の条件だった。
;; 状態が untested < measuring < validated の全順序なので、**両方とも
;; 「順位が上がるときだけ提案する」1 つの規則**に畳める。
;;
;; これが無いと gate 到達後の毎日の run が同じ昇格 event を ledger に積み続け、
;; loop が収束しない（2026-07-15 cloud-murakumo で実測した production 欠陥）。
(defn should-propose [current :i64 proposed :i64] :i64
  (if (< current proposed) 1 0))
