;; BMC の sales/marketing funnel が使う **転換率とボトルネック判定の算術の正本**。
;; ADR-2608160500。`kotoba/pure` プロファイル — capability ゼロ、effect ゼロ。
;;
;; ## なぜ切り出したか
;;
;; `70-tools/bmc/src/gftd/funnel.cljc` の `evaluate-funnel` は、日次 routine
;; （`bmc-business-operate-daily`）が「どの段が伸びていないか」を決めるのに
;; 使う判断そのものである。段の並べ方・metrics の掘り方・提案 map の組み立ては
;; コレクションの仕事なので `.cljc` に残し、**スカラで表せる判断だけ**をここへ
;; 移した（CLAUDE.md の「移行の単位は決定核」）。
;;
;; ここに在るのは:
;;
;;   - 1 段の転換率（今の段の件数 ÷ 前の段の件数）
;;   - その率と段の benchmark との差
;;   - どの段がボトルネックか（測れていて、benchmark から最も下に離れている段）
;;     と、同点のときどちらを採るか
;;   - そもそもその段が測れているか
;;
;; ここに無いのは: `funnel-specs` 表・段ベクタの走査・`get-in`・提案 map・
;; canvas の重複除去・コレクションを要する文字列整形。参照実装は
;; **`gftd.funnel` そのもの**で、別名前空間の mirror は作らない
;; （CLAUDE.md「同じ判断を 2 実装が別々に持ち片方だけ直る状態にしない」）。
;;
;; **食い違ったら kernel が正しい。`.cljc` を直す。** 両者の完全一致は fleet gate
;; `root-funnel-core` が毎回見る。
;;
;; ## なぜ整数 basis point か
;;
;; 理由は `90-docs/system-dynamics/kotoba/itonami_maturity_kernel.kotoba` の
;; 冒頭に書いてあるものと同じ（丸めが実行環境依存だと同じ入力で同じ答えを
;; runtime をまたいで保証できない／パリティを ε 無しの完全一致で書ける）。
;; **語彙もそちらに合わせる**: スケールは `10000 = 1.0`、除算は `quot`
;; （切り捨て、端数は常に下側 = 甘い側に倒れない）、`clamp-bp` は同じ意味。
;;
;; ただし **`conversion-bp` は `ratio-bp` ではない**。`ratio-bp` は 10000 で
;; 頭打ちにするが、転換率は 10000 bp を超えることが実際に起きる —— 後段の
;; emitter が前段より多く数えるとき（別窓・別重複排除・別タイムゾーン）である。
;; そこで頭打ちにすると **emitter どうしが食い違っているという信号が消えて**
;; 「ちょうど 100%、健全」に見える。だから clamp しない。
;;
;; ## 測れなかったことを 0 と綴らない（ADR-2608136000）
;;
;; 2 つとも「測れなかったものが、測って問題が無かったものと同じ値になる」形。
;; **どちらもボトルネック選択の挙動を変えてはいない**（移行前も候補にならなかった）
;; —— 変えたのは、それが *出力で区別できる* ようになったことである。誇張しない。
;;
;;   1. **前段が 0 件なのは 0% の転換ではない。分母が無い。** 前は
;;      `(when (and fc tc (pos? fc)) …)` で率が nil になり、`render-text` の
;;      綴りでは「未計測」（計器がそもそも無い段）と**同じ文字列**になっていた。
;;      ここでは `step-measured?` と `rate-known?` を別の述語に分け、
;;      `conversion-bp` は `(absent)` を返す —— 0 bp（測って 0%）とは別の値。
;;      「この段が見えない」が「この段が最悪だ」と読まれると、日次 loop は
;;      計器の穴を成長の問題として追いかけることになる。
;;   2. **benchmark を持たない段には gap が無い。** 0 に既定しない。funnel の
;;      先頭段（awareness）は前段を持たないので benchmark も持たず、gap 0 は
;;      「ちょうど目標どおり」という**実在の**答えである。`gap-bp` は
;;      `(gap-absent)` を返し、`bottleneck-wins?` はそれを候補にしない。
;;      移行前の double 経路もここは正しかった（nil を返していた）。bp への
;;      書き換えで 0 が魅力的な既定値になるので、番兵を分けて固定した。
;;
;; 挙動として実際に直ったのは host 側の 1 件で、**負の件数を数として扱わない**
;; こと（`gftd.funnel/count->bp-input`）。emitter が -1 を「不明」の意味で出すと、
;; 以前はそれが率と gap に流れ込んでその段をボトルネックに仕立てていた。
;;
;; ## 番兵の値
;;
;;   件数 / benchmark  … 負値が「host がそれを読めなかった」。件数にも
;;                       benchmark bp にも負は無いので実在の値と衝突しない。
;;                       正準値は `(absent)` = -1。
;;   gap               … `(gap-absent)` = -100000。実在の gap は
;;                       `[-10000, ∞)` に収まる（率は 0 以上、benchmark は
;;                       `clamp-bp` で 10000 以下）ので、この値は作れない。
;;                       **0 と区別できる必要があるので 0 は使えない**（上記 2）。
;;
;; ## 実測した言語側の制約（2026-08-15、この pin での話）
;;
;; - **比較・算術は i64 のみ。** `>=` に `:f64` を渡すと
;;   `expression type mismatch: expected i64, got f64` でコンパイルが落ちる。
;;   これは backend 未達ではなく、bp を選んだ理由そのもの（上記）。
;; - **arity 上限 5**（`:abi-bound`、`:intentional-security-constraint`）。
;;   ここで一番引数が多いのは 3 なので効いていない。
;; - bool は型。`and`/`or` は i64 を返しうるので **短絡は入れ子の `if`** で書く
;;   （`:intentional-semantic-simplification`）。
;; - `throw` / `try` は使わない（`:intentional-security-constraint`）。この
;;   kernel は全域関数なので `[:result T E]` も要らない —— 「答えられない」は
;;   番兵で綴る。
(ns funnel-core
  (:export [absent gap-absent clamp-bp
            measured? denominator? step-measured? rate-known?
            conversion-bp
            benchmark-known? benchmark-bp
            gap-known? gap-bp below-benchmark?
            bottleneck-wins?
            pct-bp]))

;; --- 番兵 -------------------------------------------------------------------
;; 0 引数の関数にしてあるのは、host も gate も **この値をここから読む**ため。
;; どちらかが -1 を自分で書いた瞬間に、番兵が 2 箇所に住むことになる。

(defn absent [] :i64 -1)

(defn gap-absent [] :i64 -100000)

;; --- 基本 -------------------------------------------------------------------
;; maturity kernel と同じ意味・同じ名前。

(defn clamp-bp [x :i64] :i64
  (if (< x 0) 0 (if (< 10000 x) 10000 x)))

;; --- 測れているか -----------------------------------------------------------

;; 件数として読めたか。負値は「host がその段を読めなかった」。
(defn measured? [n :i64] :bool
  (if (< n 0) false true))

;; 分母として使えるか。**0 件は分母にならない** —— 「0 件から 0 件へ 0% 転換
;; した」ではなく「率を出す材料が無い」。
(defn denominator? [from :i64] :bool
  (if (< from 1) false true))

;; 両端の件数が読めたか。`.cljc` の `:measurable` に対応する。
(defn step-measured? [from :i64 to :i64] :bool
  (if (measured? from) (measured? to) false))

;; 率を出せるか。**測れていること**と**分母があること**は別の条件で、
;; 出力でも区別する（前者は `step-measured?`、後者は `denominator?`）。
(defn rate-known? [from :i64 to :i64] :bool
  (if (step-measured? from to) (denominator? from) false))

;; --- 転換率 -----------------------------------------------------------------

;; **clamp しない**（冒頭の理由）。10000 bp 超は emitter の食い違いの信号。
(defn conversion-bp [from :i64 to :i64] :i64
  (if (rate-known? from to)
    (quot (* 10000 to) from)
    (absent)))

;; --- benchmark --------------------------------------------------------------

(defn benchmark-known? [b :i64] :bool
  (if (< b 0) false true))

;; 宣言された benchmark を 0..10000 に収める。**不在の判定を先に済ませてから**
;; clamp する —— 先に clamp すると `-1`（不在）が `0`（目標 0%）になり、
;; 「benchmark が無い」が「どんな率でも達成」に化ける。
;; 上限を掛けておくことで gap の下限が -10000 に固定され、`gap-absent` が
;; 到達不能であることが保証される。
(defn benchmark-bp [b :i64] :i64
  (if (benchmark-known? b) (clamp-bp b) (absent)))

;; --- gap --------------------------------------------------------------------

(defn gap-known? [from :i64 to :i64 bench :i64] :bool
  (if (rate-known? from to) (benchmark-known? bench) false))

;; 率 − 目標。負なら目標未達。**不在は 0 ではない**（冒頭 2）。
(defn gap-bp [from :i64 to :i64 bench :i64] :i64
  (if (gap-known? from to bench)
    (- (conversion-bp from to) (benchmark-bp bench))
    (gap-absent)))

;; ちょうど一致（gap = 0）は未達ではない。`.cljc` の `(neg? gap)` と同じ。
(defn below-benchmark? [from :i64 to :i64 bench :i64] :bool
  (if (gap-known? from to bench)
    (< (gap-bp from to bench) 0)
    false))

;; --- ボトルネックの畳み込み -------------------------------------------------

;; 候補 `cand` が現職 `best` を置き換えるか。host は段を先頭から順に回し、
;; 現職の gap（最初は `(gap-absent)`）とこれで比べる。
;;
;; **同点は候補が勝つ = 後ろの段が勝つ。** これは `.cljc` が使っていた
;; Clojure の `min-key` の挙動と同じで、`min-key` は等しいキーのとき
;; **最後**の要素を返す（2 引数版は `(if (< (k x) (k y)) x y)`、3 引数以上は
;; ループ内が `<=`。2026-08-15 に nbb で実測）。移行で暗黙に反転させないよう
;; ここに書いておく。
(defn bottleneck-wins? [cand :i64 best :i64] :bool
  (if (< (gap-absent) cand)          ;; 候補が実在の gap か
    (if (< cand 0)                   ;; かつ目標未達か
      (if (< (gap-absent) best)      ;; 現職が居るか
        (if (< best cand) false true) ;; cand <= best なら勝つ（同点は候補）
        true)                        ;; 現職が居ないので無条件に勝つ
      false)
    false))

;; --- 表示用の丸め -----------------------------------------------------------

;; bp → パーセント（四捨五入、`Math/round` と同じ half-up）。ここに置くのは、
;; 切り捨てた bp から出す丸めと、元の double から出す丸めが**別の答えを出しうる**
;; ため —— 規則を 1 箇所に持たないと、gate が見ていない側でズレる。
;; 不在は不在のまま返す（`0%` と綴らない）。
(defn pct-bp [bp :i64] :i64
  (if (< bp 0) (absent) (quot (+ bp 50) 100)))
