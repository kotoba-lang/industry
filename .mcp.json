{
  "mcpServers": {
    "cloud-itonami-license": {
      "type": "stdio",
      "command": "nbb",
      "args": [
        "--classpath",
        "orgs/gftdcojp/cloud-itonami/src:orgs/kotoba-lang/kyoninka/src:orgs/kotoba-lang/org-anthropic-mcp/src",
        "orgs/gftdcojp/cloud-itonami/scripts/mcp-server.cljs"
      ],
      "env": {}
    },
    "cloud-itonami-app": {
      "type": "stdio",
      "command": "/bin/sh",
      "args": [
        "-c",
        "cd \"$HOME/.cloud-itonami/app\" && exec clojure -M:mcp"
      ],
      "env": {
        "CLOUD_ITONAMI_DATA_DIR": "/Users/junkawasaki/.cloud-itonami/data"
      }
    }
  }
}
