{:deployment-metadata
 {:project "kotoba-server strangler-fig migration"
  :phase "Phase 1: Staging & Parallel-Run"
  :duration-weeks 4
  :timeline-start "2026-07-20"
  :timeline-end "2026-08-17"
  :adr-reference "ADR-2607072100"
  :status "ACTIVE"
  :owner "Jun Kawasaki"
  :contact-email "jun@gftd.group"}

 :infrastructure-deployed
 {:staging-pool
  {:name "staging-cljc-month1"
   :node-count 3
   :node-names ["staging-cljc-1" "staging-cljc-2" "staging-cljc-3"]
   :runtime "chicory"
   :guest-language "kotoba"
   :scope "drama-profile (Phase 1 only)"
   :hardware "Mac-mini (same as prod)"
   :network-isolation "staging gossipsub topic (no cross-prod)"
   :status "provisioned"}

  :http-routes
  [{:method "GET"
    :path "/health"
    :response-type "json"
    :description "Node health check endpoint"}
   {:method "POST"
    :path "/mesh/http/drama-profile"
    :guest-app "drama.profile"
    :entrypoint "drama-profile-handler"
    :description "Drama-profile request handler (canary target)"}]

  :traffic-split
  {:prod-rust {:pool-name "prod"
               :nodes 9
               :traffic-percent 95
               :status "existing"}
   :staging-cljc {:pool-name "staging"
                  :nodes 3
                  :traffic-percent 5
                  :status "new"}}

  :murakumo-integration
  {:route-dispatch "murakumo.route-dispatch/drama-profile-canary"
   :node-discovery "murakumo fleet-db.edn"
   :health-checks "enabled"
   :metrics-export "murakumo.metrics-ingest"}}

 :deployed-services
 {:parity-checker
  {:script "deploy/parity-checker-service.cljs"
   :purpose "Compare Rust vs cljc responses (bit-exact, semantic)"
   :capabilities
   ["hash-based-comparison"
    "http-status-identity"
    "kgraph-datom-equivalence"
    "latency-tracking"
    "automatic-divergence-detection"]
   :metrics-exported
   ["parity.success_rate"
    "parity.divergence_detected"
    "parity.latency_delta"
    "parity.hash_mismatch_rate"]
   :sample-rate 1.0
   :output-file "metrics/parity-validation.log"
   :status "ready-to-run"}

  :rollback-automation
  {:script "deploy/rollback-automation.cljs"
   :purpose "Autonomous SLO enforcement with automatic revert"
   :triggers
   [{:id "latency-regression"
     :metric "p99_latency_ms"
     :threshold-ms 250
     :sustained-sec 300
     :action "partial-revert"}
    {:id "parity-divergence"
     :metric "parity_divergence_count"
     :threshold-count 1
     :sustained-sec 60
     :action "full-revert"}
    {:id "reliability-degradation"
     :metric "http_5xx_rate_pct"
     :threshold-pct 1.0
     :sustained-sec 120
     :action "full-revert"}
    {:id "memory-exhaustion"
     :metric "jvm_heap_peak_mb"
     :threshold-mb 512
     :sustained-sec 30
     :action "partial-revert"}]
   :audit-log "metrics/rollback-audit.log"
   :status "ready-to-run"}

  :metrics-collector
  {:prometheus-targets
   [{:name "staging-pool"
     :endpoint "localhost:9090/metrics"
     :scrape-interval-sec 15}
    {:name "prod-pool"
     :endpoint "localhost:9091/metrics"
     :scrape-interval-sec 15}]
   :metrics-tracked
   ["http_request_latency_ms"
    "http_request_throughput_per_sec"
    "jvm_heap_usage_bytes"
    "jvm_gc_pause_ms"
    "parity_check_result"
    "http_5xx_rate_pct"]
   :baseline-window-days 14
   :status "configured"}

  :slo-dashboard
  {:name "Strangler-Fig Month 1 SLO"
   :endpoint "http://localhost:3000/d/strangler-fig-month1"
   :refresh-interval-sec 10
   :panels 10
   :config-file "deploy/slo-dashboard-config.edn"
   :status "ready"}}

 :slo-targets-month-1
 {:p50-latency-ms
  {:target 80
   :phase-1-budget 80
   :note "baseline ~60ms + 20ms"}

  :p95-latency-ms
  {:target 120
   :phase-1-budget 120
   :note "accept 5% variance in traffic"}

  :p99-latency-ms
  {:target 150
   :phase-1-budget 150
   :note "hard budget: baseline(100) + 50ms overhead"}

  :parity-pass-rate-pct
  {:target 99.99
   :phase-1-budget 99.99
   :note "≤0.01% divergence allowed"}

  :http-5xx-rate-pct
  {:target 0.01
   :phase-1-budget 0.01
   :note "unhandled exceptions"}

  :jvm-heap-peak-mb
  {:target 256
   :phase-1-budget 256
   :note "post-GC stable, <512MB peak"}

  :jvm-gc-pause-p99-ms
  {:target 50
   :phase-1-budget 50
   :note "ZGC/Shenandoah evaluation Month 2"}

  :throughput-loss-pct
  {:target 2.0
   :phase-1-budget 2.0
   :note "staging vs prod baseline"}}

