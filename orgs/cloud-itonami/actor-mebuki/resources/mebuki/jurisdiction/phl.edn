  :instrument/insurance {:en "Very low household penetration; some parametric and microinsurance schemes" :status :unverified-in-repo}
  :instrument/volunteer-coordination {:en "Barangay disaster committees, Philippine Red Cross, church networks, and the humanitarian cluster system where activated"}
  :instrument/waste-plan {:en "Local solid waste management boards; capacity is routinely exceeded"}
