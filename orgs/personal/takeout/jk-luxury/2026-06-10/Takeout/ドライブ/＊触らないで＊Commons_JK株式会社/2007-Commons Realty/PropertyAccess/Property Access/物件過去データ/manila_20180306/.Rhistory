#####Machine Learning
###############################################################################
library(rpart)
library(nnet)
options(warn=-1)
ptable <- table(as.character(manila2$province))
plist <- names(ptable[ptable>8])
lm.res <- list()
rp.res <- list()
nn.res <- list()
for(jj in 1:length(plist)){
tmpdata <- manila2[manila2$province==plist[jj],]
print(plist[jj])
model_formula <- "lpp~ls+bedrooms+bathrooms+longitude+latitude+lon2+lat2+lon3+lat3"
lm.res[[jj]] <- lm(model_formula,data=tmpdata)
print(summary(lm.res[[jj]])$adj.r.squared)
rp.res[[jj]] <- rpart(model_formula,data=tmpdata,cp=0.003449994)
invisible(capture.output(
nn.res[[jj]] <- nnet(lpp~ls+bedrooms+bathrooms+longitude+latitude+lon2+lat2+lon3+lat3,data=tmpdata,size=3,linout=T,decay=0.1)
))
}
tdata <- read.csv("./building-all_addls.csv")
tdata <- data.frame(tdata,lon2=tdata$longitude**2,lat2=tdata$latitude**2)
tdata <- data.frame(tdata,lon3=tdata$longitude**3,lat3=tdata$latitude**3)
plist2 <- unique(sort(tdata$province))
province <- intersect(plist,plist2)
for(jj in 1:length(province)){
print(jj)
tmpdata <- tdata[tdata$province==province[jj],]
tmp <- which(plist==province[jj])
#  predictlist <- cbind(exp(predict(lm.res[[tmp]],tmpdata)),exp(predict(rp.res[[tmp]],tmpdata)),exp(predict(nn.res[[tmp]],tmpdata)))
predictlist <- cbind(exp(predict(lm.res[[tmp]],tmpdata)),exp(predict(rp.res[[tmp]],tmpdata)),exp(predict(nn.res[[tmp]],tmpdata)))
tmpdata <- cbind(tmpdata,predictlist)
if(jj==1){
data <- tmpdata
}else{
data <- rbind(data,tmpdata)
}
}
colnames(data)[19] <- "lm.predict"
colnames(data)[20] <- "rp.predict"
colnames(data)[21] <- "nn.predict"
data <- cbind(data,data$rp.predict/data$lm.predict)
data <- cbind(data,data$nn.predict/data$lm.predict)
colnames(data)[22] <- "rp/lm"
colnames(data)[23] <- "nn/lm"
write.csv(data,"./output/buildings-predict.csv")
