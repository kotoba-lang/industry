manila2 <- data.frame(manila2,lon2=manila2$longitude**2,lat2=manila2$latitude**2)
manila2 <- data.frame(manila2,lon3=manila2$longitude**3,lat3=manila2$latitude**3)
###############################################################################
###############################################################################
###############################################################################
#####Machine Learning
###############################################################################
library(rpart)
library(nnet)
options(warn=-1)
plist <- unique(sort(as.character(manila2$province)))
meanlist <- NULL
itr <- 500
for(jj in 1:length(plist)){
tmpdata <- manila2[manila2$province==plist[jj],]
print(plist[jj])
if(dim(tmpdata)[1]>8){
for(ii in 1:itr){
print(ii)
sn <- sample(1:dim(tmpdata)[1],dim(tmpdata)[1]*0.8,replace=F)
training <- tmpdata[sn,]
test <- tmpdata[-sn,]
model_formula <- "lpp~ls+bedrooms+bathrooms+longitude+latitude+lon2+lat2+lon3+lat3"
lm.res <- lm(model_formula,data=training)
rp.res <- rpart(model_formula,data=training,cp=0.003449994)
invisible(capture.output(
nn.res <- nnet(lpp~ls+bedrooms+bathrooms+longitude+latitude+lon2+lat2+lon3+lat3,data=training,size=3,linout=T,decay=0.1)
))
lm.predict <- predict(lm.res,test)
rp.predict <- predict(rp.res,test)
nn.predict <- predict(nn.res,test)
test <- data.frame(test,lm.predict,rp.predict,nn.predict)
if(ii==1){
lm.err <- exp(test$lm.predict)/exp(test$lpp)
rp.err <- exp(test$rp.predict)/exp(test$lpp)
nn.err <- exp(test$nn.predict)/exp(test$lpp)
compare.err <- c(mean(lm.err),mean(rp.err),mean(nn.err))
}else{
lm.err <- exp(test$lm.predict)/exp(test$lpp)
rp.err <- exp(test$rp.predict)/exp(test$lpp)
nn.err <- exp(test$nn.predict)/exp(test$lpp)
compare.err <- rbind(compare.err,
c(mean(lm.err),mean(rp.err),mean(nn.err)))
}
}
compare.err <- rbind(compare.err)
colnames(compare.err) <- c("OLS","RT","NN")
rownames(compare.err) <- c(paste("sample:",1:itr,sep=""))
outfilename <- paste("./output/comparelist_",plist[jj],".csv",sep="")
write.csv(compare.err,outfilename)
#OUTPUT PDF:Error Ratio
outfilename <- paste("./output/ErrorRatio_",plist[jj],".pdf",sep="")
pdf(outfilename,family="Japan1GothicBBB")
hist(lm.err,main="linear regression:error ratio")
#      abline(a=0,b=1,col="blue")
hist(rp.err,main="regression tree:error ration")
#      abline(a=0,b=1,col="blue")
hist(nn.err,main="neural network:error ration")
#      abline(a=0,b=1,col="blue")
boxplot(lm.err,rp.err,nn.err,names=c("lm","rpart","nn"))
dev.off()
#OUTPUT PDF:Compare Result
outfilename <- paste("./output/Compare_result_",plist[jj],".pdf",sep="")
pdf(outfilename,family="Japan1GothicBBB")
boxplot(compare.err,main="boxplot of error ration average")
dev.off()
}
}
