# Note we depend on NODE_ENV being set to dictate which of the env variables below get loaded at runtime.
# See README for more details.

APP_ENV=development
PORT=3000

DB_TYPE=mysql
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=secret
DB_DATABASE=antiblock-demo
DB_PORT=3306

# Network table initialization
NETWORK_OWNER=0xfb3cd9f19483dc204e4412f933f7BF4583171D62
CHAIN_NAME=antiblock
CHAIN_ID=4329815
HARDFORK=istanbul
CHAIN_START_TIME=102233000
BLOCK_INTERVAL=1000

# Block & Checkpoint interval
CHECKPOINT_INTERVAL=10
BLOCK_PRODUCING_INTERVAL=1000
CHECKPOINT_PRODUCING_INTERVAL=1000
CHECKPOINT_TX_WAIT_INTERVAL=5000
CHECKPOINT_TX_MAX_WAIT_TIME=30000

# Gas table initialization
GAS_CREATE_TOKEN=1
GAS_MINT_TOKEN=1
GAS_BURN_TOKEN=1
GAS_TRANSFER_TOKEN=1
GAS_CREATE_KVS=1
GAS_SET_KEY_VALUE=1
GAS_DELETE_KEY_VALUE=1
MIN_GAS_PRICE=10

# Native token
NATIVE_TOKEN_NAME=BURN
NATIVE_TOKEN_SYMBOL=burn
NATIVE_TOKEN_ICON=http://etherscan.io/token/images/vechain_28.png
NATIVE_TOKEN_DECIMALS=1
NATIVE_TOKEN_INITIAL_SUPPLY=300000000000000000000000
NATIVE_TOKEN_MINTABLE=0
NATIVE_TOKEN_BURNABLE=0
INITIAL_HOLDER_AMOUNT=100000000000000000000000
INITIAL_BALANCE_HOLDERS=0xfb3cd9f19483dc204e4412f933f7BF4583171D62,0x6bf03812728e08efd88eee2383bd155fd636cd6b,0x81bd529e555244e41adf02f0203e760c786fca9c

# blockchain info
CONTRACT_ADDRESS=0x3776b9122441e87baf759e658345b9b21b23a7e9
PROVIDER_URL=https://rinkeby.infura.io/v3/ec4c1b60d12d41b9a92318ef4370189c
ETH_GAS_API_KEY=0784ff3548131a2332ebefc89a6a3285a4405c3d7580f8270e30928f541b
CHECKPOINT_GAS_LIMIT=35000
ETH_ADDRESS=0xe4f74efe4efaea7266532c1f8f1e98d0e7a78806
PRIVATE_KEY=448ad0cb7d06bcbce5fb6f416a787632eaecf921fad198dbf3e3cc564d5e52c8

BURN_URL_PROVIDER=https://pyro.burn.io
BLOCK_EXPLORER_URL=http://igniscan.io
BLOCK_EXPLORER_PORT=8000
BLOCK_EXPLORER_URL_EXTRA1=https://igniscan.io
BLOCK_EXPLORER_URL_EXTRA2=http://www.igniscan.io
BLOCK_EXPLORER_URL_EXTRA3=http://www.igniscan.io

# enable/disable endpoint collections
ENABLE_BLOCK_PRODUCER=true
ENABLE_CHECKPOINT_PRODUCER=false
ENABLE_REST_API=true
ENABLE_JSON_RPC=true

# This is testing purpose only. Remove on the production use
NETWORK_OWNER_PRIVATE_KEY=d27055395152a20b7b58e5641e70e2120d3f8b959c2c4328ef16b24661ab35b5

TS_NODE_DEV=true
