#!/usr/bin/env bb
;; registry — query orgs/personal/accounts/registry.edn (tab-separated, bash-friendly).
;; (registry.toml → registry.edn 移行に伴い Python tomllib 版から babashka 版へ。)
;;
;; USAGE:
;;     registry accounts                 # slug<TAB>email<TAB>provider
;;     registry takeout-jobs             # prefix<TAB>account<TAB>parts<TAB>note
;;     registry takeout-account PREFIX   # -> account slug (exit 1 if unknown)
;;     registry mail-accounts            # slug<TAB>provider<TAB>window (mail.sync=true only)
;;     registry email SLUG               # -> email address (exit 1 if unknown)
(require '[clojure.edn :as edn]
         '[babashka.fs :as fs])

(def ^:private usage
  (str "USAGE: registry accounts | takeout-jobs | takeout-account PREFIX"
       " | mail-accounts | email SLUG\n"))

(def ^:private path
  ;; <repo>/orgs/personal/bin/registry -> <repo>/orgs/personal/accounts/registry.edn
  (str (fs/file (fs/parent (fs/parent (fs/absolutize *file*))) "accounts" "registry.edn")))

(def ^:private reg (edn/read-string (slurp path)))

(defn -main [& args]
  (case (first args)
    "accounts"
    (doseq [[slug a] (:accounts reg)]
      (println (str (name slug) "\t" (:email a "") "\t" (:provider a ""))))

    "takeout-jobs"
    (doseq [[prefix j] (:takeout reg)]
      (println (str (name prefix) "\t" (:account j) "\t" (get j :parts "?") "\t" (:note j ""))))

    "takeout-account"
    (if-let [j (get (:takeout reg) (keyword (second args)))]
      (println (:account j))
      (System/exit 1))

    "mail-accounts"
    (doseq [[slug a] (:accounts reg)
            :let [m (:mail a)]
            :when (:sync m)]
      (println (str (name slug) "\t" (:provider a "") "\t" (:window m "14d"))))

    "email"
    (if-let [a (get (:accounts reg) (keyword (second args)))]
      (println (:email a))
      (System/exit 1))

    (do (binding [*out* *err*] (print usage)) (System/exit 2))))

(apply -main *command-line-args*)
