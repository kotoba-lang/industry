;; schema.edn — personal data warehouse: declarative Datomic (EAV) schema.
;;
;; SSoT for entity attributes AND relationships (refs). load.clj reads this file
;; instead of hard-coding the schema. Entities are linked by :db.type/ref attrs;
;; the relationship graph is summarized declaratively in model.edn.
;;
;; Content-addressing: every raw artifact (email, attachment) is stored as a
;; `blob` keyed by its content id (cid = sha256). The blob carries the git-annex
;; key / IPFS / B2 address. email/attachment point to their blob via *-cid refs.

[;; ---------- org ----------
 {:db/ident :org/name        :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :org/type        :db/valueType :db.type/string :db/cardinality :db.cardinality/one}

 ;; ---------- person ----------
 {:db/ident :person/email    :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :person/name     :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :person/role     :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :person/org      :db/valueType :db.type/ref    :db/cardinality :db.cardinality/one  :db/doc "person -> employer/affiliated org"}

 ;; ---------- account ----------
 {:db/ident :account/id      :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :account/kind    :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :account/org     :db/valueType :db.type/ref    :db/cardinality :db.cardinality/one  :db/doc "account -> provider org"}
 {:db/ident :account/owner   :db/valueType :db.type/ref    :db/cardinality :db.cardinality/one  :db/doc "account -> person"}

 ;; ---------- txn ----------
 {:db/ident :txn/id          :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :txn/date        :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :txn/month       :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :txn/amount-jpy  :db/valueType :db.type/long   :db/cardinality :db.cardinality/one}
 {:db/ident :txn/kind        :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :txn/detail      :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :txn/source      :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :txn/vendor      :db/valueType :db.type/ref    :db/cardinality :db.cardinality/one  :db/doc "txn -> org (merchant)"}
 {:db/ident :txn/account     :db/valueType :db.type/ref    :db/cardinality :db.cardinality/one  :db/doc "txn -> account (debited)"}
 {:db/ident :txn/email       :db/valueType :db.type/ref    :db/cardinality :db.cardinality/one  :db/doc "txn -> source email (provenance)"}

 ;; ---------- loan ----------
 {:db/ident :loan/id         :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :loan/date       :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :loan/amount-jpy :db/valueType :db.type/long   :db/cardinality :db.cardinality/one}
 {:db/ident :loan/lender     :db/valueType :db.type/ref    :db/cardinality :db.cardinality/one  :db/doc "loan -> org (lender)"}

 ;; ---------- event (calendar) ----------
 {:db/ident :event/id        :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :event/summary   :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :event/start     :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :event/category  :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :event/people    :db/valueType :db.type/ref    :db/cardinality :db.cardinality/many :db/doc "event -> attendees"}

 ;; ---------- action (register) ----------
 {:db/ident :action/id       :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :action/title    :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :action/priority :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :action/category :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :action/case     :db/valueType :db.type/ref    :db/cardinality :db.cardinality/one  :db/doc "action -> case"}
 {:db/ident :action/email    :db/valueType :db.type/ref    :db/cardinality :db.cardinality/one  :db/doc "action -> triggering email"}

 ;; ---------- blob (content-addressed object; cid = sha256) ----------
 {:db/ident :blob/cid        :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity :db/doc "content id = sha256 hex"}
 {:db/ident :blob/sha256     :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :blob/size       :db/valueType :db.type/long   :db/cardinality :db.cardinality/one}
 {:db/ident :blob/mime       :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :blob/path       :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/doc "annexed path under orgs/personal/"}
 {:db/ident :blob/annex-key  :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/doc "git-annex MD5E key (=B2/IPFS address)"}

 ;; ---------- email (raw, cid/eml) ----------
 {:db/ident :email/cid        :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity :db/doc "sha256 of the .eml"}
 {:db/ident :email/message-id :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity :db/doc "RFC822 Message-ID / Gmail id"}
 {:db/ident :email/thread-id  :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :email/date       :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :email/subject    :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :email/labels     :db/valueType :db.type/string :db/cardinality :db.cardinality/many}
 {:db/ident :email/from       :db/valueType :db.type/ref    :db/cardinality :db.cardinality/one  :db/doc "email -> sender person"}
 {:db/ident :email/to         :db/valueType :db.type/ref    :db/cardinality :db.cardinality/many :db/doc "email -> recipients"}
 {:db/ident :email/cc         :db/valueType :db.type/ref    :db/cardinality :db.cardinality/many}
 {:db/ident :email/mentions   :db/valueType :db.type/ref    :db/cardinality :db.cardinality/many :db/doc "email -> orgs referenced"}
 {:db/ident :email/case       :db/valueType :db.type/ref    :db/cardinality :db.cardinality/one  :db/doc "email -> case"}
 {:db/ident :email/blob       :db/valueType :db.type/ref    :db/cardinality :db.cardinality/one  :db/doc "email -> .eml blob (cid/eml)"}
 {:db/ident :email/attachments :db/valueType :db.type/ref   :db/cardinality :db.cardinality/many}

 ;; ---------- attachment ----------
 {:db/ident :attachment/id    :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :attachment/name  :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :attachment/email :db/valueType :db.type/ref    :db/cardinality :db.cardinality/one}
 {:db/ident :attachment/blob  :db/valueType :db.type/ref    :db/cardinality :db.cardinality/one  :db/doc "attachment -> content blob (cid)"}

 ;; ---------- case (litigation / matter) ----------
 {:db/ident :case/id         :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :case/name       :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :case/kind       :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :case/parties    :db/valueType :db.type/ref    :db/cardinality :db.cardinality/many :db/doc "case -> people"}
 {:db/ident :case/orgs       :db/valueType :db.type/ref    :db/cardinality :db.cardinality/many}
 {:db/ident :case/evidence   :db/valueType :db.type/ref    :db/cardinality :db.cardinality/many :db/doc "case -> emails/blobs (evidence)"}

 ;; ---------- bank (金融口座/カード/取引所 = 収集ソース; facts/bank-sources.edn) ----------
 {:db/ident :bank/id         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :bank/name       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :bank/kind       :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":bank :card :exchange :aggregator"}
 {:db/ident :bank/owner      :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one :db/doc "bank -> person"}
 {:db/ident :bank/org        :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one :db/doc "bank -> 保有法人 (jk-corp等)"}
 {:db/ident :bank/org-ref    :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one :db/doc "bank -> 提供事業者 org"}
 {:db/ident :bank/reach      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/many :db/doc ":email-notify :mf-export :api"}
 {:db/ident :bank/status     :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":ingested :partial :dark"}
 {:db/ident :bank/note       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :txn/bank        :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one :db/doc "txn -> bank (引落/入金口座)"}
 {:db/ident :txn/dir         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "out|in|failed|info"}]
