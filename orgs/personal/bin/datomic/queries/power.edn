;; queries/power.edn — ADR-0012 L3: 力学ビュー。
;; balance = their-dependence - self-dependence (Emerson)。保存せず常に導出。

{:power/balance
 {:doc "全 dyad の依存バランス。負に大きい順 = 露出が大きい順。"
  :query [:find ?name ?self-dep ?their-dep ?cost
          :where
          [?d :dyad/with ?p] [?p :person/name ?name]
          [?d :dyad/self-dependence ?self-dep]
          [?d :dyad/their-dependence ?their-dep]
          [?d :dyad/switching-cost ?cost]]}

 :power/risk-dyads
 {:doc "minimax 重点辺: 自分の依存が高い (>=0.5) のに利害一致が弱い (<=0.55)。worst-case を直視する対象。"
  :query [:find ?name ?self-dep ?align ?worst
          :where
          [?d :dyad/self-dependence ?self-dep] [(>= ?self-dep 0.5)]
          [?d :dyad/alignment ?align]          [(<= ?align 0.55)]
          [?d :dyad/with ?p] [?p :person/name ?name]
          [?d :dyad/worst-case ?worst]]}

 :power/levers
 {:doc "係争相手・ベンダー辺のレバー一覧 (家族辺は除外 — ADR-0012 倫理ガードレール)。"
  :query [:find ?name ?lever
          :where
          [?d :dyad/with ?p] [?p :person/name ?name]
          [?p :person/relation ?rel]
          [(contains? #{:counterparty :vendor :lawyer :accountant} ?rel)]
          [?d :dyad/lever ?lever]]}

 :power/test-agenda
 {:doc "シャノン・アジェンダ: open な仮説と反証手段。確信度が 0.5 に近いほど情報利得が大きい。"
  :query [:find ?id ?text ?conf ?falsifier
          :where
          [?h :hypothesis/status :open]
          [?h :hypothesis/id ?id]
          [?h :hypothesis/text ?text]
          [?h :hypothesis/confidence ?conf]
          [?h :hypothesis/falsifier ?falsifier]]}}
