;; model.edn — declarative entity-relationship graph of the personal warehouse.
;;
;; This is the human/machine readable map of DEPENDENCIES & RELATIONSHIPS between
;; entities (the ref edges defined in schema.edn). Source of truth for "what links
;; to what". Consumed by tooling/queries; mirrors schema.edn :db.type/ref attrs.

{:entities
 {:org         {:identity :org/name      :doc "company / counterparty / provider"}
  :person      {:identity :person/email  :doc "individual (self, lawyers, counterparties)"}
  :account     {:identity :account/id    :doc "financial/service account"}
  :txn         {:identity :txn/id        :doc "money movement (derived from email)"}
  :loan        {:identity :loan/id       :doc "loan / borrowing"}
  :event       {:identity :event/id      :doc "calendar event"}
  :action      {:identity :action/id     :doc "action-register item (P0..P3)"}
  :email       {:identity :email/cid     :doc "raw email, content-addressed (cid=sha256, stored as .eml)"}
  :attachment  {:identity :attachment/id :doc "email attachment"}
  :case        {:identity :case/id       :doc "litigation matter / legal case"}
  :blob        {:identity :blob/cid      :doc "content-addressed bytes (cid=sha256); carries annex/B2/IPFS address"}}

 ;; edges: [from attr cardinality to]  — the dependency/relationship graph
 :relationships
 [[:person     :person/org        :one   :org]
  [:account    :account/org       :one   :org]
  [:account    :account/owner     :one   :person]
  [:txn        :txn/vendor        :one   :org]
  [:txn        :txn/account       :one   :account]
  [:txn        :txn/email         :one   :email]   ; provenance: txn derived from which email
  [:loan       :loan/lender       :one   :org]
  [:event      :event/people      :many  :person]
  [:action     :action/case       :one   :case]
  [:action     :action/email      :one   :email]
  [:email      :email/from        :one   :person]
  [:email      :email/to          :many  :person]
  [:email      :email/cc          :many  :person]
  [:email      :email/mentions    :many  :org]
  [:email      :email/case        :one   :case]
  [:email      :email/blob        :one   :blob]    ; the .eml itself (cid/eml)
  [:email      :email/attachments :many  :attachment]
  [:attachment :attachment/email  :one   :email]
  [:attachment :attachment/blob   :one   :blob]
  [:case       :case/parties      :many  :person]
  [:case       :case/orgs         :many  :org]
  [:case       :case/evidence     :many  :email]]

 ;; content-addressing contract
 :content-addressing
 {:cid        "sha256 hex of the artifact bytes (.eml or attachment)"
  :store      "orgs/personal/mail/messages/<cid>.eml  (git-annex MD5E -> B2/IPFS)"
  :index      "orgs/personal/mail/messages/index.jsonl  (cid <-> message-id <-> thread <-> meta)"
  :blob-link  ":email/blob and :attachment/blob point to the :blob entity carrying annex-key"}}
