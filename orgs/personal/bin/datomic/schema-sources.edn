;; schema-sources.edn — データソース統一registry (:datasrc) + 通信連絡先 (:contact)。
;; この session で取り込んだ全源 (mail/imessage/notes/photos/downloads/icloud/gdrive/tanabe-3d)
;; を1つの Datalog グラフに連携し、人物グラフ (people/dyads) と接続する (ADR-0010)。
[;; ---------- datasrc: 取込源の統一台帳 ----------
 {:db/ident :datasrc/id        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :datasrc/name      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :datasrc/kind      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":comms :notes :photos :files :mail :pipeline :inventory"}
 {:db/ident :datasrc/status    :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":ingested :covered :metadata-only :tcc-blocked :disposable :spec :live"}
 {:db/ident :datasrc/count     :db/valueType :db.type/long    :db/cardinality :db.cardinality/one :db/doc "レコード数 (msgs/notes/assets/files)"}
 {:db/ident :datasrc/size-gb   :db/valueType :db.type/double  :db/cardinality :db.cardinality/one}
 {:db/ident :datasrc/from      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "期間開始 (YYYY-MM-DD)"}
 {:db/ident :datasrc/to        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :datasrc/path      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "倉庫内の索引/格納パス"}
 {:db/ident :datasrc/backed-up :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one :db/doc "B2暗号化バックアップ済か"}
 {:db/ident :datasrc/note      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}

 ;; ---------- contact: 通信相手 (iMessage handle) → person 連携 ----------
 {:db/ident :contact/id        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :contact/handle    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "電話番号 or email"}
 {:db/ident :contact/msg-count :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :contact/source    :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":imessage :sms"}
 {:db/ident :contact/person    :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one :db/doc "contact -> person (解決済の場合)"}

 ;; ---------- person 拡張: メディア/通信での出現量 (人物グラフ連携) ----------
 {:db/ident :person/photo-count :db/valueType :db.type/long   :db/cardinality :db.cardinality/one :db/doc "Photos 上の登場枚数"}
 {:db/ident :person/msg-count   :db/valueType :db.type/long   :db/cardinality :db.cardinality/one :db/doc "iMessage 上のやり取り件数"}

 ;; ---------- accounts.edn の未定義属性を補完 (他session追記分; ネストmapは文字列化) ----------
 {:db/ident :account/mail-sync :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":enabled :disabled"}
 {:db/ident :account/blocker   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "取込阻害要因 (元はEDN map → pr-str)"}]
