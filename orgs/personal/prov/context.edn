;; context.edn — PROV-O の JSON-LD @context を EDN 化 (context.jsonld から移行, ADR-0010 L2)
;; 元 context.jsonld は B2 (git-annex, encryption=hybrid) に格納。GPG鍵 09EE8413… で
;; git annex get → 復号して取り込み、平文 EDN として再定義 (語彙のみ・PIIなし)。
;; prov sidecar (orgs/personal/prov/<cid>.prov.jsonld 予定) が参照する provenance 語彙。
;; 変換: @id→:id, @type→:type。値の "@id" は JSON-LD の「IRI参照」マーカーなので文字列のまま保持。
{:context
 {:prov "http://www.w3.org/ns/prov#"
  :kj   "https://junkawasaki.com/ns#"
  :xsd  "http://www.w3.org/2001/XMLSchema#"

  :Entity   "prov:Entity"
  :Activity "prov:Activity"
  :Agent    "prov:Agent"

  :wasDerivedFrom    {:id "prov:wasDerivedFrom" :type "@id"}
  :wasGeneratedBy    {:id "prov:wasGeneratedBy" :type "@id"}
  :wasAssociatedWith {:id "prov:wasAssociatedWith" :type "@id"}
  :used              {:id "prov:used" :type "@id"}
  :startedAtTime     {:id "prov:startedAtTime" :type "xsd:dateTime"}
  :endedAtTime       {:id "prov:endedAtTime" :type "xsd:dateTime"}

  :cid      "kj:cid"
  :sha256   "kj:sha256"
  :annexKey "kj:annexKey"
  :otsProof "kj:openTimestampsProof"
  :case     {:id "kj:case" :type "@id"}}}
