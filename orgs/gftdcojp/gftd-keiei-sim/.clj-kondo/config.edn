;; clj-kondo 設定: Svelte のビルド時チェックに最も近い静的解析。
;;   clojure -M:lint  で実行 (error が1件でもあれば CI 失敗)。
;; エディタ統合 (VSCode Calva / clojure-lsp) でも同設定が使われ、保存時に赤線が出る。
{:linters
 {;; 未定義シンボル / 名前空間 — typo・未 require をビルド前に検出
  :unresolved-symbol    {:level :error}
  :unresolved-namespace {:level :error}
  :unresolved-var       {:level :error}
  ;; 関数呼び出しの引数ミス
  :invalid-arity        {:level :error}
  :type-mismatch        {:level :error}
  ;; 衛生系 — 警告どまり (ビルドは止めない)
  :unused-binding       {:level :warning}
  :unused-namespace     {:level :warning}
  :redundant-do         {:level :warning}
  :redefined-var        {:level :warning}}

 ;; reagent / re-frame 本体が jar 内に同梱する clj-kondo 設定を取り込むには、
 ;; 一度だけクラスパスを走査してキャッシュ/設定をコピーする:
 ;;   clojure -M:lint --dependencies --copy-configs --lint "$(clojure -Spath)"
 ;; これで reg-event-db / reg-sub / with-let 等の lint が精緻化される。
 }
