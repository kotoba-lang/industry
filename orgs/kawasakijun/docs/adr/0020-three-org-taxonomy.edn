 :boundary-principle
 {:runtime-library    {:goes :com-junkawasaki
                       :examples ["langgraph-clj" "langchain-clj" "computer-use-clj"
                                  "browser-use-clj" "kotodama" "kototama-clj" "kotoba"]}
  :deployed-organism  {:goes :etzhayyim
                       :examples ["etzhayyim/root: UNSPSC 18,342 actor 群"]}
  :enterprise-app     {:goes :gftdcojp
                       :examples ["ai-gftd-apps-gftdcojp" "kyber-plm"]}}

