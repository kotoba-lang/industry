# コード/ドキュメント/設定は plain git (GitHubで閲覧・diff可)
*.py     annex.largefiles=nothing
*.md     annex.largefiles=nothing
*.txt    annex.largefiles=nothing
*.json   annex.largefiles=nothing
*.toml   annex.largefiles=nothing
*.sh     annex.largefiles=nothing
*.yaml   annex.largefiles=nothing
*.yml    annex.largefiles=nothing
.gitignore annex.largefiles=nothing
.gitattributes annex.largefiles=nothing
# 大きい 3D/画像/モデル資産は annex
*.ply    annex.largefiles=anything
*.splat  annex.largefiles=anything
*.png    annex.largefiles=anything
*.jpg    annex.largefiles=anything
*.mp4    annex.largefiles=anything
*.wav    annex.largefiles=anything
*.pth    annex.largefiles=anything
*.ckpt   annex.largefiles=anything
*.bin    annex.largefiles=anything
