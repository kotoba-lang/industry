;; SLO Dashboard Configuration — Month 1 strangler-fig staging
;; Reference: ADR-2607072100 §1.6 "SLO Dashboard"
;;
;; Live monitoring dashboard for strangler-fig Month 1 deployment.
;; Tracks: latency, parity, reliability, memory, throughput against SLO targets.

{:dashboard
 {:name "Strangler-Fig Month 1 SLO (Week 1-4)"
  :description "cljc mesh nodes staging pool parity validation & performance baseline"
  :refresh-interval-sec 10
  :owner "Jun Kawasaki"
  :adr-ref "ADR-2607072100"
  :phase "Phase 1: Staging & Parallel-Run"

  :slo-targets
  {:p99-latency-ms 150     ;; hard budget: baseline(100ms) + 50ms overhead
   :parity-pass-rate-pct 99.99
   :http-5xx-rate-pct 0.01
   :memory-per-instance-mb 256
   :throughput-loss-pct 2.0}

  :panels
  [{:id "latency-p99"
    :title "Live p99 Latency (ms)"
    :description "Percentile 99 latency for drama-profile POST requests"
    :metric "histogram_quantile(0.99, rate(http_request_latency_ms_bucket{route=\"/mesh/http/drama-profile\"}[5m]))"
    :targets
    [{:pool "staging" :color "#00ff00"}
     {:pool "prod" :color "#0000ff"}]
    :slo-line 150
    :alert-threshold 200
    :annotations
    [{:time-sec 604800  ;; 1 week
      :label "Week 1 complete - baseline stable"}
     {:time-sec 1209600  ;; 2 weeks
      :label "Parity validation checkpoint"}]
    :type "timeseries"}

   {:id "latency-percentiles"
    :title "Latency Distribution (p50/p95/p99)"
    :description "Multi-percentile view of latency trends"
    :metrics
    [{:metric "histogram_quantile(0.50, ...)"
      :label "p50"
      :color "#808080"}
     {:metric "histogram_quantile(0.95, ...)"
      :label "p95"
      :color "#ffa500"}
     {:metric "histogram_quantile(0.99, ...)"
      :label "p99"
      :color "#ff0000"}]
    :targets [{:pool "staging"} {:pool "prod"}]
    :type "stacked-area"}

   {:id "parity-pass-rate"
    :title "Parity Pass Rate (%)"
    :description "% of requests with identical responses (Rust vs cljc)"
    :metric "parity_success_rate * 100"
    :slo-line 99.99
    :alert-threshold 99.0
    :interpretation "100% = all drama-profile requests validated as bit-identical"
    :type "gauge"}

   {:id "parity-divergence-count"
    :title "Parity Divergences Detected"
    :description "Count of content-hash mismatches between pools"
    :metric "increase(parity_divergence_detected[5m])"
    :alert-on-increase true
    :interpretation "Any increase = potential bug, triggers investigation"
    :type "counter"}

   {:id "http-5xx-rate"
    :title "HTTP 5xx Error Rate (%)"
    :description "Percentage of requests returning HTTP 5xx status"
    :metric "http_5xx_rate_pct"
    :slo-line 0.01
    :alert-threshold 0.1
    :targets [{:pool "staging"} {:pool "prod"}]
    :type "gauge"}

   {:id "memory-usage"
    :title "Memory Usage per Node (MB)"
    :description "JVM heap usage and peak for each staging node"
    :metric "jvm_heap_usage_bytes / 1048576"
    :slo-line 256
    :peak-slo-line 512
    :targets
    [{:node "staging-cljc-1" :color "#00ff00"}
     {:node "staging-cljc-2" :color "#00ff00"}
     {:node "staging-cljc-3" :color "#00ff00"}]
    :breakdown "usage_percent, peak_mb, current_mb"
    :type "gauge"}

   {:id "gc-pause-time"
    :title "JVM GC Pause Time (ms)"
    :description "P99 stop-the-world GC pause duration"
    :metric "histogram_quantile(0.99, jvm_gc_pause_ms)"
    :slo-line 50
    :alert-threshold 100
    :note "High pause time correlates with latency spikes - monitor closely"
    :type "timeseries"}

   {:id "throughput"
    :title "Throughput (req/sec)"
    :description "Requests per second to both pools"
    :metric "rate(http_requests_total{route=\"/mesh/http/drama-profile\"}[1m])"
    :targets [{:pool "staging"} {:pool "prod"}]
    :slo-line "baseline"  ;; Computed at week 2
    :type "timeseries"}

   {:id "throughput-loss"
    :title "Throughput Loss (%)"
    :description "Staging pool throughput as % of prod pool"
    :metric "(throughput_staging / throughput_prod) * 100"
    :slo-line 98.0  ;; Allow 2% loss
    :interpretation "If <98%, may indicate staging pool resource constraint"
    :type "gauge"}

   {:id "latency-delta"
    :title "Latency Delta (Staging - Rust) (ms)"
    :description "How much slower is cljc vs Rust for identical requests"
    :metric "p99_latency_staging_ms - p99_latency_prod_ms"
    :budget-ms 50
    :interpretation "Negative = cljc faster, positive = slower"
    :type "gauge"}

   {:id "instance-startup-time"
    :title "Instance Startup Latency (ms)"
    :description "Time to compile .kotoba, emit WASM, load in Chicory, ready to serve"
    :metric "histogram_quantile(0.95, instance_compile_to_ready_ms)"
    :target-ms 500
    :slo-ms 500
    :note "Critical for rolling updates - aim <500ms"
    :type "gauge"}

   {:id "rollback-status"
    :title "Rollback Trigger Status"
    :description "Auto-rollback detection and manual overrides"
    :metrics
    [{:metric "latency_regression_triggered"
      :label "p99 >150ms × 5min"}
     {:metric "parity_divergence_triggered"
      :label "parity >1% × 1min"}
     {:metric "reliability_degradation_triggered"
      :label "5xx >1% × 2min"}
     {:metric "manual_rollback_requested"
      :label "Manual rollback requested"}]
    :interpretation "Any trigger = automatic revert to 100% Rust"
    :type "alert-panel"}

   {:id "slo-scorecard"
    :title "SLO Compliance Scorecard"
    :description "Overall status of all SLO targets"
    :checks
    [{:metric "p99_latency_ms"
      :target 150
      :weight 40
      :status "compute"}  ;; dynamic
     {:metric "parity_success_rate_pct"
      :target 99.99
      :weight 40
      :status "compute"}
     {:metric "http_5xx_rate_pct"
      :target 0.01
      :weight 10
      :status "compute"}
     {:metric "memory_stable"
      :target "no_leak"
      :weight 10
      :status "compute"}]
    :overall-score "compute"
    :interpretation "Weighted average of all SLO checks"
    :type "scorecard"}

   {:id "alerts-and-events"
    :title "Alerts & Events Timeline"
    :description "Auto-triggers, manual rollbacks, and noteworthy events"
    :sources
    [{:type "auto-trigger"
      :color "#ff0000"
      :icon "X"}
     {:type "manual-override"
      :color "#ffff00"
      :icon "!"}
     {:type "checkpoint"
      :color "#00ff00"
      :icon "✓"}
     {:type "note"
      :color "#0000ff"
      :icon "📝"}]
    :type "timeline"}]

  :retention
  {:baseline-metrics-weeks 2
   :parity-validation-logs-weeks 2
   :audit-trail-weeks 4}

  :export-formats
  ["prometheus"  ;; Scraped from /metrics endpoints
   "json"        ;; REST API
   "grafana"     ;; Dashboard JSON for import
   "csv"]}  ;; Time-series data export

 :phase-1-checklist
 [{:week 1
   :label "Week 1: Infrastructure & Baseline Setup"
   :items
   [{:item "3 staging nodes healthy"
     :verification "nbb deploy/month-1-staging-deployment.cljs health"}
    {:item "drama-profile routes registered"
     :verification "curl GET /health on each node"}
    {:item "5% canary traffic active"
     :verification "Check murakumo route-dispatch config"}
    {:item "Parity checker running"
     :verification "tail metrics/parity-validation.log"}
    {:item "Metrics collection enabled"
     :verification "curl http://staging:9090/metrics"}]}

  {:week 2
   :label "Week 2: Baseline Stabilization & Validation"
   :items
   [{:item "p99 latency baseline locked"
     :verification "SLO Dashboard latency chart stable ±5%"}
    {:item "Parity pass rate ≥99.99%"
     :verification "SLO Dashboard parity gauge ≥99.99%"}
    {:item "Memory profile stable"
     :verification "No heap growth trend, peaks <256MB"}
    {:item "Latency delta <50ms"
     :verification "Staging p99 - Rust p99 < 50ms"}]}

  {:week 3
   :label "Week 3: Extended Validation"
   :items
   [{:item "Continue monitoring 5% canary"
     :verification "All week 2 checks remain passing"}
    {:item "Evaluate GC tuning"
     :verification "Test ZGC/Shenandoah, measure pause times"}
    {:item "Review divergence patterns (if any)"
     :verification "Analyze parity-validation.log for patterns"}]}

  {:week 4
   :label "Week 4: Phase 1 Completion Review"
   :items
   [{:item "All SLO targets met continuously for 7 days"
     :verification "SLO Dashboard shows green all 7 days"}
    {:item "Zero rollback triggers"
     :verification "rollback_triggered metric = 0"}
    {:item "Audit trail complete"
     :verification "Request logs rotated to B2"}
    {:item "Owner approval for Phase 2"
     :verification "Review meeting: metrics, logs, decision gate"}]}]}

 :annotations
 {:week-1-start {:event "staging-deployment-begin"
                 :timestamp "2026-07-20T00:00:00Z"
                 :note "ADR-2607072100 Phase 1 Week 1 starts"}
  :week-2-checkpoint {:event "parity-validation-complete"
                      :timestamp "+14 days"
                      :note "Baseline stable, advance to Phase 2 decision"}
  :week-4-complete {:event "phase-1-complete"
                    :timestamp "+28 days"
                    :note "Month 1 deliverables met, ready for Phase 2 ramp"}}}
