 ;; ---- axis catalog (common 1-5-normalized-to-0..1 axes, project-scale-agnostic) ----------
 {:axis/id :axis/functional-completeness, :axis/label "Functional completeness", :axis/scale "0-1 (~ 1-5 normalized)",
  :axis/description "how much of the claimed capability is actually implemented (not a stub/TODO/not-yet-wired), independent of whether the gap is disclosed"}
 {:axis/id :axis/safety-enforcement, :axis/label "Safety/policy enforcement", :axis/scale "0-1 (~ 1-5 normalized)",
  :axis/description "whether a claimed safety/capability constraint is actually code-enforced at runtime vs merely documented/aspirational, and how solid the enforcement mechanism itself is (stable API vs unsafe/experimental hook)"}
 {:axis/id :axis/evidence-linkage, :axis/label "Evidence linkage", :axis/scale "0-1 (~ 1-5 normalized)",
  :axis/description "whether the claim cites a concrete, independently-checkable artifact (test file+fn, CI run, commit) vs unverifiable prose; degrades over time if the cited artifact goes stale (see :axis/doc-code-drift for the time-decay case)"}
 {:axis/id :axis/doc-code-drift, :axis/label "Doc-code drift (honesty)", :axis/scale "0-1, 1=no drift/fully honest, 0=silently wrong",
  :axis/description "does the doc's OWN account match what the code actually does right now. A claim that discloses its own gap (:claim/self-caveat true) and the gap is confirmed real scores HIGH here (the doc is honest) even though :axis/functional-completeness for that same claim may be low — the two axes intentionally diverge; a claim with no caveat that turns out wrong scores LOW here regardless of completeness"}
 {:axis/id :axis/production-readiness, :axis/label "Production readiness", :axis/scale "0-1 (~ 1-5 normalized)",
  :axis/description "overall real-world usage signal — is this actually consumed by another repo/app in this monorepo today, not just internally tested"}

