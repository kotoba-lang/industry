;; repo-reality base — doc-vs-code drift verification for kotoba-lang core projects
;; (kotoba, kotoba-lang, kotobase, aiueos, kototama). Combines 3 methods discussed
;; 2026-07-15: (1) executable maturity claims, (4) claim-to-evidence linkage,
;; (5) append-only ledger for drift detection over time. Schema + catalog is
;; DataScript/Datomic-transactable EDN, same shape as
;; 90-docs/design-quality/design-quality.datoms.edn (that system scores UI libs;
;; this one scores doc/ADR claims against actual repo code — different domain,
;; same pattern). Score facts (append-only, one EDN map per line) live in the
;; sibling file repo-reality-ledger.edn — this file only declares schema + the
;; :project/*, :axis/*, :claim/* catalog entities that ledger events reference
;; via :eval/claim.
;;
;; Scope (2026-07-15): all 5 kotoba-lang core projects (kotoba, kotoba-lang,
;; kotobase, aiueos, kototama) now have :claim/* entries + a verify_<project>.cljs
;; sibling script (3-6 claims each, 17 total). First pass covered aiueos only;
;; extended same day to the other 4. Adding a 6th project means: read its
;; README/ADR/coverage.edn or maturity.md, add :claim/* entries here, write
;; verify_<project>.cljs, run it, append output to repo-reality-ledger.edn.
;;
;; example DataScript query — claims with low doc-code-drift (i.e. real drift risk):
;;   (d/q '[:find ?claim ?score ?note
;;          :where [?e :eval/claim ?claim] [?e :eval/axis :axis/doc-code-drift]
;;                 [?e :eval/score ?score] [?e :eval/note ?note] [(< ?score 0.6)]]
;;        db)
;; example — functional-completeness vs doc-code-drift side by side per claim
;; (the point of the two-axis split: a claim can be HONESTLY disclosed as
;; incomplete — high drift score, low completeness score — vs SILENTLY wrong,
;; which is high-severity: low drift score regardless of completeness):
;;   (d/q '[:find ?claim ?axis ?score
;;          :where [?e :eval/claim ?claim] [?e :eval/axis ?axis] [?e :eval/score ?score]
;;                 [(contains? #{:axis/functional-completeness :axis/doc-code-drift} ?axis)]]
;;        db)

[
 ;; ---- schema -----------------------------------------------------------------
 {:db/ident :project/id     :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :project/name   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :project/repo   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :project/own-scale :db/valueType :db.type/string :db/cardinality :db.cardinality/one} ; project's own internal maturity vocabulary, e.g. "M0-M6" / "R1-R3"

 {:db/ident :axis/id          :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :axis/label       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :axis/scale       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :axis/description :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}

 ;; a claim = one factual assertion pulled verbatim/near-verbatim from a doc (ADR/README/
 ;; coverage.edn/maturity.md), pinned to its source location, so it can be independently
 ;; re-checked against the actual repo state without re-reading prose every time.
 {:db/ident :claim/id             :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :claim/project        :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one} ; -> :project/id
 {:db/ident :claim/source         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; file path (+ :line / section) the claim was pulled from
 {:db/ident :claim/text           :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; the claim itself, close-paraphrase or verbatim quote
 {:db/ident :claim/self-reported-level :db/valueType :db.type/string :db/cardinality :db.cardinality/one} ; project's own vocabulary value, e.g. "M6", "R3 stable" ("" if the claim isn't a level claim)
 {:db/ident :claim/self-caveat    :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one} ; true if the SAME source doc already discloses a gap/caveat for this claim (honest disclosure vs silent claim)
 {:db/ident :claim/axis           :db/valueType :db.type/ref     :db/cardinality :db.cardinality/many} ; -> :axis/id, which normalized axis/axes this claim bears on

 ;; verification events (append-only, in repo-reality-ledger.edn)
 {:db/ident :eval/claim    :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one} ; -> :claim/id (curated-claim events)
 {:db/ident :eval/repo     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; "org/repo" string, e.g. "kotoba-lang/kototama" -- used INSTEAD of :eval/claim for org-wide generic checks (orgwide_scan.cljs, 2026-07-16). No per-repo hand-curated :claim/* entity exists for these (would not scale to 1000+ repos); the repo name string is the identifier. A ledger line has exactly one of :eval/claim or :eval/repo, never both.
 {:db/ident :eval/axis     :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one} ; -> :axis/id
 {:db/ident :eval/layer    :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ; :claim-extraction | :lint | :evidence-link | :ledger-reconcile
 {:db/ident :eval/score    :db/valueType :db.type/double  :db/cardinality :db.cardinality/one} ; 0..1, normalized regardless of axis/project scale
 {:db/ident :eval/judge    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; "lint-script" | "evidence-link-script" | agent/human id
 {:db/ident :eval/run-id   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :eval/at       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :eval/seq      :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :eval/note     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}

