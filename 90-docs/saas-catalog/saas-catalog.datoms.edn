;; saas-catalog base — world SaaS/software product competitive catalog (ADR-2607152600)
;; Schema + catalog is DataScript/Datomic-transactable EDN. Product FACTS (append-only,
;; one EDN map per line) live in the sibling file saas-catalog-ledger.edn -- this file only
;; declares schema + the :category/* catalog that ledger entries reference via :product/category.
;;
;; This is NOT cloud-itonami's own product portfolio (that is
;; orgs/kotoba-lang/industry/resources/kotoba/industry/registry.edn, ISIC-coded, plain EDN,
;; no DataScript/Datomic wiring). This catalog is external competitive intelligence: real
;; SaaS/software vendors and products in the world, seeded from public/general knowledge
;; (see saas-catalog-ledger.edn header for the honesty/no-fabrication discipline).
;;
;; example DataScript query -- all CRM products with their HQ country:
;;   (d/q '[:find ?name ?country
;;          :where [?e :product/category :category/crm]
;;                 [?e :product/name ?name]
;;                 [?e :product/hq-country ?country]]
;;        db)
;; example -- products by category, counted (coverage gauge):
;;   (d/q '[:find ?cat (count ?e)
;;          :where [?e :product/category ?cat]]
;;        db)
;; example -- products headquartered outside the US:
;;   (d/q '[:find ?name ?country
;;          :where [?e :product/name ?name] [?e :product/hq-country ?country]
;;                 [(not= ?country "USA")]]
;;        db)

[
 ;; ---- schema -------------------------------------------------------------------
 {:db/ident :category/id      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :category/label   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :category/isic    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}  ; ISIC Rev.4 4-digit code this category primarily maps to, when confidently known
 {:db/ident :category/cloud-itonami-actor :db/valueType :db.type/string :db/cardinality :db.cardinality/one}  ; repo slug of cloud-itonami's OWN actor in this vertical, when one exists (competitive-positioning link)

 {:db/ident :product/id           :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :product/name         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :product/vendor       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :product/category     :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}  ; ref -> :category/id
 {:db/ident :product/hq-country   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}  ; ISO 3166-1 alpha-3, current HQ (see cloud-itonami-iso3166-* siblings for the code catalog)
 {:db/ident :product/founded      :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}  ; year the vendor/product-originating company was founded (best public knowledge, may be a predecessor entity -- see :product/note)
 {:db/ident :product/website      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :product/deployment   :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}  ; :cloud | :hybrid | :on-prem
 {:db/ident :product/pricing-model :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}  ; :subscription | :usage-based | :freemium | :perpetual-license
 {:db/ident :product/status       :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}  ; :active | :acquired | :discontinued
 {:db/ident :product/note         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}  ; optional -- acquisition history, founding-entity caveats, etc.
 {:db/ident :product/added-at     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}  ; ISO date this entry was added to the catalog (provenance)
 {:db/ident :product/source       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}  ; seed batch id (provenance, mirrors :eval/run-id in design-quality-ledger.edn)

