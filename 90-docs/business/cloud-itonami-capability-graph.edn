[{;;; Capability-consumption graph for cloud-itonami. Each record is ONE
  ;;; vertical->capability edge (a relation entity), so the graph is
  ;;; navigable both ways without a ref schema: "which verticals consume
  ;;; worklaw", "which capabilities does isic-7820 consume", "every HR
  ;;; capability consumer". :graph/from and :graph/to are repo paths so
  ;;; this joins repo-taxonomy / repo-maturity by :repo/path. ISIC codes
  ;;; are NOT stamped onto capabilities (ADR-2607310300 D8: a horizontal
  ;;; capability is not a sector business; stamping would put a false code
  ;;; on the query plane). Domain is a plain string, not an ISIC.
  :graph/edge "consumes-capability"
  :graph/from "orgs/cloud-itonami/cloud-itonami-isic-7820"
  :graph/from-name "cloud-itonami-isic-7820 (temp staffing, ISIC 7820)"
  :graph/to "orgs/kotoba-lang/worklaw"
  :graph/to-name "kotoba-lang/worklaw"
  :capability/role "statutory working-time limits (overtime / breaks / rest)"
  :capability/domain "hr"
  :wiring/pattern "governor recomputes from :worked-spans via worklaw/check; prohibition -> HARD HOLD"
  :wiring/since "2026-08-02"
  :wiring/adr "adr-2607310300"
  :wiring/pr "cloud-itonami/cloud-itonami-isic-7820#1"
  :source/dataset "cloud-itonami-capability-graph"
  :source/as-of "2026-08-02"}

