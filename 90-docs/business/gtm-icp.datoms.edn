;; gtm-icp.datoms.edn — 誰に売るかの機械可読な定義。手書き（生成物ではない）。
;;
;; なぜ要るのか。`cloud-murakumo-gtm-country-plan.edn`（accepted, 2026-07-05）は
;; EU 週5–8 に「ターゲット企業 10–20 社リストアップ、コールドメール送付」と書いて
;; いるが、**どの企業がターゲットなのかを機械が判定できる形では書いていない。**
;; 散文の ICP は、リストを作る段になって毎回その場の解釈で作り直され、
;; 「なぜこの会社を選んだか」を後から誰も再現できない。ここはその判定条件だけを持つ。
;;
;; 各 entity は 3 つを分けて持つ:
;;   :icp/checkable-edn   — 今日のデータ面（cloud-itonami-lei catalog）で評価できる述語
;;   :icp/unevaluable-edn — ICP の定義には要るが、**どのデータ源にも今日は無い**述語
;;   :icp/disqualifier-edn— 当たったら外す条件
;; unevaluable を空欄にせず名指しで持つのは、`loop-system-dynamics` の
;; `:uncomputable-until-measured` と同じ規律 —— 評価できない条件を黙って落とすと、
;; 「ICP に適合した 8 社」が「国と連絡先だけ合っていた 8 社」であることが消える。
;;
;; 適用: nbb scripts/gtm-target-list.cljs --icp <icp/id>
;; query: [:find ?p ?c :where [?e "source/dataset" "gtm-icp"] [?e "icp/product" ?p]
;;                            [?e "icp/status" ?c]]

[
 {:icp/id "murakumo-us"
  :icp/product "cloud-murakumo"
  :icp/surface "murakumo.cloud"
  :icp/status "active"
  :icp/priority 1
  :icp/countries ["US"]
  :icp/segment "indie AI/ML 開発者・スタジオ（個人事業主〜数名の LLC/S-corp）、生成AI/クリエイティブスタジオ（GPU 常時稼働の需要がある小規模チーム）、IT 資産購入を検討している CFO/controller 兼務者"
  :icp/buyer-role "founder / technical lead / CFO 兼務の controller"
  :icp/hook "年末までに GPU/サーバーを買えば Bonus Depreciation / Section 179 で今期の課税所得から即時控除でき、買った実機は fleet に入って稼働収益を生む。税務助言ではない旨の disclaimer は storefront 実装済み"
  :icp/timing "Q4（12/31 taxable-year-end）に時限性がある"
  :icp/batch-size 20
  :icp/requires-contact-route true
  :icp/basis "90-docs/business/cloud-murakumo-gtm-country-plan.edn §2（accepted 2026-07-05）"
  :icp/checkable-edn "{:country #{\"US\"} :contact-route :required}"
  :icp/unevaluable-edn "[{:predicate :company-size :want \"1–50 名\" :why \"catalog に従業員数属性が無い\"} {:predicate :industry :want \"AI/ML・生成AI・クリエイティブ制作\" :why \"isic_rev5 は 185 社中 6 社、sector は 1 社しか埋まっていない\"} {:predicate :gpu-spend :want \"GPU 常時稼働の実需\" :why \"どのデータ源にも無い\"} {:predicate :entity-form :want \"LLC/S-corp\" :why \"GLEIF は法人形態を持つが catalog に射影していない\"}]"
  :icp/disqualifier-edn "[{:rule :listed-mega-cap :why \"ticker があり時価総額上位の上場企業は、この ICP の『遊休ハードを持つ小規模チーム』ではない。catalog の US 88 社はほぼ全てこれに当たる\"}]"
  :icp/note "現在の catalog 母集団（Wikidata の売上順上場企業）はこの ICP と正面から反対の population であり、ここから US リストは作れない。US は catalog ではなくコミュニティ経路（HN/X・会計士コミュニティ）が正しい取得面である、というのが country-plan §2 の元の設計。"}

