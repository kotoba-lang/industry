# TEMPLATE -- copy to <target-repo>/.github/workflows/regenerate.yml
# and replace every REPLACE-ME token (repo name x4, domain-ns x1).
# This is the JVM-Clojure variant (clojure -M, sibling checkouts of
# only kotoba-lang/{langgraph,langchain} -- no nbb/cljs toolchain, no
# npm). Proven byte-for-byte identical to cloud-itonami-isic-2910's
# regenerate.yml pattern (ADR-2607189300 ledger seq 4) and shipped
# unchanged (only repo-name substitution) on cloud-itonami-isic-851
# and cloud-itonami-isic-6820 (ledger seq 6).
name: regenerate-console
on:
  schedule:
    - cron: 'MM HH * * *'   # pick an off-minute nightly slot, JST-shifted
  workflow_dispatch: {}
permissions:
  contents: write
jobs:
  regenerate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          path: orgs/cloud-itonami/REPLACE-ME-repo-name
      - uses: actions/checkout@v4
        with: {repository: kotoba-lang/langchain, path: orgs/kotoba-lang/langchain}
      - uses: actions/checkout@v4
        with: {repository: kotoba-lang/langgraph, path: orgs/kotoba-lang/langgraph}
      - uses: actions/setup-java@v4
        with: { distribution: temurin, java-version: "21" }
      - uses: DeLaGuardo/setup-clojure@13.0
        with: { cli: latest }
      - name: regenerate through the real actor
        working-directory: orgs/cloud-itonami/REPLACE-ME-repo-name
        run: clojure -M:dev:render-html
      - name: verify (real output, not scaffolding)
        working-directory: orgs/cloud-itonami/REPLACE-ME-repo-name
        run: |
          grep -q 'REPLACE-ME-domain-ns.render-html' docs/samples/operator-console.html
          grep -q '<tbody>' docs/samples/operator-console.html
          test "$(wc -l < docs/samples/operator-console.html)" -gt 30
          echo "operator console sanity ok"
      - name: commit when changed
        working-directory: orgs/cloud-itonami/REPLACE-ME-repo-name
        run: |
          if ! git diff --quiet docs/; then
            git config user.name "regenerate-console[bot]"
            git config user.email "noreply@github.com"
            git add docs/
            git commit -m "chore(console): nightly regeneration through the real actor"
            git push
          else
            echo "console unchanged"
          fi
