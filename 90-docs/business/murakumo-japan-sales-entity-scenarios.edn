 :facts
 [{:id "k16-purchase-price"
   :statement "The supplied working purchase price is JPY 99,000 per GMKtec K16."
   :evidence ["owner input 2026-08-26"]}
  {:id "computer-customs"
   :statement "A mini PC classified in Japan Customs heading 8471 is normally customs-duty free; imported goods remain subject to consumption tax."
   :evidence ["https://www.customs.go.jp/english/tariff/2023_02_21/data/print_e_84.htm"
              "https://www.customs.go.jp/english/summary/tariff.htm"]}
  {:id "foreign-domestic-sale-vat"
   :statement "A foreign corporation selling goods located in a Japanese warehouse can owe Japanese consumption tax separately from import consumption tax."
   :evidence ["https://www.nta.go.jp/about/organization/tokyo/buppann/pdf/01.pdf"]}
  {:id "japan-national-corporate-rates"
   :statement "For a qualifying small Japanese ordinary corporation, the national corporate tax rate is generally 15% on the first JPY 8 million of income and 23.2% above it; local taxes also apply."
   :evidence ["https://www.nta.go.jp/taxes/shiraberu/taxanswer/hojin/5759.htm"]}
  {:id "us-federal-rate"
   :statement "A US C corporation computes federal income tax at 21% before applicable state taxes and credits."
   :evidence ["https://www.irs.gov/instructions/i1120"]}
  {:id "treaty-pe-rule"
   :statement "Under the Japan-US treaty, business profits are generally taxable only in the residence state unless business is conducted through a permanent establishment in the other state; only PE-attributable profits may then be taxed there."
   :evidence ["https://www.mof.go.jp/tax_policy/summary/international/tax_convention/USA_ST_en.pdf"]}
  {:id "foreign-importer-administration"
   :statement "A nonresident importer needs a resident Customs Procedure Agent, and a foreign consumption-tax taxpayer without a Japanese office needs a resident tax agent."
   :evidence ["https://www.customs.go.jp/english/c-answer_e/sonota/9601_e.htm"
              "https://www.nta.go.jp/taxes/shiraberu/taxanswer/shohi/6635.htm"]}
  {:id "simplified-consumption-tax"
   :statement "An eligible taxpayer with base-period taxable sales no more than JPY 50 million may elect simplified taxation; deemed purchase rates are 90% for wholesale and 80% for retail."
   :evidence ["https://www.nta.go.jp/taxes/shiraberu/taxanswer/shohi/6505.htm"
              "https://www.nta.go.jp/taxes/shiraberu/taxanswer/shohi/6517.htm"]}]

