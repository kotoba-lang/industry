<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0"><header><vendor>kotoba-lang/org-oasis-open-xmile</vendor><name>Gftd Japan credit-erosion (MF actuals 2026)</name></header><sim_specs method="rk4" time_units="month"><start>0</start><stop>24</stop><dt>0.25</dt></sim_specs><model name="credit_erosion_actuals"><sim_specs method="rk4" time_units="month"><start>0</start><stop>24</stop><dt>0.25</dt></sim_specs><variables><flow name="Outflow"><eqn>Opex * VendorCredit + Personnel</eqn></flow><aux name="Opex"><eqn>1079107</eqn></aux><stock name="VendorCredit"><eqn>1.0</eqn><inflow>Credit_Gain</inflow><outflow>Credit_Loss</outflow></stock><flow name="Capacity_Gain"><eqn>Recovery_K * Solvency * VendorCredit * (1 - Capacity)</eqn></flow><aux name="Erosion_K"><eqn>0.25</eqn></aux><flow name="Credit_Loss"><eqn>Erosion_K * (1 - Solvency) * VendorCredit</eqn></flow><flow name="Capacity_Loss"><eqn>Erosion_K * (1 - Solvency) * Capacity</eqn></flow><aux name="Revenue"><eqn>73918</eqn></aux><flow name="Credit_Gain"><eqn>Recovery_K * Solvency * (1 - VendorCredit)</eqn></flow><stock name="Cash"><eqn>86189</eqn><inflow>Inflow</inflow><outflow>Outflow</outflow></stock><stock name="Capacity"><eqn>1.0</eqn><inflow>Capacity_Gain</inflow><outflow>Capacity_Loss</outflow></stock><flow name="Inflow"><eqn>Revenue * Capacity</eqn></flow><aux name="Recovery_K"><eqn>0.35</eqn></aux><aux name="Personnel"><eqn>1682649</eqn></aux><aux name="Solvency"><eqn>MAX(0, MIN(1, Cash / (Opex + Personnel + 1)))</eqn></aux></variables></model></xmile>