  :licensing/authority "US SEC"
  :licensing/licence "U.S. federal government public domain (17 U.S.C. §105); EDN normalization = 自社派生"
  :licensing/redistribution true
  :licensing/attribution-required true
  :licensing/observed-at "2026-09-08"
  :licensing/notes "SEC EDGAR の company facts を EDN 正規化した自社派生。生地データは public domain、正規化・crosswalk は自社著作物。再販可（出所帰属つき）。x402 SKU は第一弾では未登録（propose のみ）。"
  :resale/status :sellable
  :datom/verified true}

