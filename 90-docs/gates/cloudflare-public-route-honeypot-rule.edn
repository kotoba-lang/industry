{:rule/id :cloudflare-public-route-honeypot-v1
 :rule/status :active
 :rule/effective-date "2026-08-08"
 :rule/authority "90-docs/adr/2608081200-cloudflare-route-semantics-and-yabai-honeypot.edn"
 :rule/applies-to ["babiniku.net" "shinshi.club"]
 :http [{:match :documented-page-api-or-asset :response :normal}
        {:match :undocumented-route :response 404 :cache-control "no-store"}
        {:match :secret-or-server-stack-probe :response 403
         :observation :cloudflare-http-analytics}]
 :analytics {:human-pageview-eligible :documented-page-only
             :unknown-route-eligible false
             :probe-eligible false}
 :collection {:system-of-record :cloudflare-http-analytics
              :application-log-fields [:event :host :route-class :status :ray-id]
              :application-log-forbidden [:source-ip :raw-path :query :headers :cookies :body :user-agent]}
 :publication {:publisher "cloud-itonami/yabai-actor"
               :window-days 7
               :minimum-evidence {:distinct-zones 2 :or-probe-requests 50}
               :candidate-policy :withhold
               :language "observed scanner source; no natural-person or organization attribution"
               :rolling-snapshot true}
 :routine {:daily "21:20 UTC"
           :weekly [:false-positive-sample :route-drift-check :correction-review]
           :fail-closed-without [:CF_API_TOKEN :YABAI_OPERATOR_GATE]}}
