{:doc/type :execution-board-template
 :doc/id "board-template-wave5-standard"
 :doc/title "Wave 5 Weekly Execution Board Template"
 :doc/status "TEMPLATE"

 :trello/board-structure
 {:name "Wave 5 Execution — [Team Name]"
  :description "Weekly gate execution tracking (Week N). Sync: Monday 9 AM, Friday 4 PM."
  :lists
  [{:name "🎯 Week N Critical Path"
    :description "Items on critical path for this gate. Move completed → Done Friday."
    :cards
    [{:title "[Example] Integration tests pass (M5 Core)"
      :labels ["critical-path" "M5"]
      :due "Fri 16:00"
      :checklist ["Unit tests pass" "Integration suite > 92% coverage" "Merge to main"]}
     {:title "[Example] Deployment staging validation (M6 Platform)"
      :labels ["critical-path" "M6"]
      :due "Fri 16:00"
      :checklist ["Staging env stable 4h" "Smoke tests pass" "Rollback plan documented"]}]}
   {:name "🚨 Blockers & Risks"
    :description "Impediments, dependencies, risks. Escalate if > 4h unblocked."
    :cards
    [{:title "Dependency: [upstream repo] pin not advanced"
      :labels ["blocker" "P1"]
      :assigned-to "team-lead-m5"
      :due "Mon 09:00"
      :description "Need upstream commit SHA by Monday 9 AM for integration tests. Contact: [owner]"}]}
   {:name "📊 Metrics This Week"
    :description "Weekly metric snapshots. Auto-populated from Prometheus."
    :template
    [{:metric "build-times (p99)" :target "< 12 min" :actual "[grafana link]"}
     {:metric "test-coverage" :target ">= 92%" :actual "[grafana link]"}
     {:metric "deployment-success" :target ">= 99.5%" :actual "[grafana link]"}
     {:metric "gate-blocker detection latency" :target "< 2 min" :actual "[grafana link]"}]}
   {:name "✅ Done (This Week)"
    :description "Completed gate items. Moved here Friday after gate review."
    :retention "Archive post-Friday gate decision"}]}

 :jira/workflow-status
 {:workflow-states
  [{:state "Open" :description "Task created, not started"}
   {:state "In Progress" :description "Actively being worked"}
   {:state "Blocked" :description "External dependency, escalation required"}
   {:state "Ready for Gate" :description "Completed, awaiting gate review"}
   {:state "Gate Approved" :description "Approved by Friday 4 PM gate"}
   {:state "Done" :description "Merged to main or archived"}]
  :issue-templates
  [{:type "gate-readiness-check"
    :template
    "Gate: Week [N] — [Team Name]\n\nReadiness:\n- [ ] Critical path complete\n- [ ] Metrics healthy (Grafana: [link])\n- [ ] Blockers resolved or escalated\n- [ ] Cross-team dependencies verified\n- [ ] Rollback plan documented\n\nDecision: [ ] Go [ ] No-Go\nNotes: [...]"}
   {:type "blocker-escalation"
    :template
    "Blocker: [Title]\n\nTeam: [M5/M6]\nSeverity: [ ] P1 (2h SLA) [ ] P2 (4h SLA)\nBlocked-on: [upstream/dependency]\nOwner: [contact]\nETA to unblock: [date+time]\n\nAction: @metrics-lead escalate to #prod-gates-wave5"}
   {:type "weekly-metrics-snapshot"
    :template
    "Metrics Report — Week [N]\n\nBuild Times (p99): [X min] (target: < 12 min)\nTest Coverage: [X%] (target: >= 92%)\nDeployment Success: [X%] (target: >= 99.5%)\nGate-Blocker Detection: [X min] (target: < 2 min)\nTeam Velocity: [X story pts] (vs. forecast)\n\nTrending: [ ] On track [ ] Slight slip [ ] Major risk\nMitigation: [...]"}]}

 :governance/sync-points
 {:monday-09am-review
  {:duration "30 min"
   :attendees "team-leads + metrics-lead"
   :output "Progress board + blocker triage + velocity trending"
   :decision "Do we stay on critical path? Any escalations needed?"
   :artifacts-to-create
   ["Monday review notes (Jira comment)"
    "Updated blocker list (Trello + Jira)"
    "Forecast update (velocity extrapolation)"]}
  :friday-16pm-gate-review
  {:duration "45 min"
   :attendees "team-leads + phase-owner + platform-lead + metrics-lead"
   :decision-rule "consensus (all teams must agree or escalate)"
   :output "Gate decision (Go/No-Go) + next-week critical path"
   :artifacts-to-create
   ["Gate decision memo (Jira issue type: gate-readiness-check)"
    "Weekly metrics snapshot (Jira issue type: weekly-metrics-snapshot)"
    "Escalation summary if any (Jira issue type: blocker-escalation)"
    "Next-week forecast + dependencies (Trello cards created)"
    "Archive: move completed cards from Trello → Done"]}}

 :automation/board-sync
 {:source "Prometheus + CI gate bot"
  :targets ["Trello (📊 Metrics This Week)" "Jira (labels + custom field: metric-value)"]
  :sync-frequency "1h"
  :update-rules
  [{:metric "build-times"
    :update "Trello card: 📊 Metrics This Week → p99 value (from grafana)"
    :jira-field "custom:metric-build-times"}
   {:metric "test-coverage"
    :update "Trello card: 📊 Metrics This Week → % value"
    :jira-field "custom:metric-coverage"}
   {:metric "deployment-success"
    :update "Trello card: 📊 Metrics This Week → % value"
    :jira-field "custom:metric-deploy-success"}]

 :team-board-assignments
 {:m5-core
  {:board-id "trello-m5-core-wave5"
   :jira-project "M5W5"
   :board-lead "m5-core-team-lead"
   :weekly-lead-contact "m5-core-team-lead@gftd.group"}}
 {:m5-integration
  {:board-id "trello-m5-integration-wave5"
   :jira-project "M5IW5"
   :board-lead "m5-integration-team-lead"
   :weekly-lead-contact "m5-integration-team-lead@gftd.group"}}
 {:m6-platform
  {:board-id "trello-m6-platform-wave5"
   :jira-project "M6W5"
   :board-lead "m6-platform-team-lead"
   :weekly-lead-contact "m6-platform-team-lead@gftd.group"}}

 :shared-dashboard
 {:name "gates-wave5-m5m6-live"
  :url "https://dashboard.internal/wave5-m5m6"
  :refresh-rate "1 min"
  :panels
  [{:name "Weekly Gate Status (Consensus)" :type "status-grid" :teams ["M5 Core" "M5 Integration" "M6 Platform"]}
   {:name "Critical Path Health" :type "timeline" :source "Jira"}
   {:name "Metrics Trending (6-week)" :type "line-chart" :metrics ["build-times" "coverage" "deploy-success"]}
   {:name "Blocker Queue (SLA Countdown)" :type "table" :source "Jira + escalation-protocol"}
   {:name "Team Velocity Burndown" :type "burndown" :source "Jira story-points"}
   {:name "Escalation History (Week by Week)" :type "timeline" :source "prod-gates-wave5 Slack"}]}}}
