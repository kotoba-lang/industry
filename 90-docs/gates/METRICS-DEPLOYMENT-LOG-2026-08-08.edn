     :files ["deploy/prometheus.yml" "deploy/prometheus-rules.yml"]
     :verification
     [{:check "Prometheus service running" :method "systemctl status prometheus"}
      {:check "Health check passing" :method "curl -s http://localhost:9090/-/healthy → 200"}
      {:check "Scrape targets configured" :method "curl -s http://localhost:9090/api/v1/targets | jq '.data.activeTargets | length' >= 5"}]}
    {:component "Metrics Collection Jobs"
     :action "Verify 5 metric collectors working"
     :scripts ["scripts/collect-build-metrics.cljs"
              "scripts/collect-coverage-metrics.cljs"
              "scripts/collect-deploy-metrics.cljs"
              "scripts/collect-blocker-metrics.cljs"
              "scripts/collect-velocity-metrics.cljs"]
