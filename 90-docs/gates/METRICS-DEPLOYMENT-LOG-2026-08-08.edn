     [{:check "Build metrics appear" :method "curl -s 'http://localhost:9090/api/v1/query?query=build_duration_seconds' | jq '.data.result | length' > 0"}
      {:check "Coverage metrics appear" :method "curl -s 'http://localhost:9090/api/v1/query?query=code_coverage_percent' | jq '.data.result | length' > 0"}
      {:check "Deploy metrics appear" :method "curl -s 'http://localhost:9090/api/v1/query?query=deployment_success_rate' | jq '.data.result | length' > 0"}
      {:check "Blocker metrics appear" :method "curl -s 'http://localhost:9090/api/v1/query?query=blocker_count' | jq '.data.result | length' > 0"}]}
    {:component "Alert Rules"
     :action "Load and verify alert rules"
     :verification
     [{:check "Alert rules loaded" :method "curl -s http://localhost:9090/api/v1/rules | jq '.data.groups | length' >= 1"}
      {:check "All targets UP" :method "curl -s http://localhost:9090/api/v1/query?query=up | jq '.data.result | length' == 5"}]}]
