  :arch/replay :idempotent-only :arch/pure-surface :needs-escaping-cell
  :arch/note "The dependency graph is discovered by observing which cells were read during a render. That is the one thing a static effect row cannot express and a CID cannot name: the shape of the computation is not a value anywhere. Nothing here is content-addressable, so seven of the eight axes have nothing to score."}

 {:db/id -16 :source/dataset "substrate-fit"
  :arch/id "react-vdom" :arch/layer :interface
  :arch/evidence "https://react.dev/learn/preserving-and-resetting-state"
