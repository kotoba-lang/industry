 :org/region-primary :region-north-america
 :org/countries ["US" "BD" "PH" "CR" "AR" "BO"]
 :org/founding-date 1935
 :org/founding-note "Created under the US Rural Electrification Administration when investor-owned utilities would not serve rural areas."
 :org/instance-count-estimate 890
 :org/member-count 42000000
 :org/member-count-basis "source-pinned: 890 rural utility members of NRECA (830 distribution and 60 generation-and-transmission co-ops) serving 42 million people and over 22 million homes, businesses, schools and farms across 48 states. They serve 12% of the population while owning 42% of America's distribution lines across three quarters of the country's land area, and return over $1 billion a year to consumer-members. Bangladesh's palli bidyut samity and Philippine electric co-ops were modelled on the same design and are counted separately."
 :org/legal-registration :registered
 :org/governance-model :democratic
 :org/mission-statement "Consumer-owned utilities in the places private capital declined to wire — the largest example in this corpus of a community form that owns heavy infrastructure, elects its board and covers 92% of persistent-poverty counties."
 :org/related-org "org-global-energy-cooperatives"
 :org/source-name "NRECA / America's Electric Cooperatives, Electric Co-op Facts & Figures"
 :org/source-url "https://www.electric.coop/electric-cooperative-fact-sheet"
 :org/source-date "2026"
 :org/source-tier :primary
 :org/pinned-on "2026-07-26"
 :org/data-provenance "source-pinned"
 :source/dataset "community-coverage"}

