 :org/source-date "2023"
 :org/source-tier :primary
 :org/source-caveat "Two membership figures are in circulation (4.38M for 2022 vs 5.88M in an undated federation summary); the discrepancy is unresolved here."
 :org/pinned-on "2026-07-25"
 :org/data-provenance "source-pinned"
 :source/dataset "community-coverage"}

