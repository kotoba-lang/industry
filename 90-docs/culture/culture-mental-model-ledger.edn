{:gesture/id :gesture-ok-sign-deu, :gesture/family :ok-sign, :gesture/region [:region/id "DEU"], :gesture/physical-description "Thumb and index finger forming circle, other fingers extended", :gesture/meaning "OK, agreement, zero, nothing", :gesture/valence :neutral, :gesture/caution "Safe in most of Northern Europe. Avoid in Mediterranean, Russia, Turkey.", :gesture/source "Cross-cultural gesture research"}
