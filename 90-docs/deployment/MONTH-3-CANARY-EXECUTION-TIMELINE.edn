    :team-size 2}}

  :canary/communication-plan
  {:primary-channel "#prod-gates-wave5 (Slack)"
   :alert-channel "PagerDuty (escalation)"
   :decision-log "This file + `MONTH-3-GO-NO-GO-DECISION.edn`"
   :status-updates-frequency "every 1 hour during active stages"
   :critical-updates
   ["Stage gate decisions (proceed / hold / rollback)"
