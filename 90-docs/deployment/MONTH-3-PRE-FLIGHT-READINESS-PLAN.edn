      :decision-criteria
      ["PASS: All 7 items PASS, no blocking issues, fire-drill successful"
       "FAIL: Any item FAILED or red flag exists → NOT READY"
       "DEFAULT: If team unconfident → DELAY, do not force GO"]
      :output-artifact "MONTH-3-GO-NO-GO-DECISION.edn (created during gate)"}]

