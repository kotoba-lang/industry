     "SLO thresholds locked in monitoring system"
     "Staging environment ready (Rust + cljc fleet both available)"]
    :deliverables
    [{:item "Fire Drill: Latency Regression Rollback (Scenario 1)"
      :duration-minutes 30
      :owner "Canary Lead + Traffic Controller + Monitoring Lead"
      :procedure
      ["14:05-14:06: Monitoring-lead simulates p99 latency spike to 210ms (> threshold)"
       "14:06-14:07: Monitoring-lead triggers rollback alert (manual, simulated alert fire)"
       "14:07-14:08: Traffic-controller receives alert, executes rollback script"
       "14:08-14:09: Traffic reverts from 75% → 50%, latency normalizes to 95ms"
       "14:09-14:11: Verify Rust pool resumes taking traffic, no cascading failure"]
      :success-criteria
      ["Rollback script executes without error"
       "Traffic reversion completes in < 2 min"
       "Rust pool connection count increases, cljc decreases"
       "Team confirms confidence in automatic rollback mechanism"]}

     {:item "Fire Drill: Parity Divergence Full Rollback (Scenario 2)"
      :duration-minutes 30
      :owner "Monitoring Lead + Canary Lead"
      :procedure
      ["14:20-14:21: Monitoring-lead simulates parity failure 1.5% (> 1% threshold)"
       "14:21-14:22: Parity checker detects divergence, automatic trigger fires"
       "14:22-14:23: Traffic-controller executes FULL rollback (100% → Rust)"
       "14:23-14:24: Verify Rust pool handles 100% traffic without error"
       "14:24-14:26: Escalation-lead logs decision: 'Full rollback due to parity divergence'"]
      :success-criteria
      ["Full rollback script executes"
       "Rust pool absorbs 100% traffic within 2 min"
       "Parity metric stabilizes at 0%"
       "Team understands full rollback is mandatory, not optional"]}

     {:item "Fire Drill: Graceful Rust Drain Procedure (Scenario 3)"
      :duration-minutes 40
      :owner "Traffic Controller + Monitoring Lead + On-Call Engineer"
      :environment "Staging (both Rust + cljc fleet available)"
      :procedure
      ["14:35-14:36: Pre-stage staging cljc fleet at 99%, Rust at 1% (simulating Stage 3b end)"
       "14:36-14:37: Traffic-controller: set Rust pool drain flag (stop new connections)"
       "14:37-14:42: Wait for in-flight requests to complete (monitor connection count)"
       "14:42-14:44: Monitoring-lead: verify all sessions migrated to cljc"
       "14:44-14:46: Traffic-controller: deactivate Rust pool (STANDBY)"
       "14:46-14:50: Verify Rust infrastructure still alive (emergency restore readiness)"]
      :success-criteria
      ["Graceful drain completes in < 10 min (normal SLA is 60s)"
       "Rust connection count drops to 0"
       "Session migration verified 100%"
       "Rust standby confirmed (can restore if needed)"
       "Team confident in graceful shutdown procedure"]}

     {:item "Fire Drill Debrief (14:50 to 15:00 JST)"
      :duration-minutes 10
      :owner "Canary Lead"
      :procedure
      ["Quick round-robin: each role reports confidence level (1-5 scale)"
