[{:deployment/id "deployment-monitoring-alerting-2026-09-08"
  :deployment/title "Strangler-fig Month 3: Monitoring & Alerting Setup"
  :deployment/date "2026-09-08"
  :deployment/owner "Jun Kawasaki"
  :db/id -1

  :deployment/prometheus-scrape-config
  {
    :global
    {
      :scrape-interval "15s"
      :evaluation-interval "15s"
      :external-labels {:cluster "murakumo-fleet" :environment "production"}
    }

    :scrape-configs
    [
      {
        :job-name "cljc-mesh-nodes-staging"
        :targets
        [
          "staging-01.mesh.internal:9090"
          "staging-02.mesh.internal:9090"
          "staging-03.mesh.internal:9090"
          "staging-04.mesh.internal:9090"
          "staging-05.mesh.internal:9090"
          "staging-06.mesh.internal:9090"
        ]
        :scrape-interval "15s"
        :scrape-timeout "10s"
        :metrics-path "/metrics"
        :scheme "https"
        :tls-config {:insecure-skip-verify false}
        :relabel-configs
        [
          {:source-labels ["__address__"] :target-label "instance"}
          {:source-labels ["__meta_node_name"] :target-label "node_id"}
          {:target-label "node_runtime" :replacement "cljc"}
          {:target-label "pool" :replacement "staging"}
        ]
      }

      {
        :job-name "cljc-mesh-nodes-production"
        :targets
        [
          "prod-cljc-01.mesh.internal:9090"
          "prod-cljc-02.mesh.internal:9090"
          "prod-cljc-03.mesh.internal:9090"
        ]
        :scrape-interval "15s"
        :scrape-timeout "10s"
        :metrics-path "/metrics"
        :scheme "https"
        :relabel-configs
        [
          {:source-labels ["__address__"] :target-label "instance"}
          {:source-labels ["__meta_node_name"] :target-label "node_id"}
          {:target-label "node_runtime" :replacement "cljc"}
          {:target-label "pool" :replacement "production"}
        ]
      }

      {
        :job-name "rust-fleet-baseline"
        :targets
        [
          "prod-rust-01.mesh.internal:9090"
          "prod-rust-02.mesh.internal:9090"
          "prod-rust-03.mesh.internal:9090"
          "prod-rust-04.mesh.internal:9090"
          "prod-rust-05.mesh.internal:9090"
          "prod-rust-06.mesh.internal:9090"
          "prod-rust-07.mesh.internal:9090"
          "prod-rust-08.mesh.internal:9090"
          "prod-rust-09.mesh.internal:9090"
        ]
        :scrape-interval "30s"
        :scrape-timeout "10s"
        :metrics-path "/metrics"
        :scheme "https"
        :relabel-configs
        [
          {:source-labels ["__address__"] :target-label "instance"}
          {:target-label "node_runtime" :replacement "rust"}
          {:target-label "pool" :replacement "production"}
        ]
      }

      {
        :job-name "murakumo-control-plane"
        :targets ["murakumo.mesh.internal:9091"]
        :scrape-interval "30s"
        :scrape-timeout "10s"
        :metrics-path "/metrics"
        :scheme "https"
        :relabel-configs
        [
          {:source-labels ["__address__"] :target-label "instance"}
          {:target-label "component" :replacement "murakumo-control"}
        ]
      }

      {
        :job-name "parity-checker"
        :targets ["parity-checker.mesh.internal:9092"]
        :scrape-interval "5s"
        :scrape-timeout "5s"
        :metrics-path "/metrics"
        :scheme "https"
        :relabel-configs
        [
          {:source-labels ["__address__"] :target-label "instance"}
          {:target-label "component" :replacement "parity-checker"}
        ]
      }

      {
        :job-name "prometheus-self-monitoring"
        :targets ["localhost:9090"]
        :scrape-interval "30s"
        :metrics-path "/metrics"
      }
    ]
  }

  :deployment/alert-rules
  {
    :rule-group "strangler-fig-canary"
    :interval "15s"

    :rules
    [
      {
        :alert-name "LatencyRegressionP99Critical"
        :condition "drama_profile_latency_p99{node_runtime=\"cljc\"} > 100"
        :for-duration "5m"
        :severity "critical"
        :action "autonomous-rollback"
        :description "cljc p99 latency exceeded 100ms SLO for 5 min"
        :annotations
        {
          :summary "Strangler-fig canary: latency regression (cljc)"
          :description "drama_profile p99 latency: {{ $value }}ms (threshold: 100ms)"
          :runbook "https://wiki.gftd.group/strangler-fig-runbook#latency-regression"
          :dashboard "https://grafana.gftd.group/d/strangler-fig-month3"
        }
        :labels {:team "platform-ops" :severity "critical" :page "yes"}
      }

      {
        :alert-name "ParityFailureRateCritical"
        :condition "parity_checker_failure_rate > 0.01"
        :for-duration "1m"
        :severity "critical"
        :action "autonomous-rollback"
        :description "Parity divergence >1% for 1 min triggers full revert"
        :annotations
        {
          :summary "Strangler-fig canary: parity failure"
          :description "Divergence rate: {{ $value }}% (threshold: 0.01%)"
          :runbook "https://wiki.gftd.group/strangler-fig-runbook#parity-failure"
          :dashboard "https://grafana.gftd.group/d/parity-debug"
        }
        :labels {:team "platform-ops" :severity "critical" :page "yes"}
      }

      {
        :alert-name "Http5xxRateElevated"
        :condition "rate(http_requests_5xx_total{node_runtime=\"cljc\"}[5m]) > 0.001"
        :for-duration "2m"
        :severity "critical"
        :action "autonomous-rollback"
        :description "HTTP 5xx rate >1% sustained 2 min"
        :annotations
        {
          :summary "Strangler-fig canary: HTTP 5xx errors"
          :description "5xx rate: {{ $value }}% (threshold: 1%)"
          :runbook "https://wiki.gftd.group/strangler-fig-runbook#http-5xx"
          :dashboard "https://grafana.gftd.group/d/strangler-fig-month3"
        }
        :labels {:team "platform-ops" :severity "critical" :page "yes"}
      }

      {
        :alert-name "MemoryPeakExceeded"
        :condition "jvm_memory_heap_peak_bytes{node_runtime=\"cljc\"} > 536870912"
        :for-duration "3m"
        :severity "warning"
        :action "manual-escalation"
        :description "JVM heap peak >512MB for 3 min"
        :annotations
        {
          :summary "Strangler-fig canary: memory peak exceeded"
          :description "Heap peak: {{ $value | humanize }}B (threshold: 512MB)"
          :runbook "https://wiki.gftd.group/strangler-fig-runbook#memory-peak"
          :dashboard "https://grafana.gftd.group/d/strangler-fig-month3"
        }
        :labels {:team "platform-ops" :severity "warning" :page "no"}
      }

      {
        :alert-name "GCPauseP99TooLong"
        :condition "jvm_gc_pause_p99{node_runtime=\"cljc\"} > 50"
        :for-duration "5m"
        :severity "warning"
        :action "manual-escalation"
        :description "GC pause p99 >50ms for 5 min"
        :annotations
        {
          :summary "Strangler-fig canary: GC pause too long"
          :description "GC pause p99: {{ $value }}ms (threshold: 50ms)"
          :runbook "https://wiki.gftd.group/strangler-fig-runbook#gc-pause"
          :dashboard "https://grafana.gftd.group/d/strangler-fig-month3"
        }
        :labels {:team "platform-ops" :severity "warning" :page "no"}
      }

      {
        :alert-name "NodeHealthCheckFailing"
        :condition "node_health_status{node_runtime=\"cljc\"} != 1"
        :for-duration "2m"
        :severity "critical"
        :action "manual-escalation"
        :description "Node health check failing"
        :annotations
        {
          :summary "Strangler-fig canary: node unhealthy"
          :description "Node {{ $labels.node_id }} health status: {{ $value }}"
          :runbook "https://wiki.gftd.group/strangler-fig-runbook#node-unhealthy"
          :dashboard "https://grafana.gftd.group/d/strangler-fig-month3"
        }
        :labels {:team "platform-ops" :severity "critical" :page "yes"}
      }

      {
        :alert-name "MurakumoControlPlaneDown"
        :condition "up{job=\"murakumo-control-plane\"} == 0"
        :for-duration "1m"
        :severity "critical"
        :action "page-oncall"
        :description "Murakumo control plane unreachable"
        :annotations
        {
          :summary "Strangler-fig canary: murakumo control plane down"
          :description "Control plane has been unreachable for 1 min"
          :runbook "https://wiki.gftd.group/strangler-fig-runbook#murakumo-down"
          :dashboard "https://grafana.gftd.group/d/strangler-fig-month3"
        }
        :labels {:team "platform-ops" :severity "critical" :page "yes"}
      }

      {
        :alert-name "ParityCheckerDown"
        :condition "up{job=\"parity-checker\"} == 0"
        :for-duration "1m"
        :severity "warning"
        :action "manual-escalation"
        :description "Parity checker unavailable (validation paused)"
        :annotations
        {
          :summary "Strangler-fig canary: parity checker down"
          :description "Parity checker has been unreachable for 1 min"
          :runbook "https://wiki.gftd.group/strangler-fig-runbook#parity-checker-down"
          :dashboard "https://grafana.gftd.group/d/parity-debug"
        }
        :labels {:team "platform-ops" :severity "warning" :page "no"}
      }

      {
        :alert-name "TrafficSplitMismatch"
        :condition "abs(murakumo_traffic_split_actual_pct - murakumo_traffic_split_desired_pct) > 5"
        :for-duration "2m"
        :severity "warning"
        :action "manual-escalation"
        :description "Actual traffic split deviates from desired by >5%"
        :annotations
        {
          :summary "Strangler-fig canary: traffic split mismatch"
          :description "Desired: {{ $value }}%, Actual: {{ .desired }}%"
          :runbook "https://wiki.gftd.group/strangler-fig-runbook#traffic-split-mismatch"
          :dashboard "https://grafana.gftd.group/d/strangler-fig-month3"
        }
        :labels {:team "platform-ops" :severity "warning" :page "no"}
      }
    ]
  }

  :deployment/pagerduty-configuration
  {
    :escalation-policy-name "strangler-fig-canary-escalation"
    :repeat-enabled true
    :repeat-timeout-min 30

    :escalation-levels
    [
      {
        :level 1
        :level-name "Platform Operations (Primary)"
        :schedule "pagerduty-primary-oncall"
        :escalation-timeout-min 5
        :notification-channels ["sms" "phone" "slack"]
        :sms-enabled true
        :phone-enabled true
        :email-enabled true
        :description "Page ops on-call immediately for any critical alert"
      }

      {
        :level 2
        :level-name "Infrastructure Lead (Backup)"
        :schedule "pagerduty-infra-lead-backup"
        :escalation-timeout-min 10
        :notification-channels ["phone" "slack"]
        :phone-enabled true
        :email-enabled true
        :description "Escalate after 5 min if ops on-call doesn't acknowledge"
      }

      {
        :level 3
        :level-name "Platform Owner (Final Escalation)"
        :schedule "pagerduty-owner-backup"
        :escalation-timeout-min 15
        :notification-channels ["phone" "slack"]
        :phone-enabled true
        :description "Final escalation to owner after 15 min total"
      }
    ]

    :service-integrations
    [
      {
        :integration-key "event-rules-strangler-fig"
        :event-rules
        [
          {
            :condition "alert.severity == 'critical'"
            :severity "critical"
            :urgency "high"
          }
          {
            :condition "alert.severity == 'warning'"
            :severity "warning"
            :urgency "low"
          }
        ]
      }
    ]

    :incident-routing-rules
    [
      {
        :rule-name "Latency Critical → Escalate Immediately"
        :trigger "LatencyRegressionP99Critical"
        :route-to "strangler-fig-canary-escalation"
        :urgency "high"
        :auto-acknowledge-timeout-min 0
      }

      {
        :rule-name "Parity Failure → Escalate Immediately"
        :trigger "ParityFailureRateCritical"
        :route-to "strangler-fig-canary-escalation"
        :urgency "high"
        :auto-acknowledge-timeout-min 0
      }

      {
        :rule-name "HTTP 5xx → Escalate Immediately"
        :trigger "Http5xxRateElevated"
        :route-to "strangler-fig-canary-escalation"
        :urgency "high"
        :auto-acknowledge-timeout-min 0
      }

      {
        :rule-name "Node Unhealthy → Escalate Immediately"
        :trigger "NodeHealthCheckFailing"
        :route-to "strangler-fig-canary-escalation"
        :urgency "high"
        :auto-acknowledge-timeout-min 0
      }

      {
        :rule-name "Murakumo Down → Escalate + Page Owner"
        :trigger "MurakumoControlPlaneDown"
        :route-to "strangler-fig-canary-escalation"
        :escalate-to-owner true
        :urgency "high"
        :auto-acknowledge-timeout-min 0
      }

      {
        :rule-name "Memory Peak → Manual Escalation"
        :trigger "MemoryPeakExceeded"
        :route-to "strangler-fig-canary-escalation"
        :urgency "low"
        :auto-acknowledge-timeout-min 30
      }

      {
        :rule-name "GC Pause Long → Manual Escalation"
        :trigger "GCPauseP99TooLong"
        :route-to "strangler-fig-canary-escalation"
        :urgency "low"
        :auto-acknowledge-timeout-min 45
      }
    ]

    :on-call-rotations
    [
      {
        :rotation-name "pagerduty-primary-oncall"
        :schedule-type "weekly"
        :start-date "2026-09-08"
        :rotation-period-days 7
        :members
        [
          {:name "alice.ops@gftd.group" :start "2026-09-08" :end "2026-09-15"}
          {:name "bob.ops@gftd.group" :start "2026-09-15" :end "2026-09-22"}
          {:name "charlie.ops@gftd.group" :start "2026-09-22" :end "2026-09-29"}
        ]
      }

      {
        :rotation-name "pagerduty-infra-lead-backup"
        :schedule-type "weekly"
        :start-date "2026-09-08"
        :rotation-period-days 7
        :members
        [
          {:name "charlie.infra@gftd.group" :start "2026-09-08" :end "2026-09-15"}
          {:name "diana.infra@gftd.group" :start "2026-09-15" :end "2026-09-22"}
        ]
      }

      {
        :rotation-name "pagerduty-owner-backup"
        :schedule-type "static"
        :members
        [
          {:name "jun@gftd.group" :title "Platform Owner"}
        ]
      }
    ]
  }

  :deployment/on-call-runbooks
  {
    :runbook-base-url "https://wiki.gftd.group/strangler-fig-runbook"

    :runbooks
    [
      {
        :runbook-name "Latency Regression"
        :runbook-path "#latency-regression"
        :alert-trigger "LatencyRegressionP99Critical"
        :severity "critical"
        :steps
        [
          "1. Verify alert: Check p99 latency dashboard. If >100ms sustained for >5min, proceed."
          "2. Check traffic split: Is cljc pool still receiving traffic?"
          "3. Check node health: All 3 cljc prod nodes healthy?"
          "4. Investigate: SSH to prod-cljc-01, check GC logs, CPU, network latency."
          "5. If root cause found & quick fix possible: deploy fix to staging first, re-test."
          "6. If unsure: Prepare rollback. Contact level 2 escalation (infra lead)."
          "7. Auto-rollback should trigger at 5min mark. Monitor traffic split gauge."
          "8. If manual rollback needed: murakumo set-traffic-split 0 (full Rust revert)."
        ]
        :mttr-target-min 5
        :escalation-path "Level 1 (ack within 5min) → Level 2 (if not resolved in 10min)"
      }

      {
        :runbook-name "Parity Failure"
        :runbook-path "#parity-failure"
        :alert-trigger "ParityFailureRateCritical"
        :severity "critical"
        :steps
        [
          "1. Verify alert: Check parity-checker dashboard. Divergence rate >0.01%?"
          "2. Review audit logs: Which requests are diverging? Check request/response blobs."
          "3. Identify pattern: Is it customer data dependent? Specific route? Time-dependent?"
          "4. Reproduce: Can you repro divergence locally on staging?"
          "5. Root cause: Is it kgraph semantic mismatch? Serialization bug? Component logic?"
          "6. If quick fix: Deploy to staging, run parity tests, then production."
          "7. If not quick fix: Full auto-rollback triggers at 1min. Monitor alert & traffic split."
          "8. Post-incident: Create issue for application fix. Plan re-test before ramp resumption."
        ]
        :mttr-target-min 2
        :escalation-path "Level 1 (immediate page) → Level 3 (auto-rollback + owner notification)"
      }

      {
        :runbook-name "HTTP 5xx Errors"
        :runbook-path "#http-5xx"
        :alert-trigger "Http5xxRateElevated"
        :severity "critical"
        :steps
        [
          "1. Verify alert: Check error rate >1% sustained 2min."
          "2. Check node logs: What exceptions are being thrown?"
          "3. Check if it's customer-data dependent or infrastructure?"
          "4. If infrastructure: Restart affected node(s), monitor recovery."
          "5. If customer-data dependent: Identify which requests fail. Try to repro."
          "6. Root cause: Is it Chicory WASM exception? JVM exception? Network timeout?"
          "7. Auto-rollback triggers at 2min. Monitor traffic split & error rate."
          "8. Post-incident: Analyze logs, create issue, add test case for scenario."
        ]
        :mttr-target-min 3
        :escalation-path "Level 1 (ack within 2min) → Level 3 (auto-rollback)"
      }

      {
        :runbook-name "Memory Peak Exceeded"
        :runbook-path "#memory-peak"
        :alert-trigger "MemoryPeakExceeded"
        :severity "warning"
        :steps
        [
          "1. Verify alert: Check heap peak graphs. Any node >512MB?"
          "2. Check traffic level: At what traffic % did memory spike?"
          "3. Check GC logs: Is GC working correctly? Pause times acceptable?"
          "4. Take heap dump: jcmd <pid> GC.heap_dump_all /tmp/heap-<date>.hprof"
          "5. Analyze dump: Looking for leaks? Check object retention."
          "6. If memory leak confirmed: This is critical. Escalate to level 3, prepare rollback."
          "7. If transient spike: Monitor next few hours. Usually OK if heap returns to <256MB post-GC."
          "8. Mitigation: If traffic continues, consider increasing node pool size or reducing per-instance load."
        ]
        :mttr-target-min 15
        :escalation-path "Level 1 (investigate) → Level 2 (if leak likely)"
      }

      {
        :runbook-name "GC Pause Too Long"
        :runbook-path "#gc-pause"
        :alert-trigger "GCPauseP99TooLong"
        :severity "warning"
        :steps
        [
          "1. Verify alert: Check GC pause histogram. p99 >50ms?"
          "2. Check ZGC configuration: Is ZGC enabled? What are current tuning params?"
          "3. Check heap size: Is Xmx too large? Large heap = longer pause."
          "4. Check object allocation rate: High rate = more GC overhead."
          "5. Consider tuning: Try -XX:+UseZGC -XX:-ZGenerational or switch to Shenandoah."
          "6. Test in staging: Deploy new JVM config, run 1 hour benchmark."
          "7. If improvement: Roll out to production during next maintenance window."
          "8. Monitor: After deployment, verify p99 drops. Update baseline."
        ]
        :mttr-target-min 30
        :escalation-path "Level 1 (investigate) → Level 2 (tuning decision)"
      }

      {
        :runbook-name "Node Unhealthy"
        :runbook-path "#node-unhealthy"
        :alert-trigger "NodeHealthCheckFailing"
        :severity "critical"
        :steps
        [
          "1. Verify alert: Which node? Ping it: curl https://<node>:9090/health"
          "2. Check node logs: tail -f /var/log/murakumo-mesh-cljc.log"
          "3. Check system: SSH to node. Check CPU, disk, network, JVM status."
          "4. Is it a network blip or real issue?"
          "5. Attempt recovery: (a) restart process? (b) reboot node? (c) remove from pool?"
          "6. If recovery takes >5min: Remove node from pool via murakumo API."
          "7. Rebalance traffic: Remaining nodes will absorb load."
          "8. Investigate root cause: Why did node go unhealthy? Deploy fix."
          "9. Re-add node: After fix verified, re-add to pool."
        ]
        :mttr-target-min 5
        :escalation-path "Level 1 (ack immediately) → Level 2 (if recovery takes >10min)"
      }

      {
        :runbook-name "Murakumo Control Plane Down"
        :runbook-path "#murakumo-down"
        :alert-trigger "MurakumoControlPlaneDown"
        :severity "critical"
        :steps
        [
          "1. CRITICAL: Murakumo is down. Canary operations are blocked."
          "2. Page level 1 & level 3 immediately."
          "3. Verify: Is murakumo-01 actually unreachable? Try SSH, DNS, ping."
          "4. Check murakumo logs: /var/log/murakumo-control.log (if accessible)"
          "5. Check DB: Is murakumo DB reachable? Is it running?"
          "6. Mitigation: cljc nodes have local cache of last-known config. They will continue serving."
          "7. Business impact: Traffic ramp will be paused. Existing 50% traffic continues."
          "8. Recovery: Restore murakumo service. Check all nodes sync. Resume ramp if appropriate."
          "9. Post-incident: Improve murakumo HA (redundancy, failover)."
        ]
        :mttr-target-min 10
        :escalation-path "Level 1 (immediate) → Level 3 (owner notification immediately)"
      }

      {
        :runbook-name "Traffic Split Mismatch"
        :runbook-path "#traffic-split-mismatch"
        :alert-trigger "TrafficSplitMismatch"
        :severity "warning"
        :steps
        [
          "1. Check: Desired % vs Actual % divergence >5%?"
          "2. Is it a metric reporting lag? Wait 30s, check again."
          "3. Check murakumo: Is config in sync across all nodes?"
          "4. Check load balancer: Is traffic actually being split as desired?"
          "5. Possible causes: (a) some nodes haven't received config update (b) LB not propagating (c) metric calculation lag"
          "6. Action: SSH to each node, verify local config matches desired. Push if needed."
          "7. Verify metric: Re-calculate actual traffic split, ensure accuracy."
          "8. If still mismatched after 5min: Restart affected nodes to force sync."
        ]
        :mttr-target-min 15
        :escalation-path "Level 1 (investigate) → Level 2 (if manual action needed)"
      }
    ]
  }
}]
