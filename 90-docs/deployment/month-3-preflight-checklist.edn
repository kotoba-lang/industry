  :deployment/slo-dashboards-definition
  {
    :dashboard-type "Grafana"
    :panels
    [
      {
        :panel-id 1
        :title "Traffic Split (cljc vs Rust %)"
        :type "gauge"
        :metrics ["murakumo_traffic_split_cljc_percent"]
        :legend-position "right"
        :thresholds [{:value 0 :color "green"} {:value 25 :color "yellow"} {:value 50 :color "orange"} {:value 100 :color "red"}]
        :unit "percent"
        :description "Real-time traffic percentage routed to cljc mesh node pool vs Rust"
      }

      {
        :panel-id 2
        :title "Latency Distribution (p50/p95/p99)"
        :type "graph"
        :metrics
        [
          "drama_profile_latency_p50{node_runtime=\"cljc\"}"
          "drama_profile_latency_p50{node_runtime=\"rust\"}"
          "drama_profile_latency_p95{node_runtime=\"cljc\"}"
          "drama_profile_latency_p95{node_runtime=\"rust\"}"
          "drama_profile_latency_p99{node_runtime=\"cljc\"}"
          "drama_profile_latency_p99{node_runtime=\"rust\"}"
        ]
        :y-axis "ms"
        :alert-threshold-p99 100
        :alert-severity "critical"
        :description "Latency percentiles by runtime (cljc canary vs Rust baseline)"
      }

      {
        :panel-id 3
        :title "Parity Failure Rate (%)"
        :type "graph"
        :metrics ["parity_checker_failure_rate"]
        :y-axis "percent"
        :alert-threshold "0.05"
        :alert-severity "warning"
        :color-scheme "red"
        :description "Content-hash divergence: cljc response vs Rust response"
      }

      {
        :panel-id 4
        :title "GC Pause Time (p99)"
        :type "graph"
        :metrics
        [
          "jvm_gc_pause_p99{node_runtime=\"cljc\"}"
        ]
        :y-axis "ms"
        :alert-threshold 30
        :alert-severity "warning"
        :description "JVM ZGC pause time p99 (target ≤30ms)"
      }

      {
        :panel-id 5
        :title "Heap Memory Usage (peak)"
        :type "graph"
        :metrics ["jvm_memory_heap_peak_bytes{node_id=~\".*\"}"]
        :y-axis "MB"
        :alert-threshold-bytes 268435456
        :alert-severity "critical"
        :description "Peak heap per instance (post-GC stable)"
      }

      {
        :panel-id 6
        :title "HTTP 5xx Error Rate (%)"
        :type "graph"
        :metrics
        [
          "http_requests_5xx_total{node_runtime=\"cljc\"}"
        ]
        :y-axis "percent"
        :alert-threshold "0.1"
        :alert-severity "critical"
        :description "Unhandled exceptions & HTTP 500/503 rate"
      }

      {
        :panel-id 7
        :title "Component Performance (drama-profile)"
        :type "heat-map"
        :metrics ["drama_profile_component_latency_histogram_bucket"]
        :axis-x "time"
        :axis-y "latency (ms)"
        :color-scheme "viridis"
        :description "Latency heatmap of drama-profile route (identifies transient spikes)"
      }

      {
        :panel-id 8
        :title "Node Health (per-instance)"
        :type "status-map"
        :metrics
        [
          "node_health_status{node_id=\"staging-01\"}"
          "node_health_status{node_id=\"staging-02\"}"
          "node_health_status{node_id=\"staging-03\"}"
          "node_health_status{node_id=\"prod-cljc-01\"}"
          "node_health_status{node_id=\"prod-cljc-02\"}"
          "node_health_status{node_id=\"prod-cljc-03\"}"
        ]
        :status-mapping {:healthy "green" :degraded "yellow" :unavailable "red"}
        :description "Health status of all staging & production cljc nodes"
      }
    ]

    :dashboard-links
