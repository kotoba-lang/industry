  :deployment/rollback-architecture
  {
    :rollback-controller "murakumo-control-plane"
    :rollback-mechanism "autonomous + manual hybrid"
    :autonomous-triggers
    [
      {
        :trigger-id 1
        :trigger-name "LatencyRegressionP99"
        :condition "drama_profile_latency_p99{node_runtime=\"cljc\"} > 100"
        :sustained-duration-sec 300
        :action "revert to previous safe traffic state"
        :action-type "autonomous"
        :requires-approval false
      }

      {
        :trigger-id 2
        :trigger-name "ParityFailureRate"
        :condition "parity_checker_failure_rate > 0.01"
        :sustained-duration-sec 60
        :action "full revert to Rust (100%)"
        :action-type "autonomous"
        :requires-approval false
      }

      {
        :trigger-id 3
        :trigger-name "Http5xxRateElevated"
        :condition "rate(http_requests_5xx_total{node_runtime=\"cljc\"}[5m]) > 0.001"
        :sustained-duration-sec 120
        :action "full revert to Rust (100%)"
        :action-type "autonomous"
        :requires-approval false
      }

      {
        :trigger-id 4
        :trigger-name "MemoryPeakExceeded"
        :condition "jvm_memory_heap_peak_bytes{node_runtime=\"cljc\"} > 536870912"
        :sustained-duration-sec "sustained (no timeout)"
        :action "manual escalation + optional revert"
        :action-type "manual"
        :requires-approval true
      }
    ]

    :manual-triggers
    [
      {
        :trigger-id "M1"
        :trigger-name "Application-Level Parity Violation"
        :condition "kgraph semantic mismatch detected (non-transient)"
        :action "hold at current traffic %, debug on staging"
        :escalation "Level 2 → Level 3 if complex fix"
      }

      {
        :trigger-id "M2"
        :trigger-name "Business Priority Change"
        :condition "higher-priority feature blocks canary"
        :action "full revert to 100% Rust"
        :escalation "Owner decision"
      }

      {
        :trigger-id "M3"
        :trigger-name "Rust Fleet Degradation"
        :condition "Rust baseline p99 latency degrades >20% (unrelated to cljc)"
        :action "pause cljc ramp, investigate Rust issue"
        :escalation "Level 2 + Level 3"
      }
    ]
  }

