  :deployment/rollback-decision-tree
  {
    :root-question "An alert has fired. Is it a critical trigger?"

    :decision-tree
    {
      :if-latency-regression
      {
        :question "p99 latency >100ms sustained 5 min?"
        :yes {:action "autonomous-rollback to previous state" :example "50% → 25%"}
        :no {:question "Is it GC pause related?" :yes {:action "manual escalation (Level 2)" :note "likely tuning issue"} :no {:action "investigate (not rollback trigger)"}}
      }

      :if-parity-failure
      {
        :question "parity divergence >0.01% sustained 1 min?"
        :yes {:action "autonomous-full-revert to 0%" :note "data correctness issue must be fixed before ramp continues"}
        :no {:question "Is divergence <0.01% but not transient?" :yes {:action "manual escalation (hold at current %, debug on staging)"} :no {:action "continue, monitor"}}
      }

      :if-http-5xx
      {
        :question "HTTP 5xx rate >1% sustained 2 min?"
        :yes {:action "autonomous-full-revert to 0%" :note "reliability issue"}
        :no {:question "Is 5xx rate slowly rising?" :yes {:action "manual escalation (prepare rollback, debug)"} :no {:action "continue, monitor"}}
      }

      :if-memory-peak
      {
        :question "JVM heap peak >512MB sustained?"
        :yes {:action "manual escalation (page Level 2)" :options ["option-1: continue + add node" "option-2: step-back rollback" "option-3: full revert"]}
        :no {:question "Is memory trending upward (leak)?" :yes {:action "manual escalation, prepare rollback"} :no {:action "continue"}}
      }

      :if-node-unhealthy
      {
        :question "Node health-check failing for 2 min?"
        :yes {:action "remove node from pool, rebalance traffic" :note "no automatic fallback to Rust"}
        :no {:action "investigate (transient blip)"}}
      }

      :if-murakumo-down
      {
        :question "Murakumo control plane unreachable for 1 min?"
        :yes {:action "page Level 1 + Level 3 (owner)" :note "nodes continue serving from cache, no traffic loss expected"}
        :no {:action "investigate"}
      }
    }

