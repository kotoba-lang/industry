  :deployment/manual-rollback-procedure
  {
    :prerequisites
    [
      "SSH access to murakumo-control plane"
      "kototama/murakumo library installed locally"
      "PagerDuty access for acknowledgement"
      "Slack access for status updates"
    ]

    :procedure-step-by-step
    [
      {
        :step 1
        :title "Acknowledge Incident"
        :actions
        [
          "1. Acknowledge PagerDuty alert (if paged)"
          "2. Post to #strangler-fig-status: \"@channel INCIDENT: Initiating rollback. Reason: <trigger>\""
          "3. Check current traffic split: curl murakumo.mesh.internal/metrics | grep murakumo_traffic_split_cljc_percent"
        ]
      }

      {
        :step 2
        :title "Verify Rollback Decision"
        :actions
        [
          "1. Confirm with on-call (if you're not already primary)"
          "2. Review metrics: p99 latency, parity rate, 5xx rate, memory"
          "3. Determine target state: full revert (0%) or step-back to previous safe state"
          "4. Document decision & reasoning in incident log"
        ]
      }

      {
        :step 3
        :title "Execute Traffic Shift"
        :actions
        [
          "1. SSH to murakumo-01"
          "2. cd /opt/murakumo && nbb bin/murakumo.cljs traffic-set --cljc-percent <target-pct>"
          "3. Verify output: should print 'Traffic split updated to <target-pct>%'"
          "4. Immediately check metrics dashboard: murakumo_traffic_split_cljc_percent should reflect new value within 5s"
        ]
      }

      {
        :step 4
        :title "Monitor Transition"
        :actions
        [
          "1. Watch latency p99 graph: should stabilize at <100ms within 10s"
          "2. Watch parity rate: should drop below 0.01% (if parity was the trigger)"
          "3. Watch 5xx rate: should drop below 0.01% (if errors were the trigger)"
          "4. Watch node health: all Rust nodes should show healthy"
          "5. Duration target: complete transition within 30s"
        ]
      }

      {
        :step 5
        :title "Graceful Drain of cljc Nodes"
        :actions
        [
          "1. For full revert (to 0%): Issue graceful shutdown to all cljc nodes"
          "2. SSH to each cljc prod node: curl -X POST https://<node>:8443/shutdown/graceful"
          "3. Monitor in-flight requests: Check logs for request drain completion"
          "4. Expected drain time: 30s (timeout 30s for in-flight requests)"
          "5. Once drained, proceed to step 6"
        ]
      }

      {
        :step 6
        :title "Verify Rust Fleet Stability"
        :actions
        [
          "1. Check Rust pool latency: p99 should be at baseline (~100ms)"
          "2. Check Rust pool error rate: should be <0.01%"
          "3. Check Rust pool capacity: CPU/memory within normal range"
          "4. Spot-check: Send test request to drama-profile route, verify 200 OK"
        ]
      }

      {
        :step 7
        :title "Post-Incident Communication"
        :actions
        [
          "1. Post to #strangler-fig-status: \"✓ Rollback complete. Traffic: 100% Rust. Incident resolved. Investigating root cause.\""
          "2. Create incident postmortem issue in GitHub (if appropriate)"
          "3. Notify stakeholders: Slack DM to owner with summary"
          "4. Trigger incident review: Schedule retro within 24h (if critical incident)"
        ]
      }

      {
        :step 8
        :title "Root Cause Analysis (post-incident)"
        :actions
        [
          "1. Collect logs: Murakumo, cljc nodes, parity-checker"
          "2. Analyze: What specifically triggered the rollback?"
          "3. Categorize: Is it a known issue with a quick fix, or a new architecture problem?"
          "4. Plan: For quick fix: test fix on staging, re-deploy, restart canary. For architecture issue: schedule deep-dive."
        ]
      }
    ]

    :example-execution
    {
      :scenario "Parity divergence detected at 30% traffic"
      :trigger "parity_checker_failure_rate > 0.01 for 1 min"
      :decision "Roll back to 15% traffic (previous safe state)"
      :execution
      [
        "$ ssh murakumo-01"
        "$ cd /opt/murakumo"
        "$ nbb bin/murakumo.cljs traffic-set --cljc-percent 15"
        "Traffic split updated to 15%"
        "$ # Monitor metrics for 30s"
        "$ # Verify p99 latency drops below 100ms"
        "$ # Verify parity rate <0.01%"
        "$ # Verify all Rust nodes healthy"
        "✓ Rollback to 15% successful"
      ]
    }
  }

