      {
        :command-name "Graceful drain cljc nodes"
        :command "for node in staging-01 staging-02 staging-03 prod-cljc-01 prod-cljc-02 prod-cljc-03; do ssh $node curl -X POST https://localhost:8443/shutdown/graceful; done"
      }

      {
        :command-name "Check cljc node health"
        :command "for node in prod-cljc-01 prod-cljc-02 prod-cljc-03; do echo $node: && curl https://$node/health; done"
      }

      {
        :command-name "View Murakumo logs"
        :command "ssh murakumo-01 && tail -f /var/log/murakumo-control.log"
      }

      {
        :command-name "View cljc node logs"
        :command "ssh prod-cljc-01 && tail -f /var/log/murakumo-mesh-cljc.log"
