   {:role "murakumo Owner" :responsibility "Technical approval (parity, performance, reliability)" :contact "murakumo-owner@gftd.group"}
   {:role "Ops Lead" :responsibility "Infrastructure readiness, on-call readiness" :contact "ops-lead@gftd.group"}
   {:role "Metrics Lead" :responsibility "SLO verification (latency, error rates, parity)" :contact "metrics-lead@gftd.group"}
   {:role "Escalation Lead" :responsibility "Gate process, decision recording" :contact "escalation-lead@gftd.group"}]

