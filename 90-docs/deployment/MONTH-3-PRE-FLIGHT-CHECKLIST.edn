   :recommendation "Schedule combined gate meeting (45 min): first 20 min = Wave 5 M5 close review, next 25 min = Month 3 preflight review, final 10 min = joint GO/NO-GO decision for Week 14 + Month 3 canary."}

  :preflight/next-steps-if-go
  ["2026-09-11 09:00 JST: Start canary Stage 1 (50% → 75% traffic)"
   "2026-09-11 to 2026-09-12: Monitor latency, parity, reliability (minimum 4h per step)"
   "2026-09-12 to 2026-09-13: Continue 75% → 90% → 99%"
   "2026-09-13 to 2026-09-14: Final 99% → 100% cutover + Rust graceful drain"
   "2026-09-14+: Post-cutover monitoring (48h stability window)"]

  :preflight/next-steps-if-no-go
  ["2026-09-08 17:30 JST: Return to Phase 2 (50% traffic, reduce to 25%)"
   "2026-09-08 to 2026-09-15: Root cause analysis (1 week debugging window)"
   "2026-09-15: Retest + revalidate (parity, performance, reliability)"
   "2026-09-22: Second attempt at Month 3 preflight gate (1 week slip)"]

  :preflight/risk-matrix
  [{:risk "Parity divergence not detected until production (100% traffic)"
    :likelihood "MEDIUM"
    :impact "CRITICAL"
    :mitigation "7-day sentinel + parity-checker running continuously (< 2 min alert latency)"}
   {:risk "GC pause spike causes p99 budget breach during traffic ramp"
    :likelihood "MEDIUM"
    :impact "HIGH"
    :mitigation "ZGC/Shenandoah tuning completed in Month 2; GC latency monitoring in place"}
   {:risk "Rust pool health degradation during graceful drain (slow shutdown)"
    :likelihood "LOW"
    :impact "HIGH"
    :mitigation "Graceful shutdown procedure tested in staging; 30sec request timeout configured"}
   {:risk "False positive rollback trigger (e.g., transient latency spike)"
    :likelihood "MEDIUM"
    :impact "MEDIUM"
    :mitigation "Automatic rollback requires 5min sustained p99 > 100ms (not single spike)"}]

