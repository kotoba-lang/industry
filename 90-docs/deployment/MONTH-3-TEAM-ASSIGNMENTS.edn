  :team/fire-drill-schedule
  {:date "2026-09-08"
   :time "14:00 to 16:00 JST (2 hours, 2 hours before pre-flight gate)"
   :duration-minutes 120
   :attendees "All core roles + backups"
   :scenarios
   [{:scenario-id 1
     :name "Latency Regression Rollback"
     :setup "Simulate: p99 latency 210ms detected at Stage 1 (75% traffic)"
     :timeline
     ["14:05 - Monitoring-lead triggers rollback alert"
      "14:07 - Traffic-controller executes rollback script"
      "14:09 - Verify: traffic reverted to 50% cljc / 50% Rust"
      "14:11 - Latency resumes normal (95ms)"]
     :pass-criteria "Rollback executes < 2 min, no cascading failure"}
    {:scenario-id 2
     :name "Parity Divergence Full Rollback"
     :setup "Simulate: parity failure 1.5% detected at Stage 2 (90% traffic)"
     :timeline
     ["14:20 - Monitoring-lead triggers full rollback alert"
      "14:22 - Traffic-controller executes full rollback (100% Rust)"
      "14:24 - Verify: Rust pool handles 100% traffic"
      "14:26 - Escalation-lead logs decision: 'Full rollback due to parity divergence'"]
     :pass-criteria "Full rollback completes < 2 min, Rust stable"}
    {:scenario-id 3
     :name "Graceful Rust Drain (Staging Environment)"
     :setup "Pre-staged: cljc fleet at 99%, Rust at 1% (in staging)"
     :timeline
     ["14:35 - Traffic-controller starts drain sequence"
      "14:36 - Rust pool: stop accepting new connections"
      "14:37 - Rust pool: drain in-flight requests (monitor connection count)"
      "14:42 - Connections → 0, all in-flight completed"
