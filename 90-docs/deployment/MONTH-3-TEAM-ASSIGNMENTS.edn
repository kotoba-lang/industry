     :trigger "Automatic rollback to Phase 2 (50% / 50% Rust)"
     :root-cause "TBD (to be determined by post-incident review)"
     :timeline "13:05 alert, 13:07 rollback complete"
     :owner-decision "Extend pre-flight sentinel 1 week, retry Stage 2 on 2026-09-18"
     :documentation "90-docs/adr/MONTH-3-INCIDENT-PARITY-DIVERGENCE.edn (ADR record)"}]

   :contact-email "escalation-lead@gftd.group"
   :backup-contact "ops-lead@gftd.group"
   :on-call-days "2026-09-11 to 2026-09-14 (standby, activates on alert or gate decision)"
   :pre-flight-requirements
   ["Review this document (team assignments + communication channels)"
    "Verify Slack #prod-gates-wave5 is accessible and monitored"
    "Test PagerDuty alert routing"
    "Review decision-logging template (practice logging 2-3 sample decisions)"
    "Confirm owner availability for critical escalations"]}

  :team/on-call-overnight
  {:role-id "on-call-engineer-overnight"
   :assignment
   {:shift-1 "2026-09-11 17:00 to 2026-09-12 09:00 JST (16 hours) — TBD"
    :shift-2 "2026-09-12 17:00 to 2026-09-13 09:00 JST (16 hours) — TBD"
    :shift-3 "2026-09-13 17:00 to 2026-09-14 09:00 JST (16 hours) — TBD"
    :shift-4 "2026-09-14 09:00 to 2026-09-14 22:00 JST (13 hours, daytime coverage) — TBD"}

   :responsibilities
