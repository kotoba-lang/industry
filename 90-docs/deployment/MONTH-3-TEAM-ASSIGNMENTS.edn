     "SLO interpretation (latency, parity, reliability)"
     "Decision-making under pressure"
     "Post-incident analysis"]
    :contact-email "canary-lead@gftd.group"
    :on-call-days "2026-09-11 to 2026-09-14 (primary, all stages)"}

   {:role "Traffic Controller"
    :responsibility "Execute traffic ramp commands, monitor load balancer configs, implement rollbacks"
    :escalation-path "Canary Lead → Ops Lead"
    :required-skills
    ["Load balancer operation (Cloudflare / Kubernetes load balancer)"
     "Traffic routing rules"
     "Graceful shutdown procedures"
     "Emergency fail-over"]
    :contact-email "traffic-controller@gftd.group"
    :on-call-days "2026-09-11 (Stage 1 + overnight), 2026-09-12 (Stage 2 + overnight), 2026-09-13 (Stage 3 + drain)"}

   {:role "Monitoring Lead"
    :responsibility "Real-time SLO monitoring, alert response, metrics interpretation, health verification"
