    :on-call-days "2026-09-11 overnight, 2026-09-12 overnight, 2026-09-13 overnight"}]

  :team/pre-flight-requirements
  {:deadline "2026-09-08 16:00 JST (pre-flight gate)"
   :checklist
   [{:item "Runbook Review"
     :owner "escalation-lead"
     :target-team "All core roles"
     :document "MONTH-3-ROLLBACK-PROCEDURE.md + MONTH-3-CANARY-EXECUTION-TIMELINE.edn"
     :duration-minutes 60
     :verification "Slack sign-off: 'Runbook review complete'"}
    {:item "SLO Threshold Validation"
     :owner "monitoring-lead"
     :target-team "Traffic Controller, Monitoring Lead"
     :document "MONTH-3-PRE-FLIGHT-CHECKLIST.edn (Seq 1-3)"
     :duration-minutes 30
     :verification "Grafana dashboard walkthrough, confirm thresholds locked"}
    {:item "Fire Drill: Latency Regression Rollback"
     :owner "canary-lead"
     :target-team "All core roles"
     :scenario
     ["Simulate: p99 latency spike to 210ms (>100ms baseline + 100ms threshold)"
      "Trigger: Monitor detects sustained > 5 min"
      "Execute: Automatic rollback script (`murakumo/rollback.cljs`)"
      "Verify: Traffic reverts to previous stage within < 2 min"
      "Confirm: Rust pool resumes taking traffic, no cascading failure"]
     :duration-minutes 30
     :pass-criteria "Rollback executes successfully, team confident"
     :fail-criteria "Script error or > 5 min rollback time → fix before gate"}
    {:item "Fire Drill: Parity Divergence Full Rollback"
     :owner "monitoring-lead"
     :target-team "Monitoring Lead, Canary Lead"
     :scenario
     ["Simulate: parity failure rate 1.5% (>1% threshold)"
      "Trigger: Parity checker detects sustained > 1 min"
      "Execute: Full rollback to Phase 2 (50% Rust / 50% cljc)"
      "Verify: Rust pool resumes, traffic stable within < 2 min"]
     :duration-minutes 20
     :pass-criteria "Full rollback executes successfully"
    {:item "Graceful Shutdown Test (Staging)"
     :owner "ops-lead"
     :target-team "Traffic Controller, On-Call Engineer"
     :scenario
     ["Deploy staging Rust pool + cljc fleet"
      "Ramp to 99% / 1% split"
      "Execute graceful drain: stop new connections, drain in-flight"
      "Verify: all connections closed within 60s grace period"
      "Confirm: no cascading failure, cljc pool stable at 100%"]
     :duration-minutes 60
     :pass-criteria "Graceful shutdown completes within SLA"
    {:item "PagerDuty Escalation Policy Test"
     :owner "escalation-lead"
     :target-team "Escalation Lead, On-Call Engineer"
     :scenario
     ["Trigger: send test alert to pagerduty/prod-gates-wave5"
      "Verify: alert reaches Slack #prod-gates-wave5"
      "Verify: email notification sent"
      "Verify: phone call placed (if enabled)"
      "Measure: time from trigger to human acknowledgement"]
     :duration-minutes 20
     :pass-criteria "Alert routing works, ack time < 5 min"
    {:item "Team Briefing & Q&A"
     :owner "canary-lead"
     :target-team "All core roles"
     :document "This file (team assignments) + MONTH-3-CANARY-EXECUTION-TIMELINE.edn"
     :duration-minutes 45
     :topics
     ["Stage gates and decision points"
      "Automatic rollback triggers"
      "Manual override procedure (owner SLA)"
      "Communication channels (Slack, PagerDuty, email)"
      "Escalation paths for each alert type"
      "Post-incident review process"]}]}

