  :team/traffic-controller
  {:role-id "traffic-controller"
   :assignment "Primary: murakumo-ops-lead | Backup: TBD"
   :responsibilities
   ["Execute traffic ramp commands (load balancer rule changes)"
    "Monitor load balancer configs during ramp (confirm 5-min per increment)"
    "Alert monitoring-lead of any ramp delays or anomalies"
    "Execute automatic rollback script when triggered by monitoring-lead"
    "Execute manual rollback command when authorized by canary-lead"
    "Implement graceful Rust drain procedure (Stage 3b → drain)"
    "Monitor Rust pool connection count during drain"
    "Force shutdown (if hung > 60s grace period)"]

   :ramp-procedure
   {:general-process
    ["1. Receive ramp authorization from canary-lead (via Slack)"
     "2. Confirm current traffic split with monitoring-lead (e.g., '50% cljc, 50% Rust')"
     "3. Calculate target split (e.g., '75% cljc, 25% Rust')"
     "4. Execute load balancer rule change (staging in CloudFlare or K8s)"
     "5. Monitor Prometheus dashboard for 30s (confirm no immediate spike)"
     "6. Notify monitoring-lead: 'Ramp complete, now at 75% / 25%'"
     "7. Begin SLO monitoring window (4+ hours)"]
    :estimated-time-per-ramp-minutes 5
    :max-time-per-ramp-minutes 10
    :alert-threshold
    ["If p99 latency spike > 100ms detected within 5 min of ramp → pause ramp, notify canary-lead"
     "If parity spike > 0.5% → pause ramp"
     "If load balancer error (e.g., backend unavailable) → rollback immediately"]}

   :rollback-procedure
   {:automatic-rollback
    ["1. Monitoring-lead issues rollback command (auto-triggered by alert)"
     "2. Traffic-controller executes rollback script"
     "3. Load balancer rule reverts to previous stage traffic split"
     "4. Monitor for 30s confirmation (latency/error should normalize)"
     "5. Notify escalation-lead & canary-lead (Slack alert auto-posted)"]
    :manual-rollback
    ["1. Canary-lead authorizes manual rollback (Slack command)"
     "2. Traffic-controller executes rollback command"
     "3. Same verification as auto-rollback"
     "4. Escalation-lead documents rollback reason in Slack"]
    :target-time-to-rollback-seconds 120
    :max-time-to-rollback-seconds 300}

   :graceful-drain-procedure
   {:step-1-stop-new-connections
    ["Execute: set Rust pool drain flag (no new connections)"
     "Duration: 30 seconds"
     "Verify: load balancer stops routing new requests to Rust pool"
     "Monitor: Rust connection count should begin decreasing"]}
    :step-2-drain-in-flight
    ["Wait: let existing connections complete (grace period: 60 seconds)"
     "Monitor: Rust active connection count → 0"
     "Track: every 10 seconds, report connection count to monitoring-lead"
     "Handle: if connections > 10% after 30s, investigate (are they truly hung?)"
     "Force: if connections still exist after 60s grace period, force timeout + close"]
     :step-3-verify-migration
     ["Confirm: all session data now in cljc fleet"
      "Coordinate: with monitoring-lead to verify session parity"
      "Decision: if discrepancy found, rollback before deactivating Rust"]
     :step-4-deactivate
     ["Set: Rust pool to STANDBY (not accepting traffic, but infrastructure alive)"
      "Document: timestamp of final 0% traffic event"
      "Notify: team that Rust is on 7-day standby (until 2026-09-21)"]}

   :contact-email "ops-lead@gftd.group"
   :backup-contact "TBD"
   :on-call-days "2026-09-11 (Stage 1), 2026-09-12 (Stage 2), 2026-09-13 (Stage 3 + drain)"
   :pre-flight-requirements
   ["Review load balancer configuration (CloudFlare / K8s rules)"
    "Test ramp commands in staging (execute 5% increments)"
    "Review graceful drain procedure in staging (Rust drain with session migration)"
    "Fire-drill: automatic rollback script execution"
    "Confirm: communication channel (Slack for commands)"]}

  :team/monitoring-lead
  {:role-id "monitoring-lead"
   :assignment "Primary: murakumo-metrics-lead | Backup: TBD"
   :responsibilities
   ["Monitor SLO metrics in real-time during all stages (latency, parity, reliability, memory)"
    "Detect SLO violations and automatic rollback trigger conditions"
    "Alert escalation-lead & canary-lead of emerging issues (trending toward failure)"
    "Authorize traffic-controller to execute automatic rollback (when triggers fire)"
    "Verify SLO gates before each stage transition (sign-off on success criteria)"
    "Track parity failure rate (< 0.01% gate)"
    "Alert on edge-case failures (rare code paths at 99% traffic)"
    "Verify session data migration (100% migrated before Rust drain completion)"
    "Post-cutover validation (confirm all SLOs stable at 100% cljc)"]

   :slo-monitoring
   {:latency-p99
    ["Target: ≤ 100ms"
     "Trigger: sustained > 5 min → automatic rollback"
     "Monitoring tool: Prometheus drama_profile_http_latency_p99"
     "Frequency: check every 1 minute (or continuous dashboard watch)"
     "Escalation: if trending toward 110ms+ → alert canary-lead immediately"]}
    :latency-p95
    ["Target: ≤ 95ms"
     "Status: monitored but not automatic trigger (soft SLO)"
     "Escalation: if > 100ms, discuss with canary-lead (may indicate system stress)"]}
    :parity-failure-rate
    ["Target: < 0.01% (< 10 divergence per 1M requests)"
    "Trigger: > 1% sustained > 1 min → automatic FULL ROLLBACK"
     "Monitoring tool: murakumo/parity-checker metrics"
     "Frequency: check every 30 seconds (parity checker sensitive)"
     "Escalation: if trending toward 0.02% → alert canary-lead (may need to slow ramp)"
     "Critical: any parity divergence at 100% cljc (post-cutover) is data consistency issue → immediate investigation"]}
    :http-5xx-rate
    ["Target: ≤ 0.01% (< 1 error per 10K requests)"
     "Trigger: > 1% sustained > 2 min → automatic rollback"
     "Monitoring tool: Prometheus murakumo_errors_total (5xx bucket)"
     "Frequency: check every 1 minute"
     "Escalation: any spike → investigate root cause (GC pause, pool exhaustion, app bug)"]}
    :memory-per-instance
    ["Target: ≤ 256MB post-GC (at traffic load)"
     "Trigger: > 512MB peak → automatic rollback + investigate"
     "Monitoring tool: JVM metrics jvm_memory_heap_used"
     "Frequency: check every 5 minutes"
     "Watch: GC collection frequency (< 2 per minute expected)"]}
    :gc-pause-p99
    ["Target: ≤ 30ms"
     "Status: monitored for regression (soft SLO)"
     "Escalation: if > 50ms, investigate ZGC tuning"]}

   :stage-gate-sign-off
   {:gate-1-stage-1-success
    ["Verify: traffic ramp 50% → 75% completed"
     "Confirm: p99 latency ≤ 100ms sustained 4+ hours"
     "Confirm: parity failure < 0.01% over stage window"
     "Confirm: 5xx rate ≤ 0.01%"
     "Confirm: memory stable < 256MB"
     "Decision: 'Stage 1 PASS' (sign-off for gate)"]}
    :gate-2-stage-2-success
    ["Same verification as Stage 1, but at 90% traffic load"
     "Extra focus: confirm Rust pool still healthy at 10% traffic"
     "Decision: 'Stage 2 PASS' (sign-off for gate)"]}
    :gate-3-stage-3a-success
    ["Verify: 90% → 99% traffic ramp completed"
     "Confirm: all SLOs stable at 99% cljc / 1% Rust"
     "Watch: 1% Rust traffic for edge-case failures"
     "Decision: 'Stage 3a PASS' (sign-off for gate)"]}
    :gate-4-stage-3b-success
    ["Verify: 99% → 100% cutover executed"
     "Confirm: no immediate spike (latency p99 < 110ms post-cutover)"
     "Confirm: 5xx rate remains ≤ 0.01%"
     "Confirm: memory stable"
     "Decision: 'Stage 3b PASS' (sign-off for gate)"]}

   :session-migration-verification
   {:responsibility "Confirm 100% session data migrated from Rust to cljc"
    :procedure
    ["1. Before Rust drain: capture session count/IDs on cljc fleet"
     "2. Query: all user sessions present in cljc session map"
     "3. Spot-check: random sample of 100 sessions, verify data integrity"
     "4. Cross-check: compare session data with Rust baseline (if still available)"
     "5. Decision: 'Session migration verified 100%' (required before drain completion)"]
    :critical-gate "If discrepancy found → DO NOT PROCEED with Rust drain, escalate to canary-lead"}

   :contact-email "metrics-lead@gftd.group"
   :backup-contact "TBD"
   :on-call-days "2026-09-11 (Stage 1), 2026-09-12 (Stage 2), 2026-09-13 (Stage 3 + post-cutover)"
   :pre-flight-requirements
   ["Review Prometheus/Grafana dashboards (murakumo-mesh-latency, parity-checker, error-rate)"
    "Verify all SLO thresholds are locked in monitoring system"
    "Test automatic rollback script (trigger on simulated latency spike)"
    "Test parity checker (confirm divergence detection works)"
    "Fire-drill: detect and respond to multi-alert scenario (p99 spike + 5xx spike)"
    "Review session migration validation procedure"]}

