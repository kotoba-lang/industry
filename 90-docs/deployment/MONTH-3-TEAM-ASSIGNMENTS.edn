    :contact-email "monitoring-lead@gftd.group"
    :on-call-days "2026-09-11 (Stage 1 + overnight), 2026-09-12 (Stage 2 + overnight), 2026-09-13 (Stage 3 + post-cutover)"}

   {:role "Escalation Lead"
    :responsibility "Process coordination, decision logging, communication, incident management"
    :escalation-path "Canary Lead → Owner"
