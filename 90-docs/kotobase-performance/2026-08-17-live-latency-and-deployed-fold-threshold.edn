 {:claim "hops = (single-entry nodes written before segmentation) + ceil(entries written after / 16)"
  :inputs {:singles-at-2026-08-02 18   ; ADR-2608021000 §6-5, measured on this same graph
           :entries-today 63
           :entries-after-segmentation 45
           :segment-size 16}
