 :selection-rule
 {:universe
  {:source "manifest/west.yml at com-junkawasaki/root ae1b88ccd38"
   :project-entries 4199
   :entries-with-path 4191
   :note "8 entries carry no `path:` and were not examined."}

  :tree-read
  {:authority "the tree each project is PINNED at in west.yml, not the local worktree"
   :why "717 of 4191 local worktrees differ from their pin (573 do not even have
         the pin object fetched, 144 have HEAD elsewhere). A scan of local
         worktrees would have been a scan of a different codebase. Measured, not
         assumed: kotoba-lang/graph's local HEAD is 4159697 while its pin is
         77819fb.
         Cross-check: classifying local worktrees instead produced 888 candidates
         against the pinned scan's 889 -- the single difference being
         kotoba-lang/kotoba-code, a candidate at the pin that the local worktree
         did not show."
   :pinned-trees-read 4188
   :pinned-trees-unreadable 3
   :unreadable
   [{:repo "orgs/cloud-itonami/adserver" :rev "8a6b141ddf20c6ec46db6a45192bfa60f57c71b5"}
    {:repo "orgs/net-kotobase/engine"    :rev "dd6a043e7395db3f1668e572a03fabff10514436"}
    {:repo "orgs/kotoba-lang/states"     :rev "3538cedb41a39ff4dc52d9e55464d5f058c05f71"}]
   :note "These three are NOT counted as clean. The pin object is absent locally
          and the GitHub tree API did not return it either. I could not see them."}

  :rules
  [{:id :p1
    :name "npm-advertised nbb test tier"
    :test "repo-root package.json at the pin declares a script whose KEY matches
           /test|spec/i and whose COMMAND runs a suite through nbb"
    :excluded-from-rule "scripts where nbb only generates config before a
                         different runner does the testing, e.g.
                         `nbb gen-shadow-cljs-edn.cljs && shadow-cljs compile test
                         && node out/test.js` -- there the tier is shadow-cljs,
                         not nbb (12 rows / 11 repos, listed under :excluded)"
    :repos 889 :script-rows 982}
   {:id :p2
    :name "fleet-ci-advertised nbb tier"
    :test "scripts/fleet-ci/gates.edn entry with `:gate :nbb-test`"
    :repos 5
    :note "NONE of these five has an nbb script in package.json, so rule P1 misses
           all five. A survey built on package.json alone would have reported 100%
           coverage of a channel it never looked at."}
   {:id :p3
    :name "nbb entry under a non-test script key (supplementary)"
    :test "nbb script whose key is not test-ish but whose command names a
           test/smoke/verify/conformance/parity target"
    :repos 13 :script-rows 14
    :note "Found by measuring what P1 excludes rather than asserting P1 was
           complete. Two of the nine dead entry points found by this audit are
           here -- they would have been invisible to P1."}]

  :population {:repos 907 :entry-points 908
               :note "sigv4 contributes two entry points."}}

