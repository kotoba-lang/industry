;; フィールズ賞（Fields Medal）受賞者ナレッジ — 直近20年（ICM 2006〜2026）
;; as-of 2026-07-19 / WebSearch/WebFetch で一次情報（IMU公式サイト・AMS Notices・
;; Clay Mathematics Institute・London Mathematical Society・Fields Institute・
;; Wikipedia）を横断確認した上で構造化。形式は 90-docs/knowledge/README.edn の
;; 先行例（childrens-content-crude-humor.datoms.edn）と同じ kotoba-datomic /
;; DataScript / Datomic transaction 互換 EDN vector。使い方・クエリ例は README.edn 参照。
;;
;; 捏造ゼロ方針: :award/confidence :high は本セッションで複数の一次/準一次ソースを
;; 横断確認済み（IMU公式citation文言を含む）。:paper/confidence は個々の論文書誌
;; （巻号・ページ・arXiv ID）をこのセッションで再検証したもののみ :high、それ以外は
;; 学習知識由来のため :medium（外部引用前に一次ソースでの再確認を推奨）。
;; ICM 2026（2026-07-23、フィラデルフィア開催予定）は本ファイル作成時点（2026-07-19）で
;; IMUの公式発表前。ウェブサイト脆弱性による未確認リーク報道（Yu Deng・Hong Wang等の
;; 名前が一部メディアで報じられた）が存在するが、公式未確定のため laureate/award
;; entity は作らず :medal/icm2026 の :medal/note にリーク状況のみ記録する
;; （実在の個人に受賞事実を断定的に紐付けるリスクを避けるため）。
;;
;; transact: (d/transact! conn <this-vector>)
[
 ;; ---- schema: medal（ICM開催年）--------------------------------------------------
 {:db/ident :medal/id            :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :medal/year          :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :medal/icm-location  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :medal/ceremony-date :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; ISO date
 {:db/ident :medal/status        :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ; :confirmed | :pending
 {:db/ident :medal/note          :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}

 ;; ---- schema: laureate（受賞者）---------------------------------------------------
 {:db/ident :laureate/id          :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :laureate/name-en     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :laureate/name-ja     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; 確度の高い定訳がある人物のみ
 {:db/ident :laureate/birth-year  :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :laureate/nationality :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :laureate/institution :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; 受賞当時の所属
 {:db/ident :laureate/field       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; 専門分野（日本語要約）

 ;; ---- schema: award（受賞そのもの — medal × laureate の join）--------------------
 {:db/ident :award/id         :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :award/medal      :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
 {:db/ident :award/laureate   :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
 {:db/ident :award/citation   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; IMU公式citation原文（英語）
 {:db/ident :award/declined   :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one} ; Perelmanのみ true
 {:db/ident :award/note       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :award/confidence :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ; :high | :medium

 ;; ---- schema: paper（受賞理由に紐づく代表論文）------------------------------------
 {:db/ident :paper/id           :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :paper/laureate     :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one} ; 受賞者側の主著者
 {:db/ident :paper/related-award :db/valueType :db.type/ref    :db/cardinality :db.cardinality/one}
 {:db/ident :paper/title        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :paper/coauthors    :db/valueType :db.type/string  :db/cardinality :db.cardinality/many} ; laureate以外の共著者
 {:db/ident :paper/venue        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :paper/year         :db/valueType :db.type/long    :db/cardinality :db.cardinality/one} ; 出版年（arXiv投稿年と異なる場合あり）
 {:db/ident :paper/arxiv        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :paper/significance :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :paper/confidence   :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ; :high | :medium

