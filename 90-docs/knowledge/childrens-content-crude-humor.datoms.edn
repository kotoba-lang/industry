;; 子供向けコンテンツにおける下ネタ（crude/toilet humor・露出）規制の国別ナレッジ
;; + クレヨンしんちゃん (Crayon Shin-chan) の国別取り扱い事例
;; as-of 2026-07-17 / 会話由来の一般知識を構造化したもの（一次ソース未検証の行は
;; :confidence :medium 以下を付す。値の捏造禁止 — 不明は attribute ごと省略する）
;; 形式は 90-docs/adr/2607021500-portfolio-bmc-lean.datoms.edn の先行例と同じ
;; kotoba-datomic / DataScript / Datomic transaction 互換 EDN vector。
;; transact: (d/transact! conn <this-vector>)  ; DataScript は schema map へ変換して conn 作成
;; example queries は同 dir の README.md を参照。
[
 ;; ---- schema: country ---------------------------------------------------------
 {:db/ident :country/id          :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :country/name-ja     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :country/name-en     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :country/region      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 ;; 子供向け枠での下ネタ・露出への厳格度:
 ;;   :prohibited  = 子供向けとしては事実上不可（禁止・成人枠送り・大幅検閲が既定）
 ;;   :strict      = 大幅カット・編集を条件に子供向けが成立
 ;;   :moderate    = 部分的な修正はあるが概ね子供向けとして流通
 ;;   :permissive  = ほぼ無修正で子供向けとして流通
 {:db/ident :country/crude-humor-policy :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 ;; 規制の根拠となる構造（複数可):
 ;;   :broadcast-regulation 放送規制当局 / :religious-norms 宗教・道徳規範
 ;;   :state-censorship 国家による内容審査 / :litigation-social-pressure 訴訟・社会圧力
 ;;   :industry-self-regulation 業界自主規制
 {:db/ident :country/policy-basis :db/valueType :db.type/keyword :db/cardinality :db.cardinality/many}
 {:db/ident :country/regulator    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :country/note         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}

 ;; ---- schema: work（対象作品）--------------------------------------------------
 {:db/ident :work/id       :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :work/title-ja :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :work/title-en :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :work/origin   :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}

 ;; ---- schema: case（作品 × 国の取り扱い事例）-----------------------------------
 {:db/ident :case/id        :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :case/work      :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
 {:db/ident :case/country   :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
 ;; 取り扱い区分:
 ;;   :banned              一時的・恒久的な放送/出版禁止
 ;;   :adult-rated         成人・深夜枠として流通（子供向けでない判定）
 ;;   :censored-for-kids   検閲・編集を経て子供向けとして流通
 ;;   :publication-halted  出版停止（漫画等）
 ;;   :restricted          配信・放送対象からの除外（明示的 rating ではない）
 ;;   :aired-as-kids       概ね原型のまま子供向けとして流通
 {:db/ident :case/treatment :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :case/medium    :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ; :tv-anime / :manga / :streaming
 {:db/ident :case/year      :db/valueType :db.type/long    :db/cardinality :db.cardinality/one} ; 事象の起点年（不明なら省略）
 {:db/ident :case/rating    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; 現地レーティング表記（不明なら省略）
 {:db/ident :case/detail    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 ;; 出典の確からしさ: :high = 広く報道された事実 / :medium = 一般知識だが一次ソース未確認
 {:db/ident :case/confidence :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}

 ;; ==================================================================================
 ;; countries
 ;; ==================================================================================
