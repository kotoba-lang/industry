;; アニメ作品の国際配信ナレッジ — 国 × 放送局/プラットフォーム × 作品 × リリース
;; as-of 2026-07-17 / DataScript / Datomic / kotoba-datomic transaction 互換 EDN vector
;; 形式先行例: 同 dir の childrens-content-crude-humor.datoms.edn（README.md 参照）
;;
;; :country/* の attribute 定義は childrens-content-crude-humor.datoms.edn と同一なので、
;; 両ファイルを同じ DB に transact できる（:country/id が :db.unique/identity なので
;; 同一国 entity は upsert でマージされる）。
;;
;; 捏造ゼロ: :confidence :high = 当日 Wikipedia 等で裏取り済み（:source に URL）、
;; :medium = 一般知識で一次ソース未確認。不明な値は attribute ごと省略。
[
 ;; ---- schema: country（childrens-content-crude-humor.datoms.edn と同一定義）------
 {:db/ident :country/id      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :country/name-ja :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :country/name-en :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :country/region  :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}

 ;; ---- schema: network（放送局・チャンネル・配信プラットフォーム）-----------------
 {:db/ident :network/id      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :network/name    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :network/country :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one} ; 本拠国（global streaming は運営本拠）
 ;; :terrestrial 地上波 / :cable-satellite ケーブル・衛星 / :kids-channel 子供専門ch
 ;; :kids-block 子供向け放送枠 / :adult-block 深夜・成人向け枠 / :streaming 配信
 {:db/ident :network/type    :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :network/note    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}

 ;; ---- schema: work（childrens-content-crude-humor.datoms.edn と同一定義 + 追加）---
 {:db/ident :work/id       :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :work/title-ja :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :work/title-en :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :work/origin   :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
 {:db/ident :work/year-start :db/valueType :db.type/long  :db/cardinality :db.cardinality/one} ; TV シリーズ開始年

 ;; ---- schema: release（作品 × 国 × 放送局のリリース事実）-------------------------
 {:db/ident :release/id          :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :release/work        :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
 {:db/ident :release/country     :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
 {:db/ident :release/network     :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
 {:db/ident :release/medium      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ; :tv-anime / :streaming
 {:db/ident :release/year-start  :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :release/year-end    :db/valueType :db.type/long    :db/cardinality :db.cardinality/one} ; 継続中なら省略
 {:db/ident :release/title-local :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 ;; :uncut ほぼ無修正 / :censored カット・修正 / :localized 文化置換を含む改変 / :adult-recut 成人向け再構成
 {:db/ident :release/edit-status :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :release/rating      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :release/note        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :release/source      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; 裏取り URL
 {:db/ident :release/confidence  :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ; :high / :medium

