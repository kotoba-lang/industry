  :adr/decision-summary "{:pattern \"sealed StayBooking-LLM + independent StayGovernor + append-only audit ledger, a REGISTER-BOOK-DISCLOSE model (never captures payment, never issues physical access) mirroring cloud-itonami-isic-6311/isic-7820's containment pattern, mapped to the alternative-accommodation domain\", :new-actor \"cloud-itonami-isic-5590\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-5590\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"5590\", :isic-name \"Other accommodation\", :registry-promotion \"kotoba-lang/industry registry.edn id 5590: :maturity :spec (dead gftdcojp/cloud-itonami-I5590 placeholder URL) -> :implemented (real repo)\", :namespace \"stay\", :governor-checks [{:check :rbac :severity :hard} {:check :capacity-overbooking-gate :severity :hard :note \"new -- no analog in any other cloud-itonami actor; a proposed booking overlapping (half-open interval arithmetic) with other confirmed bookings at the same property, summed guest counts exceeding total capacity, is rejected regardless of LLM confidence\"} {:check :license-lapsed-gate :severity :hard :note \"new -- property license-status must be :active AND safety-cert-expiry must be on/after check-in, or the booking is rejected\"} {:check :source-provenance-gate :severity :hard :note \"license-basis (property/register) or booking-channel (booking/place) citation must be in stay.facts/allowed-source-classes; :operator-attested-license additionally requires an ACTIVE registered license record\"} {:check :licensed-disclosure :severity :hard} {:check :confidence-floor :severity :soft-escalate :note \"confidence < 0.6\"} {:check :guest-flagged-gate :severity :soft-escalate :note \"guest carries an operator caution flag -- always escalates to a human\"} {:check :dispute-request :severity :soft-escalate-unconditional :note \":dispute/request never auto-resolves at any confidence, any phase\"}], :deliberately-absent {:check :payment-capture-and-physical-access, :rationale \"this actor only registers properties, confirms bookings and serves reports -- it never captures a payment, executes a refund, or issues a physical door/key-code credential, so no schema field or governor check exists for those\"}, :actuation-invariant \":dispute/request never a member of any phase's :auto set at any phase; default-phase set to 1 (assisted-register, no auto-commit) from initial implementation, applying the fail-open fix already found this session in cloud-itonami-isic-6311/isic-7820's phase.cljc rather than retrofitting it later; :booking/place and :dispute/request are not even enabled until phase 2\", :r0-scope {:license-regimes [\"JPN 旅館業法 (Ryokan Business Act) 旅館業許可\" \"GBR Regulatory Reform (Fire Safety) Order 2005\"], :structural-class \"operator-attested-license -- other jurisdictions require an operator-registered ACTIVE license record, never a hardcoded free-regime claim\", :booking-channels [\"direct-booking-desk\" \"ota-partner-verified\"], :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as siblings\"}, :robotics {:value false, :key-present false, :rationale \"property registration and booking management is a paper/systems process; no physical delivery, custody, or actual lodging occurs inside the actor's boundary\"}, :test-results {:unit-tests \"33 tests / 144 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end: op1 property register -> commit, op2 unsourced booking -> hold (source-provenance-gate), op3/op3a over-tier and uncontracted report -> hold (licensed-disclosure), op4 license-lapsed property booking -> hold (license-lapsed-gate), op5 overlapping-date capacity overrun -> hold (capacity-overbooking-gate), op6 flagged-guest booking -> escalate -> approve -> commit, op7 booking dispute -> escalate -> approve -> commit\"}, :tooling-note \"scripts/gen-west-manifest.bb was migrated to scripts/gen-west-manifest.cljs (nbb) by a concurrent session but the migration is currently broken (references clojure.java.shell, a JVM-only namespace with no nbb equivalent, so the script throws on startup) -- tracked as a separate pending task, out of scope for this ADR. The industry pin advance for this ADR was instead performed via the CLAUDE.md-documented alternate path: fetch manifest/west.yml's current blob SHA via GitHub API, edit only the industry entry's revision line, PUT with sha= for optimistic-lock conflict detection (landed as commit 1b2f811f1016af4e8a3ae6e861b2bd8b05df0443, single-line diff, verified via GitHub API compare to be a clean fast-forward from the prior pin)\", :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention\"}"
