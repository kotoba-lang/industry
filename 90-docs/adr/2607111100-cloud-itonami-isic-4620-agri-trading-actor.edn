  :adr/decision-summary "{:pattern \"sealed AgriTradeAdvisor + independent :agri-trading-governor + append-only audit ledger, PRINCIPAL trading model (like fueltrade/shosha) with a biosecurity/food-safety regulatory backbone rather than fuel-excise/export-control\", :new-actor \"cloud-itonami-isic-4620\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-4620\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"4620\", :isic-name \"Wholesale of agricultural raw materials and live animals\", :registry-promotion \"kotoba-lang/industry registry.edn id 4620: :maturity :spec (dead gftdcojp/cloud-itonami-G4620 placeholder URL) -> :implemented (real repo)\", :namespace \"agritrade\", :consignment-kind-split {:rationale \"ISIC 4620 bundles two legally distinct regulatory regimes (plant-derived commodities vs live animals) under one code; a single generic certificate check would blur which regime failed on the audit ledger\", :checks [{:check :phytosanitary-certificate-missing, :fires-for :plant, :field :phytosanitary-certificate?} {:check :animal-health-certificate-missing, :fires-for :animal, :field :animal-health-certificate?}]}, :governor-checks [{:check :no-spec-basis :severity :hard} {:check :evidence-incomplete :severity :hard} {:check :credit-uncleared :severity :hard} {:check :contract-missing :severity :hard} {:check :phytosanitary-certificate-missing :severity :hard} {:check :animal-health-certificate-missing :severity :hard} {:check :counterparty-sanctions-flag-unresolved :severity :hard} {:check :already-dispatched :severity :hard} {:check :already-invoiced :severity :hard} {:check :high-stakes-actuation-gate :severity :soft-escalate :note \":delivery/dispatch and :invoice/settle never auto-commit at any phase\"}], :robotics {:value true, :rationale \"grain-elevator conveyance (augers/belts/weighbridge loadout) is a real automation claim analogous to fueltrade's rack robot; livestock loadout automation (chute/gate control) is real but always human-attended per real animal-welfare transport law, not a full unattended-robot claim -- asymmetry documented in README/business-model.md; explicitly NOT copied from the isic-4690/isic-4610 siblings' :robotics false, reasoned per-domain instead\"}, :r0-scope {:source-catalog [\"JPN 植物防疫法 (laws.e-gov.go.jp/law/325AC0000000151) / 家畜伝染病予防法 (laws.e-gov.go.jp/law/326AC1000000166), both MAFF\" \"USA Plant Protection Act (7 U.S.C. §7701 et seq.) / Animal Health Protection Act (7 U.S.C. §8301 et seq.), both APHIS/USDA\" \"GBR Plant Health regulations / Animal Health Act 1981, APHA\" \"EU (DEU representative) Regulation (EU) 2016/2031 (Plant Health Law) / Regulation (EU) 2016/429 (Animal Health Law)\"], :citations-verified \"headline statutes and regulators independently re-verified via WebSearch at ADR-authoring time; UK Plant Health regulation's exact title and German Länder-level implementing legislation names remain unverified, flagged for follow-up\", :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as siblings\"}, :test-results {:unit-tests \"41 tests / 212 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end: clean plant order + clean animal order through intake->verify->dispatch->settle, plus both certificate-missing HARD holds and the other HARD holds\"}, :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. Only kotoba-lang/industry pin advanced in manifest/west.yml (--entry industry, minimal diff)\"}"
  :adr/authoritative true
