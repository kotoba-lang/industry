[{:adr/status "accepted", :adr/id "adr-2607082500-kotoba-lang-kasane-utsushi-reverse-domain-decomposition", :adr/repo ["orgs/kotoba-lang/kasane" "orgs/kotoba-lang/utsushi" "orgs/kotoba-lang/org-ietf-deflate" "orgs/kotoba-lang/org-adobe-tiff" "orgs/kotoba-lang/org-iso-jpeg" "orgs/kotoba-lang/org-iso-opentype" "orgs/kotoba-lang/org-w3-epub" "orgs/kotoba-lang/org-oasis-odf" "orgs/kotoba-lang/org-w3-png" "orgs/kotoba-lang/org-compuserve-gif" "orgs/kotoba-lang/org-pkware-zip" "orgs/kotoba-lang/org-iso-pdf" "orgs/kotoba-lang/org-w3-woff" "orgs/kotoba-lang/org-iso-isobmff" "orgs/kotoba-lang/org-iso-h264" "orgs/kotoba-lang/org-iso-aac" "orgs/kotoba-lang/org-ietf-opus"], :adr/decision "{:naming [{:group \"org-iso-*\", :members [\"org-iso-jpeg\" \"org-iso-h264\" \"org-iso-aac\" \"org-iso-isobmff\" \"org-iso-pdf\" \"org-iso-opentype\"], :rationale \"ISO/IEC numbering (10918-1/14496-10/13818-7/14496-12/32000/14496-22) is the identifier implementers cite most; keeps the prefix consistent across this batch's jointly-ITU/ISO-published codec specs\"} {:name \"org-compuserve-gif\", :rationale \"CompuServe's GIF89a spec doc is real and current (w3.org mirrors it); same 'vendor-published-but-real-spec' pattern as Adobe/PKWARE/Synopsys\"} {:name \"org-adobe-tiff\", :rationale \"Adobe's published TIFF 6.0 spec, same pattern\"} {:name \"org-pkware-zip\", :rationale \"PKWARE still publishes/maintains APPNOTE.TXT, same pattern\"} {:group \"org-w3-*\", :members [\"org-w3-png\" \"org-w3-woff\" \"org-w3-epub\"], :rationale \"W3C Recommendation (PNG/WOFF at w3.org/TR; EPUB3 post-IDPF-merger)\"} {:group \"org-ietf-*\", :members [\"org-ietf-deflate\" \"org-ietf-opus\"], :rationale \"RFC-numbered IETF specs (1951/1950, 6716)\"} {:name \"org-oasis-odf\", :rationale \"OASIS standard, also ISO/IEC 26300\"}], :key-findings [{:finding \"kasane.isobmff (AVIF/HEIC meta walker) and utsushi.container/demux/mux/remux (MP4) were independent duplicate implementations of the SAME spec (ISO/IEC 14496-12)\", :bonus-fix \"utsushi's box walker didn't know 'meta' is a FullBox (4-byte version+flags prefix before children); kasane's did. Merging carried the fix into the shared org-iso-isobmff engine.\"} {:finding \"utsushi.bitstream's 3 functions (split-annexb/parse-sps/parse-adts) were all unimplemented TODO stubs, not extractable code\", :action \"implemented for real as new repos instead of extracting: org-iso-h264, org-iso-aac, plus org-ietf-opus (Opus had no prior code at all, not even a stub)\"} {:finding \"kasane.gltf/kasane.svg/kasane.json/kasane.normalize's ooxml->doc have existing kotoba-lang counterparts (org-khronos-gltf+glb, org-w3-svg, kotoba-lang/json, ooxml+office+office-style+drawingml) that are either the opposite direction (write-only vs kasane's read-only) or fully duplicate\", :action \"left unchanged in this batch -- deletion isn't safe without integrating read-capability into the existing sibling repos first; recorded as follow-up in both kasane and utsushi READMEs\"}], :kasane-extractions [{:from \"kasane.codec.inflate\", :to \"org-ietf-deflate\", :spec \"DEFLATE(RFC1951)+zlib(RFC1950)\", :deps []} {:from \"kasane.png\", :to \"org-w3-png\", :spec \"PNG\", :deps [\"org-ietf-deflate\"]} {:from \"kasane.gif\", :to \"org-compuserve-gif\", :spec \"GIF89a\", :deps []} {:from \"kasane.tiff\", :to \"org-adobe-tiff\", :spec \"TIFF 6.0\", :deps []} {:from \"kasane.zip\", :to \"org-pkware-zip\", :spec \"ZIP\", :deps [\"org-ietf-deflate\"]} {:from \"kasane.jpeg+kasane.jpeg.decode\", :to \"org-iso-jpeg\", :spec \"JPEG\", :deps []} {:from \"kasane.ttf\", :to \"org-iso-opentype\", :spec \"TrueType/OpenType\", :deps []} {:from \"kasane.woff\", :to \"org-w3-woff\", :spec \"WOFF 1.0\", :deps [\"org-iso-opentype\" \"org-ietf-deflate\"]} {:from \"kasane.isobmff\", :to \"org-iso-isobmff\", :spec \"ISOBMFF\", :deps [], :note \"merged with utsushi's MP4 pipeline\"} {:from \"kasane.cos\", :to \"org-iso-pdf\", :spec \"PDF/COS (ISO 32000)\", :deps [\"org-ietf-deflate\"]} {:from \"kasane.normalize/epub->doc\", :to \"org-w3-epub\", :spec \"EPUB 3\", :deps [], :note \"pure fn over pre-unzipped entries\"} {:from \"kasane.normalize/odf->doc\", :to \"org-oasis-odf\", :spec \"ODF\", :deps [], :note \"pure fn over pre-unzipped entries\"}], :kasane-remains [\"kasane.bytes\" \"kasane.decode (EDN grammar engine)\" \"kasane.codec (PackBits only, for PSD)\" \"kasane.normalize/kasane.schema (common :kasane/doc model, still usable by any extracted repo's raw parse output)\" \"PSD/BMP/Sketch (kasane's own native flagship formats)\" \"kasane.gltf/kasane.svg/kasane.json/ooxml->doc (follow-up, unchanged)\"], :utsushi-extractions [{:from \"utsushi.container+demux+mux+remux+bytes+blob\", :to \"org-iso-isobmff\", :spec \"ISOBMFF\", :note \"unified with kasane.isobmff\"} {:from \"utsushi.bitstream (TODO stub)\", :to \"org-iso-h264\", :spec \"H.264 Annex B framing + SPS\", :new-impl true, :validation \"real libx264-encoded baseline fixture; SPS-derived 64x48 matches the encode source exactly\"} {:from \"utsushi.bitstream (TODO stub)\", :to \"org-iso-aac\", :spec \"AAC ADTS framing\", :new-impl true, :validation \"real ffmpeg/libavcodec-encoded fixture; matches ffprobe's 44100Hz mono exactly, frame boundaries self-consistent across the file\"} {:from nil, :to \"org-ietf-opus\", :spec \"Opus TOC + frame-packing (RFC 6716)\", :new-impl true, :validation \"hand-computed byte layouts against RFC 6716's precisely-specified config table and length-coding rules\"}], :utsushi-remains [\"utsushi.codec (R1 native-boundary facade, now requires isobmff.blob)\" \"utsushi.graph/utsushi.pregel (filtergraph BSP orchestration, now requires isobmff.bytes/blob/demux/remux)\" \"utsushi.policy (capability/effect/gas model)\" \"utsushi.quads (media/* datom projection)\"], :layering-principle {:rule \"extracted format repos are leaves; no repo depends back on kasane/utsushi\", :shared-dep-exception \"org-ietf-deflate only -- byte-identical across all its consumers (PNG/ZIP/WOFF/PDF), unlike PackBits/LZW which have format-specific bit-packing variants (TIFF=MSB/early-change, GIF=LSB/non-early) not worth centralizing\", :small-duplication-tolerated \"byte-cursor primitives, PackBits, per-format LZW variants each live in their own repo rather than a shared micro-lib, matching the pre-existing utsushi.bytes/kasane.bytes coexistence precedent\"}}", :adr/date "2026-07-08", :db/id -1, :adr/builds_on ["90-docs/adr/2607072500-kotoba-lang-semiconductor-standards-reverse-domain-batch.md" "90-docs/adr/2607052300-kotoba-lang-turn-rt-net-signal-reverse-domain-rename.md" "90-docs/adr/2606272100-adobe-edn-kasane.md" "90-docs/adr/2606272200-utsushi-video-edn-filtergraph.md" "90-docs/adr/2606280010-kasane-jpeg-dct-decode.md"], :adr/landing "{:kasane {:method \"worktree clone -> commit -> push branch -> gh api merges (server-side, base=main clean, no local 3-way fight)\", :merge-sha \"dec26ed57bf45fc6af255bb1ccbae78f4a9b9c56\"}, :utsushi {:method \"same\", :merge-sha \"ede15d1c587a4a7c3443608a868a7a401c22eea7\"}, :manifest {:method \"repos.edn edit + gen-west-manifest.cljs --entry (minimal diff, no wholesale regen) -> branch -> gh api merges\", :merge-sha \"1e5b7746a2bc589bade6225bd169772adfabde99\"}}", :adr/status_note "All 15 new repos scaffolded/tested/pushed. kasane and utsushi rewired to depend on the extracted repos and re-verified green. Manifest registration landed (repos.edn + west.yml, 17 entries). Both originally-outstanding follow-ups are now DONE (see :addendum-2607082500b below): kasane.gltf/svg/json/ooxml->doc integrated into their existing sibling repos, and org-iso-h264 wired into utsushi's filtergraph :decode node (org-iso-aac/org-ietf-opus deliberately left unwired -- ADTS/Opus TOC framing is already resolved by MP4 demux, so utsushi.codec's post-demux framing role has no applicable target for them).", :adr/authoritative true, :adr/verification "{:new-repos {:count 15, :quality-bar \"zero-dep .cljc, Apache-2.0, ported tests+fixtures (or new tests 