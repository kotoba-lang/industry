(vector (map (:db/id -1)
  (:adr/id "adr-2607196200-kami-automation-modes-threaded-caption-review")
  (:adr/title "KAMI adds transport automation modes and threaded caption review")
  (:adr/date "2026-07-19")
  (:adr/status "accepted")
  (:adr/authoritative true)
  (:adr/topic "kotoba-lang-media-authoring")
  (:adr/supersedes (vector "adr-2607196100-kami-mix-interpolation-caption-review-audit"))
  (:adr/decision
  (map (:daw (map (:transport-authority :monotonic-musical-tick-clock)
         (:automation-mode-authority :plugin/automation-mode)
         (:automation-modes (vector :read :touch :latch :write))
         (:write-authority :plugin/mix-automation)
         (:touch-policy :gesture-only)
         (:latch-policy :gesture-then-continuous-until-stop)
         (:write-policy :continuous-during-transport)
         (:same-tick-policy :replace)
         (:stop-policy :clear-runtime-latches)))
   (:nle (map (:thread-authority :caption/review-notes)
         (:thread-fields (vector :review/id :review/thread-id :review/parent-id :review/author :review/text :review/at))
         (:resolution-authority :review/resolution-history)
         (:resolution-fields (vector :resolution/resolved? :resolution/actor :resolution/at))
         (:resolved-reply-policy :reject)
         (:orphan-reply-policy :reject)
         (:reviewer-unassignment-policy :supported)
         (:translation-clone-reviewer-policy :unassigned)))
   (:maturity (map (:kami-app-daw :逍遥) (:kami-app-nle :逍遥)))
   (:remaining-commercial-gates
   (map (:shared (vector "persistent directory grants" "streaming package I/O above 512 MiB"))
    (:daw (vector "third-party plugin SDK/isolation" "automation thinning/trim" "surround/Atmos"))
    (:nle (vector "mentions and notifications" "tamper-evident signatures" "translation memory" "TTML/IMSC" "OCIO/ICC/HDR"))))))
  (:adr/implementation
  (map (:daw-commits (vector "d8892f39bbe86fd7aa62975b648dee390af2684d"))
   (:nle-commits (vector "ad7d9249fe635070b79e93367c8e1cf72218d087"))
   (:pull-requests (vector "kotoba-lang/kami-app-daw#20" "kotoba-lang/kami-app-nle#20"))
   (:evidence
   (vector "DAW passes 28 tests and 113 assertions; NLE passes 29 tests and 140 assertions after translation-reviewer ownership hardening."
    "Both guarded shadow-cljs production releases completed with zero compiler warnings after the DAW transport forward-reference warning was repaired."
    "Chrome observed the DAW transport advance from tick 1440 to tick 1657 during playback."
    "Chrome downloaded DAW project EDN containing :plugin/automation-mode :write and ten musical-tick automation entries from one transport run."
    "Chrome created a caption thread and reply, resolved and reopened it, then downloaded EDN containing parent linkage, two resolution events and actor mika."
    "Unit evidence rejects Read writes, inactive Touch writes, orphan replies, replies to resolved threads and contradictory resolution history."
    "Translation clones start draft with empty review audit and no inherited reviewer assignment."
    "Automated Chrome and both local servers were closed after verification."
    "Both application PRs were reviewed and merged."))))
  (:adr/consequences
  (vector "Wet-mix automation now follows a moving musical transport and established Read, Touch, Latch and Write workflows."
   "Caption discussions can retain reply topology and auditable resolve/reopen history in projects and packages."
   "Review assignment does not leak from source-language cues into translation ownership."
   "Automation thinning, notifications and cryptographic review integrity remain explicit commercial-product gaps."))
  (:adr/source-format "edn")))
