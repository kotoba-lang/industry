[{:adr/consequences "{:landed \"pay.x402 is complete as a codec; remaining work is the Worker middleware + deploy,\\n           which touches an owner-owned Cloudflare target (shinshi worker) and is separated out\\n           to respect the concurrent-subagent conflict-avoidance rule established this session\", :eip3009_host \"the exact-scheme on-chain authorization relay (gasless transfer submit/confirm)\\n                 lives outside pay/treasury (Worker + base-l2/wallet); pay.x402 does shape +\\n                 economic validation + decision purely\", :rail_relationship \"ADR-2607071900's /pay/* stays as the out-of-band human path; x402 is the\\n                      in-band agent/per-request path; both verify via treasury and settle to the\\n                      same JK株式会社 treasury (tx-hash attribution)\", :vendor_relationship \"we adopt the standard (x402) and run our own facilitator rather than\\n                        becoming a Monetization Gateway customer; same wire means low migration\\n                        cost if CF's facilitator is ever used — no lock-in by design\"}", :adr/authoritative_for ["x402 (HTTP 402 Payment Required) is adopted as the standard in-band wire protocol for\n    the kotoba-lang/pay rail, implemented as the pure .cljc codec pay.x402 (landed)" "we run as our OWN x402 facilitator over kotoba-lang/treasury (Base L2 / USDC), not\n    Cloudflare's closed facilitator-as-a-service — no waitlist, no vendor lock-in, agent-native" "pay.x402 is the protocol layer only (zero-dep/zero-I/O/zero-custody): payment-requirements/\n    challenge build the 402 body, encode/decode-header do UTF-8 base64 envelopes, payload-errors\n    validates the exact (EIP-3009) and transaction (tx-hash) schemes, authorize is the x402 form\n    of entitle (serve only on confirmed settlement, else hold 402)" "staged adoption in reverse-toposort order: L0 club-shinshi PPV gating, L3 net-kotobase\n    storage GET / cloud-murakumo inference per-request USDC billing (the DePIN monetization path)"], :adr/supersedes [], :adr/superseded_by [], :adr/topic "x402-monetization-gateway-integration", :adr/related ["90-docs/adr/2607092700-shinshi-inc-settlement-kotoba-lang-pay.md" "90-docs/adr/2607071900-club-shinshi-receive-only-usdc-rail.md" "90-docs/adr/2607051621-treasury-extraction.md"], :adr/status "accepted", :adr/id "adr-2607093100-x402-monetization-gateway-integration", :adr/doc_type "adr", :adr/last_verified "2026-07-09", :adr/decision "{:adopt \"x402 as the standard wire protocol for kotoba-lang/pay\", :library {:ns \"pay.x402\", :status \"landed (14 tests / 85 assertions, clj-kondo clean)\", :invariants \"pure .cljc, zero-dep, zero network I/O, zero key custody — protocol layer only\", :api [\"payment-requirements / challenge — build the 402 body (price via parse-usdc, micros)\" \"encode-header / decode-header — portable UTF-8 base64 for X-PAYMENT / X-PAYMENT-RESPONSE\\n          (JSON serialization stays host-side to keep zero-dep)\" \"payload-errors / acceptable? — pure validation of a decoded payment vs requirements\\n          (scheme/network/recipient/amount/expiry) for exact (EIP-3009) and transaction (tx-hash)\" \"authorize — verify-before-serve decision (x402 form of entitle): serve only when host\\n          confirms on-chain settlement, else hold at 402\"]}, :facilitator \"self-hosted via treasury/verify-payment (transaction scheme) or host-submitted\\n                EIP-3009 authorization (exact scheme); pay.core/verification<-treasury bridges\\n                treasury results into authorize. No keys held.\", :worker_middleware \"follow-up (reviewed, undeployed): a thin cljs Worker middleware — no\\n                      X-PAYMENT => 402 challenge; X-PAYMENT present => decode -> authorize ->\\n                      serve. JSON.stringify/parse Worker-side. club-shinshi /pay/* coexists\\n                      (human flow); x402 is the added in-band agent/per-request path (superset).\", :staging [\"L0: gate club-shinshi PPV scene unlocks via x402 (agent buyers + existing /support\\n             human flow share one treasury)\" \"L3: net-kotobase storage GET / cloud-murakumo inference per-request USDC billing —\\n             the usage-based-pricing-for-everything path, DePIN-layer monetization\" \"Web Bot Auth (CF verified agent identity) optional future add-on\"]}", :db/id -1, :adr/problem "{:source \"owner directive 2026-07-09: 'blog.cloudflare.com/monetization-gateway を設計統合してみて'\", :investigated [\"Cloudflare Monetization Gateway == x402: in-band HTTP 402 with price/asset/payTo in the\\n    response body, buyer (human wallet OR autonomous agent) pays a stablecoin and re-requests\\n    with an X-PAYMENT proof header, facilitator verifies, resource served with X-PAYMENT-RESPONSE\\n    receipt; no redirect, no checkout, no seller onboarding\" \"structural match to what we already own: kotoba-lang/pay (entitle verify-before-honor,\\n    PayRail seam, USDC micros) + kotoba-lang/treasury (USDC on-chain verify) + club-shinshi's\\n    /pay/quote|claim|status which is x402 done out-of-band and non-standard\" \"we can be our OWN facilitator (treasury on-chain verify + pay entitle) instead of a closed\\n    vendor service — no waitlist, settle on Base L2 / USDC already under control\" \"strategic fit: x402 makes per-request billing ($0.01/GET) work for agents — the exact\\n    mechanism to monetize L3 (murakumo inference / kotobase storage) in USDC, closing the\\n    reverse-toposort loop beyond the adult leaves\"], :risk \"EIP-3009 authorization relay (gasless USDC transfer submitted by the facilitator) is\\n         host responsibility (Worker + base-l2/wallet); needs gas/nonce/replay-protection review\\n         before production. pay.x402 itself is pure shape/economic validation + decision only.\"}", :adr/alternatives "[{:option \"adopt Cloudflare Monetization Gateway (closed waitlist) directly\", :rejected_because \"waitlist dependency + vendor-fixed facilitator; would discard the\\n                      treasury/pay settlement stack we already own. Taking only the standard\\n                      (x402) is sovereign and lock-in-free.\"} {:option \"keep only the out-of-band /pay/* rail\", :rejected_because \"cannot serve the agent economy (the article's core) or express per-request\\n                      billing (L3 monetization) naturally; x402's in-band 402 is the agent-native\\n                      standard\"} {:option \"put on-chain verification inside pay.x402\", :rejected_because \"breaks the library's zero-I/O / zero-dep invariants; keep protocol (pure)\\n                      and settle (host-injected) separate, matching the PayRail/entitle seam\"}]", :adr/authoritative true, :adr/title "ADR-2607093100: integrate x402 (Cloudflare Monetization Gateway) as the standard wire protocol for the kotoba-lang pay rail", :adr/references ["https://blog.cloudflare.com/monetization-gateway/"]}]