(vector (map (:db/id -1)
  (:adr/id "adr-2608220100-openicc-autonomous-icc-procedure-bots")
  (:adr/title "openicc — autonomous Rome Statute procedure bots, where publication is a consensus act")
  (:adr/status "accepted")
  (:adr/date "2026-08-22")
  (:adr/repo "etzhayyim/openicc")
  (:adr/related (vector "adr-2608221500-kosatsu-durability-plane-anchor-delegation"
                "adr-2605301600-danjo-public-accountability-oversight"
                "adr-2608038000-inga-consensus-holochain-write-plane-filecoin-state-plane"
