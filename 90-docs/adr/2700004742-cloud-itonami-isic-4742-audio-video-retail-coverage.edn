[{:adr/id 2700004742
  :adr/title "cloud-itonami-isic-4742 — Audio/Video-Equipment Retail Operations Coordination"
  :adr/status :accepted
  :adr/date "2026-07-16"
  :adr/scope [:kotoba-lang/industry :cloud-itonami/cloud-itonami-isic-4742]
  :adr/references [2607121000 2680004719]

  ;; Wave 2 actor (coordination/logistics/trade): retail sale of audio
  ;; and video equipment in specialized stores (TVs, home-theater
  ;; systems, speakers, headphones, car audio, projectors and related AV
  ;; gear) operations coordination-only (sales/inventory/return/
  ;; warranty-registration logging, staffing/delivery scheduling,
  ;; supply-order coordination, warranty-concern flagging). Fresh
  ;; scaffold -- no pre-existing repo (gh api 404-confirmed).

  :actor/id :cloud-itonami-isic-4742
  :actor/name "Audio/Video-Equipment Retail Operations Coordinator"
  :actor/isic-rev5 "4742"
  :actor/domain :retail/audio-video-equipment
  :actor/wave 2
  :actor/coordination? true
  :actor/robotics? true

  :actor/proposal-ops [:log-sales-record :schedule-staffing-operation
                       :coordinate-supply-order :flag-warranty-concern]
  :actor/always-escalate-ops [:flag-warranty-concern]
  :actor/cost-threshold-escalate-ops {:coordinate-supply-order 1000}

  :actor/hard-checks [:store-verified :vendor-verified :effect-propose :scope-exclusion]
  :actor/scope-excluded-terms ["finalize the warranty claim" "finalized the warranty claim"
                                "finalize the warranty claim decision"
                                "approve the warranty claim" "approved the warranty claim"
                                "deny the warranty claim" "denied the warranty claim"
                                "reject the warranty claim" "rejected the warranty claim"
                                "settle the warranty claim" "settled the warranty claim"
                                "authorize the warranty payout" "authorized the warranty payout"
                                "pay out the warranty claim" "paid out the warranty claim"
                                "issue a warranty replacement" "issued a warranty replacement"
                                "issue a warranty refund" "issued a warranty refund"
                                "process the warranty refund" "processed the warranty refund"
                                "confirm the warranty claim decision" "confirmed the warranty claim decision"
                                "execute the warranty claim decision" "executed the warranty claim decision"
                                "保証請求を確定" "保証請求の承認を実行" "保証請求を承認した"
                                "保証請求を却下した" "保証請求を拒否した" "保証金の支払いを実行"
                                "保証交換を承認した" "返金処理を実行した"]

  ;; Self-trip-avoidance: every term above is phrased as the
  ;; finalization/execution ACTION, never a bare noun -- this namespace's
  ;; own :flag-warranty-concern default proposal legitimately discusses
  ;; product-defect/warranty-dispute/counterfeit concerns, and its own
  ;; printed :op keyword literally contains the substring "warranty". A
  ;; bare-noun term list (e.g. bare "warranty"/"claim"/"counterfeit")
  ;; would self-trip this actor's own core happy path on every single
  ;; run. Regression test:
  ;; governor-test/default-mock-advisor-proposals-never-self-trip-scope-exclusion.

  :phase/rollout
  {0 {:label "read-only" :writes #{} :auto #{}}
   1 {:label "assisted-logging" :writes #{:log-sales-record} :auto #{}}
   2 {:label "assisted-coordination" :writes #{:log-sales-record :schedule-staffing-operation
                                               :coordinate-supply-order}
      :auto #{}}
   3 {:label "supervised-auto" :writes #{:log-sales-record :schedule-staffing-operation
                                         :coordinate-supply-order :flag-warranty-concern}
      :auto #{:log-sales-record :schedule-staffing-operation :coordinate-supply-order}}}

  :operation/entry-point :intake
  :operation/nodes [:intake :advise :govern :decide :request-approval :commit :hold]

  :test/counts {:total 56 :assertions 166 :failures 0 :errors 0}
  :test/coverage [:governor-hard-checks :advisor-shapes :phase-rollout :integration
                  :store-contract :scope-exclusion-self-trip-regression
                  :vendor-verification]
  :test/simulator :avretailops.sim

  :registry/maturity :implemented
  :registry/repo "https://github.com/cloud-itonami/cloud-itonami-isic-4742"
  :registry/business-id "cloud-itonami-isic-4742"
  :registry/required-technologies [:robotics :identity :forms :dmn :bpmn :audit-ledger :retail]
  :registry/operating-states [:intake :advise :govern :approve :commit :audit]

  :db/id -1}]
