  :adr/decision-summary "{:pattern \"sealed TicketRouter-LLM + independent TicketGovernor + append-only audit ledger, triages/routes client IT-support tickets to already-contracted technicians -- never processes payroll, never employer-of-record (distinct from cloud-itonami-isic-7820's dispatch model)\", :new-actor \"cloud-itonami-isic-6209\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-6209\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"6209\", :isic-name \"Other information technology and computer service activities\", :narrowed-to \"IT managed-services/helpdesk ticket-routing, same narrowing move as isic-6311/isic-4610/isic-8299\", :namespace \"itsupport\", :registry-promotion \"kotoba-lang/industry registry.edn id 6209: :maturity :spec -> :implemented\", :governor-checks [{:check :rbac :severity :hard} {:check :access-tier-clearance-gate :severity :hard :note \"new -- no analog in other cloud-itonami actors; a NIST SP 800-53 AC-6 least-privilege 3-tier scale (standard/elevated/privileged), technician's access-tier must meet or exceed the ticket's required tier\"} {:check :security-incident-misrouting-gate :severity :hard :note \"new -- a :category :security-incident ticket can only route to a technician holding at least one of 3 real named incident-response certifications (GIAC GCIH, CISSP, CHFI)\"} {:check :source-provenance-gate :severity :hard} {:check :licensed-disclosure :severity :hard} {:check :confidence-floor :severity :soft-escalate} {:check :sla-breach-imminent-gate :severity :soft-escalate :note \"a ticket within 60 minutes of SLA breach always escalates to a human, regardless of confidence\"} {:check :dispute-request :severity :soft-escalate-unconditional}], :r0-scope {:source-classes [\"client-submitted-ticket\" \"monitoring-system-alert\" \"hr-verified-certification\"], :security-incident-cert-catalog [\"GIAC GCIH\" \"CISSP\" \"CHFI\"]}, :robotics {:value false, :key-present false, :rationale \"routes tickets to already-contracted technicians only; no physical action inside the actor's boundary\"}, :test-results {:unit-tests \"26 tests / 82 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end, all 8 scenarios fire correctly\"}, :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. kotoba-lang/industry pin advanced in manifest/west.yml (--entry industry, verified via nbb scripts/gen-west-manifest.cljs)\"}"
