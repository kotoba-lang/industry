[{:adr/authoritative_for ["app-aozora cljs SPA の /videos ルート・動画タブ・縦 snap スクロール\n    動画フィードの設計" "動画フィードのデータ源チェーン (appview getVideoFeed → 公式 thevids →\n    What's Hot client filter) と cursor のソース固定則" "再生可能判定 — app.bsky.embed.video#view / recordWithMedia#view /\n    app.aozora.embed.video (record 直 URL)。blob-ref のみの record embed は\n    落とす" "app.aozora.live.* live 枠フック (:live? フラグ) の予約 — 実装は\n    ADR-2606271500 の media plane に従属"], :adr/supersedes [], :adr/superseded_by [], :adr/topic "app-aozora-vertical-video-feed", :adr/related ["90-docs/adr/2606271500-kotoba-stage-obs-live-aozora.md" "orgs/gftdcojp/app-aozora/90-docs/adr/0075-yoro-engagement-wellbecoming.md" "90-docs/adr/2607021400-app-aozora-liquid-glass-cacao-signup.md"], :adr/status "accepted", :adr/id "adr-2607062100-app-aozora-vertical-video-feed", :adr/doc_type "adr", :adr/last_verified "2026-07-06", :adr/implementation "{:repo \"gftdcojp/app-aozora\", :branch \"videos-feed-vertical\", :files [\"60-apps/appview/cljs/src/yoro_ui/kotoba/video.cljc\" \"60-apps/appview/cljs/src/yoro_ui/state/videos.cljc\" \"60-apps/appview/cljs/src/yoro_ui/pages/videos.cljc\" \"60-apps/appview/cljs/src/yoro_ui/router.cljc\" \"60-apps/appview/cljs/src/yoro_ui/shell/app.cljc\" \"60-apps/appview/cljs/src/yoro_ui/shell/tab_bar.cljc\" \"60-apps/appview/cljs/src/yoro_ui/core.cljc\" \"60-apps/appview/cljs/resources/i18n/messages/ja.edn\" \"60-apps/appview/cljs/resources/i18n/messages/en.edn\" \"60-apps/appview/cljs/package.json\" \"60-apps/appview/cljs/test/yoro_ui/kotoba/video_test.cljc\" \"60-apps/appview/cljs/test/yoro_ui/router_test.cljc\"], :verification [\"pnpm test: 44 tests / 124 assertions green\" \"shadow-cljs compile app / release app (advanced): 0 warnings\" \"headless Chrome で /videos 実走: appview 失敗 → thevids 500 → What's Hot\\n    の実チェーンを通り <video> 3 枚 (video.bsky.app poster+playlist)・著者\\n    overlay・動画タブ active を確認\"]}", :adr/decision "{:chosen [\"/videos ルート + 動画タブ (film icon、home の隣、6 タブ目)。:videos は\\n    immersive: header と liquid-glass panel をスキップし fixed inset-0 黒レイヤ\\n    (z-30)、tab dock (z-50) はその上に浮く\" \"データ源チェーン: :appview getVideoFeed → :thevids → :whats-hot (client\\n    filter)。初回のみチェーンを歩き、成功ソースを db に固定して load-more は\\n    直行 (cursor は発行フィードにのみ有効)。まばらなページは cursor を最大\\n    4 回自動追行\" \"playable 判定は pure cljc yoro-ui.kotoba.video に集約。app.aozora.embed.video\\n    (record 直 URL) を native aozora 動画投稿用に予約。:live? = record $type が\\n    app.aozora.live.* prefix (LIVE バッジ実装済み・発火は media plane 待ち)\" \"再生: native HLS → hls.js (npm bundle) → 直 src。autoplay muted、mute は\\n    フィード全体状態。play/pause は playback atom を sync-playback! が中央掃引\\n    (reactive context 外の app-db 読みを作らない)\" \"like/repost は既存 :feed/toggle-like / :feed/toggle-repost を再利用\" \"ページ固有スタイルは inline :style (生成 CSS に無い utility を増やさない)\"], :rejected [{:option \"svelte 版 (app-aozora-svelte) に実装\", :why \"svelte は archive/parity。primary は cljs SPA (README 明記)\"} {:option \"thevids 単一 fallback\", :why \"実測で上流 500 — 混合フィード + client filter の最終 fallback が必要\"} {:option \"cursor をソース跨ぎで引き回す\", :why \"cursor は発行フィード固有。跨ぐと誤ページ/エラー (設計時に検出し\\n          ソース固定則を導入)\"} {:option \"ライブ配信 media plane を同時実装\", :why \"ADR-2606271500 の残課題 (SRTP/WHIP/CMAF) は別規模 — フィード側は\\n          :live? interleave 先を用意して待つ\"}]}", :db/id -1, :adr/follow-ups ["appview 側 com.etzhayyim.yoro.feed.getVideoFeed のサーバ実装 (video filter +\n   ADR-0075 関心駆動 ranking)" "cljs SPA からの動画アップロード (svelte PostComposer parity)" "ライブ配信 media plane (ADR-2606271500 再着手) → :live? interleave の発火"], :adr/problem "{:source \"オーナー指示 (2026-07-06): 「app-aozora に TikTok のような動画メインの\\n           menu と配信は設計されているか」→ どちらも UI として無いと回答 →\\n           「では設計、実装して」\", :facts [\"primary app は cljs SPA (reagent+re-frame, 60-apps/appview/cljs)。動画は\\n    投稿添付のみで動画メイン閲覧体験は route も設計も無かった\" \"ライブ配信は ADR-2606271500 が設計済みだが media plane 実装は現存しない\\n    (2026-07-01 追記) — 本 ADR は再実装せずフィード側フックのみ予約\" \"実測: 公式 thevids 生成器は public API 経由で 500 を返すことがある。\\n    What's Hot は 30 件中 2 件程度が video#view を持つ\" \"committed tailw