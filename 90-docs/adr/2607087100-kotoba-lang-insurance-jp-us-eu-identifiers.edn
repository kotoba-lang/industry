[{:adr/authoritative_for ["kotoba-lang/insurance が JP/US/EU の医療保険/レセプト識別子検証ライブラリとして育ってきた経緯と、cloud-itonami の governed actor 群との役割分担" "JP(保険者番号・医療機関コード)/US(NAIC company code・Payer ID)/EU(EHIC)それぞれの実装内容・確度・意図的な未実装事項の全体像" "superproject 全体を俯瞰する視点でのこのライブラリの位置づけ(各子repo README は個別実装の一次情報源のまま、本ADRはそれを束ねる索引)"], :adr/supersedes [], :adr/superseded_by [], :adr/topic "kotoba-lang-insurance-identifiers", :adr/related ["adr-2607032000-cloud-itonami-insurance-real-estate-coverage" "adr-2607084100-emr-claims-primary-sources-archive"], :adr/status "accepted", :adr/id "adr-2607087100-kotoba-lang-insurance-jp-us-eu-identifiers", :adr/doc_type "adr", :adr/last_verified "2026-07-08", :adr/deciders ["Jun Kawasaki"], :adr/not-implemented "{:jp [\"4都県(埼玉/千葉/東京/神奈川)の一部レガシー医療機関コードが7桁のみで検証番号を算出する例外 -- 一次資料に明記なし、二次資料(Wikipedia)のみが伝える\"], :us [\"NAIC company code が10000未満の場合のレガシー損害保険統合様式カテゴリという二次資料の主張 -- 検証可能な一次資料PDFが文字抽出不能で確認できず\" \"Payer ID の単一公的レジストリ -- 一次資料調査の結果、存在しないことを確認(クレアリングハウスごとに独自採番)\"], :eu [\"EU加盟国ごとに異なる個人識別番号(Field 6)の桁数/チェックデジットアルゴリズム -- 一次資料(Decision No S2)自体が国ごとの詳細を規定しないと明記\" \"EN 1387準拠の印字文字集合バリデーション -- EN 1387が非公開規格のため実装せず\"]}", :adr/date "2026-07-08", :adr/cycles "[{:cycle \"original\", :sha \"cd274baf4312577a959eea3e4daf2937ac48a7a2\", :date \"2026-07-03T03:49:31Z\", :summary \"feat: policies, premiums and claims capability lib (kotoba-lang/insurance 新設、ADR-2607032000)\"} {:cycle \"#3\", :sha \"ba4b9221cd49732facb72eea1ae31523dd8379af\", :date \"2026-07-08T04:27:55Z\", :summary \"feat(jp): 保険者番号(8桁)チェックデジット検証\"} {:cycle \"#7\", :sha \"3f710c39536beb7dd79514d945f281c29bdc3c7a\", :date \"2026-07-08T06:12:40Z\", :summary \"feat(jp): 都道府県番号テーブル埋め込み、医療機関コード構造パースのみ(検証番号は未実装のまま保留)\"} {:cycle \"cycle外\", :sha \"bc1184a2f532b0dd72359a2dfe434d0028ff00a2\", :date \"2026-07-08T06:50:29Z\", :summary \"feat(jp): 医療機関コード検証番号を算出/検証、点数表番号デコード(医科1/歯科3/薬局4)、都道府県番号を51-97代替コードまで94エントリに拡張。ADR-2607084100 が詳細を記録\"} {:cycle \"#11\", :sha \"2e6c4b8385bd707e7e0ef574d0b186c648488276\", :date \"2026-07-08T08:02:43Z\", :summary \"feat(us): NAIC company code(5桁数字、チェックデジット不存在確認済み)・Payer ID(X12 AN 2/80構造のみ)の形状検証\"} {:cycle \"#15\", :sha \"bce7ad73c5d4193fa2d72bd738a6c177f30126c7\", :date \"2026-07-08T10:05:05Z\", :summary \"feat(eu): EHIC構造フィールド検証(EU全域統一フォーマット不存在を一次資料で確認済み)\"} {:cycle \"#19\", :sha \"fccd64e04cf67c4e956d07627301c4abe469f92a\", :date \"2026-07-08T11:57:55Z\", :summary \"fix(jp): parse-hokensha-bangou/parse-iryokikan-bangou の非文字列入力クラッシュ(ClassCastException)を修正。健全性確認で発見\"}]", :db/id -1, :adr/authoritative true, :adr/title "kotoba-lang/insurance の JP/US/EU 医療保険・レセプト識別子検証実装(全6コミット)を振り返って記録する", :adr/references "{:commits [\"https://github.com/kotoba-lang/insurance/commit/cd274baf4312577a959eea3e4daf2937ac48a7a2\" \"https://github.com/kotoba-lang/insurance/commit/ba4b9221cd49732facb72eea1ae31523dd8379af\" \"https://github.com/kotoba-lang/insurance/commit/3f710c39536beb7dd79514d945f281c29bdc3c7a\" \"https://github.com/kotoba-lang/insurance/commit/bc1184a2f532b0dd72359a2dfe434d0028ff00a2\" \"https://github.com/kotoba-lang/insurance/commit/2e6c4b8385bd707e7e0ef574d0b186c648488276\" \"https://github.com/kotoba-lang/insurance/commit/bce7ad73c5d4193fa2d72bd738a6c177f30126c7\" \"https://github.com/kotoba-lang/insurance/commit/fccd64e04cf67c4e956d07627301c4abe469f92a\"], :repos [\"https://github.com/kotoba-lang/insurance\" \"https://github.com/kotoba-lang/emr-claims-primary-sources\"]}"}]