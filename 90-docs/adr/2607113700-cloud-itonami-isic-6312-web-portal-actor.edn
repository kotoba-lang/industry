  :adr/decision-summary "{:pattern \"sealed PortalCurator-LLM + independent PortalGovernor + append-only audit ledger, a COLLECT-CURATE-DISCLOSE model mirroring cloud-itonami-isic-6311's hold-internally/disclose-to-contracted-users pattern, mapped to the web-portal content-aggregation domain\", :new-actor \"cloud-itonami-isic-6312\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-6312\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"6312\", :isic-name \"Web portals\", :registry-promotion \"kotoba-lang/industry registry.edn id 6312: :maturity :spec (dead gftdcojp/cloud-itonami-J6312 placeholder URL) -> :implemented (real repo)\", :namespace \"portal\", :governor-checks [{:check :rbac :severity :hard} {:check :source-provenance-gate :severity :hard :note \"source :class must be in portal.facts/allowed-source-classes; :licensed-syndication additionally requires an ACTIVE content-license\"} {:check :license-scope-gate :severity :hard :note \"new -- no analog in any other cloud-itonami actor; a :fair-use-excerpt-sourced listing whose snippet exceeds a conservative 400-char ceiling is rejected regardless of LLM confidence, grounded in 17 U.S.C. §107's excerpt/commentary doctrine (explicitly documented as NOT a legal bright-line, an operator-tunable structural proxy)\"} {:check :disclosure-gate :severity :hard :note \"new -- no analog in any other cloud-itonami actor; a sponsored placement with no :disclosure-label is rejected regardless of confidence, grounded in FTC native-advertising guidance (16 CFR Part 255)\"} {:check :licensed-disclosure :severity :hard :note \"active tenant x tier contract required, requested columns must stay within the tier\"} {:check :confidence-floor :severity :soft-escalate :note \"confidence < 0.6\"} {:check :sensitive-subject-gate :severity :soft-escalate :note \"listing flagged :allegation-subject? true -- ingestion/feature/disclosure always escalates to a human\"} {:check :takedown-request :severity :soft-escalate-unconditional :note \":takedown/request never auto-resolves at any confidence, any phase\"}], :deliberately-absent {:check :payment-order-fulfillment-checks, :rationale \"this actor only aggregates, curates and discloses third-party content references -- it never handles order-fulfillment or payment processing\"}, :actuation-invariant \":takedown/request never a member of any phase's :auto set at any phase; default-phase set to 1 (assisted, no auto-commit) from initial implementation, applying the fail-open fix already found this session in cloud-itonami-isic-6311/isic-7820's phase.cljc rather than retrofitting it later\", :r0-scope {:source-catalog [\"17 U.S.C. §105 -- US federal government works, no copyright\" \"Creative Commons Attribution 4.0 (CC BY 4.0) -- full reproduction with attribution\" \"17 U.S.C. §107 -- fair-use excerpt/commentary doctrine, excerpt-length ceiling is a conservative structural proxy not a legal bright line\"], :structural-class \"licensed-syndication -- most commercial syndication deals require an operator-registered ACTIVE content-license, never a hardcoded free-source claim\", :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as siblings\"}, :robotics {:value false, :key-present false, :rationale \"a web-portal actor's entire surface is aggregating, curating and disclosing third-party content references; no physical delivery or order-fulfillment exists inside the actor's boundary\"}, :test-results {:unit-tests \"35 tests / 137 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end: op1 public-domain listing publish -> commit, op2 unsourced listing -> hold (source-provenance-gate), op3/op3a over-tier and uncontracted report -> hold (licensed-disclosure), op4 fair-use-excerpt over cap -> hold (license-scope-gate), op5 sponsored placement no disclosure -> hold (disclosure-gate), op6 sensitive-subject feature -> escalate -> approve -> commit, op7 takedown request -> escalate -> approve -> commit\"}, :infra-note \"scripts/gen-west-manifest.bb was mid-migration to scripts/gen-west-manifest.cljs (nbb) by a concurrent session at ADR-authoring time; the migration was incomplete (scripts/nbb_compat/ shim files present but not on nbb's classpath, causing 'Could not find namespace: clojure.java.shell'). The kotoba-lang/industry west.yml pin was already advanced past this actor's registry commit by a sibling session (isic-5590) via the documented GitHub-API direct-PUT fallback (repos.edn :manifest-workflow canonical path, blob-SHA-matched PUT) -- verified via GitHub API compare (ahead_by=5, behind_by=0, merge_base = this actor's registry commit), so no further west.yml edit was needed for this ADR. Fixing the nbb migration itself is out of scope here.\", :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention.\"}"
  :adr/authoritative true
