(vector (map (:db/id -1)
  (:adr/id "adr-2607184900-kami-bus-automation-independent-audio")
  (:adr/title "KAMI adds DAW bus automation and production NLE audio lanes")
  (:adr/date "2026-07-18")
  (:adr/status "accepted")
  (:adr/authoritative true)
  (:adr/topic "kotoba-lang-media-authoring")
  (:adr/supersedes (vector "adr-2607184800-kami-audio-delivery-loudness-eq"))
  (:adr/decision
  (map (:daw (map (:bus-automation-authority :bus/gain-automation)
         (:point-schema (vector :automation/tick :automation/gain))
         (:ordering :ascending-tick)
         (:minimum-gain 0)
         (:schedulers (vector :realtime-audio-context :offline-audio-context))
         (:consumers (vector :playback :master-wav :normalized-master-wav :track-stems))))
   (:nle (map (:audio-asset-registration :sha-256)
         (:audio-runtime :decoded-audio-buffer)
         (:binding :idempotent-source-id)
         (:timeline-authority :audio-segments)
         (:preview-origin :current-playhead)
         (:export-origin :timeline-zero)
         (:shared-processing (vector :clip-gain :clip-three-band-eq :master-three-band-eq :master-gain))
         (:export-destination :media-stream-destination)
         (:missing-buffer-policy :refuse-export)
         (:restoration (vector :verified-indexeddb-cache :portable-media-package))
         (:resource-teardown :stop-and-disconnect-buffer-sources)))
   (:maturity (map (:kami-app-daw :逍遥) (:kami-app-nle :逍遥)))
   (:remaining-commercial-gates (map (:shared (vector "persistent directory grants" "streaming package I/O above 512 MiB"))
                                (:daw (vector "plugin hosting" "bus send/effect automation" "certified broadcast loudness conformance" "bundled multichannel stems"))
                                (:nle (vector "audio crossfades and automation" "delivery loudness" "color management" "persistent/background proxy jobs" "additional containers"))))))
  (:adr/implementation
  (map (:daw-commits (vector "27ebb6b828e4a5a47b5312d75a484e730844f5dc"))
   (:nle-commits (vector "90cbb1319392d71cd0743dfcc8d6848d7d49f952"))
   (:pull-requests (vector "kotoba-lang/kami-app-daw#7" "kotoba-lang/kami-app-nle#7"))
   (:evidence (vector "DAW passes 15 tests and 59 assertions; NLE passes 17 tests and 65 assertions, including sorted bus points, audio segment authority and idempotent relinking."
              "Both shadow-cljs production releases completed through the repository resource guard with zero compiler warnings."
              "DAW Chrome persisted master bus automation in recovery EDN and observed the realtime AudioParam ramp to 0.3 without console errors."
              "NLE Chrome imported two silent H.264 video assets and a separate PCM WAV, bound the WAV as asset:2, decoded it to an AudioBuffer and measured -22.0 dBFS during preview."
              "NLE production export downloaded successfully; ffprobe identified stream 0 as VP8 video and stream 1 as Opus audio, proving the independent lane reached the delivery container."
              "Automated browser contexts, BufferSources and local HTTP servers were closed after verification."
              "Both application pull requests were reviewed and squash-merged."
              "The prescribed freshness and ledger verifier scripts are absent from this root revision; direct EDN parsing verified accepted status, supersedes authority and missing-buffer export policy."))))
  (:adr/consequences
  (vector "DAW mix movement can occur after track routing without diverging between monitoring and offline delivery."
   "NLE audio is no longer limited to sound embedded in video elements; separately recorded dialogue, music and effects can occupy timeline clips."
   "Reimporting identical NLE audio restores runtime bytes without duplicating an already bound timeline clip."
   "Audio-only fades, crossfades, automation and loudness delivery remain later production work."))
  (:adr/source-format "edn")))
