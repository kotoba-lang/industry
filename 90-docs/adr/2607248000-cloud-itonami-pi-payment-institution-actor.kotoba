  (:adr/decision-summary "{:new-actor \"cloud-itonami-pi\", :repo \"https://github.com/cloud-itonami/cloud-itonami-pi\", :pattern \"sealed PaymentOps-LLM advisor + independent PIGovernor + append-only audit ledger (same shape as cloud-itonami-isic-6419/-6910)\", :scope \"PSD2 Annex I services 2/5/6/7 (execution of payment transactions, money remittance, PIS, AIS) -- general-purpose, not adult-industry-specific\", :non-goals [\"e-money issuance (see cloud-itonami-emi)\" \"banking-license deposits (see cloud-itonami-isic-6419)\" \"card-acquiring settlement mechanics (see cloud-itonami-isic-6619)\" \"issuer-side card program/BIN sponsorship (see cloud-itonami-card-issuing)\"], :actuation-invariant \"`:actuation/execute-payment`/`:actuation/remit-payout` are never members of any `pi.phase` phase's `:auto` set, and `pi.governor`'s actuation high-stakes check always escalates them -- two independent layers enforce the same structural fact\", :license \"AGPL-3.0-or-later\", :org \"cloud-itonami\", :manifest-registration \"none yet -- standalone at ADR time, per the existing cloud-itonami-{ISIC} blueprint convention; west registration deferred to a separate batch step\", :r0-scope {:jurisdictions-with-spec-basis [\"DEU\" \"FRA\" \"IRL\" \"NLD\" \"LTU\" \"GBR\" \"JPN\" \"SGP\" \"USA-NY\" \"BRA\"], :store-backend \"MemStore only (Datomic/kotoba-server backend is a planned seam, not implemented)\", :tests \"50 tests / 180 assertions, lint clean\"}}")
  (:adr/deciders (vector "Jun Kawasaki" "Claude"))
