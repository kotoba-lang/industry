  "{:repo \"kotoba-lang/sigv4\", :namespaces [sigv4.core sigv4.request sigv4.verify sigv4.crypto sigv4.protocols], :replaces-copies 6, :divergence-found [:charcodeat-utf16-in-verification-path :trailing-empty-key-split :encodeuricomponent-fixup-in-4-of-6], :shared [:signing :verification :composition :icrypto], :not-shared [:transport], :kotoba-slice {:module \"kotoba/pct_encode.kotoba\", :target :wasm, :wasm-bytes 503, :parity-inputs 147, :status :non-load-bearing}, :migrated [\"gftdcojp/net-kotobase\" \"gftdcojp/net-kotobase-ipfs\" \"kotoba-lang/kotobase-peer\" \"kotoba-lang/kotobase-protocols-worker\" \"kotoba-lang/shoko\" \"kotoba-lang/io-storj\"], :remaining-consumers 0}")
