## 次の最初のコマンド

```bash
# 1. datalake 3 台の赤を切り分ける（いちばん実害がある）
tail -40 /tmp/sukashi-datalake.log /tmp/hirameki-datalake.log
launchctl list | grep datalake

# 2. hermes の一晩の成績
sqlite3 ~/.hermes/cron/executions.db \\
  \"select status,count(*) from executions where claimed_at>'2026-08-30T12:00' group by status;\"

# 3. 飛ばされた 3 本が再発したか
python3 -c \"import json;d=json.load(open('$HOME/.hermes/cron/jobs.json'));\\
  print([(j['name'],j['next_run_at']) for j in (d['jobs'] if isinstance(d,dict) else d) \\
  if j['name'] in ('bots-aozora-pulse','shinshi-cast-post','legal-news-source')])\"
```

