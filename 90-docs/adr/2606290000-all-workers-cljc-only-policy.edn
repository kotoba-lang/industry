{:frontmatter
 {:id "adr-2606290000-all-workers-cljc-only-policy"
  :title "worker は全て CLJC のみに — club-shinshi をリファレンス実装として残 worker を段階移行"
  :status "accepted"
  :date "2026-06-29"
  :authoritative true
  :repo "orgs/gftdcojp/club-shinshi"
  :builds_on ["90-docs/adr/2606272300-cloud-murakumo-gpu-cloud.md"   ; assets-only CLJC SPA (Pattern A)
              "90-docs/adr/2606271700-cloud-itonami-business-os.md"  ; .cljc 正本 + 承認 gate
              "90-docs/adr/2606272330-gftd-ai-generation-studio.md"] ; clj+kotoba 系の製品面
  :related ["90-docs/adr/2605311530-shinshi-club-vanity-domain-migration.md.edn" ; shinshi.club apex
            "90-docs/adr/2606241600-shallow-depth1-git-default.md"]}

 :decision
 {:product "club-shinshi"
  :placement :gftdcojp
  :subject :all-workers-cljc-only
  :definition "gftdcojp 配下の Cloudflare Worker は新規・修正ともに CLJC(.cljc 正本 + cljs-dom-adapter for UI, shadow-cljs :esm for fetch handler)のみで書く。SvelteKit / Vite-TS / plain-TS worker を新規に作らない。既存は traffic+churn 順に段階移行（big-bang なし、各々 ADR + cutover + rollback）。club-shinshi(shinshi.club, 44k req/7d) を全面 CLJC 再構築のリファレンス実装とする。"
  :ssot "orgs/gftdcojp/club-shinshi/.../shinshi-cljc/resources/shinshi.edn"
  :rationale ["pure .cljc が JVM(test/CLI) と browser/worker で同一業務モデルを実行"
              "UI IR(EDN tree) → renderer(DOM/WebGL/WebGPU/WASM) 切替境界"
              "data-first SSoT(EDN) + honest-NULL telemetry(LLM による捏造禁止)"
              "cloud-murakumo(assets-only) と app-aozora appview(:esm fetch) に prod 実績済"]
  :patterns
  {:a_assets_only "cloud-murakumo: assets-only SPA。worker script なし、public/ を SPA 配信。UI 正本=cljc-ui-IR。"
   :b_esm_fetch   "app-aozora appview: shadow-cljs :esm → out/worker.js, #js {:fetch}。D1/R2/env は ^js interop。"
   :ab_worker_plus_assets "club-shinshi: A∪B。main(out/worker.js) + assets(public/), not_found_handling:none で worker が SPA fallback + SSR OG を握る。"}
  :core_ns [:club-shinshi.worker :club-shinshi.router :club-shinshi.d1
            :club-shinshi.telemetry :club-shinshi.exoclick :club-shinshi.mcp
            :club-shinshi.hotel :club-shinshi.ui.views :club-shinshi.ui.dom]
  :implementation {:language ".cljc"
                    :ssot "resources/shinshi.edn"
                    :schema "club-shinshi.schema"
                    :builds {:worker "shadow-cljs :esm → out/worker.js"
                             :app "shadow-cljs :browser → public/js/main.js"
                             :test "shadow-cljs :node-test + clojure -M:test"}
                    :runtime "Cloudflare Workers (workerd) + Worker/Assets mode, nodejs_compat"
                    :env ["SHINSHI_DB" "RECORDLOG_DB" "ASSETS"
                          "SHINSHI_MCP_URL" "SHINSHI_XRPC_URL"
                          "EXOCLICK_API_URL" "EXOCLICK_STATS_PATH"
                          "DISPATCHER_INTERNAL_SECRET" "EXOCLICK_API_TOKEN" "SHINSHI_DAILY_COST_MINOR"]}
  :migration
  {:scope "残 36 worker（ai-gftd-*, aozora-app, kotodama-yoro, spirit-in-physics-*, etzhayyim-*, 等。SvelteKit/Vite/cljs-wasm 混在）"
   :order "traffic 高・churn 大のもの優先。各 worker = ADR + parity diff + cutover + rollback。big-bang なし。"
   :exemption "TS-only 第三 party SDK で cljs 等価が無いものは case-by-case ADR。default は interop で wrap し TS を primary に残さない。"
   :reference_impl "club-shinshi（本 ADR と並行して Phase 0→3 で再構築）"}}

 :guardrails
 {:honest_null "telemetry の指標は基礎データ無ければ NULL(0 や捏造値にしない)"
  :secrets "秘密は wrangler secret / Keychain SSoT。EDN には非機密参照先のみ。コミット禁止"
  :d1_continuity "既存 database_id を再利用(新規 d1 create 禁止)。data migration ゼロ"
  :git "shallow 既定・FF-only main・force-push 禁止・オーナー WIP 破棄禁止"
  :cutover "live worker の切り替えは保守窓 + parity + 即 rollback(旧 worker は git 温存)"}

 :files ["orgs/gftdcojp/club-shinshi/60-apps/ai-gftd-project-shinshi/appview/shinshi-cljc/deps.edn"
         "orgs/gftdcojp/club-shinshi/60-apps/ai-gftd-project-shinshi/appview/shinshi-cljc/shadow-cljs.edn"
         "orgs/gftdcojp/club-shinshi/60-apps/ai-gftd-project-shinshi/appview/shinshi-cljc/wrangler.jsonc"
         "orgs/gftdcojp/club-shinshi/60-apps/ai-gftd-project-shinshi/appview/shinshi-cljc/src/club_shinshi/worker.cljc"
         "orgs/gftdcojp/club-shinshi/60-apps/ai-gftd-project-shinshi/appview/shinshi-cljc/src/club_shinshi/router.cljc"]

