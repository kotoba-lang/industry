  :adr/decision-summary "{:pattern \"sealed TextileTradeAdvisor + independent :textile-trading-governor + append-only audit ledger, PRINCIPAL trading model with a forced-labor supply-chain regulatory backbone\", :new-actor \"cloud-itonami-isic-4641\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-4641\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"4641\", :isic-name \"Wholesale of textiles, clothing and footwear\", :registry-promotion \"kotoba-lang/industry registry.edn id 4641: :maturity :spec (dead gftdcojp/cloud-itonami-G4641 placeholder URL) -> :implemented (real repo)\", :namespace \"textiletrade\", :forced-labor-check {:check :forced-labor-presumption-unrebutted, :trigger \"BOTH (a) order's jurisdiction has a binding forced-labor import-ban statute (today: USA only) AND (b) origin-region/entity-list flagged (Xinjiang / UFLPA Entity List / CAATSA §321(b) North Korea)\", :rebuttal-requires [:supply-chain-traceability-documented? :forced-labor-rebuttal-evidence-on-file?], :design-contrast-vs-isic-4662 \"jurisdiction-GATED, deliberately unlike isic-4662's jurisdiction-UNCONDITIONAL conflict-minerals check -- reasoned from UFLPA being a US border-detention mechanism (not a floating disclosure obligation like Dodd-Frank §1502/EU Reg. 2017/821)\", :proof-of-rebuttability \"same Xinjiang-origin+USA order: no evidence -> HARD hold (to-6); both evidence facts present -> dispatches cleanly (to-7)\", :proof-of-jurisdiction-gating \"same unrebutted Xinjiang-origin order: USA (binding statute seeded) -> hold; JPN (no binding statute seeded) -> dispatches cleanly (to-8)\"}, :governor-checks [{:check :no-spec-basis :severity :hard} {:check :evidence-incomplete :severity :hard} {:check :credit-uncleared :severity :hard} {:check :contract-missing :severity :hard} {:check :forced-labor-presumption-unrebutted :severity :hard} {:check :counterparty-sanctions-flag-unresolved :severity :hard} {:check :already-dispatched :severity :hard} {:check :already-invoiced :severity :hard} {:check :high-stakes-actuation-gate :severity :soft-escalate}], :robotics {:value true, :rationale \"garment-on-hanger (GOH) sortation conveyors for hanging apparel + pick-to-light/AS-RS for footwear and folded textiles, both terminating at the wholesaler's own dispatch point\"}, :r0-scope {:source-catalog [\"USA: Uyghur Forced Labor Prevention Act (Pub. L. 117-78, 2021; rebuttable presumption effective 2022-06-21) + 19 U.S.C. §1307 (codification of Tariff Act of 1930 §307), CBP-enforced; CAATSA §321(b) (North Korea nationals, no geographic limitation) as a second rebuttable-presumption mechanism; textile-specific Textile Fiber Products Identification Act (15 U.S.C. §70, FTC) / Flammable Fabrics Act (15 U.S.C. §1191, CPSC)\" \"EU: Regulation (EU) 2024/3015 (forced labour products regulation), entered into force 2024-12-13, main rules apply from 2027-12-14 -- seeded but explicitly :binding? false (not yet in force)\" \"GBR: UK Modern Slavery Act 2015 considered and DELIBERATELY excluded as a basis for this check -- it's a disclosure-statement law, not a border-enforcement mechanism, so citing it here would misrepresent the mechanism\" \"JPN/GBR have no binding forced-labor import-ban statute seeded -- an honest gap, not fabricated\"], :citations-verified \"all citations independently re-verified via WebSearch at ADR-authoring time, including CAATSA §321(b)'s exact section number and EU 2024/3015's exact phased-application dates, both confirmed accurate (the implementing agent had flagged both as only moderate confidence)\", :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as siblings\"}, :test-results {:unit-tests \"44 tests / 202 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end: clean happy path, 5 isolated HARD-hold scenarios, rebuttable-evidence control pair, jurisdiction-gating control pair, double-actuation guards\"}, :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. Only kotoba-lang/industry pin advanced in manifest/west.yml (--entry industry, minimal diff)\"}"
