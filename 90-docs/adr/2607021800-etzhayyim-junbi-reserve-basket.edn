 :problem
 {:source "owner directive 2026-07-02"
  :gap "EN is internal-only mutual credit; the scarce cross-boundary asset was pinned to a single issuer/currency (USDC on Base L2) — no multi-issuer, multi-currency reserve and no balanced unit over it"
  :risk "single-issuer concentration (Circle/USD); no JPY/EUR/CNY diversification; ad-hoc reserve decisions without gates would drift into speculative finance (Charter Rider §2(b) violation)"}

 :decision
 {:actor {:name "junbi"
          :kanji "準備"
          :repo "github.com/etzhayyim/com-etzhayyim-junbi"
          :path "orgs/etzhayyim/com-etzhayyim-junbi"
          :did-web "did:web:etzhayyim.github.io:com-etzhayyim-junbi"
          :namespace "com.etzhayyim.junbi.*"
          :pattern "containment + independent TreasuryGovernor + append-only audit ledger (langgraph-clj StateGraph at R1)"}
  :basket {:unit "HAKARI (秤)"
           :kind :unit-of-account          ; SDR-style — NEVER a minted token
           :numeraire :usd
           :band-bps 50                    ; inherits kawase-yui G4
           :weights-r1 {:usdc 0.40 :jpyc 0.40 :eurc 0.20}
           :weights-r3-example {:usdc 0.35 :jpyc 0.35 :eurc 0.20 :ecny 0.10}
           :params-pattern "Council-versioned blob (same as mKOTO tariff / social-capital params)"}
  :tier-1 [{:asset :usdc :issuer "Circle Internet Financial" :chain :base-l2}
           {:asset :eurc :issuer "Circle Internet Financial" :chain :base-l2}
           {:asset :jpyc :issuer "JPYC株式会社" :chain :base-l2
            :legal "資金移動業 / 改正資金決済法(2023) 電子決済手段"}]
  :tier-2 [{:asset :ecny :issuer "中国人民銀行 (PBOC)" :custody :authorized-operator-wallet
            :observation :attestation-datoms-only :activation :council-lv7-unanimity :phase :r3}
           {:asset :d-eur :issuer "European Central Bank" :status :not-yet-issued}
           {:asset :d-jpy :issuer "日本銀行 (BoJ)" :status :pilot-only}]
  :excluded #{:usdt}
  :custody {:tier-1 "ERC-4337 smart account / Safe on Base L2; kotoba-custody t-of-N Shamir"
            :signing :etzhayyim-exclusive  ; kotoba = read+verify only
            :accounting "kotoba-lang/banking double-entry + append-only audit datoms + toritate cross-ref"}
  :rebalance {:trigger :weight-drift-bps
              :mode :proposal-only          ; execution needs human approval (interrupt-before)
              :execution :mid-market-band   ; no AMM / no spread / no yield
              }}

 :gates
 {:j1 "no token mint — HAKARI is unit of account; no ERC-20 deploy path"
  :j2 "issuer whitelist only (Tier-1 + Council-activated Tier-2)"
  :j3 "USDT structurally rejected (hard-coded excluded set)"
  :j4 "Σ weights = 1.0 (ε), weights ≥ 0"
  :j5 "NAV rate band ±0.5% mid-market (band-bps 50 = KAWASE_MAX_BAND_BPS)"
  :j6 "no yield / no DeFi / no lending of reserve"
  :j7 "no fiat custody — stablecoin ERC-20 + authorized CBDC wallet only"
  :j8 "double-entry balanced postings only"
  :j9 "Tier-2 CBDC attestation-observed; weight 0 until Council activation"
  :j10 "rebalance is proposal-only; execution requires human approval"
  :j11 "no spread profit — mid-market locked"
  :j12 "EN net-zero untouched — no EN mint/burn surface in basket code"}

 :phases
 [{:phase :r0 :state "landed 2026-07-02"
   :scope "pure .cljc core (params validation, NAV, drift, rebalance proposal, governor J1–J12) + tests; repo + west + RAD registration"}
  {:phase :r1 :state "landed 2026-07-02 (owner-ratified)"
   :scope "langgraph-clj StateGraph TreasuryActor (interrupt-before human approval, J10); banking double-entry (J8); base-l2 read-only Base observation (USDC+EURC readable; JPYC read gated on Council address attestation); audit datoms over :db-api"}
  {:phase :r2 :state "landed 2026-07-02 (owner-ratified)"
   :scope "Chainlink attestation feed (USDC/USD 0x7e86..bc6B + EURC/USD 0xDAe3..8250 on Base; JPY/USD feed does NOT exist on Base — JPYC unattested until Council alternative); rebalance-proposer cell (1 tick = 1 bounded run); toritate.ledgerEntry cross-ref; HAKARI-denominated EN credit-limit sizing"}
  {:phase :r3a :state "landed 2026-07-02 (owner-ratified)"
   :scope "CBDC operator-attestation intake (allowlist + freshness + injected sig verify; unverified never a holding) + Council activation machinery (activate refuses records lacking unanimity/legal-analysis/valid custody)"}
  {:phase :r3b :state :blocked-on-ops
   :scope "actual e-CNY activation: per-jurisdiction legal analysis + Council Lv7+ unanimity vote + real authorized-operator custody — ops/legal, not code"}]

 :honesty
 {:ecny "foreign-entity e-CNY custody not currently establishable at scale (pilot corridors) — hence Tier-2 / weight-0 / attestation-only; nothing faked at R0"
  :repo-visibility "created private, flipped public with owner approval 2026-07-02; static did:web doc served from GitHub Pages root (/.well-known/did.json)"
