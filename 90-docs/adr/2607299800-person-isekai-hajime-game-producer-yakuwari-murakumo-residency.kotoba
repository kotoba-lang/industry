  (:adr/id "2607299800")
  (:adr/title "person-isekai-hajime — ゲームを作る yakuwari と、その murakumo 常駐")
  (:adr/status "accepted")
  (:adr/doc_type "adr")
  (:adr/date "2026-07-29")
