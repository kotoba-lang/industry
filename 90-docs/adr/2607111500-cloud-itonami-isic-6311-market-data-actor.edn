  :adr/decision-summary "{:pattern \"sealed MarketData-LLM + independent MarketDataGovernor + append-only audit ledger, a COLLECT-HOLD-SERVE model (never trades, never routes an order, never takes custody) mirroring cloud-itonami-isic-8291's Palantir-style hold-internally/disclose-to-contracted-users pattern, mapped to the price-data domain\", :new-actor \"cloud-itonami-isic-6311\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-6311\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"6311\", :isic-name \"Data processing, hosting and related activities\", :narrowed-to \"multi-asset market-data aggregation and hosting (equities/FX/commodities/crypto/real-estate indices), same narrowing move as isic-4610 (Wholesale on a fee or contract basis -> commission-broker)\", :registry-promotion \"kotoba-lang/industry registry.edn id 6311: :maturity :spec (dead gftdcojp/cloud-itonami-J6311 placeholder URL) -> :implemented (real repo), 5th promotion after M6910/isic-8291/isic-4690/isic-4610\", :namespace \"marketdata\", :governor-checks [{:check :rbac :severity :hard} {:check :tolerance-gate :severity :hard :note \"new -- no analog in any other cloud-itonami actor; a proposed :quote/ingest price deviating more than 15pct from the last known-good quote is rejected regardless of LLM confidence, the structural fat-finger/stale-print defense\"} {:check :source-provenance-gate :severity :hard :note \"source :class must be in marketdata.facts/allowed-source-classes; :licensed-operator-feed additionally requires an ACTIVE feed-license covering the instrument's asset-class\"} {:check :licensed-disclosure :severity :hard :note \"active tenant x tier contract required, requested columns must stay within the tier (mirrors dossier's tier-columns pattern)\"} {:check :confidence-floor :severity :soft-escalate :note \"confidence < 0.6\"} {:check :halted-instrument-gate :severity :soft-escalate :note \"instrument :status :halted or :circuit-breaker? true -- ingestion or disclosure always escalates to a human, mirrors dossier's high-stakes gate\"} {:check :correction-request :severity :soft-escalate-unconditional :note \":correction/request never auto-resolves at any confidence, any phase\"}], :deliberately-absent {:check :credit-counterparty-check, :rationale \"this actor only collects, holds and serves price data -- it never extends credit, takes a position, routes an order, or holds custody, so no analog of fueltrade/shosha/commtrade's counterparty-credit checks applies\"}, :actuation-invariant \":correction/request never a member of any phase's :auto set at any phase; :quote/ingest and :series/derive only auto-eligible at phase 3 and only when governor-clean\", :r0-scope {:source-catalog [\"European Central Bank euro foreign exchange reference rates (public, free, official) -- :fx\" \"U.S. Energy Information Administration Open Data (public API, free, official) -- :commodity\" \"FRED S&P/Case-Shiller U.S. National Home Price Index (public API, free, official) -- :real-estate-index\"], :structural-class \"licensed-operator-feed -- equities/crypto/most commodities require an operator-registered ACTIVE feed-license, same operator-supplies-own-licensed-feed boundary as kotoba-lang/securities; never a hardcoded free-source claim for these asset classes\", :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as siblings\"}, :robotics {:value false, :key-present false, :rationale \"a market-data actor's entire surface is collecting, holding and serving price data; no physical delivery, custody, or trade execution exists inside the actor's boundary\"}, :test-results {:unit-tests \"32 tests / 137 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end: op1 ECB reference-rate update -> commit, op2 unsourced tick -> hold (source-provenance-gate), op3/op3a over-tier and uncontracted disclosure -> hold (licensed-disclosure), op4 halted-instrument ingest -> escalate -> approve -> commit, op5 data-quality correction -> escalate -> approve -> commit, op6 tolerance breach (10x price swing) -> hold (tolerance-gate)\"}, :deps-fix \"template (cloud-itonami-isic-8291) deps.edn referenced a stale :local/root path (../../com-junkawasaki/langgraph-clj / langchain-clj) from before those repos were renamed/transferred to kotoba-lang/langgraph and kotoba-lang/langchain; this repo's deps.edn and CI workflow were corrected to the current path before tests were run\", :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. kotoba-lang/industry pin advanced in manifest/west.yml (--entry industry, minimal diff, landed in superproject commit 3f3f83a3f1a7)\"}"
