(vector (map (:db/id -1)
  (:adr/id "adr-2607196500-kami-midi-feedback-imsc-import")
  (:adr/title "KAMI adds MIDI feedback and IMSC import")
  (:adr/date "2026-07-19")
  (:adr/status "accepted")
  (:adr/authoritative true)
  (:adr/topic "kotoba-lang-media-authoring")
  (:adr/supersedes (vector "adr-2607196400-kami-midi-control-imsc-delivery"))
  (:adr/decision
  (map (:daw (map (:midi-learn-policy :next-channel-control-change)
         (:learn-target :plugin/mix)
         (:mapping-authority :project/midi-mappings)
         (:feedback-policy :send-normalized-value-to-all-connected-outputs)
         (:feedback-message (vector :status-channel :controller-number :value-0-127))
         (:feedback-triggers (vector :midi-input :ui-wet-mix-change))
         (:automation-policy :same-as-pointer-gesture)))
   (:nle (map (:imsc-import-parser :browser-dom-parser)
         (:security-policy (vector :reject-doctype :reject-parser-error))
         (:required-authority (vector :ttml-namespace :imsc-1.2-text-content-profile))
         (:time-expressions (vector :clock-milliseconds :offset-seconds :frame-clock))
         (:imported-status :draft)
         (:imported-authority (vector :language :timing :text :inline-position :inline-align :inline-font-scale))
         (:multiline-policy :ttml-br-to-newline)
         (:language-replacement-policy :replace-and-cascade-review-notifications)))
   (:maturity (map (:kami-app-daw :逍遥) (:kami-app-nle :逍遥)))
   (:remaining-commercial-gates
   (map (:shared (vector "persistent directory grants" "streaming package I/O above 512 MiB"))
    (:daw (vector "third-party plugin SDK/isolation" "full Mackie/HUI transport protocol" "surround/Atmos"))
    (:nle (vector "inherited IMSC style resolution" "external notification delivery" "translation memory" "OCIO/ICC/HDR"))))))
  (:adr/implementation
  (map (:daw-commits (vector "a4a3b51b133f5c3687056fc359d8c93f4660a077"))
   (:nle-commits (vector "176411c15304e7afe3a801057c492a1b8b175c31"))
   (:pull-requests (vector "kotoba-lang/kami-app-daw#23" "kotoba-lang/kami-app-nle#23"))
   (:evidence
   (vector "DAW passes 30 tests and 125 assertions; NLE passes 33 tests and 168 assertions after offset/frame-clock interoperability review."
    "Both guarded shadow-cljs production releases completed with zero compiler warnings; NLE waited for the workspace build lock before compiling."
    "Chrome MIDI Learn captured previously unmapped channel 2 CC 21 and applied value 100 through Touch automation at tick 1440."
    "The mock MIDI output received exact feedback bytes [177 21 100], and downloaded EDN retained the learned mapping and automation."
    "Chrome imported an IMSC 1.2 Japanese fixture using 1.5s offset timing as frame 45, draft status and language ja."
    "The imported multiline text rendered flattened in the HTML input but downloaded EDN retained the newline between both Japanese lines."
    "Unit evidence covers clock milliseconds, offset seconds, valid frame clock, invalid out-of-range frame clock, replacement cascade and invalid cue rejection."
    "Automated Chrome and both local servers were closed after verification."
    "Both application PRs were reviewed and merged."))))
  (:adr/consequences
  (vector "MIDI setup can be learned from physical movement and controller state can follow software changes bidirectionally."
   "IMSC delivery is now round-trippable into the caption review gate instead of export-only."
   "Imported captions cannot bypass review because every normalized cue starts as draft."
   "Inherited styling and complete hardware transport protocols remain explicit commercial-product gaps."))
  (:adr/source-format "edn")))
