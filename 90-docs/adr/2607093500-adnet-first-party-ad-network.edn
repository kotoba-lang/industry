 :problem
 {:source "owner directive 2026-07-09: 'r1, r2、また必要であれば adnetwork, adverse なども
           設計、実装, cloud-itonami , kotoba-lang で連携、実装'"
  :investigated
  ["R1 ad flywheel currently depends on ExoClick (third-party) — income subordinate to another
    party's fill rate / payout / settlement cycle; R2 (x402 creator payments) is already a
    vertically-integrated own stack"
   "kotoba-lang/senden exists but is self-marketing analytics (campaign/funnel/attribution on
    chobo.ledger/shitsuke) — a different domain from serving third-party ads with auction+billing;
    a new kotoba-lang/adnet is warranted"
   "cloud-itonami is a langgraph-clj ops-LLM ⊣ CertGovernor actor (propose→govern→commit) serving
    industry verticals — advertiser ops fits as one vertical"]
  :risk "prepaid/accrual billing avoids per-impression on-chain tx (gas would dwarf a $0.002
         impression); the periodic settlement sweep + x402 top-up verification is ad-server
         Worker follow-up. Ad-policy enforcement (tier segregation, prohibited content) lives in
         cloud-itonami's CertGovernor."}

 :decision
 {:library
  {:repo "kotoba-lang/adnet (public, Apache-2.0, pure .cljc, zero-dep/zero-I/O)"
   :status "landed (7 tests / 30 assertions, clj-kondo clean)"
   :adnet-core ["campaign model {:creative :bid{:cpm|:cpc} :targeting :budget :flight :status}"
                "eligible? (tier/format/placement/geo/flight/budget)"
                "ecpm-micros / select (eCPM auction; CPC normalized by assumed CTR)"
                "serve (paid winner or house-ad backfill promoting the x402 catalog + creator support)"
                "apply-spend / reset-daily (budget/pacing transitions, auto-pause on exhaustion)"]
   :adnet-billing ["charge-micros (CPM=bid/1000/impr, CPC=bid/click, cross cases free)"
                   "accrue (fold event into campaign: charge + budget advance + append-only ad-event)"
                   "balance-micros / low-balance? (prepaid accounting; x402 top-up signal)"]}
  :billing-rail "advertisers billed in USDC via the x402 rail (pay + treasury): prepaid deposit
                 verified by treasury/receipt->onchain, drawn down by impressions/clicks, x402
                 top-up when low — ad income flows in USDC through our own facilitator"
  :advertiser-ops "cloud-itonami operates campaign management as an ad vertical: ops-LLM proposes
                   create/pause/targeting, CertGovernor censors ad policy (tier segregation,
                   prohibited content, budget caps), approvals commit to the immutable ledger;
                   reuses adnet.core's pure logic"
  :publisher "sellers (shinshi ad_slot, future isekai) call adnet/serve for first-party/house ads
              in front of / instead of ExoClick, which stays as fill backfill until paid campaigns
              mature"}

 :consequences
 {:landed "adnet core (serving + billing) complete"
  :followups ["ad-server Worker (serve per placement, record impr/click via accrue, verify x402
               top-ups) — same shape as nexus-x402"
              "shinshi ad_slot wiring: static house ad → adnet dynamic serve (house-ad already
               promotes the x402 catalog, making R1 inventory a funnel into R2 demand)"
              "cloud-itonami advertiser-ops actor (propose→govern→commit) + RAD registration"
              "periodic settlement sweep (accrued charges → x402 top-up reconciliation)"]
  :r1-r2-integration "adnet's house-ad promotes the x402 catalog + creator support, so ad
                      inventory (R1) doubles as a funnel into x402 demand (R2) — the two income
                      loops reinforce each other"
  :manifest "register orgs/kotoba-lang/adnet in repos.edn; gen-west-manifest --entry adnet minimal diff"}

 :alternatives
 [{:option "keep depending on ExoClick / third-party ad networks for R1"
   :rejected_because "income subordinate to another party's fill/payout/settlement; same rationale
                      as self-hosting x402 payments — but ExoClick stays as fill backfill until
                      first-party paid campaigns mature"}
  {:option "extend kotoba-lang/senden to serve ads"
   :rejected_because "senden is self-marketing analytics (campaign/funnel/attribution), a distinct
                      domain from serving third-party ads with auction/billing; mixing lowers
                      cohesion of both"}
  {:option "bill advertisers in a bespoke token/credit"
   :rejected_because "the x402/USDC rail already exists; advertisers paying in the same USDC has
                      less friction and shares settlement infra with R2"}
  {:option "settle on-chain per impression"
   :rejected_because "paying Base gas for a $0.002 impression is uneconomic; prepaid deposit +
                      accrual + periodic x402 top-up sweep is the right granularity"}]}
