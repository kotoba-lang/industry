[{:adr/consequences "{:landed \"adnet core (serving + billing) complete\", :followups [\"ad-server Worker (serve per placement, record impr/click via accrue, verify x402\\n               top-ups) — same shape as nexus-x402\" \"shinshi ad_slot wiring: static house ad → adnet dynamic serve (house-ad already\\n               promotes the x402 catalog, making R1 inventory a funnel into R2 demand)\" \"cloud-itonami advertiser-ops actor (propose→govern→commit) + RAD registration\" \"periodic settlement sweep (accrued charges → x402 top-up reconciliation)\"], :r1-r2-integration \"adnet's house-ad promotes the x402 catalog + creator support, so ad\\n                      inventory (R1) doubles as a funnel into x402 demand (R2) — the two income\\n                      loops reinforce each other\", :manifest \"register orgs/kotoba-lang/adnet in repos.edn; gen-west-manifest --entry adnet minimal diff\"}", :adr/authoritative_for ["ad serving/auction/billing logic is the pure kotoba-lang/adnet library (adnet.core +\n    adnet.billing); the advertising twin of the x402 payment stack" "advertisers are billed in USDC over the x402 rail (kotoba-lang/pay + treasury) via prepaid\n    deposits + accrual, not a third-party network's payout" "cloud-itonami operates advertiser campaign management as an ad vertical of its ops-LLM ⊣\n    CertGovernor propose→govern→commit loop" "publishers (shinshi ad_slot, future isekai) call adnet/serve for first-party/house ads,\n    coexisting with ExoClick as fill backfill"], :adr/supersedes [], :adr/superseded_by [], :adr/topic "adnet-first-party-ad-network", :adr/related ["90-docs/adr/2607093100-x402-monetization-gateway-integration.md" "90-docs/adr/2607093300-nexus-x402-facilitator-gateway.md" "90-docs/adr/2607051621-treasury-extraction.md"], :adr/status "accepted", :adr/id "adr-2607093500-adnet-first-party-ad-network", :adr/doc_type "adr", :adr/last_verified "2026-07-09", :adr/decision "{:library {:repo \"kotoba-lang/adnet (public, Apache-2.0, pure .cljc, zero-dep/zero-I/O)\", :status \"landed (7 tests / 30 assertions, clj-kondo clean)\", :adnet-core [\"campaign model {:creative :bid{:cpm|:cpc} :targeting :budget :flight :status}\" \"eligible? (tier/format/placement/geo/flight/budget)\" \"ecpm-micros / select (eCPM auction; CPC normalized by assumed CTR)\" \"serve (paid winner or house-ad backfill promoting the x402 catalog + creator support)\" \"apply-spend / reset-daily (budget/pacing transitions, auto-pause on exhaustion)\"], :adnet-billing [\"charge-micros (CPM=bid/1000/impr, CPC=bid/click, cross cases free)\" \"accrue (fold event into campaign: charge + budget advance + append-only ad-event)\" \"balance-micros / low-balance? (prepaid accounting; x402 top-up signal)\"]}, :billing-rail \"advertisers billed in USDC via the x402 rail (pay + treasury): prepaid deposit\\n                 verified by treasury/receipt->onchain, drawn down by impressions/clicks, x402\\n                 top-up when low — ad income flows in USDC through our own facilitator\", :advertiser-ops \"cloud-itonami operates campaign management as an ad vertical: ops-LLM proposes\\n                   create/pause/targeting, CertGovernor censors ad policy (tier segregation,\\n                   prohibited content, budget caps), approvals commit to the immutable ledger;\\n                   reuses adnet.core's pure logic\", :publisher \"sellers (shinshi ad_slot, future isekai) call adnet/serve for first-party/house ads\\n              in front of / instead of ExoClick, which stays as fill backfill until paid campaigns\\n              mature\"}", :db/id -1, :adr/problem "{:source \"owner directive 2026-07-09: 'r1, r2、また必要であれば adnetwork, adverse なども\\n           設計、実装, cloud-itonami , kotoba-lang で連携、実装'\", :investigated [\"R1 ad flywheel currently depends on ExoClick (third-party) — income subordinate to another\\n    party's fill rate / payout / settlement cycle; R2 (x402 creator payments) is already a\\n    vertically-integrated own stack\" \"kotoba-lang/senden exists but is self-marketing analytics (campaign/funnel/attribution on\\n    chobo.ledger/shitsuke) — a different domain from serving third-party ads with auction+billing;\\n    a new kotoba-lang/adnet is warranted\" \"cloud-itonami is a langgraph-clj ops-LLM ⊣ CertGovernor actor (propose→govern→commit) serving\\n    industry verticals — advertiser ops fits as one vertical\"], :risk \"prepaid/accrual billing avoids per-impression on-chain tx (gas would dwarf a $0.002\\n         impression); the periodic settlement sweep + x402 top-up verification is ad-server\\n         Worker follow-up. Ad-policy enforcement (tier segregation, prohibited content) lives in\\n         cloud-itonami's CertGovernor.\"}", :adr/alternatives "[{:option \"keep depending on ExoClick / third-party ad networks for R1\", :rejected_because \"income subordinate to another party's fill/payout/settlement; same rationale\\n                      as self-hosting x402 payments — but ExoClick stays as fill backfill until\\n                      first-party paid campaigns mature\"} {:option \"extend kotoba-lang/senden to serve ads\", :rejected_because \"senden is self-marketing analytics (campaign/funnel/attribution), a distinct\\n                      domain from serving third-party ads with auction/billing; mixing lowers\\n                      cohesion of both\"} {:option \"bill advertisers in a bespoke token/credit\", :rejected_because \"the x402/USDC rail already exists; advertisers paying in the same USDC has\\n                      less friction and shares settlement infra with R2\"} {:option \"settle on-chain per impression\", :rejected_because \"paying Base gas for a $0.002 impression is uneconomic; prepaid deposit +\\n                      accrual + periodic x402 top-up sweep is the right granularity\"}]", :adr/authoritative true, :adr/title "ADR-2607093500: first-party ad network — kotoba-lang/adnet core + x402 USDC billing + cloud-itonami advertiser ops"}]