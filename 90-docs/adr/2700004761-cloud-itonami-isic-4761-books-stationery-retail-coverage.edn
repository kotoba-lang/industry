[{:adr/id 2700004761
  :adr/title "cloud-itonami-isic-4761 — Books/Newspapers/Stationery-Retail Operations Coordination"
  :adr/status :accepted
  :adr/date "2026-07-16"
  :adr/scope [:kotoba-lang/industry :cloud-itonami/cloud-itonami-isic-4761]
  :adr/references [2607121000 2700004751]

  ;; Wave 2 actor (coordination/logistics/trade): bookstore/newsstand/
  ;; stationery specialized-store retail operations coordination-only
  ;; (sales/inventory/return transaction logging, staffing-operation
  ;; scheduling, book/newspaper/stationery supply-order coordination,
  ;; inventory-concern flagging). Distinct from ISIC 4649-family
  ;; wholesale book/periodical distribution.

  :actor/id :cloud-itonami-isic-4761
  :actor/name "Books/Newspapers/Stationery-Retail Operations Coordinator"
  :actor/isic-rev5 "4761"
  :actor/domain :retail/books-newspapers-stationery-specialized-stores
  :actor/wave 2
  :actor/coordination? true
  :actor/robotics? true

  :actor/proposal-ops [:log-sales-record :schedule-staffing-operation
                       :coordinate-supply-order :flag-inventory-concern]
  :actor/always-escalate-ops [:flag-inventory-concern]
  :actor/cost-threshold-escalate-ops {:coordinate-supply-order 800}

  :actor/hard-checks [:store-verified :vendor-verified :effect-propose :scope-exclusion]
  :actor/scope-excluded-terms ["issue the refund" "authorize the refund" "approve the refund"
                                "issue a replacement" "authorize the replacement" "approve the replacement"
                                "void the sale" "finalize the return" "process the return"
                                "issue a chargeback to" "charge back the vendor"
                                "revoke the vendor's registration" "terminate the vendor contract"
                                "ban the title from the store" "remove the title from the catalog"
                                "pull the title from the shelves" "prohibit the title from sale"
                                "finalize the content-inclusion decision" "finalize the content-exclusion decision"
                                "返金を実行" "返金を承認した" "返品を確定した"
                                "タイトルを発禁にした" "書籍を発禁にした" "取り扱いを禁止にした" "タイトルを店頭から排除した"
                                "仕入先へのチャージバックを実行" "仕入先の登録を取り消した" "仕入先契約を解除した" "販売を無効化した"]

  ;; Self-trip-avoidance: every term above is phrased as the
  ;; finalization/execution ACTION, never a bare noun -- this namespace's
  ;; own :flag-inventory-concern default proposal legitimately discusses
  ;; damaged-stock/mis-shipment/quantity-mismatch observations, and its
  ;; own printed :op keyword literally contains the substring
  ;; "inventory-concern". A bare-noun term list (e.g. a literal
  ;; "inventory" or "title" entry) would self-trip this actor's own core
  ;; happy path on every single run. Regression test:
  ;; governor-test/default-mock-advisor-proposals-never-self-trip-scope-exclusion.
  ;; This actor adds a domain-specific FOURTH exclusion category beyond
  ;; sibling retail actors' return/refund-only scope: content-inclusion/
  ;; exclusion editorial-finalization terms (title banning/pulling/
  ;; prohibiting), because a bookstore-operations coordinator must never
  ;; be able to claim it decided which titles a store may or may not
  ;; carry.

  :phase/rollout
  {0 {:label "read-only" :writes #{} :auto #{}}
   1 {:label "assisted-logging" :writes #{:log-sales-record} :auto #{}}
   2 {:label "assisted-coordination" :writes #{:log-sales-record :schedule-staffing-operation
                                               :coordinate-supply-order}
      :auto #{}}
   3 {:label "supervised-auto" :writes #{:log-sales-record :schedule-staffing-operation
                                         :coordinate-supply-order :flag-inventory-concern}
      :auto #{:log-sales-record :schedule-staffing-operation :coordinate-supply-order}}}

  :operation/entry-point :intake
  :operation/nodes [:intake :advise :govern :decide :request-approval :commit :hold]

  :test/counts {:total 58 :assertions 170 :failures 0 :errors 0}
  :test/coverage [:governor-hard-checks :advisor-shapes :phase-rollout :integration
                  :store-contract :scope-exclusion-self-trip-regression
                  :vendor-verification]
  :test/simulator :bookstoreops.sim

  :registry/maturity :implemented
  :registry/repo "https://github.com/cloud-itonami/cloud-itonami-isic-4761"
  :registry/business-id "cloud-itonami-isic-4761"
  :registry/required-technologies [:robotics :identity :forms :dmn :bpmn :audit-ledger :retail]
  :registry/operating-states [:intake :stock :sell :reconcile :reorder :audit]

  :db/id -1}]
