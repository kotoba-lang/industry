(vector (map (:db/id -1)
  (:adr/id "ADR-2608125100")
  (:adr/title "Retire the five security-gate-* scripts, and record what G-004 through G-008 were meant to check")
  (:adr/status "accepted")
  (:adr/date "2026-08-12")
  (:adr/doc_type "adr")
  (:adr/doc-type "adr")
  (:adr/source-format "edn")
  (:adr/authoritative true)
  (:adr/deciders (vector "Jun Kawasaki"))
  (:adr/topic "kotoba-stack-security-assurance")
  (:adr/supersedes "")
  (:adr/superseded-by "")
  (:adr/related (vector "ADR-2608124800" "ADR-2607198100" "ADR-2607198200"))
  (:adr/authoritative-for
  (vector "disposition of scripts/security-gate-*.cljs"
   "where the real evidence for security gaps G-004 through G-010 lives"))
  (:adr/decision "delete-all-five-rewrite-none")
  (:adr/deleted-files
  (vector "scripts/security-gate-abac-audit.cljs"
   "scripts/security-gate-audit-trail-test.cljs"
   "scripts/security-gate-georestores-test.cljs"
   "scripts/security-gate-hsm-export-test.cljs"
