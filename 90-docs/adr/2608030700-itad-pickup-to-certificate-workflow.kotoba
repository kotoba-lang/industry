  (:adr/topic "itad-pickup-to-certificate-workflow")
  (:adr/authoritative_for
  (vector "itad.gftd.ai の 2 段階目フォーム(回収手続き)と署名 token 経路"
   "order の状態機械(:requested → :scheduled → :collected → :processing → :erased → :certified)"
