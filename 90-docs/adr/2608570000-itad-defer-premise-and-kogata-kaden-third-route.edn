  :adr/id "2608570000-itad-defer-premise-and-kogata-kaden-third-route"
  :adr/title "ADR-2608570000: itad.gftd.ai を外部連携前提で運転し、小型家電リサイクル法13条を第3の経路として記録する"
  :adr/status "accepted"
  :adr/doc_type "adr"
  :adr/topic "itad-licensing"
  :adr/date "2026-08-04"
  :adr/last_verified "2026-08-04"
