 (map
  (:adr/id "adr-2609111000-shinshi-club-runs-on-four-planes-and-three-were-silent")
  (:adr/title "shinshi.club runs on four bot planes, and three of them were silent")
  (:adr/status "accepted")
  (:adr/date "2026-09-11")
