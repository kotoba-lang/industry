[{:adr/repos ["orgs/kotoba-lang/murakumo" "orgs/gftdcojp/cloud-murakumo" "orgs/gftdcojp/cloud-murakumo-fleet"], :adr/note "本ADRは命名方針の決定のみ。GitHubリポジトリ名変更・west manifest反映は共有状態への破壊的でない(rename)が可視的な操作のため、別途オーナー確認の上で実施する。", :adr/rationale ["-fleet suffix は衝突回避の副産物であり役割を説明しない" "local-murakumo は『CLIは持たずlocal-first OSS CLIのクラウド接続を提供するだけ』という実態とSoraとの対比を両方表す" "CLI本体(kotoba-lang/murakumo)の名前は変えないため west :path-overrides 一発で完結する"], :adr/related ["90-docs/adr/2606272300-cloud-murakumo-gpu-cloud.md" "90-docs/adr/2606302300-org-taxonomy-4-orgs.md"], :adr/status "proposed", :adr/id "adr-2607041302-murakumo-family-naming", :adr/decision "{:kotoba-lang/murakumo \"共通lib(かつ唯一のCLI本体)として正式に位置づける。変更なし。\", :gftdcojp/cloud-murakumo \"Sora。現状維持(クラウドGPUレンタルという原義と一致)。\", :gftdcojp/cloud-murakumo-fleet \"gftdcojp/local-murakumo へ改名。衝突回避の -fleet サフィックスを、Sora(cloud)との対比が伝わる名前に置換。\"}", :adr/date "2026-07-04", :adr/family "{:kotoba-lang/murakumo {:role :common-lib+cli, :description \"kotoba WASM lattice の制御面。nbb/clj 製 OSS CLI(`nbb murakumo ...`)。standalone・ローカル store。唯一の実行ツール。\", :change :none}, :gftdcojp/cloud-murakumo {:alias \"Sora\", :role :product, :description \"Modal 等価の GPU serverless 製品。kotoba-lang/murakumo の auction に GPU 在庫を bid 対象として乗せる製品面。CLI実体なし。\", :decided-by \"90-docs/adr/2606272300-cloud-murakumo-gpu-cloud.md\", :change :none}, :gftdcojp/cloud-murakumo-fleet {:role :cloud-edge-api, :former-name \"com-junkawasaki/cloud-murakumo (renamed 2026-07-02 on transfer, collided with gftdcojp/cloud-murakumo(Sora))\", :description \"kotoba-lang/murakumo CLI の外部公開エッジAPI(Cloudflare Worker + kotobase.net)。CLI実体なし。GPUレンタル・課金もしない。\", :change {:rename-to \"gftdcojp/local-murakumo\", :status :proposed-not-executed}}}", :db/id -1, :adr/follow-up-not-executed "[{:step 1, :action \"gh repo rename cloud-murakumo-fleet local-murakumo --repo gftdcojp/cloud-murakumo-fleet\"} {:step 2, :action \"manifest/repos.edn に :path-overrides \\\"orgs/gftdcojp/cloud-murakumo-fleet\\\" -> \\\"orgs/gftdcojp/local-murakumo\\\" を追加。nbb scripts/gen-west-manifest.cljs --entry local-murakumo → --check\"} {:step 3, :action \"リポジトリ内README(タイトル `# cloud-murakumo` / 本文の自称)を local-murakumo に更新\"} {:step 4, :action \"manifest/repos.edn:57 の 2026-07-02 transfer コメントを rename 後の状態に更新\"} {:step 5, :action \"他ADR/ドキュメントの cloud-murakumo-fleet 参照を grep して更新漏れがないか確認\"}]", :adr/authoritative true, :adr/title "murakumo ファミリーの命名整理 — gftdcojp/cloud-murakumo-fleet を gftdcojp/local-murakumo へ"}]