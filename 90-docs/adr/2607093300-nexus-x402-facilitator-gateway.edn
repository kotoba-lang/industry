[{:adr/consequences "{:landed \"pay.facilitator complete as the gateway core; nexus-x402 scaffolded, repo created,\\n           pushed; worker :esm build 0 warnings\", :followup_deploy \"deploy nexus-x402 to Cloudflare (custom domain e.g. nexus.gftd.ai), populate\\n                    SELLERS_JSON with each seller's rule+origin+public treasury, set\\n                    BASESCAN_API_KEY secret — touches gftdcojp Cloudflare, coordinate with\\n                    concurrent subagents per this session's ownership rule\", :followup_migration \"move shinshi/murakumo/kotobase per-app gates toward nexus delegation\\n                       (facilitator API) or front them with the gateway proxy, per seller;\\n                       monitor vendored pay.* drift per repo\", :eip3009 \"discovery advertises exact, but the on-chain authorization submit (gasless relay)\\n            is a base-l2/wallet follow-up; the effective path today is the transaction scheme\", :manifest \"register orgs/gftdcojp/nexus-x402 in repos.edn; gen-west-manifest --entry nexus-x402\\n             minimal diff; verify pin == repo HEAD server-side\"}", :adr/authoritative_for ["gftdcojp/nexus-x402 is the self-hosted, edge-deployed x402 facilitator/gateway service\n    for all gftdcojp & kotoba-lang sellers (shinshi/murakumo/kotobase), verifying payments\n    on-chain at the edge and settling to each seller's OWN treasury — facilitator holds no keys" "the gateway core is the pure kotoba-lang/pay namespace pay.facilitator (rules engine +\n    verify/settle/gate/discovery), which nexus-x402 and any seller worker compose; nexus adds\n    only HTTP + on-chain I/O (Basescan verify via treasury.core)" "two integration modes: facilitator API (POST /verify, /settle, GET /.well-known/x402) for\n    thin delegation, and gateway proxy (ANY /gateway/<seller>/<path>) for front-of-origin gating" "seller rules + origins are SELLERS_JSON config (public treasury addresses only, no keys);\n    honest default: unknown seller -> 404, unverified payment -> 402"], :adr/supersedes [], :adr/superseded_by [], :adr/topic "nexus-x402-facilitator-gateway", :adr/related ["90-docs/adr/2607093100-x402-monetization-gateway-integration.md" "90-docs/adr/2607092700-shinshi-inc-settlement-kotoba-lang-pay.md" "90-docs/adr/2607051621-treasury-extraction.md"], :adr/status "accepted", :adr/id "adr-2607093300-nexus-x402-facilitator-gateway", :adr/doc_type "adr", :adr/last_verified "2026-07-09", :adr/decision "{:gateway_core {:ns \"pay.facilitator (kotoba-lang/pay)\", :status \"landed (19 tests / 112 assertions, clj-kondo clean)\", :invariants \"pure .cljc, zero-dep, zero network I/O, zero key custody\", :pieces [\"rules engine / seller registry: ordered rules {:seller :method :path-prefix :usd\\n             :pay-to :chain :scheme}, first structural match; many sellers each with own\\n             treasury share one keyless facilitator (match-rule, rule->requirements)\" \"verify — x402 /verify decision {:isValid :invalidReason :payer}\" \"settle — x402 /settle decision (reuses pay.x402/authorize)\" \"gate — transport-independent end-to-end decision (:pass/:challenge/:serve/:hold)\" \"discovery — the /.well-known/x402 facilitator discovery document\"]}, :service {:repo \"gftdcojp/nexus-x402 (private, scaffolded + GitHub repo created + pushed)\", :stack \"Cloudflare Worker, ClojureScript shadow-cljs :esm; vendors pay.facilitator +\\n           pay.x402 + treasury.core; adds only HTTP envelope + Basescan on-chain verify\", :build \"worker :esm build 0 warnings; smoke tests 2/7 green; clj-kondo clean\", :modes [\"Facilitator API: POST /verify, POST /settle, GET /.well-known/x402, GET /health\" \"Gateway proxy: ANY /gateway/<seller>/<path> — no X-PAYMENT -> 402 challenge;\\n            X-PAYMENT -> on-chain verify -> proxy seller origin + X-PAYMENT-RESPONSE\"], :config \"SELLERS_JSON (rules + origins, public treasury addrs only, no keys);\\n            BASESCAN_API_KEY via wrangler secret\"}, :key_custody \"zero — each seller's own treasury receives; nexus only verifies. Not locked to\\n                a closed vendor facilitator; same x402 wire keeps CF-facilitator migration cheap.\", :coexistence \"shinshi /x402/premium/* (live) and murakumo/kotobase per-app gates (PRs) coexist;\\n                nexus offers central delegation as an opt-in migration, not a forced replacement\"}", :db/id -1, :adr/problem "{:source \"owner directive 2026-07-09: 'gftdcojp/nexus-x402 を設計して、x402 の決済 gateway を\\n           kotoba-lang で設計'\", :investigated [\"ADR-2607093100 wired per-app x402 gates (shinshi L0, murakumo/kotobase L3), but each seller\\n    worker vendors pay.x402 + treasury.core and re-implements the Basescan fetch / verify /\\n    challenge wiring — duplication\" \"Cloudflare Monetization Gateway is a CENTRAL facilitator: sellers register pricing rules,\\n    the facilitator verifies at the edge; nexus-x402 is our self-hosted equivalent\" \"the gateway LOGIC belongs in kotoba-lang so both nexus and any seller worker compose it\\n    (some sellers embed rather than delegate) — pay.facilitator, pure .cljc\"], :risk \"EIP-3009 exact-scheme relay (gasless authorization submit) is a base-l2/wallet follow-up;\\n         the working path today is the transaction scheme (buyer broadcasts tx first). Deploying\\n         nexus touches gftdcojp Cloudflare resources -> coordinate with concurrent subagents.\"}", :adr/alternatives "[{:option \"keep each seller vendoring its own gate (status quo)\", :rejected_because \"duplicates Basescan/verify/wiring, scatters verification logic, no\\n                      cross-seller rules/discovery; a central facilitator is the Monetization\\n                      Gateway design and removes the duplication\"} {:option \"adopt Cloudflare Monetization Gateway (closed waitlist) as the facilitator\", :rejected_because \"same as ADR-2607093100: waitlist dependency + vendor lock-in; adopt only\\n                      the standard (x402) and run our own facilitator\"} {:option \"write the gateway core inside nexus-x402 (not a kotoba-lang library)\", :rejected_because \"seller workers also reuse the core (some embed rather than delegate); it\\n                      belongs in pure .cljc kotoba-lang — matches the owner directive to design\\n                      the gateway in kotoba-lang\"} {:option \"give the facilitator keys and let it submit EIP-3009\", :rejected_because \"breaks the no-key-custody invariant; gasless relay is a separate follow-up\\n                      (payer-device signing + base-l2 bundler); facilitator stays verify-only\"}]", :adr/authoritative true, :adr/title "ADR-2607093300: gftdcojp/nexus-x402 — self-hosted x402 payment facilitator/gateway, gateway core = kotoba-lang/pay pay.facilitator", :adr/references ["https://blog.cloudflare.com/monetization-gateway/"]}]