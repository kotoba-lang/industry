  (:adr/title "hot db の index は counterpart が 1 つのあいだ値を直接持つ —— 99.5% が singleton set で、1 つ 160 B、full SF1 の 10.9 GB のうち 6.4 GB がそれ（提案）")
  (:adr/status "proposed")
  (:adr/date "2026-09-11")
