(vector (map (:db/id -1)
  (:adr/id "adr-2608045000-kotobase-capability-topology-peer-retirement")
  (:adr/title "ADR-2608045000: Kotobase capability topology — datom core, lake, federation, projection, anchoring, and kotobase-peer retirement")
  (:adr/status "accepted")
  (:adr/doc-type "adr")
  (:adr/source-format "edn")
  (:adr/date "2026-08-04")
  (:adr/last-verified "2026-08-04")
  (:adr/authoritative true)
  (:adr/deciders (vector "Jun Kawasaki"))
  (:adr/topic "kotobase-capability-topology-peer-retirement")
  (:adr/repos (vector "orgs/kotoba-lang/kotobase"
              "orgs/kotoba-lang/kotobase-engine-contract"
              "orgs/kotoba-lang/kotobase-engine-prolly"
              "orgs/kotoba-lang/kotobase-engine-lsm"
              "orgs/kotoba-lang/kotobase-storage"
              "orgs/kotoba-lang/kotobase-lake"
              "orgs/kotoba-lang/kotobase-projection"
              "orgs/kotoba-lang/kotobase-federation"
              "orgs/kotoba-lang/kotobase-maintenance"
              "orgs/kotoba-lang/kotobase-anchor-fevm"
              "orgs/kotoba-lang/kotobase-peer"
              "orgs/kotoba-lang/kotobase-server"
              "orgs/network-awai/net-kotobase"))
  (:adr/authoritative-for
  (vector "Kotobase の capability 境界と許可される依存方向"
   "graph/datombase を中核、lake・federation・projection・anchor を optional capability、net-kotobase を composition/deployment owner とする構造"
   "kotobase-peer を新しい恒久 capability 名へ rename せず、機能抽出後に compatibility facade として退役させる判断"
   "immutable commit DAG、CID、IPLD、IPFS と blockchain anchor を同一視しない境界"))
  (:adr/related
  (vector "adr-2608039970-kotobase-base-is-the-datom-plane-not-datalog"
   "adr-2607312100-kotobase-layering-block-ref-split-signed-head"
   "adr-2608010000-mutable-state-on-an-immutable-object-store"
   "adr-2608039000-d1-is-not-a-premise-in-decentralized-paths"
   "net-kotobase/docs/adr/2607142200-strong-transactions-native-ipld-federation.md"
   "net-kotobase/docs/adr/260718-runtime-deployment-ownership.md"
   "net-kotobase/docs/adr/regulated-tier-maturity.md"))
  (:adr/decision
  (map (:layers
   (vector (map (:level 0)
     (:name "logical-and-content-primitives")
     (:owners (vector "datom" "datom-model" "datalog" "ipld" "multiformats"
              "prolly-tree" "merkle-lsm")))
    (map (:level 1)
     (:name "storage-contracts-and-providers")
     (:owners (vector "kotobase-storage" "kotobase-storage-s3"
              "kotobase-storage-d1")))
    (map (:level 2)
     (:name "database-engines")
     (:owners (vector "kotobase-engine-contract" "kotobase-engine-prolly"
              "kotobase-engine-lsm")))
    (map (:level 3)
     (:name "database-api-and-service")
     (:owners (vector "kotobase" "kotobase-server" "query protocol adapters")))
    (map (:level 4)
     (:name "optional-capabilities")
     (:owners (vector "kotobase-lake" "kotobase-projection"
              "kotobase-federation" "kotobase-maintenance"
              "kotobase-anchor-fevm")))
    (map (:level 5)
     (:name "product-composition-and-deployment")
     (:owners (vector "network-awai/net-kotobase"))
     (:note
     "owner は単数だが repo は単数ではない（2026-08-04、ADR-2608051000 で改訂）。
      net-kotobase は zone・composition policy・delegation 台帳・共通リリース証跡の owner であり、
      個々の capability は net-kotobase-* family の repo が 1 host ずつ配信する。
      ADR-260718 が既に持つ zone 所有と hostname 委譲の区別に載る（先例 wiki.kotobase.net）。
      本 level が禁じ続けるのは『net-kotobase 以外が共通 database/security semantics を fork すること』
      であって、capability ごとに deploy shell を分けることではない。"))))
   (:dependency-rule
   "Dependencies point from a higher layer to a lower layer. Optional capabilities may share lower contracts but must not import one another merely to reuse deployment code.")
   (:prohibitions
   (vector "A database engine must not import lake, federation, blockchain anchor, or deployment code."
    "A blockchain anchor must not be part of foreground transact/query success."
    "Federation may distribute and certify blocks, refs, heads, checkpoints, and receipts but must not own query semantics."
    "Lake owns catalog/provenance datoms, not byte transport or storage-provider credentials."
    "net-kotobase composes released libraries and owns external deployment; it must not fork common database or security semantics."))
   (:peer-retirement
   (map (:reason
    "kotobase-peer is not one capability. It combines a legacy embedded Datom engine, Merkle-LSM mechanism, projection maintenance, authorization policy, replica availability audit, retention, backup/restore, resumable scheduling, transactor batching, provider code, GC, and Worker host orchestration. The name peer also collides with the network-peer meaning used by federation.")
    (:destinations
    (map ("core" "kotobase-engine-prolly plus the public kotobase API; retain only a compatibility facade")
     ("merkle-lsm, block-sizing, performance-gate" "merkle-lsm and kotobase-engine-lsm")
     ("cache" "block-cache and host composition")
     ("materialized-view, datalog-materialization, statistics, atomic-publication" "kotobase-projection")
     ("availability" "kotobase-federation")
     ("retention, database-restore, resumable-execution" "kotobase-maintenance")
     ("policy, transactor" "kotobase-server or its generic authorization dependencies")
     ("object-store.worker provider operations" "kotobase-storage-s3")
     ("object-store.worker deployment scheduling" "net-kotobase")))
    (:temporary-name "kotobase-peer-compat")
    (:rule "No new feature may land in kotobase-peer after extraction begins. Compatibility namespaces delegate to the destination capability and are removed after all pinned consumers migrate.")))
   (:product-rule
   "Graph/datombase is the nucleus. Lake, federation, projection, and blockchain anchoring are independently selectable capabilities. net-kotobase may present them as one product only with an explicit implemented/experimental/planned maturity matrix.")))
  (:adr/consequences
  (map (:positive
   (vector "GraphDB, data lake, federation, and blockchain anchoring can coexist without becoming mutual premises."
    "A local or centralized deployment can omit federation and anchoring while retaining identical Datom semantics."
    "A federated deployment can replace its ref-consensus implementation without replacing the query engine."
    "Blockchain integrations become additive witnesses rather than database correctness dependencies."))
   (:negative
   (vector "The split requires a staged migration because net-kotobase and kotobase-server pin concrete kotobase-peer revisions."
    "Compatibility namespaces must be maintained until downstream pins move."
    "Atomic base-plus-projection publication requires a contract shared by the engine and projection layers without introducing a reverse engine dependency."))))
  (:adr/migration
  (vector (map (:step 1) (:action "Freeze kotobase-peer feature growth and add this topology decision."))
   (map (:step 2) (:action "Extract pure projection, federation, and maintenance capabilities with their existing tests."))
   (map (:step 3) (:action "Move provider, policy, batching, and engine-specific code to existing owners."))
   (map (:step 4) (:action "Make kotobase-peer namespaces thin compatibility facades and update pinned consumers."))
   (map (:step 5) (:action "Shadow the IEngine path in net-kotobase, qualify parity, then switch primary traffic."))
   (map (:step 6) (:action "Rename the residual repository to kotobase-peer-compat for one compatibility cycle, then archive it when consumers reach zero."))))
  (:adr/body
  "Kotobase is one composable product, not one indivisible runtime. The shared premise is the content-addressed block/ref/object boundary and the immutable Datom logical model. Query languages are peer frontends over that model. A data lake adds catalog and provenance Datoms while object bytes remain in the object plane. Federation distributes or certifies immutable blocks and mutable heads through injected transports and ref consensus. Blockchain adapters asynchronously anchor logical checkpoints and are never required by foreground database correctness. net-kotobase is the only public deployment owner and composes these capabilities.\n\nThe historical kotobase-peer repository cannot receive an honest permanent rename because its source tree contains several unrelated capabilities. The correct operation is extraction followed by compatibility retirement, not relabelling the monolith. During migration its public namespaces remain available as delegating facades, but new behavior lands only in the capability owner named by this ADR.")))
