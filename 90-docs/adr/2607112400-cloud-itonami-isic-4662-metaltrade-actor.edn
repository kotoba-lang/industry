  :adr/decision-summary "{:pattern \"sealed MetalTradeAdvisor + independent :metal-trading-governor + append-only audit ledger, PRINCIPAL trading model with a chain-of-custody/provenance regulatory backbone -- distinct from every prior sibling's jurisdiction-of-trade focus\", :new-actor \"cloud-itonami-isic-4662\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-4662\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"4662\", :isic-name \"Wholesale of metals and metal ores\", :registry-promotion \"kotoba-lang/industry registry.edn id 4662: :maturity :spec (dead gftdcojp/cloud-itonami-G4662 placeholder URL) -> :implemented (real repo)\", :namespace \"metaltrade\", :provenance-check {:check :conflict-minerals-provenance-unverified, :fires-for-metal-type #{:tin :tantalum :tungsten :gold :cobalt}, :note \"3TG + cobalt; gated on the COMMODITY's metal type not on jurisdiction, unconditional across jurisdiction unlike every jurisdiction-gated check in sibling actors; requires BOTH :chain-of-custody-documented? (to mine of origin) AND :conflict-free-smelter-certified? (RMI/RMAP-style); NO-OP for base metals, proven via gold-vs-copper control pair in tests/demo\", :cobalt-scope-note \"cobalt is an explicit POLICY EXTENSION beyond strict legal 3TG scope (neither Dodd-Frank §1502 nor EU Reg. 2017/821 legally cover it) -- documented as a reasoned scope decision grounded in OECD Guidance's mineral-agnostic framing + real DRC artisanal-mining human-rights literature, NOT asserted as a hard-law claim\"}, :governor-checks [{:check :spec-basis :severity :hard} {:check :evidence-incomplete :severity :hard} {:check :credit-uncleared :severity :hard} {:check :contract-missing :severity :hard} {:check :conflict-minerals-provenance-unverified :severity :hard} {:check :counterparty-sanctions-flag-unresolved :severity :hard} {:check :already-dispatched :severity :hard} {:check :already-invoiced :severity :hard} {:check :high-stakes-actuation-gate :severity :soft-escalate}], :robotics {:value true, :rationale \"reasoned separately for two commodity forms: bulk ore (stacker-reclaimer/conveyor automation at bulk terminals) and refined metal (overhead-crane/AGV-forklift automation at LME-style warehouses), both terminating at the wholesaler's own dispatch point\"}, :r0-scope {:general-trade-catalog [\"JPN 関税法/輸出貿易管理令 MOF/METI\" \"USA Tariff Act of 1930, CBP+OFAC\" \"GBR Taxation (Cross-border Trade) Act 2018, HMRC+SAMLA 2018/OFSI\" \"DEU/EU Union Customs Code Regulation (EU) 952/2013, Zoll/BMF\"], :conflict-minerals-catalog [\"USA Dodd-Frank Act §1502, 15 U.S.C. §78m note, SEC Rule 13p-1 -- binding statute\" \"EU Regulation (EU) 2017/821 -- binding statute\" \"all other jurisdictions fall back to OECD Due Diligence Guidance for Responsible Supply Chains of Minerals from Conflict-Affected and High-Risk Areas, 3rd ed. 2016 -- non-statutory operational baseline that both binding statutes themselves reference\"], :citations-verified \"core statutes/framework independently re-verified via WebSearch at ADR-authoring time; BAFA's specific role as Germany's EU 2017/821 competent authority remains UNVERIFIED (not asserted as fact, flagged explicitly), exact US Code customs pin-cite and UK post-Brexit customs cross-references also flagged lower-confidence\", :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as siblings\"}, :test-results {:unit-tests \"41 tests / 208 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end: clean tin order through intake->provenance-verify->dispatch->settle, all 6 HARD holds, and the gold-vs-copper NO-OP control pair\"}, :registration-note \"industry main advanced past this branch's base with a concurrent heavy-industry promotion (ISIC 2824) before merge, causing a textual conflict on the maturity-count test line (both bumped 119->120 independently). Resolved via re-branch from fresh kotoba-lang/main + cherry-pick (not local rebase/force), count corrected to 121 = 120 (2824) + 1 (4662).\", :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. Only kotoba-lang/industry pin advanced in manifest/west.yml (--entry industry, minimal diff)\"}"
