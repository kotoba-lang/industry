  :adr/decision-summary "{:pattern \"sealed MachToolTradeAdvisor + independent :precision-machinery-export-governor + append-only audit ledger, PRINCIPAL trading model with a precision-manufacturing-CAPABILITY export-control regulatory backbone -- distinct in kind from isic-4651's information-security/encryption export-control focus\", :new-actor \"cloud-itonami-isic-4659\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-4659\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"4659\", :isic-name \"Wholesale of other machinery and equipment\", :registry-promotion \"kotoba-lang/industry registry.edn id 4659: :maturity :spec (dead gftdcojp/cloud-itonami-G4659 placeholder URL) -> :implemented (real repo)\", :namespace \"machtooltrade\", :two-axis-design {:rationale \"FLEET FIRST genuinely PARALLEL two-axis check -- structurally unrelated to isic-4651's sequential same-kind-of-fact split and isic-4653's independent-but-same-kind-of-fact pair (both properties of the same machine)\", :axis-1 {:check :capability-threshold-uncertified, :mechanism \"a genuine pure physical range-check function (machtooltrade.registry/capability-threshold-crossed?) that independently RECOMPUTES whether simultaneous-axes/positioning-accuracy cross an ECCN-2B001-style threshold, never trusting an advisor claim -- the first such physical range-check function in the fleet's PRINCIPAL-TRADING cluster, mirroring the crude-extraction sibling's reservoir/annular/water-cut/H2S check pattern\"}, :axis-2 {:check :military-end-use-unresolved, :mechanism \"reads ONLY end-use/end-user facts, zero overlap with axis-1's fact set, modeling the EAR Military End User Rule (15 C.F.R. §744.21) catch-all that applies even to a BELOW-threshold machine sold to a flagged military end-user\"}, :proof-of-independence \"a below-threshold machine (identical spec to the clean scenario) sold to a flagged military end-user holds on military-end-use-unresolved ALONE (capability-threshold-uncertified explicitly asserted NOT to fire); an above-threshold machine to an ordinary end-user holds on capability-threshold-uncertified ALONE; a fixture proving both fire together; a fixture proving clean dispatch once both axes are resolved\"}, :governor-checks [{:check :spec-basis :severity :hard} {:check :evidence-incomplete :severity :hard} {:check :credit-uncleared :severity :hard} {:check :contract-missing :severity :hard} {:check :capability-threshold-uncertified :severity :hard} {:check :military-end-use-unresolved :severity :hard} {:check :counterparty-sanctions-flag-unresolved :severity :hard} {:check :already-dispatched :severity :hard} {:check :already-invoiced :severity :hard} {:check :high-stakes-actuation-gate :severity :soft-escalate}], :robotics {:value false, :rationale \"heavy precision machine tools are irregular in mass distribution and require bespoke, load-specific rigging plans, unlike metal-wholesale's uniform bulk stock (coils/plates) suited to automated crane/grapple systems -- reasoned specifically, not copied from the most recent sibling\"}, :r0-scope {:high-confidence [\"USA EAR/BIS CCL Category 2 'Materials Processing', ECCN 2B001 (numerically controlled machine tools) -- structure independently re-verified via WebSearch\" \"15 C.F.R. §744.21 Military End User Rule -- verified accurate\" \"Wassenaar Arrangement (established 1996, successor to COCOM, ~42 participating states) -- lineage and existence verified\"], :low-confidence [\"precise numeric axis-count/positioning-accuracy thresholds used in capability-threshold-crossed? -- explicitly documented by the implementing agent as an illustrative simplified composite, NOT a verified reproduction of ECCN 2B001's real per-machine-type structure\" \"Japan's 輸出貿易管理令別表第一 exact item number for machine tools -- deliberately not cited\"], :citations-verified \"regulatory-category existence and structure independently re-verified via WebSearch at ADR-authoring time and confirmed accurate; the confidence-gradient discipline (category existence vs. numeric thresholds) is explicitly preserved and reported, not collapsed into false precision\", :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as siblings\"}, :test-results {:unit-tests \"43 tests / 233 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end: clean lifecycle, capability-threshold-uncertified alone, military-end-use-unresolved alone, both-together, both-resolved-clean, plus other HARD holds and double-actuation guards\"}, :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. Only kotoba-lang/industry pin advanced in manifest/west.yml (nbb scripts/gen-west-manifest.cljs --entry industry, minimal diff)\"}"
