  :adr/decision-summary "{:pattern \"sealed TechTradeAdvisor + independent :tech-export-governor + append-only audit ledger, PRINCIPAL trading model with a technical dual-use/encryption export-control CLASSIFICATION backbone, deliberately more granular than isic-4690 shosha's coarse jurisdiction-citation export check\", :new-actor \"cloud-itonami-isic-4651\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-4651\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"4651\", :isic-name \"Wholesale of computers, computer peripheral equipment and software\", :registry-promotion \"kotoba-lang/industry registry.edn id 4651: :maturity :spec (dead gftdcojp/cloud-itonami-G4651 placeholder URL) -> :implemented (real repo)\", :namespace \"techtrade\", :high-stakes-actuation {:members [:delivery/dispatch :technology/release :invoice/settle], :note \"FLEET FIRST three-member high-stakes set (every prior sibling had two); :technology/release models the deemed-export doctrine (15 C.F.R. §734.13) -- release of controlled technology/source code to a foreign national is legally an export to that person's home country even with zero physical cross-border movement, resolved via :effective-destination = recipient's nationality for such orders\"}, :classification-split {:rationale \"generalizes/refines isic-4690's single export-license-uncleared boolean into two STRUCTURALLY distinct failure modes\", :checks [{:check :eccn-classification-missing, :meaning \"item never classified against a control list at all\"} {:check :license-required-unauthorized, :meaning \"classified, license required for destination/end-user, none authorized\"}], :encryption-handling \"EAR Category 5 Part 2 encryption items (ECCN 5A002/5D002 non-mass-market, 5A992/5D992 mass-market, License Exception ENC §740.17) deliberately FOLDED into this same two-check mechanic rather than given a third dedicated check -- reasoned as still being a classify-then-license-determine sequence\"}, :denied-party-check {:check :denied-party-list-flag-unresolved, :distinction \"BIS Entity List (15 CFR Part 744 Supplement No. 4) / Denied Persons List (15 CFR Part 764) is a DIFFERENT mechanism from generic OFAC sanctions screening -- proven by a fixture that passes OFAC while failing denied-party screening\"}, :governor-checks [{:check :no-spec-basis :severity :hard} {:check :evidence-incomplete :severity :hard} {:check :credit-uncleared :severity :hard} {:check :contract-missing :severity :hard} {:check :eccn-classification-missing :severity :hard} {:check :license-required-unauthorized :severity :hard} {:check :counterparty-sanctions-flag-unresolved :severity :hard} {:check :denied-party-list-flag-unresolved :severity :hard} {:check :already-dispatched :severity :hard} {:check :already-released :severity :hard} {:check :already-invoiced :severity :hard} {:check :high-stakes-actuation-gate :severity :soft-escalate}], :robotics {:value true, :path-specific true, :note \"FLEET FIRST path-specific robotics reasoning within one actor: applies ONLY to :delivery/dispatch (AS/RS goods-to-person robotic shuttle, ESD-safe electronics handling); :technology/release has no physical act at all and is unautomated by construction\"}, :r0-scope {:source-catalog [\"USA EAR/BIS: CCL Category 4 + Category 5 Part 2, ECCN 5A002/5D002 (non-mass-market encryption) + 5A992/5D992 (mass-market encryption), License Exception ENC (15 C.F.R. §740.17), Entity List (15 CFR Part 744 Supplement No. 4), Denied Persons List (15 CFR Part 764), deemed-export rule (15 C.F.R. §734.13)\" \"JPN: METI 安全保障貿易審査課, 該非判定/キャッチオール規制 (大量破壊兵器+通常兵器), 輸出貿易管理令別表第一\" \"EU (DEU representative): Regulation (EU) 2021/821 Annex I Category 4/5 Part 2 + Article 5 cyber-surveillance catch-all, BAFA\" \"GBR: Export Control Order 2008, ECJU\"], :citations-verified \"all citations independently re-verified via WebSearch at ADR-authoring time, including the exact ECCN numbers (5A002/5D002, 5A992/5D992), License Exception ENC section 740.17, deemed-export 15 CFR 734.13, and EU 2021/821 Article 5 cyber-surveillance catch-all -- all confirmed precisely accurate\", :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as siblings\"}, :test-results {:unit-tests \"46 tests / 265 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end: clean hardware dispatch+invoice lifecycle, clean deemed-export software release+invoice lifecycle, and 9 distinct HARD-hold scenarios each firing an exactly-distinct rule (proving the classification-vs-license split and denied-party-vs-OFAC distinction are real, not collapsed)\"}, :contrast-with-isic-4690 \"isic-4690's export-license-uncleared is one coarse jurisdiction-citation-style boolean, appropriate for a business that never specializes in one item category; this build is classification-driven (real ECCN/CCL mechanics) and splits that single check into two sequential, separately-auditable determinations, plus adds the denied-party check and the three-op actuation shape 4690 doesn't need\", :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. Only kotoba-lang/industry pin advanced in manifest/west.yml (nbb scripts/gen-west-manifest.cljs --entry industry, minimal diff)\"}"
