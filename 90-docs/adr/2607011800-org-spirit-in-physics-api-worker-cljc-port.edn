[{:adr/related ["90-docs/adr/2606290000-all-workers-cljc-only-policy.md"], :adr/status "proposed", :adr/id "adr-2607011800-org-spirit-in-physics-api-worker-cljc-port", :adr/repo "orgs/com-junkawasaki/org-spirit-in-physics", :adr/decision "{:definition \"apps/api-worker（Hono BFF, D1+R2のみ, DO/KV無し）を shadow-cljs :esm fetch worker（ADR-2606290000 Pattern B, 参照実装: app-aozora）へ移植する。apps/web・apps/researcher の Svelte UI 移植は別フェーズ。\", :design_decisions {:d1_access \"生SQL文字列 + ^js interop (.prepare/.bind/.all/.first/.run) を手書き。汎用クエリビルダは作らない（Kysely相当の前例が組織に無く、クエリ数~15-20で過剰設計）\", :webauthn \"@simplewebauthn/server を shadow-cljs npm interop でラップ。COSE/CBOR/attestation検証をCLJSで再実装しない（ADR-2606290000 exemption条項に合致）\", :session_cookie \"js/crypto.subtle interop で直接.cljcへ移植（Web Crypto はWorkersランタイム標準提供）\", :langgraph \"廃止しプレーンな .cljc 関数合成(-> パイプライン)に置換。graph_runs/graph_checkpoints/graph_node_eventsへの書き込みは既存と同形を維持（TS側も元々LangGraphのcheckpointerは未使用で手動書き込みのため挙動不変）\", :deps_edn \"作らない。app-aozora Pattern B前例（npm+shadow-cljsのみ）に揃える。langgraph-clj StateGraph actorではなくステートレスedge workerのためActors規約は非該当\", :migrations \"既存SQLをそのまま流用し無変更。既存database_id/R2 bucket名を再利用しゼロデータ移行\", :deploy \"新workerは別名・別ルートでparity検証。本番cutoverは別途確認の上で実施\"}, :product \"org-spirit-in-physics\", :rationale [\"api-worker は D1+R2のみで DO/KV 無し、zod/OpenAPI等のスキーマも無くPattern Bに直接当てはまる\" \"既存 TS worker のLangGraph利用は線形チェーン+手書きD1監査ログのみでLLM呼び出し無し\" \"Pattern Bの com-junkawasaki 初適用として、D1 interop・WebAuthn interop wrap・LangGraph代替パイプラインの前例を残す\"], :core_ns [:spirit.worker :spirit.router :spirit.db :spirit.schema :spirit.stimulus-words :spirit.auth.session :spirit.auth.webauthn :spirit.routes.health :spirit.routes.participants :spirit.routes.sessions :spirit.routes.storage :spirit.routes.timeline :spirit.routes.assessments], :scope_boundary \"apps/api-worker のみ。apps/web・apps/researcher・pkg/* は out-of-scope。\", :placement :com-junkawasaki, :subject :api-worker-cljc-port, :implementation {:language \".cljc\", :builds {:worker \"shadow-cljs :esm → out/worker.js\", :worker-test \"shadow-cljs :node-test\"}, :runtime \"Cloudflare Workers (workerd), D1 + R2 bindings\", :env [\"DB\" \"ARTIFACTS\" \"SESSION_SECRET\" \"API_MODE\"]}, :migration {:scope \"orgs/com-junkawasaki/org-spirit-in-physics/apps/api-worker（単一 worker）\", :order \"single-repo, single-worker, parity-then-cutover。big-bang なし\", :exemption \"@simplewebauthn/server は TS-only SDK として interop wrap（default方針通りTSをprimaryに残さない）\", :reference_impl \"app-aozora appview（40-engine/cljs/appview/、shadow-cljs :esm fetch worker, 手書きrouter, ^js interop）\"}, :pattern :b_esm_fetch}", :adr/date "2026-07-01", :db/id -1, :adr/out_of_scope ["apps/web・apps/researcher（~13,000行Svelte UI）の移植" "本番デプロイ・DNSルート切替（spirit-in-physics.com/api/* 等）" "manifest/west.yml・repos.edn への新規登録やpin変更" "既存apps/api-worker（TS版）の削除"], :adr/authoritative false, :adr/title "org-spirit-in-physics apps/api-worker を CLJC (:esm fetch worker) へ移植", :adr/verification_2026_07_01 "{:phase 0, :scaffold \"apps/api-worker-cljc/ に shadow-cljs.edn + package.json + wrangler.jsonc + migrations流用\", :pending \"scaffold → data layer → auth → routes → router結線 → test → build+smoke → parity検証 → PR\"}", :adr/guardrails "{:d1_continuity \"既存 database_id (f52a6c82-1f2a-444b-9ee6-a241b61bcbe5) / R2 bucket (spirit-in-physics-artifacts) を再利用。新規 d1 create 禁止。data migration ゼロ\", :secrets \"SESSION_SECRET は wrangler secret 経由のみ。EDN/コードに平文コミット禁止\", :git \"shallow既定・FF-only main・force-push禁止・オーナーWIP破棄禁止。org-spirit-in-physicsはwest管理パスのためworktreeで作業\", :cutover \"live worker切り替えは保守窓+parity+即rollback（旧TS workerはgit温存）。本ADRのスコープ外、別途確認\"}"}]