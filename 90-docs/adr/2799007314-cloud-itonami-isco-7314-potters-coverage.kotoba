  (:adr/related (vector "2799007211-cloud-itonami-isco-7211-metal-moulders-coremakers-coverage" "2799007224-cloud-itonami-isco-7224-metal-polishers-wheel-grinders-tool-sharpeners-coverage" "2799009311-cloud-itonami-isco-9311-mining-quarrying-labourers-coverage"))
