  (:adr/id 2799007314)
  (:phase/rollout "{0 {:label \"read-only\", :writes #{}, :auto #{}}, 1 {:label \"assisted-logging\", :writes #{:log-work-record}, :auto #{}}, 2 {:label \"assisted-coordination\", :writes #{:schedule-crew-operation :coordinate-supply-order :log-work-record}, :auto #{}}, 3 {:label \"supervised-auto\", :writes #{:flag-safety-concern :schedule-crew-operation :coordinate-supply-order :log-work-record}, :auto #{:schedule-crew-operation :coordinate-supply-order :log-work-record}}}")
