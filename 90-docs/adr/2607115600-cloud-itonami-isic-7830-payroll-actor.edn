  :adr/decision-summary "{:pattern \"sealed PayrollProcessor-LLM + independent PayrollGovernor + append-only audit ledger, computes and submits payroll for a client who remains the legal employer -- never an employment decision or benefits-eligibility determination, distinct from isic-7810 (placement agency) and isic-7820 (employer-of-record dispatch)\", :new-actor \"cloud-itonami-isic-7830\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-7830\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"7830\", :isic-name \"Other human resources provision\", :narrowed-to \"payroll processing and administration-as-a-service, same narrowing move as isic-6311/isic-4610/isic-8299\", :namespace \"payroll\", :registry-promotion \"kotoba-lang/industry registry.edn id 7830: :maturity :spec (dead gftdcojp/cloud-itonami-N7830 placeholder) -> :implemented\", :governor-checks [{:check :rbac :severity :hard} {:check :tax-withholding-calculation-gate :severity :hard :note \"new -- no analog in other cloud-itonami actors; a proposed withholding amount deviating more than 20pct from the R0 flat-rate demo estimate is rejected regardless of confidence\"} {:check :filing-deadline-gate :severity :hard :note \"new -- a filing submission for a form not in the R0 filing-catalog, or submitted after its due date, is rejected -- a late filing cannot be silently marked as on-time\"} {:check :source-provenance-gate :severity :hard} {:check :licensed-disclosure :severity :hard} {:check :confidence-floor :severity :soft-escalate} {:check :disputed-employee-status-gate :severity :soft-escalate :note \"a payroll run targeting an employee with :status :disputed always escalates to a human\"} {:check :dispute-request :severity :soft-escalate-unconditional}], :r0-scope {:withholding-catalog [\"IRS Publication 15-T (federal, tax year 2026)\" \"California DE 44\" \"New York IT-2104\"], :filing-catalog [\"Form 941 (federal quarterly)\" \"Form W-2 (federal annual)\"], :caveat \"demo-flat-rate-estimate is an explicit tolerance-check approximation only, never a production withholding calculation basis\"}, :robotics {:value false, :key-present false, :rationale \"payroll computation and filing submission are document/system processing only, no physical actuation\"}, :test-results {:unit-tests \"33 tests / 115 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end, all 8 scenarios fire correctly\"}, :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. kotoba-lang/industry pin advanced in manifest/west.yml (--entry industry, minimal diff)\"}"
  :adr/authoritative true
