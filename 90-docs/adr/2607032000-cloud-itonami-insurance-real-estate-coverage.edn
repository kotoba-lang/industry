 :addendum-1
 {:date "2026-07-07"
  :deepened-to-implemented "cloud-itonami-isic-6512"
  :pattern-6512 "sealed Underwriter-LLM advisor + independent Non-Life Insurance Governor + append-only audit ledger, modeled closely on the sibling cloud-itonami-isic-6511 (life insurance)"
  :new-lifecycle-6512 "claim filing (:claim/file, HARD-gated on the referenced policy actually being bound) and claim settlement (:claim/settle, a second actuation event independently checked against the policy's own coverage limit and double-settlement-protected) -- a lifecycle 6511 never modeled"
  :actuation-invariant-6512 ":policy/bind and :claim/settle are never members of any casualty.phase phase's :auto set, and casualty.governor's high-stakes check (two members) always escalates them to human sign-off"
  :fleet-maturity-before {:implemented 7 :blueprint 90 :spec 546 :total 643}
  :fleet-maturity-after {:implemented 8 :blueprint 89 :spec 546 :total 643}
  :test-status-6512 "34 tests / 172 assertions, lint clean, demo verified end-to-end"}

 :addendum-2
 {:date "2026-07-07"
  :deepened-to-implemented "cloud-itonami-isic-6621"
  :pattern-6621 "sealed Adjuster-LLM advisor + independent Loss Adjustment Governor + append-only audit ledger, modeled closely on siblings cloud-itonami-isic-6511/6512"
  :distinctive-check-6621 "conflict-of-interest screening on the ASSIGNED ADJUSTER (not a sanctions blocklist check on a party) -- independence from underwriting/claims-payment authority is the entire premise of this business; same code shape as 6511/6512's KYC check, different and equally load-bearing semantics"
  :lesson-applied-from-6512 "6512's own ADR recorded a real bug (an overly-broad op-guard silently defeating its sanctions-violations check, caught via demo verification); 6621's conflict-violations was written from scratch with that lesson already in hand (hit-in-proposal? evaluated unconditionally) -- demo and tests passed on the first run with no equivalent bug"
  :actuation-invariant-6621 ":valuation/finalize is the ONE real actuation event (unlike 6512's two), never a member of any adjustment.phase phase's :auto set, and adjustment.governor's single-member high-stakes check always escalates it to human sign-off"
  :fleet-maturity-before {:implemented 8 :blueprint 89 :spec 546 :total 643}
  :fleet-maturity-after {:implemented 9 :blueprint 88 :spec 546 :total 643}
  :test-status-6621 "24 tests / 106 assertions, lint clean, demo verified end-to-end"}

 :addendum-3
 {:date "2026-07-07"
  :deepened-to-implemented "cloud-itonami-isic-6622"
  :pattern-6622 "sealed Broker-LLM advisor + independent Insurance Intermediation Governor + append-only audit ledger, modeled closely on siblings cloud-itonami-isic-6511/6512/6621"
  :distinctive-check-6622 "insufficient-quotes (best-interest/shopping-duty check verifying at least two insurers' quotes were compared before binding) -- has no analog in 6511/6512/6621, whose document/evidence-completeness checks verify paperwork, not genuine option comparison"
  :dual-actuation-6622 "TWO actuation events (:placement/bind, :commission/book), matching 6512's dual-actuation shape rather than 6511's/6621's single-actuation one"
  :lesson-reused-from-6621 "conflict-of-interest screening reused 6621's already-corrected shape (hit-in-proposal? unconditional) a SECOND time, reinforcing it as a load-bearing convention for this actor family"
  :new-bug-caught-6622 "placement-not-bound-violations initially checked :status :bound directly, which broke on double-booking once status legitimately advances to :commission-booked after a successful booking (a status-lifecycle assumption, a DIFFERENT kind of bug from 6512's op-scoping one); fixed by checking :placement-number instead (set once, never cleared); caught via the same demo/ledger verification discipline 6512's/6621's ADRs established"
  :fleet-maturity-before {:implemented 9 :blueprint 88 :spec 546 :total 643}
  :fleet-maturity-after {:implemented 10 :blueprint 87 :spec 546 :total 643}
  :test-status-6622 "33 tests / 169 assertions, lint clean, demo verified end-to-end"
  :remaining-blueprint-from-original-batch ["cloud-itonami-6520 (reinsurance)" "cloud-itonami-6530 (pension funding)" "cloud-itonami-6629 (other insurance auxiliary)" "cloud-itonami-6820 (real estate on a fee/contract basis)"]}

 :addendum-4
 {:date "2026-07-07"
  :deepened-to-implemented "cloud-itonami-isic-6629"
  :pattern-6629 "sealed Claims-LLM advisor + independent Insurance Auxiliary Governor + append-only audit ledger, modeled closely on siblings cloud-itonami-isic-6511/6512/6621/6622"
  :distinctive-check-6629 "apportionment-mismatch -- independently recomputes a general-average apportionment (pro-rata by value-at-risk) and compares it against the case's claimed figures, reusing the CROSS-REPO cloud-itonami-isic-6499/6430 'never trust a claimed number' pattern WITHIN one repo; a pure arithmetic-verification check, unlike 6511's/6512's sanctions or 6621's/6622's conflict-of-interest party-screening checks"
  :single-op-dual-activity-6629 "ONE actuation op (:recommendation/finalize) serves TWO bundled activities (outsourced claims administration, marine general-average adjustment), dispatching its HARD checks by the case's own :case-type rather than duplicating StateGraph wiring per activity"
  :no-party-concept-6629 "this actor deliberately has NO party/conflict-of-interest Store concept at all -- its core failure mode is arithmetic, not identity-based, so adding an unused KYC-shaped collection just to match sibling shape would be premature abstraction"
  :first-run-clean-6629 "unlike 6512's and 6622's own ADRs (each recording a real bug caught during demo verification), 6629's apportionment-mismatch check passed the demo and full test suite on the FIRST run -- new territory rather than a ported pattern with a known failure mode already lurking in it"
  :fleet-maturity-before {:implemented 10 :blueprint 87 :spec 546 :total 643}
  :fleet-maturity-after {:implemented 11 :blueprint 86 :spec 546 :total 643}
  :test-status-6629 "30 tests / 125 assertions, lint clean, demo verified end-to-end"
  :remaining-blueprint-from-original-batch ["cloud-itonami-6520 (reinsurance)" "cloud-itonami-6530 (pension funding)" "cloud-itonami-6820 (real estate on a fee/contract basis)"]}

 :addendum-5
 {:date "2026-07-07"
  :deepened-to-implemented "cloud-itonami-isic-6520"
  :pattern-6520 "sealed Treaty-LLM advisor + independent Reinsurance Governor + append-only audit ledger, modeled closely on siblings cloud-itonami-isic-6511/6512/6621/6622/6629; treaty/recovery lifecycle mirrors 6512's policy/claim shape (recovery/file auto-eligible once bound, recovery/pay always human-gated)"
  :distinctive-check-6520 "recovery-calculation-mismatch -- independently recomputes a claims-recovery amount via the treaty's own quota-share (percentage-of-loss, capped) or excess-of-loss (retention/layer) formula and compares it against the claimed figure, reusing cloud-itonami-isic-6629's arithmetic-verification pattern on a NEW domain-specific formula"
  :no-party-concept-6520 "like 6629, this actor deliberately has NO party/conflict-of-interest Store concept at all -- a ceding insurer is a named contractual counterparty, not a screened individual"
  :status-lifecycle-reasoning-6520 "treaty-not-bound-violations safely checks :status :bound directly (like casualty.governor/policy-not-bound-violations) because a treaty's status never advances past :bound, unlike 6622's placement -- this reasoning is written into the check's own docstring rather than defensively copying 6622's fix where it isn't needed"
  :dual-actuation-6520 "two actuation events (:actuation/bind, :actuation/pay-recovery), matching 6512's/6622's dual-actuation shape, not 6511's/6621's/6629's single-actuation one"
  :fleet-maturity-before {:implemented 11 :blueprint 86 :spec 546 :total 643}
  :fleet-maturity-after {:implemented 12 :blueprint 85 :spec 546 :total 643}
  :test-status-6520 "36 tests / 171 assertions, lint clean, demo verified end-to-end (two clean lifecycles + five HARD-hold cases, all correct on the first run)"
  :remaining-blueprint-from-original-batch ["cloud-itonami-6530 (pension funding)" "cloud-itonami-6820 (real estate on a fee/contract basis)"]}}
