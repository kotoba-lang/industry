   (:mutation-tests "2 discriminating mutations run against a broken copy; each produced exactly the intended failure and no other")
   (:integration
   (map (:cacao (map (:commit "71014021b99d34b9e90cba5d4b5ff3a261bc3f2a")
            (:tests "63 tests / 237 assertions; the 61 pre-existing pass unchanged")
            (:mutation "covers? reverted to the substring test -> 3 assertions in the 2 new tests failed, nothing else")))
    (:security (map (:commit "74235d1cdf8034334f01dcb2f6faaff0c731146e")
               (:tests "219 tests / 1091 assertions (baseline 216 / 1076)")
               (:mutation ":personal removed from ranks -> 8 assertions in the 3 new tests failed, nothing else")))
    (:control-plane (map (:commits (vector "f33db76b499c99c0c9343897cbd5800320a7f8e3"
                              "334b8bc3a5c6d11d09db4161936cc874a904e10f"
                              "01e6c5acdcc918315afc84a9d2abb628aecedbca"
                              "e3d130f4ff53f4ffdd7128fe011c060639281cf5"))
                    (:tests "cljs (shadow-cljs compile all-tests + node): 440 tests / 2128 assertions, 0 failures. JVM (clojure -M:test): 110 tests / 675 assertions, 4 failures")
                    (:known-failures "provider-source-catalog-contract x2 and worker-artifact-contract x2 are PRE-EXISTING: they need build artifacts a fresh checkout has not produced, and fail identically on a baseline run of the same worktree with these files removed. Verified, not assumed.")
