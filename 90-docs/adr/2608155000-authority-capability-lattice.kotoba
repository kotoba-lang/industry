  (:adr/title "ADR-2608155000: kotoba-lang/authority — capability-semantics.edn が規定する capability 束を実装し、8 種の URI 文字列比較を 1 つの半順序に畳む")
  (:adr/status "accepted")
  (:adr/date "2026-08-15")
  (:adr/last_verified "2026-08-15")
