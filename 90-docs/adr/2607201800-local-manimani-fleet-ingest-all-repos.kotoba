(vector (map (:db/id -1),
  (:adr/id "adr-2607201800-local-manimani-fleet-ingest-all-repos"),
  (:adr/title "ADR-2607201800: local-manimani が com-junkawasaki 配下の全 orgs/repo を取り込む設計（3層 registry / observation / agent-loop の分離）"),
  (:adr/status "accepted"),
  (:adr/doc_type "adr"),
  (:adr/topic "local-manimani-fleet-ingest"),
  (:adr/date "2026-07-20"),
  (:adr/last_verified "2026-07-20"),
  (:adr/source-format "edn"),
  (:adr/authoritative true),
  (:adr/deciders (vector "Jun Kawasaki")),
  (:adr/authoritative_for
  (vector "local-manimani(orgs/gftdcojp/local-manimani-cdci) の repo fleet ingest スコープ"
   "manifest/repos.edn 全件を local-manimani の registry/observation 対象にする方法"
   "fleet_ingest_cli.clj の repo 選択元を repo-loops.edn から分離する設計"
   "/api/repos のページング欠如の是正方針"
   "config/repo-loops.edn(Tier2 agent loop) を全件自動投入しないというガードレール"
   "west.yml groups(:datalad/:archived) 除外基準の Tier1 への適用")),
  (:adr/related
  (vector "orgs/gftdcojp/local-manimani-cdci/docs/adr/0041-west-fleet-github-kotobase-agent-control-plane.md"
   "orgs/gftdcojp/local-manimani-cdci/src/manimani/west_registry.clj"
   "orgs/gftdcojp/local-manimani-cdci/src/manimani/fleet_ingest_cli.clj"
   "orgs/gftdcojp/local-manimani-cdci/src/manimani/repo_loop_scheduler.clj"
   "orgs/gftdcojp/local-manimani-cdci/src/manimani/repo_loop.clj"
   "orgs/gftdcojp/local-manimani-cdci/config/repo-loops.edn"
   "orgs/gftdcojp/local-manimani-cdci/config/repo-agent-loop.edn"
   "orgs/gftdcojp/local-manimani-cdci/data/providers.edn"
   "orgs/gftdcojp/local-manimani-cdci/data/cdci-policy.edn"
