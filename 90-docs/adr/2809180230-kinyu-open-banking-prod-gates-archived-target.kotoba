(vector (map (:db/id -1)
  (:adr/id "adr-2809180230-kinyu-open-banking-prod-gates-archived-target")
  (:adr/title "kinyu: open-banking prod-readiness gate register seeded with 2026-09-18 measurements; propose target cloud-itonami/open-banking found ARCHIVED (read-only), so the register lands here for re-homing")
  (:adr/status :proposed)
