(vector (map (:adr/authoritative_for (vector "new repo kotoba-lang/youtube-upload (public) holds four pure async\n    functions extracted from ai-gftd-project-yukkuri's upload_youtube.py:\n    refresh_access_token, upload_video, upload_caption, set_thumbnail —\n    no D1/yukkuri dependency, raw httpx, no googleapiclient" "every non-2xx response raises YouTubeUploadError(stage, status_code,\n    detail); callers decide fatal vs non-fatal per call" "credential resolution (per-channel token isolation), video-byte\n    fetching, and result persistence stay in the caller (yukkuri) — this\n    library only talks to Google's endpoints" "deliberate exception to the kotoba-lang .cljc convention: implemented\n    in Python because it runs inside yukkuri's Python LangGraph k8s pod;\n    a Clojure port would force an RPC/subprocess bridge for a stateless\n    HTTP client, which is disproportionate ceremony" "registered via manifest/repos.edn :extra-projects → nbb\n    scripts/gen-west-manifest.cljs --entry workflow")), (:adr/supersedes (vector)), (:adr/superseded_by (vector)), (:adr/topic "kotoba-lang-youtube-upload-extraction"), (:adr/related (vector "adr-yukkuri-multi-destination-publisher")), (:adr/status "accepted"), (:adr/id "adr-2607031500-kotoba-lang-youtube-upload-extraction"), (:adr/doc_type "adr"), (:adr/last_verified "2026-07-03"), (:adr/body "see 2607031500-kotoba-lang-youtube-upload-extraction.edn"), (:adr/deciders (vector "Jun Kawasaki")), (:adr/date "2026-07-03"), (:db/id -1), (:adr/authoritative true), (:adr/title "ADR-2607031500: kotoba-lang/youtube-upload — extract yukkuri's YouTube client into a shared lib"), (:adr/source-format "edn")))