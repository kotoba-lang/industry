  :adr/decision-summary "{:pattern \"sealed WasteTradeAdvisor + independent :waste-trading-governor + append-only audit ledger, PRINCIPAL trading model -- FIRST fleet actor with an environmental (not trade-sanctions/biosecurity/food-safety/human-rights) regulatory backbone\", :new-actor \"cloud-itonami-isic-4669\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-4669\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"4669\", :isic-name \"Wholesale of waste and scrap and other products n.e.c.\", :registry-promotion \"kotoba-lang/industry registry.edn id 4669: :maturity :spec (dead gftdcojp/cloud-itonami-G4669 placeholder URL) -> :implemented (real repo)\", :namespace \"wastetrade\", :pic-check {:check :prior-informed-consent-missing, :trigger \"fires only when :waste-stream-type is classified hazardous (Basel Convention PIC)\", :requires-both [:transboundary-notification-filed? :destination-country-consent-documented?], :bilateral-note \"genuinely BILATERAL government-to-government consent pair, unlike any prior sibling's unilateral certificate/license\", :jurisdiction-scope :unconditional, :rationale-vs-isic-4641 \"deliberately jurisdiction-UNCONDITIONAL like isic-4662, NOT jurisdiction-gated like isic-4641 -- reasoned specifically because the USA is a Basel non-Party yet has its own parallel RCRA destination-consent regime, so blanket-exempting non-Party jurisdictions (as a naive copy of 4641's binding-statute gate would do) would be wrong\", :proof-of-type-gating \"same undocumented-evidence state: hazardous waste (used lead-acid batteries, wo-6) -> HARD hold; non-hazardous/green-list waste (sorted ferrous scrap, wo-7) -> dispatches cleanly\"}, :governor-checks [{:check :no-spec-basis :severity :hard} {:check :evidence-incomplete :severity :hard} {:check :credit-uncleared :severity :hard} {:check :contract-missing :severity :hard} {:check :prior-informed-consent-missing :severity :hard} {:check :counterparty-sanctions-flag-unresolved :severity :hard} {:check :already-dispatched :severity :hard} {:check :already-invoiced :severity :hard} {:check :high-stakes-actuation-gate :severity :soft-escalate}], :robotics {:value true, :rationale \"robotic sorting arms, magnetic/eddy-current separators, automated baling at the wholesaler's own yard dispatch point, explicitly scoped away from downstream recycling/shredding/disposal processing (a separate ISIC activity)\"}, :r0-scope {:binding-government-law [\"Basel Convention (adopted 1989, entered into force 1992, ~190 Parties, Article 6 PIC procedure) -- USA explicitly noted as a non-Party, an honest fact reflected rather than glossed over\" \"USA: RCRA 42 U.S.C. §6901 et seq., 40 CFR Part 262 Subpart H (Transboundary Movements of Hazardous Waste)\" \"JPN: バーゼル法 (特定有害廃棄物等の輸出入等の規制に関する法律)\" \"GBR: Transfrontier Shipment of Waste Regulations 2007 (SI 2007/1711)\" \"EU: Regulation (EU) 2024/1157 (entered into force 2024-05-20, main rules applicable from 2026-05-21, the recast replacing Regulation (EC) 1013/2006)\"], :voluntary-private-certification-informational-only [\"R2v3 (SERI)\" \"e-Stewards (BAN)\" \"-- surfaced only as an informational note on e-waste orders, never gating a HARD check, explicitly NOT presented as binding law\"], :citations-verified \"all citations independently re-verified via WebSearch at ADR-authoring time, all confirmed accurate including USA's Basel non-Party status and the exact EU 2024/1157 entry-into-force/applicability dates\", :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as siblings\"}, :test-results {:unit-tests \"46 tests / 228 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end: hazardous-with-PIC clean lifecycle, hazardous-without-PIC hold, hazardous-partial-PIC hold, non-hazardous/green-list no-op control, other HARD holds, double-actuation guards\"}, :tooling-note \"this registration cycle is the first to use nbb script