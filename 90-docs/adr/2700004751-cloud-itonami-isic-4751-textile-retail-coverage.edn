[{:adr/id 2700004751
  :adr/title "cloud-itonami-isic-4751 — Textile-Retail Operations Coordination"
  :adr/status :accepted
  :adr/date "2026-07-16"
  :adr/scope [:kotoba-lang/industry :cloud-itonami/cloud-itonami-isic-4751]
  :adr/references [2607121000 2680004719]

  ;; Wave 2 actor (coordination/logistics/trade): fabric/notions
  ;; specialized-store retail operations coordination-only (sales/
  ;; inventory/cut-yardage transaction logging, staffing-operation
  ;; scheduling, textile supply-order coordination, quality-concern
  ;; flagging). Distinct from ISIC 4771-family apparel retail (finished
  ;; garments, not yardage).

  :actor/id :cloud-itonami-isic-4751
  :actor/name "Textile-Retail Operations Coordinator"
  :actor/isic-rev5 "4751"
  :actor/domain :retail/textiles-specialized-stores
  :actor/wave 2
  :actor/coordination? true
  :actor/robotics? true

  :actor/proposal-ops [:log-sales-record :schedule-staffing-operation
                       :coordinate-supply-order :flag-quality-concern]
  :actor/always-escalate-ops [:flag-quality-concern]
  :actor/cost-threshold-escalate-ops {:coordinate-supply-order 800}

  :actor/hard-checks [:store-verified :vendor-verified :effect-propose :scope-exclusion]
  :actor/scope-excluded-terms ["issue the refund" "authorize the refund" "approve the refund"
                                "issue a replacement" "authorize the replacement" "approve the replacement"
                                "void the sale" "finalize the quality dispute" "resolve the quality dispute"
                                "issue a chargeback to" "charge back the vendor"
                                "revoke the vendor's registration" "terminate the vendor contract"
                                "deny the quality claim" "accept liability for"
                                "返金を実行" "返金を承認した" "交換を承認した" "交換を実行した"
                                "品質紛争を確定" "品質紛争を解決した" "仕入先へのチャージバックを実行"
                                "仕入先の登録を取り消した" "仕入先契約を解除した" "販売を無効化した"]

  ;; Self-trip-avoidance: every term above is phrased as the
  ;; finalization/execution ACTION, never a bare noun -- this namespace's
  ;; own :flag-quality-concern default proposal legitimately discusses
  ;; defective-bolt/mislabeling/dye-lot-mismatch concerns, and its own
  ;; printed :op keyword literally contains the substring
  ;; "quality-concern"; the sales-record proposal's own disclaimer clause
  ;; even contains the bare noun "品質紛争" (quality dispute). A
  ;; bare-noun term list would self-trip this actor's own core happy path
  ;; on every single run. Regression test:
  ;; governor-test/default-mock-advisor-proposals-never-self-trip-scope-exclusion.

  :phase/rollout
  {0 {:label "read-only" :writes #{} :auto #{}}
   1 {:label "assisted-logging" :writes #{:log-sales-record} :auto #{}}
   2 {:label "assisted-coordination" :writes #{:log-sales-record :schedule-staffing-operation
                                               :coordinate-supply-order}
      :auto #{}}
   3 {:label "supervised-auto" :writes #{:log-sales-record :schedule-staffing-operation
                                         :coordinate-supply-order :flag-quality-concern}
      :auto #{:log-sales-record :schedule-staffing-operation :coordinate-supply-order}}}

  :operation/entry-point :intake
  :operation/nodes [:intake :advise :govern :decide :request-approval :commit :hold]

  :test/counts {:total 56 :assertions 166 :failures 0 :errors 0}
  :test/coverage [:governor-hard-checks :advisor-shapes :phase-rollout :integration
                  :store-contract :scope-exclusion-self-trip-regression
                  :vendor-verification]
  :test/simulator :textileops.sim

  :registry/maturity :implemented
  :registry/repo "https://github.com/cloud-itonami/cloud-itonami-isic-4751"
  :registry/business-id "cloud-itonami-isic-4751"
  :registry/required-technologies [:robotics :identity :forms :dmn :bpmn :audit-ledger :retail]
  :registry/operating-states [:intake :stock :sell :reconcile :reorder :audit]

  :db/id -1}]
