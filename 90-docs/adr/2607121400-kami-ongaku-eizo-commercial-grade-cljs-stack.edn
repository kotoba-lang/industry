ang/audio\" \"kotoba-lang/kami-ongaku-sampler\"], :l3-authoring [\"kotoba-lang/kami-ongaku-project\" \"kotoba-lang/kami-ongaku-sequencer\" \"kotoba-lang/kami-ongaku-notation\" \"kotoba-lang/kami-ongaku-plugin-host\"], :l4-hosts [\"wasm-webcomponent(AudioWorklet)\" \"kotoba-wasm(offline PCM)\"], :l5-apps [\"kami-app-daw(future)\"]}", :adr/eizo-layer-map "{:l0-contracts [\"kotoba-lang/kami-mangaka-*\"], :l1-raw-api [\"kotoba-lang/org-w3-webcodecs\"], :l2-codec-executor [\"kotoba-lang/utsushi\"], :l3-authoring [\"kotoba-lang/kami-eizo-timeline\" \"kotoba-lang/kami-eizo-grade\" \"kotoba-lang/kami-eizo-compositor\" \"kotoba-lang/douga\" \"kotoba-lang/anime\"], :l4-hosts [\"wasm-webcomponent(WebCodecs/WebGPU)\" \"kotoba-wasm(offline transcode)\"], :l5-apps [\"kami-app-nle(future)\"]}", :adr/commercial-parity-checklist "[{:domain :notation, :reference [\"Sibelius\" \"Dorico\" \"MuseScore\"], :target \"pitch/duration/dynamics/articulation IR + MusicXML import/export\"} {:domain :sequencing, :reference [\"Logic Pro\" \"Cubase\" \"FL Studio\"], :target \"piano-roll IR, quantize/groove, pattern/clip\"} {:domain :mixing, :reference [\"Pro Tools\" \"Waves\" \"iZotope Neutron\"], :target \"channel strip, bus, automation, EQ/comp/reverb/delay\"} {:domain :plugin-host, :reference [\"VST3\" \"Audio Unit\"], :target \"node-graph plugin contract, latency compensation\"} {:domain :sampling, :reference [\"Kontakt\"], :target \"velocity layer, round-robin, key-map, streaming\"} {:domain :nle-timeline, :reference [\"Premiere Pro\" \"DaVinci Resolve\" \"Avid Media Composer\"], :target \"track/clip/transition/effect-stack/marker EDL\"} {:domain :grading, :reference [\"DaVinci Resolve Color page\"], :target \"primary wheels/curves/LUT(.cube), waveform/vectorscope\"} {:domain :compositing, :reference [\"Nuke\" \"After Effects\" \"Fusion\"], :target \"node-based keying/roto/tracking data model\"} {:domain :codec, :reference [\"ffmpeg\"], :target \"H.264 decode complete + encode, AAC/Opus wired