   (:web-build "npx shadow-cljs release app -> 446 KB advanced bundle, 96 files")
   (:browser "backend webgl2, tick 24003, 103 instances, money 39190, served 680, canvas 642 colours / mean 69.4 / dark 0.0%")
   (:shots (vector "60-apps/network-isekai/games/boutique-stack/web/shots/boutique-stack.png"
