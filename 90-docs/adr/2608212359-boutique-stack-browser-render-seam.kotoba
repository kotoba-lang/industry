    (:gap/date "2026-08-21"))))

  (:adr/verification
  (map (:nbb-suite "65 tests / 385 assertions / 0 failures (npx nbb --classpath src:test:../common/src:<webgpu>/src:<render>/src run-tests.cljs)")
