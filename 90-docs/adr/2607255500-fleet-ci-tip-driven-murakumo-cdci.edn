 :adr/decision "{:trigger {:kind :tip-change :interval-seconds 300 :state \"~/.gftd/fleet-ci-state.edn\"}\n :fan-out {:jvm-capable-nodes [\"zebulun\" \"asher\" \"judah\" \"levi\" \"simeon\" \"joseph\" \"benjamin\"]\n           :slots 14 :registry \"scripts/fleet-ci/nodes.edn\" :probe \"scripts/fleet-ci/probe.cljs\"}\n :verdict {:mechanism :output-sentinel :sentinel \"FLEET-CI-EXIT: <code>\"\n           :reason \"Tailscale SSH + /usr/bin/login swallows remote exit status (ssh node false -> 0)\"\n           :assertions [:extract-ok :test-summary-present :nonzero-test-count]}\n :status-write-back {:api :commit-statuses :context-prefix \"fleet-ci/murakumo\"\n                     :why-not-checks-api \"Checks API requires a GitHub App; statuses need only repo scope\"}\n :cd {:pin-advance-on-green true :verifier \"scripts/verify-west-pins.cljs\"\n      :path :branch-put-server-merge :owner-key-used false}\n :signer {:kagi-name \"fleet-agent-murakumo-ci-tip\"\n          :did \"did:key:z6MkhKgm9LbcxSN5uVDBJAhZ3B7s31MHXfS2omgkmCnWu3Ve\"\n          :grant \"fleet-ci/*\" :governance-authority false :per-machine-identity true}\n :kagami-changes [:subject-extra :policy-override :gate-detail-evidence]\n :not-done [:webhook-trigger :required-status-check\n            :github-actions-replacement :nekko-red-fix :fleet-disk-capacity\n            :legacy-6h-runner-location]\n :runner-staleness-observed \"2026-07-29: main に landed した tick.cljs の修正 (1f604ad4318) が、その後の receipt (b57d52b, 06:43Z) にまだ反映されていない — 修正済みのはずの gate 交差が本番で継続している。receipt を landing している host は fleet-ci <fleet-ci@murakumo> 名義で約 7 分ごとに動いているが、12 tribes 全ノードと gad を探しても LaunchAgent も ~/.gftd/fleet-ci-tick.log も無い。:legacy-6h-runner-location は「所在が分からない」だけの問題ではなく、**landed した修正が効かない**という実害を持つことが確認された\"\n :done-since [{:item :pr-head-verification :at \"2026-07-29\" :pr 1414\n               :how \"open PR は refs/pull/N/merge で判別する (open かつ mergeable な PR にだけ存在し close で消える)。API も token も使わず git+SSH のまま。head ref だけでは判別不能 — root は head 1,411 本に対し open 0 だった\"\n               :verified \"PR #1414 を実際に開いて往復確認: merge ref 出現 -> tick が PR head db03b1a を tip と別 work として発見 -> head 移動 (ea7c6de) に追随 -> judah 実機で gate 実行 23 repositories OK / FLEET-CI-EXIT: 0 -> merge 後に merge ref が消滅\"\n               :limits [\"conflict 状態の open PR は merge ref を持たないので見えない\"\n                        \"PR gate が赤でも merge を機械的にブロックはしない (:required-status-check は API 必須で未達のまま)\"\n                        \"repo あたり既定 10 件まで。超過分は番号を log に出す\"]}]}"
