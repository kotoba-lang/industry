[{:adr/authoritative_for ["kotoba-lang org 内の 2 独立 UI ファミリー（宣言的デザインシステム kotoba-ui/appkit/uikit/liquid-glass-ui、と kami-engine/browser 系）の名前分離" "ui->kami-engine-hud, ui-gpu->kami-engine-hud-gpu, wasm-ui->dom-gpu, kami-ui-sdk->kami-engine-app-sdk の改名決定と実行記録" "内部namespace/npmスクリプト名/shellのCLI語彙(--substrate wasm-ui)は今回の改名対象に含めないという scope 境界"], :adr/supersedes [], :adr/deliberately-unchanged ["内部 Clojure namespace: kotoba.ui, kami-ui-sdk.*, kotoba.wasm.*" "dom-gpu内部のnpm script名/ビルド成果物名: wasm-ui/wasm-webgpu script, kotoba-wasm-ui.html" "shellのCLI値 --substrate wasm-ui (内部keyword :wasm-ui, デフォルト [:wasm-ui :browser]) — stable-api-specはcommand存在のみ凍結対象でoption値は対象外だが、既存自動化の互換性を優先し変更対象外とした"], :adr/superseded_by [], :adr/topic "kotoba-lang-ui-design-system", :adr/related ["adr-2607022800-kotoba-lang-default-uiux-appkit-uikit-interface-fundamentals" "adr-2607011900-kotoba-lang-liquid-glass-ui" "adr-2607010930-clj-wgsl-migration"], :adr/status "accepted", :adr/id "adr-2607051200-kotoba-lang-ui-family-rename", :adr/rejected-alternatives ["内部namespace/npmスクリプト/CLI語彙まで一括改名: scope超過・blast radius拡大のため却下" ":path-overridesのみ追加し:extra-projectsの旧名を残す: repos.edn可読性のため、既存rename事例(aiueos/kootba→svgraph/clc→office-style/edn→office)と同様に:extra-projectsは新名に更新し旧名は:path-overridesのみに残す形を採用" "wholesale nbb scripts/gen-west-manifest.cljs(--entryなし)でwest.yml全体再生成: 実際に試すとghosthacker-flow/etzhayyim root/cloud-murakumo/manimani等、無関係な多数repoのpinまで前進させてしまうと判明。CLAUDE.mdが禁じるwholesale再生成事故の再発になるため却下し--entryの最小diffに限定"], :adr/rename-table "[{:old \"orgs/kotoba-lang/ui\", :new \"orgs/kotoba-lang/kami-engine-hud\", :package \"kotoba.ui\", :reason \"kami-engine の裸機能名規約から kami-engine-* ファミリーへ。HUD実体を正確に表す\", :live-deps-edn-dependents []} {:old \"orgs/kotoba-lang/ui-gpu\", :new \"orgs/kotoba-lang/kami-engine-hud-gpu\", :reason \"kami-engine-hud とペア。既存 sprite-gpu と同じ -gpu サフィックス規約\", :live-deps-edn-dependents []} {:old \"orgs/kotoba-lang/wasm-ui\", :new \"orgs/kotoba-lang/dom-gpu\", :reason \"kotoba:dom retained-tree を GPU に描く実体を正確に表す。browser/README.md の『いずれ ui に改名』という恒久ブロック済みアスピレーションを解消\", :live-deps-edn-dependents [\"orgs/kotoba-lang/cssom\" \"orgs/kotoba-lang/htmldom\" \"orgs/kotoba-lang/browser\"], :also-updated [\"orgs/kotoba-lang/shell (:repo path + :ui-substrate label + test)\"]} {:old \"orgs/kotoba-lang/kami-ui-sdk\", :new \"orgs/kotoba-lang/kami-engine-app-sdk\", :reason \"6 SDKはUI+アニメーション+パーティクルFX+音声合成+WebRTCでUI単体でない。kami-app-*/kami-engine-* 両ファミリーに整合\", :live-deps-edn-dependents [\"orgs/kotoba-lang/kami-app-character-creator\"]}]", :adr/doc_type "adr", :adr/last_verified "2026-07-04", :adr/deciders ["Jun Kawasaki"], :adr/incidental-findings-not-fixed "[{:finding \"shellのui-substrate-specsの:browser blockが期待するファイル名(src/browser/visual_smoke_check.cljc)とnpm script名(compile:smoke等)がbrowser repoの実際の現状(visual_smoke_model.cljc、別script名)と乖離\", :impact \"clojure -M:test で8件のpre-existing failure(本改名と無関係)\", :status :not-fixed} {:finding \"cssom/src/cssom/layout.cljc docstring, cssom/README.md, window-session-state/README.md, freeboard/README.md に残るkami-ui-gpu/wasm-ui言及\", :impact \"historical provenance記述として当時の事実を正しく記録しているため、kami-text→glyph改名の前例に倣い意図的に未変更\", :status :left-as-historical-record}]", :adr/date "2026-07-04", :db/id -1, :adr/execution-steps "[{:step 1, :action \"gh repo rename で4 repoを改名。GitHubは旧名からredirect保持\"} {:step 2, :action \"ローカル orgs/kotoba-lang/<name> ディレクトリを新名へ移動、remote URLを張り替え\"} {:step 3, :action \"依存repoのdeps.edn (:local/root + io.github.kotoba-lang/<name> coordinate) を更新\"} {:step 4, :action \"shellのkotoba.shell.launcher (ui-substrate-specsの:repo path、surface-host-specsの:ui-substrateラベル、対応テスト) を更新。:wasm-ui keyword/--substrate CLI値は非変更\"} {:step 5, :action \"各repoのREADME更新。browser/README.mdのNaming節(旧'uiへ改名予定'アスピレーション)を解消記述に更新\"} {:step 6, :action \"manifest/repos.edn: :path-overrides に旧→新4entry追加 + :extra-projectsの該当4行を新名に更新\"} {:step 7, :action \"nbb scripts/gen-west-manifest.cljs --entry <4 names> で最小diff生成(サーバ側pin検証OK)。旧4entryはspliceで自動削除されないため手動削除\"} {:step 8, :action \"dom-gpu(旧wasm-ui)へのpush中に無関係PR#4が並行mergeされpushがreject。ローカルrebase/force-pushはせず一時branch経由でgh api .../merges によるサーバ側マージで解消。west.ymlのdom-gpu pinもマージ後tipに再取得(--no-verify-remoteは無関係2repoの既存pin退行を回避するためのみ使用、対象pinはGitHub compare APIで個別検証)\"}]", :adr/authoritative true, :adr/title "kotoba-lang の \"*ui*\" 系リポジトリ名衝突を解消する — ui/ui-gpu/wasm-ui/kami-ui-sdk を改名"}]