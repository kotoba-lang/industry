(vector (map (:db/id -1)
  (:adr/doc_type "adr")
  (:adr/id "adr-2609101745-cleanup-session-what-the-tools-got-wrong-20260910")
  (:adr/topic "cleanup-tooling-defects-measured")
  (:adr/title "A cleanup pass over 4,506 checkouts, and the four tool defects it had to measure around")
  (:adr/status "accepted")
  (:adr/date "2026-09-10")
  (:adr/deciders (vector "Jun Kawasaki" "Claude Opus 5"))
  (:adr/repos (vector "com-junkawasaki/root" "kotoba-lang/aiueos" "kotoba-lang/kotobase" "network-awai/loop-consumability"))
  (:adr/related (vector "adr-2608136000-eight-questions-before-you-trust-a-green"
