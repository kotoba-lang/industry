(vector (map (:db/id -1)
  (:adr/id "adr-2607184000-kami-media-content-hash-relink-missing-report")
  (:adr/title "KAMI media applications add content-hash relinking and missing-media reports")
  (:adr/date "2026-07-18")
  (:adr/status "accepted")
  (:adr/authoritative true)
  (:adr/topic "kotoba-lang-media-authoring")
  (:adr/supersedes (vector "adr-2607183900-kami-media-asset-manifest-relink"))
  (:adr/decision
  (map (:shared (map (:digest :sha-256)
            (:match-order (vector :asset/sha256 :asset/name))
            (:missing-report :stable-asset-ids)
            (:renamed-files-supported true)
            (:runtime-media-external true)))
   (:daw (map (:hash-input :audio-file) (:relink-result :decoded-audio-buffer)))
   (:nle (map (:hash-input :video-file) (:hash-registration :sequential) (:relink-result :object-url)))
   (:maturity (map (:kami-app-daw :逍遥) (:kami-app-nle :逍遥)))
   (:remaining-commercial-gates (map (:shared (vector "search paths" "portable packaged media" "duplicate-content policy"))
                                (:daw (vector "recorded-take durable media" "loop and comp recording" "plugin hosting" "LUFS/true-peak"))
                                (:nle (vector "pointer trim gestures" "proxy/cache" "color management" "additional containers"))))))
  (:adr/implementation
  (map (:daw-commits (vector "8404e35"))
   (:nle-commits (vector "cb1a45b"))
   (:evidence (vector "DAW passes 9 tests and 28 assertions; NLE passes 9 tests and 29 assertions, including hash-over-name matching and exact missing-ID reports."
              "Both guarded shadow-cljs production releases completed with zero compiler warnings."
              "Fixture and renamed-copy SHA-256 digests matched exactly for both WAV and WebM sources."
              "DAW Chrome reported two missing IDs after reload, relinked renamed files in B/A order by hash, restored two waveforms, and cleared the report without console errors."
              "NLE Chrome reported two missing IDs after reload, relinked renamed videos in B/A order to asset:0=A and asset:1=B, enabled decode, and cleared the report without console errors."
              "Both GitHub Pages workflows completed tests, release compilation and deployment successfully."))))
  (:adr/consequences
  (vector "Renaming media files no longer breaks relinking when their bytes are unchanged."
   "Users can see exactly which stable IDs remain unresolved instead of discovering missing media only during playback or export."
   "SHA-256 hashing reads complete browser files; very large-media background hashing and packaged projects remain future work."))
  (:adr/source-format "edn")))
