  :adr/decision-summary
  "{:model-ns \"yosoku.models/etzhayyim-substrate-rollout\",
    :stocks {:CouncilSeats {:meaning \"Council seats ratified (governance legitimacy)\", :init 1, :max 5}
             :TreasuryCapacity {:meaning \"junbi reserve pipeline maturity\", :init 70}
             :IdentityCoverage {:meaning \"did:web/did:plc/SBT issuance coverage\", :init 2}
             :AgentCapacity {:meaning \"real (non-mock) LLM-agent administrative throughput\", :init 5}
             :SocialCoverage {:meaning \"real (non-synthetic) mimamori/hagukumi/BHI delivery\", :init 1}
             :RoboticsUnits {:meaning \"deployed kuni-umi/watatsumi fleet (normalized)\", :init 0}
             :PublicTrust {:meaning \"reinforcing-loop stock feeding CouncilOnboardRate\", :init 5}},
    :gates {:LegalActivationGate {:meaning \"junbi CBDC/fiat activation - ops/legal act, not code\", :init 0.05}
            :RealLLMWiringGate {:meaning \"mock-advisor -> real Murakumo inference\", :init 0.1}
            :G7ConsentGate {:meaning \"mimamori self-documented live-legs-G7-gated\", :init 0.05}
            :DispatchGate {:meaning \"kuni-umi self-documented S0 no-robots-dispatched\", :init 0.0}},
    :protected-vars [\"ComplianceFloor\" \"RegulatoryCap\"],
    :edge \"u -> v = v's stock growth requires u's stock level as a MIN(1, u/threshold) operating input\",
    :reverse-toposort-waves
    {0 {:name \"governance-treasury-root\", :stocks [\"CouncilSeats\" \"TreasuryCapacity\"]}
     1 {:name \"identity\", :stocks [\"IdentityCoverage\"], :requires-gate \"LegalActivationGate\"}
     2 {:name \"ai-admin-substrate\", :stocks [\"AgentCapacity\"], :requires-gate \"RealLLMWiringGate\"}
     3 {:name \"social-security-delivery\", :stocks [\"SocialCoverage\"], :requires-gate \"G7ConsentGate\"}
     4 {:name \"robotics-physical-delivery\", :stocks [\"RoboticsUnits\"], :requires-gate \"DispatchGate\",
        :note \"order intentionally inverted vs cloud-itonami ADR-2607121000 (robotics before human-services there) -- kuni-umi's own design requires proven SocialCoverage trust before dispatch\"}},
    :baseline-t60-2026-07-13
    {:CouncilSeats 4.40 :TreasuryCapacity 91.07 :IdentityCoverage 16.59 :AgentCapacity 10.45
     :SocialCoverage 1.56 :RoboticsUnits 0.00 :PublicTrust 2.76},
    :single-gate-leverage-t60
    [{:gate \"G7ConsentGate\" :disposition :commit :leverage 9.06}
     {:gate \"DispatchGate\" :disposition :commit :leverage 8.01}
     {:gate \"LegalActivationGate\" :disposition :commit :leverage 3.85}
     {:gate \"RealLLMWiringGate\" :disposition :commit :leverage 1.30}],
    :all-gates-open-t60
    {:CouncilSeats 4.65 :TreasuryCapacity 91.07 :IdentityCoverage 86.67 :AgentCapacity 89.38
     :SocialCoverage 86.50 :RoboticsUnits 78.29 :PublicTrust 102.34},
    :over-additivity-finding
    \"combined delta 163.23 vs sum-of-individual-leverages 22.22 (~7.3x) -- the 4 gates are strong complements, not substitutes; single-gate leverage score alone is not a valid priority ranking, sequencing per the reverse-toposort wave order matters more than picking the single highest-leverage gate\",
    :governance-adversarial-test
    {:attack \"scenario/propose patch zeroing ComplianceFloor\" :disposition :hold :result \"hard-rejected, unconditionally, matching charter's own non-sovereignty-claim self-limit\"},
    :bug-found-and-fixed
    {:location \"yosoku.governor/parameter-bound-violations\"
     :symptom \"(int ##Inf) throws IllegalArgumentException when a patched variable's old value is exactly 0\"
     :reachable-via \"DispatchGate 0.0 -> 0.9 patch, i.e. the exact operation this model's Wave-4 gate-open requires\"
     :fix \"pct-str helper renders infinite relative-change as the string literal for infinity instead of coercing to int\"
     :regression-tests [\"governor_test.clj: zero-old-value-parameter-bound-does-not-crash\"
                        \"models_test.clj: opening-a-gate-escalates-and-commits\"]},
    :verification {:yosoku-tests \"44 tests / 1910 assertions green\" :lint \"clj-kondo 0 errors/warnings\"
                   :xmile-validate \"0 errors / 0 warnings on etzhayyim-substrate-rollout\"
                   :execution-path \"real operation/build + langgraph.graph/run* (full ScenarioActor graph, not raw xmile.execute alone)\"},
    :execution-phases
    {:p0 \"fill remaining 4 Council seats; junbi external reporting cadence (ops process, not code)\"
     :p1 \"Council resolution opening LegalActivationGate (junbi CBDC/fiat real activation); begin real IdentityCoverage issuance\"
     :p2 \"open RealLLMWiringGate (mock-advisor -> real Murakumo inference) across fleet/tashikame/kouhou actors\"
     :p3 \"open G7ConsentGate (mimamori/hagukumi go-live consent process); synthetic-seed -> real care recipients\"
     :p4 \"open DispatchGate after kuni-umi N>=2 witness-attestation proof; requires wave-3 SocialCoverage trust accrued\"},
    :constraints [\"parameters are order-of-magnitude estimates, not calibrated from real data -- recalibrate per-wave at execution time (same caveat as cloud-itonami ADR-2607121000's TAM figures)\"
                  \"single-gate leverage score is not a valid standalone priority ranking -- see over-additivity-finding\"
                  \"model covers 7 of the mission charter's parallel-substrate rows only (land/education/order enforcement out of scope, follow-up)\"
                  \"starting at wave 3/4 before wave 0 traverses every dependency edge backwards; rejected unless this ADR is superseded\"]}"}]
