                      :sync "project kyber results into itonami activity/effect/audit after each operation"}
  :core_ns [:itonami.activity :itonami.decision :itonami.effect :itonami.audit]
  :implementation {:language ".cljc"
                   :local_store "cloud-itonami.store over langchain.db"
                   :production_store "langchain.kotoba-db / kotoba-server XRPC"
                   :agent "langgraph-clj/langchain-clj"
                   :runtime "cloud-itonami.runtime"
                   :approval_runner "cloud-itonami.approval"
                   :ui_origin "manimani approval inbox"}
  :closure {:status :closed
            :closed_on "2026-06-27"
            :canonical_api ["cloud-itonami.plm"
                            "cloud-itonami.ops"
                            "cloud-itonami.mes"
                            "cloud-itonami.migration"]
            :compat_shims ["cloud-itonami.kyber-ops"]
            :decision "kyber-plm is no longer the public operating surface; it remains an internal/compatibility invariant engine under cloud-itonami."}}
 :business_coverage
 {:m365
  {:messages :inbox
   :events :inbox
   :teams-messages :inbox
   :crm :sales
   :projects :sales
   :mail-projects :sales
   :ses-engineers :sales
   :ses-cases :sales
   :contract-terms :contract
   :invoice-terms :billing
   :procedure-terms :procedure
   :hr-terms :employee
   :people [:employee :sales]
   :decisions :inbox}
  :kyber
  {:store_projector "cloud-itonami.migration/project-kyber-graph"
   :lanes [:plm :erp :mes]
   :facade "cloud-itonami.ops"
   :plm_api "cloud-itonami.plm"
   :mes_projector "cloud-itonami.mes/kyber-completion->tx"}
  :operating_model "cloud-itonami.operating/lane-catalog"
  :store {:local "cloud-itonami.store"
          :import "actor/artifact -> activity -> relation/decision/effect/audit"
          :many_refs "expanded to :db/add"
          :lookup_refs "tempid optimized within batch"
          :production_swap "langchain.kotoba-db"}
  :approval {:queue "cloud-itonami.approval/pending-approvals"
             :states [:proposed :approved :rejected :executed :failed]
             :execution "cloud-itonami.approval/execute-approved!"
             :fail_closed true}
  :runtime {:namespace "cloud-itonami.runtime"
            :checkpoint_store "same conn as itonami facts"
            :cli "clojure -M:runtime mock-react <store.edn> [goal] [thread-id]"}
