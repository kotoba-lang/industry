 :decision
 {:product "cloud-itonami"
  :placement :gftdcojp
  :subject :enterprise
  :definition "manimani の business 版。gftdcojp の business activity を kotoba/datom log 上の activity/decision/effect/audit に統合する。"
  :lanes [:inbox :sales :contract :billing :legal :procedure :employee :plm :erp :mes :keiei]
  :kyber_integration {:facade "cloud-itonami.ops"
                      :plm_api "cloud-itonami.plm"
                      :role "kyber-plm is the PLM/ERP/MES invariant engine called from cloud-itonami"
                      :sync "project kyber results into itonami activity/effect/audit after each operation"}
  :core_ns [:itonami.activity :itonami.decision :itonami.effect :itonami.audit]
  :implementation {:language ".cljc"
                   :local_store "cloud-itonami.store over langchain.db"
                   :production_store "langchain.kotoba-db / kotoba-server XRPC"
                   :kotoba_cli "cloud-itonami.kotoba"
                   :company_cli "cloud-itonami.company"
                   :agent "langgraph-clj/langchain-clj"
                   :runtime "cloud-itonami.runtime"
                   :runtime_model {:factory "cloud-itonami.runtime/real-model"
                                   :providers [:openai :openclaw :hermes :anthropic]
                                   :env ["ITO_MODEL_PROVIDER" "ITO_MODEL_URL" "ITO_MODEL" "ITO_MODEL_API_KEY"]}
                   :approval_runner "cloud-itonami.approval"
                   :ui_origin "manimani approval inbox"}
  :closure {:status :closed
            :closed_on "2026-06-27"
            :canonical_api ["cloud-itonami.plm"
                            "cloud-itonami.ops"
                            "cloud-itonami.mes"
                            "cloud-itonami.migration"
                            "cloud-itonami.company"]
            :compat_shims ["cloud-itonami.kyber-ops"]
            :decision "kyber-plm is no longer the public operating surface; it remains an internal/compatibility invariant engine under cloud-itonami."}}
