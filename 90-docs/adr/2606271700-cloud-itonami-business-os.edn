  {:store_projector "cloud-itonami.migration/project-kyber-graph"
   :lanes [:plm :erp :mes]
   :facade "cloud-itonami.ops"
   :plm_api "cloud-itonami.plm"
   :mes_projector "cloud-itonami.mes/kyber-completion->tx"}
  :operating_model "cloud-itonami.operating/lane-catalog"
  :store {:local "cloud-itonami.store"
          :kotoba "cloud-itonami.kotoba"
          :import "actor/artifact -> activity -> relation/decision/effect/audit"
          :many_refs "expanded to :db/add"
          :lookup_refs "tempid optimized within batch"
          :production_swap "langchain.kotoba-db"
          :env ["KOTOBA_URL" "KOTOBA_GRAPH" "KOTOBA_TOKEN" "KOTOBA_CACAO" "KOTOBA_DID"]}
  :approval {:queue "cloud-itonami.approval/pending-approvals"
             :cli "clojure -M:approval list|approve|reject|execute|execute-dry-run <store.edn>"
             :states [:proposed :approved :rejected :executed :failed]
             :execution "cloud-itonami.approval/execute-approved!"
             :fail_closed true}
  :runtime {:namespace "cloud-itonami.runtime"
            :checkpoint_store "same conn as itonami facts"
            :cli "clojure -M:runtime mock-react <store.edn> [goal] [thread-id]"}
  :company_operating_set
