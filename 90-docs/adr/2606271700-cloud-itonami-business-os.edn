                   :ui_origin "manimani approval inbox"}
  :closure {:status :closed
            :closed_on "2026-06-27"
            :canonical_api ["cloud-itonami.plm"
                            "cloud-itonami.ops"
                            "cloud-itonami.mes"
                            "cloud-itonami.migration"
                            "cloud-itonami.company"
                            "cloud-itonami.doctor"]
            :compat_shims ["cloud-itonami.kyber-ops"]
