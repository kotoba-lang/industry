[{:adr/authoritative_for ["ADR-2607022600 未記載だった 2026-07-01 削除の孤児: kotoba-vault\n    (6987行, 暗号化blob+鍵カストディ) / kotoba-server補助面\n    (email_xrpc/mcp/social_economy/attestation/access_receipt, 約22K行) /\n    kotoba-datomic::distributed (9738行) / kotoba-word (1746行) /\n    kotoba-lattice (3979行) を Wave 6-10 として ADR-2607022600 のロードマップに\n    追加。kotoba-evm は etzhayyim専用境界の意図的除外と判断、\n    kotoba-llm/kotoba-ingest/kotoba-custodyは既存ADRの対象外判定を維持" "EN/ENGI(相互信用通貨)は本ADRに一覧のみ、詳細設計は\n    ADR-2607101100(kotobase-native v1)/ADR-2607101200(DHT基盤復活v2)" "いずれのWaveも需要が具体化するまで着手しない(先回りして作らない方針を\n    ADR-2607022600から継承)"], :adr/supersedes [], :adr/superseded_by [], :adr/topic "kotoba-orphaned-crates-roadmap", :adr/related ["90-docs/adr/2607022600-kotoba-database-crates-cljc-migration-roadmap.md" "90-docs/adr/2607101100-engi-mutual-credit-kotobase-native-design.md" "90-docs/adr/2607101200-engi-mutual-credit-dht-substrate-revival.md" "90-docs/adr/2606271600-kotoba-stack-equivalences.md"], :adr/status "proposed", :adr/id "adr-2607101000-kotoba-orphaned-rust-crates-migration-roadmap-addendum", :adr/doc_type "adr", :adr/last_verified "2026-07-10", :adr/decision "{:new-waves [{:wave 6, :name \"kotoba-vault\", :priority \"中\"} {:wave 7, :name \"kotoba-word\", :priority \"低\"} {:wave 8, :name \"kotoba-lattice\", :priority \"低・保留(murakumo統合を優先検討)\"} {:wave 9, :name \"kotoba-server補助面(個別評価)\", :priority \"低・保留\"} {:wave 10, :name \"kotoba-datomic::distributed\", :priority \"低・保留(Wave5と統合再評価)\"}], :confirmed-out-of-scope [\"kotoba-evm(etzhayyim専用境界、意図的除外)\" \"kotoba-llm/kotoba-ingest/kotoba-custody(既存ADR-2607022600の判定を維持)\" \"kotoba-didcomm/kotoba-media(低価値ニッチ、後継無し)\"]}", :db/id -1, :adr/problem "{:summary \"ADR-2607022600 はDB本体のみを棚卸しし自ら部分的回答と自認していたため、\\n   同じ2026-07-01削除の他crate群(vault/server補助面/distributed/word/\\n   lattice)が一度も棚卸しされていなかった\"}", :adr/authoritative true, :adr/title "ADR-2607101000: kotoba Rust削除(2026-07-01)の孤児機能 — CLJC移行ロードマップへの追加項目"}]