  (:adr/id "adr-2607209910-kotoba-lang-bmc-scaffold")
  (:adr/title "Scaffold kotoba-lang/bmc: portable .cljc BMC canvas/ledger/gate/io core, rescued from abandoned-worktree WIP")
  (:adr/status "accepted")
  (:adr/date "2026-07-20")
  (:adr/doc_type "adr")
  (:adr/deciders (vector "Jun Kawasaki (+ Claude, standing new-project-scaffold authorization)"))
  (:adr/topic "kotoba-lang-bmc-scaffold")
