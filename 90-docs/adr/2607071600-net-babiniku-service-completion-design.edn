 :problem
 {:source "user direction 2026-07-07: 'babiniku.net の lp なども含めて、サービスとして
           完成系を設計して...' + 'anthropic key はつかわずに murakumo.cloud を使って' +
           '単なる四角いオブジェクトしか表示されていない' -- confirmed 'do it'"
  :gaps ["no live LLM (ANTHROPIC_API_KEY never provisioned; now superseded by murakumo
          direction anyway)"
         "no avatars (placeholder box unless a visitor hand-types ?vrm=)"
         "no character creation (4 hardcoded personas; creator economy has no supply side)"
         "page reads as an engineering dashboard, not a product LP"]
  :research
  {:murakumo "two live endpoints: api.murakumo.cloud/v1/messages (local-murakumo,
              Anthropic-Messages-shaped bridge to self-hosted qwen-agentworld-35b-a3b,
              ADR-2607051431, auth = ANTHROPIC_PROXY_TOKEN worker secret, no-op if unset;
              verified zero ANTHROPIC_API_KEY) vs murakumo.cloud/api/v1/messages
              (cloud-murakumo Sora, generic reverse proxy, upstream unverifiable).
              Precedent caller: local-manimani via langchain.model/anthropic-model"
   :avatars "network-isekai's isekai.stage already runs the needed multi-avatar pattern
             (avatar-cache keyed by URL, ensure-avatar!, per-frame draw of :ready);
             babiniku.web has the single-shot MVP of the same stack -- port is ~40 lines
             + a broadcast-style register-callback"
   :vrm_scarcity "vrm-c/vrm-specification yields exactly 2 practical license-clear
                  avatars (Seed-san, VRM1_Constraint_Twist_Sample -- VRM Public License
                  1.0/pixiv); 4 distinct hardcoded avatars cannot be sourced from it"
   :editor_engine "org-vrmc-vrm already ships decompose/compose/export -- see
                   ADR-2607071610"}}

 :decision
 {:completion_criteria
  [{:id :c1 :capability "live chat"
    :done "visitor sends a message, receives an in-character reply from murakumo's
           self-hosted model, gated by review-turn, in production"}
   {:id :c2 :capability "live avatars"
    :done "each roster character shows/selects its own rendered VRM; no ?vrm= param, no
           placeholder box as the product's default face"}
   {:id :c3 :capability "character creation"
    :done "visitor assembles a character via kisekae, it persists, its avatar+persona
           join their roster and are chattable"}
   {:id :c4 :capability "visitor-shaped LP"
    :done "first screen is product (hero -> gallery -> create -> tiers); containment
           transparency is a labeled trust section, not the dominant voice"}
   {:id :c5 :capability "monetization"
    :done "UNCHANGED -- honest HARD-hold until etzhayyim rail matures (ADR-2607071000);
           tiers shown as 準備中; this ADR's completion does NOT require live payments"}]
  :llm_backend
  {:target "https://api.murakumo.cloud/v1/messages (local-murakumo)"
   :rejected_target "murakumo.cloud/api/v1/messages (Sora proxy) -- upstream operator-
                     configurable and unverifiable; could be real Anthropic, silently
                     violating the user's intent"
   :auth "MURAKUMO_PROXY_TOKEN Cloudflare Pages secret iff the bridge's
          ANTHROPIC_PROXY_TOKEN is set (production state unknown -- open item); if unset,
          auth is a no-op and chat works with zero secrets. Honest-default 503 stays."
   :structured_outputs "UNVERIFIED on the bridge: keep sending output_config.format
                        (harmless if ignored) + explicit JSON instruction in the system
                        prompt + defensive parse + unchanged review-turn gate (malformed
                        emotion/motion-cue already HARD-holds). First live call after
                        retargeting is the verification; if the model can't hold the
                        contract, the fallback is a murakumo-side shaping layer, decided
                        then"
   :supersedes "ADR-2607070800's provider/model choice ONLY -- its boundary design
                (server-side call, persona prompts, schema-mirrors-governor vocabulary,
                honest-default, no self-fine-tune in babiniku) carries forward"}
  :avatars
  {:roster ":vrm-url per character"
   :plumbing "port isekai.stage's avatar-cache/ensure-avatar! into babiniku.web; expose
              select-avatar! via the babiniku.broadcast register-callback indirection;
              draw loop renders selected character's :ready parts"
   :gpu_teardown "explicitly deferred (network-isekai's own precedent) -- low-frequency
                  swaps, acceptable leak, follow-up"
   :content "Seed-san + VRM1_Constraint_Twist_Sample cover 2 slots; other 2 share a
             placeholder until kisekae-produced avatars fill them -- user-created avatars
             are the durable, license-clean supply (creator sets meta at export)"}
  :character_creation
  {:flow "babiniku embeds kisekae: pick base -> swap parts -> recolor -> name/license ->
          save; UI composes canvaskit (viewport) + kami-webgpu (preview via the same
          avatar-cache) + kotoba-lang/editor (walk-the-spec controls) around the kisekae
          domain lib"
   :persistence "kisekae.store contract: MemSpecStore (browser session) first;
                 kotobase-backed store is follow-up wiring; identity via actor-key CACAO
                 self-mint convention when accounts arrive. Spec (small EDN) is the
                 artifact; .vrm is derived -- the kotobase-datomic story"
   :creator_economy "a created character is a creator asset; when the etzhayyim rail
                     matures, ADR-2607062200's 80/20 applies with no new design"}
  :lp_structure "hero (exists) -> character gallery (live avatars; render canvas becomes
                 the gallery stage) -> create-your-character entry -> tiers (準備中,
                 honest) -> 'How containment works' labeled trust section (ledgers moved,
                 framed, NOT deleted)"
  :out_of_scope "monetization capability (HARD-held), NSFW-tier decision, shinshi.club
                 (other agent), giemon embodiment scope, babiniku.net DNS (still blocked
                 on user action)"}

 :consequences
 {:milestones "M4 murakumo chat live (retarget + secret decision + first live
               verification incl. structured-output question) -> M5 avatars -> M6 kisekae
               flow embed -> M7 LP restructure; M4/M5 independent"
  :open_items ["murakumo bridge's ANTHROPIC_PROXY_TOKEN production state"
               "qwen model's JSON-contract fidelity"
               "kotobase-backed SpecStore + account identity"]
  :new_deps "net-babiniku gains kotoba-lang/kisekae, canvaskit, editor (sibling
             :local/root) when M6 lands"
  :adr_amendment "ADR-2607070800 amended in place: provider superseded, boundary retained"
  :addendum_2607080800
  {:context "M6's compose engine (ADR-2607071610, shipped and verified live) closes
             the '2 missing character avatars' open item without any new
             third-party asset"
   :closed
   {:what "jk-luxury/net-babiniku#39: rin and mei get real avatars composed from
           the SAME two already-licensed VRM Consortium sample files aoi/yui
           already use -- rin = VRM1_Constraint_Twist_Sample body + Seed-san
           hair/outfit; mei = Seed-san body/outfit + VRM1_Constraint_Twist_Sample
           hair/face (Twist-Sample has no separate :outfit category to donate)"
    :license_basis "checked directly against both files' embedded VRMC_vrm.meta,
                    not assumed -- both declare modification:
                    allowModificationRedistribution, avatarPermission: everyone,
                    allowRedistribution: true under VRM Public License 1.0"}
   :compliance_gap_also_fixed
   {:what "Seed-san's creditNotation is 'required' (credit VirtualCast, Inc.) but
           nothing in the app credited it anywhere for aoi's existing avatar
           either -- a real, previously-missing gap, not hypothetical"
    :fix "every built-in character now carries :avatar-credit, rendered
         unconditionally and visibly on its card, not tucked in a collapsed
         details block"}
   :design_note ":avatar-spec (built-in characters only) kept SEPARATE from
                 :kisekae/spec (user-created characters) so character-card-view's
                 created? check stays correctly scoped -- rin/mei get real
                 composed avatars without gaining Edit/Export/Delete UI meant only
                 for what a visitor actually created"
   :verification "verified live in production: both avatars render as full,
                  correctly-posed, distinct humanoids; no console errors; full bb
                  test suite (character/governor/monetization/embodiment/persona)
                  passes"}}

 :alternatives
 [{:option "keep direct Anthropic and just provision the key"
   :rejected_because "explicit user direction; key was never provisioned across weeks of
                      asking while murakumo is first-party infrastructure"}
  {:option "target murakumo.cloud Sora proxy (the domain the user's words name)"
   :rejected_because "upstream unverifiable, could be real Anthropic -- silently defeats
                      the directive's intent; api.murakumo.cloud is the verified
                      self-hosted path"}
  {:option "buy/commission 4 avatar files instead of building creation"
   :rejected_because "fixes 4 slots once; leaves the creator-economy supply side unsolved
                      and re-imports the license risk kisekae's meta stamping avoids"}
  {:option "strip the audit ledgers for a clean LP"
   :rejected_because "containment transparency is a standing product decision; re-framed
                      and repositioned instead"}
  {:option "wait for accounts/auth before any character creation"
   :rejected_because "MemSpecStore gives an honest single-session experience now; kotobase
                      persistence is additive wiring behind a tested contract"}]}