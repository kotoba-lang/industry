  :adr/decision-summary "{:pattern \"sealed BuildMatTradeAdvisor + independent :potable-water-safety-governor + append-only audit ledger, PRINCIPAL trading model with a potable-water-safety product-certification regulatory backbone -- new to the fleet\", :new-actor \"cloud-itonami-isic-4663\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-4663\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"4663\", :isic-name \"Wholesale of construction materials, hardware, plumbing and heating equipment\", :registry-promotion \"kotoba-lang/industry registry.edn id 4663: :maturity :spec (dead gftdcojp/cloud-itonami-G4663 placeholder URL) -> :implemented (real repo)\", :namespace \"buildmattrade\", :lead-free-check {:check :lead-free-certification-missing, :gate :potable-water-contact?, :folds [:lead-content-tested? :lead-free-certificate-on-file?], :evaluated-at [:delivery/dispatch], :note \"folds two evidentiary arms of the SAME NSF/372+61 certification into one rule, evaluated dispatch-only since a certification doesn't un-happen the way a discovered recall does (contrast isic-4649's re-checked recall enum)\", :type-gating-proof \"strengthened beyond the usual single control case: TWO independent non-applicable categories proven NO-OP (construction material like lumber AND heating equipment like a gas furnace) -- covering both non-potable categories this ISIC code itself names\"}, :deliberately-excluded-second-check {:topic \"heating-equipment safety certification (ANSI Z21-series/CSA/UL-NRTL)\", :rationale \"unlike SDWA §1417's exact, precisely-citable threshold and effective date, US heating-equipment NRTL listing flows through a patchwork of state/local model-code adoption rather than one federal statute -- not force-added just to match the fleet's two-check pattern\"}, :governor-checks [{:check :no-spec-basis :severity :hard} {:check :evidence-incomplete :severity :hard} {:check :credit-uncleared :severity :hard} {:check :contract-missing :severity :hard} {:check :lead-free-certification-missing :severity :hard} {:check :counterparty-sanctions-flag-unresolved :severity :hard} {:check :already-dispatched :severity :hard} {:check :already-invoiced :severity :hard} {:check :high-stakes-actuation-gate :severity :soft-escalate}], :robotics {:value true, :rationale \"bulk lumber/pipe/rebar racking/stacking/gantry-crane automation, palletized hardware/fixtures/heating equipment suited to AS/RS -- contrast isic-4653's :robotics false (self-propelled/towed machinery with no fixed automatable apparatus)\"}, :r0-scope {:source-catalog [\"USA Reduction of Lead in Drinking Water Act of 2011 (Pub. L. 111-380), amending SDWA §1417 (42 U.S.C. §300g-6): 0.25% weighted-average lead-free definition (0.2% for solder/flux), effective 2014-01-04, superseding the prior 8% ceiling; NSF/ANSI/CAN 372 (lead content) + NSF/ANSI/CAN 61 (health effects) certification -- verified exact match on both thresholds and effective date\" \"JPN 水道法 + 給水装置の構造及び材質の基準に関する省令 -- CORRECTED at registration time: the implementing agent originally cited sole 厚生労働省 (MHLW) authority; independently re-verified via WebSearch that the current leaching-standard authority is jointly 国土交通大臣 (MLIT) + 環境大臣 (Ministry of Environment), most recently amended by a joint MLIT/Environment notice dated 2026-01-28 -- reflecting a 2024 reorganization of Japan's water-supply administrative jurisdiction from MHLW to MLIT/Environment, which the implementing agent's own flagged uncertainty ('possible 2024 reorg') correctly anticipated\"], :citations-verified \"USA citations independently re-verified via WebSearch at ADR-authoring time and confirmed precisely accurate; JPN citation corrected (see above), a second instance (after isic-4630's UK statute correction) of the ADR-authoring verification step catching and fixing an implementation-time citation error before it landed permanently\", :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as siblings\"}, :test-results {:unit-tests \"39 tests / 200 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end: construction-material and heating-equipment both dispatch cleanly with no certification facts on file (dual type-gating proof), certified plumbing fixture dispatches cleanly, uncertified plumbing fixture holds on lead-free-certification-missing, other HARD holds and double-actuation guards fire correctly\"}, :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. Only kotoba-lang/industry pin advanced in manifest/west.yml (nbb scripts/gen-west-manifest.cljs --entry industry, minimal diff)\"}"
