(vector (map (:db/id -1)
  (:adr/id "adr-2607195600-kami-plugin-manifest-styled-captions")
  (:adr/title "KAMI generalizes plugin manifests and title-safe captions")
  (:adr/date "2026-07-19")
  (:adr/status "accepted")
  (:adr/authoritative true)
  (:adr/topic "kotoba-lang-media-authoring")
  (:adr/supersedes (vector "adr-2607195500-kami-audio-worklet-captions"))
  (:adr/decision
  (map (:daw (map (:plugin-authority :project/plugins)
         (:manifest-authority :kami.app-daw.core/plugin-types)
         (:manifest-fields (vector :plugin/name :plugin/processor :plugin/parameters))
         (:parameter-fields (vector :parameter/name :parameter/min :parameter/max :parameter/default :parameter/step))
         (:reference-processors (vector "kami-saturator" "kami-compressor"))
         (:manifest-consumers (vector :project-defaults :validation :editor-ui :audio-worklet-parameters))
         (:render-consumers (vector :realtime-playback :master-wav :normalized-master-wav :track-stems :stem-bundle))))
   (:nle (map (:caption-authority :project/captions)
         (:style-authority :caption/style)
         (:style-fields (vector :caption/position :caption/align :caption/font-scale))
         (:positions (vector :top :bottom))
         (:alignments (vector :left :center :right))
         (:font-scale-range (vector 0.5 2.0))
         (:title-safe-inset 0.05)
         (:multiline-authority :caption/text)
         (:render-consumers (vector :decoded-preview-canvas :production-capture))
         (:sidecar :webvtt)))
   (:maturity (map (:kami-app-daw :逍遥) (:kami-app-nle :逍遥)))
   (:remaining-commercial-gates
   (map (:shared (vector "persistent directory grants" "streaming package I/O above 512 MiB"))
    (:daw (vector "third-party plugin discovery/SDK, signed distribution and processor isolation" "certified broadcast loudness" "surround/Atmos buses"))
    (:nle (vector "rich typography and localization workflow" "TTML/IMSC delivery" "OCIO/ICC/HDR and container tagging" "MOV/MXF/IMF" "hardware encoder control"))))))
  (:adr/implementation
  (map (:daw-commits (vector "792e988029fb8134845022b451434e6c005c0dd2"))
   (:nle-commits (vector "e227c2cd19228f4481b85875e3d463e124f993f2"))
   (:pull-requests (vector "kotoba-lang/kami-app-daw#13" "kotoba-lang/kami-app-nle#13"))
   (:evidence
   (vector "DAW passes 21 tests and 82 assertions; NLE passes 22 tests and 93 assertions."
    "Both guarded shadow-cljs production releases completed with zero compiler warnings."
    "Chrome instantiated kami-compressor once for realtime and once for each of three offline stems; every node held threshold -24 dB, ratio 8 and makeup +3 dB from the project manifest contract."
    "The aligned stem package contained project.edn, stems.edn and three 882044-byte WAV files."
    "Chrome painted First line and Second line independently at x=16 on a 320-pixel canvas, proving 5% left title-safe placement, top position and left alignment."
    "Production captureStream consumed the same Decoded video preview canvas and the WebVTT sidecar retained both lines in a two-second cue."
    "External ffprobe identified the production artifact as 320x180 VP8 plus 48 kHz two-channel Opus."
    "Automated Chrome and both local servers were closed after verification."
    "Both application PRs were reviewed and merged."
    "The prescribed freshness and ledger verifier scripts are absent from this root revision; direct EDN assertions verify accepted status, supersedes and both current authorities."))))
  (:adr/consequences
  (vector "Adding a built-in processor no longer requires duplicating parameter defaults, bounds and labels across core, UI and runtime."
   "Reference compressor parameters affect realtime and offline renders identically."
   "Caption style and multiline layout survive project persistence and production burn-in while old captions without style retain normalized defaults."
   "The manifest is not yet a third-party binary plugin compatibility claim, and WebVTT remains less expressive than broadcast caption packages."))
  (:adr/source-format "edn")))
