[{:adr/id "adr-2607141700-cloud-murakumo-organism-kototama-heartbeat"
  :adr/doc_type "adr"
  :adr/title "ADR-2607141700: murakumo.cloud に kototama 実行の organism heartbeat を追加 — Cloudflare は routing/web のみ"
  :adr/topic "cloud-murakumo-organism-kototama-heartbeat"
  :adr/status "accepted (v1 landed + deployed)"
  :adr/date "2026-07-14"
  :adr/deciders ["Jun Kawasaki"]
  :adr/authoritative true
  :adr/authoritative_for ["kototama の実行実体はどこに置くか: cloud-murakumo の実コンピュート上（Cloudflare Worker の中ではない）— Worker は routing/web のみに限定する境界の正本"
                           "cloud-murakumo リポジトリにおける organism/heartbeat パターンの初出（organism/ + deploy/organism/）"
                           "kototama fleet-run を無人スケジューラから繰り返し呼ぶ際の運用パターン（tenant/guest id 固定によるepoch fence衝突の回避 = 毎beat checkpoint store を wipe）"
                           "共有 west checkout 上で無人 publish ジョブを新設する際の安全規律: commit済み(HEAD)内容のみをdeployし、他セッションのdirty working treeを巻き込まない"]
  :adr/supersedes []
  :adr/superseded_by []
  :adr/amends []
  :adr/related ["adr-2607101200-kotoba-language-kototama-runtime-vocabulary-lock"
                "adr-2607050900-kotoba-lang-naming-audit"
                "adr-2605215000-etzhayyim-inference-murakumo-only-no-runpod"
                "adr-2606161200-organism-runtime-3layer-kotodama-split"
                "adr-2606302205-kotoba-genome-unified-self-evolving-all-actor-organism"]
  :db/id -1
  :adr/addenda []
  :adr/decision-summary
  "{:owner-directive \"murakumo.cloud で kototama で organism が生きている、動くように。kototama は cloudflare じゃなくて cloud-murakumo に実態があるようにして。cloudflare は基本的に routing, また web system のみ\",
    :pre-existing-state {:combo \"organism x kototama x murakumo.cloud は既存ADR/コードのどこにも無かった (greenfield)\",
                          :adjacent-prior-art [\"etzhayyim organism の推論基盤は kotoba-lang/murakumo (fleet/auction CLI) を Murakumo-only で使う -- 別レイヤー、別リポジトリ\"
                                                \"kototama の元 organism.cljc/heartbeat.cljc/cell.cljc は kotoba-lang/kotodama ファミリーへ切り出し済み (ADR-2607050900 が命名混同を未解決と明記); kotodama/kotodama-host はライブラリ専用で -main 無し\"
                                                \"kototama に Cloudflare/edge deploy経路は無い (JVM/Chicory + browser native WASM のみ; Workers は JVM を実行できない)\"]
                          :cloud-murakumo-actual \"gftdcojp/cloud-murakumo は実在の本番Cloudflare Worker (murakumo-cloud, custom domain murakumo.cloud/www.murakumo.cloud, Stripe Checkout あり)。organism/kototama/kotodama 言及ゼロ、完全greenfield\"
                          :worker-routing \"site_worker.cljs は純粋pathname routing (/api/openai, /api/anthropic, /x402/* を fetch proxy、それ以外は env.ASSETS.fetch 静的配信)。dispatch.cljc/worker.cljc (JVM専用) は import しない\"},
    :architecture {:guest \"organism/pulse.kotoba -- 最小.kotoba (算術+再帰のみ、host capability不使用、policy.edn/lock.edn vacuous)。fib(12)=144 を計算し毎beatで実WASM実行を証明。organism状態自体はguestに持たせない (kototama CLIにguestへの外部入力を渡す経路が無いため)\",
                   :compile \"kotoba wasm emit -> pulse.wasm (108 bytes, exports fib/main/vitality)、checked in (kototama自身のtest fixture慣例と同型)\",
                   :execute \"kototama fleet-run (fleet-daemonではない -- fleet-daemonは新規tickでなくexisting leaseのcrash recovery専用と実測確認、何もしない状態ではok=0/fail=0で無動作)\",
                   :checkpoint-isolation \"fleet-run はCLIにrelocate flagが無いtmp/kototama-fleetへ書くため、organism/.fleet-run/に throwaway deps.edn (:local/root でkototama checkout指す) を生成しそこをcwdにして実行 -- 共有kototama checkoutには一切書き込まない\",
                   :fence-workaround \"fleet-run は毎回同一tenant/guest idをハードコードしJVMプロセス毎に異なるfleet/node-idを持つため2回目以降の呼び出しが1回目のディスクleaseに対しepoch fenceで拒否される(fence claim refused at bootstrap) -- organismの真のbeat履歴はorganism/.fleet-run/journal.edn(自前append-only journal)が正なので毎beat前にkototama自身のcheckpoint storeをwipeする\",
                   :publish \"fold-beat.bb がjournal.edn集計しpublic/organism/pulse.json再生成、run-publish.sh が npm run release && wrangler deploy。Cloudflare Workerはコード変更ゼロ、既存env.ASSETS.fetch経路がそのまま静的配信\",
                   :scheduling \"launchd (この Mac 上 -- 既にai.gftd.murakumo daemonがresidentしているfleetノード): organism.heartbeat 60秒毎(fleet-run 1回+journal fold)、organism.publish 300秒毎(release build+wrangler deploy)。etzhayyim organism/kaname と同じ@REPO@ template置換installパターン\"},
    :verification {:local \"kotoba wasm emit -> pulse.wasm -> kototama run: result=144 fuel-used=183 を確認\"
                    :accumulation \"fleet-runを3回連続実行しjournal.edn に3 beat蓄積、pulse.json正しく再生成を確認\"
                    :production \"wrangler deploy実施、https://murakumo.cloud/organism/pulse.json が200+正しいJSONを返すことをcurlで確認(cache-busting header込み)\"
                    :canonical-checkout \"共有checkout(orgs/gftdcojp/cloud-murakumo)着地後、launchd経由のRunAtLoadが実際にbeatを打ちjournalが伸びることを確認\"},
    :incident-and-fix {:what-happened \"実装直後、共有checkoutから初回run-publish.shを走らせた際、npm run prepが別セッションの未コミットWIP(resources/murakumo.eduのairshed-intelligence function追加)を巻き込んで本番へdeployしてしまった\"
                        :detection \"deploy直後にwrangler出力の '+ /murakumo.edn' で異常アップロードを検知\"
                        :remediation \"即座にgit show HEAD:resources/murakumo.edn から復元して再deploy、run-publish.shを修正: npm run prep/release を使わずgit show HEAD:...から複製+shadow-cljs直接呼び出しに変更、fix commitを同日ランド\"
                        :lesson \"共有checkout上で無人ジョブを新設する時、ビルドスクリプトの間接的副作用(npm run prepのcp)が他セッションのdirty working treeを巻き込む経路になり得る -- 個別に検証が必要\"},
    :open-issues [\"kototama/kotodama の命名混同 (ADR-2607050900) は本ADRのスコープ外 -- 今回はkotodamaを使わずkototama単体で足りたため解消は先送り\"
                  \"kototama fleet-run のtenant/guest id固定によりcross-beat checkpoint継続性(fleet-resumeによる真のlease継続)は捨てている -- 毎beat独立lease。将来拡張の余地\"]}"}]
