 :adr/doc_type "adr"
 :adr/topic "a-grammar-is-a-surface-not-a-language"
 :adr/title "A grammar is a surface, not a language — the frontend seam for non-Lisp source, and the surface-convergence claim measured"
 :adr/status "accepted"
 :adr/date "2026-09-08"
 :adr/deciders ["Jun Kawasaki" "Claude Opus 5"]
 :adr/repos ["com-junkawasaki/root" "kotoba-lang/kotoba-lang" "kotoba-lang/amu" "kotoba-lang/osaho" "kotoba-lang/kototama" "kotoba-lang/kotoba-core-contracts"]
 :adr/related ["adr-2609076000-kir-is-an-ipld-codec-schema-and-adl"
               "adr-2609077000-amus-definition-cids-are-unison-shaped-measured"
               "adr-2609078000-kir-is-renamed-osaho"
