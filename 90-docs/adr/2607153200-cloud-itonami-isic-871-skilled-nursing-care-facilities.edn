 :isic-871/registry-entry
 {:id "871"
  :name "Residential nursing care facilities"
  :repo "https://github.com/cloud-itonami/cloud-itonami-isic-871"
  :business-id "cloud-itonami-isic-871"
  :maturity :implemented
  :wave :wave-4}

 :actor/operations
 {:allowed-ops [:log-resident-note
                :schedule-family-or-guardian-visit
                :coordinate-supply-request
                :schedule-staff-shift-proposal
                :flag-safety-concern]
  :closed-allowlist true
  :all-propose true
  :always-escalate [:flag-safety-concern]}

 :actor/governor
 {:hard-checks
  [{:name :resident-unverified
    :description "Resident must exist + be independently verified in store"}
   {:name :effect-not-propose
    :description "All proposals must have :effect :propose"}
   {:name :scope-exclusion
    :description "Extra-conservative exclusion: medication, clinical, nursing-assessment, wound-care, IV/catheter, vital-signs, restraint, end-of-life, safety-authority"}]
  :scope-excluded-terms
  {:medication ["medicatio" "dosing" "prescription" "pharma" "drug" "inject" "infusion"]
   :nursing-assessment ["nursing assessment" "clinical assessment" "clinical diagnosis" "diagnos" "assessment"]
   :vital-signs ["vital sign" "bp reading" "heart rate" "respiration" "temperature" "blood glucose"]
   :wound-care ["wound care" "dressing" "suture" "catheter" "foley" "feeding tube"]
   :end-of-life ["end of life" "dnr" "advance directive" "code status"]
   :safety-authority ["safety authority" "license suspension" "compliance enforcement" "investigat" "complaint"]}
  :escalate-conditions
  {:always-ops [:flag-safety-concern]
   :low-confidence-threshold 0.6}}

 :actor/phase-rollout
 {0 {:label "read-only" :writes #{} :auto #{}}
  1 {:label "assisted-logging" :writes #{:log-resident-note} :auto #{}}
  2 {:label "assisted-coordination"
     :writes #{:log-resident-note :schedule-family-or-guardian-visit :coordinate-supply-request :schedule-staff-shift-proposal}
     :auto #{}}
  3 {:label "supervised-auto"
     :writes :all
     :auto #{:log-resident-note :schedule-family-or-guardian-visit :coordinate-supply-request :schedule-staff-shift-proposal}}}

