  :supersedes []
  :superseded_by []}

 :problem
 {:source "owner clarification 2026-06-30"
  :gap "org partition existed only implicitly — passing 公益/事業 refs in library ADRs plus structural repos.edn keys; no single authoritative taxonomy"
  :risk "new repos land in the wrong org by accident; migration scope (com-junkawasaki->kotoba-lang) ambiguous"}

 :decision
 {:axes
  [{:axis "what (kind of thing)"
    :values ["library / substrate (kotoba-lang) — language core + all -clj infra after migration"
             "agent/product (etzhayyim, gftdcojp)"
             "cloud control plane / heavy data (com-junkawasaki, post-migration)"]}
   {:axis "whom (actors/products only)"
    :values ["公益 public-interest = etzhayyim"
             "ビジネス business = gftdcojp"]}]
  :orgs
  {"kotoba-lang"     {:role :language-substrate
                      :role-text "kotoba 言語 + (after migration) all generic -clj infra libraries"
                      :scope "language/infra substrate, consumed by all orgs"
                      :remote "git@github.com:kotoba-lang" :projects "85 -> growing"}
   "etzhayyim"       {:role :agent-centric
                      :role-text "dispatchable organism actors (com-etzhayyim-*, UNSPSC/ISCO/COFOG)"
                      :scope "公益 (public-interest)"
                      :remote "github.com/etzhayyim" :projects 170}
   "gftdcojp"        {:role :human-centric
                      :role-text "human-facing products & business services (ai-gftd-*, apps, talent)"
                      :scope "ビジネス (business)"
                      :remote "git@github.com:gftdcojp" :projects 50}
   "com-junkawasaki" {:role :transitional-foundation
                      :role-text "generic -clj infra migrating fully to kotoba-lang; retains cloud control planes + heavy/data"
                      :scope "Jun Kawasaki origin org; end-state = cloud + data only"
                      :remote "git@github.com:com-junkawasaki" :projects "53 -> shrinking"}}
  :placement-rule
  {:any-library "kotoba-lang (language core OR generic -clj infra)"
   :public-interest-agent "etzhayyim/com-etzhayyim-*"
   :commercial-product "gftdcojp/ai-gftd-* or app-*"
   :cloud-or-heavy-data "com-junkawasaki (only thing that stays once migration completes)"}
  :migration
  {:mechanism "repos.edn :path-overrides (com-junkawasaki/<x>-clj -> kotoba-lang/<x>) + :remote-overrides where GitHub org stays"
   :moved     "kotoba-language-core: kotoba, kotoba-code, kasane, kami-*, murakumo, office-*, svgraph, aiueos, kekkai, utsushi, vehicle-design-actor..."
   :to-migrate "generic -clj infra: aero-clj, bpmn-clj, ci-clj, ddl-clj, dmn-clj, crash-clj, cron-clj, datom-clj, graphql-clj, ical-clj, jsonlogic-clj, kagi-clj, kenchi-clj, kotobase-clj, ..."
   :decided   "generic -clj infra FULLY migrates to kotoba-lang (owner decision 2026-06-30); com-junkawasaki end-state = cloud (cloud-manimani, cloud-murakumo) + data (spirit-in-physics, ghosthacker) only"
   :github-org-relocation "per-repo decision; some stay at github.com/com-junkawasaki and check out under kotoba-lang/ via :remote-overrides (cf. kami-engine-sdk)"}
  :out-of-scope
  {:not-west-managed ["orgs/kawasakijun/ (personal ops/state)"
                      "orgs/personal/ (life-data vault)"]}}

 :consequences
 ["single authoritative reference for org taxonomy — supersedes the inline 公益/事業 mentions in library ADRs"
  "new-repo placement decided by axis: any library -> kotoba-lang; agent+公益 -> etzhayyim; product+ビジネス -> gftdcojp; cloud+data -> com-junkawasaki"
  "com-junkawasaki -> kotoba-lang full -clj migration DECIDED (2026-06-30); language-core already moved, generic -clj infra to follow; com-junkawasaki end-state = cloud + data only"
  "codified in repos.edn as a doc-only :orgs key (generator does not read it, mirroring :manifest-workflow)"
  "individual/vendor-specific service repos now classified BEFORE scaffolding via :repo-creation-check, not retroactively at migration time"]

 :repo-creation-check
 {:amended "2026-07-01"
  :purpose "answer 'which org does a NEW repo go in' at creation time, before scaffolding"
  :step-1-layer-test
  {:question "is this a pure technical layer: .cljc, zero network I/O, zero vendor SDK, records/protocol/data-model only?"
   :yes "kotoba-lang"
   :exemplars ["banking" "card" "swift" "eth-crypto" "cacao" "did" "vc"
               "koe (ports + dialog-loop only; every concrete capability injected by host, so admissible despite service-shaped domain)"]
   :no "fails layer test -> go to step-2 (this covers: real PayPay/Stripe/bank API calls, a video-call app, a wallet UI, an Ethereum RPC client, ...)"}
  :step-2-3-axis-charter-check
  {:when "candidate is an individual/vendor-specific service (fails step-1)"
   :worked-examples ["orgs/gftdcojp/ai-gftd-stripe/NOT-MIGRATED-VENDOR-REGULATORY.md.edn"
                     "orgs/gftdcojp/ai-gftd-livecam/NOT-MIGRATED-CHARTER-VIOLATION.md.edn"]
   :axis-a-settlement-regulatory
   {:question "does the service hit a Settlement/regulatory axis? (PCI-DSS, 資金決済法, 景品表示法, 特定商取引法, KYC/AML, banking/broker-dealer licensing, ...)"
    :if-hit "gftdcojp/ai-gftd-* (vendor-retained; regulatory liability stays with the gftd business entity)"}
   :axis-b-charter-rider-v2
   {:question "does the business model or content type hit Charter Rider v2.0 §2(a-h)?"
    :clauses ["(a) WEAPONS AND MILITARY" "(b) SPECULATIVE FINANCE"
              "(c) SURVEILLANCE CAPITALISM (ad-tech / data brokerage)"
              "(d) FOSSIL FUEL EXTRACTION (new projects)" "(e) SPECIALIST GATEKEEPING"
              "(f) MULTI-GENERATIONAL HARM" "(g) STRICT INDIVIDUALIST ONTOLOGY"
              "(h) WELLBECOMING SUBORDINATION VIOLATION"]
    :if-hit "gftdcojp/ai-gftd-* (excluded from etzhayyim by charter, same as ai-gftd-livecam)"}
   :neither-hit "etzhayyim/com-etzhayyim-* as a proper actor (sealed-intelligence dashv independent governor, append-only ledger, RAD identity per CLAUDE.md Actors section); consumes kotoba-lang protocol libs for the technical layer"}}

 :open-questions
 []}  ; resolved 2026-06-30: full -clj migration to kotoba-lang decided; 2026-07-01: repo-creation-time placement check added
