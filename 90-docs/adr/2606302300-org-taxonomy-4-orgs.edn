[{:adr/consequences ["single authoritative reference for org taxonomy — supersedes the inline 公益/事業 mentions in library ADRs" "new-repo placement decided by axis: any library -> kotoba-lang; agent+公益 -> etzhayyim; product+ビジネス -> gftdcojp; cloud+data -> com-junkawasaki" "com-junkawasaki -> kotoba-lang full -clj migration DECIDED (2026-06-30); language-core already moved, generic -clj infra to follow; com-junkawasaki end-state = cloud + data only" "codified in repos.edn as a doc-only :orgs key (generator does not read it, mirroring :manifest-workflow)" "individual/vendor-specific service repos now classified BEFORE scaffolding via :repo-creation-check, not retroactively at migration time" "noted exception (2026-07-01, ADR-2607012100): cloud-itonami-* public OSS business/occupation blueprint repos (35, formerly under gftdcojp) live in a dedicated cloud-itonami org — a product-line-specific public repo home, not a 5th taxonomy tier; the 4-org role split above is unchanged"], :adr/authoritative_for ["which GitHub org a new repo belongs in: any library (language or -clj infra) -> kotoba-lang / public-interest agent -> etzhayyim / commercial product -> gftdcojp / cloud+data -> com-junkawasaki" "the 公益=etzhayyim / 事業=gftdcojp split that library ADRs assert only inline" "com-junkawasaki -> kotoba-lang full -clj migration (decided 2026-06-30); com-junkawasaki end-state = cloud + data only" "repo-creation-time placement check for individual/vendor-specific services: layer test (kotoba-lang) then 3-axis+Charter Rider check (etzhayyim vs gftdcojp) — amendment 2026-07-01"], :adr/supersedes [], :adr/superseded_by [], :adr/topic "org-taxonomy", :adr/related ["manifest/repos.edn" "CLAUDE.md" "90-docs/adr/2606272212-ci-clj-github-actions-edn-dag.md" "90-docs/adr/2606272209-policy-clj-abac-rbac-edn.md" "90-docs/adr/2606272213-ddl-clj-sql-schema-migration.md" "90-docs/adr/2606272200-bpmn-clj-edn-process-library.md" "90-docs/adr/2606301900-isco-cofog-organism-actors.md" "90-docs/adr/2606272237-manifest-workflow-single-entry-commit.md" "orgs/gftdcojp/ai-gftd-stripe/NOT-MIGRATED-VENDOR-REGULATORY.md.edn" "orgs/gftdcojp/ai-gftd-livecam/NOT-MIGRATED-CHARTER-VIOLATION.md.edn" "90-docs/adr/2607012100-cloud-itonami-org-split.md"], :adr/status "proposed", :adr/id "adr-2606302300-org-taxonomy-4-orgs", :adr/repo-creation-check "{:amended \"2026-07-01\", :purpose \"answer 'which org does a NEW repo go in' at creation time, before scaffolding\", :step-1-layer-test {:question \"is this a pure technical layer: .cljc, zero network I/O, zero vendor SDK, records/protocol/data-model only?\", :yes \"kotoba-lang\", :exemplars [\"banking\" \"card\" \"swift\" \"eth-crypto\" \"cacao\" \"did\" \"vc\" \"koe (ports + dialog-loop only; every concrete capability injected by host, so admissible despite service-shaped domain)\"], :no \"fails layer test -> go to step-2 (this covers: real PayPay/Stripe/bank API calls, a video-call app, a wallet UI, an Ethereum RPC client, ...)\"}, :step-2-3-axis-charter-check {:when \"candidate is an individual/vendor-specific service (fails step-1)\", :worked-examples [\"orgs/gftdcojp/ai-gftd-stripe/NOT-MIGRATED-VENDOR-REGULATORY.md.edn\" \"orgs/gftdcojp/ai-gftd-livecam/NOT-MIGRATED-CHARTER-VIOLATION.md.edn\"], :axis-a-settlement-regulatory {:question \"does the service hit a Settlement/regulatory axis? (PCI-DSS, 資金決済法, 景品表示法, 特定商取引法, KYC/AML, banking/broker-dealer licensing, ...)\", :if-hit \"gftdcojp/ai-gftd-* (vendor-retained; regulatory liability stays with the gftd business entity)\"}, :axis-b-charter-rider-v2 {:question \"does the business model or content type hit Charter Rider v2.0 §2(a-h)?\", :clauses [\"(a) WEAPONS AND MILITARY\" \"(b) SPECULATIVE FINANCE\" \"(c) SURVEILLANCE CAPITALISM (ad-tech / data brokerage)\" \"(d) FOSSIL FUEL EXTRACTION (new projects)\" \"(e) SPECIALIST GATEKEEPING\" \"(f) MULTI-GENERATIONAL HARM\" \"(g) STRICT INDIVIDUALIST ONTOLOGY\" \"(h) WELLBECOMING SUBORDINATION VIOLATION\"], :if-hit \"gftdcojp/ai-gftd-* (excluded from etzhayyim by charter, same as ai-gftd-livecam)\"}, :neither-hit \"etzhayyim/com-etzhayyim-* as a proper actor (sealed-intelligence dashv independent governor, append-only ledger, RAD identity per CLAUDE.md Actors section); consumes kotoba-lang protocol libs for the technical layer\"}}", :adr/doc_type "adr", :adr/last_verified "2026-06-30", :adr/decision "{:axes [{:axis \"what (kind of thing)\", :values [\"library / substrate (kotoba-lang) — language core + all -clj infra after migration\" \"agent/product (etzhayyim, gftdcojp)\" \"cloud control plane / heavy data (com-junkawasaki, post-migration)\"]} {:axis \"whom (actors/products only)\", :values [\"公益 public-interest = etzhayyim\" \"ビジネス business = gftdcojp\"]}], :orgs {\"kotoba-lang\" {:role :language-substrate, :role-text \"kotoba 言語 + (after migration) all generic -clj infra libraries\", :scope \"language/infra substrate, consumed by all orgs\", :remote \"git@github.com:kotoba-lang\", :projects \"85 -> growing\"}, \"etzhayyim\" {:role :agent-centric, :role-text \"dispatchable organism actors (com-etzhayyim-*, UNSPSC/ISCO/COFOG)\", :scope \"公益 (public-interest)\", :remote \"github.com/etzhayyim\", :projects 170}, \"gftdcojp\" {:role :human-centric, :role-text \"human-facing products & business services (ai-gftd-*, apps, talent)\", :scope \"ビジネス (business)\", :remote \"git@github.com:gftdcojp\", :projects 50}, \"com-junkawasaki\" {:role :transitional-foundation, :role-text \"generic -clj infra migrating fully to kotoba-lang; retains cloud control planes + heavy/data\", :scope \"Jun Kawasaki origin org; end-state = cloud + data only\", :remote \"git@github.com:com-junkawasaki\", :projects \"53 -> shrinking\"}}, :placement-rule {:any-library \"kotoba-lang (language core OR generic -clj infra)\", :public-interest-agent \"etzhayyim/com-etzhayyim-*\", :commercial-product \"gftdcojp/ai-gftd-* or app-*\", :cloud-or-heavy-data \"com-junkawasaki (only thing that stays once migration completes)\"}, :migration {:mechanism \"repos.edn :path-overrides (com-junkawasaki/<x>-clj -> kotoba-lang/<x>) + :remote-overrides where GitHub org stays\", :moved \"kotoba-language-core: kotoba, kotoba-code, kasane, kami-*, murakumo, office-*, svgraph, aiueos, kekkai, utsushi, vehicle-design-actor...\", :to-migrate \"generic -clj infra: aero-clj, bpmn-clj, ci-clj, ddl-clj, dmn-clj, crash-clj, cron-clj, datom-clj, graphql-clj, ical-clj, jsonlogic-clj, kagi-clj, kenchi-clj, kotobase-clj, ...\", :decided \"generic -clj infra FULLY migrates to kotoba-lang (owner decision 2026-06-30); com-junkawasaki end-state = data (spirit-in-physics, ghosthacker) only — cloud-manimani/cloud-murakumo already GitHub-transferred to gftdcojp 2026-07-02 (superseded; see amendment-2026-07-04 below and ADR-2607041302)\", :github-org-relocation \"per-repo decision; some stay at github.com/com-junkawasaki and check out under kotoba-lang/ via :remote-overrides (cf. kami-engine-sdk)\"}, :exceptions [{:id \"adr-2607011100-svg-era-office-repo-split\", :date \"2026-07-01\", :summary \"CLJ/EDN rewrites remain in kotoba-lang, but SVG-era browser/TypeScript tooling is restored as com-junkawasaki/office-causal and com-junkawasaki/svgraph.\", :repos [\"com-junkawasaki/office-causal\" \"com-junkawasaki/svgraph\"], :reason \"preserve package names, GitHub Pages URLs, and SVG/Office integration surfaces without conflating them with the kotoba CLJ/EDN substrate\"} {:id \"adr-2607041302-murakumo-family-naming\", :date \"2026-07-04\", :summary \"cloud-manimani/cloud-murakumo (the com-junkawasaki cloud control planes named in :migration :decided above) were already GitHub-transferred to gftdcojp 2026-07-02; cloud-murakumo was renamed cloud-murakumo-fleet on transfer (collided with pre-existing gftdcojp/cloud-murakumo, Sora). ADR-2607041302 formalizes the resulting murakumo family and proposes renaming cloud-murakumo-fleet -> local-murakumo.\", :repos [\"gftdcojp/cloud-manimani\" \"gftdcojp/cloud-murakumo\" \"gftdcojp/cloud-murakumo-fleet\" \"kotoba-lang/murakumo\"], :reason \"org-taxonomy table (both gftdcojp-owned cloud control planes) is unaffected; this only corrects the stale com-junkawasaki attribution and hands naming authority to ADR-2607041302\"}], :out-of-scope {:not-west-managed [\"orgs/kawasakijun/ (personal ops/state)\" \"orgs/personal/ (life-data vault)\"]}}", :db/id -1, :adr/open-questions [], :adr/problem "{:source \"owner clarification 2026-06-30\", :gap \"org partition existed only implicitly — passing 公益/事業 refs in library ADRs plus structural repos.edn keys; no single authoritative taxonomy\", :risk \"new repos land in the wrong org by accident; migration scope (com-junkawasaki->kotoba-lang) ambiguous\"}", :adr/authoritative true, :adr/title "ADR-2606302300: Four-org taxonomy — kotoba-lang (language) / etzhayyim (agent+公益) / gftdcojp (human+ビジネス) / com-junkawasaki (foundation→cloud+data)"}]