  (:adr/title "Grok Bot is Cursor relabelled; five of its mechanisms are worth taking into cloud-itonami-app")
  (:adr/status "accepted")
  (:adr/date "2026-08-14")
  (:adr/supersedes "")
  (:adr/superseded-by "")
