 :decision
 {:product "org-spirit-in-physics"
  :placement :com-junkawasaki
  :subject :web-cljc-phase5-katex-paper
  :pattern :a_assets_only
  :definition "apps/web/src/routes/paper（PaperView.svelte + PaperContent.md）を spirit-ui.views.web.paper へ移植。KaTeX は auto-render.mjs の interop wrap、TOCスクロールスパイはIntersectionObserver、テキストはparaglide en.jsonから静的複製。"
  :process_note "本ADRはADR-2607012100が指定した「フェーズ5は別ADR/別セッション」の手順を実装(PR #21)着手時に踏まずに進めてしまった事後起票。/review のconventions角度findingで指摘され是正。フェーズ3・4は着手前に個別ADR起票を継続する。"
  :opaque_diffing
  {:problem "KaTeXがDOMを直接書き換える(テキストノード→katex span群)ため、spirit-ui.domの差分レンダラーが追跡する:ui/childrenと実DOMがずれ、次回再diff時にpatch-children!が位置ずれから誤ったノードを誤認識・破損させる"
   :mechanism ":opaque属性マーカーをpatch!に追加。旧新IRが構造的に`=`なら子孫の再diffをスキップ"
   :contract ":opaqueを付けたノードの構築関数は render間で常に`=`な出力を返す純粋関数でなければならない(docstringのみで強制、テストは未整備)"}
  :found_bug "paper.cljcの(when toc-open? ...)がpaper-containerの兄弟間で unkeyed だったため、TOC開閉が後続兄弟の位置キーをシフトさせ、article部分文木が破棄・生テキストで再生成される実バグをブラウザ実動作確認で発見・修正(全兄弟にkeyを付与)"
  :i18n_scope "settings.cljc(フェーズ2)と同じ判断でスコープ外。en.jsonの英語テキストをspirit_ui.data.paper-contentへ静的EDN複製"
  :font_asset_trim "katexフォントは.woff2のみコミット(.woff/.ttfはcss src listでwoff2の後方=evergreenブラウザでは未フェッチのため削除、1.2M→320K)"
  :implementation {:language ".cljc"
                    :new_ns ["spirit-ui.views.web.paper" "spirit-ui.data.paper-content" "spirit-ui.katex-interop"]
                    :shared_ns_touched ["spirit-ui.dom (opaque追加)" "spirit-ui.web-main (route配線)"]}}

 :guardrails
 {:adr_before_phase "フェーズ3(kami-engine結合)・フェーズ4(D3)は実装着手前に個別ADR起票を継続する(本ADRの事後起票の反省を踏まえる)"
  :opaque_future_caller "将来:opaqueを別の動的host-mutatedウィジェットに使う場合、旧新IR不一致時は通常diffにフォールバックする現在の挙動がKaTeXと同種の破損を再現しうる点に注意"
  :git "shallow既定・FF-only main・force-push禁止"}

 :out_of_scope ["フェーズ3(Force3D可視化、kami-engine結合)"
