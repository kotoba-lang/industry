  :adr/decision-summary "{:pattern \"sealed ShoshaAdvisor + independent :shosha-trading-governor + append-only audit ledger, modeled directly on cloud-itonami-isic-4671 FuelTradeAdvisor (same actuation-gate shape, generalized from single-commodity fuel-excise/physical-rack regulation to multi-commodity export-control/sanctions regulation)\", :new-actor \"cloud-itonami-isic-4690\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-4690\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"4690\", :isic-name \"Non-specialized wholesale trade\", :registry-promotion \"kotoba-lang/industry registry.edn id 4690: :maturity :spec (dead gftdcojp/cloud-itonami-G4690 placeholder URL) -> :implemented (real repo), 3rd promotion after M6910's 6910 and isic-8291\", :namespace \"shosha\", :governor-checks [{:check :spec-basis :severity :hard} {:check :evidence-incomplete :severity :hard} {:check :credit-uncleared :severity :hard} {:check :contract-missing :severity :hard} {:check :export-license-uncleared :severity :hard :note \"new -- no analog in the fueltrade precedent; encodes multi-commodity cross-border export-control exposure directly\"} {:check :counterparty-sanctions-flag-unresolved :severity :hard :note \"evaluated unconditionally at both :shipment/dispatch and :invoice/settle\"} {:check :already-dispatched :severity :hard} {:check :already-invoiced :severity :hard} {:check :high-stakes-actuation-gate :severity :soft-escalate :note \":shipment/dispatch and :invoice/settle never auto-commit at any phase even when governor-clean\"}], :actuation-invariant \":shipment/dispatch and :invoice/settle are never members of any phase's :auto set -- structural permanent human gate, enforced independently by both shosha.governor's high-stakes gate and shosha.phase's phase table, same shape as fueltrade/M6910\", :r0-scope {:source-catalog [\"JPN 外国為替及び外国貿易法(FEFTA)+輸出貿易管理令, METI 安全保障貿易管理\" \"USA Export Administration Regulations (15 C.F.R. Parts 730-774, BIS) + OFAC sanctions programs\" \"GBR Export Control Order 2008 (SI 2008/3231) + OFSI financial sanctions\" \"DEU/EU Regulation (EU) 2021/821 dual-use export-control recast + BAFA, AWG/AWV\"], :citations-verified \"independently re-verified via WebSearch at ADR-authoring time (all 4 confirmed accurate); the implementing agent had cited them from training knowledge without live web access\", :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as cloud-itonami-6310/isic-8291\"}, :robotics {:value false, :key-present false, :rationale \":shipment/dispatch is a logistics-coordination referral to a licensed freight forwarder/customs broker, not an actor-controlled physical act -- same exemption class as cloud-itonami-6310/-isic-6910/-isic-8291, contrast fueltrade's loading-rack valve robot\"}, :test-results {:unit-tests \"36 tests / 174 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end, all 7 hold rules triggered correctly\"}, :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. Only kotoba-lang/industry pin advanced in manifest/west.yml (--entry industry, minimal diff)\"}"
