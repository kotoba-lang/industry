(vector (map (:db/id -1)
  (:adr/id "adr-2607176501-cloud-itonami-isic-1075-security-incident-governor-amendment")
  (:adr/title "ADR-2607176501: cloud-itonami-isic-1075 amendment — SecurityIncidentGovernorのbcp-precondition対象への追加、リポジトリ側は無変更")
