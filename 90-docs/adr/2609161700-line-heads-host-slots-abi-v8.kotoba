(vector (map (:db/id -1)
  (:adr/id "adr-2609161700-line-heads-host-slots-abi-v8")
  (:adr/doc_type "adr")
  (:adr/authoritative true)
  (:adr/title "string-index-of-from / string-compare-lines を host slot にする（context ABI v8）と、行指向 command の出力を batch する")
  (:adr/status "accepted")
  (:adr/date "2026-09-16")
  (:adr/last_verified "2026-09-16")
  (:adr/deciders (vector "Jun Kawasaki"))
  (:adr/topic "kotoba-native-runtime")
  (:adr/repos (vector "orgs/kotoba-lang/kotoba-lang"
              "orgs/kotoba-lang/kotoba-gmir"
              "orgs/kotoba-lang/kotoba-mir"
              "orgs/kotoba-lang/osaho"
              "orgs/kotoba-lang/kotoba-sema"
              "orgs/kotoba-lang/kotoba-native"
              "orgs/kotoba-lang/kotoba-verifier"
              "orgs/kotoba-lang/amu"
              "orgs/kotoba-lang/artifact"
              "orgs/kotoba-lang/org-ieee-sort"
              "orgs/kotoba-lang/org-ieee-uniq"
              "orgs/kotoba-lang/org-ieee-cut"
              "orgs/kotoba-lang/org-ieee-grep"
