  :adr/phase-1-2026-07-14
  {:summary "Investigated the planned compiler/-vs-profile.edn diff and found the
             plan's premise wrong: profile.edn has no special-forms grammar at all.
             Read compiler/frontend.clj and kotoba/README.md directly instead, and
             found the REAL duplication: compiler/'s forbidden-heads/cap-call/
             direct-facts+infer-effects IS the CLJC-native successor of kotoba/'s
             historical Rust subset.rs/policy.rs/effects.rs three-gate safe-Kotoba
             design (T1 Memory Safety / T2 Effect Soundness / T3 Capability
             Confinement) -- but kotoba/'s own README claimed that successor
             'lives entirely in kotoba-lang/kotoba-lang', which implements none
             of it (grep 0 hits). Fixed via doc-only README edits, no code/grammar
             change (grammar reconciliation itself deferred, see :adr/plan phase
             follow-up note)."
   :gate-mapping [{:gate :subset :theorem "no ambient code/effect"
                    :rust "subset.rs" :cljc "compiler/frontend.clj forbidden-heads"}
                  {:gate :capability :theorem "T3 Capability Confinement"
                   :rust "policy.rs" :cljc "compiler/frontend.clj cap-call"}
                  {:gate :effect :theorem "T2 Effect Soundness"
                   :rust "effects.rs"
                   :cljc "compiler/frontend.clj direct-facts + infer-effects
                          (interprocedural fixpoint, converges through mutual
                          recursion)"}]
   :commits [{:repo "kotoba-lang/compiler" :from "96f72fb" :to "26ff523"
              :change "added 'Relationship to kotoba-lang/kotoba and
                        kotoba-lang/kotoba-lang' README section + gate-mapping table"}
             {:repo "kotoba-lang/kotoba" :from "53d51110c" :to "ecadee870"
