(vector (map (:db/id -1)
  (:adr/id "adr-2608280200-hyakka-resident-unwedged-and-the-wrong-seed")
  (:adr/title "hyakka resident の 2 つの詰まりを外し、間違った seed を publish 直前で止めた")
  (:adr/status "accepted")
  (:adr/date "2026-08-28")
