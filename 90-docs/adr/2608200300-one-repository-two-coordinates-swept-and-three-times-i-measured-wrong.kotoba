  (:source/dataset "adr")
  (:adr/repos "com-junkawasaki/root, kotoba-lang/* (195 repos)")
  (:adr/authoritative_for (vector "that tools.deps dedupes by coordinate symbol, and what that cost this workspace: 260 closures with a duplicate, 189 of them loading different content"
                          "that renaming one end of a closure while the other is stale CREATES the defect, measured and reverted 27 times"
                          "that the coordinate detector counted only :git/sha and therefore saw under half the population"
                          "that west.yml has ZERO duplicate registrations -- the duplication is on disk, 252 orphans and one divergent shadow"
                          "the honest strength of the evidence: -Spath resolution for most, full suites for few"))
  (:adr/related (vector "adr-2608200200-clock-native-aot-is-refused-by-an-accepted-adr-not-unfinished"
