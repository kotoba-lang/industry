  (:adr/title "同じ repo を 2 つの座標で参照していたのを fleet 規模で正準化した —— そして私は 3 度測り間違えた")
  (:adr/status "accepted")
  (:adr/date "2026-08-20")
  (:adr/topic "dependency-hygiene")
