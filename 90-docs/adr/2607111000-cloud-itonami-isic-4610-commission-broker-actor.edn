  :adr/decision-summary "{:pattern \"sealed CommTradeAdvisor + independent :commission-broker-governor + append-only audit ledger, an AGENCY/BROKERAGE model (broker never a principal) distinct from the two principal-trading siblings cloud-itonami-isic-4671/4690\", :new-actor \"cloud-itonami-isic-4610\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-4610\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"4610\", :isic-name \"Wholesale on a fee or contract basis\", :registry-promotion \"kotoba-lang/industry registry.edn id 4610: :maturity :spec (dead gftdcojp/cloud-itonami-G4610 placeholder URL) -> :implemented (real repo), 4th promotion after M6910/isic-8291/isic-4690\", :namespace \"commtrade\", :governor-checks [{:check :spec-basis :severity :hard} {:check :evidence-incomplete :severity :hard} {:check :mandate-missing :severity :hard} {:check :principal-identity-unverified :severity :hard :note \"both :buyer-kyc-cleared? AND :seller-kyc-cleared? required -- broker is responsible for both sides' KYC, unlike the single-counterparty credit check in fueltrade/shosha\"} {:check :conflict-of-interest-undisclosed :severity :hard :note \"new -- no analog in the principal-trading siblings; fires when :mandate-side is :dual and :dual-agency-disclosed? is not true; the doctrinal core of why brokerage is its own ISIC category, grounded in commercial-broker neutrality duty under JPN 商法\"} {:check :counterparty-sanctions-flag-unresolved :severity :hard :note \"both buyer and seller screened, evaluated unconditionally at both :deal/confirm and :commission/invoice\"} {:check :already-confirmed :severity :hard} {:check :already-invoiced :severity :hard} {:check :high-stakes-actuation-gate :severity :soft-escalate :note \":deal/confirm and :commission/invoice never auto-commit at any phase\"}], :deliberately-absent {:check :credit-uncleared, :rationale \"a commission broker never extends credit or takes a position -- no analog exists in this business model, documented explicitly to distinguish from a lazy relabel of the fueltrade/shosha precedent\"}, :actuation-invariant \":deal/confirm and :commission/invoice never members of any phase's :auto set -- :deal/confirm records a match between two principals who settle directly with each other, outside the actor's boundary; :commission/invoice bills only the broker's own fee, not the underlying trade settlement\", :r0-scope {:source-catalog [\"JPN 商法(Act No. 48 of 1899) 第543条以下 仲立営業 -- 仲立人の当事者双方への中立・公平義務が conflict-of-interest チェックの実定法根拠\" \"GBR The Commercial Agents (Council Directive) Regulations 1993 (SI 1993/3053), implementing EU Directive 86/653/EEC, assimilated law post-Brexit\" \"DEU Handelsgesetzbuch (HGB) §§84-92c Handelsvertreter, also implementing Directive 86/653/EEC\" \"USA Perishable Agricultural Commodities Act (PACA), 7 U.S.C. §499a et seq., USDA AMS licenses commission merchants/dealers/brokers -- honestly scoped to perishable agricultural commodities only, not general commission-agent trade\"], :citations-verified \"independently re-verified via WebSearch at ADR-authoring time (all 4 confirmed accurate)\", :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as siblings\"}, :robotics {:value false, :key-present false, :rationale \"even more clearly than isic-4690: a commission broker's entire actuation surface is arranging/confirming a deal on paper/systems, delivery and payment settle directly between the two principals outside the actor's boundary\"}, :test-results {:unit-tests \"36 tests / 179 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end, clean intake->verify->confirm->invoice plus all 6 HARD-hold scenarios fired correctly\"}, :uncertainties-flagged [\"UK owner-authority (Dept for Business and Trade as SI 1993/3053 policy successor) is a reasonable inference, not verbatim-sourced\" \"Germany sanctions-enforcement attributed only to Deutsche Bundesbank; Germany actually has 3 co-existing bodies (Bundesbank, new Central Office for Sanctions Enforcement under Customs, Zoll) -- simplification noted\"], :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. Only kotoba-lang/industry pin advanced in manifest/west.yml (--entry industry, minimal diff)\"}"
