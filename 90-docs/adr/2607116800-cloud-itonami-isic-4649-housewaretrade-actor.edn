  :adr/decision-summary "{:pattern \"sealed HousewareTradeAdvisor + independent :consumer-product-safety-governor + append-only audit ledger, PRINCIPAL trading model with a US CPSC consumer-product-safety regulatory backbone -- a consumer-goods cousin of isic-4653's durable-capital-equipment product-compliance pattern, but with a genuinely different check-shape axis: temporal (pre-shipment certificate vs. post-hoc continuous-monitoring duty) rather than spatial (jurisdiction/type/conjunction)\", :new-actor \"cloud-itonami-isic-4649\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-4649\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"4649\", :isic-name \"Wholesale of other household goods\", :registry-promotion \"kotoba-lang/industry registry.edn id 4649: :maturity :spec (dead gftdcojp/cloud-itonami-G4649 placeholder URL) -> :implemented (real repo)\", :namespace \"housewaretrade\", :dual-check-shapes {:pre-shipment {:check :childrens-product-certificate-missing, :gate :childrens-product?, :folds [:lead-phthalate-tested? :childrens-product-certificate-on-file?], :evaluated-at [:delivery/dispatch]} :post-hoc-monitoring {:check :active-recall-unresolved, :representation \"tri-state enum :recall-status (:none/:open/:resolved), NOT a boolean\", :evaluated-at [:delivery/dispatch :invoice/settle], :rationale \"CPSA §15(b)/15 U.S.C. §2064(b) is a 'keep monitoring' duty (a recall is discovered AFTER a product has already been in commerce), not a 'prove clean once' duty like every prior sibling's pre-shipment certificate check\", :distinction-from-status-antipattern \"explicitly documented as distinct from the isic-6492 :status-as-double-actuation-guard bug pattern -- double-actuation guards remain dedicated :dispatched?/:invoiced? booleans on a separate axis\", :proof \"full open->resolved lifecycle on the SAME SKU proven via the existing :order/intake patch path (no new op needed), in both demo and tests\"}}, :governor-checks [{:check :no-spec-basis :severity :hard} {:check :evidence-incomplete :severity :hard} {:check :credit-uncleared :severity :hard} {:check :contract-missing :severity :hard} {:check :childrens-product-certificate-missing :severity :hard} {:check :active-recall-unresolved :severity :hard} {:check :counterparty-sanctions-flag-unresolved :severity :hard} {:check :already-dispatched :severity :hard} {:check :already-invoiced :severity :hard} {:check :high-stakes-actuation-gate :severity :soft-escalate}], :robotics {:value true, :note \"deliberate departure from isic-4653's :robotics false -- housewares/small-appliances/toys are carton/pallet-scale goods with real AS/RS/robotic case-picking apparatus in commercial distribution-center practice, unlike isic-4653's self-propelled/towed large equipment with no fixed automatable apparatus; not copied mechanically from the most recent sibling\"}, :r0-scope {:source-catalog [\"USA CPSIA (Consumer Product Safety Improvement Act of 2008, Pub. L. 110-314) / 15 U.S.C. §1278a (100ppm lead limit), 16 CFR Part 1303 (lead paint) / Part 1307 (phthalates, 0.1% limit), CPSA §14 / 16 CFR Part 1107+1110 (Children's Product Certificate, third-party testing), CPSA §15(b) / 15 U.S.C. §2064(b) (24-hour recall reporting), 16 CFR Part 1632/1633 (mattress flammability)\" \"JPN 消費生活用製品安全法 (METI/Consumer Affairs Agency, PSC mark, serious-product-accident reporting within 10 days of awareness -- exact figure independently re-verified via WebSearch at ADR-authoring time, confirming the implementing agent's moderate-confidence citation was accurate)\"], :deliberate-exclusion \"EU General Product Safety Regulation (EU) 2023/988 deliberately NOT seeded due to scope-boundary uncertainty -- honest coverage over padding to match sibling jurisdiction counts\", :citations-verified \"all citations independently re-verified via WebSearch at ADR-authoring time, all confirmed accurate including the precise Japan 10-day reporting window\", :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as siblings\"}, :test-results {:unit-tests \"41 tests / 217 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end: children's-product type-gating (clean/missing-cert/non-children's), and the full recall open->resolved lifecycle on the same SKU\"}, :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. Only kotoba-lang/industry pin advanced in manifest/west.yml (nbb scripts/gen-west-manifest.cljs --entry industry, minimal diff)\"}"
