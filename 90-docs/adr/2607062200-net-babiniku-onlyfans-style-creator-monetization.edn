 :problem
 {:source "user direction 2026-07-06: raise net-babiniku's maturity to a full VTuber platform
           where the talent is an LLM (not a human) doing livechat/conversation/motion, with
           livechat, oshikatsu, tips (投げ銭), monthly subscription (月額課金), run in the same
           operating style as OnlyFans"
  :clarifying_answers
  {:content_rating "tiered -- free SFW core chat stays free; a paid tier may include NSFW
                    content"
   :payment "an adult-content-compatible PSP, integrated separately, not Stripe"
   :turn_scope "ADR only, no code this turn"}
  :current_state
  {:net_babiniku "Milestone 0: kami-webgpu render loop, flat babiniku.governor/review-turn
                  (blocked-terms/allowed-emotions/allowed-motion-cues), atom-backed
                  append-only ledger, broadcast-button-view UI stub (console.log only,
                  src/babiniku/ui/views.cljs:34-45), no LLM backend, no TTS, no real chat"
   :adr_2607051800 "explicitly scoped out LLM provider(s), pricing/currency model, and
                    moderation policy detail as follow-up"
   :adr_2607051900 "covers only RTMP/WebRTC streaming transport to Twitch/YouTube/OBS, no
                    monetization"
   :canvas_ledger "net-babiniku has no entry yet in 90-docs/business/canvas-ledger.edn"}
  :prior_art
  {:club_shinshi
   {:what "gftdcojp/club-shinshi (shinshi.club), live, already runs almost exactly this
           model"
    :monetization "ADR-2606010100 + amendments (b)(c): AI characters recast as OnlyFans-style
                   creators -- monthly subscription + PPV + tips (Shinshi Points), 80/20
                   creator take rate, core viewing/1:1-chat/search stays free+ad-supported
                   (creator payment is an opt-in upsell, not a full paywall)"
    :psp_gate "Stripe already ruled out for NSFW org-wide; paid creator layer blocked until an
               adult-friendly PSP (CCBill/Verotel/Epoch/Segpay) is actually contracted; until
               then all paid UI renders 準備中, never a fake checkout (ADR-0084 honest
               default)"
    :dual_rail "fiat rail: MoR = gftd, vendor-repo implementable (standing 'payment
                counterparty is always gftd' decision). crypto/USDC rail: out of bounds for
                any gftdcojp repo -- self-custody on-chain settlement must live in
                etzhayyim/root per the centralization-axis boundary (ADR-2605211950,
                ADR-2605172100)"
    :legal "特定商取引法 disclosure required for fiat tier at go-live; JP 刑法175
            extraterritorial obscenity risk (FC2 precedent) + geo-block; UK AVSA / French
            LCEN / US KOSA regional NSFW controls"
    :nsfw_llm "ADR-2606032100: self-fine-tuned gemma-4-26B-A4B (bf16 LoRA) served on
               Modal/vLLM, not a third-party API (third-party APIs categorically refuse
               in-character adult roleplay); hard invariants preserved even uncensored (no
               minors, no real persons, no non-consent, 3-stage 18+ age gate, mandatory AT
               self-label); train/inference system-prompt byte-parity is non-negotiable"}
   :gftd_talent_actor
   {:policy "talent.policy: 6-tier HARD/SOFT violation model (RBAC/purpose-limitation/
             fairness/minimal-disclosure = HARD non-overridable; confidence-floor/high-stakes
             = SOFT human-approval-eligible) -- richer than net-babiniku's flat check"
    :store "talent.store: Store protocol (MemStore / DatomicStore, same contract) for the
            append-only ledger"
    :operation "talent.operation: langgraph-clj StateGraph with interrupt-before
                #{:request-approval} for human-in-the-loop escalation"}
   :billing_precedent
   ["orgs/gftdcojp/net-kotobase/clj-edge/src/kotobase/billing.cljc -- webhook to pure
     function to KV persistence pattern for subscription-tier state"
    "orgs/kotoba-lang/com-stripe/src/stripe/main.cljc -- clean-room Stripe entity schema
     (Customer/Subscription/PaymentIntent/Charge/Refund/Invoice/Product/Price), usable as the
     internal domain schema regardless of which PSP actually settles funds"]}}

 :decision
 {:content_tiering
  {:free "existing SFW conversational-VTuber experience (Milestone 0 scope) unchanged, stays
          free"
   :paid "new tier on top, may include NSFW content -- same two-tier shape as club-shinshi's
          core-free/creator-paid split, not a full paywall"}
  :monetization_primitives
  {:subscription "月額課金, per character, tiered Free/Sub/VIP, mirroring shinshi's
                  OnlineSalon.svelte redesign"
   :ppv "単発の限定コンテンツ/シーン購入"
   :tips "投げ銭, points-style micro-payment surfaced during livechat -- this is 'oshikatsu'
          in product terms"
   :creator_take_rate "80/20, OnlyFans-canonical, matching club-shinshi"}
  :payment_rail
  {:what "fiat only, via an adult-friendly PSP, vendor(gftdcojp)-implementable"
   :not_stripe "per user direction and org-wide NSFW ToS conflict precedent"
   :vendor_selection "CCBill vs Verotel vs Epoch vs Segpay is a business/legal contracting
                      decision, out of scope for this ADR, not resolvable in code"
   :crypto_out_of_scope "USDC/on-chain settlement explicitly out of scope for net-babiniku (a
                         gftdcojp repo); if wanted later must be implemented in
                         etzhayyim/root and consumed via a consent-capability boundary, per
                         the standing centralization-axis decision"}
  :honest_default
  {:rule "until an actual PSP contract exists, every paid-looking control (subscribe/tip/PPV)
          renders disabled/準備中 -- this ADR does not authorize a checkout UI that appears
          to charge money before real PSP integration exists"
   :precedent "ADR-0084 (yoro ads integration honest-default pattern), inherited unchanged"}
  :governor_upgrade
  {:hard "non-overridable, immediate hold: existing blocked-terms/emotion/motion-cue checks,
          plus age-gate bypass attempts, plus any attempt to render a paid-content
          interaction when no PSP is provisioned (enforces honest-default structurally, not
          just in the UI)"
   :soft "human-approval-eligible: borderline content-tier ambiguity (SFW vs paid-NSFW-tier)
          -- escalates via an interrupt-before-style pause per talent.operation's StateGraph
          shape, rather than a hard reject"
   :ledger "migrate from a bare atom to the Store protocol shape (MemStore for dev/test,
            Datomic-backed for production), per talent.store"}
  :nsfw_llm_serving
  {:if "only if/when the paid NSFW tier is greenlit"
   :what "reuse club-shinshi's pipeline: self-fine-tuned model served on Modal/vLLM, same
          hard-deny categories and system-prompt parity invariant -- do not re-decide LLM
          vendor/infra from scratch"}
  :livechat_oshikatsu
  {:what "broadcast-button-view stub (src/babiniku/ui/views.cljs:34-45) becomes the literal
          livechat entry point once ADR-2607051900's transport is implemented; tip/PPV
          prompts surface during an active livechat session"
   :framing "oshikatsu is the combination of subscription + tipping + livechat presence -- an
             operating pattern, not new technology"}
  :business_ledger_registration
  {:when "follow-up, not done by this ADR"
   :how "register net-babiniku.* entries in 90-docs/business/canvas-ledger.edn via the
         normal 70-tools/bmc advisor/gate tooling (append-only event log produced by that
         tool, not hand-edited), including a PSP-gate entry shaped like club-shinshi's frozen
         PSP/crypto-rail gate"}
  :legal_compliance
  {:inherited_unchanged_from "club-shinshi"
   :requirements ["特定商取引法 disclosure at go-live for the fiat paid tier"
                  "mandatory 18+ age gate for any NSFW-tier content"
                  "JP 刑法175 extraterritorial obscenity risk (same legal entity as
                   shinshi.club) + geo-block posture"
                  "UK AVSA / French LCEN / US KOSA regional NSFW controls"]}}

 :consequences
 {:no_revenue_yet "this ADR does not unlock revenue by itself -- actual PSP contracting is a
                   business/legal step, not a code change, exactly as it currently stands for
                   club-shinshi"
  :governor_complexity "materially more complex governor (HARD/SOFT tiers, human-approval
                        escalation, durable Store) -- real implementation work, not covered
                        here"
  :shared_pattern_not_code "net-babiniku and club-shinshi now share a monetization pattern
                            (not code); a future ADR could ask whether to extract a shared
                            PSP-adapter/billing library instead of duplicating the pattern
                            per product -- left open, not decided here"
  :crypto_deferred "USDC settlement remains deferred indefinitely, pending an etzhayyim-side
                    decision; not this ADR's call to make"
  :out_of_scope_followup "concrete adult PSP vendor selection, exact subscription/PPV/tip
                          price points, and the NSFW-tier go/no-go decision itself are
                          product/business decisions out of scope for this architecture ADR"}

 :alternatives
 [{:option "design NSFW-chat/monetization from scratch for net-babiniku, independent of
            club-shinshi"
   :rejected_because "club-shinshi already has a live, hard-won precedent (PSP research, LLM
                      fine-tune, legal disclosure requirements); duplicating that research
                      wastes effort and risks inconsistent compliance posture across two
                      gftdcojp adult-adjacent products"}
  {:option "use Stripe for the paid tier"
   :rejected_because "Stripe's ToS prohibits adult content; already established precedent in
                      this repo (club-shinshi ADR-2606010100 Goal section)"}
  {:option "implement crypto/USDC settlement directly in net-babiniku"
   :rejected_because "violates the standing vendor/etzhayyim centralization-axis boundary
                      (ADR-2605211950, ADR-2605172100); gftdcojp repos may not implement
                      on-chain settlement"}
  {:option "skip the HARD/SOFT governor upgrade, keep the flat review-turn check"
   :rejected_because "monetized NSFW content raises containment stakes past what a flat
                      allow/hold check can safely arbitrate (age-gate bypass, payment-adjacent
