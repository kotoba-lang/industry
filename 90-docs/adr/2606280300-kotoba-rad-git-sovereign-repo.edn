 :repo_identity
 {:rid "cid(canonical-cbor(repo.identity))"
  :genesis_doc_keys
  [:kotoba.rad/type :kotoba.rad/version :repo/name :repo/visibility :repo/default-branch
   :repo/git-hash-suite :repo/block-hash-suite :repo/delegates :repo/created-at]
  :event_kinds
  [:identity.update :ref.create :ref.update :ref.delete :object.publish :grant.add :grant.revoke :warrant.issue]}

 :ref_authorization
 {:rules
  ["actor DID must be current delegate at parent journal state"
   "actor capability must cover event kind"
   "event/prev must match current journal head unless explicitly importing a fork"
   "ref.update is fast-forward by default; force update requires policy"
   "ref/new must resolve to a Git commit in kotoba-git projection"
   "all reachable objects must have git oid <-> CID bridge"
   "private repos gossip only encrypted objects or availability proofs to non-recipient peers"]}

 :privacy
 {:principle "peer allow-list is availability/routing policy, not secrecy boundary"
  :replication_key "ciphertext-cid = hash(ciphertext)"
  :verification_metadata ["plaintext-cid" "git oid"]
  :access ["capability datom" "recipient set" "epoch key"]
  :revocation "epoch rotation; already distributed ciphertext is not erased"
  :current_crypto "X25519 HPKE-like wrapping available in kotoba-crypto"
  :pq_target {:kem [:x25519 :ml-kem-768]
              :signature [:ed25519 :ml-dsa :slh-dsa]
              :metadata [:alg :hash :sig :kem :key-id :recipient-set :epoch :created-at]}}

