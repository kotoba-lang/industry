         (:timing-attributes (vector :begin :end :dur))
         (:projection :split-caption-into-bounded-frame-segments)
         (:hidden-policy :omit-active-hidden-segment)
         (:malformed-timing-policy :reject-whole-import)))
   (:maturity (map (:kami-app-daw :逍遥) (:kami-app-nle :逍遥)))
   (:remaining-commercial-gates
