    (:daw (vector "third-party plugin SDK/isolation" "complete Mackie/HUI channel strips" "surround/Atmos"))
    (:nle (vector "continuous TTML animation and full layout fidelity" "external notification delivery" "translation memory" "OCIO/ICC/HDR"))))))
