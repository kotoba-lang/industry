  :adr/decision-summary "{:pattern \"sealed TelecomTradeAdvisor + independent :telecom-supply-chain-governor + append-only audit ledger, PRINCIPAL trading model with a telecom supply-chain/national-security sourcing regulatory backbone -- distinct in KIND from isic-4651's technical export-classification question ('does this item's classification require a license for this destination') vs. this actor's question ('is this equipment's manufacturer on a restricted list, and does that alone bar sale to this buyer category')\", :new-actor \"cloud-itonami-isic-4652\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-4652\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"4652\", :isic-name \"Wholesale of electronic and telecommunications equipment and parts\", :registry-promotion \"kotoba-lang/industry registry.edn id 4652: :maturity :spec (dead gftdcojp/cloud-itonami-G4652 placeholder URL) -> :implemented (real repo)\", :namespace \"telecomtrade\", :conjunctive-check {:check :covered-manufacturer-buyer-restricted, :shape \"CONJUNCTION of two structurally unrelated, independently-true-or-false facts (manufacturer on FCC Covered List/NDAA §889(f)(3)) × (buyer-category in restricted set) -- FOURTH distinct HARD-check shape in the fleet, alongside sequential classify-then-license (isic-4651) and two-independent-gates (isic-4653)\", :restricted-buyer-categories [:federal-agency :federal-contractor :fcc-usf-funded-carrier], :excluded-category :commercial-unrestricted, :proof-quadruple \"covered manufacturer + commercial-unrestricted buyer dispatches cleanly; non-covered manufacturer + federal-agency buyer also dispatches cleanly; covered manufacturer + federal-agency buyer holds; covered manufacturer + fcc-usf-funded-carrier buyer (a second restricted category) also holds -- proving neither fact alone triggers the hold\", :deliberate-scope-decision \"the real, later (Nov 2022/effective 2023-02-06) FCC rule banning ALL new Covered List equipment authorization regardless of buyer was independently verified as real but deliberately NOT implemented as a second HARD check, since it is buyer-blind and would blur the conjunctive shape this build demonstrates\"}, :governor-checks [{:check :no-spec-basis :severity :hard} {:check :evidence-incomplete :severity :hard} {:check :credit-uncleared :severity :hard} {:check :contract-missing :severity :hard} {:check :covered-manufacturer-buyer-restricted :severity :hard} {:check :counterparty-sanctions-flag-unresolved :severity :hard} {:check :already-dispatched :severity :hard} {:check :already-invoiced :severity :hard} {:check :high-stakes-actuation-gate :severity :soft-escalate}], :robotics {:value true, :uniform true, :rationale \"this vertical trades physical hardware exclusively (no deemed-export-style non-physical actuation like isic-4651), so a uniform :robotics true follows the fuel/metal-wholesale precedent rather than isic-4651's path-split reasoning\"}, :r0-scope {:jurisdiction-count 2, :note \"deliberately smaller than most siblings' typical 3-4 jurisdiction catalogs; JPN and EU were considered and explicitly excluded for insufficient citation confidence rather than padded to match a quota\", :source-catalog [\"USA: Secure and Trusted Communications Networks Act 2019 / FCC Covered List (fcc.gov/supplychain/coveredlist), current listed entities Huawei/ZTE/Hytera/Hikvision/Dahua/China Mobile/China Telecom/China Unicom/Pacific Networks -- exact match verified via WebSearch; NDAA FY2019 §889 Part A (effective 2019-08-13, federal agency procurement ban) / Part B (effective 2020-08-13, federal contractor/grant-recipient ban); FAR 52.204-25\" \"GBR: Telecommunications (Security) Act 2021 + the 2022 Huawei designated vendor direction (sent to 35 UK telecom operators, phased Huawei removal)\"], :citations-verified \"all citations independently re-verified via WebSearch at ADR-authoring time, including the exact FCC Covered List company roster and the Section 889 Part A/B effective dates, both confirmed precisely accurate\", :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as siblings\"}, :test-results {:unit-tests \"45 tests / 251 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end: the full proof quadruple plus other HARD holds and double-actuation guards\"}, :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. Only kotoba-lang/industry pin advanced in manifest/west.yml (nbb scripts/gen-west-manifest.cljs --entry industry, minimal diff)\"}"
