{:frontmatter
 {:id "adr-2606290900-kotoba-aiueos-key-lifecycle-revocation"
  :title "ADR-2606290900: key lifecycle and revocation layer separated from CID immutability"
  :status "proposed"
  :doc_type "adr"
  :topic "kotoba-aiueos-security"
  :authoritative true
  :last_verified "2026-06-29"
  :authoritative_for
  ["mature aiueos signer registry from flat list to versioned/expiring trust store"
   "define revocation as a registry layer distinct from CID immutability"
   "unify kotoba(custody epoch / CACAO exp) and aiueos(ed25519 signer) key lifecycle"
   "decision engine: signature_valid AND not_expired AND not_revoked AND issuer_trusted_for"]
  :related
  ["90-docs/adr/2606290930-kotoba-aiueos-capability-bridge.md"
   "orgs/com-junkawasaki/aiueos/SECURITY.md"
   "orgs/com-junkawasaki/aiueos/src/policy.rs"
   "orgs/com-junkawasaki/aiueos/src/signing.rs"
   "orgs/com-junkawasaki/kotoba/crates/kotoba-auth"
   "orgs/com-junkawasaki/kotoba/crates/kotoba-custody"]
  :supersedes []
  :superseded_by []}

 :gap
 {:source "audit 2026-06-29"
  :aiueos {:signer-registry "flat BTreeMap<id,hex-pubkey>"
           :missing [:expiry :revocation :rotation :chain]
           :security-md-quote "A compromised signer key can only be handled by editing the policy"}
  :kotoba {:present [:cacao-exp :custody-epoch-rotation :pre-revocation-warrant-gossipsub]
           :missing [:live-revocation-registry-over-grants-and-signers]}
  :principle "CID is immutable; a bad hash stays referenceable forever. Revocation needs a separate layer."}

 :decision
 {:trust-conditions [:signature-valid :not-expired :not-revoked :issuer-trusted-for]
  :revocation-semantics "non-adoption, not deletion; distributed ciphertext/artifact is not erased"
  :registry-target [:grant-cid :signer-key-id :artifact-cid :manifest-cid]
  :registry-entry [:target :reason :issuer-did :issued-at :epoch]
  :authority "issuer_trusted_for binds who may issue a revocation warrant"}

 :trust-decision
 {:formula "signature_valid && now in [valid_from,valid_until) && !revoked(id|cid) && issuer_trusted_for(resource)"
  :purpose "forbid anyone from signing graphA/write (no electronic graffiti)"}

 :maturity
 [{:stage :K0 :deliverable ["CACAO exp" "custody epoch rotation"] :status :implemented :where "kotoba"}
  {:stage :K1 :deliverable ["aiueos signer trust store" "valid_from/until" "status active|rotated|revoked"] :status :next}
  {:stage :K2 :deliverable ["revocation registry warrant list" "target=CID/key"] :status :next}
  {:stage :K3 :deliverable ["decision engine 3-condition check in aiueos broker + kotoba auth"] :status :after-k1-k2}
  {:stage :K4 :deliverable ["rotation chain" "delegation depth>2" "PQ signature migration"] :status :future}]

 :consequences
 ["aiueos broker authenticate()/verify_one adds registry lookup; CID-pinned registry is cacheable"
  "append-only registry authority itself must be scoped by issuer_trusted_for"
  "existing manifest signature ({id}\\n{wasm_sha256} over ed25519) is unchanged; trust store sits above it"]}
