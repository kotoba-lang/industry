(vector (map (:adr/authoritative_for (vector "new repo kotoba-lang/kami-gen-sdf-agent: LLM writes/edits a bounded CSG/SDF EDN program\n    (not raw geometry) targeting kotoba-lang/scad+sdf, compiled by kotoba-lang/mesher" "bounded propose/compile/render/critique loop (max N rounds, no unbounded retry),\n    offscreen render reuses kami-engine ADR-0047's wgpu reference-renderer pattern" "v0 produces a static prop-like mesh, no VRM/skeleton rig (no bone hierarchy from CSG)" "one of 4 sibling approaches built for a head-to-head comparison against the same\n    photoreal chibi-penguin-kigurumi reference image target")), (:adr/supersedes (vector)), (:adr/superseded_by (vector)), (:adr/topic "kami-gen-sdf-agent"), (:adr/related (vector "adr-2607051100" "adr-2607051120" "adr-2607051130")), (:adr/status "accepted"), (:adr/id "adr-2607051110-kami-gen-sdf-agent-procedural-mesh-pipeline"), (:adr/doc_type "adr"), (:adr/last_verified "2026-07-05"), (:adr/body "see 2607051110-kami-gen-sdf-agent-procedural-mesh-pipeline.edn"), (:adr/deciders (vector "Jun Kawasaki")), (:adr/date "2026-07-05"), (:db/id -1), (:adr/authoritative true), (:adr/title "ADR-2607051110: kotoba-lang/kami-gen-sdf-agent — LLM-authored SDF/CSG mesh pipeline (Approach 2 of 4)"), (:adr/source-format "edn")))