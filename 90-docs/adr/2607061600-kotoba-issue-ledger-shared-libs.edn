 :decision
 {:vocabulary {:issue ":kotoba.issue/*  -- 前提: cloud-itonami の :itonami.activity/* / manimani の Inbox item"
               :proposal ":kotoba.issue.proposal/*  -- 新規語彙。risk + rationale(=PRのdiff)。前提: :itonami.effect/*"
               :review ":kotoba.issue.review/*  -- verdict は approve/reject/request-changes(request-changesは新規)"
               :merge "gate/merge! -- 旧 execute-approved! の改称。承認済み proposal を handler で実行 + audit"
               :audit ":kotoba.issue.audit/*  -- ほぼ itonami の :itonami.audit/* のまま"}

  :libraries
  {:kotoba-issue-clj {:role "gate(状態機械) + run(plan/act/observe 純粋reducer)"
                      :modules ["kotoba.issue.store" "kotoba.issue.gate" "kotoba.issue.run"]
                      :deps "zero-dep, .cljc"
                      :tests "16 tests / 32 assertions, clojure -M:test green"}
   :kotoba-ledger-clj {:role "append-only projection(JSONL codec + run-status/supervisor-snapshot) + I/O backends"
                       :modules ["kotoba.ledger.core" "kotoba.ledger.file-git" "kotoba.ledger.kotobase"]
                       :deps "cheshire only, .cljc core + #?(:clj ...) file-git backend"
                       :tests "10 tests / 21 assertions, clojure -M:test green"}}

  :namespace-strategy
  {:principle "属性 namespace を強制統一しない -- cloud-itonami は :itonami.* を維持し境界でアダプト、manimani は :kotoba.issue.* を直接採用"
   :reason "cloud-itonami の schema は store/doctor/tests に生きているため migration 不要。IssueStore は kind をただの caller-chosen partition keyword として name-agnostic に設計"}

  :manimani-scope {:choice "全 policy を issue/PR 化(ユーザー選択)"
                   :risk-routing {:auto-merge [:todo :waiting :done :archive :snooze]
                                  :human-merge [:reply_llm :unsubscribe :investigate]}
                   :ux-note "auto-merge は同一 runner tick 内で発火するため体感速度は現状維持。ただし proposed/merged の2イベントとして監査には残る"}}

