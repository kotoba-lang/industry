[{:adr/authoritative_for ["cloud-itonami.vehicle-design-link の設計決定（activity/effect/audit facade、governance-onlyスコープの維持）" "vehicle-design参照をkotoba.plm.itemのschemaではなくeffect payloadに載せる判断" ":cost-estimate/:bom-diff の数値は呼び出し側のkotoba.plm.cost/rolled-costを根拠にする、という追補（2026-07-10）"], :adr/operational-note "{:lefthook-post-checkout-deploys-to-cloudflare-pages \"orgs/gftdcojp/cloud-itonami has a lefthook post-checkout hook that deploys main's current content to Cloudflare Pages on every `git checkout`. Branch-switching work in this repo triggers a production deploy each time; be aware when scripting multi-checkout workflows here.\"}", :adr/supersedes [], :adr/superseded_by [], :adr/topic "cloud-itonami-plm-integration", :adr/related ["adr-2607083400-vdesign-cad-cam-bridge"], :adr/status "accepted", :adr/id "adr-2607083500-cloud-itonami-vehicle-design-link", :adr/changes "[{:repo \"orgs/gftdcojp/cloud-itonami\", :files [\"src/cloud_itonami/vehicle_design_link.cljc\" \"test/cloud_itonami/vehicle_design_link_test.cljc\" \"test/cloud_itonami/test_runner.cljc\"], :summary \"design-review-activity(:plm lane) -> design-review-effect(:risk :financial) -> design-review-audit, bundled by concept->tx; mirrors cloud-itonami.mes. No new deps.edn dependency.\", :merge-commit \"989b69d80abe8ae74fa6e41e1cbd25d499dd8634\"} {:repo \"orgs/gftdcojp/cloud-itonami\", :files [\"test/cloud_itonami/vehicle_design_link_test.cljc\"], :summary \"Addendum (2026-07-10): cost-estimate-matches-a-real-plm-cost-rollup test replaces the original test's arbitrary :cost-estimate {:delta-usd 340.0} literal with real, traceable numbers (500->620, delta=120) transcribed from kotoba-lang/plm's own verified receipt-and-eco-revaluation test (test/kotoba/plm/thread_test.cljc). No new kotoba-lang/plm or Datomic Local dependency added to cloud-itonami's test suite -- numbers are transcribed, not computed in-repo.\", :merge-commit \"db37cb409bba2a0db0a0f5c592d2989c759eedd3\", :tests \"487 tests / 3237 assertions, no regressions\"}]", :adr/doc_type "adr", :adr/last_verified "2026-07-10", :adr/deciders ["Jun Kawasaki"], :adr/date "2026-07-08", :db/id -1, :adr/non-goals "{:no-engineering-dependency \"cloud-itonami does not depend on kotoba-lang/kami-engine-vehicle-designer, kotoba-lang/brep, or kotoba-lang/cnc. A released design's `concept` map is treated as opaque; bom-diff/cost-estimate are caller-supplied, never computed here.\", :no-shared-schema-change \"kotoba.plm.item's item/bom-edge (shared across every cloud-itonami domain, in a different repo, kotoba-lang/plm) were NOT modified -- the design reference lives in the effect's :payload instead.\", :no-real-plm-integration-in-test-suite \"Addendum 2026-07-10: a true end-to-end integration test (cloud-itonami actually calling kotoba.plm.cost/rolled-cost) was considered and rejected -- kotoba.plm.db/fresh-conn requires Datomic Local (JVM-only, :datomic/:test alias), which would add a heavy new dependency to this repo's test suite, against the thin-facade design philosophy. Reproducibility of the transcribed numbers is instead guaranteed by kotoba-lang/plm's own `clojure -M:test`.\"}", :adr/authoritative true, :adr/title "cloud-itonami に vehicle-design-link facade を追加する — 実CAD/CAM依存を持たず、released designをopaque payloadとしてBOM再見積りレビューに繋ぐ"}]