{:adr-id "2607142000"
 :title "cloud-itonami-isic-8422 Defence Procurement Actor"
 :date "2026-07-14"
 :status :accepted
 :scope [:cloud-itonami :isic-8422]
 :summary "Implement ISIC 8422 defence procurement actor with closed-allowlist scope boundaries and hard invariants"
 :context
 {:domain "Defence Procurement and Logistics Administration (ISIC Rev.5 8422)"
  :challenge "Design an actor for authentic procurement/logistics administration while enforcing absolute scope boundaries on weapons, personnel, and lethal operations"
  :threat-model ["Unintended scope creep (especially with LLM-advised actors)"
                 "Weapons/personnel proposals slipping through escalation chains"
                 "No clear audit trail of what proposals were held vs. escalated"]}
 :decision
 {:allowed-operations #{:register-vendor
                        :draft-procurement-request
                        :schedule-equipment-maintenance
                        :coordinate-logistics}
  :permanently-forbidden "weapons, personnel deployment, classified operations, lethal decisions"
  :hard-invariants ["vendor registration required"
                    "no direct actuation (only :propose effects)"
                    "scope boundary blocks (:op :unknown routes to :hold)"]
  :escalation-invariants ["procurement request drafting (human review)"
                          "budget commitment above 1000000 (financial threshold)"
                          "low advisor confidence (<0.6)"]
  :enforcement-layers {:advisor-layer "closed allowlist + zero-confidence rejection"
                       :governor-layer "hard violations always :hold, escalation invariants route to :request-approval"}}
 :implementation
 {:repository "https://github.com/cloud-itonami/cloud-itonami-isic-8422"
  :license "AGPL-3.0-or-later"
  :structure {:src ["defence/store.cljc" "defence/advisor.cljc" "defence/governor.cljc" "defence/actor.cljc"]
              :test ["defence/governor_test.clj" "defence/actor_test.clj"]
              :docs ["adr/0001-architecture.md" "business-model.md" "operator-guide.md" "README.md" "SECURITY.md"]}
  :test-status "12/12 passing (0 failures, 0 errors)"
  :maturity :implemented}
 :consequences
 {:positive ["Scope explicitly defined and reviewed"
             "LLM safety via structured allowlist"
             "Full auditability of all proposals (committed or held)"
             "Clear human-sign-off boundary"]
  :negative ["Strictness requires code review for new operations"
             "LLM system prompt must stay in sync with advisor logic"]}
 :registry-entry {:isic "8422"
                  :name "Defence Procurement and Logistics Administration"
                  :repo "cloud-itonami/cloud-itonami-isic-8422"
                  :maturity :implemented
                  :governor :defence-procurement-governor}}
