                  :prs ["com-junkawasaki/aiueos#5 surface 設計+ADR-0007"
                        "com-junkawasaki/aiueos#6 computer-virtual provider(gate+監査)"
                        "com-junkawasaki/aiueos#7 実 backing(仮想スクリーン daemon + Xvfb Dockerfile)"
                        "com-junkawasaki/aiueos#8 computer-backing bridge(aiueos run→実ブラウザ)"
                        "com-junkawasaki/aiueos#9 Xvfb コンテナ実証(完全 Linux 隔離)"
                        "com-junkawasaki/aiueos#10 隔離コンテナを既定 backing 化 + ADR-0007 accepted"]
                  :default-backing "computer-virtual (隔離 Linux コンテナ)。computer-use=CLJ/aiueos を使う時はコンテナが基本。headless Playwright は dev 機の便宜であって既定ではない。"
                  :proof "aiueos run drive.edn --surface computer-virtual (AIUEOS_COMPUTER_BACKING=run.sh) が https://isekai.network/gftd/orbs を Linux コンテナ内で駆動し ./out にフレーム捕捉。host 画面ゼロ。"}

 :decision {:mechanism "computer-use を aiueos の `computer` surface family として実施。隔離は設定の約束でなく構造的保証: host の実 HID(pointer/host・keyboard/host・display/host)に provider を offer しない → 呼べば unresolved-capability で loud denial。合成入力は仮想 surface(Xvfb/microVM)にのみ解決。admit が trust を :ai-generated に floor、:host-input forbid、:net-allow 減衰、全操作監査が多層化。"
            :canonical {:aiueos-adr "0007-virtual-computer-surface" :pr "com-junkawasaki/aiueos#5 (merged to main)"}}

 :surfaces [{:id "computer-virtual" :default true :backing "Linux + Xvfb + Chrome (OrbStack/Lima 隔離コンテナ)" :host-isolated true  :gpu "software/WebGL2" :use "computer-use の既定 / headless CI / UX QA"}
            {:id "computer-vm"      :backing "Parallels/QEMU microVM (virtio-gpu)"   :host-isolated true  :gpu "near-native WebGPU" :use "GPU 正確な描画検証"}
            {:id "computer-host"    :backing "host WindowServer (従来 macos-computer-use)" :host-isolated false :gpu "native" :use "署名必須の opt-in 脱出口"}]

 :principles {:env-secrets "deny-by-default。host env/key/1Password/Keychain は wasm に ambient 継承しない。必要な秘密は明示・scoped・監査つき capability(:net-allow で net/fetch を origin 限定したのと同型。secrets/get を当該 component にだけ grant、実値は host 側 provider=TCB が保持)。"
              :wasm-vs-container "component=Wasm(wasmtime, fuel/mem 制限。exec/process 能力は deny-by-default で無くコンテナを起動できない)。コンテナ/microVM は surface の backing(provider)=host 側 TCB。wasm 隔離 と コンテナ/VM 隔離が二重合成。"}

 :consequences {:positive ["computer-use の自由度を保ちつつ host の kbd/mouse/display を奪わない"
                           "隔離が構造的(host HID は un-offered 能力で同一 gate で deny)"
                           "危険な computer-host は削除でなく署名・明示・監査つき脱出口に格下げ"
                           "同一 component が CI(virtual)と GPU 正確(vm)で manifest 無改変に動く"]
                :negative ["provider の host 側コード(Xvfb/X 入力 binding・microVM 入力 agent・WindowServer adapter)は TCB で監査対象"
                           "computer-virtual の WebGPU は software/WebGL2 fallback。pixel 厳密検証は computer-vm"]}

