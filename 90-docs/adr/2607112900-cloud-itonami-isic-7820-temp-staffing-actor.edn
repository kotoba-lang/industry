  :adr/decision-summary "{:pattern \"sealed TempStaffing-LLM + independent StaffingGovernor + append-only audit ledger, an EMPLOYER-OF-RECORD dispatch model distinct from isic-7810's one-time placement-fee agency model (agency never becomes employer)\", :new-actor \"cloud-itonami-isic-7820\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-7820\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"7820\", :isic-name \"Temporary employment agency activities\", :registry-promotion \"kotoba-lang/industry registry.edn id 7820: :maturity :spec -> :implemented, 6th promotion after M6910/isic-8291/isic-4690/isic-4610/isic-6311\", :namespace \"staffing\", :governor-checks [{:check :rbac :severity :hard} {:check :eligibility-gate :severity :hard :note \"worker eligibility/qualification not verified -> reject\"} {:check :tenure-limit-gate :severity :hard :note \"new -- no analog in other cloud-itonami actors; continuous dispatch tenure of one worker at one client exceeding a real statutory cap is rejected: JPN 労働者派遣法 3yr, DEU AÜG 18mo, GBR Agency Workers Regulations 2010 12wk (equal-treatment trigger); USA deliberately has no federal cap and is not covered\"} {:check :wage-compliance-gate :severity :hard :note \"new -- effective wage below an operator-maintained statutory wage floor is rejected; no hardcoded currency amounts, always tied to a jurisdiction's legal basis\"} {:check :licensed-disclosure :severity :hard} {:check :confidence-floor :severity :soft-escalate :note \"confidence < 0.6\"} {:check :hazardous-duty-gate :severity :soft-escalate :note \"placement into hazardous duty always requires human approval\"} {:check :dispute-request :severity :soft-escalate-unconditional :note \"a labor dispute never auto-resolves at any confidence, any phase\"}], :deliberately-absent {:check :one-time-placement-fee-checks, :rationale \"this actor bears ongoing employer-of-record responsibility (the dispatch agency IS the legal employer); isic-7810's one-time-fee placement-agency checks do not apply to this structurally different liability model\"}, :actuation-invariant \"dispute-request never a member of any phase's :auto set at any phase; default-phase set to 1 (assisted, no auto-commit) from initial implementation, applying the fail-open fix already found this session in the shared talent.phase template (gftd-talent-actor) and cloud-itonami-isic-6311's own phase.cljc, rather than retrofitting it later\", :deps-fix \"implemented directly with the correct io.github.kotoba-lang/langgraph + langchain :local/root paths from the start (this session already discovered and fixed the stale com-junkawasaki/langgraph-clj naming in cloud-itonami-isic-6311; this actor never had the bug)\", :test-results {:unit-tests \"41 tests / 166 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end, all 7 scenarios fire correctly\"}, :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. kotoba-lang/industry pin already advanced in manifest/west.yml by a concurrent session by the time this ADR landed (revision 8f2fda42ca8b281056af01a6c16cc61c36dac8de, confirmed via GitHub API compare to be 8 commits ahead of / a clean descendant of the isic-7820 registry commit 15b21f27f18d7089689ba89f92347d6ce93905c6 -- no further west.yml edit needed from this ADR)\"}"
  :adr/authoritative true
