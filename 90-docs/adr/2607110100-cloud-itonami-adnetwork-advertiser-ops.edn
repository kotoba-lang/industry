{:frontmatter
 {:id "adr-2607110100-cloud-itonami-adnetwork-advertiser-ops"
  :title "ADR-2607110100: cloud-itonami advertiser-ops actor — campaign governance for the first-party ad network (ADR-2607093500 follow-up #3)"
  :status "accepted"
  :doc_type "adr"
  :topic "cloud-itonami-adnetwork-advertiser-ops"
  :authoritative true
  :last_verified "2026-07-10"
  :authoritative_for
  ["cloud-itonami.adnetwork is the propose→govern→commit advertiser-ops actor for the
    first-party ad network (campaign create/pause/retarget/budget-topup)"
   "cloud-itonami.advertising-facts is the per-jurisdiction spec-basis catalog (ported from
    cloud-itonami-isic-7310) plus the smartphone/web/app/video/real ad-channel taxonomy"
   "campaigns->CAMPAIGNS_JSON is the integration seam projecting governor-approved campaigns into
    gftdcojp/adserver's expected CAMPAIGNS_JSON feed shape"
   "advertiser lead-gen/CRM reuses cloud-itonami.marketing/propose-outreach! and
    cloud-itonami.m365/crm->tx's 2-entity shape, no reimplementation"
   "real production go-live (real treasury address, real advertiser onboarding, real publisher
    ad_slot wiring) is explicitly deferred, not declared by this build"]
  :related
  ["90-docs/adr/2607093500-adnet-first-party-ad-network.md"
   "orgs/cloud-itonami/cloud-itonami-isic-7310/docs/adr/0001-architecture.md"
   "90-docs/adr/2606130200-shinshi-h1-h2-validation-plan.md"]
  :supersedes []
  :superseded_by []}

 :problem
 {:source "session request 2026-07-10: design a globally-covering adnetwork ADR + cloud-itonami
           design/real-operation, integrated with cloud-itonami's sales/marketing/CRM functions"
  :investigated
  ["ADR-2607093500 (2026-07-09) already decided this exact shape; as of this session kotoba-lang/adnet
    (public) and gftdcojp/adserver (private) were both already landed (pushed same day), but the
    third follow-up -- the cloud-itonami advertiser-ops actor itself -- had zero code: grep of
    orgs/gftdcojp/cloud-itonami for adnet/advertis* found nothing"
   "gftdcojp/adserver's own README states campaigns 'arrive here as CAMPAIGNS_JSON' with no
    supplier wired yet -- a concrete, scoped gap"
   "cloud-itonami-isic-7310 (a separate, unrelated GitHub org's OSS advertising-agency blueprint)
    already has a per-jurisdiction spec-basis catalog and a MAXIMUM-ceiling budget check that
    directly transplant onto this problem, honestly scoped (4 jurisdictions, growable)"
   "gftdcojp/cloud-itonami already has a working marketing/CRM/audit pipeline
    (cloud-itonami.marketing, cloud-itonami.m365/crm->tx, cloud-itonami.activity,
    cloud-itonami.approval) any new vertical can plug into directly"]
  :risk "spinning up a new cloud-itonami-isic-<code> OSS-blueprint child repo would duplicate/
         diverge from the already-approved, already-half-built ADR-2607093500 architecture and
         would not supply adserver's missing CAMPAIGNS_JSON feed; real-money go-live claimed
         without verified operational wiring would violate this repo's own dated-addendum
         precedent for declaring production live"}

 :decision
 {:actor
  {:ns "cloud-itonami.adnetwork (gftdcojp/cloud-itonami, src/cloud_itonami/adnetwork.cljc)"
   :ops ["propose-campaign-create!" "propose-campaign-pause!" "propose-targeting-update!"
         "propose-budget-topup!" "propose-advertiser-outreach! (delegates to
          cloud-itonami.marketing/propose-outreach!)"]
   :governor "governor-violations: a dedicated pure Campaign Governor, NOT routed through
              business_governor.cljc's shared kind-enum multimethod (kernels/substance.cljc's
              closed 0..5 kind enum, mirrored in .kotoba + compiled to wasm/kernels/substance.wasm,
              is scoped to small generic proposals) -- same reasoning as cloud-itonami-isic-7310's
              own dedicated advertising.governor being separate from any shared dispatcher"
   :hard-holds ["campaign-budget-exceeds-advertiser-authorized? (MAXIMUM-ceiling vs the
                 advertiser's own recorded budget)"
                "tier-mismatch? (adult/general segregation, club-shinshi's tier concept)"
                "unresolved-content-risk? (self-reported flag, evaluated unconditionally)"
                "missing-jurisdiction-spec-basis? (advertising-facts/spec-basis)"
                "unknown-channels-requested (advertising-facts/ad-channels)"]
   :risk-tags {:campaign-create :external-send :campaign-pause :external-send
               :targeting-update :external-send :budget-topup :financial}}
  :facts
  {:ns "cloud-itonami.advertising-facts (new)"
   :catalog "ported verbatim from cloud-itonami-isic-7310/src/advertising/facts.cljc: JPN/USA/GBR/DEU,
             each citing a real official source; never fabricated, extend one verified jurisdiction
             at a time"
   :ad-channels "new 5-way taxonomy #{:smartphone :web :app :video :real}, cloud-itonami's own
                 governance-side validation layered on adnet.core's free-form :targeting
                 :formats/:placements strings -- adnet.core itself not modified"}
  :crm-integration
  {:advertiser->tx "mirrors cloud-itonami.m365/crm->tx's exact 2-entity {activity effect} shape"
   :lead-gen "propose-advertiser-outreach! delegates straight to the existing
              cloud-itonami.marketing/propose-outreach!, no reimplementation"}
  :adserver-seam
  {:fn "campaigns->CAMPAIGNS_JSON / campaign->CAMPAIGNS_JSON-entry"
   :filter "only :approved/:executed effect status -- a still-:proposed campaign never reaches the
            feed"
   :shape "exact string-keyed shape gftdcojp/adserver's README documents for CAMPAIGNS_JSON"
   :boundary "publishing the projection to a live Worker secret remains a deploy-time operational
              step outside this ns, same boundary discipline as cloud-itonami.marketing"}
  :real-production-gate
  "explicitly deferred: no real ADNET_TREASURY_ADDR, no real advertiser onboarding, no real
   publisher ad_slot wiring in this build. Declaring the pipeline live follows this repo's own
   precedent (ADR-2606130200's dated, verified-production addendum), a separate explicitly-
   confirmed step after real operational wiring is verified."}

 :consequences
 {:closes "ADR-2607093500's third follow-up; gftdcojp/adserver's CAMPAIGNS_JSON feed now has an
           intended supplier"
  :precedent "cloud-itonami-isic-7310's advertising-agency governance lineage now has a second
              sibling application inside gftdcojp/cloud-itonami itself, proving the pattern
              generalizes from 'OSS blueprint for a licensed agency' to 'in-house first-party ad
              network governance'"
  :no-changes-to ["kotoba-lang/adnet" "gftdcojp/adserver" "business_governor.cljc"
                   "kernels/substance.cljc" "wasm/kernels/*.wasm"]
  :coverage-honesty "4-jurisdiction spec-basis coverage is a deliberate starting point, not a
                     global-coverage claim -- advertising-facts/coverage reports this honestly"
  :open-followups ["real advertiser onboarding" "real ADNET_TREASURY_ADDR wiring"
                    "real publisher ad_slot integration (shinshi/isekai)" "RAD identity
                     registration if this vertical is later split into its own actor repo"]
  :test-status "25 new tests (adnetwork_test.cljc + advertising_facts_test.cljc); full suite 631
                JVM tests / 5083 assertions and 246 portable-cljs tests / 2353 assertions pass;
                clj-kondo clean"}

 :alternatives
 [{:option "new cloud-itonami-isic-<code> OSS-blueprint child repo under the cloud-itonami GitHub org"
   :rejected_because "would duplicate/diverge from the already-approved, already-half-built
                      ADR-2607093500 architecture and would not supply adserver's missing
                      CAMPAIGNS_JSON feed; that fleet's pattern is a generic forkable blueprint for
                      a third-party licensed operator, not this company's own first-party network"}
  {:option "route campaign proposals through business_governor.cljc's shared multimethod, extending
            kernels/substance.cljc's closed kind enum (+ .kotoba twin + wasm regen)"
   :rejected_because "a much deeper, riskier change to a shared, wasm-compiled kernel other domains
                      depend on, for a proposal shape this repo's own precedent (isic-7310's
                      dedicated advertising.governor) already shows belongs in its own module"}
  {:option "declare the ad network 'live' as part of this build"
   :rejected_because "this repo's own precedent (club-shinshi ADR-2606130200) is a dated, verified-
                      production addendum after real operational wiring, not a code-existence claim"}]}
