(vector (map (:db/id -1)
  (:adr/id "adr-2607195400-kami-stereo-capability-container")
  (:adr/title "KAMI adds stereo delivery and capability-honest MP4 export")
  (:adr/date "2026-07-19")
  (:adr/status "accepted")
  (:adr/authoritative true)
  (:adr/topic "kotoba-lang-media-authoring")
  (:adr/supersedes (vector "adr-2607195300-kami-stem-interchange-display-color"))
  (:adr/decision
  (map (:daw (map (:pan-authority :track/pan)
         (:pan-range (vector -1.0 1.0))
         (:panner-node :stereo-panner-node)
         (:render-channel-count 2)
         (:wav-format (map (:encoding :pcm-s16le) (:sample-rate 44100) (:channel-layout :stereo) (:interleaving :frame-major)))
         (:loudness-channel-policy :sum-k-weighted-channel-powers)
         (:true-peak-channel-policy :maximum-per-channel-oversampled-peak)
         (:consumers (vector :realtime-playback :master-wav :normalized-master-wav :track-stems :stem-bundle))))
   (:nle (map (:profile-authority :project/export-profile)
         (:profile-fields (vector :profile/container :profile/mimes :profile/video-bps :profile/audio-bps :profile/extension))
         (:supported-containers (vector :webm :mp4))
         (:capability-check :media-recorder-is-type-supported)
         (:unsupported-policy :disable-and-refuse)
         (:fallback-policy :none)
         (:artifact-policy :actual-mime-and-matching-extension)
         (:verified-codecs (map (:webm (vector :vp8 :vp9 :opus)) (:mp4 (vector :h264 :aac))))))
   (:maturity (map (:kami-app-daw :逍遥) (:kami-app-nle :逍遥)))
   (:remaining-commercial-gates
   (map (:shared (vector "persistent directory grants" "streaming package I/O above 512 MiB"))
    (:daw (vector "plugin hosting" "certified broadcast loudness conformance" "surround/Atmos buses"))
    (:nle (vector "OCIO/ICC/HDR and container color tagging" "certified broadcast conformance" "persistent/background proxy jobs" "MOV/MXF/IMF delivery" "explicit hardware encoder control"))))))
  (:adr/implementation
  (map (:daw-commits (vector "fb2eb2c5278afb44d5b7ae910870d55750a038cc"))
   (:nle-commits (vector "294980300b11119efa3f1288e00e451b938255d8"))
   (:pull-requests (vector "kotoba-lang/kami-app-daw#11" "kotoba-lang/kami-app-nle#11"))
   (:evidence
   (vector "DAW passes 19 tests and 74 assertions; NLE passes 20 tests and 83 assertions, including pan bounds and MP4 profile filename/MIME authority."
    "Both shadow-cljs production releases completed through the repository resource guard with zero compiler warnings."
    "DAW Chrome persisted hard-left drums and hard-right synth pan, then downloaded the complete stereo stem bundle."
    "External ffprobe verified all three stems as two-channel, exactly 5.000 seconds and 882044 bytes; the manifest declared stereo for every track."
    "External ffmpeg astats measured drums channel 1 at -20.16 dB RMS and channel 2 at negative infinity, while synth channel 1 was negative infinity and channel 2 was -29.96 dB RMS."
    "Chrome reported support for all declared H.264/AAC MP4 MIME candidates, enabled the MP4 option and downloaded the exact filename kami-nle-master.mp4."
    "External ffprobe identified H.264 video, AAC audio, the MP4 container and 2.021 seconds duration; no WebM fallback occurred."
    "Automated Chrome contexts and local HTTP servers were closed after verification."
    "Both application pull requests were reviewed and squash-merged."
    "The prescribed freshness and ledger verifier scripts are absent from this root revision; direct EDN parsing verified accepted status, supersedes authority, stereo render count and unsupported-profile policy."))))
  (:adr/consequences
  (vector "DAW panning is audible and export-reproducible rather than a UI-only value."
   "Stereo master/stem WAV files preserve left/right placement and use channel-aware loudness and peak analysis."
   "NLE never labels a fallback WebM as the requested MP4 or silently changes codecs."
   "MP4 availability is browser capability-dependent and therefore visible before export."))
  (:adr/source-format "edn")))
