  :adr/decision-summary "{:pattern \"sealed PharmacyOrder-LLM + independent PharmacyGovernor + append-only audit ledger, a governed-dispensing model where the LLM only drafts and a separate governor + licensed-pharmacist review authorizes every dispense/refill/disclosure/dispute\", :new-actor \"cloud-itonami-isic-4772\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-4772\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"4772\", :isic-name \"Retail sale of pharmaceutical and medical goods, cosmetic and toilet articles\", :registry-promotion \"kotoba-lang/industry registry.edn id 4772: :maturity :spec (dead gftdcojp/cloud-itonami-G4772 placeholder URL) -> :implemented (real repo)\", :namespace \"pharmacy\", :governor-checks [{:check :rbac :severity :hard} {:check :prescription-verification-gate :severity :hard :note \"prescription exists, verified, unexpired, and (refills only) has an available refill\"} {:check :restricted-quantity-gate :severity :hard :note \"new -- no analog in other cloud-itonami actors; enforces item per-fill quantity ceiling, Schedule II never-refillable rule (structural, fires regardless of stored refills-remaining -- defense in depth against a data-entry bypass), and restricted-OTC (pseudoephedrine-class) age/quantity limits\"} {:check :source-provenance-gate :severity :hard :note \"source :class must be in pharmacy.facts/allowed-source-classes; :licensed-erx-network additionally requires an ACTIVE network\"} {:check :licensed-disclosure :severity :hard} {:check :confidence-floor :severity :soft-escalate :note \"confidence < 0.6\"} {:check :interaction-flag-gate :severity :soft-escalate :note \"new -- no analog in other cloud-itonami actors; patient allergy intersects item interacts-with -> always escalate to a licensed pharmacist\"} {:check :dispute-request :severity :soft-escalate-unconditional :note \"a dispensing dispute never auto-resolves at any confidence, any phase\"}], :actuation-invariant \":rx/dispense and :rx/refill are STRUCTURALLY excluded from every phase's :auto set, including phase 3 -- unlike sibling actors where a governor-clean write becomes auto-eligible at max rollout maturity, prescription dispensing requires a licensed pharmacist's legal sign-off regardless of automated-check cleanliness; only :otc/dispense (unrestricted/clean-restricted OTC) is phase-3-auto-eligible. default-phase set to 1 (assisted, conservative) from initial implementation, applying the fail-open fix already established in cloud-itonami-isic-7820's phase.cljc rather than retrofitting it later\", :r0-scope {:source-catalog [\"FDA National Drug Code (NDC) Directory (public API, free, official) -- grounds real/correctly-classified drug identity and Rx/OTC status\" \"DEA Controlled Substance Schedules (public reference, free, official) -- grounds the schedule (II-V) assigned to a controlled item\" \"NPPES NPI Registry (public API, free, official) -- grounds prescriber identity/license validity\"], :structural-class \"licensed-erx-network -- the prescription-exists fact itself requires an operator-registered ACTIVE e-prescribing/PDMP network integration, no free public source can grant it (same operator-supplies-own-licensed-integration boundary as cloud-itonami-isic-6311's licensed-operator-feed / kotoba-lang/securities)\", :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as siblings\"}, :robotics {:value false, :key-present false, :rationale \"this actor only decides whether a dispense/refill is allowed and records that it happened -- no order-fulfillment, shipping, or payment logistics exist inside the actor's boundary\"}, :test-results {:unit-tests \"39 tests / 138 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end: op1 clean OTC dispense -> commit, op2 unsourced OTC -> hold (source-provenance-gate), op3 leaky Rx (missing network-id) -> hold (source-provenance-gate), op4 expired prescription -> hold (prescription-verification-gate), op5 refill over per-fill cap -> hold (restricted-quantity-gate), op6 Schedule II refill with nonzero stored refills-remaining -> hold (restricted-quantity-gate, structural defense proven), op7 restricted OTC to a minor -> hold (restricted-quantity-gate), op8 allergy-interaction Rx dispense -> escalate -> approve -> commit, op9 over-tier disclosure -> hold (licensed-disclosure), op10 dispensing dispute -> escalate -> approve -> commit\"}, :bug-found-and-fixed \"DatomicStore's commit-record! re-encodes a merged patch through a fixed-attribute prescription->tx fn; a correction patch citing a field NOT in the declared Datomic schema (originally :disputed?/:quantity-dispensed, neither real fields) silently drops on the Datomic backend while MemStore's plain merge tolerates it -- caught by store_contract_test.clj's parity test, fixed by redesigning the dispute example to patch an existing schema field (:verified?) instead; a lesson generalizable to other dossier-style correction-apply patterns in the fleet\", :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. kotoba-lang/industry pin already advanced in manifest/west.yml by a concurrent session via direct GitHub API edit at ADR-authoring time, because the nbb-migrated gen-west-manifest.cljs was transiently broken (missing clojure.java.shell namespace, tracked separately) -- no further west.yml edit needed from this ADR\"}"
  :adr/authoritative true
