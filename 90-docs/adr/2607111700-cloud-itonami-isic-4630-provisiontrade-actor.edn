  :adr/decision-summary "{:pattern \"sealed ProvisionTradeAdvisor + independent :provision-trading-governor + append-only audit ledger, PRINCIPAL trading model (downstream/processed goods, following isic-4671/4690/4620) with a food-safety + alcohol-excise + tobacco-excise regulatory backbone\", :new-actor \"cloud-itonami-isic-4630\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-4630\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"4630\", :isic-name \"Wholesale of food, beverages and tobacco\", :registry-promotion \"kotoba-lang/industry registry.edn id 4630: :maturity :spec (dead gftdcojp/cloud-itonami-G4630 placeholder URL) -> :implemented (real repo)\", :namespace \"provisiontrade\", :regulatory-class-mapping {:rationale \"generalizes isic-4620's 1:1 kind-split to a many:1 category->regulatory-class mapping: food and beverage-non-alcoholic share ONE food-safety check (same statute in every seeded jurisdiction, no separate excise regime), while beverage-alcoholic and tobacco each get their OWN excise-specific check\", :classes [{:class :food-safety, :covers [:food :beverage-non-alcoholic], :check :food-safety-certificate-missing} {:class :alcohol-excise, :covers [:beverage-alcoholic], :check :alcohol-excise-license-missing} {:class :tobacco-excise, :covers [:tobacco], :check :tobacco-excise-age-verification-missing, :note \"folds two real sub-requirements (excise registration AND age-verification) into one named rule since either missing makes dispatch unsafe\"}], :rejected-alternatives [\"one generic compliance-certificate-missing check (loses which regime failed)\" \"four category-specific checks (food and non-alcoholic-beverage would be duplicate logic under the identical statute)\"]}, :governor-checks [{:check :no-spec-basis :severity :hard} {:check :evidence-incomplete :severity :hard} {:check :credit-uncleared :severity :hard} {:check :contract-missing :severity :hard} {:check :food-safety-certificate-missing :severity :hard} {:check :alcohol-excise-license-missing :severity :hard} {:check :tobacco-excise-age-verification-missing :severity :hard} {:check :counterparty-sanctions-flag-unresolved :severity :hard} {:check :already-dispatched :severity :hard} {:check :already-invoiced :severity :hard} {:check :high-stakes-actuation-gate :severity :soft-escalate}], :robotics {:value true, :rationale \"real food/beverage/tobacco distribution centers run AS/RS + robotic case-picking/palletizing/AGV forklifts at the wholesaler's own dock (the :delivery/dispatch point), explicitly distinct from the out-of-scope long-haul carrier leg -- same per-domain reasoning process as isic-4620, not copied from either true/false precedent\"}, :r0-scope {:source-catalog [\"JPN 食品衛生法/MHLW, 酒税法/NTA, たばこ事業法/MOF\" \"USA Food Safety Modernization Act (Pub. L. 111-353)/FDA, Federal Alcohol Administration Act/TTB, Family Smoking Prevention and Tobacco Control Act (Pub. L. 111-31)/FDA CTP+TTB\" \"GBR Food Safety Act 1990/FSA, Finance (No. 2) Act 2023 Part 2 (Alcohol Duty)/HMRC [CORRECTED at ADR-authoring time from the repealed Alcoholic Liquor Duties Act 1979 -- repealed 2023-08-01 by s.113(1) of that same Act], Tobacco Products Duty Act 1979/HMRC+Trading Standards\" \"EU (DEU representative) Regulation (EC) No 178/2002 (General Food Law)/EFSA, Directive 92/83/EEC (alcohol excise), Directive 2011/64/EU (tobacco excise)\"], :citations-verified \"all headline statutes independently re-verified via WebSearch at ADR-authoring time; ONE correction made (UK alcohol duty citation, see above); US Code pin-cites and UK/DEU implementing-legislation exact names remain flagged by the implementing agent as lower-confidence\", :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as siblings\"}, :test-results {:unit-tests \"47 tests / 259 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end: 4 clean lifecycles (food/non-alcoholic-beverage/alcoholic-beverage/tobacco) plus 8 distinct HARD-hold scenarios with correctly differentiated ledger rule keywords\"}, :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. Only kotoba-lang/industry pin advanced in manifest/west.yml (--entry industry, minimal diff)\"}"
