 :addendum-2026-07-05-speed-parallelism-context
 {:trigger "real Claude Code request measured 65561 tokens, 25 over the then-current 65536 ctx -> exceed_context_size_error"

  :single-stream-perspective
  {:this-fleet-tok-s 61.5
   :hosted-comparison [{:model "Claude Sonnet 5 (Max Effort)" :tok-s 72.0 :source "artificialanalysis.ai 2026-07"}]
   :verdict "a consumer APU with no discrete GPU lands in the same tok/s range as a hosted flagship model served from a datacenter GPU cluster — 300 tok/s was never a realistic single-stream target for ANY mainstream hosted model, let alone this hardware"
   :bottleneck "memory bandwidth: decode reads ~3B active MoE params (Q4_K_M) from LPDDR5x once per token"}

  :parallelism-measured
  {:method "N concurrent /v1/chat/completions requests, wall-clock aggregate = sum(completion_tokens)/wall_seconds"
   :results [{:n 1 :aggregate-tok-s 53.8}
             {:n 2 :aggregate-tok-s 77.1}
             {:n 4 :aggregate-tok-s 107.8}
             {:n 6 :aggregate-tok-s 121.2 :note "peak"}
             {:n 8 :aggregate-tok-s 74.6 :note "regressed"}]
   :caveat "raises AGGREGATE throughput only via continuous batching; a single Claude Code conversation (one request in flight) still sees ~61.5 tok/s regardless of --parallel"}

  :context-ceiling
  {:landed 262144
   :reason "qwen-agentworld-35b-a3b's own GGUF-declared native training context (qwen35moe.context_length) — confirmed by direct testing to be the real hard ceiling on the current llama-server binary"
   :architecture "hybrid Gated-DeltaNet(SSM)/Gated-Attention, full_attention_interval=4 — only 10/40 layers need real KV cache (5GB f16 at 262144); the other 30 use a FIXED ~63MB recurrent state independent of context length"
   :1m-yarn-attempt
   {:flags-tried "--rope-scaling yarn --yarn-orig-ctx 262144 --rope-scale 4 -c 1010000"
    :result "llama-server capped back to 262144 regardless"
    :root-cause "known upstream bug: server hard-caps -c to n_ctx_train unconditionally, ignoring explicit YaRN override flags"
    :github-issues ["ggml-org/llama.cpp#22140 (closed, not planned)" "ggml-org/llama.cpp#17459 (open, unconfirmed)"]
    :real-fix "patch tools/server source + rebuild from source — no CLI-flag workaround exists on official release binaries"
    :hypothetical-memory-at-1m {:kv-f16-gib 19.26 :kv-q8_0-gib 9.63 :model-gib 20.6
                                 :verdict "f16 combined ~40GB (tight vs ~46GB unified RAM); q8_0 combined ~30GB (comfortable) — confirmed q8_0/q8_0 --cache-type-k/v loads+serves correctly on this Vulkan backend at unchanged speed, so this is real future headroom IF the server cap is ever lifted"}
    :status "not attempted (source rebuild); logged as follow-up"}}

