    {:bug "non-streaming path treated any parseable upstream JSON (incl. {\"error\":...}) as a valid completion"
     :symptom "Claude Code: malformed response, no diagnostic info"
     :fix "worker.cljs checks for :error key, returns proper Anthropic error envelope"}
    {:bug ":infer/ctx never set, llama-server defaulted to 4096"
     :symptom "Claude Code always sends ~89 tool defs (~48K tokens) -> exceed_context_size_error on every request"
