(vector (map (:db/id -1)
  (:adr/id "2607189100")
 (:adr/title "Public runtime and reusable library responsibility boundary")
 (:adr/status :accepted)
 (:adr/date "2026-07-18")
 (:adr/deciders (vector "Jun Kawasaki"))
 (:adr/context
 "Public Cloudflare ownership had leaked into kotoba-lang deploy shells, while product implementations were copied across monoliths, worktrees and renamed repositories. This made route, secret, migration and receipt authority ambiguous.")
 (:adr/decision
 (map (:organization-boundary
  (map (:kotoba-lang (set :reusable-library :protocol :codec :port :test-harness :migration-reader))
   (:gftdcojp (set :public-hostname :deploy-shell :cloud-binding :secret-reference :migration-runbook :rollback :operational-receipt))))
  (:kotobase
  (map (:public-owner "gftdcojp/net-kotobase")
   (:retired-deployers (vector "kotoba-lang/kotobase-protocols-worker"))
   (:archived-predecessor "kotoba-lang/kotobase-cljc-worker")
   (:legacy-migration-owner "gftdcojp/net-kotobase/migrations/cljc-worker-v2-v3")))
  (:product-snapshots
  (map (:canonical "standalone gftdcojp product repository")
   (:historical "ai-gftd-apps-gftdcojp/60-apps")
   (:rule :no-deploy-or-product-fix-in-historical-copy)))
  (:aozora
  (map (:owner "gftdcojp/app-aozora")
   (:app-aozora-boundary :retired-local-worktree)))
  (:murakumo
  (map (:owner "gftdcojp/local-murakumo")
   (:cloud-murakumo-fleet :retired-fork)
   (:cloud-murakumo :separate-rented-gpu-product)))
  (:enforcement
  (vector :empty-routes-in-retired-workers
   :deploy-command-fails-closed
   :manifest-single-owner
   :ci-rejects-historical-deploy-edits))))
 (:adr/consequences
 (vector "Public runtime authority has one organization and repository owner."
  "Historical runtimes remain reproducible during test operation without being deployable."
  "Bulk snapshot deletion is deferred until downstream path references are migrated; CI quarantine prevents additional deployment drift."))))
