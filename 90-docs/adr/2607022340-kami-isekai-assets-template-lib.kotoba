(vector (map (:adr/authoritative_for (vector "kami-isekai-assets (kotoba-lang) = the isekai/tensei genre template asset\n    library: race/class/monster/skill EDN template generator\n    (kami.isekai.chargen/compose-character → kami.sprite2d primitives +\n    :render/profiles), no external asset files, watercolour-desaturated\n    Squaresoft-artisan default palette (brainrot variant opt-in only)" "network-isekai's Asset Hub default presets (public/assets/isekai/*) are\n    generated from this lib via nbb gen-presets, not hand-drawn/AI-generated\n    per asset")), (:adr/supersedes (vector)), (:adr/superseded_by (vector)), (:adr/topic "kami-isekai-assets-template-lib"), (:adr/related (vector)), (:adr/status "accepted"), (:adr/id "adr-2607022340-kami-isekai-assets-template-lib"), (:adr/doc_type "adr"), (:adr/last_verified "2026-07-02"), (:adr/body "see 2607022340-kami-isekai-assets-template-lib.edn"), (:adr/deciders (vector "Jun Kawasaki")), (:adr/date "2026-07-02"), (:db/id -1), (:adr/authoritative true), (:adr/title "ADR-2607022340: kami-isekai-assets — isekai/tensei RPG template asset library"), (:adr/source-format "edn")))