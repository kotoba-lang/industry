(vector (map (:db/id -1)
  (:adr/id "adr-2607196300-kami-automation-thinning-review-notifications")
  (:adr/title "KAMI adds automation thinning and review notifications")
  (:adr/date "2026-07-19")
  (:adr/status "accepted")
  (:adr/authoritative true)
  (:adr/topic "kotoba-lang-media-authoring")
  (:adr/supersedes (vector "adr-2607196200-kami-automation-modes-threaded-caption-review"))
  (:adr/decision
  (map (:daw (map (:automation-modes (vector :read :touch :latch :write :trim))
         (:trim-authority :plugin/mix-automation)
         (:trim-operation :bounded-relative-offset)
         (:thinning-authority :user-supplied-tolerance)
         (:linear-thinning-policy :retain-endpoints-and-points-above-maximum-linear-deviation)
         (:step-thinning-policy :remove-only-redundant-consecutive-values)
         (:value-bounds (vector 0.0 1.0))))
   (:nle (map (:notification-authority :project/review-notifications)
         (:notification-kinds (vector :mention :review-request :thread-reply))
         (:recipient-sources (vector :mentioned-user :assigned-reviewer :thread-author))
         (:read-authority :notification/read-at)
         (:read-policy :recipient-only)
         (:ordering (vector :notification/at :notification/id))
         (:duplicate-id-policy :reject)
         (:reference-policy :same-caption-existing-thread)
         (:caption-removal-policy :cascade-notifications)
         (:translation-replacement-policy :cascade-replaced-caption-notifications)))
   (:maturity (map (:kami-app-daw :逍遥) (:kami-app-nle :逍遥)))
   (:remaining-commercial-gates
   (map (:shared (vector "persistent directory grants" "streaming package I/O above 512 MiB"))
    (:daw (vector "third-party plugin SDK/isolation" "control-surface protocols" "surround/Atmos"))
    (:nle (vector "external notification delivery" "tamper-evident signatures" "translation memory" "TTML/IMSC" "OCIO/ICC/HDR"))))))
  (:adr/implementation
  (map (:daw-commits (vector "33cc55172bf99fde4830d180fb48705debfd3020"))
   (:nle-commits (vector "3295bc19f4f10dd131ec5ca62d12c84d3905a193"))
   (:pull-requests (vector "kotoba-lang/kami-app-daw#21" "kotoba-lang/kami-app-nle#21"))
   (:evidence
   (vector "DAW passes 29 tests and 117 assertions; NLE passes 30 tests and 150 assertions after thread-reply kind hardening."
    "Both guarded shadow-cljs production releases completed with zero compiler warnings; NLE was rebuilt after notification-kind review."
    "Chrome generated thirteen DAW Write points, thinned them to two endpoints at tolerance 0.01, applied Trim +0.1, and persisted value 0.5 plus mode :trim in project EDN."
    "Chrome showed one mention notification for lead and one review-request notification for assigned reviewer mika."
    "Chrome marked only lead's notification read: lead changed from one unread to zero while mika remained at one unread."
    "Downloaded NLE EDN contained two deterministic notification IDs and recipient-scoped :notification/read-at."
    "Unit evidence covers linear deviation thinning, bounded Trim, unauthorized read rejection, deterministic recipient creation, same-caption thread references and caption-removal cascade."
    "Automated Chrome and both local servers were closed after verification."
    "Both application PRs were reviewed and merged."))))
  (:adr/consequences
  (vector "Dense transport writes can be reduced under an explicit user-controlled error bound before long-form project growth becomes operationally expensive."
   "Trim adjusts an existing wet-mix curve without replacing its musical-tick topology."
   "Caption review attention and unread state now survive project/package persistence and remain scoped to their recipient."
   "External notification delivery, hardware control and cryptographic review integrity remain explicit commercial-product gaps."))
  (:adr/source-format "edn")))
