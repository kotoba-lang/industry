   "CLAUDE.md"]
  :supersedes []
  :superseded_by []}

 :status-note "analysis only; implementation deferred to next task (owner directive 2026-06-30)"

 :problem
 {:was "submodule era: uniform shallow fine (superproject checks out gitlink directly)"
  :now "west migration: coordination is pin(commit-SHA) driven; west checks out each project to manifest revision"
  :collision "uniform clone-depth:1 vs pin: shallow turns a pin-that-lags-tip from 'slow' into 'fail'"}

 :observed-breakage-2026-06-30
 [{:kind "pin unreachable (7 update failed)"
   :why "--fetch smart + clone-depth:1 fetches only branch tips + tags; a pin that is not any tip is outside the shallow boundary -> checkout fails"
   :projects ["kotoba" "kotoba-code" "aero" "aiueos" "computer-use" "kami-engine" "kami-webgpu"]
   :proof "manual `git fetch --depth 1 origin <pinned-sha>` resolves in seconds => pin-reachability is the sole cause, not network/auth"}
  {:kind "ancestry misjudgment (false force-update)"
   :why "superproject main sync: merge-base outside shallow graft boundary; local git reports 1-1 divergence + forced update"
   :truth "GitHub compare API (full history): status ahead, ahead_by 23, behind_by 0 => pure fast-forward; resolved by --deepen then ff-only"}
  {:kind "heavy repo pin checkout costly"
   :example "org-spirit-in-physics (worktree 1.5-3G; .git is a symlink into superproject .git/modules); checkout to pin timed out at 2min"
   :note "shallow does not shrink the working-tree binaries; depth cannot help heavy repos"}]

 :measurements
 {:as-of "2026-06-30 checked-out children"
  :total-footprint-gb 40
  :distribution {:light-lt-50mb 357 :heavy-ge-200mb 15}
  :heavy-table
  [{:path "orgs/com-junkawasaki/manimani" :size "16.2 GB"}
   {:path "orgs/com-junkawasaki/kotoba" :size "8.98 GB"}
   {:path "orgs/etzhayyim/kotoba" :size "8.98 GB"}
   {:path "orgs/com-junkawasaki/org-spirit-in-physics-comics" :size "3.0 GB"}
   {:path "orgs/gftdcojp/app-aozora" :size "2.4 GB"}
   {:path "orgs/com-junkawasaki/kami-engine" :size "1.95 GB"}
   {:path "orgs/etzhayyim/root" :size "1.77 GB"}
   {:path "orgs/com-junkawasaki/260208-spirit-in-physics" :size "1.56 GB"}
   {:path "orgs/com-junkawasaki/ghosthacker" :size "803 MB"}
   {:path "orgs/gftdcojp/ai-gftd-apps-gftdcojp" :size "538 MB"}
   {:path "orgs/gftdcojp/m365-archive" :size "453 MB" :note "already DataLad"}
   {:path "orgs/com-junkawasaki/kototama" :size "435 MB"}
   {:path "orgs/com-junkawasaki/webmaster" :size "301 MB"}
   {:path "orgs/gftdcojp/network-isekai" :size "231 MB"}]
  :light-note "kotoba-lang pure .cljc libs (aero/dmn/states/datom/cron/ical/policy/openapi...) dominate; full-history increment negligible"}

 :decision-proposed
 {:thesis "drop uniform shallow; keep shallow only for heavy repos (hybrid)"
  :steps
  [{:n 1 :do "add :heavy (= keep-shallow) list to repos.edn = the heavy paths above"}
   {:n 2 :do "patch gen-west-manifest.bb: emit clone-depth:1 ONLY for projects in :heavy (currently :defaults :clone-depth tags all); light projects get no clone-depth line => full clone"}
   {:n 3 :do "migrate heavy to B2 + DataLad over time (m365-archive is the precedent); west keeps only pointers eventually"}
   {:n 4 :do "git fetch --unshallow for LIGHT repos only; do not touch heavy"}]
  :expected
  ["light (357): pin-unreachable failures structurally eliminated (old pin always present in full history) -> roots today's 7 failures"
   "ancestry misjudgment (false force-update) gone for light"
   "heavy is a binary-payload problem, not a depth problem -> keep shallow + DataLad; this ADR leaves that unchanged"]}

 :alternatives-rejected
 [{:opt "all full (drop shallow entirely)" :why-no "solves pin/ancestry but heavy balloons (manimani/kotoba full history even larger)"}
  {:opt "keep shallow + pins always track tip" :why-no "min disk but brittle; any pin lag returns to update failure; usable only as a complementary discipline"}
  {:opt "fixed deeper depth (--depth 30)" :why-no "ADR-2606241600 calls it a gamble (hit=fast / miss=wrong-or-fail)"}]

 :implementation-guardrails
 ["repos.edn/generator change = normal superproject commit; west.yml regen watch the pin-regression trap (generator pins to local working HEAD)"
  "regen then bb scripts/gen-west-manifest.bb --check"
  "main reflection via repos.edn :manifest-workflow API single-entry path"
  "unshallow limited to light; never --unshallow heavy"
  "do not retract ADR-2606241600; this ADR amends its applicability under west"]

 :open-items-out-of-scope
 [{:item "cloud-murakumo west name collision"
   :detail "generator derives name from last path segment so com-junkawasaki vs gftdcojp cloud-murakumo collide; this turn only the 2 west.yml name lines were locally fixed to restore west; generator org-qualification not yet applied"}
