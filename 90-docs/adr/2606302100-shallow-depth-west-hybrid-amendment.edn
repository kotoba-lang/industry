{:frontmatter
 {:id "adr-2606302100-shallow-depth-west-hybrid-amendment"
  :title "ADR-2606302100: clone-depth policy after west — uniform shallow to heavy-only hybrid (analysis, proposed)"
  :status "proposed"
  :doc_type "adr"
  :topic "git-shallow-policy"
  :authoritative false
  :last_verified "2026-06-30"
  :amends ["90-docs/adr/2606241600-shallow-depth1-git-default.md"]
  :authoritative_for
  ["record how west pin-driven checkout collides with uniform clone-depth:1 and breaks update"
   "fix the heavy(binary) vs light(pure-code) split criterion and measurements"
   "propose moving uniform shallow to 'shallow only for heavy, full for the rest' + unshallow procedure"]
  :related
  ["90-docs/adr/2606241600-shallow-depth1-git-default.md"
   "90-docs/adr/2606280300-kotoba-rad-git-sovereign-repo.md"
   "manifest/repos.edn"
