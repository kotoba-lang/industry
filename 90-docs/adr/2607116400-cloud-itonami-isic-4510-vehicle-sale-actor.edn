  :adr/decision-summary "{:pattern \"sealed VehicleSale-LLM + independent VehicleSaleGovernor + append-only audit ledger, lists/discloses/confirms sale DECISIONS only -- never payment, escrow, or vehicle custody\", :new-actor \"cloud-itonami-isic-4510\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-4510\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"4510\", :isic-name \"Sale of motor vehicles\", :distinct-from \"cloud-itonami-isic-4774 (general second-hand-goods resale) -- vehicle sales carry title/lien and federal odometer-disclosure law that a generic resale actor does not model\", :namespace \"vehiclesale\", :registry-promotion \"kotoba-lang/industry registry.edn id 4510: :maturity :spec (dead gftdcojp/cloud-itonami-G4510 placeholder) -> :implemented\", :governor-checks [{:check :rbac :severity :hard} {:check :lien-clearance-gate :severity :hard :note \"new -- no analog in other cloud-itonami actors; a sale/confirm on a title with an active lien, without an explicit lien-cleared? confirmation, is rejected regardless of confidence\"} {:check :odometer-disclosure-gate :severity :hard :note \"new -- a listing rolling back below the last recorded odometer reading, or a sale/confirm on a non-exempt-age (under 20 model years) vehicle missing the federal disclosure statement (49 U.S.C. Chapter 327 / 49 CFR Part 580), is rejected\"} {:check :source-provenance-gate :severity :hard} {:check :licensed-disclosure :severity :hard} {:check :confidence-floor :severity :soft-escalate} {:check :salvage-title-gate :severity :soft-escalate :note \"a salvage/flood/rebuilt-title vehicle's sale confirmation always escalates to a human, mirrors isic-6311's halted-instrument gate\"} {:check :dispute-request :severity :soft-escalate-unconditional}], :r0-scope {:source-catalog [\"NMVTIS official DOJ one-report-per-VIN gateway (free, federal)\" \"NHTSA vehicle recalls (free, federal API)\"], :structural-class \"operator-licensed-dmv-feed -- no single free nationwide US source for live state-by-state title/lien data exists; an operator must register a real dmv-license credential\"}, :robotics {:value false, :key-present false, :rationale \"lists/discloses/confirms sale decisions only, never physical vehicle handover, payment, or custody\"}, :test-results {:unit-tests \"34 tests / 113 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end, all 10 scenarios fire correctly (sourced listing -> commit, unsourced listing -> hold, active-lien sale -> hold, cleared-lien sale -> commit, over-disclosure x2 -> hold, salvage-title sale -> escalate -> approve -> commit, dispute -> escalate -> approve -> commit, odometer-rollback listing -> hold, age-exempt sale without disclosure statement -> commit)\"}, :landing-note \"kotoba-lang/industry registry.edn + maturity-tier test count were landed via direct GitHub API single-entry blob-SHA PUT (commits 9240224/f2c7f51) rather than the local shared checkout, which was concurrently occupied by sibling forks' (isic-3822/isic-6209) uncommitted WIP at landing time -- their WIP was preserved via git stash, not discarded\", :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. kotoba-lang/industry pin advanced in manifest/west.yml (--entry industry, pin-verified OK)\"}"
