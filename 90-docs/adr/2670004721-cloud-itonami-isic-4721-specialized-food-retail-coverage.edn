  :actor/id :cloud-itonami-isic-4721
  :actor/name "Specialized Food Retail Operations Coordinator"
  :actor/isic-rev4 "4721"
  :actor/domain :retail/specialized-food-stores
  :actor/wave 2
  :actor/coordination? true
  :actor/robotics? true

  :actor/proposal-ops [:log-sales-record :schedule-staffing-operation
