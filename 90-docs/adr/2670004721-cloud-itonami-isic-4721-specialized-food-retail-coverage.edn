                                "アレルゲン除外" "アレルゲン上書き"
                                "refrigeration equipment override" "actuate equipment" "shut down equipment"
                                "control the walk-in cooler" "control the slicer" "control the meat grinder"
                                "health department" "inspection clearance" "license suspension"
                                "保健所" "衛生当局" "営業許可取消"]

  ;; Self-trip-avoidance: equipment-actuation terms kept English-only --
  ;; this namespace's own Japanese default disclaimer text ("...加工設備の
  ;; 直接操作は行わない") legitimately discusses NOT touching such
  ;; equipment, so a bare Japanese equipment term would self-trip.
  ;; Regression test: governor-test/default-mock-advisor-proposals-never-self-trip-scope-exclusion.

  :phase/rollout
  {0 {:label "read-only" :writes #{} :auto #{}}
