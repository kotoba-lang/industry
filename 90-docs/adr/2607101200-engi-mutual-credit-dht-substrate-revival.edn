[{:adr/authoritative_for ["v1(ADR-2607101100)が諦めた3性質(push型warrant伝播/非EN forkの\n    チェーン同期/手数料の双方署名化)への復活パスをCLJC再実装マップとして\n    文書化: source-chain → engi-on-source-chain → warrant+neighborhood →\n    gossip(net拡張) → settlement、の5段階シーケンス" "着手条件(いずれか): v1運用でpull型検知の間隙を突いた実害が観測される /\n    ENGI以外の複数消費者がsource-chain+warrant+gossip基盤を要求する /\n    kotobase.netのCACAO委任スコープが多者間grantに拡張され双方向書込みが\n    可能になる。いずれも満たさない限り着手しない" "各段階は独立にリリース可能、途中で止めてもv1からの後退にはならない"], :adr/supersedes [], :adr/superseded_by [], :adr/topic "engi-mutual-credit", :adr/related ["orgs/kotoba-lang/kotoba/docs/ADR-engi-mutual-credit-on-chain.md" "90-docs/adr/2607101100-engi-mutual-credit-kotobase-native-design.md" "90-docs/adr/2607101000-kotoba-orphaned-rust-crates-migration-roadmap-addendum.md" "90-docs/adr/2607022600-kotoba-database-crates-cljc-migration-roadmap.md"], :adr/status "proposed (将来パス、着手条件を満たすまで実装しない)", :adr/id "adr-2607101200-engi-mutual-credit-dht-substrate-revival", :adr/doc_type "adr", :adr/last_verified "2026-07-10", :adr/decision "{:revival-sequence [{:stage 1, :lib \"kotoba-lang/source-chain\", :note \"commit-dagとの概念重複を先に解消\"} {:stage 2, :lib \"kotoba-lang/engi (on source-chain)\", :note \"R0/R4/R5相当\"} {:stage 3, :libs [\"kotoba-lang/warrant\" \"kotoba-lang/neighborhood\"], :note \"R7/R8相当、まだpull型\"} {:stage 4, :lib \"kotoba-lang/net拡張(gossip)\", :note \"R8/R9相当、push型伝播をここで追加\"} {:stage 5, :lib \"settlement(手数料双方署名化)\", :note \"原設計deferred項目2\"}], :launch-conditions [\"v1でのpull型検知間隙の実害観測\" \"ENGI以外の複数消費者の出現(kotoba-word/kotoba-lattice等)\" \"kotobase.net CACAO委任スコープの多者間grant拡張\"]}", :db/id -1, :adr/authoritative true, :adr/title "ADR-2607101200: ENGI/EN 相互信用通貨 — kotoba-dht基盤フル復活(v2、将来パス)"}]