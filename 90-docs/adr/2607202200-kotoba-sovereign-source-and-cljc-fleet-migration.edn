{:adr/id "2607202200-kotoba-sovereign-source-and-cljc-fleet-migration"
 :adr/status :accepted
 :adr/date "2026-07-20"
 :adr/title "Kotoba sovereign source and CLJC fleet migration"

 :decision
 {:runtime-priority [:safety :determinism :bounded-resources :portability]
  :production-jvm :forbidden
  :extensions
  {".clj" {:language :clojure :role :compatibility-source}
   ".cljs" {:language :clojurescript :role :compatibility-source}
   ".cljc" {:languages [:clojure :clojurescript :kotoba]
            :role :shared-migration-source}
   ".cljk" {:language :kotoba :role :clj-to-kotoba-correspondence}
   ".kotoba" {:language :kotoba :role :sovereign-source}
   ".kotobas" {:language :kotoba-script :role :browser-script-source}}
  :pipelines
  [{:source [".kotoba" ".cljk"]
    :compiler :kotoba-lang/compiler
    :runtime :kototama
    :targets [:reference :wasm32-browser :native-aot]}
   {:source [".kotoba" ".kotobas"]
    :compiler :kotoba-lang/kotoba-script
    :target :restricted-javascript}]
  :web-rule "JavaScript is an untrusted host target; capability admission, bounded values, and fail-closed host validation remain Kotoba authority."
  :migration-rule "Do not rename .cljc mechanically. Admit source through the Kotoba grammar/type/effect/resource gates, add cross-target evidence, then change the extension and authority declaration."
  :kami-placement "Kami owns 3D, physics, rendering, simulation, and game-engine providers. Kotoba owns language, compiler, values, capability admission, and portable domain programs."
  :cross-host-conformance "Require valid and instantiable Wasm plus observable semantic, ABI, resource-bound, and fail-closed rejection conformance across compiler hosts. Byte layout is diagnostic evidence only, never a language-compatibility gate."}

