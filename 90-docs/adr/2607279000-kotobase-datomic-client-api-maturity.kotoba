  (:adr/title "ADR-2607279000: Kotobase Datomic Client API maturity — official API surface, not XRPC")
  (:adr/status "accepted")
  (:adr/date "2026-07-27")
  (:adr/last_verified "2026-07-27")
  (:adr/deciders (vector "Jun Kawasaki"))
  (:adr/authoritative true)
  (:adr/authoritative_for (vector "kotobase.datomic.client as datomic.client.api drop-in"
   "D1 Worker /api/* Client API paths (application/edn, not XRPC)"
