 :decision
 {:pattern :kenchi-split-of-duties
  :rationale "governor が拒否しうる能力 (LLM 提案・生成・PDS 認証・publish) は off-mesh JVM actor に残し、mesh には identity/liveness の2 component のみ置く。"
  :on-mesh
  [{:component "drama-profile"
    :trigger {:type :http :route "/minidrama/profile"}
    :does "actor identity record (handle/did/registry) を応答 + profile datom assert"}
   {:component "drama-heartbeat"
    :trigger {:type :tick :every "1h"}
    :does "resident-liveness datom append + identity anchor 再 assert"}]
  :off-mesh "DramaLLM ⊣ DramaGovernor / generate / assemble / aozora publish+announce (minidrama.operation/publisher/announce, JVM)"}

