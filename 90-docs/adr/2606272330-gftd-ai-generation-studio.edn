 {:id "adr-2606272330-gftd-ai-generation-studio"
  :title "gftd.ai 生成スタジオ — murakumo を基盤に chat/voice/image/music/sfx/3D の生成 API + UI/UX を datom 化する"
  :status "closed"
  :closed "2026-06-28"
  :date "2026-06-27"
  :authoritative true
  :repo ["orgs/gftdcojp/cloud-murakumo"      ; 生成関数の追加(基盤)
         "orgs/gftdcojp/ai-gftd-router"         ; 製品面(新規): API + lexicon + studio UI
         "orgs/gftdcojp/network-isekai"]     ; 消費側
  :builds_on ["orgs/gftdcojp/cloud-murakumo"            ; GPU serverless 基盤(ADR-2606272300)
              "orgs/gftdcojp/cloud-itonami"             ; 同設計原則(business を datom 化)
              "orgs/com-junkawasaki/kotoba"             ; CID+Datom+WASM + on-http component
              "orgs/com-junkawasaki/murakumo"           ; mesh 制御面(auction 配置)
              "etzhayyim/kami-engine"]                  ; scene/render-IR + Rust kami-render
  :related ["90-docs/adr/2606272300-cloud-murakumo-gpu-cloud.md"   ; GPU 基盤(本 ADR が拡張)
            "90-docs/adr/2606271700-cloud-itonami-business-os.md"  ; AT-proto lexicon の同型
            "90-docs/adr/2606271700-kotoba-transport-planes.md"]}  ; 2 平面(Live/Read) reach

 :decision
 {:product "gftd.ai 生成スタジオ"
  :placement :gftdcojp
  :subject :multimodal-generation
  :definition "chat/voice/image/music/sfx/3D の生成を 3 層で datom 化する。基盤=cloud-murakumo に :fn/kind :gen(request→artifact 非同期ジョブ)を追加、製品=ai-gftd-router が統一ジョブ API + AT-proto lexicon ai.gftd.gen.* + studio.gftd.ai(ClojureScript)、消費=isekai.network/kami-engine が同じ API を XRPC 機械消費。cloud-itonami(business)/cloud-murakumo(Modal)を datom 化したのと同じ原則。"
  :layers
  {:substrate {:repo "gftdcojp/cloud-murakumo"
               :role "GPU serverless。auction 配置 / scale-to-zero / gpu-seconds 課金 / 承認 gate を無改造で再利用し :fn/kind :gen を追加。"
               :ssot "resources/murakumo.edn"}
   :product   {:repo "gftdcojp/ai-gftd-router"
               :role "統一生成 API(REST+SSE) + AT-proto lexicon + studio UI。配置/実行/課金は murakumo へ委譲。"
               :subdomain "studio.gftd.ai / gen.gftd.ai"}
   :consumers {:repo ["gftdcojp/network-isekai" "etzhayyim/kami-engine"
                      "gftdcojp/ai-gftd-shiropico-wt/60-apps/ai-gftd-project-mangaka"]
               :role "ワールド/IP。画像→3D アセット、storyboard→KAMI scene、NPC voice、world BGM を同じジョブモデルで消費。"}}}

 :principles
 ["murakumo を置き換えず拡張(:serve に対し :gen を追加するだけ。配置/課金/承認は再利用)"
  "エンジンは差し替え可能アダプタ(vllm の serve-cmd 生成と同型に comfy/trellis/audio/tts/kami-render を EDN→起動仕様で生成)"
  "成果物は kotoba CID(B2 実体。git には載せない。API は CID 参照を返す)"
  "製品面は AT-proto NSID lexicon ai.gftd.gen.*(itonami の ai.gftd.apps.itonami.* と同型 / XRPC 公開)"
  "chat だけ同期ストリーミング(OpenAI 互換 /v1。既存 vLLM serve へ proxy)。他は submit→SSE→artifact"]

 :existing_assets
 {:principle "greenfield しない。散在する生成パイプの GPU 実行面を murakumo :gen 関数に統合・載せ替える"
  :kami-engine {:repo "com-junkawasaki/kami-engine(30+ Rust crates, wgpu WebGPU→WebGL2)"
                :kami-cine "8 段ニューラル映像パイプ(world-model→USD→neural-geom→neural-render→diffusion→EXR)。WIT contract。diffusion/neural-render 段が :gen の主消費者"
                :3d-out ["kami-nerf(NeRF)" "Gaussian splat(GsplatAdapter)" "kami-terrain" "kami-vegetation"]
                :audio-out ["kami-audio(HRTF/3D pan)" "kami-rt-binaural" "kami-sound.js(27 preset)"]}
  :image-existing "ComfyUI gateway(shiropico ADR-0088) + animeka 画像パイプ → :engine :comfy に正規化・集約(二重運用しない)"
  :isekai "network-isekai(browser CLJ/EDN game play/fork, Cloudflare, VRM dance, USD, Datomic fork)+ kami-app-isekai(Plains voxel) = 生成アセット最終消費地"
  :chat-runtime "langgraph-clj StateGraph(既存。/v1/chat/completions 上位オーケストレーション)"}

 :core_vocab
 {:murakumo {:fn-kind {:gen "request→artifact 非同期ジョブ(:serve と対称)"}
             :fn-engine #{:vllm :comfy :trellis :audio :tts :kami-render}
             :fn-modality #{:chat :voice :image :music :sfx :3d}
             :reuse [:murakumo.run/gpu-seconds :murakumo.placement :murakumo.effect :murakumo.volume]}
  :gen {:gen.job/id "ULID"
        :gen.job/modality #{:chat :voice :image :music :sfx :3d}
        :gen.job/model "モデル id → murakumo fn へ解決"
        :gen.job/input "{:prompt :refs[CID] :params}"
        :gen.job/status #{:queued :running :done :failed}
        :gen.job/artifacts "[CID] (media-type/provenance 付き。B2/kotoba)"
        :gen.job/run ":murakumo.run(gpu-seconds → 課金)"
        :gen.job/actor "gftd.ai account / isekai world / kami pipeline"}}

 :api
 {:rest {"POST /v1/chat/completions" "OpenAI 互換。murakumo vLLM serve へ proxy(同期 streaming)"
         "POST /v1/gen" "ジョブ生成 {modality,model?,input,params} → {job}(非同期)"
         "GET /v1/gen/{id}" "ジョブ poll"
         "GET /v1/gen/{id}/events" "SSE 進捗(queue/%/preview)"
         "GET /v1/models" "modality 別モデル一覧(murakumo.edn 射影)"
         "GET /v1/artifacts/{cid}" "成果物取得(Read 面 CID-over-HTTP / B2 署名 URL)"}
  :lexicon {:nsid "ai.gftd.gen.*"
            :methods ["createJob" "getJob" "listJobs" "listModels" "job(record)"]
            :note "itonami と同型 / kotoba XRPC。isekai/kami が SDK 無しで直叩き。"}
  :auth ":api-key(gftd.ai account 単位。murakumo :endpoint{:auth :api-key} 継承)"
  :billing ":gen.job/run → :murakumo.run/gpu-seconds(:financial gate を通る)"}

 :ui
 {:app "studio.gftd.ai(ClojureScript/reagent/re-frame。kotoba on-http component)"
  :layout {:left "モダリティ切替(チャット/音声/画像/音楽/効果音/3D)+ パイプライン + ライブラリ"
           :center "プロンプト+params+参照ドロップ(CID)。ライブキャンバス(画像グリッド/波形+player/3D viewer/chat)。SSE 進捗"
           :right "ライブラリ(CID 成果物履歴。参照再投入可。provenance: model/gpu-seconds/コスト)"}
  :pipelines {"チャット→絵コンテ→KAMI scene" "mangaka 橋(mangaka/kami.cljc)→ kami-render(murakumo :gen)"
              "画像→3D" "TRELLIS で glTF(isekai アセット化)"
              "シーン作曲" "3D scene + prompt → BGM(music)+環境音(sfx)→ isekai world"
              "キャラボイス" "text + voice ref → TTS で isekai NPC セリフ"}
  :design "dark / 日本語ファースト / キーボード駆動 / 全成果物 CID 不変・共有可・再現可"}

 :model_defaults
 {:chat  {:models ["MiniMax-M2.7" "Kimi-K2.7"] :engine :vllm :gpu "h100x4 / h200x8" :note "既存 :llm-serving"}
  :voice {:models ["CosyVoice2(JA)" "Kokoro(fast)"] :engine :tts :gpu "l4x1"}
  :image {:models ["FLUX.1-dev" "Qwen-Image" "SDXL-Turbo(fast)"] :engine :comfy :gpu "a100-40 / l4 x1"}
  :music {:models ["ACE-Step" "Stable Audio Open"] :engine :audio :gpu "a100x1"}
  :sfx   {:models ["Stable Audio Open"] :engine :audio :gpu "l4x1"}
  :3d    {:models ["TRELLIS" "Hunyuan3D-2.1"] :engine :trellis :gpu "a100-80x1" :out [:gltf :glb]}
  :render {:models ["kami-render"] :engine :kami-render :gpu "l4/a10 x1" :in :kami-scene-ir :out [:png :mp4]}}

 :murakumo_edn_patch
 {:images_add [:comfy-cuda :trellis-cuda :audio-cuda :tts-cuda]
  :apps_add {:generation {:functions [:image :model3d :music :sfx :voice :render]
                          :note ":fn/kind :gen / scale-to-zero / 既存 fleet 同居 / 既存 schema・scheduler・runtime 無改造"}}
  :new_ns ["cloud-murakumo.gen(gen function→worker 起動 + ジョブ正規化)"
           "cloud-murakumo.engine(engine ロジック clj。:gen.job→backend 呼び出し記述。純粋)"
           "cloud-murakumo.worker(gen ワーカ clj。run-job を execute 注入で実行。--engine dispatch)"]}

 :risk_gate
 {:gpu-spend "生成ジョブの GPU 確保は既存 :scale-up/:deploy の :financial gate を通る"
  :quota "アカウント別 gpu-seconds 上限。超過は :gen.job/status :failed で fail-closed(暴走 prompt loop 防止)"
  :safety "NSFW/権利チェックは :gen 後段 filter effect。isekai/IP の独立 governor(itonami CertGovernor 流)に接続可"}

 :transport
 {:planes_adr "90-docs/adr/2606271700-kotoba-transport-planes.md"
  :execution "Live 面(libp2p QUIC, native fleet)"
  :artifacts "Read 面(CID-over-HTTP)"
  :edge "sora(l4, :http reach)= 軽量・高速モデル置き場(sdxl-turbo/kokoro/sfx)"}

 :alternatives
 {:external-saas "Modal/Replicate/fal.ai 直投げ → SSoT/課金監査が二重化。native fleet を使い切る方が原価有利。不採用(将来 :http reach の外部ノードを auction spillover として残す)"
  :per-modality-api "modality 別エンドポイント → UX/課金が割れる。統一 POST /v1/gen に集約(chat だけ OpenAI 互換別口)"
  :react-stack "React/Next 別スタック → cljc+kotoba WASM 主軸と CID/XRPC/on-http 整合のため ClojureScript 採用"
  :model-pin "image=FLUX/Qwen, 3d=TRELLIS/Hunyuan, music=ACE-Step/Stable Audio, tts=CosyVoice2/Kokoro。pin はライセンス確認後確定"}

 :consequences
 ["gftd.ai 生成 AI が単一 operating surface(murakumo.edn + clj -M:* / ai.gftd.gen.* + studio.gftd.ai)。Modal decorator も SaaS キーも増やさない"
  "isekai.network/kami engine が人間と同じ生成 API を XRPC 機械消費(mangaka/NPC voice/world BGM が同一ジョブモデル)"
  "生成 1 回 = :gen.job + :murakumo.run datom。Datomic as-of/Datalog で誰が・どのモデルで・何 gpu-seconds・いくらを横断照会"
  "成果物は CID 不変・B2 実体。git/clone を重くせず再現・共有・provenance"
  "関心分離: murakumo=GPU / ai-gftd-router=製品課金UX / isekai・kami=IP"]

 :open_questions
 ["[決定 2026-06-28] 製品リポ = gftdcojp/ai-gftd-router(ai-gftd-* 命名整合。subdomain studio.gftd.ai / gen.gftd.ai)"
  "[未了] モデル pin 確定(ライセンス商用可否・日本語性能・VRAM 実測。特に FLUX dev/Stable Audio/CosyVoice2)"
  "[決定 2026-06-28] 課金主体 = gftd.ai 単独テナント(isekai/kami は actor タグで provenance 分離、口座は単一)"
  "[決定] 着手順 = (a) 基盤先行 → (b) 製品層。両方着手済み"]

