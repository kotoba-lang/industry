(vector (map (:db/id -1)
  (:adr/id "adr-2608111810-simulated-user-fictional-cohort-product-evaluation")
  (:adr/title "ADR-2608111810: simulated-user — 相関付き架空 cohort による製品評価を実在人物の模倣から分離する")
  (:adr/status "accepted")
  (:adr/date "2026-08-11")
  (:adr/deciders (vector "Jun Kawasaki"))
  (:adr/authoritative true)
  (:adr/authoritative_for
  (vector "kotoba-lang/simulated-user の責務境界"
   "架空 categorical persona DAG と Survey/Chatbot/Web/App 評価の R0 contract"
   "実在人物・PII・説得・targeting・重大意思決定を拒否する安全境界"))
  (:adr/related
