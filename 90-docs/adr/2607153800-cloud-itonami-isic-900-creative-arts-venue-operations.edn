{:id "2607153800"
 :title "cloud-itonami-isic-900 — Creative Arts & Entertainment Venue Operations Coordination"
 :status "accepted"
 :date "2026-07-15"
 :scope ["orgs/cloud-itonami/cloud-itonami-isic-900"
         "orgs/kotoba-lang/industry"]
 :context {:isic-class 900
           :domain "creative-arts-entertainment"
           :focus "performing-arts-venue-administrative-coordination"
           :not "creative-content-decisions-casting-programming-pricing"}
 :decision {:repo {:path "cloud-itonami/cloud-itonami-isic-900"
                   :public true
                   :license "AGPL-3.0-or-later"}
            :namespace "venueadminops"
            :modules ["store" "advisor" "governor" "phase" "operation" "sim"]
            :hard-checks [{:name "venue-unverified"
                           :rule "target must exist and be :registered?/:verified? in store"}
                          {:name "effect-not-propose"
                           :rule ":effect must be :propose"}
                          {:name "scope-exclusion"
                           :rule "no creative/artistic decisions, casting, programming, pricing, or safety-authority overrides"}]
            :allowed-ops ["schedule-venue-booking"
                          "coordinate-performer-schedule-proposal"
                          "coordinate-supply-request"
                          "coordinate-ticketing-logistics"
                          "flag-safety-concern"]
            :escalate-ops ["flag-safety-concern"]
            :phases {:phase-0 "read-only"
                     :phase-1 "venue-booking + performer-schedule (approval-gated)"
                     :phase-2 "+ supply-coordination + ticketing-logistics (approval-gated)"
                     :phase-3 "auto-commits clean proposals (safety always escalates)"}}
 :consequences {:positive ["isic-900 actor available for wave-4 rollout"
                          "consistent wave-4 architecture"
                          "hard scope boundaries enforced"]
                :negative ["no real venue-system integration yet (pilot)"
                          "no isco-08 occupation mapping (future)"]}
 :references ["ADR-2607121000"
              "ADR-2607152700"
              "ADR-2607152800"
              "ADR-2607051621"]}
