             :check-3 "scope-exclusion (clinical/patient-care/treatment/diagnosis) -> permanent HARD hold via substring scan"}
  :phase {:stages 4
          :stage-0 "read-only"
          :stage-1 "assisted-logistics (appointment scheduling only, approval-gated)"
          :stage-2 "assisted-coordination (+ referral/supply/shift, still approval-gated)"
          :stage-3 "supervised-auto (4 non-safety ops auto-commit when clean, safety always escalates)"
          :safety-concern-never-auto-commits? true}
  :module-shape {:store "clinicops.store (MemStore, string-keyed appointment/provider directory, append-only ledger)"
                 :advisor "clinicops.advisor (mock + real-LLM seam, 5-op deterministic routes)"
