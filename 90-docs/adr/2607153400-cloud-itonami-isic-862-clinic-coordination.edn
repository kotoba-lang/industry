 :context
 {:domain "Medical and dental practice activities (ISIC Rev.4 862)"
  :scope "Back-office administrative coordination only — NOT clinical decision-making"
  :wave 4
  :batch 7
  :related-adr ["2607152800" "2607152500" "2607121000"]
  :difference-from-siblings "Domain-adapted for outpatient clinics: appointment scheduling, referral logistics instead of bed assignment, visitor access"}

 :decision
 {:operations {:allowed-ops 5
               :ops [:schedule-appointment :coordinate-referral-logistics :coordinate-supply-request
                     :schedule-staff-shift-proposal :flag-safety-concern]}
  :governor {:hard-checks 3
