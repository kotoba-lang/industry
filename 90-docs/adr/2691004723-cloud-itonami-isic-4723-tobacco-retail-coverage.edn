  ;; staffing-operation scheduling, supply-order coordination,
  ;; compliance-concern flagging).

  :actor/id :cloud-itonami-isic-4723
  :actor/name "Specialized Tobacco Retail Operations Coordinator"
  :actor/isic-rev4 "4723"
  :actor/domain :retail/specialized-tobacco-stores
  :actor/wave 2
  :actor/coordination? true
  :actor/robotics? true

  :actor/proposal-ops [:log-sales-record :schedule-staffing-operation
                       :coordinate-supply-order :flag-compliance-concern]
  :actor/always-escalate-ops [:flag-compliance-concern]
  :actor/cost-threshold-escalate-ops {:coordinate-supply-order 750}

  :actor/hard-checks [:store-verified :effect-propose :scope-exclusion]
  :actor/scope-excluded-terms ["age verification override" "finalize age verification" "override the age gate"
                                "年齢確認を確定" "年齢確認の上書き" "年齢確認をバイパス"
                                "control the age verification terminal" "actuate the id scanner" "override id scan"
                                "年齢確認端末を操作" "年齢確認端末の直接操作" "IDスキャナーを操作"
                                "tobacco license suspension" "inspection clearance" "regulatory enforcement"
                                "たばこ小売許可停止" "たばこ小売許可取消" "営業許可取消"]

  ;; Self-trip-avoidance: every scope-excluded term is phrased as the
  ;; finalization/execution ACTION, never a bare noun -- this namespace's
  ;; own Japanese default disclaimer text ("...年齢確認の実施可否については
  ;; 関与しない" / "...年齢確認端末の設定変更は行わない") legitimately
  ;; discusses age verification WITHOUT finalizing or actuating it, so a
  ;; bare "年齢確認" term would self-trip. Regression test:
  ;; governor-test/default-mock-advisor-proposals-never-self-trip-scope-exclusion.

  :phase/rollout
  {0 {:label "read-only" :writes #{} :auto #{}}
   1 {:label "assisted-logging" :writes #{:log-sales-record} :auto #{}}
   2 {:label "assisted-coordination" :writes #{:log-sales-record :schedule-staffing-operation
