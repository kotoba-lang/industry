[{:adr/id 2680004719
  :adr/title "cloud-itonami-isic-4719 — Non-Specialized-Store Retail Operations Coordination"
  :adr/status :accepted
  :adr/date "2026-07-16"
  :adr/scope [:kotoba-lang/industry :cloud-itonami/cloud-itonami-isic-4719]
  :adr/references [2607121000 2670004721]

  ;; Wave 2 actor (coordination/logistics/trade): non-specialized-store
  ;; general-merchandise retail (department stores/general-merchandise
  ;; stores without predominant food sales) operations coordination-only
  ;; (sales-record logging, staffing-operation scheduling, supply-order
  ;; coordination, loss-prevention-concern flagging). Distinct from ISIC
  ;; 4711's dual-actuation sale-post/reorder-commit shape.

  :actor/id :cloud-itonami-isic-4719
  :actor/name "Non-Specialized-Store Retail Operations Coordinator"
  :actor/isic-rev5 "4719"
  :actor/domain :retail/non-specialized-stores
  :actor/wave 2
  :actor/coordination? true
  :actor/robotics? true

  :actor/proposal-ops [:log-sales-record :schedule-staffing-operation
                       :coordinate-supply-order :flag-loss-prevention-concern]
  :actor/always-escalate-ops [:flag-loss-prevention-concern]
  :actor/cost-threshold-escalate-ops {:coordinate-supply-order 1000}

  :actor/hard-checks [:store-verified :vendor-verified :effect-propose :scope-exclusion]
  :actor/scope-excluded-terms ["finalize detention" "detain the suspect" "detain the customer"
                                "physically detain" "physically restrain"
                                "conduct a search of" "perform a search of"
                                "search the suspect" "search the customer's bag"
                                "search the customer's belongings"
                                "make an arrest" "place under arrest" "citizen's arrest"
                                "confiscate the suspect's" "seize the suspect's"
                                "call security to detain" "instruct security to detain"
                                "escort the suspect to" "press charges against"
                                "finalize the loss-prevention enforcement action"
                                "execute the loss-prevention enforcement action"
                                "取り押さえを実行" "身柄を拘束" "所持品検査を実施"
                                "現行犯逮捕を実行" "商品を没収した"]

  ;; Self-trip-avoidance: every term above is phrased as the
  ;; finalization/execution ACTION, never a bare noun -- this namespace's
  ;; own :flag-loss-prevention-concern default proposal legitimately
  ;; discusses shoplifting/shrinkage concerns, and its own printed :op
  ;; keyword literally contains the substring "loss-prevention". A
  ;; bare-noun term list (e.g. bare "shoplifting"/"detention"/"loss
  ;; prevention") would self-trip this actor's own core happy path on
  ;; every single run. Regression test:
  ;; governor-test/default-mock-advisor-proposals-never-self-trip-scope-exclusion.

  :phase/rollout
  {0 {:label "read-only" :writes #{} :auto #{}}
   1 {:label "assisted-logging" :writes #{:log-sales-record} :auto #{}}
   2 {:label "assisted-coordination" :writes #{:log-sales-record :schedule-staffing-operation
                                               :coordinate-supply-order}
      :auto #{}}
   3 {:label "supervised-auto" :writes #{:log-sales-record :schedule-staffing-operation
                                         :coordinate-supply-order :flag-loss-prevention-concern}
      :auto #{:log-sales-record :schedule-staffing-operation :coordinate-supply-order}}}

  :operation/entry-point :intake
  :operation/nodes [:intake :advise :govern :decide :request-approval :commit :hold]

  :test/counts {:total 56 :assertions 166 :failures 0 :errors 0}
  :test/coverage [:governor-hard-checks :advisor-shapes :phase-rollout :integration
                  :store-contract :scope-exclusion-self-trip-regression
                  :vendor-verification]
  :test/simulator :merchandiseops.sim

  :registry/maturity :implemented
  :registry/repo "https://github.com/cloud-itonami/cloud-itonami-isic-4719"
  :registry/business-id "cloud-itonami-isic-4719"
  :registry/required-technologies [:robotics :identity :forms :dmn :bpmn :audit-ledger :retail]
  :registry/operating-states [:intake :advise :govern :approve :commit :audit]

  :db/id -1}]
