(vector (map (:adr/id "adr-2607202500-cloud-itonami-isco-human-required-gap-referral"),
  (:adr/title "ADR-2607202500: cloud-itonami-isco — human-required gap detection + referral-draft handoff to the staffing/matching actors"),
  (:adr/topic "cloud-itonami-isco-human-required-gap-referral"),
