  :adr/id "adr-2609100300-hermes-bots-onto-murakumo-api"
  :adr/title "hermes profile bots の API を api.murakumo.cloud にする。fleet の実効 context 上限が Hermes の下限を下回っている"
  :adr/status "accepted"
  :adr/date "2026-09-10"
  :adr/tags ["hermes"
"murakumo"
