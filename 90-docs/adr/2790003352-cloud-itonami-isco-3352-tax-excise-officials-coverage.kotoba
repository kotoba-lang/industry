  (:registry/operating-states (vector :intake :propose :approve :execute :audit)),
  (:registry/repo "https://github.com/cloud-itonami/cloud-itonami-isco-3352"),
  (:registry/business-id "cloud-itonami-isco-3352"),
  (:test/counts "{:total 24, :assertions 54, :failures 0, :errors 0}"),
  (:test/coverage (vector :governor-hard-checks :advisor-shapes :integration :store-contract :scope-exclusion-self-trip-regression :closed-op-allowlist :appointment-capacity-ceiling :supply-order-cost-ceiling)),
