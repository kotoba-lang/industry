  (:adr/source-format "edn"),
  (:adr/scope (vector :kotoba-lang/occupation :cloud-itonami/cloud-itonami-isco-3352)),
  (:adr/references (vector 2607121000)),
  (:actor/id :cloud-itonami-isco-3352),
  (:actor/name "Tax Excise Documentation & Logistics Coordination Practice"),
  (:actor/domain :government/tax-excise-documentation),
  (:actor/isco-08 "3352"),
