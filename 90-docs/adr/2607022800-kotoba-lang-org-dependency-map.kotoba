(vector (map (:adr/authoritative_for (vector "west-registration coverage of the kotoba-lang GitHub org (363 repos on GitHub as of 2026-07-02; 358 correctly covered by manifest/west.yml paths, 5 gap repos registered by this ADR's companion commit (cad/eda/genome/mst-projector/lab), 4 documented exceptions left untouched (see :exceptions)" "consolidated map of the ~44 comment-documented repo clusters already curated in manifest/repos.edn's :extra-projects, normalized into one queryable :clusters vector" "ground-truthed dependency graph for the crypto/CBOR/CID/CRDT/MST substrate hub repos, derived from actual deps.edn :local/root and io.github.kotoba-lang/* git-sha coordinates (not just comment inference)" "naming-collision-avoidance table: every case where a kami-engine-crate restoration target renamed away from its natural short name because an unrelated, pre-existing kotoba-lang/<short-name> repo already occupied it" "does NOT claim exhaustive per-repo dependency edges for all 363 repos — most are leaf libraries with no documented cross-repo relationship; this ADR reports what is actually documented/grounded, not a fabricated complete graph")), (:adr/orgs "{\"kotoba-lang\" {:role :language-substrate, :scope :platform, :note \"pure-CLJC language + core library substrate; every other org consumes it\"}, \"etzhayyim\" {:role :agent-centric, :scope :public-interest, :note \"com-etzhayyim-* organism actors (UNSPSC/ISCO/COFOG-flavored)\"}, \"gftdcojp\" {:role :human-centric, :scope :business, :note \"ai-gftd-* products/services, apps, talent\"}, \"com-junkawasaki\" {:role :transitional-foundation, :scope :private-foundation, :note \"shrinking toward data-only (e.g. spirit-in-physics); language core already migrated to kotoba-lang via :path-overrides, generic -clj foundation libs slated to follow (decided 2026-06-30)\"}}"), (:adr/topic "kotoba-lang"), (:adr/dependency-graph "{:method \"deps.edn read directly from the 17 locally-checked-out orgs/kotoba-lang/* hub repos on 2026-07-02\", :edges [{:from \"ed25519\", :to \"cacao\", :kind :local-root} {:from \"dag-cbor\", :to \"cacao\", :kind :local-root} {:from \"ed25519\", :to \"pqh\", :kind :git-sha} {:from \"dag-cbor\", :to \"pqh\", :kind :git-sha} {:from \"ed25519\", :to \"witness-quorum\", :kind :git-sha} {:from \"eth-crypto\", :to \"base-l2\", :kind :git-sha} {:from \"mst\", :to \"checkpointer\", :kind :git-sha} {:from \"multiformats\", :to \"checkpointer\", :kind :git-sha} {:from \"pqh\", :to \"checkpointer\", :kind :git-sha} {:from \"multiformats\", :to \"commit-dag\", :kind :git-sha} {:from \"dag-cbor\", :to \"commit-dag\", :kind :git-sha} {:from \"multiformats\", :to \"prolly-tree\", :kind :git-sha} {:from \"dag-cbor\", :to \"prolly-tree\", :kind :git-sha} {:from \"prolly-tree\", :to \"quad-store\", :kind :git-sha} {:from \"multiformats\", :to \"quad-store\", :kind :git-sha} {:from \"dag-cbor\", :to \"quad-store\", :kind :git-sha}], :zero-dep-leaves [\"ed25519\" \"dag-cbor\" \"multiformats\" \"did\" \"atproto\" \"mst\" \"eth-crypto\" \"crdt\"], :notable-facts [\"commit-dag has NO compile-time dependency on prolly-tree despite both being part of the same database-crates roadmap (ADR-2607022600) — a commit wraps an opaque state value\" \"koe's :dev alias has a stale :local/root (../langgraph-clj, ../langchain-clj) that resolves incorrectly from koe's current kotoba-lang location — the real targets are orgs/com-junkawasaki/{langgraph-clj,langchain-clj}; likely a leftover from before koe migrated orgs\" \"eth-crypto's own deps.edn header states it is lift-ready for extraction to com-junkawasaki/eth-crypto-clj — a directional tension against the general kotoba-lang-ward migration note in :orgs\" \"sha256d-clj (cluster 22) is the one deliberate counter-example to 'crypto belongs in kotoba-lang': its research/benchmark purpose needs algorithm-searchability that conflicts with the substrate's host-injected-vetted-crypto convention\"]}"), (:adr/related (vector "ADR-2606302300 (4-org taxonomy: kotoba-lang/etzhayyim/gftdcojp/com-junkawasaki role+scope, authoritative source for :orgs below)" "ADR-kotoba-lang-foundational-stdlib (stdlib P0/P1/P2/M5 tiers)" "ADR-2607010930 (clj-wgsl migration Phase 4 — the largest single cluster family: kami-engine crate restoration waves, ~150+ repos)" "ADR-2607011830 / -011930 / -011940 (etzhayyim-sdk relocation batch, 3 waves)" "ADR-2607022600 (kotoba database-crates cljc migration roadmap — commit-dag/prolly-tree/quad-store/kqe/kotoba-client)" "manifest/repos.edn (source of truth this ADR consolidates; every cluster below cites its origin comment/line region there)")), (:adr/phase-5-2026-07-02-fix-sweep "{:summary \"fixes for Phase 4's :findings (stale *-clj coords + monorepo-only coordinates), which surfaced and forced the fix of a REAL namespace collision between two published repos; west pins advanced for every repo touched today\", :fixed [{:repo \"signal\", :sha \"36cb3c11\", :fix \"io.github.com-junkawasaki/ed25519-clj -> io.github.kotoba-lang/ed25519, SAME pinned SHA ec077bca (reachable in the migrated repo, so the resolved tree is byte-identical — pure coordinate fix)\", :test-result \"23 tests / 62 assertions, 0 failures\"} {:repo \"inference\", :sha \"d4b8de31\", :fix \"org.kotoba-lang/{num,torch} :local/root (never resolvable as a git dep) -> io.github.kotoba-lang/{num,torch} main-HEAD pins; :dev alias keeps workspace-offline :local/root overrides\", :test-result \"12 tests / 125 assertions, 0 failures\"} {:repo \"kotoba\", :sha \"7096842d\", :fix \"all four :local/root ../../kotoba-lang/* deps (kotoba-core-contracts + kotoba-selfhost-contracts with bare non-github groups, kotoba-lang, cacao) -> main-HEAD git pins; :dev alias keeps offline overrides. A fresh standalone clone previously could not even build a classpath; now the full suite runs\", :test-result \"109 tests / 613 assertions, 0 failures\"} {:repo \"cacao\", :sha \"c88333c7\", :fix \"ns RENAME kotoba.cli -> cacao.cli (+ bin/kotoba, nbb.edn tasks, tests, README). Not in Phase 4's findings — discovered BY the kotoba fix: cacao and kotoba-lang/kotoba-lang both shipped a kotoba.cli ns (identity CLI vs canonical contract-dispatch CLI); on an alphabetized classpath cacao's src sorts first and silently hides kotoba.cli/dispatch. The monorepo :local/root era masked it; real git pins surfaced it as 'No such var: cli/dispatch'. No external consumer of the old ns found (org code search + the Phase-4 org-wide deps scan)\", :test-result \"21 tests / 115 assertions, 0 failures\"}], :not-fixed [{:repo \"kototama-clj\", :reason \"repo is ARCHIVED on GitHub (read-only since 2026-06-15) — the fix (kotoba-lang/{langgraph,langchain} git pins + :dev alias, 40 tests / 222 assertions green locally) was verified but cannot be pushed. Stale coords are moot for consumers while frozen; if the repo is ever unarchived, the verified patch applies as-is\"} {:repo \"kagi\", :reason \"kagitaba is still unpushed concurrent-session WIP (ADR-2607023000) — unchanged from Phase 4; pin after it lands on GitHub\"}], :west-pins-advanced {:note \"manifest/west.yml --entry minimal diff, all 12 verified server-side as pure fast-forwards (covers the ADR-2607023200 tag-42 chain pushed earlier today, which had not yet had its pins advanced, plus this phase's fixes)\", :entries [\"dag-cbor 9c60d583\" \"prolly-tree 8da6d1e1\" \"quad-store ecb99b8f\" \"commit-dag 05cc0473\" \"kotoba-client 92cbadab\" \"kqe 9901532a\" \"kotobase-engine 60d922b9\" \"net 20d99d1e\" \"signal 36cb3c11\" \"inference d4b8de31\" \"kotoba 7096842d\" \"cacao c88333c7\"]}}"), (:adr/status "accepted"), (:adr/id "adr-2607022800-kotoba-lang-org-dependency-map"), (:adr/phase-2-2026-07-02 "{:correction-kami-flow \"kami-flow was initially misjudged (in this ADR's original collision table\\n   above) as an unrelated Node.js/Cypher graph-ingest tool. That description\\n   actually belongs to an unrelated graph/ subdirectory sharing the same\\n   kami-engine/kami-flow/ folder path. kami-flow's own src/lib.rs is a\\n   genuine RTL->PnR->GDSII->Verify/Power/DFT/SI/Yield->STA->DRC/LVS->Signoff\\n   orchestrator, restored to kotoba-lang/kami-flow (ADR-2607010930 Phase 7),\\n   wiring 7 already-restored sibling EDA crates.\", :clj-suffix-rename-sweep {:convention \"-clj suffix is dropped on kotoba-lang migration UNLESS it would collide with an unrelated, older, still-live kotoba-lang/<short-name> repo (established pre-ADR by aero-clj->aero, crash-clj->crash, datom-clj->datom, echem-clj->echem, motor-clj->motor, vphysics-clj->vphysics, langchain-clj->langchain, langgraph-clj->langgraph)\", :renamed [{:from \"engine-clj\", :to \"engine\"} {:from \"kami-mangaka-page-clj\", :to \"kami-mangaka-page\"} {:from \"kami-mangaka-reader-clj\", :to \"kami-mangaka-reader\"} {:from \"kami-mangaka-render-clj\", :to \"kami-mangaka-render\"} {:from \"kami-mangaka-text-clj\", :to \"kami-mangaka-text\"} {:from \"kami-app-sip-clj\", :to \"kami-app-sip\"}], :kept-as-is [{:name \"kami-mangaka-scene-clj\", :reason \"collides with kotoba-lang/kami-mangaka-scene (separate Rust/PyO3-origin 3D crate, ADR-2607010930 Phase 7)\"} {:name \"kami-engine-sdk-clj\", :reason \"collides with kotoba-lang/kami-engine-sdk (pre-existing unrelated Svelte 5 UI component mirror)\"} {:name \"kototama-clj\", :reason \"genuinely distinct project from kotoba-lang/kototama (the WASM-runtime compiler), not a naming legacy\"}], :method \"gh repo rename (GitHub preserves history + sets up redirect from old name); manifest/repos.edn :extra-projects entry and manifest/west.yml name:/path: fields updated to match\"}, :post-rename-dep-fixes [{:repo \"kami-app-sip\", :fixed-deps [\"kami-mangaka-render-clj -> kami-mangaka-render\" \"kami-mangaka-page-clj -> kami-mangaka-page\"], :test-result \"pre-existing unrelated gap in sip.store/:datomic alias, unaffected\"} {:repo \"kami-mangaka-reader\", :fixed-deps [\"kami-mangaka-text-clj -> kami-mangaka-text\"], :test-result \"3 tests / 19 assertions, 0 failures\"} {:repo \"kami-mangaka-page\", :fixed-deps [\"kami-mangaka-text-clj -> kami-mangaka-text\"], :test-result \"7 tests / 21 assertions, 0 failures\"} {:repo \"koe\", :fixed-deps [\"io.github.com-junkawasaki/langgraph-clj -> io.github.kotoba-lang/langgraph (both main :deps and :dev :override-deps)\"], :note \"SHA unchanged across the rename (133740f...) — confirms pure coordinate fix, not a version skew\", :test-result \"3 tests / 13 assertions, 0 failures\"}], :full-org-dependency-graph {:scope \"all 377 kotoba-lang repos, parsed deps.edn (:git/url + :local/root entries)\", :deps-edn-coverage {:has-deps-edn 362, :no-deps-edn 15, :no-deps-edn-examples [\"homebrew-kotoba\" \"kami-engine\" \"kami-engine-sdk\" \"kotoba-adapter-contracts\" \"kotoba-lang-cli-contract\" \"kotoba-pages-poc\" \"kotoba-topology\" \"kotoba-v2025\" \"kotodama-cells\" \"kotodama-holochain\" \"kotodama-py\" \"kototama-cljc-contract\" \"lab\" \"svgraph\" \"yaml\"]}, :internal-dep-stats {:repos-with-kotoba-lang-deps 88, :standalone-leaf-repos 274, :total-edges 167, :multi-node-clusters 21}, :top-in-degree [{:repo \"css\", :count 13} {:repo \"html\", :count 12} {:repo \"scene\", :count 11} {:repo \"shitsuke\", :count 10} {:repo \"langchain\", :count 7} {:repo \"langgraph\", :count 5} {:repo \"chobo\", :count 5}], :top-clusters-by-size [{:size 35, :root \"css/html/shitsuke/chobo/mise\", :theme \"office/appkit/OOXML family\", :members [\"appkit\" \"banking\" \"card\" \"chobo\" \"css\" \"docs\" \"drawingml\" \"giemon\" \"html\" \"kami-engine\" \"kami-genko\" \"kiyaku\" \"kotoba-ui\" \"labor\" \"liquid-glass-ui\" \"logistics\" \"madoguchi\" \"mise\" \"office\" \"office-style\" \"ooxml\" \"phone\" \"presentationml\" \"property\" \"retail\" \"robotics\" \"senden\" \"sheets\" \"shitsuke\" \"slides\" \"soko\" \"swift\" \"transit\" \"uikit\" \"webrtc\"]} {:size 21, :root \"scene\", :theme \"kami-*-scene family, ADR-2607010930 Phase 7\", :members [\"atmosphere\" \"character\" \"cnc\" \"game\" \"input\" \"kami-atmosphere-scene\" \"kami-autodrive-scene\" \"kami-cam-scene\" \"kami-character-scene\" \"kami-game-scene\" \"kami-input-scene\" \"kami-postfx-scene\" \"kami-skeleton-scene\" \"kami-terrain-scene\" \"kami-vegetation-scene\" \"kami-vehicle-scene\" \"postfx\" \"scene\" \"skeleton\" \"terrain\" \"vegetation\"]} {:size 15, :root \"langgraph-clj/langchain-clj-descended\", :theme \"AI/cloud-control-plane actors\", :members [\"aero-clj\" \"authenticator\" \"computer-use\" \"crash-clj\" \"datom-clj\" \"echem-clj\" \"godaddy-dns\" \"kami-engine-vehicle-designer\" \"kekkai\" \"koe\" \"kotodama\" \"langchain-clj\" \"langgraph-clj\" \"motor-clj\" \"vphysics-clj\"], :note \"member names here are the STALE pre-rename coordinates found in these repos' deps.edn (see :known-stale-clj-refs) — the real target repos are aero/crash/datom/echem/motor/vphysics/langchain/langgraph\"} {:size 12, :root \"wgsl/gpu\", :theme \"shader/graphics DSL family\", :members [\"expr\" \"gpu\" \"render-shaders\" \"scene2d\" \"shaders\" \"sky\" \"sprite-gpu\" \"sprite2d\" \"text\" \"verilog\" \"webgl\" \"wgsl\"]} {:size 10, :root \"langchain/langgraph\", :theme \"browser/agent automation\", :members [\"browser\" \"browser-agent\" \"browser-use\" \"comfyui\" \"kagi\" \"kenchi\" \"langchain\" \"langgraph\" \"langgraph-store\" \"wasm-ui\"]} {:size 8, :root \"kami-flow\", :theme \"EDA signoff pipeline, ADR-2607010930 Phase 7\", :members [\"dft\" \"kami-flow\" \"model-checking\" \"pnr\" \"power\" \"rtl\" \"signal-integrity\" \"yield\"]} {:size 7, :root \"cae-solver\", :theme \"reduced-order vehicle CAE solvers\", :members [\"aero\" \"cae-solver\" \"crash\" \"datom\" \"echem\" \"motor\" \"vphysics\"]} {:size 6, :root \"kami-mangaka-*\", :theme \"mangaka *-clj split, ADR-2607010930 Phase 7 (post-rename names)\", :members [\"kami-app-sip\" \"kami-engine-sdk-clj\" \"kami-mangaka-page\" \"kami-mangaka-reader\" \"kami-mangaka-render\" \"kami-mangaka-text\"]}]}, :known-stale-clj-refs {:summary \"beyond the koe fix above, ~17 more deps.edn files were FLAGGED as possibly referencing OLD -clj-suffixed com-junkawasaki coordinates. Phase 3 (below) re-verified each candidate against a fresh deps.edn fetch: 8 had genuine stale references and were fixed; the other candidates (browser-use, kagi, langgraph-store, kenchi, and the bare langgraph/datom/vphysics/cae-solver entries) turned out NOT to actually contain the stale com-junkawasaki/<name>-clj pattern on closer inspection — the original flagging grep matched a broader/looser pattern than the actual issue.\", :fix-pattern \"replace io.github.com-junkawasaki/<name>-clj (and any :local/root sibling paths) with io.github.kotoba-lang/<name> (drop -clj) using either the resolved :git/tag SHA (when the original pinned a tag) or the current kotoba-lang/<name> main HEAD SHA (when the original only used :local/root with no version pin); keep :local/root only inside :dev-style workspace-checkout aliases, pointing at the new (no -clj) sibling dir name; verify via clojure -M:test\"}, :phase-3-2026-07-02-stale-clj-dep-fix-sweep {:summary \"fixed all 8 repos confirmed (via fresh deps.edn re-fetch) to still hold genuine stale com-junkawasaki/<name>-clj dependency coordinates, completing the :known-stale-clj-refs follow-up flagged in Phase 2\", :fixed [{:repo \"kami-engine-vehicle-designer\", :deps-fixed [\"langgraph-clj\" \"datom-clj\" \"vphysics-clj\" \"aero-clj\" \"crash-clj\" \"echem-clj\" \"motor-clj\" \"langchain-clj (:dev override)\"], :method \":local/root (never resolved outside a monorepo-sibling checkout) -> :git/url+:sha for all 7 in main :deps\", :test-result \"11 tests / 47 assertions, 0 failures\"} {:repo \"authenticator\", :deps-fixed [\"langchain-clj (main :deps + :dev override)\"], :method \":git/tag v0.1.1 preserved, SHA resolved to full 044ecb221e6dfc4a1e055e83b5996253aaa2eda8\", :test-result \"22 tests / 92 assertions, 0 failures\"} {:repo \"kotoba-code\", :deps-fixed [\"langchain-clj\" \"langgraph-clj\"], :method \":local/root \\\"../../com-junkawasaki/...\\\" (never worked outside monorepo layout) -> :git/url+:sha\", :test-result \"15 tests / 36 assertions, 0 failures\"} {:repo \"kekkai\", :deps-fixed [\"langgraph-clj (main :deps)\" \"langchain-clj (:dev override)\"], :method \":local/root -> :git/url+:sha for main dep\", :test-result \"19 tests / 66 assertions, 0 failures\"} {:repo \"computer-use\", :deps-fixed [\"langgraph-clj (main :deps + :dev override)\"], :method \":git/tag v0.2.0 preserved, SHA resolved to full 133740f3df2f4aa57e9e98b32f70e2483c025a7e\", :test-result \"13 tests / 60 assertions, 0 failures\"} {:repo \"kotodama\", :deps-fixed [\"langgraph-clj (main :deps + :dev override)\"], :method \":git/tag v0.2.1 preserved, SHA resolved to full eaab7d9bf4b66a76bf0927298b53232e4e6c6ed6\", :test-result \"7 tests / 17 assertions, 0 failures\"} {:repo \"kotoba-fleet\", :deps-fixed [\"langchain-clj (:kotoba alias :extra-deps)\"], :method \":local/root -> :git/url+:sha, isolated to the optional :kotoba test alias so the core lib stays dependency-free\", :test-result \"clojure -M:kotoba: 3 tests / 10 assertions, 0 failures\"} {:repo \"godaddy-dns\", :deps-fixed [\"langgraph-clj (main :deps + :dev override)\"], :method \":git/tag v0.2.0 preserved, SHA resolved to full 133740f3df2f4aa57e9e98b32f70e2483c025a7e\", :test-result \"8 tests / 38 assertions, 0 failures\"}], :total {:repos-fixed 8, :total-tests-passing 98, :total-assertions-passing 366, :total-failures 0}, :not-fixed-because-already-fine [\"browser-use\" \"kagi\" \"langgraph-store\" \"kenchi\" \"cae-solver\" \"langgraph\" \"datom\" \"vphysics\"]}}"), (:adr/doc_type "adr"), (:adr/clusters "[{:n 1, :theme \"fleet coordination substrate\", :adr \"ADR-2606302000\", :members [\"kotoba-fleet\" \"etzhayyim/com-etzhayyim-fleet\"], :rel \"20-agent lease/governor substrate\"} {:n 2, :theme \"junbi treasury/basket\", :adr \"ADR-2607021800\", :members [\"etzhayyim/com-etzhayyim-junbi\"], :rel \"reserve treasury actor + HAKARI basket\"} {:n 3, :theme