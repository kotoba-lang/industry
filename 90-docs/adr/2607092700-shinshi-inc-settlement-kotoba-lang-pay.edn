 :problem
 {:source "owner directive 2026-07-09: 'club-shinshi は etzhayyim じゃなくて shinshi inc
           にして。@etzhayyim/sdk は kotoba-lang repo で共通ライブラリにしなおして'"
  :investigated
  ["etzhayyim substrate boundary (orgs/etzhayyim/root/CLAUDE.md) prohibits external
    tip/subscription/purchase payment purposes — creator monetization was doctrinally
    incompatible with consuming etzhayyim's rail from the start"
   "vendor->etzhayyim consumption crossover had no worked example in ADR-2605211950 and
    was blocked on etzhayyim-side review"
   "@etzhayyim/sdk implementation state: only pay() real; payStream/splitDistribute/
    verify() are stubs; missing verify() alone forces HARD-hold on every entitlement"
   "relocation precedent + building blocks already in kotoba-lang: base-l2 (relocated
    from etzhayyim-sdk per ADR-2607011940), treasury (USDC on-chain verification +
    ledger = the verify() shape), wallet (non-custodial signing), kessai (fiat ISO
    sibling)"
   "club-shinshi/net-babiniku already transferred to jk-luxury (JK株式会社) 2026-07-06
    per ADR-2607062300 — the corporate vessel exists"]
  :risk "adult-business crypto settlement needs per-jurisdiction legal review (資金決済法/
         AML); this ADR moves the code home and the operating entity, it does not clear
         legal gates"}

 :decision
 {:operator "JK株式会社 ('Shinshi Inc.', org jk-luxury) owns creator-monetization
             settlement, platform take (20% of 80/20), and PSP/AML/regulatory posture
             for club-shinshi + net-babiniku; etzhayyim uninvolved"
  :new_repo "kotoba-lang/pay"
  :library
  {:layer_contract "pure .cljc, zero network I/O, zero key custody — same as
                    kotoba-lang/base-l2 and treasury"
   :pure ["parse-usdc / format-usdc (6-decimal micros, truncating parse)"
          "flow-rate-per-second (Superfluid-shaped)"
          "split-allocations / creator-platform-split (80/20, dust to creator,
           total invariant)"
          "capability-errors / valid-capability? / expired? (generalized
           net.babiniku.monetization.capability shape)"
          "->receipt (string micros on the wire)"
          "entitle = verify-before-honor decision (grant only on host-verified
           settlement covering the authorized amount)"]
   :seam "PayRail protocol (-pay! -pay-stream! -pay-stream-stop! -split-distribute!
          -escrow-open! -escrow-release!) — hosts back with base-l2 (transfer/ERC-4337),
          treasury (verification), wallet (signing)"
   :honest_default "unprovisioned-rail HOLDs every operation with
                    :pay/unprovisioned-capability — never fake a settlement"
   :verified "7 tests / 49 assertions green (clojure -M:test), clj-kondo errors 0"}
  :chain_stack_unchanged "Base L2 / USDC・EURC・JPYC / passkey smart wallet /
                          payer-device signing / no platform-held private key —
                          the operator and code home change, not the cryptographic rail"
  :economic_gate_update "reverse-toposort B3 gate (creator-monetization unlock) moves
                         from 'etzhayyim review + SDK stub implementation' to
                         'kotoba-lang/pay rail adapters + treasury verification wiring',
                         fully owned on the Shinshi Inc side; ignition order unchanged:
                         shinshi tip -> babiniku tip/subscribe -> GMV demand into
                         murakumo/net-kotobase -> kotoba/kotobase identity layer"}

 :consequences
 {:canvas_followup "club-shinshi canvas 準備項目 'PSP/crypto rail 解禁' now references
                    kotoba-lang/pay + JK株式会社 — update via gftd canvas note (generated
                    md not hand-edited)"
  :crossover_review_moot "ADR-2607071000's pending etzhayyim-side crossover review is no
                          longer needed (the crossover no longer exists)"
  :followups ["Superfluid / 0xSplits / Safe-escrow PayRail adapters"
              "first consumer wiring: club-shinshi tip with treasury verification feeding
               entitle"
              "consider neutral NSID for the monetization capability lexicon"
              "deps wiring in jk-luxury/club-shinshi and jk-luxury/net-babiniku"]
  :out_of_scope "@etzhayyim/sdk non-payment surfaces (atproto/encrypted/ipfs/...) stay
                 etzhayyim-internal"}

 :alternatives
 [{:option "keep ADR-2607071000's design (vendor consumes etzhayyim rail)"
   :rejected_because "doctrinally incompatible (etzhayyim prohibits external
                      tip/subscription/purchase) and organizationally blocked
                      (unreviewed crossover, unimplemented stubs)"}
  {:option "fold the surface into kotoba-lang/treasury or kessai instead of a new repo"
   :rejected_because "treasury is quote/verify/ledger and kessai is fiat ISO rails —
                      both are composed BY pay, not homes for the creator-rail surface;
                      a focused repo keeps the layer boundaries legible"}
  {:option "port the TS SDK as-is (viem, key-holding PayClient)"
   :rejected_because "violates the kotoba-lang layer contract (zero vendor SDK, zero
                      custody) and the repo-wide runtime priority (.cljc first);
                      the EOA privateKey PayClient also contradicted the no-server-key
                      invariant the SDK itself stated"}]}
