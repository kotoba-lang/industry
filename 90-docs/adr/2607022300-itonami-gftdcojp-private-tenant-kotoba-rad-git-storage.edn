{:frontmatter
 {:id "adr-2607022300-itonami-gftdcojp-private-tenant-kotoba-rad-git-storage"
  :title "ADR-2607022300: gftdcojp/gftdcojp を itonami.cloud の private tenant として登録し、itonami.cloud の repo storage を GitHub 依存から kotoba-git/kotoba-rad 主権層へ段階移行する"
  :status "proposed"
  :date "2026-07-02"
  :deciders ["Jun Kawasaki"]
  :doc_type "adr"
  :topic "itonami-gftdcojp-private-tenant-kotoba-rad-git-storage"
  :authoritative true
  :authoritative_for ["gftdcojp(org)/gftdcojp(repo) を itonami.cloud の private tenant として bootstrap すること（public sanitized read を経由しない）"
                       "gftdcojp/gftdcojp の認証を CACAO/did:key 自己発行モデルに揃え、ITONAMI_OPERATOR_TOKEN 共有 token 方式を採用しないこと"
                       ":itonami.repo/visibility 属性を追加し既定を :private とすること"
                       "orgs/gftdcojp/cloud-itonami の Pages Functions API 実体が 2026-07-01 に削除済みであるという事実の記録（ADR-0002 は書き換えず本ADRで補足）"
                       "itonami.cloud の repo storage を GitHub 依存から kotoba-git(R0)/kotoba-rad(R1/R2, ADR-2606280300) 主権層へ段階移行する方針と、GitHub を public repo のみの one-way publish mirror に格下げする長期方向"]
  :supersedes []
  :superseded_by []
  :related ["adr-2606271700-cloud-itonami-business-os"
            "adr-2606280300-kotoba-rad-git-sovereign-repo"
            "orgs/gftdcojp/cloud-itonami/docs/adr/0001-cloudflare-pages-operator-cockpit.md"
            "orgs/gftdcojp/cloud-itonami/docs/adr/0002-org-repo-tenant-isolation.md"
            "orgs/gftdcojp/ai-gftd-itonami/src/itonami/cacao.clj"]
  :last_verified "2026-07-02"}

 :decision
 {:tenant {:org "gftdcojp"
           :repo "gftdcojp"
           :visibility :private
           :auth :cacao-did-key
           :route "itonami.cloud/gftdcojp/gftdcojp"
           :data-source "orgs/gftdcojp/m365-archive/facts"
           :store "cloud-itonami.kotoba (production kotoba conn)"}
  :storage-migration
  {:short-term "business activity/effect/audit data only, via existing kotoba/datom model"
   :mid-term "itonami.cloud pulls repo checkouts via kotoba-git (R0, implemented) instead of GitHub"
   :long-term "kotoba-rad R1 (RepoIdentity/RepoRid/RepoEvent/Delegate/RefPolicy/RecipientGrant) + R2 (encrypted private objects) become itonami.cloud's repo storage backend; GitHub becomes public-only one-way publish mirror"}}

 :known-gaps
 ["ADR-0002 Pages Functions API (functions/api/[[path]].js) removed 2026-07-01 (638bdc3); no live API currently serves itonami.cloud"
  "kotoba-rad R1/R2 not yet implemented (status: next / next-after-R1 per ADR-2606280300)"
  "company.cljc ingestion does not yet tag activities with :itonami.activity/repo or transact to production kotoba store"]

 :follow-up
 ["addendum to orgs/gftdcojp/cloud-itonami/docs/adr/0002-org-repo-tenant-isolation.md noting API removal"
  "kotoba-rad R1 implementation (orgs/com-junkawasaki/kotoba crates: kotoba-git rad module or new kotoba-rad crate)"
  "CACAO-authenticated itonami.cloud API layer design/implementation"]}
