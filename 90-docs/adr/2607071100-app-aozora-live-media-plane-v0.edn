[{:adr/authoritative_for ["live.aozora.app (app-aozora-live Worker) の ingest/serve 契約 —\n    PUT/DELETE /ingest/<id>/<name>, GET /s/<id>/<name>,\n    app.aozora.live.{startBroadcast,stopBroadcast,listBroadcasts}" "broadcast 認可 (INGEST_SECRET → ingestToken = HMAC-SHA256(secret, id))" "producer 経路 — OBS→ffmpeg local HLS + watcher アップローダ\n    (40-engine/cljs/live/scripts/live-relay.cljs)。ffmpeg 直 HTTP PUT が\n    Cloudflare edge に破棄される実測と回避" "ライブ告知の書式 — 通常 post + app.aozora.embed.video {playlist, live:true}"], :adr/supersedes [], :adr/superseded_by [], :adr/topic "app-aozora-live-media-plane", :adr/related ["90-docs/adr/2606271500-kotoba-stage-obs-live-aozora.md" "90-docs/adr/2607062100-app-aozora-vertical-video-feed.md" "90-docs/adr/2607071000-app-aozora-video-upload-r2-blob.md"], :adr/status "accepted", :adr/id "adr-2607071100-app-aozora-live-media-plane-v0", :adr/doc_type "adr", :adr/last_verified "2026-07-07", :adr/implementation "{:repo \"gftdcojp/app-aozora\", :merges [\"0d724f6f3ab7 (worker+lexicon+relay)\" \"7290caf2a061 (gitignore fix)\" \"ac1660619e94 (waitUntil)\" \"ed854658bd5b (watcher relay)\"], :infra [\"R2 bucket aozora-live-segments 作成\" \"wrangler secret INGEST_SECRET 設定 (Keychain aozora-live-ingest 控え)\" \"Worker app-aozora-live → live.aozora.app デプロイ\"], :verification [\"E2E: nbb live-relay.cljs --mode test --duration 20 → 10 segments + ENDLIST、\\n    公開 URL から ffprobe h264+aac デコード成功\" \"配信中 listBroadcasts live:true → 終了後 false\" \"誤 secret 403 / トークン無し PUT 403\" \"tests: aozora.live.core-test 含む 267 tests / 1152 assertions green\"]}", :adr/decision "{:chosen [\"新 Worker app-aozora-live (cljs, 40-engine/cljs/live) @ live.aozora.app。\\n    PUT/DELETE /ingest/<id>/<name> (Bearer ingestToken) → R2\\n    aozora-live-segments (key live/<id>/<name>)、GET /s/<id>/<name> 公開再生\\n    (playlist no-store / segment immutable, CORS *)\" \"認可: INGEST_SECRET (wrangler secret, Keychain aozora-live-ingest 控え) が\\n    operator 資格。ingestToken = HMAC-SHA256(secret, broadcastId) — stateless\" \"liveness: playlist の R2 uploaded 時刻が heartbeat (90s 窓)。stopBroadcast\\n    は .ended marker。VOD replay は hls_list_size 0 + ENDLIST\" \"producer は local HLS 出力 + watcher アップローダ (live-relay.cljs):\\n    segment は playlist 参照時点=完成でアップロード → その後 playlist PUT\\n    (プレイヤーが 404 segment を引かない順序)。--mode obs (RTMP listen -c copy)\\n    / --mode test (testsrc2+sine)\" \"告知は通常 post + app.aozora.embed.video {playlist, live:true} —\\n    /videos が再生し LIVE バッジ (kotoba.video live? は embed :live も判定)\" \"lexicon: app.aozora.live.{startBroadcast,stopBroadcast,listBroadcasts} +\\n    record 予約 broadcast。旧設計名 getIngestTicket/getPlaylist/getViewerTicket\\n    からの命名変更は本 ADR が正\"], :rejected [{:option \"ffmpeg -method PUT で直接 ingest\", :why \"実測 (2026-07-07): ffmpeg は response を読まず socket を閉じ、\\n          Cloudflare edge は完全な chunked body でも破棄 (raw-socket 再現:\\n          response 読取り有→200/永続、無→404)。ctx.waitUntil でも救えない\\n          (Worker 到達前に edge で破棄)。-http_persistent 1 は 2 本目が\\n          Canceled で stall\"} {:option \"WHIP/DTLS-SRTP 終端を v0 に含める\", :why \"native SRTP or WebTransport が必要な別規模の工事 (ADR-2606271500\\n          残課題のまま follow-up)。v0 の HLS ingest はそれを待たず実配信できる\"} {:option \"Durable Object で playlist 状態管理\", :why \"producer 単一 writer なので R2 直置き + mtime heartbeat で足りる。\\n          v0 に DO の複雑さは不要\"}]}", :db/id -1, :adr/follow-ups ["WHIP/ICE/DTLS-SRTP 終端・RTP→CMAF・LL-HLS (ADR-2606271500 本体)" ":live/segment datom 台帳 / IPFS セグメント配布 (v0 は R2 のみ)" "視聴チケット (v0 は公開読み)・startBroadcast の CACAO 化" "SPA からの告知 post 自動作成 (v0 は relay が embed JSON を印字)" "kotoba-stage (CLJ シーングラフ合成)"], :adr/problem "{:source \"オーナー指示 (2026-07-07): ADR-2606271500 media plane 残課題に着手\", :facts [\"ADR-2606271500 の実装は現存せずゼロから (2026-07-01 追記)。残課題は\\n    WHIP/SRTP 終端 + RTP→CMAF という大物\" \"v0 に最低限必要なのは HLS を書ける producer と認証付き content store +\\n    公開再生パスだけ — サーバは RTP を触る必要がない\" \"ライブ配信インフラは repo 横断でゼロ (lexicon も Worker も storage も無し、\\n    2026-07-07 調査)\"]}", :adr/authoritative true, :adr/title "ADR-2607071100: app-aozora — ライブ配信 media plane v0 (HLS HTTP ingest、ADR-2606271500 の実装スライス)"}]