(vector (map (:db/id -1)
  (:adr/id "adr-2607183400-kami-media-bus-send-cross-dissolve")
  (:adr/title "KAMI media applications add DAW bus sends and NLE audiovisual cross-dissolve")
  (:adr/date "2026-07-18")
  (:adr/status "accepted")
  (:adr/authoritative true)
  (:adr/topic "kotoba-lang-media-authoring")
  (:adr/supersedes (vector "adr-2607183300-kami-media-automation-stems-professional-trim"))
  (:adr/decision
  (map (:daw (map (:routing (map (:track-output :named-bus)
                   (:send (map (:effect :feedback-delay) (:delay-ms 180)))))
         (:authority "Realtime playback and OfflineAudioContext master export consume the same track bus and send values.")))
   (:nle (map (:transition (map (:type :dissolve)
                      (:picture "Two stable HTMLVideoElement decoders are alpha-composited into the export canvas.")
                      (:audio "Complementary Web Audio gain ramps mix both source soundtracks into the MediaRecorder stream.")))
         (:authority "render-segments transition metadata drives the production scheduler; decoder identity is kept separate from React refs.")))
   (:maturity (map (:kami-app-daw :逍遥) (:kami-app-nle :逍遥)))
   (:remaining-commercial-gates (map (:daw (vector "recording" "plugin hosting" "bus automation" "LUFS/true-peak" "stem bundle"))
                                (:nle (vector "pointer trim gestures" "proxy/cache" "color management" "audio meters/mixer" "codec/container presets"))))))
  (:adr/implementation
  (map (:daw-commits (vector "d899782" "d31f525"))
   (:nle-commits (vector "096b480" "14015dc"))
   (:evidence (vector "Both repository Pages workflows completed tests, release compilation and deployment successfully."
              "DAW Pages Chrome exported 5.0-second dry and 0.85-send WAV masters without console errors; 134946 samples differ, with wet-minus-dry RMS 0.003209."
              "NLE Pages Chrome exported a 174500-byte WebM without console errors from real red/440 Hz and blue/660 Hz sources."
              "NLE master center pixels measured red (253,0,0) at 4.40 s, mixed (101,0,91) at 4.90 s, blue (4,1,220) at 5.10 s, and remained blue (0,0,253) at 6.00 s."
              "NLE transition audio FFT windows showed both sources and complementary progression: at 4.85/4.95/5.05 s, 440 Hz magnitudes were 177.83/119.11/70.07 while 660 Hz magnitudes were 34.88/82.47/142.31."))))
  (:adr/consequences
  (vector "DAW bus/send routing is production audio behavior rather than project metadata alone."
   "NLE cross-dissolve is proven in the downloadable master for both picture and source audio."
   "Commercial parity is not claimed; the remaining gates stay explicit and retain the current maturity level."))
  (:adr/source-format "edn")))
