[{:db/id -1, :adr/id "2607011700", :adr/title "kotoba-lang/webrtc: WebRTC signaling/session as pure data contracts", :adr/status :accepted, :adr/date "2026-07-01", :adr/context "{:gap \"no video-call/WebRTC library exists; closest relatives are kotoba-lang/phone (telephony records) and kotoba-lang/koe (voice-session ports + dialog loop), neither covers video/media negotiation\", :placement-check \"ADR-2606302300 step-1 layer test: pure .cljc, zero I/O, records/protocol-only -> kotoba-lang; actual signaling server / TURN-STUN / browser RTCPeerConnection integration fails step-1 and needs step-2 3-axis+Charter Rider classification, explicitly out of scope here\"}", :adr/decision "{:repo \"kotoba-lang/webrtc\", :style \"records, not wire format (same rationale as kotoba-lang/card ISO 8583 and kotoba-lang/swift MT/ISO 20022)\", :namespaces {:kotoba.webrtc {:models [\"ice-candidate (RFC 8445: foundation, component, transport, priority, address, port, candidate-type, related-address, related-port)\" \"sdp-session / media-description (RFC 8866-shaped: origin, kind, direction, codecs, mid, ice-ufrag, ice-pwd, dtls-fingerprint)\"], :features [:construct :validate]}, :kotoba.webrtc.session {:pattern \"pure signaling negotiation reducer, host-injected effects (same separation of concerns as koe's dialog loop)\", :states [:idle :have-local-offer :have-remote-offer :connecting :connected :disconnected :failed :ended], :effects [:send-offer :send-answer :send-ice-candidate], :fn \"apply-event: session x event -> {:session next-session :effects [...]}\"}, :kotoba.webrtc.room {:models \"multi-party room membership: participants, tracks, join/leave\", :style \"pure functions over an EDN room record, SFU-style multi-party calls\"}, :kotoba.webrtc.stats {:models \"RTCStats-shaped quality record: packets-lost, jitter, round-trip-time\", :fn \"quality classifier -> :good | :degraded | :poor\"}, :kotoba.webrtc.ui {:deps [:kotoba-lang/html :kotoba-lang/css], :note \"read-only operator dashboard, matches phone/banking/card/swift house pattern\"}, :kotoba.webrtc.export {:formats [:csv :json], :note \"matches phone/banking/card/swift house pattern\"}}}", :adr/consequences ["fills the video-call gap for kotoba-lang without expanding into an actual signaling server or browser integration (deferred to ADR-2606302300 step-2 classification)" "host runtimes (browser cljs app, or a future gftdcojp/etzhayyim video-call actor) supply their own RTCPeerConnection/getUserMedia/signaling-transport bindings and consume this library for negotiation-state + room-membership logic" "deps.edn depends on kotoba-lang/html + kotoba-lang/css for the dashboard; :test/:lint aliases match house convention (cognitect test-runner + clj-kondo)"]}]