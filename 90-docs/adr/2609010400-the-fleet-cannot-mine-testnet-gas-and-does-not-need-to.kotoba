  (:adr/date "2026-09-01")
  (:adr/related (vector "adr-2609010200-a-faucet-gated-by-a-passkey-issues-the-grant-not-only-the-tokens"
                "adr-2609010100-the-passkey-is-the-root-and-the-first-spend-limit-is-the-balance"
