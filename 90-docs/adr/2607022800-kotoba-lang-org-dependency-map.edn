 ;; 4-org taxonomy (authority: ADR-2606302300). gen-west-manifest.bb does NOT read
 ;; this — doc-only policy metadata for where a NEW repo should be created.
 :orgs
 {"kotoba-lang"
  {:role :language-substrate
   :scope :platform
   :note "pure-CLJC language + core library substrate; every other org consumes it"}
  "etzhayyim"
  {:role :agent-centric
   :scope :public-interest
   :note "com-etzhayyim-* organism actors (UNSPSC/ISCO/COFOG-flavored)"}
  "gftdcojp"
  {:role :human-centric
   :scope :business
   :note "ai-gftd-* products/services, apps, talent"}
  "com-junkawasaki"
  {:role :transitional-foundation
   :scope :private-foundation
   :note "shrinking toward data-only (e.g. spirit-in-physics); language core already migrated to kotoba-lang via :path-overrides, generic -clj foundation libs slated to follow (decided 2026-06-30)"}}

