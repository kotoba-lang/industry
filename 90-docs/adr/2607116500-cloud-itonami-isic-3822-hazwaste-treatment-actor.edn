  :adr/decision-summary "{:pattern \"sealed HazWasteTreatment-LLM + independent HazWasteGovernor + append-only audit ledger, tracks manifest chain-of-custody and treatment-authorization state only -- never arranges/executes physical transport or treatment\", :new-actor \"cloud-itonami-isic-3822\", :org \"cloud-itonami\", :repo \"https://github.com/cloud-itonami/cloud-itonami-isic-3822\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"3822\", :isic-name \"Treatment and disposal of hazardous waste\", :namespace \"hazwaste\", :registry-promotion \"kotoba-lang/industry registry.edn id 3822: :maturity :spec (dead gftdcojp/cloud-itonami-E3822 placeholder) -> :implemented\", :sibling \"deliberately distinct from cloud-itonami-isic-3811 (non-hazardous waste collection dispatch) -- 3811 dispatches NON-hazardous streams under a hazard-misclassification-gate that rejects anything hazardous, 3822 treats/disposes HAZARDOUS waste itself under a much heavier regulatory regime\", :governor-checks [{:check :rbac :severity :hard} {:check :manifest-chain-of-custody-gate :severity :hard :note \"new -- no analog in other cloud-itonami actors; every hazardous shipment must carry an unbroken signed chain generator->transporter->facility (40 CFR Part 262), a missing/unsigned step is rejected regardless of confidence\"} {:check :treatment-method-authorization-gate :severity :hard :note \"new -- the facility must hold an ACTIVE permit authorizing both the specific waste-code and the specific treatment method; an unauthorized combination or a lapsed permit is rejected\"} {:check :source-provenance-gate :severity :hard} {:check :licensed-disclosure :severity :hard} {:check :confidence-floor :severity :soft-escalate} {:check :cross-border-gate :severity :soft-escalate :note \"any shipment flagged cross-border always escalates, Basel Convention transboundary-movement oversight, regardless of confidence\"} {:check :dispute-request :severity :soft-escalate-unconditional}], :r0-scope {:source-catalog [\"US EPA RCRA Subtitle C Uniform Hazardous Waste Manifest (40 CFR Part 262)\" \"EU Waste Shipment Regulation (Regulation (EC) No 1013/2006)\" \"Basel Convention transboundary movement notification/consent document\"]}, :robotics {:value false, :key-present false, :rationale \"manifest and treatment-record management only -- the physical treatment act itself is outside the actor's boundary\"}, :test-results {:unit-tests \"28 tests / 98 assertions, 0 failures\", :lint \"0 errors, 0 warnings\", :demo \"clojure -M:dev:run verified end-to-end, all 7 scenarios fire correctly\"}, :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention. kotoba-lang/industry pin advanced in manifest/west.yml (--entry industry, minimal diff)\"}"
