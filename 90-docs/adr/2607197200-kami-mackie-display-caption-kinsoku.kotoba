(vector (map (:db/id -1)
  (:adr/id "adr-2607197200-kami-mackie-display-caption-kinsoku")
  (:adr/title "KAMI adds Mackie displays and language-aware caption breaking")
  (:adr/date "2026-07-19")
  (:adr/status "accepted")
  (:adr/authoritative true)
  (:adr/topic "kotoba-lang-media-authoring")
  (:adr/supersedes (vector "adr-2607197100-kami-mackie-touch-imsc-ruby"))
  (:adr/decision
  (map (:daw (map (:scribble-strip (map (:transport :mackie-lcd-sysex)
                          (:bank-size 8) (:characters-per-track 7)
                          (:encoding :printable-ascii-with-question-mark-fallback)
                          (:refresh (vector :connect :bank-change))))
         (:time-display (map (:transport :channel-cc-0x40-through-0x49)
                        (:format :bar-beat-subdivision-tick)
                        (:digits 10) (:maximum-refresh-hz 10)))
         (:permission (map (:request-sysex true) (:fallback :ordinary-midi-with-time-display)))))
   (:nle (map (:line-breaking (map (:authority :shared-pure-caption-contract)
                         (:bounded-units (map (:minimum 4) (:maximum 80)))
                         (:cjk-languages (vector :ja :zh))
                         (:cjk-rules (vector :line-start-kinsoku :line-end-kinsoku))
                         (:other-languages :word-boundary-first)
                         (:overlong-token :bounded-split)))
         (:consumers (vector :editorial-accessible-preview :canvas-preview :production-capture))
         (:semantic-delivery-text :unchanged)))
   (:maturity (map (:kami-app-daw :逍遥) (:kami-app-nle :逍遥)))
   (:remaining-commercial-gates
   (map (:shared (vector "persistent directory grants" "streaming package I/O above 512 MiB"))
    (:daw (vector "third-party plugin SDK/isolation" "certified hardware profiles" "surround/Atmos"))
    (:nle (vector "continuous/interpolated TTML animation" "dictionary-grade morphological line breaking" "external notification delivery" "translation memory" "OCIO/ICC/HDR"))))))
  (:adr/implementation
  (map (:daw-commits (vector "dabe4c5"))
   (:nle-commits (vector "3322c05"))
   (:pull-requests (vector "kotoba-lang/kami-app-daw#30" "kotoba-lang/kami-app-nle#30"))
   (:evidence
   (vector "DAW passes 36 tests and 166 assertions; NLE passes 37 tests and 183 assertions."
    "Both guarded production releases generated non-empty optimized main.js artifacts."
    "Chrome requested SysEx, observed exact bank-one and bank-two LCD labels, and received ten ASCII-digit time-display CC messages."
    "Chrome decoded a real WebM and exposed a multi-line Japanese editorial preview whose lines obeyed start/end kinsoku and rejoined to the exact source caption."
    "Both browser consoles had zero errors; Chrome closed in finally and both local servers were stopped."))))
  (:adr/consequences
  (vector "Operators can identify banked tracks and musical position without looking away from a Mackie-compatible surface."
   "Caption preview and production capture no longer break Japanese punctuation at prohibited boundaries or ordinary Latin words arbitrarily."
   "Hardware certification, dictionary-grade morphology, continuous TTML animation and third-party audio plugin isolation remain explicit gaps."))
  (:adr/source-format "edn")))
