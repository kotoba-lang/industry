(vector (map 
  (:db/id -1)
  (:adr/id "adr-2608301600-tamaki-and-cloud-itonami-are-separate-planes")
  (:adr/title "tamaki と cloud-itonami は別の面。scheduler は機構が kotoba-lang、配備が cloud-itonami")
  (:adr/status :accepted)
