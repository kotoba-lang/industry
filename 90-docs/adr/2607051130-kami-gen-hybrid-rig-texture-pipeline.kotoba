(vector (map (:adr/authoritative_for (vector "new repo kotoba-lang/kami-gen-hybrid: deterministic parametric humanoid body/rig from\n    kotoba-lang/character (shared with kami-gen-procedural) + LLM-authored comfyui-clj\n    node-graph EDN generating only texture maps (albedo/normal/roughness), assembled via\n    kotoba-lang/vrm" "texture execution is injected (DI): real comfyui-clj run needs a live ComfyUI/diffusion\n    backend not present yet (generate.html backend status table: image=TODO); mock executor\n    returns fixture textures for CI / no-GPU comparison leg" "cannot reproduce the reference image's non-humanoid rounded penguin-suit silhouette,\n    only its surface coloring as a texture skin over a humanoid body shape" "one of 4 sibling approaches built for a head-to-head comparison against the same\n    photoreal chibi-penguin-kigurumi reference image target")), (:adr/supersedes (vector)), (:adr/superseded_by (vector)), (:adr/topic "kami-gen-hybrid"), (:adr/related (vector "adr-2607051100" "adr-2607051110" "adr-2607051120")), (:adr/status "accepted"), (:adr/id "adr-2607051130-kami-gen-hybrid-rig-texture-pipeline"), (:adr/doc_type "adr"), (:adr/last_verified "2026-07-05"), (:adr/body "see 2607051130-kami-gen-hybrid-rig-texture-pipeline.edn"), (:adr/deciders (vector "Jun Kawasaki")), (:adr/date "2026-07-05"), (:db/id -1), (:adr/authoritative true), (:adr/title "ADR-2607051130: kotoba-lang/kami-gen-hybrid — deterministic rig + ML-textured costume pipeline (Approach 4 of 4)"), (:adr/source-format "edn")))