  ;; ISIC Rev.5 8010: private security activities (guarding, patrol, escort,
  ;; monitoring under contract). Pre-existing :blueprint-tier repo (docs
  ;; published, no code) filled in, not recreated. Coordination-only:
  ;; patrol/checkpoint/incident-report data logging, guard-shift scheduling
  ;; proposals, equipment-supply coordination, incident-concern flagging.
  ;; Genuinely high-stakes (physical security / use-of-force adjacency) --
  ;; a stricter governor discipline than most cloud-itonami verticals:
  ;; dispatch-to-respond, use-of-force authorization, and detention/arrest
  ;; are ALWAYS a permanent HARD block, never merely human-gated.

  :actor/id :cloud-itonami-isic-8010
  :actor/name "Private Security Operations Coordinator"
  :actor/isic-rev5 "8010"
  :actor/domain :commercial/private-security-services
  :actor/wave 4
  :actor/coordination? true
  :actor/robotics? false
  :actor/pre-existing-blueprint-repo? true

  :actor/proposal-ops [:log-patrol-record :schedule-guard-shift
                        :coordinate-equipment-supply :flag-incident-concern]
  :actor/always-escalate-ops [:flag-incident-concern]

  :actor/hard-checks [:assignment-verified :effect-propose :scope-exclusion]
  :actor/scope-exclusion-phrasing :action-not-noun
  :actor/scope-excluded-terms ["dispatch a guard to respond" "dispatch to respond"
                                "authorize the use of force" "authorize use of force"
                                "use-of-force authorization"
                                "authorize detention" "authorize an arrest"
                                "place under arrest" "detain the individual"
                                "現場へ急行させる" "現場への出動を指示"
                                "実力行使を許可" "武力行使を許可"
                                "拘束を許可" "逮捕を許可"]
  :actor/self-trip-regression-test :guardops.governor-test/default-mock-advisor-proposals-never-self-trip-scope-exclusion

  :phase/rollout
  {0 {:label "read-only" :writes #{} :auto #{}}
   1 {:label "assisted-logging" :writes #{:log-patrol-record} :auto #{}}
   2 {:label "assisted-coordination" :writes #{:log-patrol-record :schedule-guard-shift
                                               :coordinate-equipment-supply}
      :auto #{}}
   3 {:label "supervised-auto" :writes #{:log-patrol-record :schedule-guard-shift
                                         :coordinate-equipment-supply :flag-incident-concern}
      :auto #{:log-patrol-record :schedule-guard-shift :coordinate-equipment-supply}}}

