 :decision
 {:product "cloud-murakumo"
  :placement :gftdcojp
  :subject :gpu-serverless-cloud
  :definition "Modal(GPU serverless: App/Function/Image/Volume/Secret/autoscale/scale-to-zero/endpoint/cron)を Python decorator ではなく clj+kotoba(CID+Datom+WASM)+datomic の EDN datom に落とす分散 GPU cloud。cloud-itonami が manimani(business)を datom 化したのと対称。"
  :ssot "resources/murakumo.edn"
  :relationship {:murakumo "kotoba mesh 制御面(≅ wadm/wash)。cloud-murakumo は GPU 在庫を bid 対象に乗せた製品面で murakumo を置き換えない。"
                 :minimax-m2-modal "最初の実 app(:llm-serving)として吸収。serve コマンドは cloud-murakumo.vllm に一般化。"
                 :cloud-itonami "同じ設計原則(EDN SSoT / .cljc 正本 / 承認 gate / kotoba datom log)の GPU 版。"}
  :core_ns [:murakumo.app :murakumo.fn :murakumo.image :murakumo.node
            :murakumo.placement :murakumo.run :murakumo.effect :murakumo.audit]
  :implementation {:language ".cljc"
                   :ssot "resources/murakumo.edn"
                   :schema "cloud-murakumo.schema"
                   :spec "cloud-murakumo.spec"
                   :scheduler "cloud-murakumo.scheduler"
                   :vllm "cloud-murakumo.vllm"
                   :runtime "cloud-murakumo.runtime"
                   :cli "cloud-murakumo.cli"
                   :store "kotoba-datomic / langchain.kotoba-db XRPC"
                   :env ["KOTOBA_URL" "KOTOBA_GRAPH" "KOTOBA_TOKEN" "LLM_KEY"]}}

 :modal_equivalences
 {"@app.function(gpu=...)" :murakumo.fn
  "App / modal deploy"     [:murakumo.app "clj -M:deploy"]
  "Image / Dockerfile"     :murakumo.image
  "Volume"                 [:murakumo.volume :kotoba-cid :b2]
  "Secret"                 [:murakumo.secret "参照のみ(実値は scripts/b2-creds.bb)"]
  "autoscale / scale-to-zero" "cloud-murakumo.spec/desired-replicas (target-concurrency, [min max] clamp)"
  "container scheduler"    "cloud-murakumo.scheduler/plan-placements (murakumo lattice bid auction)"
  "usage / 課金"           [:murakumo.run/gpu-seconds "cloud-murakumo.scheduler/hourly-cost"]
  "web_endpoint"           [:murakumo.fn/endpoint "kotoba on-http trigger"]
  "scheduled / Cron"       [:murakumo.fn/schedule "kotoba on-tick trigger"]}

 :scheduler
 {:model "GPU-aware bin-packing auction(murakumo lattice の leaderless bid)"
  :bid "gpu単価 × 個数 + 断片化ペナルティ(best-fit)"
  :tie_break "node 出現順で決定的(再実行で同一結果)"
  :class_match {:strict :gpu/class :flexible :gpu/min-vram-cheapest}
  :overflow ":unscheduled で返す(silent cap 禁止)"
  :order "first-fit-decreasing(大 GPU 要求から。断片化抑制)"
  :gpu_catalog {:t4 16 :l4 24 :a10g 24 :a100-40 40 :a100-80 80 :h100 80 :h200 141 :b200 192}}

 :autoscale
 {:formula "replicas = clamp(ceil(in-flight / target-concurrency), min, max)"
  :scale_to_zero "負荷ゼロ → min(既定 0)。serve は idle-timeout(既定 300s)後 drain→cold。"}

 :risk_gate
 {:deploy :financial
  :scale-up :financial
  :scale-down :read-only
  :delete :destructive
  :rule "GPU 確保(deploy/scale-up)は課金が始まるため承認必須。runtime/reconcile が差分を effect として propose し、承認後のみ kotoba XRPC へ transact(fail-closed)。"}

 :transport
 {:planes_adr "90-docs/adr/2606271700-kotoba-transport-planes.md"
  :inference "Live 面(libp2p QUIC, native fleet)"
  :artifacts "Read 面(CID-over-HTTP)"
  :reach {:native "native fleet ノード" :http "edge(l4)ノード"}}

 :files
 ["orgs/gftdcojp/cloud-murakumo/deps.edn"
