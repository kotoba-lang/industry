  (:adr/title "ADR-2608292330: kotoba-lang/json に .kotoba の scalar field extractor を landing する — guest 内 JSON 検査の第 1 slice")
  (:adr/status "accepted")
  (:adr/doc_type "adr")
  (:adr/doc-type "adr")
  (:adr/source-format "edn")
  (:adr/date "2026-08-29")
  (:adr/last-verified "2026-08-29")
  (:adr/last_verified "2026-08-29")
