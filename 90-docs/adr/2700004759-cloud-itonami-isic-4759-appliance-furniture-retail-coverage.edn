[{:adr/id 2700004759
  :adr/title "cloud-itonami-isic-4759 — Household Appliance, Furniture and Lighting Specialized-Store Retail Operations Coordination"
  :adr/status :accepted
  :adr/date "2026-07-16"
  :adr/scope [:kotoba-lang/industry :cloud-itonami/cloud-itonami-isic-4759]
  :adr/references [2607121000 2691004752]

  ;; Wave 2 actor (coordination/logistics/trade): household-appliance/
  ;; furniture/lighting specialized-store retail operations
  ;; coordination-only (sales-record logging, delivery-operation
  ;; scheduling, supply-order coordination, warranty-concern flagging).
  ;; No op finalizes a warranty-claim decision or a delivery/
  ;; installation-safety clearance -- those actions are structurally
  ;; excluded, never merely gated.

  :actor/id :cloud-itonami-isic-4759
  :actor/name "Household Appliance, Furniture and Lighting Retail Operations Coordinator"
  :actor/isic-rev5 "4759"
  :actor/domain :retail/appliance-furniture-lighting
  :actor/wave 2
  :actor/coordination? true
  :actor/robotics? true

  :actor/proposal-ops [:log-sales-record :schedule-delivery-operation
                       :coordinate-supply-order :flag-warranty-concern]
  :actor/always-escalate-ops [:flag-warranty-concern]
  :actor/cost-threshold-escalate-ops {:coordinate-supply-order 2000}

  :actor/hard-checks [:store-verified :vendor-verified :effect-propose :scope-exclusion]
  :actor/scope-excluded-terms ["approve the warranty claim" "deny the warranty claim"
                                "finalize the warranty claim" "finalize the warranty claim decision"
                                "authorize the warranty replacement" "authorize the warranty refund"
                                "issue the warranty refund" "reject the warranty claim"
                                "settle the warranty dispute" "grant the warranty replacement"
                                "close the warranty claim as resolved"
                                "certify the gas hookup as safe" "certify the electrical hookup as safe"
                                "clear the installation hazard as resolved"
                                "sign off on the installation safety inspection"
                                "declare the installation code-compliant"
                                "authorize the gas connection as safe"
                                "保証請求を承認" "保証請求を却下" "保証交換を許可" "保証返金を確定"
                                "ガス接続を安全と認定" "設置安全検査に合格したと認定"]

  ;; Self-trip-avoidance: every term above is phrased as the
  ;; finalization/execution ACTION, never a bare noun -- this namespace's
  ;; own :flag-warranty-concern default proposal legitimately discusses
  ;; defect/warranty-dispute concerns, and its own printed :op keyword
  ;; literally contains the substring "warranty". A bare-noun term list
  ;; (e.g. bare "warranty"/"claim"/"installation"/"gas") would self-trip
  ;; this actor's own core happy path on every single run. Regression
  ;; test:
  ;; governor-test/default-mock-advisor-proposals-never-self-trip-scope-exclusion.

  :phase/rollout
  {0 {:label "read-only" :writes #{} :auto #{}}
   1 {:label "assisted-logging" :writes #{:log-sales-record} :auto #{}}
   2 {:label "assisted-coordination" :writes #{:log-sales-record :schedule-delivery-operation
                                               :coordinate-supply-order}
      :auto #{}}
   3 {:label "supervised-auto" :writes #{:log-sales-record :schedule-delivery-operation
                                         :coordinate-supply-order :flag-warranty-concern}
      :auto #{:log-sales-record :schedule-delivery-operation :coordinate-supply-order}}}

  :operation/entry-point :intake
  :operation/nodes [:intake :advise :govern :decide :request-approval :commit :hold]

  :test/counts {:total 56 :assertions 166 :failures 0 :errors 0}
  :test/coverage [:governor-hard-checks :advisor-shapes :phase-rollout :integration
                  :store-contract :scope-exclusion-self-trip-regression
                  :vendor-verification]
  :test/simulator :applianceops.sim

  :registry/maturity :implemented
  :registry/repo "https://github.com/cloud-itonami/cloud-itonami-isic-4759"
  :registry/business-id "cloud-itonami-isic-4759"
  :registry/required-technologies [:robotics :identity :forms :dmn :bpmn :audit-ledger :retail]
  :registry/operating-states [:intake :advise :govern :approve :commit :audit]

  :db/id -1}]
