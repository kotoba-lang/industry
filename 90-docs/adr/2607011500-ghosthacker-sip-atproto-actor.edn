 :problem
 {:source "user request 2026-07-01: publish Spirit in Physics (Ghost Hacker universe) as an atproto actor using kototama + kami-mangaka-*-clj generation + a co-scientist quality loop, registered/publishing on aozora.app, with X/Instagram/LINE as likely future targets"
  :investigated
  ["kototama (orgs/com-junkawasaki/kototama) was rewritten same-day into a pure actor/organism CLJC authority layer (kototama.contract/gates/membrane/didkey/atproto/emit) — the game-compiler framing in kami-engine's CLAUDE.md (ADR-0039) is stale"
   "app-aozora's real write path ($lib/server/aozora-pds/index.ts) is Bearer==env.PDS_ADMIN_TOKEN, single-owner; the `account` table for multi-tenant actors is unused; kototama.emit's :app-aozora target still points at a placeholder https://bsky.social"
   "app-aozora already ships a pure EDN->kotoba-tx manga projector (aozora.appview.manga / manga_export.cljc), currently fed by a hand-run JVM export of one 260123-jump arc under did:web:ghosthacker.gftd.ai, seeded directly into the D1 store"
   "the self-sovereign CACAO pattern (self-mint depth-1, no owner hand-off) is already implemented and working: orgs/gftdcojp/ai-gftd-itonami/src/itonami/{cacao.clj,kotoba.clj}"]
  :risk "retrofitting DID/CACAO signature verification onto app-aozora's single-owner-secret write path is new, security-sensitive surface on shared infra; seed-data dumps are not actor-signed and don't scale to a second work"}

 :decision
 {:topology "relay/pull, not push"
  :actor_core ["self-issued did:key CACAO identity (ports itonami.cacao)"
               "kotoba-store self-mint :cap/transact on own graph (ports itonami.kotoba)"
               "content read from org-spirit-in-physics-comics episode/storyboard EDN (sip.lore/sip.storyboard pattern)"
               "generation via kami-mangaka-render-clj / kami-mangaka-page-clj, containment node (proposal-only)"
               "co-scientist quality loop: generate -> review (charter gates) -> rank (Elo) -> evolve, ported from com-etzhayyim-ibuki methods/coscientist.cljc"
               "StateGraph intake -> advise -> govern -> decide -> commit|request-approval|hold, ported from gftd-talent-actor operation.cljc"
               "only :commit writes; append-only ledger"]
  :publish_fanout "kototama.emit-style targets map; this ADR implements :aozora (app-aozora polls/subscribes the actor's kotobase.net graph, feeds aozora.appview.manga); :x/:instagram/:line left as future target entries requiring no actor-core change"
  :repo "orgs/etzhayyim/com-etzhayyim-tsumugu (west-registered per standing manifest workflow)"}

 :consequences
 {:isolation "actor never depends on app-aozora's security model or deploy lifecycle to publish"
  :app_aozora_change "gains a relay/poll job, not a new authenticated write surface"
  :reuse "second work (260123-jump) or second downstream platform reuse the same actor skeleton / same targets extension point without touching the core"}

 :alternatives
 [{:option "seed-data dump into app-aozora D1 (as already done by hand for one 260123-jump arc)"
   :rejected_because "not actor-signed/self-sovereign, not reusable without repeating the manual export; user explicitly asked for the most beautiful path, not the seed shortcut"}
  {:option "DID-verified push into app-aozora"
   :rejected_because "architecturally valid in the abstract, but this Worker's write path was built around one static owner secret; retrofitting is a larger, separate, security-sensitive project than extending the existing pull-based projector"}]}
