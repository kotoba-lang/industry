  :adr/decision-summary "{:pattern \"sealed waste-ops-LLM + independent SanitationGovernor + append-only audit ledger, same containment pattern as robotaxi-actor/gftd-talent-actor/cloud-itonami\", :new-actor \"swachh-actor\", :org \"etzhayyim\", :repo \"https://github.com/etzhayyim/com-etzhayyim-swachh-actor\", :west-name \"com-etzhayyim-swachh-actor\", :pin \"9d4cc00ed021dc70d225a093b9a9b7d71ce2d961\", :visibility :public, :license \"AGPL-3.0-or-later\", :domain \"India urban municipal solid waste collection/sorting/recycling BUSINESS EXECUTION (route/dispatch, vendor shipment, facility routing) -- NOT the system-dynamics analysis itself\", :namespace \"swachh\", :governor-checks [{:check :rbac :severity :hard} {:check :purpose :severity :hard} {:check :worker-privacy :severity :hard :note \"citing the zone's informal waste-picker (kabadiwala) identity as a decision basis is rejected\"} {:check :vendor-eligibility :severity :hard :note \"new -- no analog in other actors; recommending an unlicensed/unregistered recycling vendor is rejected\"} {:check :minimal-disclosure :severity :hard} {:check :confidence-floor-and-high-stakes :severity :soft-escalate :note \"confidence < 0.6 or stake in #{:large-shipment :hygiene-escalation} -> escalate to ward-officer\"}], :analysis-intervention-separation {:principle \"this workspace already separates analysis-only actors (observe/project/react-loop-verdict, never write/actuate) from intervention/execution actors (governor-gated real writes/dispatch)\", :analysis-actor \"junkan (orgs/etzhayyim/root/20-actors/junkan), extended by junkan/methods/waste_dynamics.cljc for this domain\", :execution-actor \"swachh-actor (this ADR)\", :consuming-contract \"swachh.wasteops :route/propose reads :observed-backlog (a plain supervisor-reported number) and (swachh.store/insight-of db zone-id) -- junkan's last-written verdict -- as two independent facts; falls back to observed-backlog alone when no insight is present; no direct code-level integration with junkan (loose EDN-map coupling only)\"}, :concurrent-session-note \"A separate concurrent session independently converged on the same actor name/namespace/design and pushed etzhayyim/com-etzhayyim-swachh-actor to GitHub first (20 tests/76 assertions, 0 failures, 0 lint errors) before this session's own implementation completed. This ADR registers that shipped implementation as canonical; this session's own alternate self-contained build (system dynamics embedded directly rather than delegated to junkan) was never pushed anywhere and does not conflict with the registered repo.\", :scope-excluded [\"junkan integration wiring (a real insight-writing pipeline)\" \"real municipal GIS/route-database integration\" \"real LLM production endpoint config\" \"RAD identity registration\" \"vendor payment/settlement confirmation\" \"physical collection-vehicle/hardware actuation\"], :manifest-registration \"orgs/etzhayyim/com-etzhayyim-swachh-actor added to manifest/repos.edn :extra-projects (44-byte minimal diff); manifest/west.yml regenerated with --entry com-etzhayyim-swachh-actor (5-line minimal diff) using the pre-migration gen-west-manifest.cljs as a fallback since the nbb port could not run; the new entry's own pin verified reachable from main, --no-verify-remote used only because 4 unrelated already-committed entries (untouched by this diff) failed verification due to concurrent upstream pin advancement during the run\"}"
