  :adr/decision-summary "{:pattern \"sealed Dossier-LLM advisor + independent DisclosureGovernor + append-only audit ledger (same shape as cloud-itonami-6310 / cloud-itonami-M6910 / robotaxi-actor)\", :new-actor \"cloud-itonami-isic-8291\", :org \"cloud-itonami\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"8291\", :isic-name \"Activities of collection agencies and credit bureaus\", :registry-promotion \"kotoba-lang/industry registry.edn id 8291: :maturity :spec -> real repo (2nd promotion after cloud-itonami-M6910's 6910)\", :scope-boundary {:included [:company-registry-facts :officers-directors-ubo-where-legally-disclosed :government-official-in-official-role :disclosed-ownership-directorship-jv-edges :business-contact-info] :excluded [:private-life :family-outside-disclosed-shareholding :political-religious-health-orientation :realtime-location :social-media-inference] :owner-confirmed \"narrow scope option chosen via AskUserQuestion, 2026-07-10\"}, :governor-checks [{:check :scope-gate :severity :hard :note \"schema itself has no field for excluded categories -- structural, not just runtime\"} {:check :source-basis :severity :hard :note \"every fact/edge must cite an allowed source-class; uncited LLM inference rejected outright\"} {:check :licensed-disclosure :severity :hard :note \"disclosure/query only serves an active contracted tenant+tier+purpose; no anonymous/public query op exists\"} {:check :confidence-floor :severity :soft-escalate} {:check :high-stakes-gate :severity :soft-escalate :note \"government-official or sanctions/PEP-flagged subject always escalates\"} {:check :correction-request :severity :hard-always-escalate :note \"data-subject dispute never auto-resolves at any phase, FCRA-style dispute right\"}], :actuation-invariant \":correction/request and government-official/sanctions-flagged :disclosure/query|:relationship/draft are never members of any phase's :auto set -- structural permanent human gate, same shape as M6910's :filing/submit\", :r0-scope {:source-catalog [\"JPN houjin-bangou (法人番号公表サイト)\" \"GBR Companies House (officers/PSC free API)\" \"DEU Unternehmensregister\" \"EST e-Business Register\" \"USA SEC EDGAR (public companies only)\" \"EU consolidated financial sanctions list (public government data, not private surveillance)\"], :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as cloud-itonami-6310\"}, :wholesale-fleet-wiring \"NOT done in this ADR -- :corporate-intelligence capability keyword declared conceptually only; wiring into the 175+ cloud-itonami-{ISIC} blueprint fleet's required-technologies is an explicit follow-up, not bundled here\", :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention (ADR-2607011000/2607012000/2607012100/2607031500)\"}"
  :adr/authoritative true
  :adr/follow-up-2026-07-10-first-real-integration "{:consumer \"cloud-itonami-isic-6910\", :trigger \"owner said next after the declaration-only pilot; picked 6910 since its own screen-kyc already had a self-declared, never-sourced :sanctions-hit? field -- the exact gap this actor exists to fill\", :integration {:new-ns \"formation.corporate-intel.cljc (6910 side)\", :op-called \":disclosure/screen-name\", :governance \"calls through 8291's OWN DisclosureGovernor -- no bypass from the consumer side either; a real 8291 hit escalates for 8291's own human reviewer first, so 6910 never peeks at Dossier-LLM's pre-approval draft\", :injection \"registrarllm/mock-advisor gained a :corporate-intel-screen opt, default no-op, so every prior caller's behavior is byte-for-byte unchanged unless explicitly opted in\", :real-guarantee \"'no longer silently clears', NOT 'now hard-holds' -- a real 8291 hit only ever settles to a definitive :hit synchronously after 8291's own human already approved it\"}, :bug-found-and-fixed-in-8291 {:symptom \"propose-name-screen's not-found case was confidence 0.5 (escalate), modeled after a no-data uncertainty pattern\", :why-wrong \"a real PEP/sanctions screening product returns a confident negative for a no-match result; low confidence there would make every screen of someone outside R0's tiny demo catalog escalate, defeating the point of an automatable op\", :fix \"raised to 0.85; R0's narrow coverage stays a documented dossier.facts/coverage characteristic, not a per-query confidence hedge\", :discovered-via \"writing the 6910 integration test end-to-end against the REAL (unmocked) 8291 actor, not a stub\"}, :test-results {:8291 \"37 tests / 164 assertions, lint clean\", :6910 \"69 tests / 311 assertions (6 new), lint clean\"}, :remaining-pilot-repos \"still declaration-only (9 of 10); still deferred whether/which get real integration code next\"}"
  :adr/follow-up-2026-07-10-pilot-fleet-wiring "{:trigger \"owner chose a small pilot (5-10 repos) over a 288-repo wholesale sweep, via AskUserQuestion\", :pilot-set [\"cloud-itonami-isic-6810\" \"cloud-itonami-isic-6910\" \"cloud-itonami-isic-6499\" \"cloud-itonami-isic-6430\" \"cloud-itonami-isic-6630\" \"cloud-itonami-isic-6512\" \"cloud-itonami-isic-6621\" \"cloud-itonami-isic-6622\" \"cloud-itonami-isic-6420\" \"cloud-itonami-isic-6419\"], :selection-criteria \"already :implemented (real actor, not scaffold-only) AND KYC/counterparty/ownership due-diligence is genuinely load-bearing for the vertical's own domain logic -- not sprayed speculatively across unrelated verticals\", :method \"each repo's own blueprint.edn :itonami.blueprint/optional-technologies got :corporate-intelligence appended, committed+pushed directly to that repo's main (10 independent minimal-diff commits, not a wholesale regen); kotoba-lang/industry registry.edn's matching 10 entries updated the same way via a single worktree+server-side-merge batch, 7 tests/193 assertions green\", :declaration-only \"the optional-technologies entry is a capability DECLARATION only -- no blueprint's own code was changed to actually call cloud-itonami-isic-8291's XRPC/contract surface; that integration is each blueprint's own follow-up\", :remaining-fleet-decision \"deferred -- whether to extend to the remaining ~278 repos (individually, as each vertical's own need arises, or via a future wholesale ADR) is NOT decided here; watch whether the pilot's declared capability actually gets consumed before deciding\"}"
