  :adr/decision-summary "{:pattern \"sealed Dossier-LLM advisor + independent DisclosureGovernor + append-only audit ledger (same shape as cloud-itonami-6310 / cloud-itonami-M6910 / robotaxi-actor)\", :new-actor \"cloud-itonami-isic-8291\", :org \"cloud-itonami\", :visibility :public, :license \"AGPL-3.0-or-later\", :isic-rev4 \"8291\", :isic-name \"Activities of collection agencies and credit bureaus\", :registry-promotion \"kotoba-lang/industry registry.edn id 8291: :maturity :spec -> real repo (2nd promotion after cloud-itonami-M6910's 6910)\", :scope-boundary {:included [:company-registry-facts :officers-directors-ubo-where-legally-disclosed :government-official-in-official-role :disclosed-ownership-directorship-jv-edges :business-contact-info] :excluded [:private-life :family-outside-disclosed-shareholding :political-religious-health-orientation :realtime-location :social-media-inference] :owner-confirmed \"narrow scope option chosen via AskUserQuestion, 2026-07-10\"}, :governor-checks [{:check :scope-gate :severity :hard :note \"schema itself has no field for excluded categories -- structural, not just runtime\"} {:check :source-basis :severity :hard :note \"every fact/edge must cite an allowed source-class; uncited LLM inference rejected outright\"} {:check :licensed-disclosure :severity :hard :note \"disclosure/query only serves an active contracted tenant+tier+purpose; no anonymous/public query op exists\"} {:check :confidence-floor :severity :soft-escalate} {:check :high-stakes-gate :severity :soft-escalate :note \"government-official or sanctions/PEP-flagged subject always escalates\"} {:check :correction-request :severity :hard-always-escalate :note \"data-subject dispute never auto-resolves at any phase, FCRA-style dispute right\"}], :actuation-invariant \":correction/request and government-official/sanctions-flagged :disclosure/query|:relationship/draft are never members of any phase's :auto set -- structural permanent human gate, same shape as M6910's :filing/submit\", :r0-scope {:source-catalog [\"JPN houjin-bangou (法人番号公表サイト)\" \"GBR Companies House (officers/PSC free API)\" \"DEU Unternehmensregister\" \"EST e-Business Register\" \"USA SEC EDGAR (public companies only)\" \"EU consolidated financial sanctions list (public government data, not private surveillance)\"], :store-backend \"MemStore + DatomicStore (langchain.db), same swap-seam as cloud-itonami-6310\"}, :wholesale-fleet-wiring \"NOT done in this ADR -- :corporate-intelligence capability keyword declared conceptually only; wiring into the 175+ cloud-itonami-{ISIC} blueprint fleet's required-technologies is an explicit follow-up, not bundled here\", :manifest-registration \"none -- standalone, per the existing cloud-itonami-{ISIC} blueprint convention (ADR-2607011000/2607012000/2607012100/2607031500)\"}"
  :adr/authoritative true
  :adr/follow-up-2026-07-10-pilot-round-wrapup "{:trigger \"owner: '残り9 repoにも同様の実統合を順次展開', after confirming direction via AskUserQuestion\", :method \"investigated all 9 remaining pilot repos' existing screen-kyc-equivalent code before writing any; split into group A (structurally identical to 6910's officer/party + :sanctions-hit? + kyc-of shape) and group B (structurally incompatible with the :disclosure/screen-name op) rather than mechanically forcing the same pattern onto all 9\", :group-a-real-integrations [{:repo \"cloud-itonami-isic-6810\" :ns \"realty\" :commit \"9ba0967\" :tests \"30/118\" :note \"created ci.yml from scratch (none existed)\"} {:repo \"cloud-itonami-isic-6499\" :ns \"vcfund\" :commit \"8055f7e\" :tests \"176/661\" :note \"no ci.yml, none created; agent self-caught+fixed a paren bug via its own test run before pushing\"} {:repo \"cloud-itonami-isic-6512\" :ns \"casualty\" :commit \"1158aa9\" :tests \"40/187\" :note \"no ci.yml, none created\"} {:repo \"cloud-itonami-isic-6419\" :ns \"banking\" :commit \"12665c0\" :tests \"44/191\" :note \"created ci.yml from scratch; narrower :unresolved/:resolved vocabulary (no :incomplete) means governor's sanctions-violations HARD-holds unconditionally on :unresolved, so 8291 pending-review/held collapse to an immediate hold here rather than a soft escalate -- confirmed correct against banking/governor.cljc, a deliberate stricter AML-domain choice not a bug\"}], :ci-yml-inconsistency \"the 4 parallel agents independently disagreed on whether to create a new ci.yml when none existed (6810/6419 created one, 6499/6512 did not) -- low-risk but flagged for later harmonization, not fixed in this addendum\", :group-b-not-integrated [{:repos [\"cloud-itonami-isic-6430\" \"cloud-itonami-isic-6630\"] :reason \"pure back-office actors (capital-call/NAV/fee/carry recompute-and-cross-check between vcfund and its LP/GP-facing vehicles) -- zero sanctions/kyc/screen concept anywhere in governor.cljc, no integration point exists\"} {:repos [\"cloud-itonami-isic-6420\"] :reason \"screen-beneficial-ownership verifies a boolean UBO-confirmed flag on a subsidiary POSITION, not a person's name against a sanctions list -- conceptually adjacent to 8291's :relationship/edge (ownership) data but needs a NEW UBO-chain query op, not :disclosure/screen-name\"} {:repos [\"cloud-itonami-isic-6621\" \"cloud-itonami-isic-6622\"] :reason \"conflict-of-interest check screens the ADJUSTER/BROKER's own relationship to the matter's parties, not an external counterparty's PEP/sanctions status -- would need a NEW two-party relationship-query op built on 8291's :relationship/edge graph, not :disclosure/screen-name\"}], :status-tally \"5 of 10 pilot repos now have real integration code (6910 + these 4); 2 of 10 have no applicable integration point; 3 of 10 need a new 8291 capability designed first; remaining ~278-repo fleet decision and the 3 group-B repos' new-capability design are NOT decided in this addendum\"}"
  :adr/follow-up-2026-07-10-first-real-integration "{:consumer \"cloud-itonami-isic-6910\", :trigger \"owner said next after the declaration-only pilot; picked 6910 since its own screen-kyc already had a self-declared, never-sourced :sanctions-hit? field -- the exact gap this actor exists to fill\", :integration {:new-ns \"formation.corporate-intel.cljc (6910 side)\", :op-called \":disclosure/screen-name\", :governance \"calls through 8291's OWN DisclosureGovernor -- no bypass from the consumer side either; a real 8291 hit escalates for 8291's own human reviewer first, so 6910 never peeks at Dossier-LLM's pre-approval draft\", :injection \"registrarllm/mock-advisor gained a :corporate-intel-screen opt, default no-op, so every prior caller's behavior is byte-for-byte unchanged unless explicitly opted in\", :real-guarantee \"'no longer silently clears', NOT 'now hard-holds' -- a real 8291 hit only ever settles to a definitive :hit synchronously after 8291's own human already approved it\"}, :bug-found-and-fixed-in-8291 {:symptom \"propose-name-screen's not-found case was confidence 0.5 (escalate), modeled after a no-data uncertainty pattern\", :why-wrong \"a real PEP/sanctions screening product returns a confident negative for a no-match result; low confidence there would make every screen of someone outside R0's tiny demo catalog escalate, defeating the point of an automatable op\", :fix \"raised to 0.85; R0's narrow coverage stays a documented dossier.facts/coverage characteristic, not a per-query confidence hedge\", :discovered-via \"writing the 6910 integration test end-to-end against the REAL (unmocked) 8291 actor, not a stub\"}, :test-results {:8291 \"37 tests / 164 assertions, lint clean\", :6910 \"69 tests / 311 assertions (6 new), lint clean\"}, :remaining-pilot-repos \"still declaration-only (9 of 10); still deferred whether/which get real integration code next\"}"
  :adr/follow-up-2026-07-10-pilot-fleet-wiring "{:trigger \"owner chose a small pilot (5-10 repos) over a 288-repo wholesale sweep, via AskUserQuestion\", :pilot-set [\"cloud-itonami-isic-6810\" \"cloud-itonami-isic-6910\" \"cloud-itonami-isic-6499\" \"cloud-itonami-isic-6430\" \"cloud-itonami-isic-6630\" \"cloud-itonami-isic-6512\" \"cloud-itonami-isic-6621\" \"cloud-itonami-isic-6622\" \"cloud-itonami-isic-6420\" \"cloud-itonami-isic-6419\"], :selection-criteria \"already :implemented (real actor, not scaffold-only) AND KYC/counterparty/ownership due-diligence is genuinely load-bearing for the vertical's own domain logic -- not sprayed speculatively across unrelated verticals\", :method \"each repo's own blueprint.edn :itonami.blueprint/optional-technologies got :corporate-intelligence appended, committed+pushed directly to that repo's main (10 independent minimal-diff commits, not a wholesale regen); kotoba-lang/industry registry.edn's matching 10 entries updated the same way via a single worktree+server-side-merge batch, 7 tests/193 assertions green\", :declaration-only \"the optional-technologies entry is a capability DECLARATION only -- no blueprint's own code was changed to actually call cloud-itonami-isic-8291's XRPC/contract surface; that integration is each blueprint's own follow-up\", :remaining-fleet-decision \"deferred -- whether to extend to the remaining ~278 repos (individually, as each vertical's own need arises, or via a future wholesale ADR) is NOT decided here; watch whether the pilot's declared capability actually gets consumed before deciding\"}"
  :adr/follow-up-2026-07-10-remaining-3-repos-wired "{:trigger \"owner: 'do it', continuing from addendum 3's group-B finding that 6420/6621/6622 needed a NEW 8291 capability before integration made sense\", :new-8291-ops [{:op :disclosure/ownership-chain :answers \"who owns this company, per one-hop sourced :ownership relationship edges\" :min-tier :tier/graph :for \"cloud-itonami-isic-6420\"} {:op :disclosure/relationship-check :answers \"does this named person have a professional-capacity relationship (org membership or a direct one-hop edge) with a target -- company OR another person\" :min-tier :tier/graph :for \"cloud-itonami-isic-6621/6622\" :generalization \"added :target-name (tries company-by-name then official-by-name) after realizing 6621/6622's own `party` records store both companies and individuals under the identical generic shape, so the caller often can't know in advance which kind its counterparty is\"}], :new-8291-store-fn \"dossier.store/company-by-name, symmetric with official-by-name\", :new-8291-demo-relationships [\"co-200 (sanctions-flagged) owns 60% of new demo co-300\" \"of-1 also sits on co-200's board (directorship)\" \"of-2 has a direct business-contact edge to of-1\"], :8291-test-results \"55 tests / 213 assertions, lint clean, demo ops 7-8 added\", :8291-commits [\"c91691c\" \"2152c07\" \"448151b\"], :consumer-wiring [{:repo \"cloud-itonami-isic-6420\" :op-used :disclosure/ownership-chain :query-key :company-name :commit \"4109e99\" :tests \"40/195\" :vocabulary \"binary (verified?/not), no incomplete state -- governor's beneficial-ownership-verification-unresolved-violations is unconditional HARD, so pending-review/held BOTH collapse to verified?=false -> immediate hold, confirmed via a REAL (unmocked) end-to-end run against 8291's actual co-300/co-200 ownership data, not just a stub\"} {:repo \"cloud-itonami-isic-6621\" :op-used :disclosure/relationship-check :query-key :target-name :new-optional-request-field :matter-id :commit \"4c628f9\" :tests \"30/123\" :vocabulary \"3-way (hit/incomplete/clear), same as the group-A repos\" :agent-correction \"my brief wrongly assumed the demo adjuster-name x counterparty-name pair would trigger 8291's own high-stakes escalation; the agent ran it for real, found related?=true commits immediately (neither individual is independently sanctions/gov-flagged, only associated), adjusted the test to match reality, and added separate deterministic stub tests for the pending-review/held branches 8291's current demo data can't reach through this specific op\"} {:repo \"cloud-itonami-isic-6622\" :op-used :disclosure/relationship-check :query-key :target-name :new-optional-request-field :placement-id :commit \"b61854d\" :tests \"40/193\" :vocabulary \"3-way, same as 6621\" :agent-correction \"same false assumption caught again independently; this agent chose a DIFFERENT, better demo pairing (a director of a company that IS itself sanctions-flagged) that genuinely triggers 8291's real high-stakes escalation end-to-end, rather than falling back to stubs only\"}], :backward-compat \":matter-id/:placement-id are optional additions to each op's existing request shape -- omitting them preserves prior behavior exactly, verified by both agents\", :verification-pattern-note \"both wiring agents independently discovered the same wrong assumption in my brief (which demo pairing triggers 8291's escalation) by actually RUNNING the integration rather than trusting the written plan, then corrected it -- exactly the empirical-verification discipline this whole effort has leaned on throughout\", :status-tally \"8 of 10 pilot repos now have real integration code (up from 5); only cloud-itonami-isic-6430/6630 remain unintegrated, and only because no sanctions/kyc/screen concept exists in their domain at all (pure back-office capital-call/NAV/fee actors) -- not a capability gap, a genuine non-applicability; the ~278-repo fleet decision remains deferred\"}"
  :adr/follow-up-2026-07-10-live-data-source "{:trigger \"owner: '2,3' -- fleet decision + real data source; owner picked UK Companies House, asked to check 1Password/Keychain for an existing key first\", :credential-search \"searched all 7 accessible 1Password vaults (Apple Password Manager, gftdcojp, jk.luxury, junkawasaki.com, Private, 純真個人x2) via `op item list` + manifest/repos.edn's secrets map, and macOS Keychain via `security find-generic-password` -- no Companies House key found anywhere; proceeded per owner's fallback instruction to build the plumbing regardless\", :new-files [{:file \"dossier/companies_house.clj\" :note \"started as .cljc with #?(:clj ...) requires, but ALL requires were :clj-only (http-kit/jsonista have no cljs equivalent) so clj-kondo's :cljs analysis pass saw an empty (:require) and errored 'Invalid require: no libs specified' -- converted to plain .clj, same precedent as talent.facts.clj (a dev/ops integration seam, not part of the portable actor core)\"} {:file \"dossier/live_store.cljc\" :note \"Store protocol decorator: LOCAL data always wins, live Companies House consulted ONLY as a fallback for company/company-by-name/officials-of when local has nothing; nil fetch-fn (no key configured) behaves exactly like the undecorated local store\"}], :scope-honest-limits \"company-by-name + officials-of(known company) only; official-by-name (global person search) explicitly NOT built -- Companies House's /search/officers needs a second per-candidate /officers/{id}/appointments hop to resolve company context, deferred rather than half-built, so :disclosure/screen-name (the op the 5 direct-pattern consumers actually call) does not yet benefit from live data\", :testing \"all tests inject a fake fetch-fn (canned JSON-shaped maps) -- 68 tests / 253 assertions (13 new), fully offline, lint clean\", :NOT-verified-against-real-api \"no key was available at build time -- this integration has NEVER made a real HTTP call to Companies House; operators must smoke-test with their own key before production use (documented in docs/operator-guide.md)\", :commit \"343fadc\"}"
  :adr/follow-up-2026-07-10-fleet-survey "{:trigger \"same '2,3' instruction, fleet-decision half\", :methodology-correction \"initially assumed kotoba-lang/industry registry comments listing dozens of superficially-similar-sounding sibling verticals (e.g. cloud-itonami-isic-6419's comment chain naming 6511/6512/6621/6622/.../9603/9602/.../8569 as sharing 'sanctions-violations') meant all were corporate-intelligence candidates; DISPROVED this by reading cloud-itonami-isic-9603's (funeral) actual governor.cljc, which has NO sanctions/PEP concept at all -- its check is authorization-unverified-violations (next-of-kin authority to arrange a funeral). The registry comments were about reuse of a STRUCTURAL pattern (unconditional hard-check discipline), not a SEMANTIC one (KYC/sanctions screening) -- naively trusting the name list would have declared the capability on dozens of unrelated verticals, repeating exactly the kind of cross-org name-collision confusion ADR-2607051300 already flagged as a known failure mode in this fleet (its own 'mangaka' example)\", :method-actually-used \"individually read the governor.cljc of all 111 :implemented blueprints' relevant check function + docstring, kept only those whose check semantically screens a NAMED PARTY/COUNTERPARTY against a sanctions/PEP/conflict-of-interest/beneficial-ownership concept 8291's actual data model covers\", :found-and-declared [{:repo \"cloud-itonami-isic-6411\" :check \"correspondent-banking-due-diligence-unresolved-violations\" :fit \"real AML/CFT correspondent-banking concept\"} {:repo \"cloud-itonami-isic-6511\" :check \"sanctions-violations\" :fit \"literally identical structure to cloud-itonami-isic-6512\"} {:repo \"cloud-itonami-isic-6612\" :check \"conflict-of-interest-violations\" :fit \"broker's own conflict-of-interest, same shape as 6621/6622\"} {:repo \"cloud-itonami-isic-6920\" :check \"independence-violation-violations\" :fit \"auditor independence (real SEC/PCAOB-class concept), same shape as 6612/6621/6622\"}], :declaration-only \"blueprint.edn + kotoba-lang/industry registry only (4 individual repo commits + 1 industry batch commit, 7 tests/217 assertions green) -- no real integration code wired for these 4 in this pass, though the pattern would likely apply near-mechanically given how closely 3 of the 4 match already-wired siblings\", :excluded-with-reasons [{:repo \"cloud-itonami-isic-6491\" :reason \"adverse-credit-flag is a CREDIT SCORE concept, not sanctions/PEP/ownership -- different data model than 8291 covers\"} {:repo \"cloud-itonami-isic-6492\" :reason \"loan approval/affordability, not KYC\"} {:repo \"cloud-itonami-isic-6520\" :reason \"reinsurance recovery/reconciliation, no counterparty-screening concept\"} {:repo \"cloud-itonami-isic-6530\" :reason \"proof-of-life check, unrelated to KYC\"} {:repo \"cloud-itonami-isic-6611\" :reason \"trading-pattern market-surveillance flag, not PEP/sanctions\"} {:repo \"cloud-itonami-isic-6619\" :reason \"transaction fraud flag, not identity/sanctions-based\"} {:repo \"cloud-itonami-isic-6629\" :reason \"apportionment reconciliation, no screening concept\"} {:repo \"cloud-itonami-isic-6820\" :reason \"fee/contract management, no screening concept\"} {:repo \"cloud-itonami-isic-9200\" :reason \"patron-flag ambiguous from code alone -- could be responsible-gambling self-exclusion (unrelated to 8291) or AML source-of-funds (related); left undecided rather than guess\"}], :remaining-scope \"the other ~101 implemented blueprints beyond these 14 total, ALL non-implemented (scaffold-only) blueprints, and the full ~278-repo remainder are NOT surveyed exhaustively -- this was a targeted pass over plausible financial/professional-services candidates, not a fleet-wide sweep\"}"
  :adr/follow-up-2026-07-10-fleet-survey-repos-wired "{:trigger \"owner: 'next', continuing from the fleet-survey addendum's 4 declared-only repos\", :8291-extension {:op :disclosure/query :change \"accepts :company-name (via company-by-name) in addition to :company-id, and its proposal now carries :value {:company-id :flags} -- previously :disclosure/query had no :value at all; needed because cloud-itonami-isic-6920/6411 only hold a counterparty NAME (engagement.client / member.member-name), not an 8291 id, mirroring the *-by-name pattern already used by :disclosure/screen-name|:ownership-chain|:relationship-check\" :8291-test-results \"70 tests / 257 assertions, lint clean\" :8291-commit \"b8adf8c\"}, :consumer-wiring [{:repo \"cloud-itonami-isic-6511\" :op-used :disclosure/screen-name :query-key :party.name :commit \"233dcfd\" :tests \"30/118\" :note \"structurally identical to already-wired cloud-itonami-isic-6512, direct pattern reuse\"} {:repo \"cloud-itonami-isic-6612\" :op-used :disclosure/screen-name :query-key \"account.client (person name)\" :commit \"586abfa\" :tests \"40/193\" :note \"confirmed via a REAL (unmocked) run that screening Jane Smith (demo, co-200 officer) actually escalates through 8291's own governor (:high-stakes) before settling to 6612's own :incomplete, not a silent :clear\"} {:repo \"cloud-itonami-isic-6920\" :op-used :disclosure/query :query-key \"engagement.client (company name)\" :commit \"5e8d1e1\" :tests \"44/189\" :note \"empirically found a layering nuance: 8291's OWN audit reason for escalating is :high-stakes (sanctions flag on the client), while 6920's OWN outer governor independently reasons :low-confidence off the proposal's 0.5 confidence -- both correct, two independent layers reaching the same hold via different rationale\"} {:repo \"cloud-itonami-isic-6411\" :op-used :disclosure/query :query-key \"member.member-name (correspondent bank name)\" :commit \"8a2339b\" :tests \"47/205\" :note \"binary vocabulary (no incomplete state), same collapse pattern as 6419/6420 -- 8291 escalates internally but 6411's own unconditional hard-check turns pending-review/held into an immediate hold with no interrupt\"}], :status-tally \"12 of the 14 surveyed candidate repos now have real integration code (up from 8): 6910/6810/6499/6512/6419/6420/6621/6622/6511/6612/6920/6411. Only cloud-itonami-isic-6430/6630 remain unintegrated (genuine non-applicability, no screening concept in their domain, per addendum 3). The 9 repos excluded in the fleet-survey addendum, the ~101 other implemented blueprints never surveyed, and the ~278-repo fleet remainder all remain explicitly out of scope for this ADR.\"}"
