(vector (map (:adr/authoritative_for (vector "cloud-itonami-isic-2930が org-iso-10303/kotoba-lang webgpu契約/physics-2dへの実依存を取ることの位置づけ（ADR-2607083500『依存を持たない』原則のisic-2930限定の例外）" "autoparts.cad/autoparts.scene/autoparts.motionplan をisic-2930の実digital-twin正本コードとする位置づけ" "他部品/中間製造業種への拡張は本ADRのスコープ外というfollow-up明記")), (:adr/supersedes (vector)), (:adr/superseded_by (vector)), (:adr/topic "cloud-itonami-manufacturing-digital-twin"), (:adr/related (vector "adr-2607151600-cloud-itonami-real-engineering-simulation-integration" "adr-2607152000-cloud-itonami-real-engineering-simulation-fleet-extension" "adr-2607142800-cloud-itonami-robotics-process-simulation" "adr-2607083500-cloud-itonami-vehicle-design-link")), (:adr/status "accepted"), (:adr/id "adr-2607160000-cloud-itonami-isic-2930-parts-digital-twin-pilot"), (:adr/doc_type "adr"), (:adr/body "# ADR-2607160000: cloud-itonami-isic-2930（自動車部品）に部品完成段階の real digital-twin を pilot 導入する\n\n**Status**: accepted。\n\n本文は同名 .md ファイル参照(Context / Decision / Consequences / Verification / References の各節)。"), (:adr/deciders (vector "Jun Kawasaki")), (:adr/scope-boundary "本ADRはcloud-itonami-isic-2930(自動車部品)1業種のみへのCAD形状+WebGPUレンダリング用データ+動線計画の追加を扱う。他の部品/中間製造業種(isic-2610 fab等)・スマートフォン側(isic-2620/2630/2640)への拡張、新規物理エンジン/CADカーネル/Rustの新規作成は一切スコープ外。"), (:adr/date "2026-07-15"), (:adr/amends (vector)), (:db/id -1), (:adr/decision-summary "{:decision \"cloud-itonami-isic-2930(autoparts)に、自動車pilot(isic-2910/ADR-2607151600)と\n    同型のCAD/CAM形状+WebGPUレンダリング用データ整形+動線計画を追加する。新規sibling\n    design-libraryリポジトリは作らず、autoparts.cad/autoparts.scene/autoparts.motionplan\n    をisic-2930自身のnamespaceとして直接実装、vdesign.cad/vdesign.scene/vdesign.motionplan\n    を直接移植・適応する。autoparts.robotics/run-pull-testの固定AABB定数を実CAD形状由来の\n    寸法に置き換える。\",\n    :trigger \"『cloud.itonamiで製造業関係のcoverageは？スマホ/車は原材料から全て設計実装・\n    シミュレーションできているか』への回答で、isic-2910だけがフルdigital-twin(形状+物理+\n    レンダリング+動線)を持ち、isic-2930含む他6業種は物理point-testのみと判明→ユーザーが\n    『部品完成までのデジタルツイン』を指示、設計ADR+実装着手の両方を選択\",\n    :honest-scope [\"box近似(styled surfaceでない)、2D物理のみ、材料/剛性モデルなし\"\n                    \"実ロボット制御/IK解/PLC-MES-SCADA/load-cell-DAQ接続は一切モデル化しない\"\n                    \"isic-2930単体のpilotのみ、他業種は明示的にfollow-up\"]}"), (:adr/authoritative true), (:adr/title "ADR-2607160000: cloud-itonami-isic-2930（自動車部品）に部品完成段階の real digital-twin を pilot 導入する"), (:adr/source-format "edn"), (:adr/pilot-target "{:vertical \"cloud-itonami-isic-2930\", :domain \"autoparts\", :new-namespaces [\"autoparts.cad\" \"autoparts.scene\" \"autoparts.motionplan\"], :modified-namespaces [\"autoparts.robotics\"], :reused-components [\"kotoba-lang/physics-2d(既存依存)\" \"kotoba-lang/org-iso-10303(BREP、新規依存)\" \"kotoba-lang/webgpu kami.webgpu.mesh契約(新規依存、データ形状のみ、.cljs実行はしない)\"], :new-repo? false, :new-physics-engine? false}")))