[{:adr/id 2622000000
  :adr/title "cloud-itonami-isic-9810 — Undifferentiated Household-Goods Own-Account-Production Tracking-Programme Operations Coordination"
  :adr/status :accepted
  :adr/date "2026-07-16"
  :adr/scope [:kotoba-lang/industry :cloud-itonami/cloud-itonami-isic-9810]
  :adr/references [2607152500 2607121000 2616562900]

  ;; Wave 4 actor (human-facing/personal-services). ISIC 9810 is a UN
  ;; SNA residual/statistical bookkeeping category for own-account,
  ;; non-market household production, not a normal business -- this
  ;; actor is deliberately modeled as an operations-coordination actor
  ;; for a structured own-account-production tracking programme (FAO /
  ;; national-statistics-office household-production-survey pattern),
  ;; never a marketplace or production business. See this ADR's own
  ;; Context section and the actor repo's README.md Scope section for
  ;; the full honest framing.

  :actor/id :cloud-itonami-isic-9810
  :actor/name "Household Own-Account-Production Tracking-Programme Operations Coordinator"
  :actor/isic-rev4 "9810"
  :actor/domain :statistics/household-own-account-production-tracking
  :actor/wave 4
  :actor/coordination? true
  :actor/robotics? false

  :actor/proposal-ops [:log-household-production-record :schedule-survey-visit
                       :coordinate-programme-support :flag-food-security-concern]
  :actor/always-escalate-ops [:flag-food-security-concern]
  :actor/cost-threshold-escalate-ops {:coordinate-programme-support 250}

  :actor/hard-checks [:household-verified :effect-propose :scope-exclusion]
  :actor/scope-excluded-terms ["finalize the eligibility determination" "finalize eligibility determination"
                                "finalize the welfare determination" "finalize the benefit determination"
                                "determine eligibility for aid" "grant aid eligibility" "grant welfare eligibility"
                                "eligibility determination decision"
                                "福祉受給資格の確定" "受給資格を確定" "給付資格の確定" "給付資格を確定"
                                "directly perform the harvest" "directly execute the production work"
                                "execute production on the household's behalf" "execute the harvest on the household's behalf"
                                "physically carry out the field work" "conduct the planting on the household's behalf"
                                "世帯に代わって生産作業を実施" "世帯の代わりに収穫作業を実施" "世帯に代わり収穫作業を代行"
                                "suspend programme enrollment" "terminate programme enrollment" "revoke programme enrollment"
                                "programme enrollment suspension" "programme enrollment termination"
                                "プログラム登録の停止" "プログラム登録を停止" "プログラム登録の取消"]

  ;; This ADR's own build actually hit the fleet-known bare-noun
  ;; self-tripping bug during development: the initial
  ;; :coordinate-programme-support default rationale contained the
  ;; literal substring "給付資格の確定" (also a scope-excluded term),
  ;; caught by a pre-test programmatic scan and fixed by rewording the
  ;; rationale, not by weakening the term list. See
  ;; `hhproductionops.governor-test/default-mock-advisor-proposals-
  ;; never-self-trip-scope-exclusion`.
  :actor/self-trip-bug-hit-and-fixed? true

  :phase/rollout
  {0 {:label "read-only" :writes #{} :auto #{}}
   1 {:label "assisted-logging" :writes #{:log-household-production-record} :auto #{}}
   2 {:label "assisted-coordination" :writes #{:log-household-production-record :schedule-survey-visit
                                               :coordinate-programme-support}
      :auto #{}}
   3 {:label "supervised-auto" :writes #{:log-household-production-record :schedule-survey-visit
                                         :coordinate-programme-support :flag-food-security-concern}
      :auto #{:log-household-production-record :schedule-survey-visit :coordinate-programme-support}}}

  :operation/entry-point :intake
  :operation/nodes [:intake :advise :govern :decide :request-approval :commit :hold]

  :test/counts {:total 45 :assertions 128 :failures 0 :errors 0}
  :test/coverage [:governor-hard-checks :advisor-shapes :phase-rollout :integration :store-contract
                  :scope-exclusion-self-trip-regression]
  :test/simulator :hhproductionops.sim

  :registry/maturity :implemented
  :registry/repo "https://github.com/cloud-itonami/cloud-itonami-isic-9810"
  :registry/business-id "cloud-itonami-isic-9810"
  :registry/required-technologies [:identity :forms :dmn :bpmn :audit-ledger]
  :registry/operating-states [:intake :advise :govern :approve :commit :audit]

  :db/id -1}]
