 ;; ==================================================================================
 ;; Lx cross-cutting: nexus-x402 — payment facilitator/gateway（Cloudflare Monetization Gateway 型）
 ;; (ADR-2607105200 で追加。鍵ゼロ・マルチ seller の自前 x402 facilitator。ゲートウェイ核 = kotoba-lang/pay)
 ;; ==================================================================================
 (map (:canvas/kind :lean) (:canvas/product :nexus-x402) (:canvas/layer :payment-facilitator-infra)
  (:canvas/id :nexus-x402.problem) (:canvas/block :lean/problem) (:canvas/label "Problem")
  (:canvas/items (vector "各 seller worker (club-shinshi/murakumo/kotobase) が pay.x402 + treasury.core を個別 vendor し、Basescan verify・challenge/authorize 配線を毎回重複実装している"
                 "自律 AI agent が per-request でマイクロペイメントする「エージェント経済」に対応できる決済ゲートが自前レールに無かった (既存 /pay/* は帯域外・人間向け)"
                 "Cloudflare Monetization Gateway は closed waitlist + facilitator をベンダーに委ねる設計"
                 "中小 seller / 新規 worker は on-chain 検証・treasury 管理の実装コストを個別に負いたくない")))
 (map (:canvas/kind :lean) (:canvas/product :nexus-x402) (:canvas/layer :payment-facilitator-infra)
  (:canvas/id :nexus-x402.segments) (:canvas/block :lean/customer-segments) (:canvas/label "Customer Segments")
  (:canvas/items (vector "内部 seller (first customers): club-shinshi (L0 PPV ゲート)、cloud-murakumo (L1 推論従量課金)、net-kotobase (L2 storage GET 従量課金)"
                 "将来: 外部 seller — gftdcojp/kotoba-lang 外で x402 標準に乗りたい任意の HTTP API 事業者"
                 "買い手側: 自律 AI agent (per-request で USDC を払う消費者、人間ウォレットも可)"
                 "kotoba-lang エコシステム開発者 (pay.facilitator を自 worker に埋め込みたい層)")))
 (map (:canvas/kind :lean) (:canvas/product :nexus-x402) (:canvas/layer :payment-facilitator-infra)
  (:canvas/id :nexus-x402.uvp) (:canvas/block :lean/uvp) (:canvas/label "Unique Value Proposition")
  (:canvas/items (vector "鍵ゼロ・マルチ seller の自前 facilitator — 各 seller は自分の treasury に直接着金、nexus は検証のみでカストディを一切持たない"
                 "x402 標準ワイヤ準拠でロックインしない — Cloudflare facilitator を併用したくなっても移行コストが小さい"
                 "統合モードを seller が選べる (薄い委譲 API で既存ゲートを温存 / フル gateway proxy で前段に置く) — 強制的な中央化ではなく段階移行")))
 (map (:canvas/kind :lean) (:canvas/product :nexus-x402) (:canvas/layer :payment-facilitator-infra)
  (:canvas/id :nexus-x402.solution) (:canvas/block :lean/solution) (:canvas/label "Solution")
  (:canvas/items (vector "ゲートウェイ核: kotoba-lang/pay の pay.facilitator (rules engine / seller registry / verify / settle / gate / discovery、zero-dep・zero-I/O・zero-key-custody)"
                 "nexus-x402 Cloudflare Worker: HTTP エンベロープ + on-chain I/O (Basescan verify via treasury.core) のみ追加"
                 "Facilitator API (薄い委譲): POST /verify・POST /settle・GET /.well-known/x402"
                 "Gateway proxy (前段配置): ANY /gateway/<seller>/<path> — 402 challenge → on-chain 検証 → origin へプロキシ + X-PAYMENT-RESPONSE"
                 "SELLERS_JSON config (公開 treasury アドレスのみ、鍵は一切含まない)。honest default: 未知 seller → 404、未検証 payment → 402"
                 "準備 (follow-up): Cloudflare デプロイ (custom domain 例 nexus.gftd.ai)"
                 "準備 (follow-up): shinshi/murakumo/kotobase の個別ゲートから委譲への移行"
                 "準備 (follow-up): EIP-3009 exact スキームの gasless relay (現状は transaction スキームのみ実効)")))
 (map (:canvas/kind :lean) (:canvas/product :nexus-x402) (:canvas/layer :payment-facilitator-infra)
  (:canvas/id :nexus-x402.channels) (:canvas/block :lean/channels) (:canvas/label "Channels")
  (:canvas/items (vector "gftdcojp 内部 seller (shinshi/murakumo/kotobase) への直接展開 (build in public、既存ゲートとの併存から段階移行)"
                 "kotoba-lang OSS 公開 (Apache-2.0) による開発者 channel — pay.facilitator 単体でも他 seller が vendor 可能"
                 "x402 標準を軸にしたエージェント経済コミュニティ (Cloudflare Monetization Gateway 文脈の代替選択肢として)")))
 (map (:canvas/kind :lean) (:canvas/product :nexus-x402) (:canvas/layer :payment-facilitator-infra)
  (:canvas/id :nexus-x402.revenue) (:canvas/block :lean/revenue-streams) (:canvas/label "Revenue Streams")
