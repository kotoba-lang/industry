 ;; ---- schema -----------------------------------------------------------------
 (map (:db/ident :canvas/kind)    (:db/valueType :db.type/keyword) (:db/cardinality :db.cardinality/one))   ; :lean
 (map (:db/ident :canvas/product) (:db/valueType :db.type/keyword) (:db/cardinality :db.cardinality/one))
 (map (:db/ident :canvas/layer)   (:db/valueType :db.type/keyword) (:db/cardinality :db.cardinality/one))
 (map (:db/ident :canvas/block)   (:db/valueType :db.type/keyword) (:db/cardinality :db.cardinality/one))
 (map (:db/ident :canvas/id)      (:db/valueType :db.type/keyword) (:db/cardinality :db.cardinality/one) (:db/unique :db.unique/identity)) ; :<product>.<block>
 (map (:db/ident :canvas/label)   (:db/valueType :db.type/string)  (:db/cardinality :db.cardinality/one))
 (map (:db/ident :canvas/items)   (:db/valueType :db.type/string)  (:db/cardinality :db.cardinality/many))
 (map (:db/ident :canvas/note)    (:db/valueType :db.type/string)  (:db/cardinality :db.cardinality/one))

 (map (:db/ident :hyp/id)     (:db/valueType :db.type/keyword) (:db/cardinality :db.cardinality/one) (:db/unique :db.unique/identity))
 (map (:db/ident :hyp/product) (:db/valueType :db.type/keyword) (:db/cardinality :db.cardinality/one))
 (map (:db/ident :hyp/claim)  (:db/valueType :db.type/string)  (:db/cardinality :db.cardinality/one))
 (map (:db/ident :hyp/gate)   (:db/valueType :db.type/string)  (:db/cardinality :db.cardinality/one))
 (map (:db/ident :hyp/risk)   (:db/valueType :db.type/keyword) (:db/cardinality :db.cardinality/one))       ; :riskiest
 (map (:db/ident :hyp/status) (:db/valueType :db.type/keyword) (:db/cardinality :db.cardinality/one))      ; :untested

