  :adr/title ":local/root は fleet 規約であって欠陥ではない — 実際に壊れていた6件を直し、west 未登録の2 repo を登録する"
  :adr/status "accepted"
  :adr/date "2026-07-30"
  :adr/last-verified "2026-07-30"
  :adr/deciders ["Jun Kawasaki"]
  :adr/authoritative true
  :adr/source-format "edn"
