  (:adr/id "adr-2607172240-genko-tone-vocabulary-reconcile")
  (:adr/title "ADR-2607172240: genko :tone → :gh.manga/tone 永続化(語彙は既に部分集合、リマップ不要と判明)")
  (:adr/status "accepted")
  (:adr/date "2026-07-17")
  (:adr/last_verified "2026-07-17")
  (:adr/deciders (vector "Jun Kawasaki"))
