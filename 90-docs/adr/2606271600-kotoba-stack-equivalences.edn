   "90-docs/adr/2606241428-submodule-weight-shallow-b2-datalad.md"]
  :supersedes []
  :superseded_by []}

 :equivalences
 [{:technology :wasmcloud
   :role "分散制御面 / lattice / auction / capability link"
   :kotoba ["kotoba-lattice" "kotoba-net" "kotoba-auth"]
   :replacement "NATS -> gossipsub, OCI registry -> CID/bitswap"}
  {:technology :spin
   :role "component + trigger + DX"
   :kotoba ["kotoba-runtime" "on-http/on-tick/on-kse/datom-delta triggers"]
   :replacement "spin.toml -> EDN/datoms, SDK -> kotoba-guest WIT"}
  {:technology :clojure
   :role "言語フロントエンド"
   :kotoba ["kotoba-clj"]
   :replacement "source code as content-addressed component"}
  {:technology :datomic
   :role "不変 DB / as-of / Datalog"
   :kotoba ["kotoba-datomic" "kotoba-query" "CommitDag"]
   :replacement "SQL peer -> Datom on CID/ProllyTree"}
  {:technology :radicle
   :role "P2P 主権 git / node identity / source chain"
   :kotoba ["kotoba-git" "kotoba-dht" "kotoba-rad"]
   :replacement "central forge 無し / CID gossip / DID-derived identity"
   :note "Radicle protocol implementation ではなく役割対応"}]

 :distributed_model
 {:data_plane "wasmCloud lattice x Holochain: leaderless gossipsub auction + CID/bitswap + kotoba-dht source chain"
  :db_plane "Datomic-like CommitDag; DistributedDatomCommit as accountability chain"
  :spin_boundary "Spin/SpinKube から採るのは trigger と single-app DX のみ。中央 k8s control plane は不採用"
  :murakumo "com-junkawasaki/murakumo ≅ wadm + wash for kotoba WASM mesh"}

 :security_posture
 {:principle "private data boundary は peer trust / selective replication ではなく object encryption に置く"
  :radicle_private_repo
  {:strengths ["Git workflow を維持" "RID/DID/delegate による主権 identity" "allow-list selective replication"]
   :limits ["暗号化 at rest ではない" "許可 seed/peer が侵害されると平文 repository は読める" "長期秘匿と harvest-now-decrypt-later には不十分"]}
  :kotoba_private_object
  {:public_metadata ["ciphertext-cid" "datom" "CommitDag" "capability policy" "identity journal"]
   :private_content "envelope-encrypted blob"
   :cid_policy {:replication_key "ciphertext-cid = hash(ciphertext)"
                :verification_key "plaintext-cid = hash(plaintext), authority-scoped metadata"}
   :access_control ["capability datom" "recipient set" "epoch key"]
   :revocation "既存暗号文は消せない前提。new epoch key へ rotate し future writes を遮断"
   :crypto_agility [:alg :hash :sig :kem :key-id :recipient-set :epoch :created-at]
   :post_quantum_target
   {:kem "hybrid classical+PQ, e.g. X25519 + ML-KEM"
    :signature "hybrid classical+PQ, e.g. Ed25519 + ML-DSA or SLH-DSA"
    :hash "multihash / algorithm-tagged CID"
    :migration "GPG/git-annex 既存資産は PQ/hybrid envelope への再暗号化 migration を前提に保全"}}}

 :secret_tools
 {:gpg {:role "現行 DataLad/git-annex at-rest encryption"
        :use_for ["large binary" "evidence" "personal warehouse" "B2 special remote"]
        :caveat "複雑で運用ミス余地が大きい。PQ は将来 migration"}
  :age {:role "simple file/blob envelope candidate"
        :use_for ["small-to-medium secret blob" "developer-local encryption"]
        :caveat "標準 age 単体は PQ ではない。長期秘匿は hybrid 化が必要"}
  :sops {:role "structured secret config encryption"
         :use_for ["YAML/JSON/env style config values" "repo-stored secret config"]
         :caveat "構造や key 名は見える。大容量 blob には使わない"}
  :kotoba-envelope {:role "CID/Datom/DHT-native object encryption"
                    :use_for ["untrusted mesh replication" "algorithm-agile private object store"]
                    :status "target design, not fully implemented"}}

 :decision
 ["kotoba の Radicle 対応は protocol compatibility ではなく role equivalence として扱う"
  "private repository 相当の長期秘匿は Radicle 型 selective replication だけに依存しない"
  "kotoba private data は envelope encryption + recipient set + epoch key を必須境界にする"
  "現行運用は DataLad/git-annex + B2 + GPG hybrid encryption を継続する"
  "post-quantum は ML-KEM / ML-DSA / SLH-DSA を候補に、hybrid migration 可能な metadata を先に固定する"]}
