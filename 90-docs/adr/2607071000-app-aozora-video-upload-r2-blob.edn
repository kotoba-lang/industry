[{:adr/authoritative_for ["PDS uploadBlob/getBlob の byte store (R2 aozora-pds-blobs, binding BLOBS,\n    key blob/<cid>) と 100MB 上限" "cljs SPA post-composer の動画添付 → app.aozora.embed.video record embed" "appview com.etzhayyim.yoro.feed.getVideoFeed (server-side video filter)" "SPA /videos の appview 成功・0件時の public チェーン degrade 規則"], :adr/supersedes [], :adr/superseded_by [], :adr/topic "app-aozora-video-upload", :adr/related ["90-docs/adr/2607062100-app-aozora-vertical-video-feed.md" "90-docs/adr/2607071100-app-aozora-live-media-plane-v0.md"], :adr/status "accepted", :adr/id "adr-2607071000-app-aozora-video-upload-r2-blob", :adr/doc_type "adr", :adr/last_verified "2026-07-07", :adr/implementation "{:repo \"gftdcojp/app-aozora\", :merges [\"653ea254fed4 (appview getVideoFeed)\" \"c66c8d701306 (pds R2 + composer)\"], :deploys [\"app-aozora-pds d79edc06\" \"app-aozora-appview 7858e5de\" \"app-aozora-spa efad26cf\"], :verification [\"本番 uploadBlob→getBlob 100KB 往復 bytes 一致 (video/mp4, immutable)\" \"getVideoFeed 200 空配列 (graph に動画無し — 正)\" \"/videos 本番: appview空→thevids 500→What's Hot degrade で描画\" \"tests: 40-engine 259 + SPA 47 green\"]}", :adr/decision "{:chosen [\"PDS blob store = R2 (binding BLOBS, key blob/<cid>)。uploadBlob が bytes を\\n    PUT (失敗は 500)、getBlob は R2-first + IPFS gateway fallback。100MB 上限\" \"appview getVideoFeed: timeline を video embed 持ち record に filter\\n    (aozora native / bsky blob / recordWithMedia)。record は JS object なので\\n    goog.object アクセス。limit は filter 後\" \"composer: raw-body at-upload-blob + :atproto/upload-blob fx。投稿時\\n    uploadBlob → app.aozora.embed.video {src=getBlob URL, video=blob ref}\" \"SPA: appview 成功・0件・cursor無しは public チェーンへ degrade\\n    (deployed-but-dry の false empty state 防止)\" \"live? は embed :live true も判定 (ADR-2607071100 告知 post 連携)\"], :rejected [{:option \"Bluesky video service 互換 (uploadVideo job API)\", :why \"aozora PDS に video service が無い。直 URL embed (app.aozora.embed.video)\\n          は ADR-2607062100 で予約済みで、<video> がそのまま再生できる\"} {:option \"kotobase blob-ingest を先に実装して IPFS を byte store に\", :why \"kotobase 側の未実装 endpoint に依存。R2 は既存 bucket で即日動く。\\n          ingest が繋がれば gateway fallback が実体を持つ (follow-up)\"}]}", :db/id -1, :adr/follow-ups ["uploadBlob の認可強制 (PDS_REQUIRE_AUTH との整合)" "kotobase blob-ingest (R2→IPFS push) で gateway fallback に実体" "画像添付 (app.bsky.embed.images) — 同経路で未実装"], :adr/problem "{:source \"オーナー指示 (2026-07-07): ADR-2607062100 follow-up 3 点の実装\", :facts [\"PDS uploadBlob は bytes を保存せず (PSA pin は best-effort メタデータのみ、\\n    gateway 到達可能と仮定という documented TODO) — getBlob は常に失敗する壊れた経路\" \"appview getVideoFeed 未実装 — /videos チェーン先頭が常に fail\" \"SPA に動画投稿手段が無い (interop は JSON 専用 xrpc-fetch のみ)\" \"R2 bucket aozora-pds-blobs が legacy aozora-app Worker 用に既存\"]}", :adr/authoritative true, :adr/title "ADR-2607071000: app-aozora — 動画アップロード経路 (PDS R2 blob store + composer 添付 + appview getVideoFeed)"}]