[{:adr/consequences "{:isolation \"3 substrates each own one concern; no cycles; aozora-deploy = identity reg (1x), runtime publish attributed by venue\", :venues \"user-WASM and fleet-kototama both materialize the same CID from kotoba, both publish to aozora; attribution differs (user vs actor+leash)\", :reuse \"lands under existing nbb e7m consolidation; no new CLI binary (rename-only)\", :gaps \"{:pin-cli 'actor pin CLI not yet tidied', :kotodama-cells 'R0 scaffold', :build-wasm 'compiler+IDB exist but e7m actor build-wasm not wired', :leash 'member key is owner-supplied (no-server-key)'}\"}", :adr/authoritative_for ["3 substrate は対等な deploy 先でなく、storage/compute/publish の3関心事。aozora は compute 基盤でなく publish 先+identity 登録場所" "依存は厳密レイヤリング: author → kotoba → {murakumo|browser-WASM} → aozora。循環なし。3登録は互いに独立(idempotent)" "nbb e7m(ADR-2606222000)の下に 3 facet を1名詞で統合: e7m actor {mesh, pin(kotoba), reside(murakumo), identify(aozora), deploy --all}。既存 aozora:deploy=identify, kotobase:pin=pin, murakumo:deploy=reside のリネーム統合" "2 実行会場(browser-WASM=user主権 / murakumo kototama=communal 常駐)はどちらも kotoba から具現化し aozora へ publish。venue が署名帰属を分ける"], :adr/supersedes [], :adr/superseded_by [], :adr/topic "substrate-architecture", :adr/related ["90-docs/adr/2606222000-nbb-e7m-cli-consolidation.md" "90-docs/adr/2607022200-com-etzhayyim-tashikame-factcheck-aozora-actor-r0.md" "90-docs/adr/2607022210-com-etzhayyim-kouhou-public-info-actor-r0.md" "orgs/etzhayyim/root/70-tools/src/etzhayyim/aozora_deploy.cljc" "orgs/etzhayyim/root/50-infra/murakumo/fleet.edn" "orgs/gftdcojp/net-kotobase/kotoba/"], :adr/status "accepted", :adr/id "adr-2607022300-actor-deploy-3-substrate-topology", :adr/doc_type "adr", :adr/last_verified "2026-07-02", :adr/decision "{:topology \"3 substrate = 3 concerns (storage/compute/publish). aozora is publish-sink + identity-register, NOT compute.\", :layering \"author → kotoba(storage) → {murakumo | browser-WASM}(compute) → aozora(publish). no cycles; 3 registrations independent & idempotent.\", :facets {:kotoba {:concern :storage, :verb \"pin\", :registers \"code+state by CID\", :shipped-via \"nbb kotobase:pin / actor:mesh\"}, :murakumo {:concern :compute-resident, :verb \"reside\", :registers \"kototama (resident Pregel cell)\", :shipped-via \"nbb murakumo:deploy --node\"}, :aozora {:concern :publish, :verb \"identify\", :registers \"did+profile+lexicon on PDS (1x)\", :shipped-via \"nbb aozora:deploy [--apply]\"}}, :execution-venues [{:venue \"browser-WASM\", :mode \"user-sovereign (no-server-key pure form)\", :publish-signed-by \"user key\", :maturity :gap-wiring} {:venue \"murakumo kototama\", :mode \"communal resident (distributed inference)\", :publish-signed-by \"actor did + member CACAO leash\", :maturity :lite-runner-live-cells-r0}], :unified-cli \"under nbb e7m (ADR-2606222000): e7m actor {mesh, pin, reside, identify, deploy --all}; rename-only of existing nbb tasks, no new CLI binary\", :aozora-1-2-3 \"`e7m actor identify` (= aozora:deploy) already does (1) PDS did/profile reg, (2) LEASH member CACAO, (3) createRecord auth — ~80% shipped; gap = child-repo actor manifest wiring + owner-supplied member key\"}", :adr/honesty "{:maturity \"identify=shipped, pin/reside=partly-built/R0, browser-WASM=gap-wiring. This ADR fixes topology+ naming; per-facet depth (pin CLI, full kotodama cells, build-wasm) is follow-up.\", :outward \"live aozora publish needs owner-supplied member LEASH + actor repo on PDS; design-resolved via identify, key still owner-supplied (no-server-key).\"}", :db/id -1, :adr/problem "{:source \"owner directive 2026-07-02 (deploy Q&A)\", :investigated [\"kotoba Rust CLI (gftdcojp/net-kotobase)\" \"nbb murakumo:deploy / fleet:probe\" \"nbb aozora:deploy + aozora_deploy.cljc\" \"nbb e7m consolidation (ADR-2606222000)\" \"kotoba-clj WASM compiler + IdbBlockStore\"], :gap \"3 substrate CLI を『対等な deploy 先』と見做すと storage/compute/publish が混同され、aozora で actor を走らせる誤謬と CLI の乱立(e7m TS / etzhayyim-cli Go 二重化の再発)を生む\", :risk \"aozora=compute の誤謬、依存の循環、実行会場(user-WASM vs fleet)と publish 帰属の分離不明確\"}", :adr/alternatives "[{:option \"treat 3 substrates as peer deploy targets\", :rejected_because \"conflates storage/compute/publish; leads to the 'run the actor on aozora' category error\"} {:option \"single unified substrate\", :rejected_because \"loses the user-sovereign-WASM vs communal-fleet dual and the CID-verifiable storage/compute split\"} {:option \"three new standalone CLI binaries (kotoba/murakumo/aozora)\", :rejected_because \"collides with nbb e7m consolidation (ADR-2606222000); reproduces the e7m-TS / etzhayyim-cli-Go duplication\"}]", :adr/authoritative true, :adr/title "ADR-2607022300: actor deploy 3-substrate topology — kotoba=storage / murakumo=compute / aozora=publish + unified e7m actor CLI"}]