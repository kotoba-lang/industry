 :adr/date "2026-09-10"
 :adr/deciders ["Jun Kawasaki" "Claude Opus 5"]
 :adr/repos ["com-junkawasaki/root" "kotoba-lang/kotobase" "kotoba-lang/ayatori" "kotoba-lang/io-ipld" "kotoba-lang/osaho" "kotoba-lang/amu"]
