  {:api-namespace "kotobase.datomic"
   :argument-order
   ["(d/db conn)"
    "(d/transact conn {:tx-data [...]})"
    "(d/q query db & inputs)"
    "(d/pull db selector eid)"
    "(d/datoms db {:index ... :components ... :limit ...})"]
   :transaction-syntax
   ["Datomic Client {:tx-data [...]}"
    "entity maps with :db/id"
    "[:db/add e a v]"
    "[:db/retract e a v]"
    "[:db/retractEntity e]"]
   :query-syntax
   ["vector and map query representation"
    ":find :in :where :with :keys :strs :syms"
    "relation, scalar '.', collection '...', tuple"
    "joins, negation, or/or-join, whitelisted functions, aggregates, rules"]
   :wire
   {:content-type "application/edn"
    :routes ["/v1/transact" "/v1/q" "/v1/pull" "/v1/datoms" "/v1/head"]
    :database-ref-header "x-kotobase-ref"
    :query-evaluation "EDN reader only; never eval; fixed function whitelist"}
   :storage
   {:provider "kotobase-storage-d1"
    :contracts ["IBlockStore" "IRefStore" "IBackendCapabilities"]
    :publication-order ["persist immutable IPLD blocks" "conditional ref CAS"]
    :not-postgresql true
    :not-embedded-sqlite true}
   :security
   {:authentication "signed Ed25519 did:key CACAO with iat/exp/nonce validation"
    :authorization "deny-by-default capability plus tenant-ref prefix"
    :replay-protection "D1-backed nonce claim"
    :evidence "sanitized decisions only; raw credential is not persisted"}}
