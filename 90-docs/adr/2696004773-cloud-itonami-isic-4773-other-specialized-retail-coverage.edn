[{:adr/id 2696004773
  :adr/title "cloud-itonami-isic-4773 — Other-Specialized-Retail Operations Coordination"
  :adr/status :accepted
  :adr/date "2026-07-16"
  :adr/scope [:kotoba-lang/industry :cloud-itonami/cloud-itonami-isic-4773]
  :adr/references [2607121000 2680004719]

  ;; Wave 2 actor (coordination/logistics/trade): other retail sale of new
  ;; goods in specialized stores (a catch-all class for single-category
  ;; specialty shops not covered by other 477x classes) operations
  ;; coordination-only (sales-record logging, staffing-operation
  ;; scheduling, supply-order coordination, quality-concern flagging).

  :actor/id :cloud-itonami-isic-4773
  :actor/name "Other-Specialized-Retail Operations Coordinator"
  :actor/isic-rev5 "4773"
  :actor/domain :retail/other-specialized-stores
  :actor/wave 2
  :actor/coordination? true
  :actor/robotics? true

  :actor/proposal-ops [:log-sales-record :schedule-staffing-operation
                       :coordinate-supply-order :flag-quality-concern]
  :actor/always-escalate-ops [:flag-quality-concern]
  :actor/cost-threshold-escalate-ops {:coordinate-supply-order 1500}

  :actor/hard-checks [:store-verified :vendor-verified :effect-propose :scope-exclusion]
  :actor/scope-excluded-terms ["finalize the refund decision" "finalized the refund decision"
                                "process the refund without review" "processed the refund without review"
                                "issue a final resolution to the dispute" "issued a final resolution to the dispute"
                                "authorize the replacement unilaterally" "authorized the replacement unilaterally"
                                "close the dispute unilaterally" "closed the dispute unilaterally"
                                "determine fault and refund the customer" "determined fault and refunded the customer"
                                "accept liability for the defect" "accepted liability for the defect"
                                "settle the quality dispute directly" "settled the quality dispute directly"
                                "grant the customer a final refund" "granted the customer a final refund"
                                "reject the customer's claim outright" "rejected the customer's claim outright"
                                "finalize the quality-dispute resolution" "finalized the quality-dispute resolution"
                                "execute the replacement without approval" "executed the replacement without approval"
                                "返金を確定した" "返金を確定させた" "返金を独断で実行した"
                                "交換を独断で承認した" "交換対応を独断で確定した"
                                "クレームを一方的に解決した" "苦情を一方的に解決した"
                                "品質紛争を独断で解決した" "品質紛争の最終判断を下した"
                                "苦情対応を最終決定した" "返品対応を独断で確定した"
                                "損害賠償を確定した" "賠償責任を認めて確定した"]

  ;; Self-trip-avoidance: every term above is phrased as the
  ;; finalization/execution ACTION, never a bare noun -- this namespace's
  ;; own :flag-quality-concern default proposal legitimately discusses
  ;; defective-goods/mis-shipment/product-safety concerns, and its own
  ;; printed :op keyword literally contains the substring "quality". A
  ;; bare-noun term list (e.g. bare "refund"/"dispute"/"defect") would
  ;; self-trip this actor's own core happy path on every single run.
  ;; Regression test:
  ;; governor-test/default-mock-advisor-proposals-never-self-trip-scope-exclusion.

  :phase/rollout
  {0 {:label "read-only" :writes #{} :auto #{}}
   1 {:label "assisted-logging" :writes #{:log-sales-record} :auto #{}}
   2 {:label "assisted-coordination" :writes #{:log-sales-record :schedule-staffing-operation
                                               :coordinate-supply-order}
      :auto #{}}
   3 {:label "supervised-auto" :writes #{:log-sales-record :schedule-staffing-operation
                                         :coordinate-supply-order :flag-quality-concern}
      :auto #{:log-sales-record :schedule-staffing-operation :coordinate-supply-order}}}

  :operation/entry-point :intake
  :operation/nodes [:intake :advise :govern :decide :request-approval :commit :hold]

  :test/counts {:total 56 :assertions 166 :failures 0 :errors 0}
  :test/coverage [:governor-hard-checks :advisor-shapes :phase-rollout :integration
                  :store-contract :scope-exclusion-self-trip-regression
                  :vendor-verification]
  :test/simulator :specialtyretailops.sim

  :registry/maturity :implemented
  :registry/repo "https://github.com/cloud-itonami/cloud-itonami-isic-4773"
  :registry/business-id "cloud-itonami-isic-4773"
  :registry/required-technologies [:robotics :identity :forms :dmn :bpmn :audit-ledger :retail]
  :registry/operating-states [:intake :advise :govern :approve :commit :audit]

  :db/id -1}]
