(vector (map (:db/id -1)
  (:adr/id "adr-2800000200-cloud-itonami-isic2813-jsic4721-equipment-asset-visualize-ci")
  (:adr/title "ADR-2800000200: cloud-itonami — isic-2813⇔jsic-4721 equipment-asset連携 + isic-2813 :visualize CI job追加(pw_eval.cjsクロスプラットフォーム化)")
  (:adr/status "accepted")
  (:adr/doc_type "adr")
