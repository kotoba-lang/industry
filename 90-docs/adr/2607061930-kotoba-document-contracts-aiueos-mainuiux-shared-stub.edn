 :new-repo
 {:path "orgs/kotoba-lang/kotoba-document-contracts"
  :github "kotoba-lang/kotoba-document-contracts"
  :visibility :public
  :language ".cljc"
  :status :stub
  :naming-convention "kotoba-<domain>-contracts, matching kotoba-core-contracts / kotoba-adapter-contracts"}

 :contract-surface
 [{:ns "kotoba.document.dom"
   :covers "trusted-subset DOM tree node shape (element + text node)"
   :produced-by ["kotoba.wasm.dom (dom-gpu)"]
   :consumed-by ["kotoba-lang/htmldom" "kotoba-lang/cssom"]}
  {:ns "kotoba.document.style"
   :covers "resolved-style map shape (flat CSS-property-keyword -> resolved value)"
   :produced-by ["kotoba-lang/cssom cascade"]
   :note "known-properties allow-list tracks THIS implementation's supported set, not full CSS"}
  {:ns "kotoba.document.draw-ops"
   :covers "draw-ops vocabulary (:rect/:text/:clip/:node)"
   :produced-by ["kotoba-lang/cssom layout"]
   :consumed-by ["dom-gpu webgl.cljs" "dom-gpu webgpu.cljs" "future aiueos mainuiux renderer (not yet built)"]
   :note "single most directly reusable layer for a future non-Clojure renderer"}]

 :non-goals-for-capability-secure-os-and-wasm-browser
 [{:item "full WHATWG HTML5 tree-construction algorithm (foreign content, adoption agency, encoding sniffing)"
   :reason "trusted authored content, not hostile arbitrary web input"}
  {:item "ambient network/filesystem/DOM/clipboard access"
   :reason "browser's own ADR-0001 core invariant: only host capabilities at the ABI boundary, never ambient; matches kotoba's own capability-confinement language design (ambient authority antipattern rejected)"}
  {:item "general Web Platform API surface (IndexedDB, WebRTC, WebAuthn, Payment Request, Web Audio, Service Workers, WebUSB, ...)"
   :reason "aiueos's own manifest/policy/broker layer is the capability surface; ambient browser-style APIs contradict capability confinement"}
  {:item "JIT-class general JS execution requirement"
   :reason "this contract has no opinion on script execution; kotoba-lang/browser itself already chose a JIT-less QuickJS interpreter as sufficient"}
  {:item "multi-process sandboxing / site isolation"
   :reason "aiueos already provides Wasm-component-level isolation externally; no need to re-derive an isolation boundary here"}
  {:item "DevTools / extension platform"
   :reason "not needed for embedded system UI"}
  {:item "font shaping/kerning/bidi, image/video codecs, GPU compositor"
   :reason "real, already-documented open gaps in kotoba-lang/browser's own maturity matrix; inherited as follow-ups, not solved by this contract"}]

 :execution-steps
 [{:step 1 :action "scaffold orgs/kotoba-lang/kotoba-document-contracts (README + deps.edn + 3 .cljc contract namespaces + tests), verified via clojure -M:test (17 tests, 0 failures)"}
  {:step 2 :action "git init + initial commit"}
  {:step 3 :action "gh repo create kotoba-lang/kotoba-document-contracts --public + push"}
