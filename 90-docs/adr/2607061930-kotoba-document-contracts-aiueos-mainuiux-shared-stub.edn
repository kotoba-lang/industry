[{:adr/correction "{:date \"2026-07-06\", :trigger \"owner correction in chat: \\\"aiueos は rust 依存から離れて純粋な .kotoba wasm aot のはずなんですが...\\\"\", :original-claim \"future aiueos-side mainuiux implementation would be Rust/Wasm\", :corrected-claim \"aiueos's own documented self-hosting direction moves semantic authority out of Rust into .kotoba (safe Kotoba) source compiled to a Wasm component; Rust stays permanently adapter/bootstrap-only, never the semantic authority (ADR-safe-capability-language.md). kotoba-lang/kotoba already completed an analogous move, replacing its own Rust kotoba-clj compiler with a JVM-Clojure implementation on Chicory. A future mainuiux renderer conforming to this contract should follow the same pattern.\", :honesty-caveat \"aiueos's own checked-out repo today (orgs/kotoba-lang/aiueos) is still a real Rust crate (Cargo.toml + src/) -- the .kotoba-wasm-AOT model is the documented direction, not yet aiueos's own shipped state\", :files-corrected [\"orgs/kotoba-lang/kotoba-document-contracts/README.md\" \"90-docs/adr/2607061930-kotoba-document-contracts-aiueos-mainuiux-shared-stub.md\" \"90-docs/adr/2607061930-kotoba-document-contracts-aiueos-mainuiux-shared-stub.edn\"]}", :adr/authoritative_for ["kotoba-lang/kotoba-document-contracts の新設決定と scope（DOM tree / resolved style / draw-ops の3 contract、stub のみ、parser/cascade/layout algorithm は含まない）" "capability-secure OS (aiueos) + wasm-only browser (kotoba-lang/browser) が共通して非目標とする機能群の一覧（WHATWG full parsing, ambient I/O, 汎用 Web Platform API, JIT級JS実行要件, マルチプロセスsandboxing, DevTools/拡張機能, フォント/コーデック/GPU compositor）" "aiueos-cljc-contract は KAMI clj-wgsl migration Phase 4 用に既に割当済みのため転用しない、という判断" "訂正（オーナー指摘）: 将来の aiueos 側 mainuiux 実装は Rust/Wasm ではなく .kotoba（safe Kotoba）ソース + Wasm component であるべき、という aiueos 自身の self-hosting 方針との整合"], :adr/supersedes [], :adr/superseded_by [], :adr/topic "kotoba-lang-document-runtime-contracts", :adr/related ["kotoba-lang/browser/docs/adr/0001-kotoba-only-browser.md" "adr-2607051300-cross-org-capability-map" "kotoba-lang/kotoba-lang/docs/adr/ADR-safe-capability-language" "adr-2607022200-aiueos-cljc-wasm-component-kernel-architecture" "adr-2607051200-kotoba-lang-ui-family-rename" "kotoba-lang/kotoba/docs/ADR-kotoba-shell-aiueos-safe-kotoba"], :adr/status "accepted", :adr/id "adr-2607061930-kotoba-document-contracts-aiueos-mainuiux-shared-stub", :adr/contract-surface "[{:ns \"kotoba.document.dom\", :covers \"trusted-subset DOM tree node shape (element + text node)\", :produced-by [\"kotoba.wasm.dom (dom-gpu)\"], :consumed-by [\"kotoba-lang/htmldom\" \"kotoba-lang/cssom\"]} {:ns \"kotoba.document.style\", :covers \"resolved-style map shape (flat CSS-property-keyword -> resolved value)\", :produced-by [\"kotoba-lang/cssom cascade\"], :note \"known-properties allow-list tracks THIS implementation's supported set, not full CSS\"} {:ns \"kotoba.document.draw-ops\", :covers \"draw-ops vocabulary (:rect/:text/:clip/:node)\", :produced-by [\"kotoba-lang/cssom layout\"], :consumed-by [\"dom-gpu webgl.cljs\" \"dom-gpu webgpu.cljs\" \"future aiueos mainuiux renderer (not yet built; expected in .kotoba per aiueos's self-hosting direction, not Rust)\"], :note \"single most directly reusable layer for a future renderer, regardless of implementation language\"}]", :adr/doc_type "adr", :adr/last_verified "2026-07-06", :adr/deciders ["Jun Kawasaki"], :adr/date "2026-07-06", :db/id -1, :adr/non-goals-for-capability-secure-os-and-wasm-browser "[{:item \"full WHATWG HTML5 tree-construction algorithm (foreign content, adoption agency, encoding sniffing)\", :reason \"trusted authored content, not hostile arbitrary web input\"} {:item \"ambient network/filesystem/DOM/clipboard access\", :reason \"browser's own ADR-0001 core invariant: only host capabilities at the ABI boundary, never ambient; matches kotoba's own capability-confinement language design (ambient authority antipattern rejected)\"} {:item \"general Web Platform API surface (IndexedDB, WebRTC, WebAuthn, Payment Request, Web Audio, Service Workers, WebUSB, ...)\", :reason \"aiueos's own manifest/policy/broker layer is the capability surface; ambient browser-style APIs contradict capability confinement\"} {:item \"JIT-class general JS execution requirement\", :reason \"this contract has no opinion on script execution; kotoba-lang/browser itself already chose a JIT-less QuickJS interpreter as sufficient\"} {:item \"multi-process sandboxing / site isolation\", :reason \"aiueos already provides Wasm-component-level isolation externally; no need to re-derive an isolation boundary here\"} {:item \"DevTools / extension platform\", :reason \"not needed for embedded system UI\"} {:item \"font shaping/kerning/bidi, image/video codecs, GPU compositor\", :reason \"real, already-documented open gaps in kotoba-lang/browser's own maturity matrix; inherited as follow-ups, not solved by this contract\"}]", :adr/execution-steps "[{:step 1, :action \"scaffold orgs/kotoba-lang/kotoba-document-contracts (README + deps.edn + 3 .cljc contract namespaces + tests), verified via clojure -M:test (17 tests, 0 failures)\"} {:step 2, :action \"git init + initial commit\"} {:step 3, :action \"gh repo create kotoba-lang/kotoba-document-contracts --public + push\"} {:step 4, :action \"author this ADR (md+edn pair)\"} {:step 5, :action \"register in manifest/repos.edn :extra-projects, regenerate west.yml via gen-west-manifest.cljs --entry kotoba-document-contracts\"} {:step 6, :action \"commit+push superproject (ADR + manifest)\"}]", :adr/authoritative true, :adr/new-repo "{:path \"orgs/kotoba-lang/kotoba-document-contracts\", :github \"kotoba-lang/kotoba-document-contracts\", :visibility :public, :language \".cljc\", :status :stub, :naming-convention \"kotoba-<domain>-contracts, matching kotoba-core-contracts / kotoba-adapter-contracts\"}", :adr/title "kotoba-document-contracts -- htmldom/cssom を aiueos の mainuiux でも使えるよう共通 stub 契約を新設", :adr/deferred ["actual aiueos-side (.kotoba source, compiled to a Wasm component) implementation that conforms to this contract -- separate future cycle" "growing known-properties / draw-ops vocabulary as cssom/dom-gpu gain new features -- ordinary incremental edits, not breaking changes"]}]