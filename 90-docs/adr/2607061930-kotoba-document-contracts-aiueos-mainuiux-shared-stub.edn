  {:step 5 :action "register in manifest/repos.edn :extra-projects, regenerate west.yml via gen-west-manifest.bb --entry kotoba-document-contracts"}
  {:step 6 :action "commit+push superproject (ADR + manifest)"}]

 :deferred
