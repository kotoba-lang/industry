{:frontmatter
 {:id "adr-2607012100-org-spirit-in-physics-web-cljc-port"
  :title "org-spirit-in-physics apps/web + apps/researcher を CLJC (cljc-ui-IR) へ移植"
  :status "proposed"
  :date "2026-07-01"
  :authoritative false
  :repo "orgs/com-junkawasaki/org-spirit-in-physics"
  :related ["90-docs/adr/2606290000-all-workers-cljc-only-policy.md"
            "90-docs/adr/2607011800-org-spirit-in-physics-api-worker-cljc-port.md"]}

 :decision
 {:product "org-spirit-in-physics"
  :placement :com-junkawasaki
  :subject :web-researcher-cljc-port
  :pattern :a_assets_only
  :definition "apps/web + apps/researcher（SvelteKit 2 / Svelte 5, 合計~14,400行）を shadow-cljs :target :browser の cljc-ui-IR へ移植する。フェーズ0-2（基盤+単純ページ）のみが本ADRの対象、3D/D3/KaTeXはフェーズ3-5へ先送り。"
  :scope_boundary "フェーズ0(基盤)・フェーズ1(pkg/*データ)・フェーズ2(単純ページ+認証配線)のみ。Force3D/D3チャート/KaTeXは別ADR。"
  :corrections
  {:cloud_murakumo "ADR-2606290000は cloud-murakumo を 'prod実績あり' の Pattern A 参照実装として記載しているが、実際は369行・単一commit(2026-06-30 21:18)のPoC。ADR-2606290000自体の日付(2026-06-29)がこのコードの存在より前であり、当時の記述は事実に基づいていない。DOM全再構築(差分無し)・フォームはslider1個のみ・パラメータ無しhashルート3画面・テスト無し。README記載の 'orgs/kotoba-lang/wasm-ui への移行' も当該ディレクトリが存在せず事実誤認。"
   :kami_engine "kami-engine-sdk-clj(cljc/cljs層, 2298行, unit test 16件green)は実在するが、ブラウザでのライブ動作は未検証。オービットカメラ・エッジ/ライン描画パイプライン・力学シミュレーション(kami-graphはRust 2D限定でcljsバインディング無し)は新規結合が必要。"}
  :rationale ["cloud-murakumoの実証規模(369行PoC)は対象アプリ(~14,400行・30ルート・動的ルート・フォーム多数)に対して不十分。差分レンダラー/パラメータ付きルーティング/フォームプリミティブを新規構築する"
              "D3・KaTeXは組織内にcljs相当が無く、ADR-2606290000のexemption条項(TS-only SDKはinterop wrapがデフォルト)を適用してフェーズ4/5でnpm interop wrapする"
              "lib/components/researcher/*はweb/researcher間でバイト同一コピペのため、移植時に1つの共有名前空間へ統合する"
              "pkg/visualization/structure-analysis.ts(552行、pkgの約48%)はどこからも呼ばれていない未使用コードのため移植対象から除外"]
  :phases
  {:phase0 "apps/web-cljc/ スキャフォールド(shadow-cljs :browser, Pattern A) + cljc-ui-IRコア(ir/dom差分レンダラー/router/state/forms)新規実装"
   :phase1 "pkg/consent・pkg/experiment・pkg/visualization(types+emotion-normalization、structure-analysis除く)をEDNデータとして移植"
   :phase2 "3D/D3/KaTeX非依存の単純ページ先行移植(consent/settings/privacy/support/sessions/participants)+ 認証配線(api-worker-cljc対向)"
   :phase3 "kami-engine-sdk-clj結合によるForce3D可視化(別ADR・別セッション)"
   :phase4 "D3(TimelineChart/KPICards)をnpm interop wrapで移植(別ADR・別セッション)"
   :phase5 "KaTeX/markdown(/paper静的ページ、別ADR・別セッション)"}
  :implementation {:language ".cljc"
                    :builds {:web "shadow-cljs :browser → 静的アセット"
                             :web-test "shadow-cljs :node-test"}
                    :runtime "ブラウザ(SPA)、api-worker-cljcへfetch"}}

 :guardrails
 {:no_big_bang "フェーズ0-2のみ本ADR対象。3D/D3/KaTeXは既存SvelteKit実装のまま温存し段階移行"
  :dedup "lib/components/researcher/*のweb/researcher間コピペを1名前空間へ統合、二重メンテナンスを引き継がない"
  :dead_code_exclusion "structure-analysis.ts(未使用)は移植対象から除外"
  :git "shallow既定・FF-only main・force-push禁止。org-spirit-in-physicsはwest管理パスのためworktreeで作業"}

 :out_of_scope ["Force3D可視化(kami-engine結合)"
                "D3チャート(TimelineChart/KPICards)"
                "KaTeX/paperページ"
                "本番デプロイ・cutover・既存SvelteKitアプリの削除"
                "apps/analyzerとresearcher / の3Dパネル部分(3D依存のため後続フェーズ)"]

 :verification_2026_07_01
 {:phase 0
  :scaffold "apps/web-cljc/ に shadow-cljs.edn + ir/dom/router/state/api_client/forms.cljc の新規実装"
  :pending "scaffold → pkg dedata移植 → 単純ページ移植 → test → build → ブラウザ実動作確認 → PR"}}
