 :decision
 {:product "org-spirit-in-physics"
  :placement :com-junkawasaki
  :subject :web-cljc-phase4-d3-timeline
  :pattern :a_assets_only
  :definition "TimelineVisualization.svelte のシェル(タブ切替+データ取得)とTimelineChart+KPICardsをspirit-ui.views.web.timelineへ移植。d3はnpm interop wrap、:opaque機構(フェーズ5のKaTeXと同様)でSVGへの直接DOM操作を許容。'force3d'タブはフェーズ3待ちのプレースホルダ。"
  :independence_from_phase3 "TimelineChart/KPICardsはTimelineVisualization.svelteの'timeline'タブでのみ使われ、Force3DThrelte/Force3DControls/StructureAnalysisPanel('force3d'タブ)には依存しない。実際に到達可能な5ルート(apps/web: demo/force3d・experiment/report・analyzer、apps/researcher: +page・participants/[id])で確認済み。"
  :d3_api_surface ["select" "selectAll" "scaleTime" "scaleLinear" "extent" "max" "area" "line" "curveMonotoneX" "brushX" "axisBottom" "timeFormat"]
  :d3_version "^7.9.0"
  :opaque_reuse "TimelineChartは$effect内での命令的D3 DOM操作(host-mutated subtree)。dom.cljsの:opaque機構(ADR-2607012230で導入)をKaTeXに続く2例目として再利用する。"
  :backend_status "apps/api-worker-cljc/src/spirit/routes/timeline.cljc(フェーズ0/PR #19で移植済み)が/api/timeline/{integrated,analysis,word-statistics,word-aggregates,emotion-vectors}を実装済み。新規バックエンド作業は不要、api_client.cljcへのfetch呼び出し追加のみ。"
  :kpi_delta_decision "KPICardsの前回値差分はMath.random()ベースのdemo placeholder(オリジナルコードコメントで明記、実データでない)。研究ツールで捏造トレンドを表示するのは誤解を招くため、本移植ではオーナー判断(2026-07-01, AskUserQuestion)により省略。カード本体(値+スパークライン)は忠実に移植。"
  :implementation {:language ".cljc"
                    :new_ns ["spirit-ui.d3-interop" "spirit-ui.views.web.timeline (仮)"]
                    :shared_ns_touched ["spirit-ui.dom (:opaque 再利用)" "spirit-ui.api-client (timeline endpoints追加)"]}}

 :guardrails
 {:adr_before_phase "本ADRはADR-2607012100の「フェーズ4は別ADR/別セッション」を実装着手前に踏んだもの(フェーズ5での事後起票の反省を踏まえる)"
  :no_phase3_bleed "'force3d'タブ・StructureAnalysisPanelはプレースホルダに留め、フェーズ3(kami-engine結合)の前倒し実装をしない"
  :git "shallow既定・FF-only main・force-push禁止"}

 :out_of_scope ["フェーズ3(Force3D可視化、kami-engine結合)"
