    (:foreign-code "C sources/objects/CRT/linker/imports/dynamic dependencies empty")
    (:tests "aiueos 431 tests / 1305 assertions")))
   (:closed
   (vector "scalar exclusion を boot-lifetime bounded bitmap に置換"
    "duplicate claim と double-free を success path 内で拒否"
    "release 後の同一 slot reuse"
    "zeroed four-level page-table root authority の allocator からの取得"))
