  :schedule/format "edn"

  :schedule/phases
  [{:phase "M5"
    :phase-title "Datalog Statistics, Join Planner, Delta Materialized Arrangement"
    :phase-scope ["Datalog query statistics accuracy validation"
                  "Join planner selectivity estimate correctness"
                  "Delta-materialized arrangement consistency"
                  "Foundation for incremental Datalog (M8 detail scope)"]
    :phase-duration "3 weeks (Weeks 11-13)"
    :phase-readiness-dependency "M4 range compaction + safe epoch operational"

    :gates
    [{:gate-name "M5 Week 11 Gate — Statistics & Planner Readiness"
      :gate-week 11
      :gate-dates "2026-08-18 through 2026-08-24"
      :gate-type "major"
      :gate-decision-authority "Jun Kawasaki + kotobase steering"
      :gate-go-criteria [:all-pass]

      :gate-decision-criteria
      [{:criterion "Datalog Statistics Accuracy"
        :category "validation"
        :metric "Histogram correctness over 10K datom dataset"
        :target-threshold "≥99% bucket frequency accuracy (compare generated vs ground-truth)"
        :test-method "Cross-validate statistics rebuild outputs against materialized datom set"
        :evidence-artifact "90-docs/migration/M5-W11-statistics-validation-report.edn"
        :failure-escalation "statistics subsystem remediation sprint"}

       {:criterion "Join Planner Selectivity Estimates"
        :category "validation"
        :metric "Planned vs actual cardinality error"
        :target-threshold "<10% RMS error on join selectivity predictions"
        :test-method "Execute 500+ representative queries; compare planner estimates to actual result cardinality"
        :evidence-artifact "90-docs/migration/M5-W11-planner-selectivity-report.edn"
        :failure-escalation "statistics calibration or cardinality model redesign"}

       {:criterion "p95 Query Latency (Materialized Plans)"
        :category "performance"
        :metric "Latency percentile under planned join order"
        :target-threshold "p95 <50ms (100 datom × 32-way join workload)"
        :test-method "Execute planned joins on W10 snapshot; measure tail latency"
        :evidence-artifact "90-docs/migration/M5-W11-latency-profile.edn"
        :failure-escalation "join execution or cache tuning"}

       {:criterion "Delta Arrangement Consistency — Base vs Materialized"
        :category "correctness"
        :metric "Arrangement staleness and correctness"
        :target-threshold "Materialized views ≤1 sec behind base tables; ≥99.99% semantic parity"
        :test-method "Concurrent base + arrangement mutation; verify read paths converge"
        :evidence-artifact "90-docs/migration/M5-W11-arrangement-staleness-report.edn"
        :failure-escalation "arrangement maintenance logic remediation"}

       {:criterion "Statistics Freshness"
        :category "freshness"
        :metric "Time since last statistics rebuild"
        :target-threshold "<1 sec staleness after datom batch append"
        :test-method "Automated rebuild trigger latency measurement"
        :evidence-artifact "90-docs/migration/M5-W11-statistics-freshness-report.edn"
        :failure-escalation "rebuild scheduling or batching optimization"}
      ]

      :gate-pass-criteria
      "All five criteria must be ✓ pass. Any ✗ fail triggers escalation and re-test after remediation. Statistics and planner are prerequisite for Week 12-13 materialization."

      :gate-decision-process
      ["09:00 UTC Mon W11: Gate review meeting (Jun Kawasaki, kotobase team leads)"
       "10:00 UTC Mon W11: Artifact review + escalation triage if any fail"
       "15:00 UTC Mon W11: Team async response to failures (if any)"
       "09:00 UTC Tue W11: Re-test if escalations triggered"
       "16:00 UTC Tue W11: Final gate decision + signed-off artifacts"
       "17:00 UTC Tue W11: Green light or hard stop decision published"]

      :gate-blockers []
      :gate-pass-action "Proceed to M5 Week 12 delta arrangement staging"
      :gate-fail-action "Halt M5 Week 12-13 and execute remediation sprint (1-2 weeks estimated)"
    }

    {:gate-name "M5 Week 13 Gate — Delta Arrangement Production Readiness"
      :gate-week 13
      :gate-dates "2026-09-01 through 2026-09-07"
      :gate-type "major"
      :gate-decision-authority "Jun Kawasaki + kotobase steering"
      :gate-go-criteria [:all-pass]

      :gate-decision-criteria
      [{:criterion "Arrangement Update Latency"
        :category "performance"
        :metric "Time from epoch barrier to arrangement materialization"
        :target-threshold "p95 ≤100ms for 100K datom epoch batch"
        :test-method "Load-test arrangement update under 1K concurrent queries"
        :evidence-artifact "90-docs/migration/M5-W13-arrangement-update-latency.edn"
        :failure-escalation "arrangement update pipeline bottleneck analysis"}

       {:criterion "Query Plan Stability"
        :category "correctness"
        :metric "Plan invariance across consecutive epochs"
        :target-threshold "≥99.9% consistent plan selection for identical logical queries"
        :test-method "Re-execute same queries across 10 consecutive epochs; verify plan choice"
        :evidence-artifact "90-docs/migration/M5-W13-plan-stability.edn"
        :failure-escalation "planner heuristic review or statistics recalibration"}

       {:criterion "Materialized View Recompile Cost"
        :category "performance"
        :metric "CPU/memory for full arrangement recompilation"
        :target-threshold "Deterministic cost, <5% deviation across runs"
        :test-method "Stress-test arrangement rebuild under memory/CPU contention"
        :evidence-artifact "90-docs/migration/M5-W13-arrangement-recompile-cost.edn"
        :failure-escalation "arrangement incremental computation or caching review"}

       {:criterion "Integration Readiness Checklist"
        :category "readiness"
        :metric "All pre-production integration milestones complete"
        :target-threshold "✓ logged, ✓ monitored, ✓ graceful degrade, ✓ rollback procedure tested"
        :test-method "Walk-through of production runbook; execute rollback on staging clone"
        :evidence-artifact "90-docs/migration/M5-W13-integration-checklist.edn"
        :failure-escalation "integration infrastructure gap mitigation"}
      ]

      :gate-pass-criteria
      "All four criteria must be ✓ pass. M5 complete; staging ready for M6 consumer migration prep."

      :gate-decision-process
      ["09:00 UTC Mon W13: Gate review (artifacts + readiness checklist)"
       "15:00 UTC Mon W13: Final sign-off or escalation"
       "16:00 UTC Mon W13: M5 complete declaration"]

      :gate-blockers ["M5 W11 gate PASS"]
      :gate-pass-action "Proceed to M6 Week 14 gate prep (IStore consumer inventory)"
      :gate-fail-action "Execute integration remediation; gate retry W13 Fri or W14 Mon"
    }]
