{:id :kami-provider-catalog
 :date "2026-07-01"
 :authority ["orgs/kotoba-lang/kami-contracts"
             "orgs/kotoba-lang/kami-scene-contracts"]
 :adapter-default :wasm-component-model
 :crate-authority? false
 :provider-families
 [{:id :render
   :split-to "orgs/kotoba-lang/kami-engine"
   :crates ["kami-render" "kami-webgpu-rs" "kami-web" "kami-web-modelb"
            "kami-clj-host" "kami-eng-render" "kami-eng-web" "kami-ui-gpu"
            "kami-rt" "kami-rtx-native"]
   :authority "orgs/kotoba-lang/kami-contracts"
   :rule :provider-loads-edn-ir}
  {:id :physics
   :split-to "orgs/kotoba-lang/kami-engine"
   :crates ["kami-genesis" "kami-physics-solvers" "kami-physics-2d"
            "kami-vehicle" "kami-articulated" "kami-shugyo"
            "kami-sensor-sim" "kami-autodrive" "kami-cartpole-wasm"]
   :authority "orgs/kotoba-lang/kami-contracts"
   :rule :provider-executes-validated-step-requests}
  {:id :scene-domains
   :split-to "orgs/kotoba-lang/kami-scene-contracts"
   :crates ["kami-articulated-scene" "kami-atmosphere-scene"
            "kami-autodrive-scene" "kami-cam-scene" "kami-character-scene"
            "kami-game-scene" "kami-input-scene" "kami-mangaka-scene"
            "kami-postfx-scene" "kami-skeleton-scene" "kami-terrain-scene"
            "kami-vegetation-scene" "kami-vehicle-scene"]
   :authority "orgs/kotoba-lang/kami-scene-contracts"
   :rule :edn-fixtures-first-then-retire-rust-parsers}
  {:id :domain-providers
   :split-to "orgs/kotoba-lang/kami-engine"
   :crates ["kami-audio" "kami-bim" "kami-cad" "kami-cad-import" "kami-cae"
            "kami-cam" "kami-dft" "kami-eda" "kami-geo" "kami-gltf"
            "kami-ip" "kami-os" "kami-pkg" "kami-pnr" "kami-power"
            "kami-rtc" "kami-rtl" "kami-si" "kami-spice" "kami-usd"
            "kami-usd-native" "kami-vrm" "kami-yield"]
   :authority "domain EDN contracts"
   :rule :native-code-only-executes-validated-requests}
  {:id :app-fixtures
   :split-to "orgs/kotoba-lang/kami-app-fixtures"
   :crates ["kami-app" "kami-app-amenominaka" "kami-app-car-sim"
            "kami-app-isekai" "kami-app-quarry-walk"
            "kami-app-sarutahiko-factory" "kami-app-shibuya"
            "kami-app-tatekata" "kami-clj-play" "kami-clj-play3d"]
   :authority "EDN examples and fixtures"
   :rule :convert-to-edn-fixtures-or-delete}
  {:id :giemon
   :split-to "orgs/kotoba-lang/giemon"
   :crates ["kami-app-giemon" "kami-app-giemon-factory"]
   :authority "orgs/kotoba-lang/giemon"
   :dependency-repos ["orgs/kotoba-lang/robotics"]
   :rule :giemon-cljc-authority-adapter-loads-scene-ir}
  {:id :visual-render-providers
   :split-to "orgs/kotoba-lang/kami-engine"
   :crates ["kami-atmosphere" "kami-character" "kami-graph" "kami-live"
            "kami-map" "kami-mesher" "kami-nerf" "kami-pbrt"
            "kami-postfx" "kami-replicator" "kami-sdf" "kami-skeleton"
            "kami-terrain" "kami-text" "kami-tilemap"
            "kami-vegetation" "kami-voxel"]
   :authority "orgs/kotoba-lang/kami-contracts"
   :rule :render-domain-providers-load-edn-ir}
  {:id :engine-runtime-providers
   :split-to "orgs/kotoba-lang/kami-engine"
   :crates ["kami-core" "kami-engine" "kami-engine-clj" "kami-game"
            "kami-input" "kami-scene" "kami-scene-graph"
            "kami-script-runtime"]
   :authority "orgs/kotoba-lang/kami-contracts"
   :rule :runtime-providers-execute-validated-scene-requests}
  {:id :engineering-workflow-providers
   :split-to "orgs/kotoba-lang/kami-engine"
   :crates ["kami-bridge" "kami-dec" "kami-eng-core" "kami-eng-io"
            "kami-flow" "kami-groot" "kami-knp" "kami-mine-ai"
            "kami-mine-pds" "kami-pathfind" "kami-pdk" "kami-pipelines"
            "kami-scad" "kami-verify"]
   :authority "domain EDN contracts"
   :rule :workflow-providers-execute-validated-domain-requests}]}
