    {:repo "json" :authority :cljc-oracle :status :port-kotoba
     :first-party-deps [] :external-runtime-deps []}
    {:repo "spec" :authority :cljc-oracle :status :port-kotoba
     :first-party-deps [] :external-runtime-deps []}
    {:repo "dsl-core" :authority :kotoba :status :sovereign
