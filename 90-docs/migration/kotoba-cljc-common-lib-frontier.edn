    {:repo "lsp" :authority :cljc-oracle :status :port-after-compiler-diagnostics
     :first-party-deps [] :external-runtime-deps []}]}]

 :planned-surfaces
 [{:id :portable-edn
   :target-repo "edn"
   :status :bounded-document-textual-codec-complete
   :reason "clojure.edn/cljs.reader block 113/32 dependency closures"
   :scope [:bounded-reader :bounded-writer :closed-tags :depth-limit :size-limit
           :nil :bool :i64 :f64 :string :keyword :symbol :vector :list :set
           :document-keyed-map :contextual-document-literal]
   :authoring {:form "(document closed-edn-tree)"
               :lowering :existing-document-constructors
               :authority "kotoba-lang/kotoba-lang#364"
               :compiler "kotoba-lang/compiler#481"
               :vendor "kotoba-lang/kotoba#443"}
   :remaining []
   :forbidden [:reader-eval :ambient-class-resolution :unbounded-keyword-interning]}
  {:id :http-routing
   :target-repo "http"
   :status :bounded-exact-kernel-implemented
   :reason "reitit/ring/jetty appear in 79+ closures but physical servers are host mechanisms"
   :scope [:route-table-data :method-path-match :path-params :handler-operation :not-found]
   :forbidden [:socket-open :thread-pool :servlet-object :ambient-middleware]}
  {:id :collection-walk-set
   :target-repo "coll"
   :status :typed-set-primitives-implemented-algebra-and-walk-deferred
   :reason "clojure.walk and clojure.set remain shared portable gaps"
   :scope [:bounded-prewalk :bounded-postwalk :union :intersection :difference]
   :forbidden [:unbounded-recursion]}]

 :actor-stack
 {:run-envelope "kotoba-lang/agent"
  :graph-transition "kotoba-lang/langgraph"
  :durable-tick-lease-budget "kotoba-lang/scheduler"
  :checkpoint-and-kv ["kotoba-lang/store" "kotoba-lang/langgraph-store"]
