     :external-runtime-deps []}]}

  {:id :io-contract
   :rule "Own data contracts and pure validation only; physical I/O stays in providers."
   :libraries
   [{:repo "io" :authority :cljc-oracle :status :port-kotoba
     :first-party-deps [] :external-runtime-deps []}
    {:repo "http" :authority :mixed :status :expand-kotoba-profile
     :first-party-deps ["json"] :external-runtime-deps []}
    {:repo "fs" :authority :cljc-oracle :status :port-kotoba
     :first-party-deps [] :external-runtime-deps []}
    {:repo "time" :authority :cljc-oracle :status :port-kotoba
     :first-party-deps [] :external-runtime-deps []}
    {:repo "store" :authority :cljc-oracle :status :port-after-foundation
     :first-party-deps ["fs" "io" "wit" "coll"] :external-runtime-deps []}]}

  {:id :actor
   :rule "Bounded run, transition, scheduling, and checkpoint semantics compose; no umbrella runtime owns all four."
