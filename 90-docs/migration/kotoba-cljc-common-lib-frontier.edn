    {:repo "fmt" :authority :cljc-oracle :status :port-after-edn
     :first-party-deps [] :external-runtime-deps []}]}

  {:id :effect
   :rule "Effect requests are inert data; authority is supplied only by a host grant."
   :libraries
   [{:repo "wit" :authority :cljc-oracle :status :port-kotoba
     :first-party-deps [] :external-runtime-deps []}
    {:repo "async" :authority :kotoba :status :sovereign
