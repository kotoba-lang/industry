    {:repo "langchain" :authority :cljc-oracle :status :port-bounded-kernels
     :first-party-deps ["json"] :external-runtime-deps []}
    {:repo "langgraph" :authority :cljc-oracle :status :port-bounded-kernels
     :first-party-deps ["langchain"] :external-runtime-deps []}
    {:repo "statechart" :authority :cljc-oracle :status :port-kotoba
     :first-party-deps ["dsl-core"] :external-runtime-deps []}
    {:repo "states" :authority :mixed :status :expand-kotoba-profile
     :first-party-deps ["dsl-core"] :external-runtime-deps []}]}

  {:id :tooling
   :rule "Migration verification uses Kotoba-owned contracts; host test runners are tool-only."
