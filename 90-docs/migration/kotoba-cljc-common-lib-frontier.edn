{:schema :kotoba.cljc-common-lib-frontier/v1
 :as-of "2026-08-03"
 :authority
 {:decision "Migrate shared actor, I/O, and library-dependent semantics before leaf repositories."
  :source "90-docs/adr/2607279200-kotoba-clojure-shaped-safety-elaboration-migration.edn"
  :inventory "90-docs/migration/kotoba-cljc-project-graphs.json"
  :stdlib "orgs/kotoba-lang/kotoba-lang/docs/adr/ADR-kotoba-lang-foundational-stdlib.md"}

 :policy
 {:runtime-dependency-org "io.github.kotoba-lang"
  :leaf-runtime-dependencies :kotoba-lang-only
  :host-mechanism :capability-provider-only
  :ambient-host-apis :forbidden
  :mechanical-extension-rename :forbidden
  :shared-code-placement :kotoba-lang
  :package-shape :small-responsibility-named-libraries
  :generic-core-repository :forbidden
  :cutover-gate
  [:kotoba-source-authority
   :reference-kir-wasm-conformance
   :declared-effects
   :bounded-resources
   :host-deny-fixtures
   :cid-pinned-first-party-dependencies]}

