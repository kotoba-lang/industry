[{:checkpoint-procedures "M5-M6 Sequential Gate Reviews — Executable Procedures for Weekly Checkpoints & Gate Decisions"
  :procedures/adr-reference "adr-2607201600-kotobase-merkle-lsm-istore-retirement"
  :procedures/date-created "2026-07-21"
  :procedures/version "1.0"
  :procedures/format "edn"

  :procedures/gate-decision-process
  [{:gate-type "major-gate"
    :gate-examples ["M5 Week 11", "M5 Week 13", "M6 Week 14", "M6 Week 16"]

    :gate-procedure
    {:step-1-preparation
     {:title "Preparation (Friday afternoon before gate, or Mon 06:00 UTC if weekend gate)"
      :tasks
      [{:task "Compile all gate artifacts (5 criteria per gate)"
        :owner "Checkpoint owner (typically criteria lead)"
        :duration "2-4 hours"
        :output ["5 .edn reports, one per criterion"
                 "Each report includes: metric, measured value, target threshold, pass/fail verdict, evidence"]
        :validation "All reports peer-reviewed; escalations flagged"}

       {:task "Run automated gate evaluation script (CI/CD gate bot)"
        :owner "CI/CD infra"
        :duration "30-60 min"
        :output ["Automated gate summary: ✓ pass / ✗ fail / ⚠ escalation per criterion"
                 "Digital artifact signature (date/time stamped)"]
        :validation "No manual edits post-automation; if discrepancy, fix source and re-run"}

       {:task "Draft gate decision document (template)"
        :owner "Gate facilitator (Jun Kawasaki)"
        :duration "30 min"
        :output ["Gate decision stub with criteria summary + escalation triage (if any)"]
        :validation "Shared with team Friday EOD for async review"}
      ]}

    :step-2-gate-meeting
     {:title "Gate Review Meeting (Mon 09:00 UTC)"
      :duration "60-90 min"
      :participants ["Jun Kawasaki (decision authority)"
                     "Kotobase team leads (2-3)"
                     "Criteria owners (1 per criterion, async if <4 people)"]
      :agenda
      [{:item "Opening & context (5 min)"
        :content "Recap gate scope, decision criteria, known blockers"}

       {:item "Criterion 1 review (10-15 min)"
        :content "Presenter: criterion lead. Walkthrough: measured value vs target, evidence, go/no-go"}

       {:item "Criterion 2-5 review (10 min each, parallel if >2 criteria)"
        :content "Same format as Criterion 1"}

       {:item "Escalation triage (if any ✗ fail) (10-20 min)"
        :content "For each fail: Root cause analysis, remediation estimate, re-test schedule, decision (hard stop or 48h escalation window)"}

       {:item "Gate decision consensus (5 min)"
        :content "If all ✓ pass: unanimous green light. If any ✗ fail: hard stop or escalation resolution agreed."
        :output ["Gate decision: PASS / FAIL / ESCALATION"
                 "Escalation resolution window locked (if applicable)"]
        :approval-authority "Jun Kawasaki (final signature)"}

       {:item "Closing & next steps (5 min)"
        :content "Confirm decision published + phase gates locked (if pass) or escalation kickoff (if fail)"}
      ]

      :decision-rules
      ["All criteria must be ✓ pass to proceed. No majority rule or weighted scoring."
       "Any single ✗ fail immediately → escalation triage or hard stop."
       "Escalation window locked: team has 48h to remediate and re-test."
       "If 48h window expires without resolution: hard stop + phase delayed to next week."]

      :recording-requirement "Zoom recording + meeting notes (async-friendly archive)"
    }

    :step-3-escalation-response
     {:title "Escalation Response (if any ✗ fail, Tue-Wed)"
      :duration "24-48 hours per escalation"
      :condition "Only if gate meeting found ✗ fail"

      :tasks
      [{:task "Root cause analysis (Tue morning)"
        :owner "Criteria lead + domain experts"
        :duration "4-6 hours"
        :output ["Root cause RCA document"
                 "Remediation plan + effort estimate"
                 "Re-test schedule (e.g., Tue 15:00 UTC)"]
        :escalation-if-missing "Escalate to steering committee; phase gated hard stop"}

       {:task "Remediation execution (Tue-Wed)"
        :owner "Assigned team (domain-specific)"
        :duration "4-8 hours"
        :output ["Fixed code / config changes"
                 "Staged/tested on non-production replica"
                 "Ready for re-test"]
        :validation "Code review + merge to gate-test branch"}

       {:task "Re-test (Wed morning or Tue afternoon if urgent)"
        :owner "Criteria lead"
        :duration "2-4 hours"
        :output ["Revised .edn report (criterion + remediation result)"
                 "Pass/fail verdict on remediation"]
        :success-criteria "Criterion now ✓ pass; artifact re-signed"}

       {:task "Gate re-decision (Wed 15:00 UTC)"
        :owner "Jun Kawasaki (abbreviated meeting, 15 min)"
        :duration "30 min"
        :output ["Final gate decision: PASS (proceed) or FAIL (hard stop)"
                 "Signed artifact"]
        :failure-option "If remediation still fails: hard stop, phase delayed to W+2 or defer"}
      ]

      :escalation-communication "Slack #kotobase-m-wave channel: daily async updates (emoji: ⏳ investigating, 🔧 fixing, ✅ resolved)"
    }

    :step-4-publication
     {:title "Gate Decision Publication (Tue 16:00-17:00 UTC after gate meeting)"
      :tasks
      [{:task "Publish signed gate decision to 90-docs/migration/"
        :owner "Jun Kawasaki"
        :output ["<adr>-W<n>-gate-decision-signed.edn with timestamp + signature"]}

       {:task "Lock phase gates in CI/CD"
        :owner "CI/CD infra"
        :output ["If PASS: unlock next phase (merge gates removed)"
                 "If FAIL: block next-phase merges; require escalation resolution or week delay"]}

       {:task "Notify team + consumers (async)"
        :owner "Jun Kawasaki + facilitator"
        :output ["Slack message in #kotobase-m-wave + #general (brief)"]
        :content "Format: [GATE PASS | GATE FAIL + ESCALATION] — <gate-name>, decision: <summary>"}
      ]
    }
  }]

  :procedures/daily-checkpoint-execution
  [{:checkpoint-type "kick-off"
    :checkpoint-examples ["M5 W11 Mon kick-off", "M6 W14 Mon kick-off"]
    :checkpoint-procedure
    {:overview "Launch phase; assign leads; confirm prerequisites ready"
     :duration "1-2 hours"
     :participants ["Phase owner (Jun Kawasaki)"
                    "Assigned team leads (1-2)"
                    "Checkpoint facilitator"]

     :tasks
     [{:task "Phase kick-off meeting (09:00 UTC)"
       :agenda ["Phase scope & gate criteria review (5 min)"
                "Success criteria breakdown per criterion (10 min)"
                "Test harness / environment confirmation (5 min)"
                "Team assignments & RACI (5 min)"
                "Q&A + blockers (5 min)"]
       :output ["Teams confirmed ready"
                "Test environment signed off"
                "Baseline data ready (if applicable)"]}

      {:task "Assign criteria owners (RACI)"
       :owner "Phase owner"
       :output ["Explicit owner assigned per criterion"
                "Backup assigned (escalation coverage)"
                "Owners acknowledge async"]
       :validation "All 5+ criteria have explicit owner in assignment matrix"}

      {:task "Confirm prerequisites complete"
       :owner "Checkpoint facilitator"
       :validation-checklist
       ["Previous phase gate PASSED (if applicable)"
        "Test datasets prepared (10K datom snapshot, 1K concurrent load, etc.)"
        "CI/CD test harness deployed"
        "Logging/metrics pipeline configured"
        "Rollback procedure reviewed (for execution phases)"]
       :escalation-if-missing "Halt checkpoint; escalate to steering; delay phase"}

      {:task "Publish checkpoint summary to Slack + team"
       :owner "Checkpoint facilitator"
       :output ["Async message with: phase, dates, gate criteria, team assignments"]}
     ]

     :success-criteria "All teams assigned, prerequisites confirmed, baseline ready"
    }
  }

  {:checkpoint-type "progress"
    :checkpoint-examples ["M5 W11 Tue-Thu", "M6 W14 Tue-Wed"]
    :checkpoint-procedure
    {:overview "Daily metrics collection & mid-phase progress tracking"
     :duration "30-60 min per day"
     :automation "Automated metrics push; manual validation loop"

     :daily-routine
     [{:task "Automated metrics collection (EOD, 18:00 UTC)"
       :owner "CI/CD metrics pipeline"
       :automation "Scheduled cron job"
       :collects ["Test harness output (latency, accuracy, throughput)"
                  "Staging environment metrics (CPU, memory, I/O)"
                  "Error logs + escalation detection"
                  "Artifact signatures (timestamp)"]
       :output ["Daily metrics .edn appended to phase checkpoint log"
                "Automated alerts for >threshold deviations"]
       :validation "Manual spot-check (lead reviews Tue/Wed/Thu morning)"
      }

      {:task "Manual checkpoint review (09:00 UTC each morning)"
       :owner "Criteria lead (async, 15-30 min)"
       :checklist
       ["Metrics align with target threshold?"
        "Any anomalies or escalations overnight?"
        "Test harness still operational?"
        "Next phase prep on track?"]
       :output ["Async Slack summary (1-2 emoji bullets): ✅ on-track / ⚠️ watch / 🔴 escalate"]
       :escalation-trigger "If ⚠️ or 🔴: async thread for root cause, re-test decision within 4h"
      }

      {:task "Escalation resolution (if triggered)"
       :owner "Assigned team lead"
       :sla "4-6 hour root cause + fix plan"
       :output ["Escalation memo (RCA + remediation plan)"
                "Re-test schedule locked"
                "Status posted to team thread"]
      }
     ]

     :success-criteria "Daily metrics collected & reviewed; no unresolved escalations >24h old"
    }
  }

  {:checkpoint-type "gate-prep"
    :checkpoint-examples ["M5 W11 Fri gate-prep", "M6 W14 Fri gate-prep"]
    :checkpoint-procedure
    {:overview "Compile gate artifacts; draft decision doc; team sign-off"
     :duration "2-4 hours"
     :participants ["All 5 criteria leads", "Gate facilitator", "Jun Kawasaki"]

     :tasks
     [{:task "Criteria leads compile final reports (Fri 12:00-15:00 UTC)"
       :owner "Each criteria lead (parallel)"
       :per-criteria-report
       {:section-1 "Criterion title & gate reference"
        :section-2 "Measured value (numerical + context)"
        :section-3 "Target threshold (explicit)"
        :section-4 "Pass/fail verdict (✓ or ✗)"
        :section-5 "Evidence & validation method (reproducible)"
        :section-6 "Escalations (if any): RCA + remediation status"}
       :output ["Each .edn report: ~1-2 KB, queryable by criterion"
                "Automated CID + timestamp (deterministic)"]
       :validation "Lead attestation + peer review (async before Fri 15:00)"
      }

      {:task "Automated gate evaluation (CI/CD, Fri 15:30 UTC)"
       :owner "CI/CD gate bot"
       :automation "Scheduled job; reads all 5 reports"
       :output ["Gate summary: ✓ pass / ✗ fail / ⚠ escalation"
                "Signed artifact (date/hash)"]
       :validation "No manual gate score editing; re-run if discrepancy"
      }

      {:task "Draft gate decision doc (Fri 16:00-17:00 UTC)"
       :owner "Gate facilitator + Jun Kawasaki"
       :sections
       ["Gate criteria summary (5 rows: criterion, measured, target, verdict)"
        "Escalation triage (if any ✗ fail): impact, remediation, re-test date"
        "Recommended decision (PASS / ESCALATION / HARD-STOP)"
        "Sign-off block (decision authority, timestamp)"]
       :output ["Gate decision stub (.edn, unsigned)"
                "Shared with team async Fri EOD"]
       :review-window "Fri EOD to Mon 06:00 UTC (48h async review window)"
      }

      {:task "Team readiness sign-off (Fri EOD async)"
       :owner "All criteria leads + team leads"
       :via "Slack thread emoji reactions"
       :sign-off-options ["✅ reports ready, go-ahead confident"
                          "⚠️ reports ready but escalations pending"
                          "🔴 reports incomplete, gate delayed"]
       :escalation-if-missing "Any 🔴 → gate delayed to next Monday; RCA + remediation"
      }
     ]

     :success-criteria "All 5 reports compiled & peer-reviewed, gate decision stub drafted, team signed off"
    }
  }

  {:checkpoint-type "gate-decision"
    :checkpoint-examples ["M5 W11 gate", "M6 W14 gate"]
    :checkpoint-procedure
    {:overview "See :gate-decision-process above (step-2 through step-4)"
     :cross-reference "Detailed gate procedure: :procedures/gate-decision-process[:gate-type=major-gate]"
    }
  }

  {:checkpoint-type "stress-test"
    :checkpoint-examples ["M5 W12 Tue-Fri stress-test", "M6 W14 Wed stress-test"]
    :checkpoint-procedure
    {:overview "Execute production-scale load on staging"
     :duration "4-8 hours per day × 3 days"
     :participants ["Load test coordinator", "Infrastructure ops", "Criteria lead (monitoring)"]

     :pre-test-checklist
     ["Staging environment refreshed from M4 snapshot"
      "Test data: 100K-1M datom synthetic corpus"
      "Concurrent load: 32-1K writers + 1K readers"
      "Monitoring stack: CPU/memory/I/O + latency/throughput"
      "Rollback procedure tested + staged"
      "On-call roster ready (24h window)"]

     :load-profile
     {:phase-1-ramp-up "5 min: linearly increase from 0 to target concurrent users"
      :phase-2-steady-state "30 min: hold at target load"
      :phase-3-spike "5 min: +50% spike (test burst handling)"
      :phase-4-cool-down "10 min: ramp back to 0"
      :repeat "Repeat 3× over test window"}

     :metrics-collected
     ["Latency: p50/p95/p99 (all operations)"
      "Throughput: ops/sec (sustained)"
      "Error rate: %failed requests"
      "Resource utilization: CPU%, memory%, I/O utilization"
      "Cache hit rate: (if applicable)"
      "GC pause times: (if JVM/runtime GC)"]

     :pass-criteria
     ["p99 latency <target (e.g., 200ms) sustained for ≥15 min"
      "Error rate <0.1% (or <1% if explicitly higher threshold)"
      "No memory leak (heap size <+20% EOD vs start)"
      "No cascading failures under spike"]

     :failure-response
     ["If p99 >threshold: capture profile dump + heap dump; escalate to team"
      "If error rate >threshold: stop test, rollback, root-cause analysis"
      "If memory leak suspected: repeat with profiling; leak detection tool"]

     :output-artifacts
     ["Load test log (.edn): timestamp, phase, throughput, latency percentiles"
      "Error log (exceptions + stack traces)"
      "Resource utilization profile (CSV or .edn)"
      "Summary report: pass/fail verdict + any anomalies"]
    }
  }

  {:checkpoint-type "inventory"
    :checkpoint-examples ["M6 W14 Mon inventory audit"]
    :checkpoint-procedure
    {:overview "Audit codebase to identify all consumers/dependencies"
     :duration "4-8 hours"
     :participants ["Inventory lead", "Code reviewers (1-2)"]

     :audit-method
     {:step-1 "Grep codebase for IStore.* method calls"
      :step-2 "Trace import paths to consumer repos (drama, arrangement, kototama, net-kotobase)"
      :step-3 "Categorize: read-only vs read-write vs transactional"
      :step-4 "Cross-reference with docs/ADRs for undocumented usage"
      :step-5 "Verify each consumer identified in RACI matrix"}

     :output
     ["Consumer inventory .edn: {consumer-name → {class: read|write|transact, callers: [...], call-sites: [...]}}"
      "Dependency graph visualization (optional)"
      "Coverage checklist: kotobase-peer ✓, drama ✓, arrangement ✓, kototama ✓, net-kotobase ✓"]

     :validation
     ["Peer review: other team lead confirms audit completeness"
      "100% coverage required (no 'unknown' consumers allowed)"]

     :pass-criteria "All 4 required consumers identified; no undocumented IStore usage in codebase"
    }
  }

  {:checkpoint-type "parity-test"
    :checkpoint-examples ["M6 W14 Tue dual-read parity", "M6 W16 Tue full-dataset parity"]
    :checkpoint-procedure
    {:overview "Verify legacy IStore and new datom schema return identical results"
     :duration "2-4 hours"
     :participants ["Adapter lead", "Parity test orchestrator"]

     :test-design
     {:load-test-corpus "Representative queries: 1000+ points, ranges, joins"
      :query-types ["Exact-match point lookups (entity, attribute, value)"
                    "Range scans (entity range, attribute prefix, value comparison)"
                    "Join queries (multi-table, aggregate)"
                    "Concurrent read-write (transaction isolation)"]
      :shadowing-mode "Dual-read: send query to both IStore (legacy) and datom (new), compare results"}

     :parity-check
     ["Result set size match (≥99.99%)"
      "Entity/attribute/value byte-for-byte match"
      "Ordering match (if applicable)"
      "Timestamp/version metadata match"]

     :mismatch-response
     ["Log mismatch (query + results from both systems)"
      "Escalate to adapter lead; classify as: semantic difference vs bug"
      "If bug: remediate adapter translation; re-run"]

     :output-artifacts
     ["Parity test log: query ID → {legacy result, new result, match: Y/N}"
      "Mismatch summary: {count, distribution by query type, categorization}"
      "Pass/fail: ≥99.99% parity required"]

     :pass-criteria "≥99.99% result parity; any mismatches documented + remediated"
    }
  }

  {:checkpoint-type "cutover-dry-run"
    :checkpoint-examples ["M6 W14 Thu cutover-dry-run"]
    :checkpoint-procedure
    {:overview "Execute 6-phase cutover sequence on staging; verify rollback at each phase"
     :duration "6-8 hours (one full day)"
     :participants ["Cutover coordinator (Jun Kawasaki)", "Each consumer lead (4)", "Ops/infra"]

     :six-phases
     [{:phase-number 1
       :phase-name "Adapter Shadow Deployment"
       :phase-task "Deploy legacy XRPC adapter alongside Merkle-LSM backend (read-only path)"
       :phase-duration "30 min"
       :phase-validation "Adapter healthy; no errors in logs"
       :rollback-procedure "Disable adapter; fall back to IStore directly"
       :rollback-validation "IStore read path operational; no data loss"}

      {:phase-number 2
       :phase-name "Dual-Read Activation (Shadow Mode)"
       :phase-task "Enable adapter to receive real queries; dual-read (IStore + datom) active"
       :phase-duration "30 min"
       :phase-validation "≥99.99% parity confirmed on live traffic"
       :rollback-procedure "Disable dual-read; adapter detaches from IStore (read-only remains)"
       :rollback-validation "IStore single-read path restored; adapter offline"}

      {:phase-number 3
       :phase-name "Adapter as Primary Read Path"
       :phase-task "Switch all read traffic to adapter (datom backend); IStore read-only"
       :phase-duration "30 min"
       :phase-validation "Read latency <10% delta; error rate <0.01%"
       :rollback-procedure "Revert read traffic to IStore; adapter stays online for validation"
       :rollback-validation "IStore primary read restored; p99 latency baseline"}

      {:phase-number 4
       :phase-name "Write Path to Datom Transact"
       :phase-task "Route new writes to datom transact; IStore becomes write-only (legacy capture)"
       :phase-duration "30 min"
       :phase-validation "Datom transact working; write amplification <2x baseline"
       :rollback-procedure "Revert new writes back to IStore.put; discard datom writes"
       :rollback-validation "IStore write path fully operational; data consistency verified"}

      {:phase-number 5
       :phase-name "Read-Write Parity Continuous"
       :phase-task "All I/O on new path (datom transact/query); IStore idle"
       :phase-duration "30 min"
       :phase-validation "Full parity maintained; SLO metrics green"
       :rollback-procedure "Resume IStore write path; redirect read traffic to IStore"
       :rollback-validation "IStore fully operational; any writes pending reconciled"}

      {:phase-number 6
       :phase-name "Legacy IStore Archived (Read-Only Published)"
       :phase-task "Mark IStore deprecated; publish read-only adapter as canonical interface"
       :phase-duration "30 min"
       :phase-validation "IStore marked read-only; all write requests redirected to datom"
       :rollback-procedure "Restore IStore write capability; old write path re-enabled"
       :rollback-validation "IStore fully mutable; rollback complete to pre-Phase-6 state"}
     ]

     :dry-run-execution
     [{:step "Execute Phase 1; verify rollback works"
       :time "T+0 to T+1h"}
      {:step "Execute Phase 2; verify rollback works"
       :time "T+1h to T+2h"}
      {:step "Execute Phases 3-6 sequentially; rollback verified at each"
       :time "T+2h to T+6h"}
      {:step "Repeat Phases 1-6 a 2nd time (parallel paths, race conditions)"
       :time "T+6h to T+8h"}]

     :pass-criteria
     ["All 6 phases execute successfully"
      "Rollback works perfectly from each phase"
      "No data loss or corruption at any rollback point"
      "Latency/error metrics stable throughout"]

     :output-artifacts
     ["Cutover dry-run log: phase → {start, end, validation result, rollback result}"
      "Signed pass/fail verdict"
      "Consumer runbooks for each phase (shared with teams pre-cutover)"]
    }
  }

  {:checkpoint-type "migration-cutover"
    :checkpoint-examples ["M6 W15 Mon-Thu (per-consumer)"]
    :checkpoint-procedure
    {:overview "Live cutover: switch consumer from IStore to datom backend (one per day)"
     :duration "2-4 hours per consumer"
     :participants ["Consumer lead", "Kotobase ops", "Rollback team"]

     :pre-cutover-checklist
     ["Consumer-specific runbook reviewed & signed by lead"
      "Rollback procedure staged and tested"
      "On-call team assigned + paged"
      "Monitoring alerts configured (latency, error, SLO)"
      "Cut time announced to team (no other deploys 1h before/after)"]

     :cutover-execution
     [{:step "T+0: Announce cutover window (Slack #general)"
       :duration "5 min"
       :action "Notify broader team; no other changes during window"}

      {:step "T+5: Pre-cutover baseline (measure IStore performance)"
       :duration "5 min"
       :metrics-captured ["p50/p95/p99 latency", "throughput", "error rate", "CPU%"]
       :validation "Baseline healthy; no anomalies"}

      {:step "T+10: Route traffic to adapter (one consumer at a time)"
       :duration "1-2 min"
       :action "Flip DNS/load-balancer rule; route <consumer> read/write to adapter"
       :monitoring "Watch error rate & latency (30 sec)"
       :rollback-trigger "If error rate >0.5% or p99 >baseline+20%: immediate rollback"}

      {:step "T+15: Verify adapter operational (shadow read-write)"
       :duration "5 min"
       :checks ["Consumer reads return correct data"
                "Consumer writes persist to datom backend"
                "No cascading failures"]
       :rollback-trigger "Any check fails: immediate rollback"}

      {:step "T+20: Monitor for 24-48 hours post-cutover"
       :duration "24-48h"
       :metrics ["Continuous latency p99 <baseline+10% or SLO"
                 "Error rate <0.01%"
                 "CPU/memory stable"
                 "No data loss or corruption alerts"]
       :checkpoint-frequency "Hourly automated checks (first 4h), then 4-hourly"
       :escalation-trigger "Any SLO breach → escalation team engaged; prepare rollback"
       :rollback-option "If SLO not recovered within 6h: rollback approved"}
     ]

     :post-cutover-sign-off
     ["Consumer lead attestation: ✓ cutover successful"
      "SLO confirmation: metrics within acceptable range"
      "Data integrity verified (spot checks)"]

     :output-artifacts
     ["Cutover log per consumer: [drama | arrangement | kototama | net-kotobase] cutover report"
      "Signed attestation from consumer lead"
      "SLO metrics comparison (pre- vs post-cutover)"]
    }
  }

  {:checkpoint-type "parity-audit"
    :checkpoint-examples ["M6 W16 Tue full-dataset parity"]
    :checkpoint-procedure
    {:overview "Exhaustive audit: Merkle-LSM vs legacy IStore byte-for-byte match"
     :duration "4-6 hours"
     :participants ["Audit lead", "Data integrity specialist"]

     :audit-method
     ["Export full datom graph from Merkle-LSM (canonical materialized view)"
      "Export full IStore snapshot (legacy backend, final state)"
      "Sort both by [entity, attribute, value, transaction] (deterministic order)"
      "Compare byte-for-byte: entity IDs, attribute names, values, transaction metadata"
      "Compute CID of both exports; verify CID match (determinism proof)"]

     :scope
     ["All EAVT/AEVT/AVET datoms"
      "All values (including large IPLD Links)"
      "Transaction metadata (timestamp, operation)"]

     :mismatch-handling
     ["Log each mismatch: entity, attribute, value, source (datom vs IStore)"
      "Classify: missing entity, missing attribute, value corruption, transaction metadata drift"
      "Categorize by criticality: data loss (fail gate), metadata drift (warn, proceed)"]

     :pass-criteria
     ["100% entity/attribute/value match"
      "0 data loss detected"
      "Transaction metadata match ≥99% (minor clock drift acceptable if ≤1 sec)"]

     :output-artifacts
     ["Parity audit report (.edn): {entity → {attributes → {values → {status: match|mismatch, detail}}}}"
      "Mismatch summary: count + distribution"
      "CID match confirmation: hash(Merkle-LSM export) = hash(IStore export)"]
    }
  }]

  :procedures/escalation-protocol
  {:overview "When a criterion fails or escalations are detected"

   :escalation-severity-levels
   [{:level "warning"
     :condition "Metric trending toward threshold; not yet exceeded"
     :response "Add to daily checkpoint summary; monitor; no action required"
     :sla "Monitor until EOD Fri"}

    {:level "alert"
     :condition "Metric exceeds threshold; recoverable (likely)"
     :response "Escalate within 4h; root cause + fix plan due; re-test scheduled"
     :sla "Root cause due 4h; fix due 8h; re-test within 48h"}

    {:level "critical"
     :condition "Metric far exceeds threshold; gate fail; data loss risk"
     :response "Escalate immediately; CEO/decision-authority involved; hard stop or deep remediation sprint"
     :sla "Decision within 2h; remediation plan within 4h"}
   ]

   :escalation-checklist
   ["1. Escalation triggered (gate fail or ⚠ alert)"
    "2. Slack notification: #kotobase-m-wave + @jun (immediate, async)"
    "3. RCA thread created (async)"
    "4. Team responds within SLA (4h for alert, 2h for critical)"
    "5. Remediation plan posted (effort, timeline, owner)"
    "6. Re-test scheduled"
    "7. Result posted; gate re-decision or phase delay confirmed"
    "8. Escalation closed (archive)"]

   :communication-channels
   ["Slack #kotobase-m-wave: primary"
    "Async RCA thread: detailed discussion"
    "Email to jun@gftd.group: urgent escalations (critical only)"]
  }

  :procedures/metrics-collection-and-reporting
  {:overview "How to collect, log, and validate metrics for gate evaluation"

   :metrics-pipeline
   [{:component "Test harness"
     :outputs ["Latency: p50/p95/p99 (milliseconds, per operation type)"
               "Throughput: ops/sec (per operation type)"
               "Error rate: % failed operations"
               "Accuracy: metric-specific (e.g., ≥99% histogram bucket frequency)"]}

    {:component "Staging environment telemetry"
     :outputs ["CPU %"
               "Memory %"
               "I/O bytes/sec"
               "Network throughput"
               "GC pause times (if applicable)"]}

    {:component "Application logs"
     :outputs ["Exceptions + stack traces (filtered by severity)"
               "Warnings/escalations"
               "Anomaly detection alerts"]}

    {:component "CI/CD gate bot"
     :outputs ["Automated criterion evaluation: ✓ pass / ✗ fail"
               "Comparison: measured vs target threshold"
               "Digital signature (timestamp + hash)"]}
   ]

   :logging-format
   {:artifact-type ".edn"
    :structure "{:criterion <name>, :measured-value <number>, :target-threshold <number>, :unit <string>, :verdict <pass|fail>, :evidence-method <string>, :timestamp <ISO-8601>, :signature <hash>}"
    :determinism "Same test harness + data → same metric values → same CID (if hashed)"
    :queryability "DataScript-compatible; can `?find ?c ?m where [?e :criterion/name ?c] [?e :criterion/measured-value ?m]`"}

   :data-quality
   ["Do not round values mid-calculation; round only for reporting"
    "Do not aggregate until final report (preserve raw measurements)"
    "Do not edit historical metrics (corrections must be new entries with RCA link)"
    "All metrics must be reproducible (query, load profile, dataset must be documented)"]

   :validation-rules
   ["Automated metrics collection is mandatory (no manual data entry)"
    "Human review (spot-check) occurs within 24h of collection"
    "Any discrepancy between automated + manual review → re-run automated collection"
    "Escalations must reference specific metric value + evidence method"]
  }
}]
