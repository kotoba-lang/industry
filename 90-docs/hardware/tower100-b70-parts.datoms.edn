;; Tower 100 + Arc Pro B70 ワークステーション — 部材カタログ
;; 見積(2026-08-17)の 7 品目 + 同梱クーラーを、mk1-parts.datoms.edn と同じ schema で持つ。
;;
;; 座標系(この筐体固有。MK-1 の sandwich とは別物なので注意):
;;   原点 = 筐体内空の 左下前 隅。
;;   X = 幅   (mobo トレイ面 → 反対側パネル。CPU クーラー高さ / GPU 高さ がこの軸)
;;   Y = 高さ (床 → 天面。**GPU の長さ 271mm と VGA 制限 330mm がこの軸**)
;;   Z = 奥行 (前 → 後。mobo の 170mm と PSU の 140mm がこの軸)
;;
;; レイアウトの根拠は Thermaltake 公式マニュアル(CA-1R3-00S1WN-00, A-2020.10):
;;   ・p.04 「VGA length max length: 330mm」は**縦**方向に寸法線が引かれている
;;   ・p.11 PCI Card Installation はスロットカバーを**上に**抜き、カードを**下へ**降ろす
;;   ・p.07 PSU は底部に**背面から**スライド挿入し、化粧枠 4 本のネジで留める
;;   ・p.03 CPU クーラー 190mm は基板面からの垂直距離 = 筐体内では**水平**(X)
;;   → mobo は垂直マウント・rear I/O が上向き、GPU は天面のブラケットから吊り下がる。
;;
;; :part/envelope は「この筐体に載った姿勢での」AABB を pr-str [x y z] で持つ。
;; :part/dim-grade  :spec=規格確定 / :datasheet=メーカー公称 / :estimate=推定
;; :part/tolerance-mm は片側公差。worst-case stack-up に使う。
[
 ;; ---- schema (mk1-parts と同一。join できるよう属性名を変えない) -------------
 {:db/ident :source/dataset  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :part/id         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :part/name       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :part/category   :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :part/envelope   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :part/mass-g     :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :part/power-w    :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :part/qty        :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :part/price-jpy  :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :part/interface  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :part/insert-axis :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :part/mounts-on  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :part/subassembly :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :part/mount-side :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :part/fasteners  :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :part/measured   :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}
 {:db/ident :part/dim-grade  :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :part/tolerance-mm :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :part/source     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :limit/id        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :limit/name      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :limit/axis      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :limit/max-mm    :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :limit/applies-to :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :cable/id        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :cable/name      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :cable/from      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :cable/to        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :cable/bundle-dia-mm :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
 {:db/ident :cable/min-bend-factor :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
 {:db/ident :cable/waypoints :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}

 ;; ---- 筐体(市販品。寸法は導出せず与えられる — ここが MK-1 と決定的に違う) ----
 {:part/id "chassis-tower100" :part/dim-grade :datasheet :part/tolerance-mm "[1.0 1.0 1.0]"
  :part/name "Thermaltake The Tower 100 Racing Green (CA-1R3-00SCWN-00)"
  :part/category :chassis :part/envelope "[266 462.8 266]"
  :part/mass-g 6600 :part/power-w 0 :part/qty 1 :part/price-jpy 0
  :part/interface "Mini-ITX / 2 expansion slots / Standard PS2 PSU / Tempered Glass x3 (4mm) / SPCC"
  :part/insert-axis :none :part/fasteners 0
  :part/measured false
  :part/source "公式仕様 462.8 x 266 x 266mm。**この筐体の内寸は公表されていない** — 公表されているのは下の :limit/* 4 件(クリアランス制限)だけなので、内部座標はそこから導出する。質量 6.6kg は推定(ガラス3面 + SPCC)"
  :source/dataset "tower100-b70-parts"}

 ;; ---- メーカー公表クリアランス = この検査の「契約」 -------------------------
 ;; 市販ケースで組み立て成立性を判定する正しい基準は、実測した内部形状ではなく
 ;; **メーカーが公表した制限値**である。内部形状を写真から推定して AABB を作ると、
 ;; 「実測していない数値」を「検査した」ように見せることになる。
 {:limit/id "lim-vga"    :limit/name "VGA max length"       :limit/axis :y :limit/max-mm 330
  :limit/applies-to "gpu-b70" :part/source "公式仕様表 Clearance。マニュアル p.04 で縦方向に寸法線" :source/dataset "tower100-b70-parts"}
 {:limit/id "lim-cooler" :limit/name "CPU cooler max height" :limit/axis :x :limit/max-mm 190
  :limit/applies-to "cooler-wraith" :part/source "公式仕様表 Clearance。基板面からの垂直距離" :source/dataset "tower100-b70-parts"}
 {:limit/id "lim-psu"    :limit/name "PSU max length"        :limit/axis :z :limit/max-mm 180
  :limit/applies-to "psu-pro750b" :part/source "公式仕様表 Clearance / PSU: Standard PS2 PSU (optional)" :source/dataset "tower100-b70-parts"}
 {:limit/id "lim-slots"  :limit/name "Expansion slots"       :limit/axis :z :limit/max-mm 2
  :limit/applies-to "gpu-b70" :part/source "公式仕様表 Expansion Slots: 2。単位はスロット数(mm ではない)" :source/dataset "tower100-b70-parts"}

 ;; ---- 主要部材 -------------------------------------------------------------
 {:part/id "gpu-b70" :part/dim-grade :datasheet :part/tolerance-mm "[1.0 2.0 1.0]"
  :part/name "ASRock Intel Arc Pro B70 Creator 32GB (B70 CT 32G)"
  :part/category :gpu :part/envelope "[112 271 39]"
  :part/mass-g 1100 :part/power-w 230 :part/qty 1 :part/price-jpy 204364
  :part/interface "PCIe 5.0 x16 / 1x 12V-2x6 (カード END 側) / 4x DP 2.1 / blower + vapor chamber"
  :part/mounts-on "mobo-b650i"
  :part/insert-axis :-y :part/fasteners 2
  :part/measured false
  :part/source "ASRock 公称 271 x 112 x 39mm、2-slot、TBP 230W、推奨 PSU 600W、1x 12V-2x6。**ASRock は『電源ケーブル取り付けのため長さ方向に +30mm の余裕を空けること』を明記** — コネクタがカード端にあるため。この筐体では GPU が上から吊り下がるので、その +30mm はカード下端の下に要る"
  :source/dataset "tower100-b70-parts"}

 {:part/id "mobo-b650i" :part/dim-grade :spec :part/tolerance-mm "[2.0 0.3 0.3]"
  :part/name "ASRock B650I Lightning WiFi (Mini-ITX)"
  :part/category :motherboard :part/envelope "[36 170 170]"
  :part/mass-g 500 :part/power-w 15 :part/qty 1 :part/price-jpy 0
  :part/interface "AM5 / **PCIe 4.0 x16** / M2_1 Gen5x4 + M2_2 Gen4x4 / 2x DDR5 DIMM / 2.5GbE / WiFi 6E"
  :part/subassembly :bench
  :part/insert-axis :-x :part/fasteners 4
  :part/measured false
  :part/source "Mini-ITX 規格 170x170mm(確定)。X=36 は PCB 1.6 + 実装部品高さを含む envelope 推定。**x16 スロットは PCIe 4.0 であって 5.0 ではない**(ASRock 仕様: 1 x PCIe 4.0 x16 Slot)。Gen5 は M.2 の M2_1 のみ"
  :source/dataset "tower100-b70-parts"}

 {:part/id "cpu-7500f" :part/dim-grade :spec :part/tolerance-mm "[0.2 0.2 0.2]"
  :part/name "AMD Ryzen 5 7500F (6C/12T, 65W TDP)"
  :part/category :cpu :part/envelope "[8 40 40]"
  :part/mass-g 75 :part/power-w 88 :part/qty 1 :part/price-jpy 26346
  :part/interface "Socket AM5 (LGA1718) / **iGPU 非搭載(F)**"
  :part/mounts-on "mobo-b650i" :part/subassembly :bench
  :part/insert-axis :-x :part/fasteners 0
  :part/measured false
  :part/source "AM5 パッケージ 40x40mm(規格)。TDP 65W / PPT 88W、Tjmax 95C。power-w には PPT 88W を入れている(TDP ではなく実消費の上界)"
  :source/dataset "tower100-b70-parts"}

 {:part/id "cooler-wraith" :part/dim-grade :estimate :part/tolerance-mm "[5.0 5.0 5.0]"
  :part/name "AMD Wraith Stealth (7500F BOX 同梱)"
  :part/category :cooler :part/envelope "[54 95 95]"
  :part/mass-g 300 :part/power-w 2 :part/qty 1 :part/price-jpy 0
  :part/interface "AM5 純正リテンション / 4-pin PWM"
  :part/mounts-on "cpu-7500f" :part/subassembly :bench
  :part/insert-axis :-x :part/fasteners 0
  :part/measured false
  :part/source "**BOM に CPU クーラーが無いのは欠品ではない** — AMD 公式仕様の Supplied Thermal Solution (PIB) が Wraith Stealth なので 7500F BOX に同梱される。寸法 54mm 高 / 95mm 径は :estimate(出典により 43-55mm と割れる)。190mm 制限に対し余裕が桁違いなので、この推定の粗さは判定を変えない"
  :source/dataset "tower100-b70-parts"}

 {:part/id "ram-ddr5" :part/dim-grade :spec :part/tolerance-mm "[0.3 1.0 0.3]"
  :part/name "ADATA AD5U56008G-DT (DDR5-5600 8GB UDIMM, ヒートスプレッダ無)"
  :part/category :memory :part/envelope "[31.25 4 133.35]"
  :part/mass-g 20 :part/power-w 3 :part/qty 2 :part/price-jpy 14310
  :part/interface "DDR5 288-pin UDIMM / PC5-44800"
  :part/mounts-on "mobo-b650i" :part/subassembly :bench
  :part/insert-axis :-x :part/fasteners 0
  :part/measured false
  :part/source "UDIMM 規格 133.35 x 31.25mm。ADATA Premier 系は素モジュール(背高ヒートスプレッダ無し)なので、この筐体でも純正クーラーでも高さ干渉の余地が無い。2枚組 28,619円 = 1枚 14,310円。**合計 16GB** — VRAM 32GB に対する容量比はこの構成の最大の弱点(組み立て可否ではなく用途適合の問題)"
  :source/dataset "tower100-b70-parts"}

 {:part/id "ssd-m2" :part/dim-grade :spec :part/tolerance-mm "[0.5 0.2 0.2]"
  :part/name "PNY M280CS2241-500-CL (M.2 2280 Gen4 500GB)"
  :part/category :storage :part/envelope "[3.5 80 22]"
  :part/mass-g 8 :part/power-w 7 :part/qty 1 :part/price-jpy 14528
  :part/interface "M.2 M-key 2280 / PCIe 4.0 x4"
  :part/mounts-on "mobo-b650i" :part/subassembly :bench
  :part/insert-axis :-x :part/fasteners 1
  :part/measured false
  :part/source "M.2 2280 規格 80 x 22 x 3.5mm。Gen4 品なので M2_2(Gen4x4, chipset)側で仕様どおり。M2_1(Gen5)に挿しても動くが帯域は SSD 側で頭打ち"
  :source/dataset "tower100-b70-parts"}

 {:part/id "psu-pro750b" :part/dim-grade :datasheet :part/tolerance-mm "[0.5 0.5 1.0]"
  :part/name "ASRock PRO-750B (750W 80+ Bronze, ATX 3.1)"
  :part/category :psu :part/envelope "[150 86 140]"
  :part/mass-g 1700 :part/power-w 0 :part/qty 1 :part/price-jpy 6255
  :part/interface "ATX 3.1 / PS2 / 24-pin / EPS / **native 12V-2x6 (450W)** / 120mm fan / IEC C14"
  :part/insert-axis :+z :part/fasteners 4
  :part/measured false
  :part/source "ASRock 公称 140(D) x 150(W) x 86(H)mm = PS2/ATX 標準。**native 12V-2x6 を持つので B70 に変換アダプタ不要** — これは偶然ではなく ATX 3.1 世代の PSU を選んだ結果。62.5A on +12V"
  :source/dataset "tower100-b70-parts"}

 {:part/id "fan-140" :part/dim-grade :datasheet :part/tolerance-mm "[0.5 0.5 0.5]"
  :part/name "NZXT F140Q RF-Q14SF-B2 (140mm Quiet Airflow PWM)"
  :part/category :fan :part/envelope "[140 140 25]"
  :part/mass-g 150 :part/power-w 2 :part/qty 2 :part/price-jpy 1346
  :part/interface "4-pin PWM / 102.9 CFM / 1.77 mmH2O / 500-1500 RPM / 29.8 dBA"
  :part/insert-axis :none :part/fasteners 4
  :part/measured false
  :part/source "NZXT 公称 140 x 140 x 25mm。**筐体が 140mm を受けるのは Top / Rear / Power Cover の 3 箇所**(公式仕様 Fan Support)なので 2 個は載る。注意: マニュアル p.09 が『HDD を付けるなら rear fan を外せ』と明記 — 3.5インチを使わない本構成では無関係"
  :source/dataset "tower100-b70-parts"}

 ;; ---- ケーブル経路 ----------------------------------------------------------
 ;; MK-1 と違い PSU が底、GPU コネクタも下端 — 経路が素直になる構成。
 ;; waypoints は筐体内空座標 mm。
 {:cable/id "atx24" :cable/name "ATX 24-pin メイン電源"
  :cable/from "psu-pro750b" :cable/to "mobo-b650i"
  :cable/bundle-dia-mm 13 :cable/min-bend-factor 3
  :cable/waypoints "[[75 90 200] [40 130 215] [30 300 215] [22 330 200]]"
  :part/source "24 本 18AWG 結束で外径 12-14mm。PSU は非モジュラー(flat cable)なので全ケーブルが常時出ている — 余長の収納先が必要"
  :source/dataset "tower100-b70-parts"}

 {:cable/id "eps8" :cable/name "EPS 8-pin CPU 電源"
  :cable/from "psu-pro750b" :cable/to "mobo-b650i"
  :cable/bundle-dia-mm 9 :cable/min-bend-factor 3
  :cable/waypoints "[[60 90 60] [30 150 50] [25 380 50] [20 425 70]]"
  :part/source "8 本 18AWG 結束で外径 8-10mm。**EPS は mobo の I/O 側(上端)に在るので、底の PSU から筐体高さのほぼ全長を登る** — 非モジュラー ATX PSU の標準ケーブル長 600-650mm で足りるかがこの構成固有の確認点"
  :source/dataset "tower100-b70-parts"}

 {:cable/id "pcie12vhp" :cable/name "12V-2x6 GPU 電源"
  :cable/from "psu-pro750b" :cable/to "gpu-b70"
  :cable/bundle-dia-mm 10 :cable/min-bend-factor 4
  :cable/waypoints "[[90 95 150] [95 120 150] [95 150 148] [95 164 145]]"
  :part/source "**この筐体では PSU(底) と GPU コネクタ(カード下端) が近い** — MK-1 で問題になった長い引き回しが要らない。12V-2x6 は曲げ係数 4、かつ仕様上コネクタから 35mm 以内で曲げないこと。ASRock の +30mm 指定はこの直線区間のための寸法"
  :source/dataset "tower100-b70-parts"}
]
