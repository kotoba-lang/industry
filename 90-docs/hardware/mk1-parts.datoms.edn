 ;; PSU: SFX-L(130mm 奥行)ではなく SFX(100mm)を選ぶ。理由は scripts/mk1-cad.cljs
 ;; の長さ予算の導出結果 — SFX-L では board chamber の Z 余白に収まらない。
 {:part/id "psu-sfx750" :part/dim-grade :spec :part/tolerance-mm "[0.3 0.5 0.3]" :part/name "750W SFX 80+ Gold (ATX 3.1 / 12V-2x6)"
  :part/category :psu :part/envelope "[125 63 100]"
  :part/mass-g 1000 :part/power-w 0 :part/qty 1 :part/price-usd 128
  :part/interface "ATX 3.1 / 24-pin / 2x EPS / 12V-2x6 / IEC C14 inlet"
  :part/insert-axis :bracket :part/chamber :psu :part/fasteners 4
  :part/measured false
  :part/source "SFX 規格 125x63.5x100mm(SFX-L は奥行 130mm)。**この 125mm 幅が筐体の X を決める律速** — GPU ではない。**取り外し可能な PSU ブラケットに載せる**: sim の挿入経路判定で、L 字隅(GPU の上・mobo の後ろ)に置いた PSU はどの単一軸からも挿入できないことが判明したため。筐体はモノコックではなく着脱式サブフレームを持つ必要がある(SFF ケースでは一般的な構造)"
  :source/dataset "mk1-parts"}

 {:part/id "riser" :part/dim-grade :estimate :part/tolerance-mm "[3.0 5.0 10.0]" :part/name "PCIe 5.0 x16 フレキシブルライザー 200mm"
  :part/category :riser :part/envelope "[10 30 200]"
  :part/mass-g 60 :part/power-w 0 :part/qty 1 :part/price-usd 45
  :part/interface "PCIe 5.0 x16 (Gen5 認証必須 — Gen4 ライザーは B70 で不可)"
  :part/mounts-on "mobo-b650i" :part/subassembly :bench
  :part/insert-axis :+x :part/chamber :gpu :part/fasteners 0
  :part/measured false
  :part/source "assumption。Gen5 x16 ライザーは Gen4 品より高価で $40-60 帯。sandwich レイアウトの必須部品。**作業台で mobo の PCIe スロットに先付けする(:subassembly :bench)**"
  :source/dataset "mk1-parts"}

 {:part/id "fan-92" :part/dim-grade :spec :part/tolerance-mm "[0.3 0.3 0.3]" :part/name "92mm 吸気ファン (PWM)"
  :part/category :fan :part/envelope "[92 92 25]"
  :part/mass-g 110 :part/power-w 2 :part/qty 0 :part/price-usd 11
  :part/interface "4-pin PWM"
  :part/insert-axis :+x :part/chamber :board :part/fasteners 8
  :part/measured false
  :part/source "assumption。B70 は blower で背面 I/O から直接排気するため、筐体ファンは board 側の吸気/CPU 側排熱が主目的。**qty は sim の結果 2→1→0 になった。筐体ファンは載らない。** 92mm 角は board 室の X 帯(4.2-80.2mm)に収まらず、X を伸ばすと GPU 室に食い込み、前面 Z 帯 25mm は GPU の 8-pin ケーブル逃げと競合する。代わりに **前面は passive メッシュ**とし、送風は ①B70 blower の背面直排気(負圧で前面から makeup air を吸う。OEM が blower カードで使う正攻法)②CPU クーラー自身のファン に任せる。65W CPU + blower GPU の構成では妥当。エントリは将来 80mm 以下に変える場合の参照として残す"
  :source/dataset "mk1-parts"}

 {:part/id "cordset" :part/dim-grade :estimate :part/tolerance-mm "[2.0 2.0 100.0]" :part/name "◇PSE 取得済み JP 電源コードセット"
  :part/category :accessory :part/envelope "[20 20 1800]"
  :part/mass-g 180 :part/power-w 0 :part/qty 1 :part/price-usd 4
  :part/interface "IEC C13 - JIS C 8303"
  :part/insert-axis :+z :part/chamber :psu :part/fasteners 0
  :part/measured false
  :part/source "PC 本体は電気用品安全法の対象外だが、コードセットは取得済み部材を購入する(認証プロジェクト不要)"
  :source/dataset "mk1-parts"}

 ;; ---- ケーブル経路(SFF で「入らない」の最頻要因。AABB 部材だけでは守れない) ----
 ;; waypoints は筐体座標 mm。始点/終点はコネクタ位置、中間点は経路の曲がり。
 ;; bundle-dia は結束後の外径、min-bend-factor は最小曲げ半径 / 径。
 {:cable/id "atx24" :cable/name "ATX 24-pin メイン電源"
  :cable/from "psu-sfx750" :cable/to "mobo-b650i"
  :cable/bundle-dia-mm 13 :cable/min-bend-factor 3
  :cable/waypoints "[[65 120 200] [65 150 190] [60 150 110] [52 148 100]]"
  :part/source "24 本 18AWG 結束で外径 12-14mm。ATX 3.1 標準。最小曲げ係数 3x は PSU ハーネスの実勢(初版の 5x は硬い coax/光の値で、実際の個別スリーブ線はもっと曲がる)"
  :source/dataset "mk1-parts"}

 {:cable/id "eps8" :cable/name "EPS 8-pin CPU 電源"
  :cable/from "psu-sfx750" :cable/to "mobo-b650i"
  :cable/bundle-dia-mm 9 :cable/min-bend-factor 3
  :cable/waypoints "[[55 120 190] [55 178 185] [55 178 60] [50 176 40]]"
  :part/source "8 本 18AWG 結束で外径 8-10mm。曲げ係数 3x"
  :source/dataset "mk1-parts"}

 {:cable/id "pcie12vhp" :cable/name "12V-2x6 GPU 電源"
  :cable/from "psu-sfx750" :cable/to "gpu-b70"
  :cable/bundle-dia-mm 10 :cable/min-bend-factor 4
  :cable/waypoints "[[100 120 250] [110 118 312] [110 50 317] [110 50 272]]"
  :part/source "**GPU の 8-pin はカード端(Z 前方)にあるため PSU から前方へ長く回す必要がある。**12V-2x6 は曲げに厳しく factor 4。加えて仕様上コネクタから 35mm 以内で曲げないこと(本モデルは折れ角のみを見るのでこの直線区間の要件は別途図面で担保する)"
  :source/dataset "mk1-parts"}

 {:cable/id "front-io" :cable/name "前面 I/O ヘッダ (USB/電源SW)"
  :cable/from "chassis-mk1" :cable/to "mobo-b650i"
  :cable/bundle-dia-mm 5 :cable/min-bend-factor 2
  :cable/waypoints "[[70 20 290] [70 20 200] [65 20 120] [52 20 70]]"
  :part/source "前面パネル USB/電源SW ヘッダ。筐体ファンを廃したので PWM 分は不要になった。細く自由度が高い"
  :source/dataset "mk1-parts"}

