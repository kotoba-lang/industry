 ;; ---- クリアランス規則(筐体寸法の導出に使う。設計の正本) ------------------
 {:part/id "rule-clearance" :part/name "クリアランス規則"
  :part/category :design-rule :part/envelope "[0 0 0]"
  :part/mass-g 0 :part/power-w 0 :part/qty 0 :part/price-usd 0
  :part/interface "wall=1.2 / part-to-wall=3 / part-to-part=2 / riser-gap=10 / rear-io=8 / gpu-cable-end=40 / airflow-plenum=12"
  :part/insert-axis :none :part/chamber :none :part/fasteners 0
  :part/measured false
  :part/source "gpu-cable-end=40 は B70 の 8-pin がカード**端**にあるため必要(上端ではない — igorslab)。riser-gap=10 は Gen5 フレキライザーの最小曲げ半径からの assumption"
  :source/dataset "mk1-parts"}
