;; 叢雲 MK-1 — 部材カタログ (ADR-2607267000 / 2607268000 / 2607269000)
;; 単位: 寸法 mm / 質量 g / 電力 W / 価格 USD。座標系は右手系で
;;   X = 幅(sandwich の厚み方向) / Y = 高さ / Z = 奥行(前後)。
;; :part/envelope は部品自身の AABB を [x y z] で与える(設置姿勢での値)。
;; :part/insert-axis は組み立て時の挿入方向(この軸に沿って外から入れる)。
;; transact: (d/transact conn (edn/read-string (slurp "…mk1-parts.datoms.edn")))
;; query は datascript.js 向けに裸文字列属性を使う(CLAUDE.md の EDN query plane 参照)。
[
 ;; ---- schema ---------------------------------------------------------------
 {:db/ident :source/dataset  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :part/id         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :part/name       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :part/category   :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :part/envelope   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; pr-str [x y z]
 {:db/ident :part/mass-g     :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :part/power-w    :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :part/qty        :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :part/price-usd  :db/valueType :db.type/long    :db/cardinality :db.cardinality/one} ; @50台 目標
 {:db/ident :part/interface  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :part/insert-axis :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :part/mounts-on :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; 親部材 id(嵌合/搭載先)
 {:db/ident :part/subassembly :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ; :bench = 筐体外で先組み
 {:db/ident :part/mount-side :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ; :rear = PCB 裏面
 {:db/ident :part/chamber    :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ; :board | :gpu | :psu
 {:db/ident :part/fasteners  :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :part/measured   :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one} ; false = 公称/推定
 {:db/ident :part/dim-grade  :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ; :spec(規格確定) :datasheet(公称) :estimate(推定)
 {:db/ident :part/tolerance-mm :db/valueType :db.type/string :db/cardinality :db.cardinality/one} ; pr-str [tx ty tz] 片側公差
 {:db/ident :cable/id       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :cable/name     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :cable/from     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :cable/to       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :cable/bundle-dia-mm :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
 {:db/ident :cable/min-bend-factor :db/valueType :db.type/long :db/cardinality :db.cardinality/one} ; 最小曲げ半径 = factor x 径
 {:db/ident :cable/waypoints :db/valueType :db.type/string :db/cardinality :db.cardinality/one} ; pr-str [[x y z] ...]
 {:db/ident :part/source     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}

