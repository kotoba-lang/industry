diff --git a/test/biscuit/effective_test.cljc b/test/biscuit/effective_test.cljc
index cfda1a5..f73ef78 100644
--- a/test/biscuit/effective_test.cljc
+++ b/test/biscuit/effective_test.cljc
@@ -34,15 +34,28 @@
   (bt/authority {:facts facts :next-public-key (:public k1)
                  :root-private-key (:private root) :sign-fn k/sign-fn}))
 
-(defn- call [t requested & [{:keys [policy now]}]]
+(defn- call [t requested & [{:keys [policy now holder]}]]
   (eff/authorize {:semantics semantics :token t
                   :root-public-key (:public root) :verify-fn k/verify-fn
                   :requested requested
                   :local-policy (or policy {:policy/allow ["kotoba://graph/acme"]
                                             :policy/forbid-wildcard true})
                   :now (or now "2026-08-19T00:00:00Z")
+                  :holder holder
                   :call "graph/read"}))
 
+(def k2 (k/keypair "two"))
+
+(defn- addressed-to
+  "An authority block delegating `graph-read` on acme, addressed to `who`."
+  [who]
+  (bt/authority {:facts [['cap "graph-read" "kotoba://graph/acme"]
+                         ['holder who]]
+                 :next-public-key (:public k1)
+                 :root-private-key (:private root) :sign-fn k/sign-fn}))
+
+(def acme {:cap/kind :graph-read :cap/resource "kotoba://graph/acme"})
+
 (deftest the-whole-decision-needs-no-secret
   (testing "the reason the centre is biscuit and not macaroon"
     (let [t (token '[[cap "graph-read" "kotoba://graph/acme"]])
@@ -113,6 +126,82 @@
            (:reason (call t {:cap/kind :graph-read :cap/resource "kotoba://graph/acme"}
                           {:policy {:policy/allow ["*"] :policy/forbid-wildcard true}}))))))
 
+;; ---------------------------------------------------------------------------
+;; The fourth term: the grant is addressed, and the address is checked.
+
+(deftest a-self-asserted-holder-never-reaches-the-capability
+  (testing "the defect this slice closes: before it, the string a caller put
+            in :cap/holder arrived intact in the capability handed to the
+            handler, having been compared to nothing"
+    (let [d (call (token '[[cap "graph-read" "kotoba://graph/acme"]])
+                  (assoc acme :cap/holder "did:key:zAttacker"))]
+      (is (true? (:allowed? d)) "a bearer grant still passes; that is not what changed")
+      (is (not (contains? (:capability d) :cap/holder))
+          "the request's own holder claim must not become the capability's holder")
+      (is (nil? (get-in d [:receipt :receipt/holder])))
+      (is (= :unauthenticated (get-in d [:receipt :receipt/holder-binding]))))))
+
+(deftest an-addressed-grant-is-usable-only-by-its-addressee
+  (let [t (addressed-to "did:key:zBob")]
+    (testing "the addressee"
+      (let [d (call t acme {:holder "did:key:zBob"})]
+        (is (true? (:allowed? d)))
+        (is (= "did:key:zBob" (get-in d [:capability :cap/holder])))
+        (is (= :bound (get-in d [:receipt :receipt/holder-binding])))))
+    (testing "anyone else — refused by its own name, not swallowed by the intersection"
+      (is (= :wrong-holder (:reason (call t acme {:holder "did:key:zEve"})))))
+    (testing "and nobody at all: an addressed grant is not a bearer grant"
+      (is (= :holder-required (:reason (call t acme)))))))
+
+(deftest a-delegation-ends-at-the-leaf
+  (testing "authority block addressed to Alice, block 1 re-addressing to Bob:
+            it is Bob who presents it. Taking the FIRST holder fact made the
+            delegation a silent no-op — the parent kept the token and the
+            child got nothing."
+    (let [t (-> (addressed-to "did:key:zAlice")
+                (bt/append {:facts [['cap "graph-read" "kotoba://graph/acme"]
+                                    ['holder "did:key:zBob"]]
+                            :next-public-key (:public k2)
+                            :private-key (:private k1) :sign-fn k/sign-fn}))]
+      (is (true? (:allowed? (call t acme {:holder "did:key:zBob"}))))
+      (is (= :wrong-holder (:reason (call t acme {:holder "did:key:zAlice"})))))))
+
+(deftest bearer-is-legal-but-a-deployment-can-decline-it
+  (let [t (token '[[cap "graph-read" "kotoba://graph/acme"]])
+        strict {:policy/allow ["kotoba://graph/acme"]
+                :policy/forbid-wildcard true
+                :policy/require-holder true}]
+    (testing "unaddressed, and the policy does not mind"
+      (is (true? (:allowed? (call t acme {:holder "did:key:zBob"}))))
+      (is (= :bearer (get-in (call t acme {:holder "did:key:zBob"})
+                             [:receipt :receipt/holder-binding]))))
+    (testing "unaddressed, and the policy does mind — same shape as forbid-wildcard"
+      (is (= :unbound-grant (:reason (call t acme {:policy strict :holder "did:key:zBob"})))))
+    (testing "an addressed grant satisfies the strict policy"
+      (is (true? (:allowed? (call (addressed-to "did:key:zBob") acme
+                                  {:policy strict :holder "did:key:zBob"})))))))
+
+(deftest every-receipt-names-the-holder-and-unauthenticated-is-not-bearer
+  (testing "'no principal was supplied' and 'a principal was supplied and the
+            grant did not ask for one' are different facts about a call"
+    (let [bearer (token '[[cap "graph-read" "kotoba://graph/acme"]])]
+      (doseq [[label d] [["allowed, bound" (call (addressed-to "did:key:zBob") acme
+                                                 {:holder "did:key:zBob"})]
+                         ["allowed, bearer" (call bearer acme {:holder "did:key:zBob"})]
+                         ["allowed, unauthenticated" (call bearer acme)]
+                         ["denied, wrong holder" (call (addressed-to "did:key:zBob") acme
+                                                      {:holder "did:key:zEve"})]
+                         ["denied, unknown kind" (call bearer {:cap/kind :kernel/format-disk
+                                                               :cap/resource "/dev/sda"}
+                                                        {:holder "did:key:zBob"})]]]
+        (testing label
+          (is (contains? (:receipt d) :receipt/holder) label)
+          (is (contains? (:receipt d) :receipt/holder-binding) label)))
+      (is (= :bearer (get-in (call bearer acme {:holder "did:key:zBob"})
+                             [:receipt :receipt/holder-binding])))
+      (is (= :unauthenticated (get-in (call bearer acme)
+                                      [:receipt :receipt/holder-binding]))))))
+
