diff --git a/src/kotoba/lang/type_system.cljc b/src/kotoba/lang/type_system.cljc
index ae81cc2..6fd9608 100644
--- a/src/kotoba/lang/type_system.cljc
+++ b/src/kotoba/lang/type_system.cljc
@@ -10,6 +10,30 @@
 (def primitive-types
   #{:nil :bool :i32 :i64 :f32 :string :bytes :keyword :value})
 
+(def opaque-types
+  "Types with no literal syntax: the only way a program holds one is to have
+  been handed one.
+
+  `:principal` is who this execution runs as. It is deliberately NOT in
+  `primitive-types`, because every member of that set is inhabitable by
+  writing one down, and a principal a program can write down is a principal
+  it can claim rather than one it was given.
+
+  A principal is not authority. `[:cap kind resource]` is authority, and
+  `implied-effects` makes a capability parameter force the matching effect
+  into the signature; a `:principal` parameter forces nothing, because being
+  told who is calling permits nothing on its own. Deciding what may proceed
+  from who is calling is the ambient-authority mistake this language exists
+  to not make -- identity is for designation and accountability, and the
+  capability is what permits.
+
+  Two properties this namespace does NOT check, named so the silence is not
+  read as coverage. That a principal cannot be rendered to `:string` is the
+  absence of any such operation in the surface, not a rule stated here; and
+  that a runtime hands one in rather than a program constructing one is a
+  property of the grammar, which has no principal literal."
+  #{:principal})
+
 (def non-nil-primitives
   "S1b: public returns must not be bare :nil. Use [:option T] for absence."
   (disj primitive-types :nil))
@@ -36,6 +60,8 @@
   (cond
     (contains? primitive-types t) []
 
+    (contains? opaque-types t) []
+
     (not (vector? t)) [{:problem :type/invalid :type t}]
 
     :else
@@ -120,6 +146,34 @@
     (= :cap (first t)) #{(second t)}
     :else (into #{} (mapcat capability-kinds (rest t)))))
 
+(defn mentions-principal?
+  "Whether T is, or contains at any depth, the `:principal` type."
+  [t]
+  (cond
+    (= :principal t) true
