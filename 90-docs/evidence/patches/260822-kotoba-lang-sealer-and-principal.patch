+(ns kotoba.lang.principal-test
+  "`:principal` in the language type contract: identity is received, not minted.
+
+  The companion decision is the superproject's
+  adr-2608220100-capability-grants-are-addressed-and-the-address-is-checked."
+  (:require [clojure.edn :as edn]
+            [clojure.test :refer [deftest is testing]]
+            [kotoba.lang.type-system :as ts]))
+
+(def ^:private acme "kotoba://graph/acme")
+
+(deftest principal-is-a-type-but-has-no-literal
+  (testing "it is well-formed, so it can appear in a signature"
+    (is (ts/type? :principal))
+    (is (ts/type? [:option :principal]))
+    (is (ts/type? [:result :principal :string])))
+  (testing "and it is deliberately not a primitive: every primitive is
+            inhabitable by writing one down, and a principal a program can
+            write down is one it claims rather than one it was given"
+    (is (not (contains? ts/primitive-types :principal)))
+    (is (contains? ts/opaque-types :principal))))
+
+(deftest a-principal-is-not-authority
+  (testing "a capability parameter forces its effect into the signature"
+    (is (= #{:graph-read}
+           (ts/implied-effects [[:cap :graph-read acme]]))))
+  (testing "a principal parameter forces nothing — being told who is calling
+            permits nothing on its own, and deciding from it is the ambient
+            authority mistake"
+    (is (= #{} (ts/implied-effects [:principal])))
+    (is (= #{} (ts/implied-effects [:principal :string [:option :principal]])))
+    (is (:ok? (ts/validate-signature
+               {:params [:principal :string] :returns :string :effects #{}})))))
+
+(deftest a-signature-cannot-mint-a-principal
+  (testing "producing one out of nothing is the whole thing being refused"
+    (let [r (ts/validate-signature {:params [:string] :returns :principal
+                                    :effects #{}})]
+      (is (false? (:ok? r)))
+      (is (= [:principal/minted] (mapv :problem (:problems r))))))
+  (testing "no parameters at all is the same claim, more plainly"
+    (is (false? (:ok? (ts/validate-signature
+                       {:params [] :returns :principal :effects #{}})))))
+  (testing "and it is refused at depth, since wrapping is not laundering"
+    (doseq [returns [[:option :principal]
+                     [:result :principal :string]
+                     [:vector :principal]
+                     [:map :string :principal]]]
+      (is (false? (:ok? (ts/validate-signature
+                         {:params [:string] :returns returns :effects #{}})))
+          (str "minting through " (pr-str returns))))))
+
+(deftest passing-one-on-is-not-minting
+  (testing "the principal came in through a parameter, so the signature is
+            answering with what it was given"
+    (doseq [sig [{:params [:principal] :returns :principal :effects #{}}
+                 {:params [:principal] :returns [:option :principal] :effects #{}}
+                 {:params [:string [:option :principal]] :returns :principal
+                  :effects #{}}
+                 {:params [[:vector :principal]] :returns :principal :effects #{}}]]
+      (is (:ok? (ts/validate-signature sig)) (pr-str sig))))
+  (testing "and a signature that never mentions one is untouched by the rule"
+    (is (empty? (ts/principal-mint-problems [:string] :string)))))
+
+(deftest the-invariant-is-recorded-where-the-language-records-invariants
+  (testing "surface-status.edn is the authority for what the surface does;
+            a rule enforced in code and absent from that file is a rule the
+            next reader has no way to find"
+    (let [entry (get-in (edn/read-string (slurp "lang/surface-status.edn"))
+                        [:invariants :principal-is-received-not-minted])]
+      (is (some? entry))
+      (is (= :intentional-security-constraint (:disposition entry)))
+      (testing "and it says plainly that only the type contract is done —
+                no backend represents a :principal value yet"
+        (is (= #{} (:backends entry)))
+        (is (= #{:type-contract} (:implemented entry)))
+        (is (contains? (:not-implemented entry) :guest-grammar))))))
