 ;; --- (a) AArch64 UEFI loader spike -----------------------------------------
 :aarch64-uefi-loader
 {:status :boots-under-real-uefi
  :artifact "BOOTAA64.EFI, PE32+ executable (EFI application) Aarch64, 4608 bytes"
  :build ["clang --target=aarch64-unknown-windows -ffreestanding -fshort-wchar -fno-stack-protector -O1 -c"
          "lld-link -subsystem:efi_application -entry:efi_main -nodefaultlib"]
  :qemu-exit 0
  :serial-markers
  ["AIUEOS_AARCH64_UEFI_ENTRY"
   "AIUEOS_UEFI_REVISION 0x0000000000020046"
   "AIUEOS_GOP_OK base=0x0000000000000000 size=0 w=1280 h=800 stride=1280 format=3"
   "AIUEOS_MEMMAP_OK entries=32 descsize=48"
   "AIUEOS_EXIT_BOOT_SERVICES_OK"
   "AIUEOS_CURRENT_EL 1"
   "AIUEOS_AARCH64_UEFI_OK"]
  :negative-control
  {:invocation "--expect-fail (FAT32 ESP with no EFI/BOOT/BOOTAA64.EFI)"
   :result "all 6 required markers absent; gate rejects"
   :note "The gate was watched failing before being recorded as landed."}
  :kernel-handoff
  {:status :loads-and-enters
   :kernel "KERNEL.ELF, ELF64 ET_EXEC AArch64, 83536 bytes, entry 0x42000000"
   :admission "bounded ET_EXEC/EM_AARCH64 PT_LOAD placement into a reserved
               2 MiB window at 0x42000000 (AllocateAddress, so a collision is
               loud); 3 segments admitted"
   :boot-info "field-for-field identical to the x86_64 struct aiueos_boot_info;
               magic and version validated by the kernel before use"
   :markers ["AIUEOS_KERNEL_FILE_OK bytes=83536"
             "AIUEOS_KERNEL_ELF_OK segments=3 entry=0x0000000042000000"
             "AIUEOS_KERNEL_HANDOFF entry=0x0000000042000000"
             "AIUEOS_KERNEL_ENTRY"
             "AIUEOS_BOOTINFO_OK entries=39"]}

  :findings
  [{:finding :calling-convention
    :detail "AArch64 UEFI uses the platform AAPCS64 default, so EFIAPI is empty.
             The x86_64 loader's __attribute__((ms_abi)) on every protocol
             function pointer is the single largest source-level difference."}
   {:finding :no-port-io
    :detail "AArch64 has no port I/O at all. The x86_64 evidence path (COM1 at
             0x3f8) becomes PL011 MMIO at 0x09000000 on QEMU virt."}
   {:finding :termination
    :detail "isa-debug-exit (x86_64, iobase 0xf4) has no AArch64 counterpart.
             PSCI SYSTEM_OFF (0x84000008 via HVC #0) terminates QEMU with exit 0
             and is the deterministic replacement."}
   {:finding :exception-level
    :detail "AAVMF hands control at EL1 on machine virt (CurrentEL >> 2 = 1),
             not EL2. A kernel wanting EL2 must be entered before firmware or
             re-enter deliberately."}
   {:finding :vector-slot-size
    :detail "An AArch64 exception vector slot is exactly 0x80 bytes (32
             instructions). A register-save sequence inlined into every slot
             overflows it; the slots must hold a branch to one shared save."}
   {:finding :table-cache-maintenance
    :detail "The page tables are written under the firmware's mapping and then
             walked under ours. They are cleaned by VA (dc cvac) before the
             TTBR0/SCTLR switch so the walk cannot observe a stale line."}]}

 ;; --- (a2) AArch64 kernel: own translation tables, W^X actually enforced ----
 :aarch64-kernel-mmu-wx
 {:status :mmu-enabled-and-wx-proven
  :counterpart "x86_64 Phase-1/2: kernel replaces the firmware CR3 with its own
                four-level identity map, maps text RX / rodata R+NX / writable
                RW+NX, then writes to text and executes a byte in rodata and
                requires both to raise vector 14."
  :translation-regime
  {:granule "4 KiB"
   :t0sz 25
   :va-bits 39
   :start-level 1
   :mair {0 :Device-nGnRnE 1 :Normal-write-back}
   :map ["L1[0] 0..1 GiB Device, PXN+UXN (PL011, GIC, virt MMIO)"
         "L1[1] 1..2 GiB table -> L2 (RAM; lets the kernel's own 2 MiB split)"
         "L1[2..3] 1 GiB Normal blocks, PXN+UXN"
         "L2[16] table -> L3 (the kernel image at 0x42000000)"
         "L3 4 KiB pages: text AP=RO+exec, rodata AP=RO+PXN+UXN, rest AP=RW+PXN+UXN"]}
  :sctlr "0x0000000030d0198d"
  :sctlr-bits {:M true :C true :I true}
  :ttbr0 "0x0000000042005000"
  :wx-probes
  [{:probe "store into .text"
    :esr-ec "0x25"
    :esr-ec-meaning "data abort taken without a change in exception level"
    :fsc :permission-fault-level-3
    :far "0x0000000042000000"
    :outcome :faulted-as-required}
   {:probe "execute a byte in .rodata"
    :esr-ec "0x21"
    :esr-ec-meaning "instruction abort taken without a change in exception level"
    :fsc :permission-fault-level-3
    :far "0x00000000420031dc"
    :outcome :faulted-as-required
    :note "The rodata byte is a valid `ret` (0xd65f03c0), so a PXN failure
           returns cleanly and is reported as NO_FAULT instead of hanging."}]
  :termination "PSCI SYSTEM_OFF via HVC #0; qemu exit 0"}

 ;; --- The gate judges substance, and was watched refusing both controls -----
 :gate-negative-controls
 [{:control :no-loader
   :setup "FAT32 ESP with no EFI/BOOT/BOOTAA64.EFI"
   :rejected? true
   :unmet-requirements 5
   :note "Trivial case: nothing boots, every marker absent."}
  {:control :wx-not-enforced
   :setup "kernel built with -DAIUEOS_BREAK_WX: every kernel page mapped
           writable AND privileged-executable"
   :rejected? true
   :unmet-requirements 2
   :note "The sharp control. This build boots the whole chain and still prints
          AIUEOS_MMU_OK and AIUEOS_AARCH64_KERNEL_OK, so a marker-presence gate
          would pass it. It is refused on the two W^X substance checks alone —
          which is what distinguishes this gate from theatre."}]

 ;; --- The load-bearing display finding: this is what couples (a) and (c) ----
 :aarch64-gop-display-matrix
 {:machine "qemu-system-aarch64 -machine virt, AAVMF"
  :why "The x86_64 desktop-surface bootstrap takes the GOP LINEAR APERTURE
        (framebuffer_base/size), maps it RW+NX uncached, and presents a
        retained-rectangle test frame with a readback hash. That bootstrap only
        ports to a device that actually exposes an aperture."
  :efi-pixel-format {0 :PixelRedGreenBlueReserved8BitPerColor
                     1 :PixelBlueGreenRedReserved8BitPerColor
                     2 :PixelBitMask
                     3 :PixelBltOnly}
  :devices
  [{:device "virtio-gpu-pci"
    :gop :present
    :pixel-format 3
    :pixel-format-name :PixelBltOnly
    :framebuffer-base "0x0000000000000000"
    :framebuffer-size 0
    :resolution [1280 800]
    :linear-aperture? false
    :note "The idiomatic AArch64 display device gives Blt-only GOP with NO
           aperture. The x86_64 desktop-surface bootstrap does not port to it."}
   {:device "ramfb"
    :gop :present
    :pixel-format 1
    :pixel-format-name :PixelBlueGreenRedReserved8BitPerColor
    :framebuffer-base "0x000000005c7a0000"
    :framebuffer-size 3145728
    :resolution [800 600]
    :stride 800
    :linear-aperture? true
    :note "The only probed AArch64 device exposing a real linear aperture."}
   {:device "VGA"           :gop :absent :linear-aperture? false
    :note "AAVMF binds no GOP; there is no CSM/VGA BIOS execution on ARM.
           vgabios-stdvga.bin was present, so this is not a missing-rom artifact."}
   {:device "bochs-display" :gop :absent :linear-aperture? false
    :note "Same as VGA: rom present, no GOP bound."}
   {:device "virtio-vga"    :gop :not-applicable :linear-aperture? false
    :note "'virtio-vga' is not a valid device model name on aarch64 — it is
           x86-only because it bundles VGA compatibility. This is exactly the
           device os/aiueos/scripts/smoke-qemu-uefi.sh uses on x86_64, so the
           existing smoke gate's display device does not exist on AArch64."}]
  :consequence
  "AArch64 desktop parity requires either (i) ramfb for the early surface, or
   (ii) the virtio-gpu 2D resource path (create resource, attach backing,
   transfer, flush) that os/aiueos/README.md currently lists as intentionally
   excluded. Therefore virtio-gpu 2D moves from 'Phase 6, later' to 'required
   for AArch64 desktop', and tracks (a) and (c) are coupled rather than
   independent."}

 ;; --- What this evidence does NOT show -------------------------------------
 :not-demonstrated
 ["Any desktop. No compositor, no widget tree, no input path, no virtio-gpu 2D
   resource path; the GOP numbers are a capability probe, not a rendered
   surface. ramfb is probed but never driven."
  "Anything above the MMU. No physical page allocator, no dynamic paging, no
   GIC, no generic timer, no scheduler, no ring 3, no userspace. The kernel
   maps a static identity map and stops."
  "Kotoba decision objects. The 59 .kotoba objects are untouched; the arch
   split described in ADR-2608080300 track a3 has not started."
  "Anything on macOS. No Mac host in this session, so HVF, the
   com.apple.security.hypervisor entitlement, and Apple Silicon virtio-gpu
   behaviour are all unmeasured."
  "Real hardware. ramfb's aperture and its 800x600 mode are QEMU artifacts;
   Apple Silicon exposes neither ramfb nor this GOP shape."]}
