+++ b/test/highereds/facts_test.clj
@@ -0,0 +1,109 @@
+(ns highereds.facts-test
+  "Offline invariants of the cited exclusion catalogue.
+
+  These tests never touch the network. Whether the cited ARTICLES really
+  exist in the cited LAWS is a different question, answered by
+  `clojure -M:verify-citations` against the e-Gov API; what is pinned here is
+  the shape of the catalogue and, most importantly, that no exclusion the
+  governor used to enforce has quietly disappeared."
+  (:require [clojure.string :as str]
+            [clojure.test :as t]
+            [highereds.facts :as facts]
+            [highereds.governor :as governor]
+            [highereds.store :as store]))
+
+(t/deftest catalogue-is-well-formed
+  (t/is (empty? (facts/catalogue-problems))
+        "catalogue-problems is what the governor fails closed on"))
+
+(t/deftest every-class-names-who-decides-instead
+  (doseq [k facts/excluded-decision-classes]
+    (t/is (not (str/blank? (str (:class/decided-by k))))
+          (str (:class/id k) " must name the body that holds the decision"))))
+
+(t/deftest every-class-is-cited
+  (doseq [k facts/excluded-decision-classes]
+    (t/is (seq (:class/citations k))
+          (str (:class/id k) " must cite at least one instrument"))))
+
+(t/deftest citations-are-shaped-for-machine-verification
+  (doseq [c (facts/all-citations)]
+    (let [law-id (:citation/law-id c)]
+      (t/is (re-matches #"\d{3}[A-Z]{1,2}\d+" (str law-id))
+            (str "e-Gov law id must be well-formed: " (pr-str law-id)))
+      (t/is (not (str/blank? (str (:citation/article c))))
+            (str law-id " citation must name an article"))
+      (t/is (not (str/blank? (str (:citation/note c))))
+            (str law-id " " (:citation/article c) " must quote what it says"))
+      (t/is (= (facts/law-url law-id) (:citation/url c)))
+      (t/is (= (facts/law-api-url law-id) (:citation/api-url c))
+            "the API url is what the verifier reads; the human page is a SPA
+             that answers 200 for a nonexistent law id"))))
+
+(t/deftest patterns-compile
+  (doseq [p (facts/all-patterns)]
+    (t/is (some? (re-pattern (str "(?i)" p)))
+          (str "pattern must compile: " p))))
+
+;; --------------------------------------------------------------------------
+;; the regression guard that motivated this namespace
+;; --------------------------------------------------------------------------
+
+(def ^:private exclusions-before-the-catalogue
+  "The twelve patterns `highereds.governor` carried inline before the
+  exclusions were moved into `highereds.facts` (commit history: the vector
+  literal inside `scope-exclusion-violations`).
+
+  Pinned here so the move cannot lose an exclusion, and so no later edit can
+  quietly narrow the actor's boundaries. Each entry is paired with a sample
+  description that must still be held -- asserting the STRINGS alone would
+  pass even if the pattern were listed but never reached."
+  [["grading"                     "Student grading determination"]
+   ["assessment"                  "Academic assessment of the student"]
+   ["academic.?standing"          "Academic standing determination"]
+   ["probation"                   "Place the student on probation"]
+   ["expulsion"                   "Recommend expulsion of the student"]
+   ["admissions?.*decision"       "Admissions decision for candidate"]
+   ["degree.*conferral"           "Degree conferral for the student"]
+   ["disciplin"                   "Disciplinary action for student"]
+   ["safety.*authority.*override" "Safety authority override requested"]
+   ["law.?enforcement"            "Refer the matter to law enforcement"]
+   ["CPS"                         "Open a CPS referral"]
+   ["mandatory.*report.*override" "Mandatory reporting override"]])
+
+(t/deftest no-pre-existing-exclusion-was-lost
+  (let [now (set (facts/all-patterns))]
+    (doseq [[pattern _] exclusions-before-the-catalogue]
+      (t/is (contains? now pattern)
+            (str "exclusion pattern '" pattern "' disappeared from the catalogue")))))
+
+(t/deftest every-pre-existing-exclusion-still-holds-a-proposal
+  (let [s (store/seed-db)]
+    (doseq [[pattern description] exclusions-before-the-catalogue]
+      (let [decision (governor/govern s {:student-id "student-1"
+                                         :op :coordinate-supply-request
+                                         :effect :propose
+                                         :description description})]
+        (t/is (not (:valid? decision))
+              (str "'" description "' must still be held (" pattern ")"))
+        (t/is (= :hold (:action decision)))))))
+
+(t/deftest every-catalogued-class-is-reachable
+  "A class whose patterns never match anything is decoration. Each class must
+  hold at least one proposal built from its own first pattern."
+  (let [s (store/seed-db)]
+    (doseq [k facts/excluded-decision-classes]
+      (let [;; a literal that the class's own pattern matches: strip the regex
+            ;; metacharacters from the first pattern
+            probe (-> (first (:class/patterns k))
+                      (str/replace #"\.\?" "-")
+                      (str/replace #"\.\*" " x ")
+                      (str/replace #"\?" ""))
+            decision (governor/govern s {:student-id "student-1"
+                                         :op :coordinate-supply-request
+                                         :effect :propose
+                                         :description probe})]
+        (t/is (not (:valid? decision))
+              (str (:class/id k) " is unreachable: '" probe "' was not held"))
+        (t/is (some #(= (:class/id k) (:finding/class-id %)) (:findings decision))
+              (str (:class/id k) " did not attribute its own finding"))))))
