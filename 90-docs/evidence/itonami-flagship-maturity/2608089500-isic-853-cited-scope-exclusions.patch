diff --git a/src/highereds/verify_citations.clj b/src/highereds/verify_citations.clj
new file mode 100644
index 0000000..c5292b5
--- /dev/null
+++ b/src/highereds/verify_citations.clj
@@ -0,0 +1,145 @@
+(ns highereds.verify-citations
+  "Check every citation in `highereds.facts` against the e-Gov 法令検索 API.
+
+      clojure -M:verify-citations              ; verify the whole catalogue
+      clojure -M:verify-citations --offline    ; shape only, no network
+
+  **Why this reads the law text and not the HTTP status.** The obvious
+  implementation -- GET each `:citation/url` and accept 2xx -- does not work
+  and, worse, looks like it does. `laws.e-gov.go.jp` is a single-page app: a
+  nonexistent law id answers `200 OK` with the app shell. Measured
+  2026-08-08, `https://laws.e-gov.go.jp/law/999AC9999999999` returns 200, and
+  so does `https://www.ecfr.gov/current/title-34/part-99999`. A status-only
+  link checker therefore passes on a completely fabricated citation, which is
+  the one failure it exists to catch.
+
+  So each law is fetched through the API instead, which answers with a result
+  code and the full text, and three things are asserted:
+
+    1. the API returns `<Code>0</Code>` for the law id (the id is real),
+    2. the returned `<LawTitle>` matches the instrument name we recorded
+       (the id is the law we think it is, not merely some law),
+    3. every cited `<ArticleTitle>` is present in that law's text
+       (the article is real, in that law).
+
+  What this does NOT check is whether the article still SAYS what
+  `:citation/note` quotes -- Japanese statutes are amended, and diffing
+  quoted prose against the current text is a larger job than this gate. The
+  notes carry the date they were read.
+
+  JVM-only and deliberately outside the test suite: `clojure -M:test` must
+  stay offline and deterministic. Run this gate when the catalogue changes."
+  (:require [clojure.string :as str]
+            [highereds.facts :as facts])
+  (:import (java.net URI)
+           (java.net.http HttpClient HttpRequest HttpResponse$BodyHandlers)
+           (java.time Duration)))
+
+(def ^:private timeout-seconds 60)
+
+(defn- http-get
+  "Body of a GET, or {:error msg}."
+  [url]
+  (try
+    (let [client (-> (HttpClient/newBuilder)
+                     (.connectTimeout (Duration/ofSeconds timeout-seconds))
+                     (.followRedirects java.net.http.HttpClient$Redirect/NORMAL)
+                     (.build))
+          req (-> (HttpRequest/newBuilder (URI/create url))
+                  (.timeout (Duration/ofSeconds timeout-seconds))
+                  (.GET)
+                  (.build))
+          resp (.send client req (HttpResponse$BodyHandlers/ofString))]
+      (if (= 200 (.statusCode resp))
+        {:body (.body resp)}
+        {:error (str "HTTP " (.statusCode resp))}))
+    (catch Exception e
+      {:error (str (.getSimpleName (class e)) ": " (.getMessage e))})))
+
+(defn- result-code
+  "The e-Gov API's own result code. 0 = the law id resolved."
+  [body]
+  (second (re-find #"<Code>(\d+)</Code>" (str body))))
+
+(defn- law-title
+  [body]
+  (some-> (re-find #"<LawTitle[^>]*>([^<]+)</LawTitle>" (str body))
+          second
+          str/trim))
+
+(defn- article-titles
+  "Every `<ArticleTitle>` in the law, trimmed."
+  [body]
+  (into #{}
+        (map (comp str/trim second))
+        (re-seq #"<ArticleTitle>([^<]+)</ArticleTitle>" (str body))))
+
+(defn verify-law
+  "Verify every citation that points at one law id. Returns a vector of
+  problem strings (empty when the law and all its cited articles check out)."
+  [law-id citations]
+  (let [{:keys [body error]} (http-get (facts/law-api-url law-id))]
+    (cond
+      error
+      [(str law-id ": could not reach the e-Gov API (" error ")")]
+
+      (not= "0" (result-code body))
+      [(str law-id ": e-Gov API result code " (pr-str (result-code body))
+            " -- the law id does not resolve")]
+
+      :else
+      ;; Per CITATION, not per law. Checking the title against the SET of
+      ;; instrument names in this group passes when two differently-named
+      ;; instruments share one id -- which is exactly the repointed-law-id
+      ;; mistake this gate is for. (Found by mutation on 2026-08-08: moving
+      ;; 学位規則's id onto 学校教育法's merged the two groups and the
+      ;; set-membership check stayed green.)
+      (let [title (law-title body)
+            present (article-titles body)]
+        (into []
+              (mapcat
+               (fn [c]
+                 (cond-> []
+                   (not= title (:citation/instrument c))
+                   (conj (str law-id ": e-Gov calls this " (pr-str title)
+                              " but the catalogue cites it as "
+                              (pr-str (:citation/instrument c))))
+
+                   (not (contains? present (str/trim (:citation/article c))))
+                   (conj (str law-id " (" title "): cited article "
+                              (pr-str (:citation/article c))
+                              " is not in this law")))))
+              citations)))))
+
+(defn verify-catalogue
+  "Verify the whole catalogue. Returns {:problems [...] :laws n :citations n}."
+  []
+  (let [by-law (group-by :citation/law-id (facts/all-citations))]
+    {:laws (count by-law)
+     :citations (facts/citation-count)
+     :problems (into (vec (facts/catalogue-problems))
+                     (mapcat (fn [[law-id cs]]
+                               (println "  checking" law-id
+                                        (str "(" (count cs) " citation"
+                                             (when (> (count cs) 1) "s") ")"))
+                               (verify-law law-id cs)))
+                     (sort-by key by-law))}))
+
+(defn -main
+  [& args]
+  (let [offline? (some #{"--offline"} args)
+        _ (println (str "highereds.facts: " (facts/citation-count) " citations across "
+                        (count (facts/law-ids)) " instruments, "
+                        (count (facts/class-ids)) " excluded decision classes"))
+        problems (if offline?
+                   (do (println "  --offline: catalogue shape only")
+                       (vec (facts/catalogue-problems)))
+                   (:problems (verify-catalogue)))]
+    (if (seq problems)
+      (do (println)
+          (println (count problems) "problem(s):")
+          (doseq [p problems] (println "  ✗" p))
+          (System/exit 1))
+      (do (println)
+          (println "✓ every cited article exists in the cited law")
+          (System/exit 0)))))
