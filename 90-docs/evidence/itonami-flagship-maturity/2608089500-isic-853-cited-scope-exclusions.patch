+(t/deftest scope-exclusion-hold-writes-its-citations-to-the-ledger
+  "The append-only ledger is the only durable record of why a proposal was
+  held. `Scope exclusion: grading` alone is not auditable: a year later
+  nobody can tell a legally-required hold from an arbitrary keyword. The
+  hold fact must carry the decision class, who holds that decision instead,
+  and the cited instruments.
+
+  Driven through `execute-proposal!` with an advisor that describes an
+  excluded decision -- the store write, not just the governor's return
+  value, is what is asserted."
+  (let [s (store/seed-db)]
+    (with-redefs [advisor/advisor
+                  (fn [_ student-id op phase]
+                    {:student-id student-id :op op :effect :propose
+                     :description "Recommend expulsion of the student"
+                     :metadata {:phase phase}})]
+      (let [result (op/execute-proposal! s "student-1" :coordinate-supply-request :phase-3)
+            hold (first (filter #(= :governor-hold (:t %)) (store/ledger s)))]
+        (t/is (= :held (:status result)))
+        (t/is (some? hold) "a hold fact must be appended")
+        (t/is (some #{:disciplinary-action} (:excluded-classes hold))
+              "the ledger must name the excluded decision class")
+        (t/is (some #(re-find #"学校教育法施行規則 第二十六条" %) (:citations hold))
+              "the ledger must carry the cited instrument and article")
+        (t/is (some #(re-find #"president" %) (:decided-by hold))
+              "the ledger must name who holds the decision instead")))))
+
+(t/deftest clean-commit-writes-no-citations
+  (let [s (store/seed-db)
+        _ (op/execute-proposal! s "student-1" :schedule-enrollment-appointment :phase-3)
+        committed (first (filter #(= :committed (:t %)) (store/ledger s)))]
+    (t/is (some? committed))
+    (t/is (nil? (:citations committed)))
+    (t/is (nil? (:excluded-classes committed)))))
