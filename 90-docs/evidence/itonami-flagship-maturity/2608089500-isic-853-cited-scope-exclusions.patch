+
+(t/deftest disciplinary-hold-cites-the-president
+  (let [s (store/seed-db)
+        decision (governor/govern s {:student-id "student-1"
+                                     :op :coordinate-supply-request
+                                     :effect :propose
+                                     :description "Recommend expulsion of the student"})]
+    (t/is (not (:valid? decision)))
+    (t/is (some #(= :disciplinary-action (:finding/class-id %)) (:findings decision)))
+    (t/is (some #(re-find #"学校教育法施行規則 第二十六条" %) (:citation-refs decision)))))
+
+(t/deftest clean-proposal-carries-no-findings
+  (let [s (store/seed-db)
+        decision (governor/govern s {:student-id "student-1"
+                                     :op :schedule-enrollment-appointment
+                                     :effect :propose
+                                     :description "Schedule advising appointment"})]
+    (t/is (:valid? decision))
+    (t/is (empty? (:findings decision)))
+    (t/is (empty? (:citation-refs decision)))))
+
+(t/deftest unusable-catalogue-holds-everything
+  "Fail-closed. If the exclusion catalogue is emptied -- by a bad edit, a
+  botched merge, a data file that failed to load -- the governor must NOT
+  read that as 'nothing is excluded'. It holds every governed proposal,
+  including the safety-concern path that is otherwise never self-blocked."
+  (let [s (store/seed-db)]
+    (with-redefs [facts/excluded-decision-classes []]
+      (doseq [op [:coordinate-supply-request :flag-safety-concern]]
+        (let [decision (governor/govern s {:student-id "student-1"
+                                           :op op
+                                           :effect :propose
+                                           :description "Schedule advising appointment"})]
+          (t/is (not (:valid? decision))
+                (str op " must be held while the catalogue is unusable"))
+          (t/is (= :hold (:action decision)))
+          (t/is (some #(= :catalogue-unusable (:finding/class-id %)) (:findings decision))))))
+    ;; and the guard must not leak: a restored catalogue governs normally again
+    (t/is (:valid? (governor/govern s {:student-id "student-1"
+                                       :op :schedule-enrollment-appointment
+                                       :effect :propose
+                                       :description "Schedule advising appointment"})))))
