+
+            (empty? patterns)
+            (conj (str "Class " id " has no :class/patterns"))
+
+            (empty? citations)
+            (conj (str "Class " id " has no :class/citations"))
+
+            :always
+            (into (keep (fn [c]
+                          (when (or (str/blank? (str (:citation/law-id c)))
+                                    (str/blank? (str (:citation/article c)))
+                                    (not (str/starts-with? (str (:citation/url c)) "https://")))
+                            (str "Class " id " has a malformed citation: " (pr-str c))))
+                        citations))))
+        classes)))))
