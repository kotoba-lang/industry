<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0"><header><vendor>kotoba-lang/org-oasis-open-xmile</vendor><product></product><name>sanction-survivability-EU</name></header><sim_specs method="euler"><start>0</start><stop>36</stop><dt>0.25</dt></sim_specs><model name="sanction-survivability-EU"><sim_specs method="euler"><start>0</start><stop>36</stop><dt>0.25</dt></sim_specs><variables><flow name="recov_legal"><eqn>0</eqn></flow><stock name="exposed_code"><eqn>0</eqn><outflow>loss_code</outflow></stock><flow name="loss_compute"><eqn>IF TIME &gt;= 6 THEN 2.5 * exposed_compute ELSE 0</eqn></flow><stock name="alt_hardware"><eqn>0</eqn><inflow>recov_hardware</inflow></stock><aux name="native_hardware"><eqn>0.9</eqn></aux><aux name="native_storage"><eqn>0.95</eqn></aux><aux name="operating_capability"><eqn>MIN(MIN(MIN(MIN(MIN(MIN(cap_names, cap_compute), cap_storage), cap_code), cap_money), cap_hardware), cap_legal)</eqn></aux><flow name="recov_names"><eqn>0</eqn></flow><aux name="cap_legal"><eqn>native_legal + exposed_legal + alt_legal</eqn></aux><aux name="cap_storage"><eqn>native_storage + exposed_storage + alt_storage</eqn></aux><flow name="loss_names"><eqn>IF TIME &gt;= 6 THEN 2.5 * exposed_names ELSE 0</eqn></flow><flow name="recov_money"><eqn>IF TIME &gt;= 9 THEN 0.2 * MAX(0, 0.0375 - alt_money) ELSE 0</eqn></flow><stock name="exposed_storage"><eqn>0.05</eqn><outflow>loss_storage</outflow></stock><stock name="alt_names"><eqn>0</eqn><inflow>recov_names</inflow></stock><flow name="loss_legal"><eqn>IF TIME &gt;= 6 THEN 2.5 * exposed_legal ELSE 0</eqn></flow><aux name="native_compute"><eqn>0.95</eqn></aux><flow name="recov_code"><eqn>0</eqn></flow><stock name="exposed_money"><eqn>0.15</eqn><outflow>loss_money</outflow></stock><aux name="cap_compute"><eqn>native_compute + exposed_compute + alt_compute</eqn></aux><aux name="mean_capability"><eqn>(cap_names + cap_compute + cap_storage + cap_code + cap_money + cap_hardware + cap_legal) / 7</eqn></aux><flow name="loss_storage"><eqn>IF TIME &gt;= 6 THEN 2.5 * exposed_storage ELSE 0</eqn></flow><aux name="cap_money"><eqn>native_money + exposed_money + alt_money</eqn></aux><flow name="recov_storage"><eqn>IF TIME &gt;= 8 THEN 0.35 * MAX(0, 0.03 - alt_storage) ELSE 0</eqn></flow><flow name="recov_hardware"><eqn>IF TIME &gt;= 12 THEN 0.06 * MAX(0, 0.020000000000000004 - alt_hardware) ELSE 0</eqn></flow><stock name="alt_compute"><eqn>0</eqn><inflow>recov_compute</inflow></stock><aux name="native_money"><eqn>0.85</eqn></aux><stock name="alt_code"><eqn>0</eqn><inflow>recov_code</inflow></stock><flow name="loss_hardware"><eqn>IF TIME &gt;= 6 THEN 2.5 * exposed_hardware ELSE 0</eqn></flow><flow name="loss_code"><eqn>IF TIME &gt;= 6 THEN 2.5 * exposed_code ELSE 0</eqn></flow><flow name="recov_compute"><eqn>IF TIME &gt;= 6.5 THEN 0.8 * MAX(0, 0.034999999999999996 - alt_compute) ELSE 0</eqn></flow><aux name="cap_code"><eqn>native_code + exposed_code + alt_code</eqn></aux><aux name="native_legal"><eqn>0.95</eqn></aux><stock name="alt_money"><eqn>0</eqn><inflow>recov_money</inflow></stock><stock name="exposed_legal"><eqn>0.05</eqn><outflow>loss_legal</outflow></stock><flow name="loss_money"><eqn>IF TIME &gt;= 6 THEN 2.5 * exposed_money ELSE 0</eqn></flow><stock name="alt_legal"><eqn>0</eqn><inflow>recov_legal</inflow></stock><stock name="exposed_names"><eqn>0</eqn><outflow>loss_names</outflow></stock><aux name="cap_hardware"><eqn>native_hardware + exposed_hardware + alt_hardware</eqn></aux><stock name="exposed_compute"><eqn>0.05</eqn><outflow>loss_compute</outflow></stock><stock name="exposed_hardware"><eqn>0.1</eqn><outflow>loss_hardware</outflow></stock><aux name="native_names"><eqn>1</eqn></aux><aux name="cap_names"><eqn>native_names + exposed_names + alt_names</eqn></aux><stock name="alt_storage"><eqn>0</eqn><inflow>recov_storage</inflow></stock><aux name="native_code"><eqn>1</eqn></aux></variables></model></xmile>