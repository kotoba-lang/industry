 :priority-plan
 [{:order 0 :target "now" :action "Stop calling the HKDF loop Argon2id; land real Argon2id and a migration format."}
  {:order 1 :target "0-30 days" :action "Inventory/migrate all identity secrets to non-exportable custody; add key ids, epochs, states, timestamps, and emergency revoke."}
  {:order 2 :target "30-60 days" :action "Implement automated DEK/revoke rotation and recipient re-enveloping with current-epoch enforcement."}
  {:order 3 :target "60-90 days" :action "Implement hybrid authority rotation DAG, witness checkpoints, fork handling, and recovery quorum."}
  {:order 4 :target "90-180 days" :action "Add passkey PRF, tested recovery, cryptographic known-answer/interoperability tests, and an independent review."}]
