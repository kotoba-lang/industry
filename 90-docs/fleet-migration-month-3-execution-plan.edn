     :time "10:00 JST"
     :task "FINAL CUTOVER: Shift from 99% → 100% cljc traffic (implicit, last 1%)"
     :owner "ops-lead, monitoring, owner approval"
     :procedure
     ["Confirm 72-hour stability at 99% (Friday-Sunday, all metrics green)"
      "Announce 'Final Cutover Event' on monitoring channels"
      "Set murakumo traffic-split cljc-percent = 100 (Rust pool = 0)"
      "Monitor 60 seconds (all traffic now on cljc)"
      "Verify no client-side errors / 5xx spikes"
      "Activate Rust graceful shutdown procedure (see Rust drain below)"]
     :success-criteria
     ["100% traffic redirected to cljc pool"
      "No HTTP 5xx errors on cutover"
      "p99 latency ≤ 105ms"
      "Parity checker confirms no divergence (no Rust responses to compare)"
      "All in-flight Rust requests complete (30-second drain timeout)"]
     :failure-action "If critical error within 5 min of cutover → emergency revert to 50% Rust"
