    {:day "Monday-Tuesday 2026-08-25 to 2026-08-26"
     :time "10:00-18:00 JST"
     :task "Rust fleet graceful drain and decommissioning"
     :owner "ops-lead + infra-team"
     :detailed-procedure
     [{:step "1. Health check disable" :action "Disable health checks on Rust node pool (all 7 nodes marked unhealthy)" :timeout "2 min" :automation "murakumo/set-node-unhealthy [rust-node-1 … rust-node-7]"}
      {:step "2. Connection drain" :action "Graceful timeout (30 seconds) for in-flight HTTP requests to complete" :timeout "30 sec" :automation "murakumo/graceful-shutdown :timeout 30000"}
      {:step "3. Process shutdown" :action "SIGTERM to kotoba-server processes on each Rust node (murakumo-family/murakumo/bin/stop-server.sh)" :timeout "10 sec per node" :automation "ssh <node> 'systemctl stop murakumo-kotoba-server'"}
      {:step "4. Port release" :action "Verify port :8077 (kotoba-server HTTP) no longer in use (netstat -an | grep 8077)" :timeout "5 sec per node" :automation "ssh <node> 'netstat -an | grep 8077' (should be empty)"}
      {:step "5. Workdir cleanup (optional)" :action "Archive logs/state to B2 DataLad, optionally delete ~/murakumo-kotoba-server-run/ (keep git history)" :timeout "5 min" :automation "ssh <node> 'tar -czf murakumo-kotoba-server-final-$(date +%s).tar.gz ~/murakumo-kotoba-server-run && aws s3 cp … s3://kotobase.b2/'"}]
     :success-criteria
     ["All 7 Rust nodes no longer respond on :8077"
      "murakumo control-plane confirms 0 nodes in Rust pool"
      "No client-side connection refused errors"
      "Logs archived to B2"]
     :rollback-instruction
     ["If Rust drain fails mid-way → restart kotoba-server on affected node (systemctl start murakumo-kotoba-server), return traffic split to 50%, investigate issue"]
     :audit-trail
     ["Timestamp, node name, step completed, result (success/failure), duration"
      "Log all to murakumo metrics with :event/type :rust-drain"]}]

