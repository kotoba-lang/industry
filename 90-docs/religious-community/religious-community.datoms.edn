 :doctrine/conflicting-with [[:doctrine/id :doctrine-papal-infallibility]]
 :doctrine/historical-evolution "Developed during Protestant Reformation (1517). Remains core to Reformed, Lutheran, and Evangelical Protestantism. Rejected by Catholic and Orthodox traditions."}

{:db/id -4005
 :doctrine/id :doctrine-papal-infallibility
