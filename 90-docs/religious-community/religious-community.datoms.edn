 :doctrine/category :soteriology
 :doctrine/origin-text "Dhammacakkappavattana Sutta (First Sermon)"
 :doctrine/summary "Buddhist foundational doctrine: (1) Suffering (Dukkha) is inherent in existence; (2) Suffering arises from craving (Samudaya); (3) Cessation of suffering is possible (Nirodha); (4) The path to cessation is the Eightfold Path (Magga)."
 :doctrine/conflicting-with nil
 :doctrine/historical-evolution "Universal across Theravada, Mahayana, and Vajrayana schools. Unchanged since Buddha's first sermon ~2500 years ago."}

{:db/id -4003
