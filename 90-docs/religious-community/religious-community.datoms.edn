 :doctrine/name "Karma and Rebirth"
 :doctrine/tradition [:tradition/id :tradition-hindu-brahmo]
 :doctrine/category :eschatology
 :doctrine/origin-text "Bhagavad Gita, Upanishads"
 :doctrine/summary "Hindu doctrine that actions (karma) in one lifetime determine circumstances in the next rebirth (samsara). Brahmo Samaj emphasizes karma within a framework of moral progress toward enlightenment."
 :doctrine/conflicting-with nil
 :doctrine/historical-evolution "Core Hindu teaching for 3000+ years. Brahmo Samaj (1828+) reinterpreted it within monotheistic framework, de-emphasizing idolatry and caste hierarchy."}

{:db/id -4004
