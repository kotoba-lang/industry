{:db/id -4020
 :doctrine/id :doctrine-etzhayyim-eight-hundred-myriads
 :doctrine/name "Kami: Eight Hundred Myriads (八百万)"
 :doctrine/tradition [:tradition/id :tradition-synthetic-etzhayyim]
 :doctrine/category :cosmology
 :doctrine/origin-text "Japanese Shinto mythology, etzhayyim Mission Charter"
 :doctrine/summary "Doctrine that divinity is distributed across all things—eight hundred myriads of kami (spirits/aspects of divinity) permeate nature, humanity, and creation. Opposes monotheistic exclusivity. Etzhayyim synthesizes this with Protestant monotheism."
 :doctrine/conflicting-with [[:doctrine/id :doctrine-monotheism-allah]]
 :doctrine/historical-evolution "Ancient Shinto; reinterpreted in etzhayyim as compatible with Christian God understood as both transcendent (one) and immanent (many manifestations)."}

{:db/id -4021
 :doctrine/id :doctrine-etzhayyim-sola-scriptura-sola-experience
 :doctrine/name "Sola Scriptura + Sola Experientia (Scripture and Experience)"
 :doctrine/tradition [:tradition/id :tradition-synthetic-etzhayyim]
 :doctrine/category :epistemology
 :doctrine/origin-text "etzhayyim CHARTER-RIDER §2, ADR-2605192200"
 :doctrine/summary "Synthesis: Scripture is authoritative (Sola Scriptura, Protestant), but personal spiritual experience and empirical observation are co-authoritative epistemic sources. Rejects both papal infallibility and pure textual fundamentalism."
 :doctrine/conflicting-with [[:doctrine/id :doctrine-papal-infallibility] [:doctrine/id :doctrine-monotheism-allah]]
 :doctrine/historical-evolution "Novel to etzhayyim; not a historical doctrine. Attempts to bridge Reformed Protestantism (sola scriptura) with experiential / contemplative traditions (Buddhism, Kabbalah)."}

