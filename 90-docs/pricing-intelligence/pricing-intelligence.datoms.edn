;; pricing-intelligence.datoms.edn — cloud-itonami vertical pricing intelligence, base (schema + catalog).
;; Generated from the pilot competitor-pricing research (28 of 295 ISIC+ISCO verticals cloud-itonami
;; has blueprinted; see orgs/cloud-itonami/cloud-itonami-isic-*/isco-* and 90-docs/business/cloud-itonami-business-model.edn).
;; Schema + catalog is DataScript/Datomic-transactable EDN, following the same convention as
;; 90-docs/design-quality/design-quality.datoms.edn and 90-docs/adr/2607021500-portfolio-bmc-lean.datoms.edn:
;; this file declares schema + the stable :cluster/*, :vertical/*, :product/* catalog entities (identified by
;; :db.unique/identity, no :db/id needed). Actual price observations (which change over time / get re-benchmarked)
;; are append-only facts in the sibling file pricing-intelligence-ledger.edn — load both when querying.
;;
;; Verified queryable 2026-07-16 via JVM Clojure + datascript (nbb + the npm `datascript` package's compiled
;; JS API round-tripped incorrectly under nbb/SCI — two independent keyword-comparator implementations collide,
;; "Cannot compare :k to :k" on every transact regardless of schema/data shape). Real run, from outside the
;; superproject tree (its root `deps.edn` is unrelated workspace-metadata EDN, not a Clojure deps manifest —
;; invoking `clojure` from inside the tree makes clojure.tools.deps try and fail to parse it):
;;   cd /tmp && clojure -Sdeps '{:deps {datascript/datascript {:mvn/version "1.7.1"}}}' \
;;     -M /path/to/com-junkawasaki/90-docs/pricing-intelligence/query.clj /path/to/com-junkawasaki
;; Result: 27 schema attrs, 116 catalog entities, 118 ledger events -> 1306 datoms transacted; example queries
;; below returned correct joined results (see query.clj for the full, runnable versions of both):
;;
;; example query — every competitor observed for a given vertical, with disclosure tier:
;;   (d/q '[:find ?pname ?price ?tier
;;          :where [?v :vertical/id :vertical/isic-7912]
;;                 [?o :obs/vertical ?v] [?o :obs/product ?p] [?p :product/name ?pname]
;;                 [?o :obs/price-summary ?price] [?o :obs/disclosure-tier ?tier]]
;;        db)
;;
;; example query — recommended price band per vertical, joined to its cluster label:
;;   (d/q '[:find ?vname ?clabel ?low ?high ?unit
;;          :where [?v :vertical/name ?vname] [?v :vertical/cluster ?c] [?c :cluster/label ?clabel]
;;                 [?r :rec/vertical ?v] [?r :rec/band-low ?low] [?r :rec/band-high ?high] [?r :rec/unit ?unit]]
;;        db)
[
 ;; ---- schema -----------------------------------------------------------------
 {:db/ident :cluster/id    :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :cluster/label :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}

 {:db/ident :vertical/id            :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :vertical/code          :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :vertical/code-system   :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ; :code-system/isic-rev5 | :code-system/isco-08
 {:db/ident :vertical/name          :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :vertical/cluster       :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one} ; -> :cluster/id
 {:db/ident :vertical/repo          :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; orgs/cloud-itonami/<repo>
 {:db/ident :vertical/pricing-shape :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; native billing unit observed in this vertical's market

 {:db/ident :product/id   :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :product/name :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}

 ;; observation facts (append-only, in pricing-intelligence-ledger.edn) — one per (vertical, competitor product) pair
 {:db/ident :obs/vertical        :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one} ; -> :vertical/id
 {:db/ident :obs/product         :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one} ; -> :product/id
 {:db/ident :obs/price-summary   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :obs/disclosure-tier :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ; :tier/published | :tier/estimated | :tier/opaque
 {:db/ident :obs/source-url      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :obs/run-id          :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :obs/at              :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ; ISO date
 {:db/ident :obs/seq             :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}

 ;; recommendation facts (append-only, in pricing-intelligence-ledger.edn) — one per vertical per run
 {:db/ident :rec/vertical  :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one} ; -> :vertical/id
 {:db/ident :rec/band-low  :db/valueType :db.type/double  :db/cardinality :db.cardinality/one} ; absent for enterprise-contract-only verticals with no self-serve band
 {:db/ident :rec/band-high :db/valueType :db.type/double  :db/cardinality :db.cardinality/one}
 {:db/ident :rec/unit      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :rec/rationale :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :rec/run-id    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :rec/at        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :rec/seq       :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}

