{:rec/vertical [:vertical/id :vertical/isic-4741] :rec/band-low 199.0 :rec/band-high 399.0 :rec/unit "$/mo/location" :rec/rationale "Buyers already pay for serial-number/warranty/RMA tracking tiers, giving more headroom than plain grocery retail." :rec/run-id "pricing-intel-20260716-01" :rec/at "2026-07-16" :rec/seq 113}
