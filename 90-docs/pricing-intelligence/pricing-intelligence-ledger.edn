{:obs/vertical [:vertical/id :vertical/isic-6399] :obs/product [:product/id :product/jobboard-io] :obs/price-summary "Basic $449/mo (unlimited jobs, 500 alert subscribers, Stripe/PayPal checkout, 1 seat); Professional $649/mo (5,000 alert subscribers, 5 auto-import feeds, 2 seats); Enterprise custom (unlimited feeds/seats, API, multi-board login). Owned by ZipRecruiter; powers 3,000+ boards incl. TechCrunch, Politico" :obs/disclosure-tier :tier/published :obs/source-url "https://jobboard.io/pricing/" :obs/run-id "pricing-intel-20260716-02" :obs/at "2026-07-16" :obs/seq 120}
