<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0">
  <header>
    <vendor>kotoba-lang/org-oasis-open-xmile</vendor>
    <product version="1.0">power-vector</product>
    <name>Money / Power vector / Reputation / Sacred status</name>
  </header>
  <sim_specs method="rk4" time_units="period">
    <start>0</start>
    <stop>300</stop>
    <dt>0.5</dt>
  </sim_specs>
  <model name="money_powervector_reputation_sacred">
    <sim_specs method="rk4" time_units="period">
      <start>0</start>
      <stop>300</stop>
      <dt>0.5</dt>
    </sim_specs>
    <variables>
      <aux name="g_legitimacy">
        <eqn>3</eqn>
      </aux>
      <aux name="n_Data_Power">
        <eqn>Data_Power / (22.5 + Data_Power)</eqn>
      </aux>
      <flow name="political_power_in">
        <eqn>g_political * (a_money_pol * Financial_Capacity + a_network_pol * n_Network_Power) * Conversion_Friction</eqn>
      </flow>
      <aux name="a_pol_inst">
        <eqn>0.6</eqn>
      </aux>
      <stock name="Data_Power">
        <eqn>1</eqn>
        <non_negative/>
        <inflow>data_power_in</inflow>
        <outflow>data_power_out</outflow>
      </stock>
      <aux name="money_cap_k">
        <eqn>0.0015</eqn>
      </aux>
      <aux name="a_follow_coord">
        <eqn>0.5</eqn>
      </aux>
      <aux name="Reward_Power">
        <eqn>Financial_Capacity^0.5 * n_Institutional_Power^0.5</eqn>
      </aux>
      <aux name="e_cultural">
        <eqn>0.5</eqn>
      </aux>
      <flow name="coordination_power_out">
        <eqn>0.18 * Coordination_Power</eqn>
      </flow>
      <aux name="a_media_att">
        <eqn>0.55</eqn>
      </aux>
      <aux name="Conversion_Friction">
        <eqn>1 - phi</eqn>
      </aux>
      <aux name="a_ck_legit">
        <eqn>0.25</eqn>
      </aux>
      <flow name="cultural_power_out">
        <eqn>0.05 * Cultural_Power</eqn>
      </flow>
      <flow name="sacred_mass_gain">
        <eqn>m_rec * Recognition * Common_Knowledge + m_cultural * n_Cultural_Power + m_moral * n_Moral_Authority</eqn>
      </flow>
      <aux name="Common_Knowledge">
        <eqn>1 - EXP(-k_ck * n_Attention)</eqn>
      </aux>
      <aux name="Manipulation">
        <eqn>manip_gain * manip_frac * Financial_Capacity + manip_info * Information_Power</eqn>
      </aux>
      <aux name="a_sacred_att">
        <eqn>0.45</eqn>
      </aux>
      <stock name="Coordination_Power">
        <eqn>1</eqn>
        <non_negative/>
        <inflow>coordination_power_in</inflow>
        <outflow>coordination_power_out</outflow>
      </stock>
      <aux name="Expert_Power">
        <eqn>n_Data_Power^0.5 * n_Technological_Power^0.5</eqn>
      </aux>
      <aux name="g_reputation">
        <eqn>4</eqn>
      </aux>
      <aux name="g_moral">
        <eqn>2</eqn>
      </aux>
      <aux name="lam_contra_i">
        <eqn>0.9</eqn>
      </aux>
      <flow name="sacred_inst_gain">
        <eqn>i_legit * n_Legitimacy + i_contrib * Genuine_Contribution + i_rec * Recognition</eqn>
      </flow>
      <aux name="rent_coef">
        <eqn>8</eqn>
      </aux>
      <aux name="n_Network_Power">
        <eqn>Network_Power / (15 + Network_Power)</eqn>
      </aux>
      <aux name="a_reward_net">
        <eqn>0.65</eqn>
      </aux>
      <aux name="g_political">
        <eqn>4</eqn>
      </aux>
      <stock name="Technological_Power">
        <eqn>1</eqn>
        <non_negative/>
        <inflow>technological_power_in</inflow>
        <outflow>technological_power_out</outflow>
      </stock>
      <aux name="k_ck">
        <eqn>3</eqn>
      </aux>
      <aux name="g_institution">
        <eqn>3</eqn>
      </aux>
      <stock name="Political_Power">
        <eqn>1</eqn>
        <non_negative/>
        <inflow>political_power_in</inflow>
        <outflow>political_power_out</outflow>
      </stock>
      <aux name="manip_gain">
        <eqn>1.2</eqn>
      </aux>
      <aux name="a_tech_data">
        <eqn>0.4</eqn>
      </aux>
      <aux name="a_coord_inst">
        <eqn>0.4</eqn>
      </aux>
      <aux name="Platform_Power">
        <eqn>n_Technological_Power^0.5 * n_Network_Power^0.5</eqn>
      </aux>
      <aux name="b_attention">
        <eqn>0.5</eqn>
      </aux>
      <aux name="i_contrib">
        <eqn>0.9</eqn>
      </aux>
      <flow name="coordination_power_in">
        <eqn>g_coordination * (a_follow_coord * Followers + a_inst_coord * n_Institutional_Power + a_nar_coord * n_Narrative_Power)</eqn>
      </flow>
      <aux name="lam_scandal_e">
        <eqn>0.6</eqn>
      </aux>
      <aux name="lam_scandal_m">
        <eqn>1.8</eqn>
      </aux>
      <aux name="w_elite">
        <eqn>0.3</eqn>
      </aux>
      <flow name="media_power_out">
        <eqn>0.2 * Media_Power</eqn>
      </flow>
      <aux name="g_media">
        <eqn>7</eqn>
      </aux>
      <aux name="a_inst_legit">
        <eqn>0.45</eqn>
      </aux>
      <aux name="n_Narrative_Power">
        <eqn>Narrative_Power / (12.86 + Narrative_Power)</eqn>
      </aux>
      <flow name="money_out">
        <eqn>spend_rate * Money</eqn>
      </flow>
      <aux name="Commercialization">
        <eqn>psi * (comm_media * n_Media_Power / (1 + Genuine_Contribution) + comm_manip * Manipulation)</eqn>
      </aux>
      <aux name="a_media_nar">
        <eqn>0.55</eqn>
      </aux>
      <aux name="n_Technological_Power">
        <eqn>Technological_Power / (15 + Technological_Power)</eqn>
      </aux>
      <aux name="g_technology">
        <eqn>5</eqn>
      </aux>
      <flow name="network_power_in">
        <eqn>g_network * (a_att_net * n_Attention + a_reward_net * Reward_Power)</eqn>
      </flow>
      <stock name="Reputation">
        <eqn>1</eqn>
        <non_negative/>
        <inflow>reputation_in</inflow>
        <outflow>reputation_out</outflow>
      </stock>
      <aux name="spend_rate">
        <eqn>0.12</eqn>
      </aux>
      <aux name="income_rate">
        <eqn>0.14</eqn>
      </aux>
      <aux name="a_network_pol">
        <eqn>0.45</eqn>
      </aux>
      <aux name="a_nar_coord">
        <eqn>0.2</eqn>
      </aux>
      <aux name="a_rep_nar">
        <eqn>0.45</eqn>
      </aux>
      <aux name="n_Sacred_Institutional">
        <eqn>Sacred_Institutional / (30 + Sacred_Institutional)</eqn>
      </aux>
      <aux name="w_inst">
        <eqn>0.25</eqn>
      </aux>
      <aux name="n_Media_Power">
        <eqn>Media_Power / (15.75 + Media_Power)</eqn>
      </aux>
      <aux name="n_Legitimacy">
        <eqn>Legitimacy / (16.875 + Legitimacy)</eqn>
      </aux>
      <aux name="n_Coordination_Power">
        <eqn>Coordination_Power / (10 + Coordination_Power)</eqn>
      </aux>
      <aux name="Financial_Capacity">
        <eqn>n_Money * Conversion_Friction</eqn>
      </aux>
      <stock name="Narrative_Power">
        <eqn>1</eqn>
        <non_negative/>
        <inflow>narrative_power_in</inflow>
        <outflow>narrative_power_out</outflow>
      </stock>
      <aux name="a_nar_cul">
        <eqn>0.6</eqn>
      </aux>
      <aux name="Followers">
        <eqn>n_Attention^0.5 * n_Cultural_Power^0.5</eqn>
      </aux>
      <aux name="Scandal">
        <eqn>Manipulation * Detection_Probability</eqn>
      </aux>
      <aux name="Recognition">
        <eqn>n_Reputation^hill_n / (K_hill^hill_n + n_Reputation^hill_n)</eqn>
      </aux>
      <aux name="a_legit_moral">
        <eqn>0.45</eqn>
      </aux>
      <stock name="Sacred_Mass">
        <eqn>0</eqn>
        <non_negative/>
        <inflow>sacred_mass_gain</inflow>
        <outflow>sacred_mass_loss</outflow>
      </stock>
      <aux name="n_Cultural_Power">
        <eqn>Cultural_Power / (22.5 + Cultural_Power)</eqn>
      </aux>
      <aux name="comm_media">
        <eqn>0.6</eqn>
      </aux>
      <flow name="sacred_elite_gain">
        <eqn>e_powerpath * (n_Political_Power + n_Institutional_Power) / 2 / (1 + theta * (n_Political_Power + n_Institutional_Power) / 2) + e_cultural * n_Cultural_Power + e_legit * n_Legitimacy</eqn>
      </flow>
      <aux name="n_Sacred_Elite">
        <eqn>Sacred_Elite / (30 + Sacred_Elite)</eqn>
      </aux>
      <flow name="data_power_in">
        <eqn>g_data * (a_money_data * Financial_Capacity + a_tech_data * n_Technological_Power)</eqn>
      </flow>
      <flow name="moral_authority_in">
        <eqn>g_moral * (a_contrib_moral * Genuine_Contribution + a_legit_moral * n_Legitimacy)</eqn>
      </flow>
      <stock name="Moral_Authority">
        <eqn>1</eqn>
        <non_negative/>
        <inflow>moral_authority_in</inflow>
        <outflow>moral_authority_out</outflow>
      </stock>
      <flow name="technological_power_in">
        <eqn>g_technology * (a_money_tech * Financial_Capacity + a_data_tech * n_Data_Power)</eqn>
      </flow>
      <flow name="reputation_in">
        <eqn>g_reputation * (b_contribution * Genuine_Contribution + b_attention * n_Attention * Recognition)</eqn>
      </flow>
      <aux name="Analytical_Capability">
        <eqn>n_Technological_Power</eqn>
      </aux>
      <aux name="psi">
        <eqn>1</eqn>
      </aux>
      <aux name="invest_frac">
        <eqn>0.35</eqn>
      </aux>
      <stock name="Legitimacy">
        <eqn>1</eqn>
        <non_negative/>
        <inflow>legitimacy_in</inflow>
        <outflow>legitimacy_out</outflow>
      </stock>
      <flow name="sacred_elite_loss">
        <eqn>0.06 * Sacred_Elite + lam_scandal_e * Scandal + lam_comm_e * Commercialization + lam_contra_e * Contradiction</eqn>
      </flow>
      <flow name="legitimacy_out">
        <eqn>0.08 * Legitimacy</eqn>
      </flow>
      <aux name="lam_comm_i">
        <eqn>0.4</eqn>
      </aux>
      <aux name="c_coord">
        <eqn>0.25</eqn>
      </aux>
      <aux name="K_hill">
        <eqn>0.45</eqn>
      </aux>
      <aux name="g_cultural">
        <eqn>2.5</eqn>
      </aux>
      <flow name="political_power_out">
        <eqn>0.1 * Political_Power</eqn>
      </flow>
      <aux name="m_rec">
        <eqn>1.4</eqn>
      </aux>
      <aux name="n_Money">
        <eqn>Money / (400 + Money)</eqn>
      </aux>
      <aux name="comm_manip">
        <eqn>0.4</eqn>
      </aux>
      <aux name="a_data_tech">
        <eqn>0.2</eqn>
      </aux>
      <aux name="Detection_Probability">
        <eqn>MIN(1, d_base + d_ck * Common_Knowledge + d_data * n_Data_Power)</eqn>
      </aux>
      <aux name="lam_contra_m">
        <eqn>1.2</eqn>
      </aux>
      <aux name="a_money_data">
        <eqn>0.6</eqn>
      </aux>
      <aux name="c_inst">
        <eqn>0.4</eqn>
      </aux>
      <flow name="cultural_power_in">
        <eqn>g_cultural * (a_nar_cul * n_Narrative_Power + a_inst_cul * n_Institutional_Power)</eqn>
      </flow>
      <aux name="c_tech">
        <eqn>0.35</eqn>
      </aux>
      <aux name="a_inst_cul">
        <eqn>0.4</eqn>
      </aux>
      <aux name="lam_comm_m">
        <eqn>1.6</eqn>
      </aux>
      <flow name="attention_out">
        <eqn>0.45 * Attention</eqn>
      </flow>
      <aux name="Political_Influence">
        <eqn>Financial_Capacity^0.4 * n_Network_Power^0.3 * n_Reputation^0.2 * n_Institutional_Power^0.1</eqn>
      </aux>
      <aux name="i_legit">
        <eqn>1.1</eqn>
      </aux>
      <aux name="n_Sacred_Mass">
        <eqn>Sacred_Mass / (30 + Sacred_Mass)</eqn>
      </aux>
      <aux name="w_mass">
        <eqn>0.45</eqn>
      </aux>
      <stock name="Attention">
        <eqn>1</eqn>
        <non_negative/>
        <inflow>attention_in</inflow>
        <outflow>attention_out</outflow>
      </stock>
      <stock name="Media_Power">
        <eqn>1</eqn>
        <non_negative/>
        <inflow>media_power_in</inflow>
        <outflow>media_power_out</outflow>
      </stock>
      <aux name="a_contrib_legit">
        <eqn>0.3</eqn>
      </aux>
      <aux name="a_money_media">
        <eqn>0.75</eqn>
      </aux>
      <flow name="moral_authority_out">
        <eqn>0.09 * Moral_Authority</eqn>
      </flow>
      <aux name="a_money_tech">
        <eqn>0.8</eqn>
      </aux>
      <aux name="Genuine_Contribution">
        <eqn>c_inst * n_Institutional_Power + c_tech * n_Technological_Power + c_coord * n_Coordination_Power</eqn>
      </aux>
      <aux name="coercion_vis">
        <eqn>0.8</eqn>
      </aux>
      <aux name="n_Institutional_Power">
        <eqn>Institutional_Power / (22.5 + Institutional_Power)</eqn>
      </aux>
      <aux name="n_Political_Power">
        <eqn>Political_Power / (18 + Political_Power)</eqn>
      </aux>
      <aux name="Coercion_Visibility">
        <eqn>coercion_vis * Coercive_Power * Common_Knowledge</eqn>
      </aux>
      <flow name="money_in">
        <eqn>income_rate * Money / (1 + money_cap_k * Money) + rent_coef * (Reward_Power + Political_Influence) / 2</eqn>
      </flow>
      <aux name="Coercive_Power">
        <eqn>n_Political_Power^0.6 * n_Institutional_Power^0.4</eqn>
      </aux>
      <aux name="n_Moral_Authority">
        <eqn>Moral_Authority / (10 + Moral_Authority)</eqn>
      </aux>
      <stock name="Sacred_Elite">
        <eqn>0</eqn>
        <non_negative/>
        <inflow>sacred_elite_gain</inflow>
        <outflow>sacred_elite_loss</outflow>
      </stock>
      <aux name="hill_n">
        <eqn>3</eqn>
      </aux>
      <aux name="a_contrib_moral">
        <eqn>0.55</eqn>
      </aux>
      <aux name="lam_contra_e">
        <eqn>0.4</eqn>
      </aux>
      <aux name="m_cultural">
        <eqn>0.8</eqn>
      </aux>
      <aux name="a_money_pol">
        <eqn>0.55</eqn>
      </aux>
      <stock name="Money">
        <eqn>100</eqn>
        <non_negative/>
        <inflow>money_in</inflow>
        <outflow>money_out</outflow>
      </stock>
      <aux name="theta">
        <eqn>0.3</eqn>
      </aux>
      <aux name="b_contribution">
        <eqn>0.5</eqn>
      </aux>
      <aux name="g_network">
        <eqn>4</eqn>
      </aux>
      <aux name="Sacred_Total">
        <eqn>w_elite * Sacred_Elite + w_mass * Sacred_Mass + w_inst * Sacred_Institutional</eqn>
      </aux>
      <aux name="scandal_effect">
        <eqn>2</eqn>
      </aux>
      <aux name="n_Attention">
        <eqn>Attention / (9 + Attention)</eqn>
      </aux>
      <flow name="technological_power_out">
        <eqn>0.15 * Technological_Power</eqn>
      </flow>
      <flow name="network_power_out">
        <eqn>0.12 * Network_Power</eqn>
      </flow>
      <aux name="lam_scandal_i">
        <eqn>1</eqn>
      </aux>
      <aux name="Information_Power">
        <eqn>n_Data_Power * Analytical_Capability * exclusivity</eqn>
      </aux>
      <aux name="d_ck">
        <eqn>0.7</eqn>
      </aux>
      <flow name="sacred_mass_loss">
        <eqn>0.06 * Sacred_Mass + lam_scandal_m * Scandal + lam_comm_m * Commercialization + lam_contra_m * Contradiction</eqn>
      </flow>
      <aux name="d_data">
        <eqn>0.2</eqn>
      </aux>
      <flow name="sacred_inst_loss">
        <eqn>0.06 * Sacred_Institutional + lam_scandal_i * Scandal + lam_comm_i * Commercialization + lam_contra_i * Contradiction</eqn>
      </flow>
      <aux name="a_att_net">
        <eqn>0.35</eqn>
      </aux>
      <flow name="legitimacy_in">
        <eqn>g_legitimacy * (a_inst_legit * n_Institutional_Power + a_ck_legit * Common_Knowledge + a_contrib_legit * Genuine_Contribution)</eqn>
      </flow>
      <aux name="n_Sacred_Total">
        <eqn>Sacred_Total / (30.0 + Sacred_Total)</eqn>
      </aux>
      <aux name="i_rec">
        <eqn>0.4</eqn>
      </aux>
      <stock name="Sacred_Institutional">
        <eqn>0</eqn>
        <non_negative/>
        <inflow>sacred_inst_gain</inflow>
        <outflow>sacred_inst_loss</outflow>
      </stock>
      <stock name="Institutional_Power">
        <eqn>1</eqn>
        <non_negative/>
        <inflow>institutional_power_in</inflow>
        <outflow>institutional_power_out</outflow>
      </stock>
      <aux name="Gatekeeping_Power">
        <eqn>Platform_Power^0.5 * n_Media_Power^0.5</eqn>
      </aux>
      <aux name="n_Reputation">
        <eqn>Reputation / (18 + Reputation)</eqn>
      </aux>
      <flow name="narrative_power_in">
        <eqn>g_narrative * (a_media_nar * Gatekeeping_Power + a_rep_nar * Recognition)</eqn>
      </flow>
      <stock name="Network_Power">
        <eqn>1</eqn>
        <non_negative/>
        <inflow>network_power_in</inflow>
        <outflow>network_power_out</outflow>
      </stock>
      <aux name="manip_info">
        <eqn>0.6</eqn>
      </aux>
      <aux name="Contradiction">
        <eqn>n_Moral_Authority * Coercion_Visibility</eqn>
      </aux>
      <aux name="a_network_media">
        <eqn>0.25</eqn>
      </aux>
      <aux name="exclusivity">
        <eqn>0.6</eqn>
      </aux>
      <aux name="g_attention">
        <eqn>9</eqn>
      </aux>
      <aux name="m_moral">
        <eqn>0.7</eqn>
      </aux>
      <flow name="institutional_power_out">
        <eqn>0.06 * Institutional_Power</eqn>
      </flow>
      <aux name="a_inst_coord">
        <eqn>0.3</eqn>
      </aux>
      <aux name="phi">
        <eqn>0.3</eqn>
      </aux>
      <flow name="media_power_in">
        <eqn>g_media * (a_money_media * Financial_Capacity + a_network_media * n_Network_Power)</eqn>
      </flow>
      <aux name="d_base">
        <eqn>0.1</eqn>
      </aux>
      <aux name="lam_comm_e">
        <eqn>0.5</eqn>
      </aux>
      <aux name="e_powerpath">
        <eqn>1.3</eqn>
      </aux>
      <flow name="data_power_out">
        <eqn>0.1 * Data_Power</eqn>
      </flow>
      <flow name="attention_in">
        <eqn>g_attention * (a_media_att * n_Media_Power + a_sacred_att * n_Sacred_Total)</eqn>
      </flow>
      <aux name="e_legit">
        <eqn>0.6</eqn>
      </aux>
      <flow name="institutional_power_in">
        <eqn>g_institution * (a_pol_inst * n_Political_Power + a_coord_inst * n_Coordination_Power)</eqn>
      </flow>
      <aux name="g_narrative">
        <eqn>4</eqn>
      </aux>
      <flow name="narrative_power_out">
        <eqn>0.14 * Narrative_Power</eqn>
      </flow>
      <aux name="manip_frac">
        <eqn>0.12</eqn>
      </aux>
      <stock name="Cultural_Power">
        <eqn>1</eqn>
        <non_negative/>
        <inflow>cultural_power_in</inflow>
        <outflow>cultural_power_out</outflow>
      </stock>
      <aux name="g_data">
        <eqn>5</eqn>
      </aux>
      <flow name="reputation_out">
        <eqn>0.10 * Reputation + scandal_effect * Scandal</eqn>
      </flow>
      <aux name="g_coordination">
        <eqn>4</eqn>
      </aux>
    </variables>
  </model>
</xmile>
