(ns itonami-maturity-kernel
  (:export [clamp-bp sat-bp ratio-bp bool-bp axis3-bp axis4-bp
            acc-init acc-step acc-step2 acc-mean]))

;; cloud-itonami 成熟度スコアの **算術の正本**（ADR-2608052000）。
;;
;; ここが定義であって、`scripts/itonami-maturity-dynamics.cljs` の同名計算は
;; その参照実装（reference implementation）。両者が全 repo で 1 の位まで
;; 一致することを `scripts/itonami-maturity-kernel-parity.cljs` が毎回検査する。
;; 食い違ったら **カーネルが正しく、cljs 側を直す**。
;;
;; ## なぜ整数 basis point か
;;
;; スコアは 0..10000 の i64（basis point、10000 = 1.0）で表す。浮動小数を
;; 使わないのは、
;;
;;   1. f32/f64 は丸めが実行環境に依存するので「同じ入力で同じ点数」が
;;      runtime をまたいで保証できない。成熟度スコアは監査対象なので、
;;      再現できない数値には意味が無い。
;;   2. パリティゲートを ε 付き比較でなく **完全一致** で書ける。ε 比較は
;;      「どこまでズレてよいか」を誰かが決めることになり、その判断が
;;      検査から漏れる。
;;   3. この kernel は kotoba/pure プロファイルに収まる（capability ゼロ、
;;      外部から観測可能な effect ゼロ）。i64 と quot だけで足りる。
;;
;; ## 表現できていないもの（正直に）
;;
;; - **指数減衰が書けない。** admitted builtins に f32sqrt はあるが exp は
;;   無い。freshness は exp(-d/180) ではなく双曲減衰 10000*180/(180+d)
;;   （= `sat-bp` の引数を入れ替えたもの）にしてある。180 日で 0.5 になる点は
;;   同じで、裾が厚い。これは「kotoba に合わせて式を選んだ」ので明記する。
;; - **7 軸の加重平均を 1 関数にできない。** guest-grammar の arity 上限が 5
;;   （`:abi-bound {:max-arity 5 :disposition :intentional-security-constraint}`）
;;   なので、(値,重み)×7 = 14 引数の関数は書けない。畳み込みは `pair` を
;;   アキュムレータにして host が回す。**算術はすべてこの kernel が持ち、
;;   host が持つのは反復の順序だけ**という分担になる。
;; - 再帰的な値型が無いので、repo 1 件ぶんの証拠を 1 個の値として渡せない。
;;   これは言語側の W4（recursive logical values）待ちで、handle 設計に
;;   逃げない（ADR-2607279200）。

;; --- 基本 -------------------------------------------------------------------

(defn clamp-bp [x :i64] :i64
  (if (< x 0) 0 (if (< 10000 x) 10000 x)))

;; 半飽和。x = k でちょうど 5000（= 0.5）。k は fleet 自身の正値中央値を
;; host が渡す（外から持ち込んだ閾値ではない）。x<=0 は 0 = 「証拠が無い」。
(defn sat-bp [x :i64 k :i64] :i64
  (if (< x 1) 0
      (if (< k 1) 0
          (quot (* 10000 x) (+ x k)))))

;; 比率を bp に。den<1 なら 0（未測定でなく「分母が無い」）。10000 で頭打ち。
(defn ratio-bp [num :i64 den :i64] :i64
  (if (< den 1) 0 (clamp-bp (quot (* 10000 num) den))))

;; bool を bp に。`if` を使うのは、この profile の `or` が bool でなく i64 を
;; 返すため（css_core.kotoba の safe? と同じ理由）。
(defn bool-bp [b :bool] :i64
  (if b 10000 0))

;; --- 複合軸 -----------------------------------------------------------------
;; docs は 3 要素、surface は 4 要素の単純平均。quot なので切り捨て、
;; つまり端数は常に下側に倒れる（甘い側に倒れない）。

(defn axis3-bp [a :i64 b :i64 c :i64] :i64
  (quot (+ (+ a b) c) 3))

(defn axis4-bp [a :i64 b :i64 c :i64 d :i64] :i64
  (quot (+ (+ a b) (+ c d)) 4))

;; --- 加重平均の畳み込み -----------------------------------------------------
;; アキュムレータは pair(分子, 分母)。**未測定の軸は acc-step を呼ばない**ので
;; 分母に入らない。0 として混ぜると「測っていない」が「悪い」に化ける
;; （ADR-2607203000）。分母が空なら 0 でなく呼び出し側が nil を選べるよう、
;; acc-mean は 0 を返しつつ host 側が pair-second で空を判定できる形にしてある。

(defn acc-init [] :i64
  (pair 0 0))

(defn acc-step [acc :i64 v :i64 w :i64] :i64
  (pair (+ (pair-first acc) (* v w))
        (+ (pair-second acc) w)))

;; arity 上限 5 いっぱいまで使って 2 軸ずつ畳む。呼び出し回数が半分になる
;; （KIR インタプリタ経由のパリティ検査が全 fleet で現実的な時間に収まる）。
(defn acc-step2 [acc :i64 v1 :i64 w1 :i64 v2 :i64 w2 :i64] :i64
  (acc-step (acc-step acc v1 w1) v2 w2))

(defn acc-mean [acc :i64] :i64
  (if (< (pair-second acc) 1)
    0
    (clamp-bp (quot (pair-first acc) (pair-second acc)))))
