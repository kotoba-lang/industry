{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Kotoba",
    "scopeName": "source.kotoba",
    "patterns": [
        {
            "include": "#keywords"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#types"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#identifiers"
        },
        {
            "include": "#literals"
        }
    ],
    "repository": {
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.kotoba",
                    "match": "\\b(shiki|kan|ou|ba|en|ma|ze|gyo|rin|refl|glue|unglue)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.kotoba",
                    "match": "\\b(ku|i64|Bool)\\b"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "variable.other.kotoba",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.kotoba",
                    "match": "=>|:|->|=|\\|>"
                }
            ]
        },
        "literals": {
            "patterns": [
                {
                    "name": "constant.numeric.kotoba",
                    "match": "\\b\\d+\\b"
                },
                {
                    "name": "constant.language.kotoba",
                    "match": "\\b(i0|i1|true|false)\\b"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.kotoba",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.kotoba",
                    "match": "\\\\."
                }
            ]
        },
        "comments": {
            "name": "comment.line.double-slash.kotoba",
            "begin": "//",
            "end": "\\n"
        }
    }
} 