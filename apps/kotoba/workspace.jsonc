/**
 * this is the main configuration file of your bit workspace.
 * for full documentation, please see: https://bit.dev/reference/workspace/workspace-json
 **/{
  "$schema": "https://static.bit.dev/teambit/schemas/schema.json",
  "teambit.workspace/workspace": {
    "name": "kotoba-platform",
    "defaultScope": "kotoba.platform"
  },
  "teambit.workspace/variants": {
    "kotoba/components/editor": {
      "teambit.react/react": {},
      "teambit.defender/eslint": {
        "eslintConfig": {
          "extends": ["@teambit/react.react-env/eslint-config"]
        }
      },
      "teambit.defender/prettier": {
        "prettierConfig": {
          "printWidth": 80,
          "tabWidth": 2,
          "useTabs": false,
          "semi": true,
          "singleQuote": true,
          "trailingComma": "es5"
        }
      }
    },
    "kotoba/components/graph": {
      "teambit.react/react": {},
      "teambit.defender/eslint": {
        "eslintConfig": {
          "extends": ["@teambit/react.react-env/eslint-config"]
        }
      },
      "teambit.defender/prettier": {
        "prettierConfig": {
          "printWidth": 80,
          "tabWidth": 2,
          "useTabs": false,
          "semi": true,
          "singleQuote": true,
          "trailingComma": "es5"
        }
      }
    },
    "kotoba/components/host": {
      "teambit.react/react": {},
      "teambit.defender/eslint": {
        "eslintConfig": {
          "extends": ["@teambit/react.react-env/eslint-config"]
        }
      },
      "teambit.defender/prettier": {
        "prettierConfig": {
          "printWidth": 80,
          "tabWidth": 2,
          "useTabs": false,
          "semi": true,
          "singleQuote": true,
          "trailingComma": "es5"
        }
      }
    },
    "kotoba/kotoba-app": {
      "teambit.react/react": {},
      "teambit.defender/eslint": {
        "eslintConfig": {
          "extends": ["@teambit/react.react-env/eslint-config"]
        }
      },
      "teambit.defender/prettier": {
        "prettierConfig": {
          "printWidth": 80,
          "tabWidth": 2,
          "useTabs": false,
          "semi": true,
          "singleQuote": true,
          "trailingComma": "es5"
        }
      }
    }
  },
  "teambit.dependencies/dependency-resolver": {
    "packageManager": "npm",
    "policy": {
      "dependencies": {
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "@types/react": "19.0.2",
        "@types/react-dom": "19.0.2"
      },
      "peerDependencies": {
        "react": "19.0.0",
        "react-dom": "19.0.0"
      }
    }
  }
}
