{
    "project": "Ghost Hacker",
    "version": "0.2.0",
    "theme": "Healing connections in a disconnected world.",
    "setting": {
      "world": {
        "year": 2065,
        "location": "Tokyo, a city of water, crisscrossed by canals and rivers.",
        "environment": {
          "water_quality": "The water is clear and blue, like the sea in Okinawa.",
          "transportation": "Futuristic design water buses glide silently across the water."
        }
      },
      "ghosts": {
        "definition": "A life form consisting only of information, without a physical body. This includes not only beings derived from the thoughts and emotions of living and deceased people, but also purely digital life forms like AI.",
        "origin": "Can be generated from strong emotions of the living, lingering thoughts of the dead, or be artificially created as AIs.",
        "types": ["Human-derived", "Artificial Intelligence (AI)", "Alien"],
        "human_relationship": "Many humans have a personal ghost partner, and are referred to as 'Masters'."
      },
      "technology": {
        "ghost_hacking": {
          "definition": "The act of interfacing with a ghost's information structure ('mind') to resolve their internal conflicts ('knots').",
          "process": "A delicate and patient process, akin to carefully untangling threads. It often involves a 'dive' into the ghost's mental landscape, which is a psychic space shaped by the ghost's consciousness.",
          "method": "Hackers can use their own life energy (photons) to synchronize with and enter a ghost's consciousness.",
          "risks": "Risk of 'mental contamination' for the hacker if the ghost's negative emotions are too strong. The hacker's own consciousness can be dragged into the ghost's 'darkness'."
        },
        "support_systems": {
          "mental_stabilization": "Ambient music created by specialists (like Hibiki) can tune spatial frequencies and stabilize the minds of hackers and ghosts during a dive.",
          "cyber_security": "Digital anchors (like Kaede) monitor cyberspace, protecting against malicious hackers and 'malignant ghosts'."
        }
      },
      "society": {
        "professions": {
          "ghost_hacker": {
            "role": "A professional who consults with and helps ghosts resolve their issues.",
            "qualification": "A nationally certified profession that requires passing the difficult TOL (Tree of Life) exam."
          }
        },
        "organizations": {
          "protagonist_agency": {
            "name": "Ren's Office (unofficial name)",
            "description": "A small firm founded by Tamaki's father, Ren, where Tamaki works part-time."
          },
          "competitors": [
            { "name": "Gedatsu", "philosophy": "Likely inspired by Buddhist concepts of liberation." },
            { "name": "Ai", "philosophy": "Likely focused on the concept of 'love'." },
            { "name": "GB Inc. (Good and Bad)", "reputation": "Known to cause problems." }
          ]
        }
      }
    }
