# Dgraph Schema from 0.md

# --- Core Types ---
type Agent {
  uid: ID!
  name: string @index(exact)
  role: string
  belongsTo: [Group] @hasInverse(field: members)
}

type Group {
  uid: ID!
  name: string @index(term)
  members: [Agent]
}

type Event {
  uid: ID!
  at: datetime @index(hour)
  tau: string @index(exact)          # 粗視化スケール
  kind: string @index(term)          # meeting, sleep, sensor, policy_change...
  hasObs: [Observation]              # 生理/行動/文書の観測束ね
  involves: [Agent] @hasInverse(field: involvedIn)
  context: [Context]
}

type Observation {
  uid: ID!
  at: datetime @index(hour)
  source: string                      # sensor/log/doc
  key: string @index(term)
  value: float
  unit: string
}

type Relation {
  uid: ID!
  at: datetime @index(day)
  from: Agent
  to: Agent
  weight: float
  kind: string @index(term)           # collab, chat, citation ...
}

type KPI {
  uid: ID!
  tau: string @index(exact)
  at: datetime @index(hour)
  I: float
  R: float
  O: float
  W: float
}

type Policy {
  uid: ID!
  name: string @index(term)
  starts: datetime @index(day)
  ends: datetime @index(day)
  targetsTau: string
  description: string
}

type Context {
  uid: ID!
  windowStart: datetime @index(day)
  windowEnd: datetime @index(day)
  summary: string                     # LLM生成の要約（コミュニティ/期間要約）
  embedding: [float]                   # ベクトル索引(外部)
}

# --- Convenience edges on Agent ---
extend type Agent {
  involvedIn: [Event]
  edgesOut: [Relation] @hasInverse(field: from)
  edgesIn: [Relation] @hasInverse(field: to)
}
