config.define_string('tilt_subcommand', False, 'tilt subcommand')

cfg = config.parse()

# Load Kubernetes manifests
k8s_yaml('llm-deployment.yaml')

# Build custom Docker images (e.g., for LLM Activities)
docker_build('your-repo/llm-activity', '.', dockerfile='Dockerfile')

# Local resources for Temporal and Dgraph setup
local_resource(
  'temporal-setup',
  'temporal server start-dev --db-filename temporal.db',
  deps=['.'],
  labels=['temporal']
)

local_resource(
  'dgraph-setup',
  'dgraph zero & dgraph alpha --zero=localhost:5080 & dgraph-ratel',
  deps=['schema.dgraph'],
  labels=['dgraph']
)

# Apply Dgraph schema after alpha is up
local_resource(
  'apply-schema',
  'curl -X POST localhost:8080/admin/schema --data-binary @schema.dgraph',
  resource_deps=['dgraph-setup'],
  labels=['dgraph']
)

# Kubernetes resources
k8s_resource('llm-activity', port_forwards='8080:8080', labels=['llm'])

# Allow running in background or foreground
if 'up' in cfg.get('tilt_subcommand', 'up'):
  pass  # Default to up behavior
