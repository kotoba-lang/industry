# -*- mode: Python -*-

# Temporal Server Setup with Tilt

# Load the docker-compose file
dc_resource('postgres', labels=['database'])
dc_resource('temporal', labels=['server'])
dc_resource('temporal-admin-tools', labels=['tools'])
dc_resource('temporal-web', labels=['web'])

docker_compose('./docker-compose.yml')

# Define local resources for easy access
local_resource(
    'temporal-web-ui',
    serve_cmd='echo "Temporal Web UI is running at http://localhost:8080"',
    links=['http://localhost:8080']
)

local_resource(
    'temporal-server-status',
    cmd='docker compose ps',
    deps=['docker-compose.yml']
)

# Watch for configuration changes
watch_file('./docker-compose.yml')
watch_file('./dynamicconfig/')

# Port forwards for easy access
port_forward(7233, name='Temporal gRPC')
port_forward(7234, name='Temporal HTTP')
port_forward(8080, name='Temporal Web UI')
port_forward(5432, name='PostgreSQL')

# Allow Tilt to manage the services
allow_k8s_contexts('docker-for-desktop')
allow_k8s_contexts('docker-desktop')

print('Temporal Server is being set up with Tilt!')
print('Access points:')
print('- Web UI: http://localhost:8080')
print('- gRPC: localhost:7233')
print('- HTTP: localhost:7234')
print('- PostgreSQL: localhost:5432')
