{
  "name": "@junkawasaki/kagami",
  "version": "0.1.0",
  "description": "CodeMirror-based web editor with event sourcing and spreadsheet capabilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "pnpm exec tsc",
    "watch": "pnpm exec tsc --watch",
    "dev": "pnpm run build && pnpm exec http-server -p 8080 -c-1",
    "dev:watch": "concurrently \"pnpm run watch\" \"pnpm exec http-server -p 8080 -c-1\"",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "test": "pnpm exec jest",
    "lint": "pnpm exec eslint src/**/*.ts",
    "format": "pnpm exec prettier --write src/**/*.ts"
  },
  "keywords": [
    "editor",
    "codemirror",
    "event-sourcing",
    "kafka",
    "spreadsheet",
    "typescript"
  ],
  "author": "junkawasaki",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^8.0.0",
    "http-server": "^14.1.1",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@types/uuid": "^9.0.0",
    "hyperformula": "^2.6.0",
    "immutable": "^4.3.0",
    "kafkajs": "^2.2.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-example-setup": "^1.2.3",
    "prosemirror-gapcursor": "^1.3.2",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.1",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.7.1",
    "prosemirror-transform": "^1.10.4",
    "prosemirror-view": "^1.40.0",
    "rxjs": "^7.8.0",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}