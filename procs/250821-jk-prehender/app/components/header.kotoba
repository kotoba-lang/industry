// Prehender Header Component - Kotoba Template
// Reimplements the original Header.tsx component with Kotoba

metadata {
    title "Prehender Header"
    description "Header component with navigation and controls"
}

// Component props/data
data {
    selectedViewpoint: "timeline"
    hasSelectedNote: false
    onNewNote: () => void
    onViewpointChange: (viewpoint: string) => void
    onCreateStreamType: (streamType: string) => void
}

template {
    header class="bg-white shadow-sm border-b sticky top-0 z-50" {
        nav class="container mx-auto px-4 py-4" {
            div class="flex items-center justify-between" {
                // Logo and Title
                div class="flex items-center space-x-4" {
                    div class="flex items-center space-x-3" {
                        div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-lg flex items-center justify-center" {
                            span class="text-white font-bold text-sm" { "P" }
                        }
                        div {
                            h1 class="text-xl font-bold text-gray-900" { "Prehender" }
                            span class="text-sm text-gray-500 block -mt-1" { "Stream Management" }
                        }
                    }
                }

                // Controls Section
                div class="flex items-center space-x-3" {
                    // New Stream Dropdown
                    div class="relative" {
                        button id="new-stream-dropdown" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-all duration-200 flex items-center space-x-2 shadow-sm" {
                            span class="text-sm" { "+ New Stream" }
                            svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
                            }
                        }

                        // Dropdown Menu
                        div id="new-stream-menu" class="absolute right-0 mt-2 w-56 bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-50 hidden" {
                            div class="px-4 py-2 text-xs font-medium text-gray-500 uppercase tracking-wide" {
                                "Choose Stream Type"
                            }

                            // Stream Type Options
                            button class="w-full text-left px-4 py-3 hover:bg-gray-50 transition-colors flex items-center space-x-3"
                                    data-stream-type="note" {
                                div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center" {
                                    span class="text-blue-600" { "📝" }
                                }
                                div {
                                    div class="font-medium text-gray-900 text-sm" { "Note" }
                                    div class="text-xs text-gray-500" { "Simple text note" }
                                }
                            }

                            button class="w-full text-left px-4 py-3 hover:bg-gray-50 transition-colors flex items-center space-x-3"
                                    data-stream-type="idea" {
                                div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center" {
                                    span class="text-green-600" { "💡" }
                                }
                                div {
                                    div class="font-medium text-gray-900 text-sm" { "Idea" }
                                    div class="text-xs text-gray-500" { "Creative idea or concept" }
                                }
                            }

                            button class="w-full text-left px-4 py-3 hover:bg-gray-50 transition-colors flex items-center space-x-3"
                                    data-stream-type="task" {
                                div class="w-8 h-8 bg-yellow-100 rounded-lg flex items-center justify-center" {
                                    span class="text-yellow-600" { "✅" }
                                }
                                div {
                                    div class="font-medium text-gray-900 text-sm" { "Task" }
                                    div class="text-xs text-gray-500" { "Actionable task or todo" }
                                }
                            }

                            button class="w-full text-left px-4 py-3 hover:bg-gray-50 transition-colors flex items-center space-x-3"
                                    data-stream-type="meeting" {
                                div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center" {
                                    span class="text-purple-600" { "👥" }
                                }
                                div {
                                    div class="font-medium text-gray-900 text-sm" { "Meeting" }
                                    div class="text-xs text-gray-500" { "Meeting notes and agenda" }
                                }
                            }

                            button class="w-full text-left px-4 py-3 hover:bg-gray-50 transition-colors flex items-center space-x-3"
                                    data-stream-type="project" {
                                div class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center" {
                                    span class="text-red-600" { "📁" }
                                }
                                div {
                                    div class="font-medium text-gray-900 text-sm" { "Project" }
                                    div class="text-xs text-gray-500" { "Project planning and tracking" }
                                }
                            }
                        }
                    }

                    // Viewpoint Selector (only show when note is selected)
                    @if(hasSelectedNote) {
                        div class="relative" {
                            select id="viewpoint-selector" class="border border-gray-300 rounded-lg px-4 py-2 text-sm bg-white shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" {
                                option value="" { "Select Viewpoint" }
                                option value="timeline" selected="{{selectedViewpoint === 'timeline'}}" { "📅 Timeline" }
                                option value="network" selected="{{selectedViewpoint === 'network'}}" { "🔗 Network" }
                                option value="kanban" selected="{{selectedViewpoint === 'kanban'}}" { "📋 Kanban" }
                                option value="calendar" selected="{{selectedViewpoint === 'calendar'}}" { "🗓️ Calendar" }
                                option value="mindmap" selected="{{selectedViewpoint === 'mindmap'}}" { "🧠 Mind Map" }
                            }
                        }
                    }

                    // Search Button
                    button id="search-btn" class="text-gray-600 hover:text-gray-800 p-2 rounded-lg hover:bg-gray-100 transition-colors" title="Search" {
                        svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        }
                    }

                    // Settings Button
                    button id="settings-btn" class="text-gray-600 hover:text-gray-800 p-2 rounded-lg hover:bg-gray-100 transition-colors" title="Settings" {
                        svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4"
                        }
                    }

                    // User Menu
                    div class="relative" {
                        button id="user-menu-btn" class="flex items-center space-x-2 text-gray-700 hover:text-gray-900 p-2 rounded-lg hover:bg-gray-100 transition-colors" {
                            div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center" {
                                span class="text-white font-medium text-sm" { "U" }
                            }
                            svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
                            }
                        }

                        // User Dropdown Menu
                        div id="user-menu" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-50 hidden" {
                            div class="px-4 py-2 border-b border-gray-100" {
                                div class="font-medium text-gray-900 text-sm" { "Local User" }
                                div class="text-xs text-gray-500" { "local-user@prehender.dev" }
                            }

                            button class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors" {
                                "⚙️ Preferences"
                            }

                            button class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors" {
                                "📊 Analytics"
                            }

                            button class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors" {
                                "🔗 API Settings"
                            }

                            div class="border-t border-gray-100 mt-1" {}

                            button class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors" {
                                "🚪 Sign Out"
                            }
                        }
                    }
                }
            }
        }

        // Search Overlay (hidden by default)
        div id="search-overlay" class="absolute top-full left-0 right-0 bg-white border-b border-gray-200 shadow-lg p-4 hidden" {
            div class="max-w-2xl mx-auto" {
                div class="relative" {
                    input type="text" id="search-input" placeholder="Search streams, tags, content..."
                           class="w-full px-4 py-3 pl-12 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-lg"
                    div class="absolute left-4 top-1/2 transform -translate-y-1/2" {
                        svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        }
                    }
                }

                // Search Results
                div id="search-results" class="mt-4 max-h-96 overflow-y-auto hidden" {
                    div class="space-y-2" {
                        // Results will be populated by JavaScript
                    }
                }

                // Search Tips
                div id="search-tips" class="mt-4 text-sm text-gray-500" {
                    div class="flex items-center space-x-4" {
                        span { "💡 Tip: Use @tag to search by tags" }
                        span { "🔍 Press Enter to search" }
                        span { "⎋ Press Escape to close" }
                    }
                }
            }
        }
    }

    // Component JavaScript
    script {
        // Component state
        let isSearchOpen = false
        let selectedViewpoint = '{{selectedViewpoint}}'
        let hasSelectedNote = {{hasSelectedNote}}

        // DOM elements
        const newStreamDropdown = document.getElementById('new-stream-dropdown')
        const newStreamMenu = document.getElementById('new-stream-menu')
        const userMenuBtn = document.getElementById('user-menu-btn')
        const userMenu = document.getElementById('user-menu')
        const searchBtn = document.getElementById('search-btn')
        const searchOverlay = document.getElementById('search-overlay')
        const searchInput = document.getElementById('search-input')
        const viewpointSelector = document.getElementById('viewpoint-selector')

        // Initialize component
        function init() {
            setupEventListeners()
            setupKeyboardShortcuts()
        }

        // Setup event listeners
        function setupEventListeners() {
            // New Stream Dropdown
            if (newStreamDropdown) {
                newStreamDropdown.addEventListener('click', toggleNewStreamMenu)
            }

            // Stream Type Selection
            document.querySelectorAll('[data-stream-type]').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const streamType = e.currentTarget.dataset.streamType
                    handleCreateStream(streamType)
                })
            })

            // User Menu
            if (userMenuBtn) {
                userMenuBtn.addEventListener('click', toggleUserMenu)
            }

            // Search
            if (searchBtn) {
                searchBtn.addEventListener('click', toggleSearch)
            }

            // Search Input
            if (searchInput) {
                searchInput.addEventListener('input', handleSearch)
                searchInput.addEventListener('keydown', handleSearchKeydown)
            }

            // Viewpoint Selector
            if (viewpointSelector) {
                viewpointSelector.addEventListener('change', handleViewpointChange)
            }

            // Close menus when clicking outside
            document.addEventListener('click', handleClickOutside)
        }

        // Setup keyboard shortcuts
        function setupKeyboardShortcuts() {
            document.addEventListener('keydown', (e) => {
                // Cmd/Ctrl + K for search
                if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                    e.preventDefault()
                    toggleSearch()
                }

                // Cmd/Ctrl + N for new stream
                if ((e.metaKey || e.ctrlKey) && e.key === 'n') {
                    e.preventDefault()
                    handleCreateStream('note')
                }

                // Escape to close search
                if (e.key === 'Escape' && isSearchOpen) {
                    toggleSearch()
                }
            })
        }

        // Toggle new stream menu
        function toggleNewStreamMenu() {
            const isOpen = !newStreamMenu.classList.contains('hidden')
            closeAllMenus()

            if (!isOpen) {
                newStreamMenu.classList.remove('hidden')
                newStreamDropdown.classList.add('bg-blue-700')
            }
        }

        // Toggle user menu
        function toggleUserMenu() {
            const isOpen = !userMenu.classList.contains('hidden')
            closeAllMenus()

            if (!isOpen) {
                userMenu.classList.remove('hidden')
            }
        }

        // Toggle search overlay
        function toggleSearch() {
            isSearchOpen = !isSearchOpen

            if (isSearchOpen) {
                searchOverlay.classList.remove('hidden')
                searchInput.focus()
                document.body.style.overflow = 'hidden'
            } else {
                searchOverlay.classList.add('hidden')
                searchInput.value = ''
                document.body.style.overflow = ''
            }
        }

        // Handle stream creation
        function handleCreateStream(streamType) {
            console.log('Creating new stream:', streamType)
            closeAllMenus()

            // Emit event for parent component
            const event = new CustomEvent('createStream', {
                detail: { streamType }
            })
            document.dispatchEvent(event)
        }

        // Handle viewpoint change
        function handleViewpointChange(e) {
            selectedViewpoint = e.target.value
            console.log('Viewpoint changed to:', selectedViewpoint)

            // Emit event for parent component
            const event = new CustomEvent('viewpointChange', {
                detail: { viewpoint: selectedViewpoint }
            })
            document.dispatchEvent(event)
        }

        // Handle search input
        function handleSearch(e) {
            const query = e.target.value.trim()
            if (query.length > 0) {
                performSearch(query)
            } else {
                clearSearchResults()
            }
        }

        // Handle search keyboard events
        function handleSearchKeydown(e) {
            if (e.key === 'Enter') {
                const query = e.target.value.trim()
                if (query.length > 0) {
                    performSearch(query)
                }
            }
        }

        // Perform search
        function performSearch(query) {
            console.log('Searching for:', query)
            // TODO: Implement search logic
        }

        // Clear search results
        function clearSearchResults() {
            const results = document.getElementById('search-results')
            if (results) {
                results.classList.add('hidden')
            }
        }

        // Close all menus
        function closeAllMenus() {
            if (newStreamMenu) newStreamMenu.classList.add('hidden')
            if (userMenu) userMenu.classList.add('hidden')

            document.querySelectorAll('.bg-blue-700').forEach(el => {
                el.classList.remove('bg-blue-700')
            })
        }

        // Handle clicks outside menus
        function handleClickOutside(e) {
            if (!e.target.closest('#new-stream-dropdown') && !newStreamMenu.contains(e.target)) {
                closeAllMenus()
            }

            if (!e.target.closest('#user-menu-btn') && !userMenu.contains(e.target)) {
                userMenu.classList.add('hidden')
            }

            if (!e.target.closest('#search-overlay') && isSearchOpen) {
                toggleSearch()
            }
        }

        // Public API for parent components
        window.PrehenderHeader = {
            setSelectedViewpoint: (viewpoint) => {
                selectedViewpoint = viewpoint
                if (viewpointSelector) {
                    viewpointSelector.value = viewpoint
                }
            },

            setHasSelectedNote: (hasNote) => {
                hasSelectedNote = hasNote
                // TODO: Show/hide viewpoint selector based on this
            }
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', init)

        console.log('🚀 Prehender Header component loaded!')
    }
}
