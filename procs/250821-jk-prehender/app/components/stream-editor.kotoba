// Prehender Stream Editor Component - Kotoba Template
// Reimplements the original NoteEditor.tsx component with Kotoba

metadata {
    title "Prehender Stream Editor"
    description "Stream editor component for creating and editing streams"
}

// Component props/data
data {
    note: null
    allNotes: []
    onUpdateNote: (id: string, updates: object) => void
    onNewNote: () => void
    onAddStreamReference: (fromId: string, toId: string, type: string) => void
    onRemoveStreamReference: (fromId: string, referenceId: string) => void
}

template {
    div id="stream-editor" class="h-full flex flex-col bg-white" {
        @if(note) {
            // Stream Header
            div class="flex-shrink-0 p-4 border-b border-gray-200 bg-gray-50" {
                div class="flex items-center justify-between" {
                    div class="flex items-center space-x-3 flex-1" {
                        // Stream Icon
                        div class="w-10 h-10 rounded-lg flex items-center justify-center text-lg {{getTypeColor(note.streamType || 'note')}}" {
                            span { "{{getTypeIcon(note.streamType || 'note')}}" }
                        }

                        // Title and Metadata
                        div class="flex-1 min-w-0" {
                            input id="stream-title" type="text" value="{{note.title || ''}}"
                                   class="w-full text-lg font-semibold bg-transparent border-none outline-none focus:ring-0 p-0 text-gray-900 placeholder-gray-400"
                                   placeholder="Untitled Stream"
                            div class="flex items-center space-x-4 mt-1 text-sm text-gray-600" {
                                span class="flex items-center space-x-1" {
                                    span { "Type:" }
                                    span class="font-medium {{getTypeColor(note.streamType || 'note')}} px-2 py-1 rounded text-xs" {
                                        "{{note.streamType || 'note'}}"
                                    }
                                }
                                span { "•" }
                                span { "Updated: {{formatDate(note.updatedAt)}}" }
                                span { "•" }
                                span { "ID: {{note.id}}" }
                            }
                        }
                    }

                    // Action Buttons
                    div class="flex items-center space-x-2" {
                        button id="save-btn" class="bg-blue-600 text-white px-3 py-1.5 rounded-lg hover:bg-blue-700 transition-colors text-sm font-medium" {
                            "Save"
                        }
                        button id="duplicate-btn" class="text-gray-600 hover:text-gray-800 px-3 py-1.5 rounded-lg hover:bg-gray-100 transition-colors text-sm" title="Duplicate Stream" {
                            "📋"
                        }
                        button id="delete-btn" class="text-red-600 hover:text-red-800 px-3 py-1.5 rounded-lg hover:bg-red-100 transition-colors text-sm" title="Delete Stream" {
                            "🗑️"
                        }
                    }
                }
            }

            // Main Editor Area
            div class="flex-1 flex overflow-hidden" {
                // Content Editor
                div class="flex-1 flex flex-col" {
                    // Editor Toolbar
                    div class="flex-shrink-0 p-3 border-b border-gray-200 bg-white" {
                        div class="flex items-center justify-between" {
                            div class="flex items-center space-x-2" {
                                button id="bold-btn" class="p-2 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded transition-colors" title="Bold (Ctrl+B)" {
                                    svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                                        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 12h8a4 4 0 110 8H6m8-8V6a4 4 0 00-8 0v6"
                                    }
                                }
                                button id="italic-btn" class="p-2 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded transition-colors" title="Italic (Ctrl+I)" {
                                    svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                                        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m-4-4h8"
                                    }
                                }
                                button id="code-btn" class="p-2 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded transition-colors" title="Code" {
                                    svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                                        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                                    }
                                }
                            }

                            div class="flex items-center space-x-2 text-sm text-gray-600" {
                                span id="word-count" { "0 words" }
                                span { "•" }
                                span id="char-count" { "0 characters" }
                            }
                        }
                    }

                    // Content Area
                    div class="flex-1 p-4 overflow-auto" {
                        textarea id="stream-content" class="w-full h-full border-none outline-none resize-none text-gray-900 placeholder-gray-400 leading-relaxed"
                                placeholder="Start writing your stream content here..." {
                            "{{note.content || ''}}"
                        }
                    }
                }

                // Sidebar
                div class="w-80 border-l border-gray-200 bg-gray-50 flex flex-col" {
                    // Properties Panel
                    div class="flex-1 overflow-y-auto" {
                        // Tags Section
                        div class="p-4 border-b border-gray-100" {
                            div class="flex items-center justify-between mb-3" {
                                h3 class="text-sm font-semibold text-gray-900" { "Tags" }
                                button id="add-tag-btn" class="text-blue-600 hover:text-blue-800 text-sm" { "+ Add" }
                            }

                            div id="tags-container" class="flex flex-wrap gap-2" {
                                @each(note.tags || [] as tag) {
                                    span class="inline-flex items-center px-2 py-1 rounded-full text-xs bg-blue-100 text-blue-800" {
                                        span { "{{tag}}" }
                                        button class="ml-1 text-blue-600 hover:text-blue-800" onclick="removeTag('{{tag}}')" { "×" }
                                    }
                                }
                            }

                            @if(!(note.tags && note.tags.length > 0)) {
                                p class="text-xs text-gray-500 italic" { "No tags yet. Click + Add to create tags." }
                            }
                        }

                        // References Section
                        div class="p-4 border-b border-gray-100" {
                            div class="flex items-center justify-between mb-3" {
                                h3 class="text-sm font-semibold text-gray-900 flex items-center space-x-2" {
                                    span { "References" }
                                    span class="text-xs text-gray-500 bg-gray-200 px-2 py-1 rounded" {
                                        "{{(note.references || []).length}}"
                                    }
                                }
                                button id="add-reference-btn" class="text-green-600 hover:text-green-800 text-sm" { "+ Link" }
                            }

                            div id="references-container" class="space-y-2" {
                                @each(note.references || [] as ref) {
                                    div class="flex items-center justify-between p-2 bg-white rounded-lg border border-gray-200" {
                                        div class="flex items-center space-x-2 flex-1" {
                                            span class="text-sm" { "{{getTypeIcon(ref.referenceType)}}" }
                                            span class="text-sm text-gray-900 truncate" {
                                                "{{getReferenceTitle(ref.targetStreamId) || 'Unknown Stream'}}"
                                            }
                                            span class="text-xs text-gray-500" { "{{ref.context || ref.referenceType}}" }
                                        }
                                        button class="text-red-600 hover:text-red-800 p-1" onclick="removeReference('{{ref.id}}')" title="Remove reference" {
                                            svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                                                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
                                            }
                                        }
                                    }
                                }
                            }

                            @if(!(note.references && note.references.length > 0)) {
                                div class="text-center py-4" {
                                    div class="w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center mx-auto mb-2" {
                                        span class="text-gray-400" { "🔗" }
                                    }
                                    p class="text-xs text-gray-500" { "No references yet." }
                                    p class="text-xs text-gray-400 mt-1" { "Link to other streams for context." }
                                }
                            }
                        }

                        // Related Streams Section
                        div class="p-4" {
                            div class="flex items-center justify-between mb-3" {
                                h3 class="text-sm font-semibold text-gray-900" { "Related Streams" }
                                button id="find-related-btn" class="text-purple-600 hover:text-purple-800 text-sm" { "🔍 Find" }
                            }

                            div id="related-streams" class="space-y-2" {
                                // Related streams will be populated dynamically
                                p class="text-xs text-gray-500 italic" { "Click Find to discover related streams." }
                            }
                        }
                    }

                    // Footer with Stream Info
                    div class="p-4 border-t border-gray-200 bg-gray-100" {
                        div class="space-y-2 text-xs text-gray-600" {
                            div class="flex justify-between" {
                                span { "Created:" }
                                span { "{{formatDate(note.createdAt)}}" }
                            }
                            div class="flex justify-between" {
                                span { "Updated:" }
                                span { "{{formatDate(note.updatedAt)}}" }
                            }
                            div class="flex justify-between" {
                                span { "Version:" }
                                span { "{{note.version || 1}}" }
                            }
                        }
                    }
                }
            }
        } @else {
            // Empty State
            div class="flex-1 flex items-center justify-center" {
                div class="text-center max-w-md" {
                    div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6" {
                        span class="text-3xl" { "📝" }
                    }
                    h2 class="text-xl font-semibold text-gray-900 mb-3" { "No Stream Selected" }
                    p class="text-gray-600 mb-6" { "Select a stream from the sidebar to start editing, or create a new one." }
                    button id="create-new-stream-btn" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors font-medium" {
                        "+ Create New Stream"
                    }
                }
            }
        }
    }

    // Component JavaScript
    script {
        // Component state
        let note = {{note}}
        let allNotes = {{allNotes}}
        let autoSaveTimer = null
        let isDirty = false

        // DOM elements
        const titleInput = document.getElementById('stream-title')
        const contentTextarea = document.getElementById('stream-content')
        const saveBtn = document.getElementById('save-btn')
        const duplicateBtn = document.getElementById('duplicate-btn')
        const deleteBtn = document.getElementById('delete-btn')
        const wordCount = document.getElementById('word-count')
        const charCount = document.getElementById('char-count')
        const addTagBtn = document.getElementById('add-tag-btn')
        const addReferenceBtn = document.getElementById('add-reference-btn')
        const findRelatedBtn = document.getElementById('find-related-btn')
        const createNewStreamBtn = document.getElementById('create-new-stream-btn')

        // Initialize component
        function init() {
            if (!note) return

            setupEventListeners()
            setupAutoSave()
            updateWordCount()
            setupKeyboardShortcuts()
        }

        // Setup event listeners
        function setupEventListeners() {
            // Title input
            if (titleInput) {
                titleInput.addEventListener('input', handleTitleChange)
                titleInput.addEventListener('keydown', handleTitleKeydown)
            }

            // Content textarea
            if (contentTextarea) {
                contentTextarea.addEventListener('input', handleContentChange)
                contentTextarea.addEventListener('keydown', handleContentKeydown)
            }

            // Save button
            if (saveBtn) {
                saveBtn.addEventListener('click', handleSave)
            }

            // Duplicate button
            if (duplicateBtn) {
                duplicateBtn.addEventListener('click', handleDuplicate)
            }

            // Delete button
            if (deleteBtn) {
                deleteBtn.addEventListener('click', handleDelete)
            }

            // Add tag button
            if (addTagBtn) {
                addTagBtn.addEventListener('click', handleAddTag)
            }

            // Add reference button
            if (addReferenceBtn) {
                addReferenceBtn.addEventListener('click', handleAddReference)
            }

            // Find related button
            if (findRelatedBtn) {
                findRelatedBtn.addEventListener('click', handleFindRelated)
            }

            // Create new stream button
            if (createNewStreamBtn) {
                createNewStreamBtn.addEventListener('click', handleCreateNewStream)
            }

            // Toolbar buttons
            setupToolbarButtons()
        }

        // Setup toolbar buttons
        function setupToolbarButtons() {
            const boldBtn = document.getElementById('bold-btn')
            const italicBtn = document.getElementById('italic-btn')
            const codeBtn = document.getElementById('code-btn')

            if (boldBtn) boldBtn.addEventListener('click', () => insertFormatting('**', '**'))
            if (italicBtn) italicBtn.addEventListener('click', () => insertFormatting('*', '*'))
            if (codeBtn) codeBtn.addEventListener('click', () => insertFormatting('`', '`'))
        }

        // Setup auto-save
        function setupAutoSave() {
            if (autoSaveTimer) clearInterval(autoSaveTimer)
            autoSaveTimer = setInterval(() => {
                if (isDirty) {
                    saveNote()
                }
            }, 30000) // Auto-save every 30 seconds
        }

        // Setup keyboard shortcuts
        function setupKeyboardShortcuts() {
            document.addEventListener('keydown', (e) => {
                // Ctrl/Cmd + S for save
                if ((e.ctrlKey || e.metaKey) && e.key === 's') {
                    e.preventDefault()
                    handleSave()
                }

                // Ctrl/Cmd + B for bold
                if ((e.ctrlKey || e.metaKey) && e.key === 'b') {
                    e.preventDefault()
                    insertFormatting('**', '**')
                }

                // Ctrl/Cmd + I for italic
                if ((e.ctrlKey || e.metaKey) && e.key === 'i') {
                    e.preventDefault()
                    insertFormatting('*', '*')
                }
            })
        }

        // Handle title change
        function handleTitleChange() {
            isDirty = true
            markAsUnsaved()
        }

        // Handle title keydown
        function handleTitleKeydown(e) {
            if (e.key === 'Enter') {
                e.preventDefault()
                contentTextarea?.focus()
            }
        }

        // Handle content change
        function handleContentChange() {
            isDirty = true
            updateWordCount()
            markAsUnsaved()
        }

        // Handle content keydown
        function handleContentKeydown(e) {
            // Tab for indentation
            if (e.key === 'Tab') {
                e.preventDefault()
                insertText('    ')
            }
        }

        // Handle save
        function handleSave() {
            saveNote()
        }

        // Handle duplicate
        function handleDuplicate() {
            const event = new CustomEvent('duplicateNote', {
                detail: { noteId: note.id }
            })
            document.dispatchEvent(event)
        }

        // Handle delete
        function handleDelete() {
            if (confirm('Are you sure you want to delete this stream? This action cannot be undone.')) {
                const event = new CustomEvent('deleteNote', {
                    detail: { noteId: note.id }
                })
                document.dispatchEvent(event)
            }
        }

        // Handle add tag
        function handleAddTag() {
            const tag = prompt('Enter a tag:')
            if (tag && tag.trim()) {
                addTag(tag.trim())
            }
        }

        // Handle add reference
        function handleAddReference() {
            // Simple implementation - show available streams to reference
            const availableStreams = allNotes.filter(n => n.id !== note.id)
            const streamTitles = availableStreams.map(n => `${n.title || 'Untitled'} (${n.id})`).join('\n')

            if (availableStreams.length === 0) {
                alert('No other streams available to reference.')
                return
            }

            const selectedTitle = prompt('Available streams:\n\n' + streamTitles + '\n\nEnter stream title or ID to reference:')
            if (!selectedTitle) return

            const targetStream = availableStreams.find(n =>
                n.title === selectedTitle || n.id === selectedTitle
            )

            if (targetStream) {
                addReference(targetStream.id, 'reference')
            } else {
                alert('Stream not found.')
            }
        }

        // Handle find related
        function handleFindRelated() {
            const event = new CustomEvent('findRelatedStreams', {
                detail: { streamId: note.id }
            })
            document.dispatchEvent(event)
        }

        // Handle create new stream
        function handleCreateNewStream() {
            const event = new CustomEvent('createNewStream')
            document.dispatchEvent(event)
        }

        // Save note
        async function saveNote() {
            if (!titleInput || !contentTextarea) return

            const updates = {
                title: titleInput.value.trim(),
                content: contentTextarea.value,
                updatedAt: new Date().toISOString()
            }

            try {
                const event = new CustomEvent('updateNote', {
                    detail: { noteId: note.id, updates }
                })
                document.dispatchEvent(event)

                isDirty = false
                markAsSaved()

                console.log('Stream saved successfully')
            } catch (error) {
                console.error('Error saving stream:', error)
            }
        }

        // Add tag
        function addTag(tag) {
            const currentTags = note.tags || []
            if (!currentTags.includes(tag)) {
                const updatedTags = [...currentTags, tag]
                updateNoteTags(updatedTags)
            }
        }

        // Remove tag
        function removeTag(tag) {
            const currentTags = note.tags || []
            const updatedTags = currentTags.filter(t => t !== tag)
            updateNoteTags(updatedTags)
        }

        // Update note tags
        function updateNoteTags(tags) {
            const updates = { tags }
            const event = new CustomEvent('updateNote', {
                detail: { noteId: note.id, updates }
            })
            document.dispatchEvent(event)
        }

        // Add reference
        function addReference(targetStreamId, referenceType) {
            const event = new CustomEvent('addStreamReference', {
                detail: {
                    fromStreamId: note.id,
                    toStreamId: targetStreamId,
                    referenceType
                }
            })
            document.dispatchEvent(event)
        }

        // Remove reference
        function removeReference(referenceId) {
            const event = new CustomEvent('removeStreamReference', {
                detail: {
                    fromStreamId: note.id,
                    referenceId
                }
            })
            document.dispatchEvent(event)
        }

        // Insert formatting
        function insertFormatting(prefix, suffix) {
            if (!contentTextarea) return

            const start = contentTextarea.selectionStart
            const end = contentTextarea.selectionEnd
            const selectedText = contentTextarea.value.substring(start, end)
            const replacement = prefix + selectedText + suffix

            contentTextarea.value = contentTextarea.value.substring(0, start) + replacement + contentTextarea.value.substring(end)
            contentTextarea.focus()
            contentTextarea.selectionStart = start + prefix.length
            contentTextarea.selectionEnd = start + prefix.length + selectedText.length
        }

        // Insert text at cursor
        function insertText(text) {
            if (!contentTextarea) return

            const start = contentTextarea.selectionStart
            const end = contentTextarea.selectionEnd

            contentTextarea.value = contentTextarea.value.substring(0, start) + text + contentTextarea.value.substring(end)
            contentTextarea.focus()
            contentTextarea.selectionStart = contentTextarea.selectionEnd = start + text.length
        }

        // Update word and character count
        function updateWordCount() {
            if (!contentTextarea) return

            const text = contentTextarea.value
            const words = text.trim() ? text.trim().split(/\s+/).length : 0
            const chars = text.length

            if (wordCount) wordCount.textContent = `${words} word${words !== 1 ? 's' : ''}`
            if (charCount) charCount.textContent = `${chars} character${chars !== 1 ? 's' : ''}`
        }

        // Mark as unsaved
        function markAsUnsaved() {
            if (saveBtn) {
                saveBtn.textContent = 'Save*'
                saveBtn.classList.add('bg-orange-600', 'hover:bg-orange-700')
                saveBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700')
            }
        }

        // Mark as saved
        function markAsSaved() {
            if (saveBtn) {
                saveBtn.textContent = 'Save'
                saveBtn.classList.add('bg-blue-600', 'hover:bg-blue-700')
                saveBtn.classList.remove('bg-orange-600', 'hover:bg-orange-700')
            }
        }

        // Utility functions for template
        function getTypeIcon(type) {
            const icons = {
                note: '📝',
                idea: '💡',
                task: '✅',
                meeting: '👥',
                project: '📁',
                reference: '🔗',
                template: '📋'
            }
            return icons[type] || '📄'
        }

        function getTypeColor(type) {
            const colors = {
                note: 'bg-blue-500 text-white',
                idea: 'bg-green-500 text-white',
                task: 'bg-yellow-500 text-white',
                meeting: 'bg-purple-500 text-white',
                project: 'bg-red-500 text-white',
                reference: 'bg-indigo-500 text-white',
                template: 'bg-pink-500 text-white'
            }
            return colors[type] || 'bg-gray-500 text-white'
        }

        function getReferenceTitle(targetStreamId) {
            const targetNote = allNotes.find(n => n.id === targetStreamId)
            return targetNote ? targetNote.title : null
        }

        function formatDate(dateString) {
            try {
                const date = new Date(dateString)
                return date.toLocaleDateString() + ' ' + date.toLocaleTimeString()
            } catch {
                return 'Unknown'
            }
        }

        // Public API for parent components
        window.PrehenderStreamEditor = {
            updateNote: (newNote) => {
                note = newNote
                if (titleInput) titleInput.value = note.title || ''
                if (contentTextarea) contentTextarea.value = note.content || ''
                updateWordCount()
            },

            updateAllNotes: (newAllNotes) => {
                allNotes = newAllNotes
            },

            focus: () => {
                if (titleInput && !titleInput.value) {
                    titleInput.focus()
                } else {
                    contentTextarea?.focus()
                }
            }
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', init)

        console.log('✏️ Prehender Stream Editor component loaded!')
    }
}
