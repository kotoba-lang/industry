// Prehender Sidebar Component - Kotoba Template
// Reimplements the original NoteSidebar.tsx component with Kotoba

metadata {
    title "Prehender Sidebar"
    description "Sidebar component for stream navigation and management"
}

// Component props/data
data {
    notes: []
    selectedNoteId: null
    onNoteSelect: (noteId: string) => void
    onDeleteNote: (noteId: string) => void
    onNoteUpdate: (noteId: string, updates: object) => void
}

template {
    aside id="sidebar" class="w-80 bg-white border-r border-gray-200 flex flex-col h-full" {
        // Sidebar Header
        div class="p-4 border-b border-gray-200 bg-gray-50" {
            div class="flex items-center justify-between mb-3" {
                h2 class="text-lg font-semibold text-gray-900" { "Streams" }
                span id="stream-count" class="text-xs text-gray-500 bg-gray-200 px-2 py-1 rounded-full" {
                    "{{notes.length}} streams"
                }
            }

            // Search and Filter Controls
            div class="space-y-2" {
                // Search Input
                div class="relative" {
                    input id="sidebar-search" type="text" placeholder="Search streams..."
                           class="w-full pl-9 pr-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
                    div class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400" {
                        svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        }
                    }
                }

                // Filter Controls
                div class="flex items-center space-x-2" {
                    select id="type-filter" class="flex-1 px-3 py-1 border border-gray-300 rounded text-xs focus:ring-1 focus:ring-blue-500" {
                        option value="all" { "All Types" }
                        option value="note" { "📝 Notes" }
                        option value="idea" { "💡 Ideas" }
                        option value="task" { "✅ Tasks" }
                        option value="meeting" { "👥 Meetings" }
                        option value="project" { "📁 Projects" }
                    }

                    button id="sort-btn" class="p-1 text-gray-600 hover:text-gray-800 hover:bg-gray-200 rounded transition-colors"
                            title="Sort options" {
                        svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"
                        }
                    }

                    button id="filter-btn" class="p-1 text-gray-600 hover:text-gray-800 hover:bg-gray-200 rounded transition-colors"
                            title="Filter options" {
                        svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"
                        }
                    }
                }
            }
        }

        // Stream List
        div id="stream-list" class="flex-1 overflow-y-auto" {
            // Loading State
            div id="loading-state" class="p-8 text-center text-gray-500" {
                div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto mb-4" {}
                p class="text-sm" { "Loading streams..." }
            }

            // Empty State
            div id="empty-state" class="p-8 text-center text-gray-500 hidden" {
                div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4" {
                    span class="text-2xl" { "📄" }
                }
                h3 class="text-lg font-medium text-gray-900 mb-2" { "No streams yet" }
                p class="text-sm text-gray-600 mb-4" { "Create your first stream to get started with Prehender." }
                button id="create-first-stream-btn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors text-sm" {
                    "+ Create First Stream"
                }
            }

            // Stream Items Container
            div id="stream-items" class="hidden" {
                @each(notes as note) {
                    div class="stream-item group p-3 border-b border-gray-100 hover:bg-gray-50 cursor-pointer transition-all duration-200 {{selectedNoteId === note.id ? 'bg-blue-50 border-l-4 border-l-blue-500' : ''}}"
                         data-note-id="{{note.id}}"
                         data-note-type="{{note.streamType || 'note'}}" {

                        div class="flex items-start space-x-3" {
                            // Stream Type Icon
                            div class="flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-sm {{getTypeColor(note.streamType || 'note')}}" {
                                span { "{{getTypeIcon(note.streamType || 'note')}}" }
                            }

                            // Stream Content
                            div class="flex-1 min-w-0" {
                                // Title and Actions
                                div class="flex items-center justify-between mb-1" {
                                    h3 class="font-medium text-gray-900 truncate text-sm pr-2" {
                                        "{{note.title || 'Untitled'}}"
                                    }

                                    // Action Menu
                                    div class="opacity-0 group-hover:opacity-100 transition-opacity" {
                                        button class="stream-menu-btn p-1 text-gray-400 hover:text-gray-600 rounded" title="More options" {
                                            svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" {
                                                path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"
                                            }
                                        }
                                    }
                                }

                                // Content Preview
                                p class="text-xs text-gray-600 mb-2 line-clamp-2" {
                                    "{{note.content ? note.content.substring(0, 80) + (note.content.length > 80 ? '...' : '') : 'No content'}}"
                                }

                                // Metadata
                                div class="flex items-center justify-between text-xs text-gray-500" {
                                    div class="flex items-center space-x-3" {
                                        span { "📅 {{formatDate(note.updatedAt)}}" }
                                        @if(note.references && note.references.length > 0) {
                                            span { "🔗 {{note.references.length}}" }
                                        }
                                        @if(note.tags && note.tags.length > 0) {
                                            span { "🏷️ {{note.tags.length}}" }
                                        }
                                    }

                                    @if(note.streamState) {
                                        span class="px-2 py-1 rounded-full text-xs {{getStateColor(note.streamState)}}" {
                                            "{{note.streamState}}"
                                        }
                                    }
                                }
                            }
                        }

                        // Context Menu (hidden by default)
                        div class="stream-context-menu absolute right-2 top-2 bg-white border border-gray-200 rounded-lg shadow-lg py-1 z-50 hidden" {
                            button class="context-menu-item w-full text-left px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors flex items-center space-x-2" data-action="edit" {
                                svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                                    path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                                }
                                span { "Edit" }
                            }

                            button class="context-menu-item w-full text-left px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors flex items-center space-x-2" data-action="duplicate" {
                                svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                                    path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                                }
                                span { "Duplicate" }
                            }

                            button class="context-menu-item w-full text-left px-3 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors flex items-center space-x-2" data-action="delete" {
                                svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                                    path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                                }
                                span { "Delete" }
                            }
                        }
                    }
                }
            }
        }

        // Sidebar Footer
        div class="p-4 border-t border-gray-200 bg-gray-50" {
            div class="flex items-center justify-between text-xs text-gray-600" {
                div class="flex items-center space-x-4" {
                    span id="total-stats" { "Loading..." }
                    button id="refresh-btn" class="text-blue-600 hover:text-blue-800 underline" title="Refresh" {
                        "Refresh"
                    }
                }
            }
        }
    }

    // Component JavaScript
    script {
        // Component state
        let notes = {{notes}}
        let selectedNoteId = '{{selectedNoteId}}'
        let filteredNotes = [...notes]
        let searchQuery = ''
        let typeFilter = 'all'
        let sortOrder = 'updated-desc'

        // DOM elements
        const streamList = document.getElementById('stream-list')
        const streamItems = document.getElementById('stream-items')
        const loadingState = document.getElementById('loading-state')
        const emptyState = document.getElementById('empty-state')
        const searchInput = document.getElementById('sidebar-search')
        const typeFilterSelect = document.getElementById('type-filter')
        const sortBtn = document.getElementById('sort-btn')
        const filterBtn = document.getElementById('filter-btn')
        const refreshBtn = document.getElementById('refresh-btn')
        const totalStats = document.getElementById('total-stats')

        // Initialize component
        function init() {
            setupEventListeners()
            updateUI()
            updateStats()
        }

        // Setup event listeners
        function setupEventListeners() {
            // Search input
            if (searchInput) {
                searchInput.addEventListener('input', debounce(handleSearch, 300))
            }

            // Type filter
            if (typeFilterSelect) {
                typeFilterSelect.addEventListener('change', handleTypeFilter)
            }

            // Sort button
            if (sortBtn) {
                sortBtn.addEventListener('click', toggleSortMenu)
            }

            // Filter button
            if (filterBtn) {
                filterBtn.addEventListener('click', toggleFilterMenu)
            }

            // Refresh button
            if (refreshBtn) {
                refreshBtn.addEventListener('click', handleRefresh)
            }

            // Stream item clicks
            document.addEventListener('click', handleStreamClick)

            // Context menu actions
            document.addEventListener('click', handleContextMenuAction)
        }

        // Handle stream item click
        function handleStreamClick(e) {
            const streamItem = e.target.closest('.stream-item')
            const contextMenuItem = e.target.closest('.context-menu-item')

            if (contextMenuItem) {
                return // Handle in separate function
            }

            if (streamItem && !e.target.closest('.stream-menu-btn')) {
                const noteId = streamItem.dataset.noteId
                selectStream(noteId)
            }
        }

        // Select a stream
        function selectStream(noteId) {
            selectedNoteId = noteId

            // Update UI
            document.querySelectorAll('.stream-item').forEach(item => {
                const isSelected = item.dataset.noteId === noteId
                item.classList.toggle('bg-blue-50', isSelected)
                item.classList.toggle('border-l-4', isSelected)
                item.classList.toggle('border-l-blue-500', isSelected)
            })

            // Emit event
            const event = new CustomEvent('noteSelect', {
                detail: { noteId }
            })
            document.dispatchEvent(event)
        }

        // Handle search
        function handleSearch(e) {
            searchQuery = e.target.value.toLowerCase()
            filterNotes()
            renderStreamList()
        }

        // Handle type filter
        function handleTypeFilter(e) {
            typeFilter = e.target.value
            filterNotes()
            renderStreamList()
        }

        // Filter notes based on search and type
        function filterNotes() {
            filteredNotes = notes.filter(note => {
                // Search filter
                const matchesSearch = !searchQuery ||
                    note.title?.toLowerCase().includes(searchQuery) ||
                    note.content?.toLowerCase().includes(searchQuery) ||
                    note.tags?.some(tag => tag.toLowerCase().includes(searchQuery))

                // Type filter
                const matchesType = typeFilter === 'all' || note.streamType === typeFilter

                return matchesSearch && matchesType
            })
        }

        // Toggle sort menu
        function toggleSortMenu() {
            // TODO: Implement sort menu
            console.log('Toggle sort menu')
        }

        // Toggle filter menu
        function toggleFilterMenu() {
            // TODO: Implement filter menu
            console.log('Toggle filter menu')
        }

        // Handle refresh
        function handleRefresh() {
            const event = new CustomEvent('refreshNotes')
            document.dispatchEvent(event)
        }

        // Handle context menu actions
        function handleContextMenuAction(e) {
            const menuItem = e.target.closest('.context-menu-item')
            if (!menuItem) return

            e.stopPropagation()

            const action = menuItem.dataset.action
            const streamItem = menuItem.closest('.stream-item')
            const noteId = streamItem?.dataset.noteId

            if (!noteId) return

            switch (action) {
                case 'edit':
                    selectStream(noteId)
                    break
                case 'duplicate':
                    duplicateStream(noteId)
                    break
                case 'delete':
                    deleteStream(noteId)
                    break
            }

            // Hide context menu
            document.querySelectorAll('.stream-context-menu').forEach(menu => {
                menu.classList.add('hidden')
            })
        }

        // Duplicate stream
        function duplicateStream(noteId) {
            const event = new CustomEvent('duplicateNote', {
                detail: { noteId }
            })
            document.dispatchEvent(event)
        }

        // Delete stream
        function deleteStream(noteId) {
            if (confirm('Are you sure you want to delete this stream?')) {
                const event = new CustomEvent('deleteNote', {
                    detail: { noteId }
                })
                document.dispatchEvent(event)
            }
        }

        // Update UI based on state
        function updateUI() {
            if (notes.length === 0) {
                loadingState.classList.add('hidden')
                streamItems.classList.add('hidden')
                emptyState.classList.remove('hidden')
            } else {
                loadingState.classList.add('hidden')
                emptyState.classList.add('hidden')
                streamItems.classList.remove('hidden')
                renderStreamList()
            }
        }

        // Render stream list
        function renderStreamList() {
            // This will be handled by Kotoba's data binding
            // For now, we rely on the template's @each directive
        }

        // Update statistics
        function updateStats() {
            const totalNotes = notes.length
            const selectedNotes = notes.filter(n => n.streamState === 'active').length
            const completedTasks = notes.filter(n => n.streamType === 'task' && n.streamState === 'completed').length

            totalStats.textContent = `${totalNotes} total • ${selectedNotes} active${completedTasks > 0 ? ` • ${completedTasks} completed` : ''}`
        }

        // Utility functions for template
        function getTypeIcon(type) {
            const icons = {
                note: '📝',
                idea: '💡',
                task: '✅',
                meeting: '👥',
                project: '📁',
                reference: '🔗',
                template: '📋'
            }
            return icons[type] || '📄'
        }

        function getTypeColor(type) {
            const colors = {
                note: 'bg-blue-100 text-blue-600',
                idea: 'bg-green-100 text-green-600',
                task: 'bg-yellow-100 text-yellow-600',
                meeting: 'bg-purple-100 text-purple-600',
                project: 'bg-red-100 text-red-600',
                reference: 'bg-indigo-100 text-indigo-600',
                template: 'bg-pink-100 text-pink-600'
            }
            return colors[type] || 'bg-gray-100 text-gray-600'
        }

        function getStateColor(state) {
            const colors = {
                draft: 'bg-gray-100 text-gray-800',
                active: 'bg-green-100 text-green-800',
                completed: 'bg-blue-100 text-blue-800',
                archived: 'bg-yellow-100 text-yellow-800'
            }
            return colors[state] || 'bg-gray-100 text-gray-800'
        }

        function formatDate(dateString) {
            try {
                const date = new Date(dateString)
                const now = new Date()
                const diffTime = Math.abs(now - date)
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24))

                if (diffDays === 1) return 'today'
                if (diffDays === 2) return 'yesterday'
                if (diffDays <= 7) return `${diffDays - 1} days ago`
                return date.toLocaleDateString()
            } catch {
                return 'recent'
            }
        }

        // Debounce utility
        function debounce(func, wait) {
            let timeout
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout)
                    func(...args)
                }
                clearTimeout(timeout)
                timeout = setTimeout(later, wait)
            }
        }

        // Public API for parent components
        window.PrehenderSidebar = {
            updateNotes: (newNotes) => {
                notes = newNotes
                filterNotes()
                updateUI()
                updateStats()
            },

            selectNote: (noteId) => {
                selectStream(noteId)
            },

            refresh: () => {
                handleRefresh()
            }
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', init)

        console.log('📋 Prehender Sidebar component loaded!')
    }
}
