// Prehender Viewpoint Panel Component - Kotoba Template
// Reimplements the original ViewpointPanel.tsx component with Kotoba

metadata {
    title "Prehender Viewpoint Panel"
    description "Viewpoint panel component for different perspectives on streams"
}

// Component props/data
data {
    note: null
    viewpoint: "timeline"
    allNotes: []
    streamNetwork: { streams: new Map(), references: new Map(), reverseReferences: new Map() }
    onAddStreamReference: (fromId: string, toId: string, type: string) => void
    onRemoveStreamReference: (fromId: string, referenceId: string) => void
    findRelatedStreams: (streamId: string, depth: number) => void
}

template {
    div id="viewpoint-panel" class="h-full flex flex-col bg-white" {
        @if(note) {
            // Viewpoint Header
            div class="flex-shrink-0 p-4 border-b border-gray-200 bg-gray-50" {
                div class="flex items-center justify-between" {
                    div class="flex items-center space-x-3" {
                        // Viewpoint Icon
                        div class="w-10 h-10 rounded-lg flex items-center justify-center text-lg {{getViewpointColor(viewpoint)}}" {
                            span { "{{getViewpointIcon(viewpoint)}}" }
                        }

                        // Title and Description
                        div {
                            h2 class="text-lg font-semibold text-gray-900" {
                                "{{getViewpointTitle(viewpoint)}}"
                            }
                            p class="text-sm text-gray-600" {
                                "{{getViewpointDescription(viewpoint)}}"
                            }
                        }
                    }

                    // Viewpoint Controls
                    div class="flex items-center space-x-2" {
                        // Viewpoint Selector
                        select id="viewpoint-selector" class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent" {
                            option value="timeline" selected="{{viewpoint === 'timeline'}}" { "📅 Timeline" }
                            option value="network" selected="{{viewpoint === 'network'}}" { "🔗 Network" }
                            option value="kanban" selected="{{viewpoint === 'kanban'}}" { "📋 Kanban" }
                            option value="calendar" selected="{{viewpoint === 'calendar'}}" { "🗓️ Calendar" }
                            option value="mindmap" selected="{{viewpoint === 'mindmap'}}" { "🧠 Mind Map" }
                            option value="gantt" selected="{{viewpoint === 'gantt'}}" { "📊 Gantt" }
                        }

                        // Settings Button
                        button id="viewpoint-settings-btn" class="p-2 text-gray-600 hover:text-gray-800 hover:bg-gray-100 rounded-lg transition-colors" title="Viewpoint Settings" {
                            svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" {
                                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4"
                            }
                        }
                    }
                }
            }

            // Viewpoint Content Area
            div class="flex-1 overflow-hidden" {
                @if(viewpoint === 'timeline') {
                    {{{renderTimelineView()}}}
                } @elif(viewpoint === 'network') {
                    {{{renderNetworkView()}}}
                } @elif(viewpoint === 'kanban') {
                    {{{renderKanbanView()}}}
                } @elif(viewpoint === 'calendar') {
                    {{{renderCalendarView()}}}
                } @elif(viewpoint === 'mindmap') {
                    {{{renderMindMapView()}}}
                } @elif(viewpoint === 'gantt') {
                    {{{renderGanttView()}}}
                } @else {
                    {{{renderDefaultView()}}}
                }
            }

            // Viewpoint Footer
            div class="flex-shrink-0 p-4 border-t border-gray-200 bg-gray-50" {
                div class="flex items-center justify-between text-sm text-gray-600" {
                    div class="flex items-center space-x-4" {
                        span { "{{getStatsText()}}" }
                        span { "•" }
                        span { "Last updated: {{formatDate(note.updatedAt)}}" }
                    }

                    div class="flex items-center space-x-2" {
                        button id="export-view-btn" class="px-3 py-1.5 bg-gray-600 text-white rounded hover:bg-gray-700 transition-colors text-sm" {
                            "Export"
                        }
                        button id="share-view-btn" class="px-3 py-1.5 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors text-sm" {
                            "Share"
                        }
                    }
                }
            }
        } @else {
            // Empty State
            div class="flex-1 flex items-center justify-center" {
                div class="text-center max-w-md" {
                    div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6" {
                        span class="text-3xl" { "👁️" }
                    }
                    h2 class="text-xl font-semibold text-gray-900 mb-3" { "No Stream Selected" }
                    p class="text-gray-600 mb-6" { "Select a stream to explore it from different viewpoints." }
                }
            }
        }
    }

    // Component JavaScript
    script {
        // Component state
        let note = {{note}}
        let viewpoint = '{{viewpoint}}'
        let allNotes = {{allNotes}}
        let streamNetwork = {{streamNetwork}}

        // DOM elements
        const viewpointSelector = document.getElementById('viewpoint-selector')
        const exportViewBtn = document.getElementById('export-view-btn')
        const shareViewBtn = document.getElementById('share-view-btn')
        const viewpointSettingsBtn = document.getElementById('viewpoint-settings-btn')

        // Initialize component
        function init() {
            if (!note) return

            setupEventListeners()
            renderViewpoint()
        }

        // Setup event listeners
        function setupEventListeners() {
            // Viewpoint selector
            if (viewpointSelector) {
                viewpointSelector.addEventListener('change', handleViewpointChange)
            }

            // Export button
            if (exportViewBtn) {
                exportViewBtn.addEventListener('click', handleExport)
            }

            // Share button
            if (shareViewBtn) {
                shareViewBtn.addEventListener('click', handleShare)
            }

            // Settings button
            if (viewpointSettingsBtn) {
                viewpointSettingsBtn.addEventListener('click', handleSettings)
            }
        }

        // Handle viewpoint change
        function handleViewpointChange(e) {
            viewpoint = e.target.value
            renderViewpoint()

            const event = new CustomEvent('viewpointChange', {
                detail: { viewpoint }
            })
            document.dispatchEvent(event)
        }

        // Handle export
        function handleExport() {
            const data = getViewpointData()
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' })
            const url = URL.createObjectURL(blob)

            const a = document.createElement('a')
            a.href = url
            a.download = `prehender-${viewpoint}-${note.id}.json`
            document.body.appendChild(a)
            a.click()
            document.body.removeChild(a)
            URL.revokeObjectURL(url)
        }

        // Handle share
        function handleShare() {
            const url = `${window.location.origin}?stream=${note.id}&viewpoint=${viewpoint}`

            if (navigator.share) {
                navigator.share({
                    title: `${note.title} - ${getViewpointTitle(viewpoint)}`,
                    text: `Check out this stream in ${getViewpointTitle(viewpoint)} view`,
                    url: url
                })
            } else {
                navigator.clipboard.writeText(url).then(() => {
                    alert('View URL copied to clipboard!')
                })
            }
        }

        // Handle settings
        function handleSettings() {
            // TODO: Implement viewpoint settings modal
            alert('Viewpoint settings coming soon!')
        }

        // Render viewpoint content
        function renderViewpoint() {
            const contentArea = document.querySelector('#viewpoint-panel > div:nth-child(2)')
            if (!contentArea) return

            let html = ''

            switch (viewpoint) {
                case 'timeline':
                    html = renderTimelineView()
                    break
                case 'network':
                    html = renderNetworkView()
                    break
                case 'kanban':
                    html = renderKanbanView()
                    break
                case 'calendar':
                    html = renderCalendarView()
                    break
                case 'mindmap':
                    html = renderMindMapView()
                    break
                case 'gantt':
                    html = renderGanttView()
                    break
                default:
                    html = renderDefaultView()
            }

            contentArea.innerHTML = html
        }

        // Render Timeline View
        function renderTimelineView() {
            const relatedStreams = findRelatedStreams(note.id, 3)
            const timelineEvents = []

            // Add current note
            timelineEvents.push({
                id: note.id,
                title: note.title || 'Current Stream',
                type: 'current',
                date: new Date(note.updatedAt),
                description: note.content ? note.content.substring(0, 100) + '...' : 'No content'
            })

            // Add related streams
            relatedStreams.forEach(related => {
                timelineEvents.push({
                    id: related.stream.id,
                    title: related.stream.title || 'Untitled',
                    type: 'related',
                    date: new Date(related.stream.updatedAt),
                    description: related.stream.content ? related.stream.content.substring(0, 80) + '...' : 'No content',
                    depth: related.depth
                })
            })

            // Sort by date
            timelineEvents.sort((a, b) => b.date - a.date)

            return `
                <div class="p-6">
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">Timeline View</h3>
                        <p class="text-sm text-gray-600">See how this stream and related streams have evolved over time.</p>
                    </div>

                    <div class="relative">
                        <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gray-300"></div>

                        <div class="space-y-6">
                            ${timelineEvents.map(event => `
                                <div class="relative flex items-start space-x-4">
                                    <div class="flex-shrink-0 w-8 h-8 rounded-full ${event.type === 'current' ? 'bg-blue-500' : 'bg-gray-400'} flex items-center justify-center">
                                        <span class="text-white text-xs">${event.type === 'current' ? '📝' : '🔗'}</span>
                                    </div>

                                    <div class="flex-1 min-w-0 pb-6">
                                        <div class="flex items-center space-x-2 mb-2">
                                            <h4 class="font-medium text-gray-900">${event.title}</h4>
                                            ${event.depth ? `<span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded">${event.depth}° connection</span>` : ''}
                                        </div>
                                        <p class="text-sm text-gray-600 mb-2">${event.description}</p>
                                        <p class="text-xs text-gray-500">${formatDate(event.date)}</p>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                </div>
            `
        }

        // Render Network View
        function renderNetworkView() {
            const relatedStreams = findRelatedStreams(note.id, 2)

            return `
                <div class="p-6">
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">Network View</h3>
                        <p class="text-sm text-gray-600">Explore connections between streams in a network graph.</p>
                    </div>

                    <div class="bg-gray-50 rounded-lg p-8 text-center">
                        <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                            <span class="text-2xl">🔗</span>
                        </div>
                        <h4 class="font-medium text-gray-900 mb-2">Network Visualization</h4>
                        <p class="text-sm text-gray-600 mb-4">Interactive network view coming soon!</p>
                        <div class="text-left max-w-md mx-auto">
                            <div class="space-y-2 text-sm">
                                <div class="flex justify-between">
                                    <span>Current Stream:</span>
                                    <span class="font-medium">${note.title || 'Untitled'}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Direct References:</span>
                                    <span class="font-medium">${(note.references || []).length}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Related Streams:</span>
                                    <span class="font-medium">${relatedStreams.length}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `
        }

        // Render Kanban View
        function renderKanbanView() {
            return `
                <div class="p-6">
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">Kanban View</h3>
                        <p class="text-sm text-gray-600">Organize streams by status or priority.</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="bg-gray-50 rounded-lg p-4">
                            <h4 class="font-medium text-gray-900 mb-3 flex items-center space-x-2">
                                <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                                <span>To Do</span>
                            </h4>
                            <div class="space-y-2">
                                <div class="bg-white p-3 rounded border border-gray-200 text-sm">
                                    Sample task item
                                </div>
                            </div>
                        </div>

                        <div class="bg-gray-50 rounded-lg p-4">
                            <h4 class="font-medium text-gray-900 mb-3 flex items-center space-x-2">
                                <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                                <span>In Progress</span>
                            </h4>
                            <div class="space-y-2">
                                <div class="bg-white p-3 rounded border border-gray-200 text-sm text-center text-gray-500">
                                    Drop tasks here
                                </div>
                            </div>
                        </div>

                        <div class="bg-gray-50 rounded-lg p-4">
                            <h4 class="font-medium text-gray-900 mb-3 flex items-center space-x-2">
                                <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                                <span>Done</span>
                            </h4>
                            <div class="space-y-2">
                                <div class="bg-white p-3 rounded border border-gray-200 text-sm text-center text-gray-500">
                                    Drop tasks here
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `
        }

        // Render Calendar View
        function renderCalendarView() {
            return `
                <div class="p-6">
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">Calendar View</h3>
                        <p class="text-sm text-gray-600">View streams scheduled for specific dates.</p>
                    </div>

                    <div class="bg-gray-50 rounded-lg p-8 text-center">
                        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                            <span class="text-2xl">📅</span>
                        </div>
                        <h4 class="font-medium text-gray-900 mb-2">Calendar Integration</h4>
                        <p class="text-sm text-gray-600">Calendar view for scheduling and time-based streams coming soon!</p>
                    </div>
                </div>
            `
        }

        // Render Mind Map View
        function renderMindMapView() {
            return `
                <div class="p-6">
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">Mind Map View</h3>
                        <p class="text-sm text-gray-600">Visualize stream relationships as a mind map.</p>
                    </div>

                    <div class="bg-gray-50 rounded-lg p-8 text-center">
                        <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
                            <span class="text-2xl">🧠</span>
                        </div>
                        <h4 class="font-medium text-gray-900 mb-2">Mind Map Visualization</h4>
                        <p class="text-sm text-gray-600">Interactive mind map view coming soon!</p>
                    </div>
                </div>
            `
        }

        // Render Gantt View
        function renderGanttView() {
            return `
                <div class="p-6">
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">Gantt View</h3>
                        <p class="text-sm text-gray-600">Project timeline and task dependencies.</p>
                    </div>

                    <div class="bg-gray-50 rounded-lg p-8 text-center">
                        <div class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-4">
                            <span class="text-2xl">📊</span>
                        </div>
                        <h4 class="font-medium text-gray-900 mb-2">Project Timeline</h4>
                        <p class="text-sm text-gray-600">Gantt chart view for project management coming soon!</p>
                    </div>
                </div>
            `
        }

        // Render Default View
        function renderDefaultView() {
            return `
                <div class="p-6">
                    <div class="text-center">
                        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                            <span class="text-2xl">👁️</span>
                        </div>
                        <h4 class="font-medium text-gray-900 mb-2">Viewpoint Not Available</h4>
                        <p class="text-sm text-gray-600">This viewpoint is not yet implemented.</p>
                    </div>
                </div>
            `
        }

        // Find related streams
        function findRelatedStreams(streamId, depth = 2) {
            const visited = new Set()
            const results = []

            const searchRecursive = (currentStreamId, currentDepth, path) => {
                if (currentDepth > depth || visited.has(currentStreamId)) return

                visited.add(currentStreamId)
                const currentStream = streamNetwork.streams.get(currentStreamId)
                if (!currentStream || currentStream.id === note.id) return

                if (currentStreamId !== streamId) {
                    results.push({
                        stream: currentStream,
                        referencePath: [...path],
                        depth: currentDepth
                    })
                }

                // Search references
                const references = streamNetwork.references.get(currentStreamId) || []
                references.forEach(ref => {
                    if (ref.isActive) {
                        searchRecursive(ref.targetStreamId, currentDepth + 1, [...path, ref])
                    }
                })

                // Search reverse references
                const reverseRefs = streamNetwork.reverseReferences.get(currentStreamId) || []
                reverseRefs.forEach(refStreamId => {
                    const refStream = streamNetwork.streams.get(refStreamId)
                    if (refStream) {
                        const refToThis = refStream.references.find(r => r.targetStreamId === currentStreamId)
                        if (refToThis) {
                            searchRecursive(refStreamId, currentDepth + 1, [...path, refToThis])
                        }
                    }
                })
            }

            searchRecursive(streamId, 0, [])
            return results
        }

        // Get viewpoint data for export
        function getViewpointData() {
            return {
                viewpoint,
                streamId: note.id,
                streamTitle: note.title,
                timestamp: new Date().toISOString(),
                data: getViewpointSpecificData()
            }
        }

        // Get viewpoint-specific data
        function getViewpointSpecificData() {
            switch (viewpoint) {
                case 'timeline':
                    return findRelatedStreams(note.id, 3)
                case 'network':
                    return findRelatedStreams(note.id, 2)
                default:
                    return {}
            }
        }

        // Utility functions
        function getViewpointIcon(viewpoint) {
            const icons = {
                timeline: '📅',
                network: '🔗',
                kanban: '📋',
                calendar: '🗓️',
                mindmap: '🧠',
                gantt: '📊'
            }
            return icons[viewpoint] || '👁️'
        }

        function getViewpointColor(viewpoint) {
            const colors = {
                timeline: 'bg-blue-500 text-white',
                network: 'bg-green-500 text-white',
                kanban: 'bg-yellow-500 text-white',
                calendar: 'bg-red-500 text-white',
                mindmap: 'bg-purple-500 text-white',
                gantt: 'bg-orange-500 text-white'
            }
            return colors[viewpoint] || 'bg-gray-500 text-white'
        }

        function getViewpointTitle(viewpoint) {
            const titles = {
                timeline: 'Timeline View',
                network: 'Network View',
                kanban: 'Kanban View',
                calendar: 'Calendar View',
                mindmap: 'Mind Map View',
                gantt: 'Gantt View'
            }
            return titles[viewpoint] || 'Unknown View'
        }

        function getViewpointDescription(viewpoint) {
            const descriptions = {
                timeline: 'See how streams evolve over time',
                network: 'Explore connections between streams',
                kanban: 'Organize streams by status',
                calendar: 'View streams on a calendar',
                mindmap: 'Visualize as a mind map',
                gantt: 'Project timeline and dependencies'
            }
            return descriptions[viewpoint] || 'Alternative view of your streams'
        }

        function getStatsText() {
            const related = findRelatedStreams(note.id, 2).length
            const refs = (note.references || []).length
            return `${refs} references • ${related} related streams`
        }

        function formatDate(date) {
            if (date instanceof Date) {
                return date.toLocaleDateString() + ' ' + date.toLocaleTimeString()
            }
            try {
                return new Date(date).toLocaleDateString()
            } catch {
                return 'Unknown'
            }
        }

        // Public API for parent components
        window.PrehenderViewpointPanel = {
            updateNote: (newNote) => {
                note = newNote
                renderViewpoint()
            },

            updateViewpoint: (newViewpoint) => {
                viewpoint = newViewpoint
                if (viewpointSelector) viewpointSelector.value = newViewpoint
                renderViewpoint()
            },

            updateAllNotes: (newAllNotes) => {
                allNotes = newAllNotes
                renderViewpoint()
            },

            updateStreamNetwork: (newNetwork) => {
                streamNetwork = newNetwork
                renderViewpoint()
            }
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', init)

        console.log('👁️ Prehender Viewpoint Panel component loaded!')
    }
}
