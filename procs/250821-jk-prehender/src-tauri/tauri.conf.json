{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "prehender",
  "version": "0.1.0",
  "identifier": "com.junkawasaki.prehender",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:1991",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "prehender",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
