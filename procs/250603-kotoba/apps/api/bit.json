{
  "$schema": "https://static.bit.dev/teambit/schemas/schema.json",
  "teambit.harmony/aspect": {
    "name": "junkawasaki.kotoba/kotoba-api"
  },
  "teambit.node/node": {},
  "teambit.defender/eslint": {
    "eslintConfig": {
      "extends": ["@teambit/node.node-env/eslint-config"]
    }
  },
  "teambit.defender/prettier": {
    "prettierConfig": {
      "printWidth": 80,
      "tabWidth": 2,
      "useTabs": false,
      "semi": true,
      "singleQuote": true,
      "trailingComma": "es5"
    }
  },
  "teambit.generator/generator": {
    "aspects": [
      "teambit.node/node-env",
      "teambit.defender/eslint",
      "teambit.defender/prettier"
    ]
  }
} 