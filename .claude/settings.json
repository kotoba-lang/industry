{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-toolchain-pin-sync.cljk\" \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Syncing toolchain checkouts to their west pins…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-branch-sync-check.cljk\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Checking branch sync with origin/main…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-spec-inventory.cljk\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Listing external-spec repos in the workspace…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-shallow-check.cljk\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Checking this checkout and orgs/ are not shallow…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci --classpath \"$CLAUDE_PROJECT_DIR:$CLAUDE_PROJECT_DIR/scripts/nbb_compat\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-orgs-detectors.cljk\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Reporting orgs-dependent detectors (new / resolved / standing)…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-checkout-staleness.cljk\" 2>/dev/null || true",
            "timeout": 25,
            "statusMessage": "Measuring how stale the checkouts something actually reads are…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci --classpath \"$CLAUDE_PROJECT_DIR:$CLAUDE_PROJECT_DIR/scripts/nbb_compat\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-repo-bots.cljk\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Reporting the per-repo resident bots (roster, unticked, growth)…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-push-main-sync-guard.cljk\"",
            "timeout": 30,
            "statusMessage": "Checking branch is in sync with main before push…"
          },
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci --classpath \"$CLAUDE_PROJECT_DIR:$CLAUDE_PROJECT_DIR/scripts/nbb_compat\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/west-pin-verify-guard.cljk\"",
            "timeout": 90,
            "statusMessage": "Verifying west.yml pins against upstream (server-side)…"
          },
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-pull-west-sync-guard.cljk\"",
            "timeout": 15,
            "statusMessage": "Checking git pull uses depth+west-update sequence…"
          },
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci \"$CLAUDE_PROJECT_DIR/.claude/hooks/wrangler-deploy-main-sync-guard.cljk\"",
            "timeout": 45,
            "statusMessage": "Checking the deploy source contains origin/main…"
          },
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci \"$CLAUDE_PROJECT_DIR/.claude/hooks/deploy-local-root-pin-guard.cljk\"",
            "timeout": 60,
            "statusMessage": "Checking :local/root deps match their west pins before deploy…"
          },
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci \"$CLAUDE_PROJECT_DIR/.claude/hooks/branch-create-main-sync-guard.cljk\"",
            "timeout": 30,
            "statusMessage": "Checking the checkout is in sync before creating a branch…"
          },
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-edn-parse-guard.cljk\"",
            "timeout": 20,
            "statusMessage": "Checking changed 90-docs EDN parses…"
          },
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci \"$CLAUDE_PROJECT_DIR/.claude/hooks/adr-id-shape-guard.cljk\"",
            "timeout": 20,
            "statusMessage": "Checking new ADR :adr/id shape…"
          },
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci --classpath \"$CLAUDE_PROJECT_DIR:$CLAUDE_PROJECT_DIR/scripts:$CLAUDE_PROJECT_DIR/scripts/nbb_compat\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/jvm-new-surface-guard.cljk\"",
            "timeout": 25,
            "statusMessage": "Checking scaffold/deps do not grow JVM runtime surface…"
          }
        ]
      },
      {
        "matcher": "Write|Edit|StrReplace",
        "hooks": [
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci --classpath \"$CLAUDE_PROJECT_DIR:$CLAUDE_PROJECT_DIR/scripts:$CLAUDE_PROJECT_DIR/scripts/nbb_compat\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/jvm-new-surface-guard.cljk\"",
            "timeout": 25,
            "statusMessage": "Checking Write/Edit does not add production .clj or JVM runtime deps…"
          }
        ]
      },
      {
        "matcher": "Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci \"$CLAUDE_PROJECT_DIR/.claude/hooks/duplication-warn.cljk\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$DELTA_CAPTURE\" = \"1\" ] || exit 0; KBB=\"$CLAUDE_PROJECT_DIR/orgs/kotoba-lang/kotoba/bin/kbb\"; \"$KBB\" --backend sci \"$CLAUDE_PROJECT_DIR/.claude/hooks/delta-capture-post-tool.cljk\" || true",
            "timeout": 30,
            "statusMessage": "Recording edit into kotoba-delta op-log…"
          }
        ]
      }
    ]
  }
}
