{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bb \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-push-main-sync-guard.bb\"",
            "timeout": 30,
            "statusMessage": "Checking branch is in sync with main before push…"
          }
        ]
      }
    ]
  }
}
