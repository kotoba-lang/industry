#!/usr/bin/env kbb
(require '[scripts.nbb-compat :refer [sh slurp spit]]
         '[clojure.string :as str])

(def fs (js/require "node:fs"))
(def os (js/require "node:os"))
(def path (js/require "node:path"))
(def root (-> (sh "git" "rev-parse" "--show-toplevel") :out str/trim))
(def generator (.join path root "scripts" "gen-west-manifest.cljk"))
(def nbb (or (aget js/process.env "KBB_EXECUTABLE") "kbb"))

(defn run! [cwd & argv]
  (apply sh (concat argv [{:cwd cwd}])))

(defn git! [cwd & argv]
  (let [result (apply run! cwd "git" argv)]
    (when-not (zero? (:exit result))
      (throw (ex-info (str "git failed: " (:err result)) {:argv argv :result result})))
    (str/trim (:out result))))

(defn commit! [repo text message]
  (spit (.join path repo "value.txt") text)
  (git! repo "add" "value.txt")
  (git! repo "commit" "-m" message)
  (git! repo "rev-parse" "HEAD"))

(defn init-repo! [repo]
  (.mkdirSync fs repo #js {:recursive true})
  (git! repo "init" "-b" "main")
  (git! repo "config" "user.name" "manifest-test")
  (git! repo "config" "user.email" "manifest-test@example.invalid"))

(defn west-content [a-sha b-sha]
  (str "# west.yml — generated by scripts/gen-west-manifest.cljk. DO NOT EDIT BY HAND.\n"
       "# source of truth: manifest/repos.edn  /  再生成: kbb --backend sci scripts/gen-west-manifest.cljk\n"
       "manifest:\n  version: \"1.0\"\n\n"
       "  remotes:\n    - name: fixture\n      url-base: https://example.invalid/fixture\n\n"
       "  defaults:\n    revision: main\n\n"
       "  group-filter: [+fixture]\n\n"
       "  projects:\n"
       "    - name: a\n      remote: fixture\n      revision: " a-sha
       "\n      path: orgs/fixture/a\n      groups: [fixture]\n"
       "    - name: fixture-b\n      remote: fixture\n      repo-path: b\n      revision: " b-sha
       "\n      path: orgs/fixture/b\n      groups: [fixture]\n"
       "      submodules:\n        - path: vendor/example\n\n"
       "  self:\n    path: manifest\n    west-commands: west-commands.yml\n"))

(defn revision [content name]
  (second (re-find (re-pattern (str "(?s)- name: " name ".*?revision: ([0-9a-f]+)")) content)))

(defn assert! [pred message data]
  (when-not pred (throw (ex-info (str message " " (pr-str data)) data))))

(let [fixture (.mkdtempSync fs (.join path (.tmpdir os) "gen-west-manifest-test-"))]
  (try
    (init-repo! fixture)
    (.mkdirSync fs (.join path fixture "manifest") #js {:recursive true})
    (spit (.join path fixture "manifest" "repos.edn")
          (pr-str [{:db/id -1
                    :manifest.repos/remotes {"fixture" "https://example.invalid/fixture"}
                    :manifest.repos/defaults {:revision "main"}
                    :manifest.repos/group-filter ["+fixture"]
                    :manifest.repos/extra-projects ["orgs/fixture/a" "orgs/fixture/b"]}]))
    (let [a (.join path fixture "orgs" "fixture" "a")
          b (.join path fixture "orgs" "fixture" "b")]
      (init-repo! a)
      (init-repo! b)
      (let [a-old (commit! a "old\n" "old")
            b-old (commit! b "old\n" "old")
            a-new (commit! a "new\n" "new")
            west (.join path fixture "manifest" "west.yml")]
        (spit west (west-content a-old b-old))

        ;; Renamed paths may temporarily lack policy entries. Never silently
        ;; reactivate archived datasets or strip their custody metadata.
        (doseq [replacement ["groups: [legacy-group]"
                             "groups: [archived]\n      userdata:\n        archived: true"
                             "groups: [datalad]\n      userdata:\n        datalad: true\n        annex-remote: b2"]]
          (spit west (str/replace-first (west-content a-old b-old) "groups: [fixture]" replacement))
          (let [checked (run! fixture nbb "--backend" "sci" "--classpath" root generator "--check")]
            (assert! (zero? (:exit checked)) "committed classification was lost" checked)))
        (spit west (str/replace (west-content a-old b-old) "\n  self:" "\n\n  self:"))
        (let [updated (run! fixture nbb "--backend" "sci" "--classpath" root generator "--entry" "a" "--no-verify-remote")
              checked (run! fixture nbb "--backend" "sci" "--classpath" root generator "--check")]
          (assert! (zero? (:exit updated)) "entry update failed" updated)
          (assert! (zero? (:exit checked)) "entry suffix whitespace was not canonical" checked))
        (spit west (west-content a-old b-old))

        ;; A locally advanced child must not make canonical --check stale.
        (let [checked (run! fixture nbb "--backend" "sci" "--classpath" root generator "--check")]
          (assert! (zero? (:exit checked))
                   "--check depended on arbitrary child HEAD"
                   checked))
        (let [content (slurp west)]
          (assert! (str/includes? content "    - name: fixture-b\n")
                   "canonical check renamed an existing west project"
                   {:content content})
          (assert! (str/includes? content "      submodules:\n        - path: vendor/example\n")
                   "canonical check dropped an explicit submodule list"
                   {:content content}))

        ;; An explicit --entry remains the sole checkout-backed pin workflow.
        (let [advanced (run! fixture nbb "--backend" "sci" "--classpath" root generator
                             "--entry" "a" "--no-verify-remote")
              content (slurp west)]
          (assert! (zero? (:exit advanced)) "--entry failed" advanced)
          (assert! (= a-new (revision content "a"))
                   "--entry did not take the target checkout HEAD"
                   {:expected a-new :actual (revision content "a")})
          (assert! (= b-old (revision content "fixture-b"))
                   "--entry changed an unrelated pin"
                   {:expected b-old :actual (revision content "fixture-b")}))

        ;; Moving the checkout backwards after the advance must neither regress
        ;; the pin nor create a canonical false stale.
        (git! a "checkout" "--detach" a-old)
        (let [checked (run! fixture nbb "--backend" "sci" "--classpath" root generator "--check")
              content (slurp west)]
          (assert! (zero? (:exit checked))
                   "stale checkout caused false stale after pin advance"
                   checked)
          (assert! (= a-new (revision content "a"))
                   "stale checkout regressed the committed pin"
                   {:expected a-new :actual (revision content "a")}))
        (let [rewritten (run! fixture nbb "--backend" "sci" "--classpath" root generator
                              "--no-verify-remote")
              content (slurp west)]
          (assert! (zero? (:exit rewritten)) "canonical rewrite failed" rewritten)
          (assert! (= a-new (revision content "a"))
                   "canonical rewrite regressed pin to stale child HEAD"
                   {:expected a-new :actual (revision content "a")}))))
    (println "gen-west-manifest tests passed: canonical pins ignore child drift; --entry uses target HEAD")
    (finally
      (.rmSync fs fixture #js {:recursive true :force true}))))
