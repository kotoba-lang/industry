;; fabric actor（`*-organism.aozora.app`）が **外へ出す文字列と終了状態の正本**。
;; ADR-2608155000。`kotoba/pure` プロファイル — capability ゼロ、effect ゼロ。
;;
;; ## なぜ切り出したか
;;
;; この 9 体の actor を動かしているのは 2 本の JVM script で、
;; `scripts/register_fabric_actors.clj`（登録・1 回きり）と
;; `scripts/publish_fabric_actor_status.clj`（週次 pulse、launchd
;; `com.junkawasaki.fabric-actor-cadence`）である。両者は
;;
;;   - product 一覧（9 件）
;;   - handle の作り方（`<product>-organism.aozora.app`）
;;   - Keychain の service 名（`aozora.app/actor-seed/<handle>`）
;;   - 「1 件でも失敗したら exit 1」という規則
;;
;; を **それぞれ独立に書いていた**。同じ判断の 2 実装が別々に直る状態で、
;; CLAUDE.md が名指しする mirror そのものだった（「同じ判断を 2 実装が
;; 別々に持ち片方だけ直る状態にしない」）。参照実装を
;; `scripts/gftd/fabric_actor_core.cljc` に 1 本化し、その算術と文字列の
;; **正本をここに置く**。両者の完全一致は fleet gate
;; `root-fabric-actor-core` が毎回見る。食い違ったら **この kernel が
;; 正しく、cljc 側を直す**（`manifest/org-id.kotoba` と同じ分担）。
;;
;; ## 決定核はどこまでか
;;
;; ここに在るのは「何と名乗るか・何と言うか・何を成功と呼ぶか」だけ。
;; HTTP・Keychain・CACAO の鋳造・receipt の JSON 書き出しは host（.clj）に
;; 残る。決定核は scalar と string で表せる**判断**に限る、という
;; CLAUDE.md の移行単位に従っている（repo 全体を移そうとしない）。
;;
;; ## 欠測を欠測として出す（ADR-2608136000）
;;
;; 移行前の pulse 文は `(str (get-in activity [:runtime :healthy]))` で、
;; **値が無いと空文字**になった。`runtime=/` と出るので「0 台が健全」でも
;; 「測れなかった」でもなく、読み手にはどちらとも判別できない。
;; `count-text` は負値（host が欠測に割り当てる番兵）を `unknown` と綴る。
;; 測れなかったことと測って 0 だったことを、出力で区別する。
;;
;; ## 実測した言語側の制約
;;
;; - **arity 上限 5**（`:abi-bound`、`:intentional-security-constraint`）。
;;   pulse 文は product/status/runtime/ci/dirty でちょうど 5。runtime を
;;   先に `runtime-text` で 1 本の文字列に畳んでいるのはこのため。
;; - **比較は i64 のみ。** `>=` に `:f64` を渡すと
;;   `expression type mismatch: expected i64, got f64` でコンパイルが落ちる
;;   （2026-08-15 実測）。ここに現れる数はすべて件数なので影響しない。
;; - 文字列の等値は `string=?`。`string=` は
;;   `operation has no admitted lowering` になる（同日実測）。
(ns fabric-actor-core
  (:export [handle seed-service display-name description registration-text
            text-or-unknown count-text runtime-text pulse-text exit-code]))

;; --- 名乗り -----------------------------------------------------------------

(defn handle [product :string] :string
  (string-concat product "-organism.aozora.app"))

;; Keychain の service 名。**handle から作る**（product からではない）——
;; 登録側が handle で書き、公開側が handle で読む。間に product を挟むと
;; 「handle を変えたのに seed が見つからない」が起きる経路ができる。
(defn seed-service [h :string] :string
  (string-concat "aozora.app/actor-seed/" h))

(defn display-name [product :string] :string
  (string-concat product " organism"))

(defn description [product :string] :string
  (string-concat (string-concat "Autonomous " product)
                 " actor. Kotoba-policy governed, capability-bound and auditable."))

(defn registration-text [product :string] :string
  (string-concat product
                 (string-concat " organism registered. Kotoba → Kototama WASM → Murakumo"
                                " → Kotobase evidence. Autonomous activity remains bounded and auditable.")))

;; --- 欠測の綴り -------------------------------------------------------------

;; 空文字は「host がその欄を読めなかった」の番兵。空のまま連結すると
;; `fabric=, runtime=` となり、区切りだけが残って欄の不在が消える。
(defn text-or-unknown [s :string] :string
  (if (string=? s "") "unknown" s))

;; 負値は「host がその件数を読めなかった」の番兵。件数に負は無いので
;; 実在の値と衝突しない。0 は `0` と綴る —— 測って 0 だった、である。
(defn count-text [n :i64] :string
  (if (< n 0) "unknown" (string-from-i64 n)))

(defn runtime-text [healthy :i64 total :i64] :string
  (string-concat (count-text healthy)
                 (string-concat "/" (count-text total))))

;; --- 週次 pulse -------------------------------------------------------------

(defn pulse-text [product :string status :string runtime :string ci :string dirty :i64] :string
  (string-concat
   (string-concat product " organism weekly pulse — fabric=")
   (string-concat
    (text-or-unknown status)
    (string-concat
     (string-concat ", runtime=" runtime)
     (string-concat
      (string-concat ", CI=" (text-or-unknown ci))
      (string-concat
       (string-concat ", open checkout WIP=" (count-text dirty))
       ". Evidence: https://murakumo.cloud/health/fabric.json"))))))

;; --- 何を成功と呼ぶか -------------------------------------------------------

;; 1 件でも失敗したら 1。**0 件処理は 0 を返さない** —— 対象が空のまま
;; 走った run は「全部成功した」ではなく「何もしていない」で、それを
;; 成功と綴ると、product 一覧が壊れて空になった日に緑が出る
;; （ADR-2608136000 の evidence floor を終了状態に当てたもの）。
;; 2 = 「答えられなかった」。0 でも 1 でもない値にしてあるのは、
;; 呼び出し側が失敗と区別できるようにするため。
(defn exit-code [attempted :i64 failed :i64] :i64
  (if (< attempted 1) 2 (if (< 0 failed) 1 0)))
