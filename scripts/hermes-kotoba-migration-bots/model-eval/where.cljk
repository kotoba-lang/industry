#!/usr/bin/env nbb
(ns where (:require [cljs.reader :as edn] ["node:fs" :as fs]))
(def d (edn/read-string (.readFileSync fs (first *command-line-args*) "utf8")))
(def rs (:results d))
(def by-task (group-by :task rs))
(println "task                     verdicts(3 reps)        ptok   ctok   total")
(doseq [[t rows] (sort-by key by-task)]
  (let [p (reduce + (map #(get-in % [:usage :prompt] 0) rows))
        c (reduce + (map #(get-in % [:usage :completion] 0) rows))
        vs (clojure.string/join "," (map #(subs (name (:verdict %)) 0 (min 4 (count (name (:verdict %))))) rows))]
    (println (str (subs (str t "                         ") 0 25)
                  (subs (str vs "                        ") 0 24)
                  p "   " c "   " (+ p c)))))
(println)
(def ptot (reduce + (map #(get-in % [:usage :prompt] 0) rs)))
(def ctot (reduce + (map #(get-in % [:usage :completion] 0) rs)))
(println (str "PROMPT tokens  " ptot "  (" (.toFixed (* 100.0 (/ ptot (+ ptot ctot))) 1) "% of all tokens)"))
(println (str "OUTPUT tokens  " ctot "  (" (.toFixed (* 100.0 (/ ctot (+ ptot ctot))) 1) "%)"))
(println)
(def passing #{"time-pad2" "json-starts"})
(def spent-on-pass (reduce + (for [r rs :when (passing (:task r))] (+ (get-in r [:usage :prompt] 0) (get-in r [:usage :completion] 0)))))
(println (str "tokens spent on tasks that ever passed:      " spent-on-pass))
(println (str "tokens spent on tasks that never passed:     " (- (+ ptot ctot) spent-on-pass)
              "  (" (.toFixed (* 100.0 (/ (- (+ ptot ctot) spent-on-pass) (+ ptot ctot))) 1) "%)"))
