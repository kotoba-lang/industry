#!/usr/bin/env kbb
;; Generates shadow-cljs.edn :source-paths from `kbb -Spath`.
;; nbb port of the shared gen-shadow-cljs-edn.bb family (ADR-2607173000 Wave 1).
;;
;;   kbb --backend sci scripts/gen-shadow-cljs-edn.cljk          ; cwd = target repo
;;   kbb --backend sci /path/to/superproject/scripts/gen-shadow-cljs-edn.cljk
(require '[clojure.string :as str]
         '[scripts.nbb-compat :refer [slurp spit sh]])

(def fs (js/require "node:fs"))

(let [r (sh "kbb" "-Spath")
      cp (str/trim (or (:out r) ""))
      dirs (->> (str/split cp #":")
                (remove str/blank?)
                (filter #(.isDirectory (.statSync fs %))))]
  (spit "shadow-cljs.edn"
        (str "{:source-paths " (pr-str (vec (concat ["test"] dirs))) "\n"
             " :builds\n"
             " {:test {:target :node-test\n"
             "         :output-to \"out/test.js\"\n"
             "         :ns-regexp \"-test$\"}}}\n"))
  (println "wrote shadow-cljs.edn with" (count dirs) "source dirs from kbb -Spath"))
