#!/usr/bin/env kbb
;; Second judge for the aiuefs-v4 co-scientist loop: WHICH codec, at which
;; level, for a leaf that is compressed before it is sealed.
;;
;; The first judge (aiuefs-compression-bench.cljs) settled the ORDER and
;; compared brotli q9 against zstd's default level 3 -- not a level-matched
;; comparison, and it measured no time at all. A codec chosen on ratio alone is
;; chosen on half the evidence: the read path pays decompression on every
;; verified block ayatori pulls, and the write path pays compression inside the
;; commit that already has to hash and seal every leaf.
;;
;;   kbb --backend sci scripts/aiuefs-codec-bench.cljk --root . --out <file.edn>
;;
;; Reports ratio AND both throughputs per (codec, level), plus the load average
;; at measurement time -- this workstation runs many agents at once, so a
;; throughput number without the load beside it is not reproducible.

(require '[clojure.string :as str])

(def fs (js/require "node:fs"))
(def path (js/require "node:path"))
(def zlib (js/require "node:zlib"))
(def os (js/require "node:os"))

(def EXIT-COULD-NOT-ANSWER 2)
(def args (vec *command-line-args*))
(defn- arg [flag default]
  (let [i (.indexOf (to-array args) flag)] (if (>= i 0) (nth args (inc i) default) default)))
(def root (arg "--root" "."))
(def out-path (arg "--out" nil))
(def leaf-bytes (js/parseInt (arg "--leaf" "16384")))
(def reps (js/parseInt (arg "--reps" "3")))

(defn- die [code & msg]
  (binding [*out* *err*] (apply println (cons "aiuefs-codec:" msg)))
  (.exit js/process code))

(defn- brotli-opts [q]
  (let [params (js-obj)]
    (aset params (.. zlib -constants -BROTLI_PARAM_QUALITY) q)
    (aset params (.. zlib -constants -BROTLI_PARAM_LGWIN) 22)
    (js-obj "params" params)))

(def candidates
  (concat
   (for [l [1 6 9]]
     {:id (keyword (str "deflate-" l)) :family :deflate :level l
      :c #(.deflateRawSync zlib % (js-obj "level" l))
      :d #(.inflateRawSync zlib %)})
   (for [q [4 5 9 11]]
     {:id (keyword (str "brotli-" q)) :family :brotli :level q
      :c #(.brotliCompressSync zlib % (brotli-opts q))
      :d #(.brotliDecompressSync zlib %)})
   (when (fn? (.-zstdCompressSync zlib))
     (for [l [1 3 9 19]]
       (let [params (js-obj)]
         (aset params (.. zlib -constants -ZSTD_c_compressionLevel) l)
         {:id (keyword (str "zstd-" l)) :family :zstd :level l
          :c #(.zstdCompressSync zlib % (js-obj "params" params))
          :d #(.zstdDecompressSync zlib %)})))))

;; Corpus: the datom plane, because that is the plane whose leaves the query
;; face reads on every scan. Deterministic selection, then split into leaves.
(defn- collect []
  (let [acc (atom [])]
    (letfn [(go [d]
              (doseq [name (sort (js->clj (.readdirSync fs d)))]
                (let [p (.join path d name)
                      st (try (.statSync fs p) (catch :default _ nil))]
                  (cond (nil? st) nil
                        (.isDirectory st) (when-not (contains? #{".git" "node_modules"} name) (go p))
                        (and (.isFile st) (str/ends-with? p ".datoms.edn") (> (.-size st) 4096))
                        (swap! acc conj p)))))]
      (try (go (.join path root "90-docs")) (catch :default _ nil)))
    @acc))

(defn- leaves [files]
  (vec (mapcat (fn [f]
                 (let [b (try (.readFileSync fs f) (catch :default _ nil))]
                   (when b
                     (loop [off 0 out []]
                       (if (>= off (.-length b))
                         out
                         (recur (+ off leaf-bytes)
                                (conj out (.subarray b off (min (.-length b) (+ off leaf-bytes))))))))))
               files)))

(def ^:private perf (js/require "node:perf_hooks"))
(defn- now-ms [] (.now (.-performance perf)))
(defn- elapsed-ms [t0] (- (now-ms) t0))

(defn- best-of
  "Minimum wall time across reps. The minimum is the least contaminated sample
   on a loaded box; the load average is reported beside it either way."
  [n f]
  (reduce min (for [_ (range n)] (let [t0 (now-ms)] (f) (elapsed-ms t0)))))

(defn- mbps [bytes ms] (if (or (nil? ms) (zero? ms)) :UNMEASURED
                           (/ (js/Math.round (* 10 (/ (/ bytes 1048576.0) (/ ms 1000.0)))) 10.0)))

(defn -main []
  (let [files (collect)
        ls (leaves files)
        total (reduce + 0 (map #(.-length %) ls))]
    (println (str "SCANNED\tdatom-catalogs\t" (count files)))
    (println (str "LEAVES\t" (count ls) "\tleaf-bytes\t" leaf-bytes "\tbytes\t" total))
    (when (or (zero? (count files)) (zero? (count ls)))
      (die EXIT-COULD-NOT-ANSWER "no leaves; refusing to report a codec ranking."))
    (when (empty? candidates) (die EXIT-COULD-NOT-ANSWER "no codec candidates available."))
    (let [load1 (first (js->clj (.loadavg os)))
          rows
          (vec (for [{:keys [id family level c d]} candidates]
                 (let [comp (mapv c ls)
                       out (reduce + 0 (map #(.-length %) comp))
                       ;; A codec that does not round-trip is not a candidate.
                       roundtrip? (every? true?
                                          (map (fn [orig z]
                                                 (try (.equals (d z) orig) (catch :default _ false)))
                                               ls comp))
                       ct (best-of reps #(doseq [l ls] (c l)))
                       dt (best-of reps #(doseq [z comp] (d z)))]
                   {:codec id :family family :level level
                    :roundtrip? roundtrip?
                    :ratio (if (zero? total) :UNMEASURED
                               (/ (js/Math.round (* 10000 (/ out total))) 10000.0))
                    :compressed-bytes out
                    :compress-mbps (mbps total ct)
                    :decompress-mbps (mbps total dt)})))
          result {:measurement :aiuefs-v4/codec-choice
                  :measured-at (.toISOString (js/Date.))
                  :node (.-version js/process)
                  :corpus :datom-catalogs
                  :files (count files) :leaves (count ls)
                  :leaf-bytes leaf-bytes :plaintext-bytes total
                  :reps reps
                  :load1-at-measurement load1
                  :rows rows}]
      (when-let [bad (seq (remove :roundtrip? rows))]
        (die EXIT-COULD-NOT-ANSWER
             "these codecs did not round-trip:" (str/join "," (map (comp name :codec) bad))))
      (when out-path
        (.mkdirSync fs (.dirname path out-path) #js {:recursive true})
        (.writeFileSync fs out-path (with-out-str (pr result))))
      (println)
      (println (str/join "\t" ["codec" "ratio" "comp MB/s" "decomp MB/s"]))
      (doseq [r (sort-by :ratio rows)]
        (println (str/join "\t" [(name (:codec r)) (:ratio r) (:compress-mbps r) (:decompress-mbps r)])))
      (println)
      (println (str "load1 at measurement: " load1 " -- throughput without this number is not reproducible")))))

(-main)
