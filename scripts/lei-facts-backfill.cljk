#!/usr/bin/env kbb
;; lei-facts-backfill.cljs — facts.edn をまだ持たない cloud-itonami-lei-* repo に、
;; **正本の生成器**で facts.edn を作って着地させる。
;;
;; ## この script が持たないもの
;;
;; 事実の取得も、GLEIF の読み方も、何を書くかも持たない。それは全部
;; `scripts/lei-verify-facts.cljk`（正本、各 repo に vendored）の仕事で、ここは
;; **「どの repo にまだ無いか」を選んで、正本を呼んで、結果を main に載せる**だけ。
;;
;; 2026-08-25 にこれを分けなかった実害がある: 同じことをする 2 本目の収集器を書き、
;; 既存の facts.edn を 17 repo で別形式に**上書きした**（復元済み）。正本が在るのに
;; 別実装を足すと、片方だけが直る 2 つの真実ができる。だからここは呼ぶだけにする。
;;
;; ## 既に在るものを踏まない
;;
;; local の有無ではなく **GitHub の main を見て**判定する。local checkout は
;; pin より遅れていることがあり、遅れた checkout は「在る」ものを「無い」と測る。
;;
;; ## 測れなかったことを clean と書かない
;;
;; 生成器が 0 以外で終わった repo は着地させず、その exit code を添えて報告する。
;; 1 件も着地しなかった run は exit 2（0 でも 1 でもない）。
;;
;; Run (from the superproject root):
;;   kbb --backend sci scripts/lei-facts-backfill.cljk [--limit N] [--offset N] [--dry-run]
;;                                       [--orgs-root <path>] [--root <superproject>]

(ns lei-facts-backfill
  (:require ["fs" :as fs]
            ["path" :as path]
            ["child_process" :refer [execFileSync execSync]]
            [clojure.string :as str]
            [cljs.reader :as edn]))

(def argv (vec (drop 2 (js->clj (.-argv js/process)))))
(defn- flag [n] (let [i (.indexOf (clj->js argv) n)]
                  (when (and (>= i 0) (< (inc i) (count argv))) (nth argv (inc i)))))
(def dry-run? (boolean (some #{"--dry-run"} argv)))
(def limit (some-> (flag "--limit") js/parseInt))
(def offset (or (some-> (flag "--offset") js/parseInt) 0))
(def orgs-dir (or (flag "--orgs-root") "orgs/cloud-itonami"))
(def root-dir (or (flag "--root") (.cwd js/process)))
(def generator (path/join root-dir "scripts" "lei-verify-facts.cljk"))

(defn- sh [cmd args opts]
  (try {:ok true :out (.toString (execFileSync cmd (clj->js args)
                                               (clj->js (merge {:encoding "utf8"
                                                                :stdio ["ignore" "pipe" "pipe"]}
                                                               opts))))}
       (catch :default e
         {:ok false :code (or (.-status e) 1)
          :out (str (some-> (.-stdout e) .toString) (some-> (.-stderr e) .toString))})))

(defn- gh-json [args input]
  (try
    (let [p (execSync (str "gh api " args (when input " --input -"))
                      (clj->js (cond-> {:encoding "utf8" :maxBuffer (* 20 1024 1024) :stdio "pipe"}
                                 input (assoc :input input))))]
      {:ok true :json (js->clj (js/JSON.parse p) :keywordize-keys true)})
    (catch :default e {:ok false :err (str (some-> (.-stderr e) .toString))})))

(defn- repo-dirs []
  (->> (fs/readdirSync orgs-dir)
       (filter #(str/starts-with? % "cloud-itonami-lei-"))
       (filter #(fs/existsSync (path/join orgs-dir % "blueprint.edn")))
       sort vec))

(defn- has-facts-on-main? [repo]
  (let [r (gh-json (str "\"repos/cloud-itonami/" repo "/contents/facts.edn\"") nil)]
    (if (:ok r) true
        ;; 404 は「無い」。それ以外（403 / network）は「判らない」なので触らない。
        (if (str/includes? (str (:err r)) "Not Found") false :unknown))))

(defn- legal-name [dir]
  (try (:company/legal-name
        (edn/read-string (fs/readFileSync (path/join orgs-dir dir "blueprint.edn") "utf8")))
       (catch :default _ nil)))

(defn- land! [repo body name]
  (let [p (str "repos/cloud-itonami/" repo "/contents/facts.edn")
        payload (js/JSON.stringify
                 (clj->js {:message (str "data(facts): verified GLEIF registry facts for " name
                                         "\n\nGenerated by scripts/lei-verify-facts.cljk (the canonical"
                                         "\ngenerator this repo vendors as scripts/verify-facts.cljs)."
                                         "\nEvery fact carries the URL it was read from and the time it"
                                         "\nwas read; re-running the vendored copy re-fetches them all.")
                           :content (.toString (js/Buffer.from body "utf8") "base64")
                           :branch "main"}))]
    (gh-json (str "-X PUT \"" p "\"") payload)))

(defn- process! [dir]
  (let [repo dir
        fpath (path/join orgs-dir dir "facts.edn")
        on-main (has-facts-on-main? repo)]
    (cond
      (= :unknown on-main) {:repo repo :outcome "unknown-state"}
      on-main              {:repo repo :outcome "already-has"}
      :else
      (let [gen (sh "nbb" [generator "--write"] {:cwd (path/join orgs-dir dir)})]
        (if-not (:ok gen)
          {:repo repo :outcome (str "generator-exit-" (:code gen))
           :detail (str/trim (str/join " " (take-last 3 (str/split-lines (str (:out gen))))))}
          (if-not (fs/existsSync fpath)
            {:repo repo :outcome "generator-wrote-nothing"}
            (let [body (fs/readFileSync fpath "utf8")
                  n (count (re-seq #":fact/id" body))]
              (if dry-run?
                (do (fs/unlinkSync fpath) {:repo repo :outcome "ok" :entities n :dry-run true})
                (let [r (land! repo body (or (legal-name dir) repo))]
                  ;; local は消して remote から取り直す —— 共有 checkout に
                  ;; untracked を残さない（残すと次の ff-merge が拒否される）
                  (fs/unlinkSync fpath)
                  (if (:ok r)
                    {:repo repo :outcome "ok" :entities n}
                    {:repo repo :outcome "land-failed" :detail (:err r)}))))))))))

(defn- run! []
  (let [dirs (cond->> (repo-dirs)
               (pos? offset) (drop offset)
               limit (take limit)
               true vec)]
    (when (empty? dirs)
      (println "no cloud-itonami-lei-* repo matched -- refusing to report a pass")
      (.exit js/process 2))
    (println (str "SCANNED\t" (count dirs) (when dry-run? "  (dry-run)")))
    (let [rs (mapv (fn [d]
                     (let [r (process! d)]
                       (println (str (case (:outcome r)
                                       "ok" "OK      "
                                       "already-has" "SKIP    "
                                       "SKIP/ERR")
                                     " " (:repo r) "  " (:outcome r)
                                     (when (:entities r) (str "  entities=" (:entities r)))
                                     (when (:detail r) (str "  " (:detail r)))))
                       r))
                   dirs)
          by (frequencies (map :outcome rs))]
      (println (str "=== " (str/join " " (map (fn [[k v]] (str k "=" v)) (sort-by key by)))))
      (when (zero? (get by "ok" 0))
        (println "nothing was generated -- refusing to report a pass")
        (.exit js/process 2)))))

(run!)
