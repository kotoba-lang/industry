#!/usr/bin/env kbb
;; plane-coscientist.cljs — クエリ面の速さを Co-Scientist ループで詰める。
;;
;; Generate -> Reflect -> Rank -> Evolve -> Meta。原典は
;; `90-docs/design-quality/coscientist.cljk`（さらに遡ると
;; `orgs/gftdcojp/network-isekai` の ADR-0007、engine は ADR-2606141500）。
;;
;; ## この loop の判定は LLM ではない
;;
;; design-quality 版が「判定は決定論的な audit であって LLM の討論ではない」と
;; 書いたのと同じ理由で、ここも **実測した壁時計**で順位を付ける。速さの議論は
;; 意見が入りやすいので、意見を入れない。
;;
;; ## 正しさの門が順位より先に来る
;;
;; **答えが baseline と一致しない戦略は、速くても順位表に載せない。** 速さのために
;; 答えを変えるのは最適化ではなく別の質問への回答で、この loop が最も作りやすい
;; 嘘がそれ（「dataset を名指したから shard だけ読めばいい」は、名指していない
;; entity を解が含みうるとき偽になる）。だから各戦略はまず baseline と
;; **1 文字単位で同じ出力**を出すことを求められ、落ちたら :rejected として残す。
;;
;; ## この harness の出力は、この harness の入力でもある
;;
;; 2026-08-25 の 2 反復目で実際に踏んだ: 1 反復目が ledger を `90-docs/` に書き、
;; そこは面の入力なので **キャッシュが stale になり**、次の反復では baseline
;; （面を読む戦略）が exit 4 で何も返さず、view 系だけが答えて「baseline と違う」
;; として全部 :rejected になった。loop は 0 件として exit 2 で止まった —— 正しい
;; 振る舞いだが、原因は測定対象ではなく測定行為の方にあった。
;;
;; だから **測る前にキャッシュの鮮度を確かめ、stale なら測らずに止まる**。
;; ledger を面の外に逃がす手もあるが、それは ledger が git に載らないか、
;; 「面が読まないディレクトリ」という暗黙の約束に依存する。前者は履歴を失い、
;; 後者は次に誰かが loader を足した瞬間に黙って壊れる。**毎反復 refresh する**
;; 方が高いが、嘘をつかない。
;;
;; ## 測るときの作法
;;
;; - 各戦略 × 各問い を N 回まわして **中央値**を採る（この機械は並行 agent が
;;   多く load が 10〜170 まで振れる）。
;; - 測ったときの load average を値の隣に書く。単独の ms を引用させない。
;; - 1 問も答えられなかった run は exit 2（0 でも 1 でもない）。
;;
;; Run:
;;   kbb --backend sci scripts/plane-coscientist.cljk [--trials N] [--out <file.edn>]

(ns plane-coscientist
  (:require ["child_process" :as cp]
            ["fs" :as fs]
            ["os" :as os]
            [clojure.string :as str]
            [cljs.reader :as edn]))

(def argv (vec (drop 2 (js->clj (.-argv js/process)))))
(defn- flag [n] (let [i (.indexOf (clj->js argv) n)]
                  (when (and (>= i 0) (< (inc i) (count argv))) (nth argv (inc i)))))
(def trials (or (some-> (flag "--trials") js/parseInt) 3))
(def out-file (or (flag "--out") "90-docs/query-efficiency/coscientist/latest.edn"))
(def root (str/trim (.toString (.execSync cp "git rev-parse --show-toplevel"))))

(def plane-script
  "面のスクリプト。まだ着地していない版を測れるように差し替え可能にする
   （query-dialect-bench が --plane-script でやっているのと同じ）。"
  (or (flag "--plane-script") "manifest/edn-query.cljk"))

;; ---------------------------------------------------------------- 問い
;;
;; 面の形をなるべく違う角度から突く 4 問。**答えが安定していること**が条件で、
;; 探索的な問いはここに置かない（正しさの門が働かなくなる）。

(def questions
  [{:id :lei-isin
    :why "2 dataset の join。dataset が両方リテラルなので shard が効くはず"
    :q "[:find ?name ?juris ?isin :where [?f \"source/dataset\" \"cloud-itonami-lei-facts\"] [?f \"company/lei\" ?lei] [?f \"securities/isin\" ?isin] [?b \"source/dataset\" \"cloud-itonami-lei\"] [?b \"company/lei\" ?lei] [?b \"company/legal-name\" ?name] [?b \"company/jurisdiction\" ?juris]]"
    :view "lei-isin"}
   {:id :lei-jurisdiction
    :why "1 dataset の集計"
    :q "[:find ?juris (count ?e) :where [?e \"source/dataset\" \"cloud-itonami-lei\"] [?e \"company/jurisdiction\" ?juris]]"
    :view "lei-by-jurisdiction"}
   {:id :facts-count
    :why "1 dataset を数えるだけ。shard の下限に近い"
    :q "[:find (count ?e) :where [?e \"source/dataset\" \"cloud-itonami-lei-facts\"]]"}
   {:id :adr-status
    :why "dataset を名指さない。**shard に落ちてはいけない**問い（負の対照）"
    :q "[:find ?status (count ?e) :where [?e \"adr/status\" ?status]]"
    :view "adr-status-counts"}])

;; ---------------------------------------------------------------- 実行

(defn- run!
  ([args] (run! args nil))
  ([args extra-env]
   (let [t (js/Date.now)
         env (js/Object.assign #js {} (.-env js/process) (clj->js (or extra-env {})))
         r (.spawnSync cp "nbb" (clj->js (concat ["--classpath" ".:scripts/nbb_compat"] args))
                       (clj->js {:cwd root :encoding "utf8"
                                 :maxBuffer (* 128 1024 1024)
                                 :timeout (* 10 60 1000)
                                 :env env}))]
     {:ms (- (js/Date.now) t)
      :exit (or (.-status r) 1)
      :out (str/trim (str (.-stdout r)))
      :err (str (.-stderr r))})))

(defn- load1 [] (first (js->clj (.loadavg os))))

;; ---------------------------------------------------------------- Generate
;;
;; 仮説はコードに書く（LLM に出させない）。それぞれ「何を減らすか」が違う。

(def hypotheses
  [{:id :full-cache
    :claim "キャッシュ済みの面をまるごと読む。これが baseline"
    :reduces :nothing
    :run (fn [{:keys [q]}] (run! [plane-script "q" q] {:EDN_QUERY_NO_SHARD "1"}))}
   {:id :shard
    :claim "クエリが触りうる dataset を静的に決められるなら、その shard だけ読む"
    :reduces "読む bytes（282 MB のうち触る dataset ぶんだけ）"
    :run (fn [{:keys [q]}] (run! [plane-script "q" q]))}
   {:id :view
    :claim "答えを事前に計算しておき、面を組まずに読むだけにする"
    :reduces "面のロードそのもの（ただし問いを先に知っている必要がある）"
    :run (fn [{:keys [view]}] (when view (run! [plane-script "view" view])))}
   {:id :view-min
    :claim "同じ view を、面の実装を読み込まない最小スクリプトで読む"
    :reduces "edn-query.cljs 約 3,000 行の nbb コンパイル（実測 288ms の起動に対し
              +300ms）。29 KB の EDN を読むのに datascript も 40 の loader も要らない"
    :run (fn [{:keys [view]}] (when view (run! ["scripts/plane-view.cljk" view])))}])

;; :full-cache と :shard は同じコマンドで、違いは面の側の判定。
;; **測り分けるために環境変数で shard を殺せるようにする** —— そうしないと
;; 「baseline を測った」と言いながら shard 経路を測ることになる。
(defn- run-hyp [h qn]
  (case (:id h)
    :full-cache (let [r ((:run h) qn)] r)
    :shard (let [r ((:run h) qn)] r)
    ((:run h) qn)))

(defn- median [xs]
  (let [v (vec (sort xs))] (when (seq v) (nth v (quot (count v) 2)))))

(defn- measure [h qn]
  (let [runs (remove nil? (for [_ (range trials)] (run-hyp h qn)))]
    (when (seq runs)
      {:ms (median (map :ms runs))
       :ms-all (mapv :ms runs)
       :exit (:exit (first runs))
       :out (:out (first runs))
       :shard-line (some (fn [r] (first (filter #(str/includes? % "shard(s) in")
                                                (str/split-lines (:err r)))))
                         runs)})))

(defn- cache-fresh? []
  (let [r (run! [plane-script "q" "[:find (count ?e) :where [?e \"adr/id\" ?v]]"]
                {:EDN_QUERY_NO_SHARD "1"})]
    {:fresh? (zero? (:exit r)) :exit (:exit r)
     :why (first (str/split-lines (:err r)))}))

(defn -main []
  (let [{:keys [fresh? exit why]} (cache-fresh?)
        _ (when-not fresh?
            (println (str "SCANNED\t0"))
            (println (str "plane cache is not answering (exit " exit "): " why))
            (println "  refusing to measure -- a baseline that cannot run makes every")
            (println "  other strategy look like it disagrees with it. Refresh first:")
            (println "    kbb --backend sci --classpath \".:scripts/nbb_compat\" manifest/edn-query.cljk refresh")
            (.exit js/process 2))
        load-start (load1)
        baseline-id :full-cache
        results
        (doall
         (for [qn questions]
           (let [per (into {} (keep (fn [h]
                                      (when-let [m (measure h qn)]
                                        [(:id h) m]))
                                    hypotheses))
                 base (get per baseline-id)
                 ;; 正しさの門: baseline と出力が一致しないものは順位に載せない
                 judged (into {} (map (fn [[k m]]
                                        [k (assoc m :same-answer?
                                                  (= (:out m) (:out base)))])
                                      per))]
             {:question (:id qn)
              :why (:why qn)
              :baseline-ms (:ms base)
              :strategies judged})))
        load-end (load1)
        ranked (for [{:keys [question strategies baseline-ms]} results]
                 [question
                  (->> strategies
                       (filter (fn [[_ m]] (and (:same-answer? m) (zero? (:exit m)))))
                       (sort-by (fn [[_ m]] (:ms m)))
                       (mapv (fn [[k m]] [k (:ms m)
                                          (when (and baseline-ms (pos? (:ms m)))
                                            (js/Math.round (* 10 (/ baseline-ms (:ms m)))))])))])
        rejected (for [{:keys [question strategies]} results
                       [k m] strategies
                       :when (not (:same-answer? m))]
                   [question k (:exit m)])
        answered (count (remove (fn [[_ r]] (empty? r)) ranked))]
    (println (str "SCANNED\t" (count questions)))
    (println (str "load-at-start=" load-start " load-at-end=" load-end
                  " trials=" trials))
    (doseq [[q rows] ranked]
      (println (str "  " q))
      (doseq [[k ms speedup] rows]
        (println (str "    " (name k) " " ms "ms"
                      (when speedup (str "  x" (/ speedup 10.0)))))))
    (when (seq rejected)
      (println "  REJECTED (answer differed from the baseline):")
      (doseq [[q k e] rejected] (println (str "    " q " " (name k) " exit=" e))))
    (let [dir (str root "/" (str/replace out-file #"/[^/]+$" ""))]
      (.mkdirSync fs dir (clj->js {:recursive true}))
      (.writeFileSync fs (str root "/" out-file)
                      (pr-str {:measured-at (.toISOString (js/Date.))
                               :load {:start load-start :end load-end}
                               :trials trials
                               :hypotheses (mapv #(dissoc % :run) hypotheses)
                               :results results
                               :ranked (vec ranked)
                               :rejected (vec rejected)})))
    (println (str "wrote " out-file))
    (when (zero? answered)
      (println "no question was answered by any strategy -- refusing to report a pass")
      (.exit js/process 2))))

(-main)
