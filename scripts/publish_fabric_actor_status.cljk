#!/usr/bin/env kbb
;; publish_fabric_actor_status.cljs — 週次 fabric actor pulse
;; （launchd com.junkawasaki.fabric-actor-cadence）。
;;
;; 2026-08-30 に JVM (.clj) から nbb (.cljs) へ refactor。JVM 版は
;; java.net.http + clojure.data.json + io.github.kotoba-lang/cacao で動いて
;; いたが、`clojure` の起動自体が superproject root の deps.edn（workspace
;; メタデータで Clojure マニフェスト **ではない**）を読みにいって落ちていた
;; （/tmp/fabric-actor-cadence.err 実測、2026-08-10 以降週次で 1 行も走らず終了）。
;; nbb は deps.edn を読まないので、この障害クラスごと消える。CACAO 鋳造は
;; aozora bots（scripts/hermes-bots-aozora/pulse.cljk）と同じ cljs 実装
;; （cacao.core）に寄せた。
;;
;; pulse 文・handle・Keychain service 名・終了状態は **この script が持たない**
;; —— 正本は `scripts/kotoba/fabric_actor_core.kotoba`、参照実装は
;; `gftd.fabric-actor-core`（ADR-2608155000）。ここに残るのは HTTP・Keychain
;; 読み出し・CACAO 鋳造・receipt の JSON 書き出しという effect だけ。
;;
;; 実行（launcher scripts/publish-fabric-actor-status と同じ classpath）:
;;   kbb --backend sci --classpath "scripts:orgs/kotoba-lang/org-chainagnostic-cacao/src:orgs/kotoba-lang/authority/src:orgs/kotoba-lang/org-ietf-ed25519/src:orgs/kotoba-lang/org-ietf-cbor/src" \
;;     scripts/publish_fabric_actor_status.cljk
(ns publish-fabric-actor-status
  (:require [clojure.string :as str]
            [cacao.core :as cacao]
            [gftd.fabric-actor-core :as core]
            ["node:child_process" :as cp]
            ["node:fs" :as fs]
            ["node:path" :as path]))

(def root (or (aget (.-env js/process) "FABRIC_ROOT") "."))
(def receipt-path (path/join root "80-data/system/artificial-organism-actor-cadence.json"))
(def user (or (aget (.-env js/process) "USER") "fabric-operator"))

(defn- now-iso [] (.toISOString (js/Date.)))

(defn actor-seed [handle]
  (let [r (cp/spawnSync "security"
                        (clj->js ["find-generic-password" "-a" user
                                  "-s" (core/seed-service handle) "-w"])
                        #js {:encoding "utf8"})]
    (when-not (zero? (.-status r))
      (throw (ex-info "actor seed absent from Keychain" {:handle handle})))
    (js/Uint8Array.from (js/Buffer.from (str/trim (.-stdout r)) "base64"))))

(defn session-cacao [seed]
  (let [now (js/Date.)]
    (:cacao-b64
     (cacao/mint {:seed seed :aud "did:web:pds.aozora.app"
                  :iat (now-iso)
                  :exp (.toISOString (js/Date. (+ (.getTime now) 300000)))
                  :nonce (str (random-uuid)) :domain "pds.aozora.app"
                  :resources ["atproto://account/session"]}))))

(defn post! [nsid body token]
  (-> (js/fetch (str core/pds "/xrpc/" nsid)
                (clj->js {:method "POST"
                          :headers (cond-> {"content-type" "application/json"}
                                     token (assoc "authorization" (str "Bearer " token)))
                          :body (js/JSON.stringify (clj->js body))}))
      (.then (fn [resp]
               (.then (.text resp)
                      (fn [text]
                        (let [value (try (js->clj (js/JSON.parse text) :keywordize-keys true)
                                         (catch :default _ {}))]
                          (when (or (>= (.-status resp) 400) (:error value))
                            (throw (ex-info (str nsid " rejected")
                                            {:status (.-status resp)
                                             :error (:error value)
                                             :message (:message value)})))
                          value)))))))

(defn publish! [product health]
  (let [handle (core/handle product)]
    (-> (post! "com.atproto.server.createSession"
               {:cacao (session-cacao (actor-seed handle))} nil)
        (.then (fn [session]
                 (-> (post! "com.atproto.repo.createRecord"
                            {:repo (:did session) :collection "app.bsky.feed.post"
                             :record {:$type "app.bsky.feed.post"
                                      :text (core/pulse-for product health)
                                      :createdAt (now-iso)}}
                            (:accessJwt session))
                     (.then (fn [result]
                              {:product product :handle handle :did (:did session)
                               :uri (:uri result) :cid (:cid result)}))))))))

(defn read-health!
  "murakumo /health/fabric.json。**取れなくても落ちない** —— kernel の番兵設計
   （欠測 → \"unknown\"）と aozora bots の BLOCKED-not-crash 原則に合わせ、nil を
   返して全 product を \"fabric=unknown\" で pulse させる。feed が死んでいる日に
   actor が沈黙するより、正直な「測れなかった」を出す方がこの pulse の目的に合う。
   （実測 2026-08-30: feed は 404 — ADR-2608137200 の既知 defect。旧 JVM 版は
   ここで例外死していた。）"
  []
  (-> (js/fetch "https://murakumo.cloud/health/fabric.json")
      (.then (fn [resp] (.text resp)))
      (.then (fn [text] (js->clj (js/JSON.parse text) :keywordize-keys true)))
      (.catch (fn [_e] nil))))

(defn -main [& _]
  (-> (read-health!)
      (.then (fn [health]
               (-> (reduce (fn [p product]
                             (.then p (fn [acc]
                                        (.then (.catch (publish! product health)
                                                       (fn [e] {:product product
                                                                :error (or (:error (ex-data e)) (.-message e))
                                                                :message (:message (ex-data e))}))
                                               #(conj acc %)))))
                           (js/Promise.resolve []) core/products)
                   (.then (fn [results]
                            (let [receipt {:schema 1 :publishedAt (now-iso)
                                           :health (if health "ok" "unavailable")
                                           :results results}
                                  ;; 0 件 = exit 2。product 一覧が空になった週に
                                  ;; 「全部成功」で緑を出さない。
                                  code (core/exit-code (count results)
                                                       (count (filter :error results)))]
                              (fs/mkdirSync (path/dirname receipt-path) #js {:recursive true})
                              (fs/writeFileSync receipt-path
                                                (str (js/JSON.stringify (clj->js receipt) nil 2) "\n"))
                              (println (js/JSON.stringify (clj->js receipt)))
                              (.exit js/process code)))))))
      (.catch (fn [e]
                (binding [*out* *err*]
                  (println (str "publish-fabric-actor-status: " (.-message e))))
                (.exit js/process 1)))))

;; script 実行のときだけ走る（require では走らない — テストで誤発火させない）。
(when (some #(or (str/ends-with? (str %) "publish_fabric_actor_status.cljk") (str/ends-with? (str %) "publish_fabric_actor_status.cljs"))
            (js->clj js/process.argv))
  (-main))
