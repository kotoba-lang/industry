<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gftd.capacity-alarm</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "$HOME/github/com-junkawasaki" &amp;&amp; exec /opt/homebrew/bin/nbb --classpath scripts/fleet-ci scripts/fleet-ci/capacity-alarm.cljs</string>
  </array>
  <!-- Hourly. The incident went from workable to zero inside a day, and the
       floor (20GiB) is chosen to leave room to act rather than to be a last
       warning, so checking often costs one `df` and buys the difference
       between "clean something up" and "writes are already failing". -->
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/junkawasaki/.itonami/capacity-alarm.log</string>
  <key>StandardErrorPath</key><string>/Users/junkawasaki/.itonami/capacity-alarm.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
