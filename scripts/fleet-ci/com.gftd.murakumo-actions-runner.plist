<?xml version="1.0" encoding="UTF-8"?>
<!--
  murakumo.cloud/actions の fleet runner を常駐させる。

  なぜ要るか（実測 2026-08-05）: control plane（Worker `murakumo-cloud`）は
  deploy 済み・D1 bound・GitHub webhook が 202 で配送成功していて、job は
  **2026-08-04T10:01Z から溜まり続けていた**。欠けていたのは
  `scripts/actions-runner.mjs` を回すプロセスだけだった。手で 1 回走らせたら
  hermetic job を claim → sha で clone → 実テスト実行 → complete まで通った。

  token は plist に書かない（plist は world-readable）。ADR-2607178000 §3 が
  認めた launchd 経路と同じく mode 600 のファイルから読ませる。
  正本は kagi `MURAKUMO_ACTIONS_RUNNER_TOKEN`（compartment gftdcojp、2026-09-05 登録。
  値の一致確認は shasum 比較。ローカル file と Worker secret も同じ値で一致済み）。

  導入:
    cp scripts/fleet-ci/com.gftd.murakumo-actions-runner.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gftd.murakumo-actions-runner.plist
    launchctl kickstart -p gui/$(id -u)/com.gftd.murakumo-actions-runner

  ⚠ この runner は **claim した job を実行する** = repo を clone して
  allowlist されたコマンドを回す。allowlist は runner 側（actions-runner.mjs の
  actionCatalog）にあり、control plane の応答では注入できない。

  path について（2026-08-13、ADR-2608138600）: ここは
  `orgs/network-awai/cloud-murakumo` = **west が宣言している path**。
  2026-08-05〜2026-08-13 は `orgs/gftdcojp/cloud-murakumo` を指していたが、
  あれは west 未登録の shadow（同じ repository id 1285031835 の重複 checkout）で、
  撤去されれば runner が止まる。両 slug は `gh api repos/<slug>` で同じ id を返す
  ——**rename ledger ではなく id で確かめること**。
  runner 自身は cwd に依存しない（`node:` 組み込みのみを import し、
  actionCatalog の `cwd` は clone 先の temp dir 相対）。WorkingDirectory は
  「撤去されない path を指す」という意味しか持たない。
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gftd.murakumo-actions-runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <!-- token はファイルから読んで env に入れる。argv には載せない（ps 露出）。 -->
    <string>export MURAKUMO_ACTIONS_RUNNER_TOKEN="$(cat $HOME/.gftd/murakumo-actions-runner-token)"; export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin; exec node /Users/junkawasaki/github/com-junkawasaki/orgs/network-awai/cloud-murakumo/scripts/actions-runner.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/junkawasaki/github/com-junkawasaki/orgs/network-awai/cloud-murakumo</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- 5 秒間隔だと空 queue でも control plane を叩き続ける。30 秒で十分。 -->
    <key>MURAKUMO_ACTIONS_POLL_MS</key><string>30000</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/junkawasaki/.gftd/murakumo-actions-runner.log</string>
  <key>StandardErrorPath</key><string>/Users/junkawasaki/.gftd/murakumo-actions-runner.log</string>
</dict>
</plist>
