  ;; kotoba-lang/shell の in-app provider bridge。scaffold された .ipa/.apk が
  ;; 自前で持つ provider 実装（Swift / Java）と、Clojure 側の宣言
  ;; `bridge-provider-commands` の3者が一致していることを検査する。
  ;;
  ;; 片側だけ足す/消すと silent に壊れる: 宣言にあって実装が無い command は
  ;; その platform でだけ `unknown-command` になり（policy 上は許可されている
  ;; ので「許可されているのに動かない」）、実装があって宣言に無い command は
  ;; policy asset の capabilities に載らず capability 単位の allow が効かなく
  ;; なる。どちらもコードを読む限り自然に見える変更なので機械で押さえる。
  ;;
  ;; この repo の GitHub Actions（ci.yml）は 2026-08-04 を最後に無効化されて
  ;; おり、それ以降の commit は gate を通っていない。実 xcodebuild/gradle と
  ;; 実機起動までは fleet ノードに Xcode/Android SDK が要るのでまだ移せて
  ;; いない —— ここが埋めているのは「両 native 半分の対称性」だけで、ビルドの
  ;; 再現ではない。
  ;;
  ;; 落ちることを実測済み（2026-08-07）: Java 側の `case "notify/show"` を1つ
  ;; 潰したコピーで exit 1 + 差分の名指し、空 tree でも exit 1（絞り込みミスを
  ;; 「0対0で一致」と報告しない）、無改変で exit 0。
  {:name "shell" :id "shell-native-bridge-parity" :gate :nbb-script
   :script "gates/shell-native-bridge-parity.cljs"
   :include-ext [".clj" ".swift" ".java"] :min-files 5 :cd true}

  ;; kotobase-peer の Merkle block size class が、client 封緘の padding bucket に
  ;; 実際に載るかを検査する（ADR-2608070400 D6）。
  ;;
  ;; 2 つの定数は別 repo・別 owner が別の理由で決めている: size class は sync 粒度
  ;; （kotobase-peer）、bucket は長さ秘匿（kotoba-lang/pqh の ISO/IEC 7816-4）。
  ;; **両者の整合を見るものが無かった。** 実測 2026-08-07 で 4 class すべてが
  ;; 病的だった —— class が 2 冪の上にちょうど乗ると、pick-bucket が要求する
  ;; len+1+16 が 17 バイト超過して次の bucket へ落ちる:
  ;;   16384 -> 65536 (+300%) / 32768 -> 65536 (+100%) / 65536, 131072 -> bucket 無し
  ;; 両 repo を直して（pqh 86c453f = 階段を 7 段へ、kotobase-peer 587e3f9 =
  ;; class を 17 下げる）今は 0.0-0.1%。
  ;;
  ;; **bucket 階段を :script-args に置くのは意図的。** 正本は pqh 側だが、この
  ;; gate は kotobase-peer の tree に対して走るので別 repo の定数を tree から
  ;; 読めない。script に埋めると pqh が動いたときに誰も気づかないので、値を
  ;; review 対象として gates.edn に置く（pqh 側の変更が diff に出る）。
  ;;
  ;; 落ちることを実測済み（2026-08-07）: 修正前の実 tree で exit 1（4/4 を名指し）、
  ;; bucket 直下に揃えた tree で exit 0、size-classes 定数が読めない tree で
  ;; exit 1（読めなかったことを pass にしない）。
  {:name "kotobase-peer" :id "kotobase-peer-block-sizing-pad" :gate :nbb-script
   :script "gates/block-sizing-pad-alignment-check.cljs"
   :script-args ["--buckets" "1024,4096,16384,32768,65536,131072,262144"
                 "--max-overhead" "25"]
   :include-ext [".cljc"] :min-files 20 :cd false}

  ;; ------------------------------------------------- datalake format libraries
  ;; ADR-2608054000 P4 が開いたまま 6 日間、この 6 repo には CI が無かった。
  ;; GitHub Actions は方針で無効（ADR-2607300900）、fleet gate には未登録 —
  ;; つまり「止まっている」のではなく**誰も問いを立てていなかった**。その間に
  ;; main へ入った 11 merge（GROUP BY / evolve / Parquet writer / snapshot /
  ;; compaction / N-Triples ほか）は自動検査を一度も受けていない。
  ;;
  ;; ADR が保留した理由は「`clojure -M:test` が要求する maven 上の Clojure core が
  ;; ノードで解決するか未確認」だった。**2026-08-11 に実測して解消した** —
  ;; 6 repo すべてを実ノードへ配って走らせ、210 tests / 735 assertions が green:
  ;;   columnar 36/115 ・ org-apache-parquet 34/163 ・ org-apache-arrow 40/130
  ;;   org-apache-avro 14/32 ・ kotobase-lake 76/257 ・ org-ietf-csv 10/38
  ;;
  ;; 同時に、この登録が依存する前提を 2 つ実測した（定数で持たない — CLAUDE.md）:
  ;;
  ;; 1. **`:jvm` cap は正しい。** raw な ssh では `java` が PATH に無く
  ;;    `/usr/libexec/java_home` も NONE を返すので「JVM が無い」と読めるが、
  ;;    JDK は keg-only の `/opt/homebrew/opt/openjdk`（openjdk 26.0.1）に在り、
  ;;    tick.cljs:543 が `JAVA_HOME` をそこへ export している。**gate 環境と
  ;;    ssh 環境は別物**で、ssh で測ると capability 宣言を誤って疑う。
  ;;
  ;; 2. **zebulun は外向き HTTPS を全て失っている**（github / maven / npm とも
  ;;    curl が接続不能。他 9 ノードは 3 つとも 200）。git 依存を持つ repo は
  ;;    zebulun では classpath を組めない — 実測で org-apache-parquet が
  ;;    `Failed to connect to github.com port 443` で落ちた。zebulun の
  ;;    `:caps` は `#{}` なのでスケジューラは jvm 仕事を送らず、ここは安全。
  ;;    **ただし zebulun は receipts 上、歴史的に jvm-test gate を回していた
  ;;    ノードである**（test-kagami-murakumo-zebulun ほか）。egress 前提の
  ;;    gate をこのノードに戻すなら先に疎通を直すこと。
  ;;    fleet-ci README の「ノードは tailnet だけで外向き HTTPS が無い」は
  ;;    **今は zebulun にだけ当たる**。全ノードの性質として引用しない。
  ;;
  ;; 落ちることの確認について: `:jvm-test` の gate 本体は各 repo の test suite
  ;; なので、赤くする細工を gates.edn 側に持たない。上記 6 本はいずれも失敗を
  ;; 報告する runner（cognitect test-runner、exit 非 0）で走ることを実測済み。
  ;; columnar / org-ietf-csv: flipped to :nbb-test on measured parity — see the
  ;; admission note at the head of :repos. columnar needed its runner fixed
  ;; first (5e165f0); org-ietf-csv's already covered its whole suite.
  {:name "columnar" :gate :nbb-test :classpath "src:test" :entry "test/run.cljs" :cd true}
  {:name "org-apache-parquet" :gate :jvm-test :cd true}
  {:name "org-apache-arrow" :gate :jvm-test :cd true}
  {:name "org-apache-avro" :gate :jvm-test :cd true}
  {:name "org-ietf-csv" :gate :nbb-test :classpath "src:test" :entry "test/run.cljs" :cd true}
  {:name "kotobase-lake" :gate :jvm-test :cd true}

  ;; ── 委譲した decision core を ClojureScript で実行する gate ──────────────
  ;;
  ;; ADR-2608122000。`.kotoba` core を委譲した repo は shipped artifact を
  ;; `kotoba.kir` で実行するが、host↔guest の非対称が 3 つあり、**どれも JVM
  ;; suite が緑のまま cljs でだけ落ちる**。2026-08-12 に 4 repo が実際に壊れて
  ;; いた（うち 2 つは「production で core を実行している」と記録されていた）。
  ;;
  ;; 各 repo は修正と一緒に cljs gate を持ったが、**それは人が思い出して打つ
  ;; コマンドでしかなかった**。走っていない検査は緑でも赤でもない、というのが
  ;; その ADR の主題なので、ここに載せるまで仕事は終わっていない。
  ;;
  ;; gate 本体は repo 自身のもの。`gates/kotoba-oracle-cljs.cljs` が足すのは
  ;; classpath（repo の deps.edn が pin する interpreter を使う）と**床**だけ:
  ;; exit 0 に加えて「N cases 走った」という申告を要求し、N < :min なら落とす。
  ;; exit 0 単独は証拠にならない —— artifact の load に失敗した gate も、case 表が
  ;; 空になった gate も、0 で抜ける。
  ;;
  ;; 落ちることを確認済み（2026-08-12、手元で実測。`--nbb` は npx がこの
  ;; laptop で壊れているための検証用 escape で、ノードでは pin を解決する）:
  ;;   - seam の i64 変換を外す → repo の gate が 6 case で throw、exit 1
  ;;   - `--min 300`（実測 220）→ 「floor is 300」で fail
  ;;   - count 行を出さない entry（calendar の現行 gate）→ pass を拒否
  ;; 無改変では 220 cases / 0 failures で OK。
  ;;
  ;; **com-cloudflare にはこれが最初の fleet gate である**（jvm-test の entry も
  ;; まだ無い）。この gate は cljs 面しか見ないので `:cd false` —— repo 全体の
  ;; suite ではないものを根拠に pin を進めない。
  ;;
  ;; 他の委譲済み repo（calendar / cloud-itonami-app / shitsuke / kura /
  ;; erasure）は、それぞれの entry が case 数を申告するようになってから足す。
  ;; 上の 3 つ目の実測がそのまま「calendar は何が足りないか」の答えになっている。
  ;; :ship-git-deps true — gate script が repo の deps.edn から classpath を
  ;; 組むので、その実体が要る（ADR-2608132000）。無かったので 2 run とも
  ;; `unresolved git deps (not in ~/.gitlibs and no sibling checkout):
  ;; kotoba-kir, abi, compiler — ship-git-deps! should have placed these` で
  ;; 落ちていた —— **受領がそのまま処置を名指ししていた**。
  ;;
  ;; amu-native-conformance と症状は似ているが**原因は別**（実測 2026-08-13）:
  ;; こちらの 3 依存はノードに **ABSENT**（simeon/levi/joseph/benjamin は 3 件とも、
  ;; judah は abi のみ在って archive 形）で、この gate script は `dep-dir` が
  ;; dir の存在しか見ないので archive 形でも通る。つまり**こちらはこの 1 行で足りる**。
  ;; :cap :jvm — **cljs の gate なのに JVM ノードを要求する。** この repo の
  ;; `nbb.edn` が `:deps` を宣言しているので、nbb が deps.clj 経由で解決を試み、
  ;; そこだけに JDK が要る（oracle 自体は最初から最後まで nbb で走る）。
  ;; gate script が PATH に JDK を足すが、**そもそも JDK が入っていないノード**
  ;; （naphtali / issachar / dan）に置かれたら足すものが無い。
  {:id "com-cloudflare-oracle-cljs"
   :name "com-cloudflare" :gate :nbb-script :cap :jvm
   :script "gates/kotoba-oracle-cljs.cljs" :ship-git-deps true
   :script-args ["--entry" "test/cloudflare/oracle_cljs_gate.cljs" "--min" "200"]
   :include-ext [".cljs" ".cljc" ".clj" ".edn"] :min-files 30 :cd false}

  ;; ── credential 経路の回帰 guard を実際に走らせる ────────────────────────
  ;;
  ;; ADR-2608122600 の sweep で最悪だった site は kotoba-lang/app-yorishiro で、
  ;; `provider/{nuro,japanpost-enaiyo}/runner.ts` が `VAULT_URL ?? "http://vault:8200"`
  ;; を既定に持ち、`X-Vault-Token` を **cleartext で誰も所有していない single-label
  ;; ホスト**へ送り、その応答を無検査で銀行口座にして flow.ts が submit していた。
  ;; merge 3d161b144ae7 が直し、34 本のテストを足した —— うち 10 本は runner の
  ;; source を直接読む guard で、**再発を止めているのはその 10 本**。
  ;;
  ;; **が、それを走らせるものが 1 つも無かった。** この repo には gates.edn の
  ;; entry も GitHub Actions も無く、guard は書かれた瞬間から誰にも読まれて
  ;; いなかった。ADR-2608122000 と同じ形 —— 走っていない検査は緑でも赤でもない。
  ;;
  ;; gate 本体は repo 自身の vitest suite。`gates/yorishiro-provider-vault-check.cljs`
  ;; が足すのは床だけで、検査ロジックは複製しない:
  ;;   ① 8 個の必須 path が届いているか（:include-ext が壊れて provider/ を落とすと
  ;;      vitest は「テストが無い」で終わる。それを合格と読ませない）
  ;;   ② guard の describe block がまだ在るか（本数の床だけだと、guard を消して
  ;;      別のテストを足せば 34 のまま緑になる。**guard の消失は guard の失敗より静か**）
  ;;   ③ `Tests N (…)` の総数が --min 以上で、vitest が exit 0 か
  ;;
  ;; 落ちることを確認済み（2026-08-12、手元で実測。`npx` がこの laptop で壊れて
  ;; いるので `nbb` を直接呼んだ。ノードでは npx が pin を解決する）:
  ;;   - nuro/runner.ts に fix 前の defect を戻す → 4 guard が FAIL、exit 1
  ;;   - guard describe を消して本数を 34 に保つ → exit 92
  ;;   - provider/nuro/runner.ts を落とした tree → exit 90
  ;; 無改変の 3d161b144ae7 では 34 tests / exit 0。
  ;;
  ;; :include-ext は 45 件（repo は全部で 72 件と小さい）。**.md が要る** ——
  ;; README guard が deployment checklist を読むので、md を送らないと guard が
  ;; 問いを立てられない。:min-files 30 はその床。
  ;;
  ;; **:cd false** —— この gate が見るのは provider/ だけで、appview/ と kotoba/ は
  ;; 見ない。すぐ上の com-cloudflare entry と同じ理由で、repo 全体の suite では
  ;; ないものを根拠に pin を進めない。緑が意味するのは「credential 経路の guard が
  ;; 成立している」であって「repo が検証済み」ではない。
  {:name "app-yorishiro" :gate :nbb-script
   :script "gates/yorishiro-provider-vault-check.cljs"
   :script-args ["--min" "34"]
   :include-ext [".ts" ".json" ".md"] :min-files 30 :cd false}

  ;; ────────────────────────────────────────────────────────────────────────
  ;; kotoba-provider-orphan（ADR-2608134200。ADR-2608132400 の「載せられない」を撤回）
  ;;
  ;; 規則: **この repo 自身の履歴**で src/ の .clj/.cljc/.cljs が削除されており、
  ;; 同じ path に .kotoba が今あり、兄弟の Clojure source が残っていないなら FAIL。
  ;;
  ;; 第 1 項が repo の git 履歴にしか無いので、既定の配送（mirror からの
  ;; `git archive --prefix=repo/`）では**ノード上に入力が存在しない** —— `git archive`
  ;; の出力に `.git` は入らない。ADR-2608132400 はそれを理由に entry を足さなかった。
  ;;
  ;; **`:ship-self-bundle true` がその入力を配る。** tick.cljs が mirror から
  ;; `git bundle create` して ssh stdin で送り、ノードで `git init` → `fetch` →
  ;; `checkout -f` → sha 照合して**本物の checkout**を作る（ADR-2608132000 が
  ;; `ship-git-deps!` で依存に対して landed させた経路の、対象 repo 自身への適用）。
  ;;
  ;; **`:include-ext` を書かないこと。** bundle は tree の部分集合ではないので
  ;; filter は効かない。両方書いた entry は `gate-input!` が拒否する（黙って
  ;; 無視すると「絞って送っている」と読めてしまうため）。`.kotoba` は bundle が
  ;; 全部運ぶので、ADR-2608132400 が警告した「.kotoba を送らない filter で
  ;; 手元は緑・fleet は赤」は構造的に起こらない。
  ;;
  ;; **:cd false** —— この gate が言うのは「移行の置き去りが無い」だけで、repo が
  ;; 検証済みだとは言っていない。それを根拠に west pin を進めない。
  ;;
  ;; 載せてよいのは **green を実測できた repo だけ**。ADR-2608132400 が数えた
  ;; 対象 97 repo（うち既知の欠陥 9 件）の残りは **owed** —— 赤いまま entry を足すと
  ;; 「入力の無い gate」を「直っていない gate」に置き換えるだけで、このワークスペースが
  ;; 259 tip × 298 receipt 払った失敗と同じ形になる。**修理された repo から足す。**
  ;;
  ;; **2026-08-13 時点で既知の欠陥 9 件は全部 landed し、赤い列は空になった**
  ;; （ADR-2608130900 が dsl-core / async、ADR-2608133600 が postfx / cartpole-math、
  ;; ADR-2608134800 が残り 7 件）。下の 11 entry は 11 repo すべてが手元で EXIT=0 を
  ;; 実測した状態で登録してある。
  ;;
  ;; **gate の緑は「この repo はもう安全」ではない。** この gate は `.kotoba` の兄弟しか
  ;; 見ない。cartpole-math が実例で、消費側 `kotoba-lang/webgpu` が実際に require して
  ;; いる `src/kami/cartpole_math.cljc` は `.kotoba` を伴わない削除だったので gate の
  ;; 視界の外にあり、その repo で本当に webgpu を直したファイルを gate は一度も見て
  ;; いない。残り 7 件については削除 commit を 1 件ずつ確認し、この第 2 類の削除が
  ;; **無い**ことを実測した（ADR-2608134800）。
  {:name "postfx" :id "kotoba-provider-orphan-postfx" :gate :nbb-script
   :script "gates/kotoba-provider-orphan-check.cljs" :script-args ["--min" "1"]
   :ship-self-bundle true :cd false}
  {:name "dsl-core" :id "kotoba-provider-orphan-dsl-core" :gate :nbb-script
   :script "gates/kotoba-provider-orphan-check.cljs" :script-args ["--min" "1"]
   :ship-self-bundle true :cd false}
  {:name "async" :id "kotoba-provider-orphan-async" :gate :nbb-script
   :script "gates/kotoba-provider-orphan-check.cljs" :script-args ["--min" "1"]
   :ship-self-bundle true :cd false}
  {:name "cartpole-math" :id "kotoba-provider-orphan-cartpole-math" :gate :nbb-script
   :script "gates/kotoba-provider-orphan-check.cljs" :script-args ["--min" "1"]
   :ship-self-bundle true :cd false}
  {:name "annotation" :id "kotoba-provider-orphan-annotation" :gate :nbb-script
   :script "gates/kotoba-provider-orphan-check.cljs" :script-args ["--min" "1"]
   :ship-self-bundle true :cd false}
  {:name "kami-app-quarry-walk" :id "kotoba-provider-orphan-kami-app-quarry-walk" :gate :nbb-script
   :script "gates/kotoba-provider-orphan-check.cljs" :script-args ["--min" "1"]
   :ship-self-bundle true :cd false}
  {:name "kami-usd-native" :id "kotoba-provider-orphan-kami-usd-native" :gate :nbb-script
   :script "gates/kotoba-provider-orphan-check.cljs" :script-args ["--min" "1"]
   :ship-self-bundle true :cd false}
  {:name "pbrt" :id "kotoba-provider-orphan-pbrt" :gate :nbb-script
   :script "gates/kotoba-provider-orphan-check.cljs" :script-args ["--min" "1"]
   :ship-self-bundle true :cd false}
  {:name "replicator" :id "kotoba-provider-orphan-replicator" :gate :nbb-script
   :script "gates/kotoba-provider-orphan-check.cljs" :script-args ["--min" "1"]
   :ship-self-bundle true :cd false}
  {:name "rtx-native" :id "kotoba-provider-orphan-rtx-native" :gate :nbb-script
   :script "gates/kotoba-provider-orphan-check.cljs" :script-args ["--min" "1"]
