  {:name "cloud-itonami-isic-4630" :id "itonami-regenerate-4630" :gate :nbb-script
   :script "gates/itonami-regenerate.cljs" :script-args ["--org" "cloud-itonami"]
   :include-ext [".edn" ".clj" ".cljc" ".cljs" ".html" ".json" ".md" ".css" ".svg"]
