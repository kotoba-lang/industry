;; gates.edn — fleet-ci の gate matrix（tick.cljs の唯一の対象リスト）。
;;
;; ADR-2607178000 の runner は対象 14 repo とノード（zebulun/asher）を
;; スクリプト内にハードコードしていた。ここを data にして「1行足せば対象が増える」
;; 状態にする（ノードは指定しない — 実行先は nodes.edn の capability から
;; tick.cljs が選ぶ）。
;;
;; :gate kinds
;;   :jvm-test   deps.edn の :test alias（cognitect test-runner）を clojure -M:test で回す
;;               → node cap :jvm 必須
;;   :nbb-test   nbb のテストエントリを回す（:classpath / :entry）
;;               → node cap :node 必須
;;   :nbb-script gates/ 配下の nbb script をノードに配って repo tree に対して回す
;;               → node cap :node 必須
;;
;; org は west.yml の remote から解決するのでここには書かない（drift 防止）。
{:policy "fleet-ci/tip-verify/v1"
 :gate-timeout-ms 1800000            ;; 1 gate 30 分（clojure の初回 maven 解決を含む）
 :status-context-prefix "fleet-ci/murakumo"
 ;; receipt を署名する弱権限鍵（kagi item 名）。fleet-keys.edn には**入っていない** —
 ;; pin 前進も governance quorum も持たない（漏れても append-only の fleet-ci.edn に
 ;; 偽の行を足せるだけ）。machine ごとに別 identity を enroll する運用なので、
 ;; 鍵を machine 間でコピーしない（ADR-2607178000 の murakumo-ci は別マシンの identity）。
 ;; 2026-07-30: `fleet-agent-murakumo-ci-tip` は fleet-agents.edn に enroll 済み
 ;; （公開鍵 2aa25c7c、DID z6MkhKgm…）だが、**秘密鍵がこのマシンの kagi にも
 ;; PEM にも無い** — 狙い撃ちで両 compartment を確認して不在、vault 自体は
 ;; unlock 可能（lock 障害ではない）。そのため tick は gate を 1 本も実行できず
 ;; `no such item` で死んでいた。
 ;;
 ;; そこで **このマシン専用の identity を新規 enroll した**（README の
 ;; 「machine ごとに別 identity」に従う）。既存 `-tip` の鍵を推測で作り直すと
 ;; enroll 済み公開鍵と一致せず receipt の検証が壊れるので、名前を分ける。
 ;; 秘密鍵は kagi と ~/.gftd/fleet-ci-signer-tip.pem（mode 600、plist が期待
 ;; する路 = ADR-2607178000 §3 が認めた launchd 経路）の両方に置いた。
 :signer-kagi "fleet-agent-murakumo-ci-tip-25mbair"
 :landing {:repo "com-junkawasaki/root"
           :branch "main"
           :receipts "manifest/fleet-ci.edn"
           :west "manifest/west.yml"
           :db "manifest/fleet-db.edn"}
 ;; Radicle 反映。**落ちたときだけ issue を開く**（rad 1.9.1 に commit status に
 ;; 当たる COB は無い — job も ci も status も無く、書ける面は issue か patch の
 ;; コメント/レビューだけ。patch は tip 駆動のこの CI には存在しない）。
 ;;
 ;; 実行先が seed node なのは、gad が systemd で node 常駐・gate 対象を seed
 ;; 済みで、announce できる identity がそちらにあるため。この laptop の node は
 ;; 停止したままで、その鍵の passphrase item（radicle-node-passphrase）は今も
 ;; kagi に無い。
 ;;
 ;; :passphrase-item — COB の署名鍵を unlock する passphrase の kagi item
 ;; （compartment personal）。gad に ssh-agent は無いので、これが唯一の unlock
 ;; 手段。2026-07-26 に実際に置いた（ADR-2607252200 はこの置き場所を決めて
 ;; いたが、実測では `no such item` のままだった＝実行されていなかった）。
 ;; 値は stdin 経由でのみ渡す（argv はリモートの ps に出る）。
 ;;
 ;; RID は manifest/repos.edn の rad-rids から orgs/<org>/<repo> で引く。RID の
 ;; 無い repo は skip して名前を出す（黙って落とさない）。
 :rad {:enabled true
       :host "gad"
       :bin "/home/gad/.radicle/bin/rad"
       :run-as "gad"
       :passphrase-item "radicle-seed-gad-passphrase"}
 ;; CD: gate が green かつ west pin が tip より遅れているとき pin を前進させる。
 ;; 対象は :cd true の repo のみ（opt-in — 静かな pin 前進を全 repo に広げない）。
 :cd {:pin-advance-on-green true}
 :repos
 [{:name "kagami" :gate :jvm-test :cd true}
  {:name "nekko" :gate :jvm-test :cd true}
  {:name "bonsai" :gate :jvm-test :cd true}
  {:name "langgraph" :gate :jvm-test :cd true}
  {:name "kagitaba" :gate :jvm-test :cd true}
  {:name "org-ietf-ed25519" :gate :jvm-test :cd true}
  {:name "org-ietf-cbor" :gate :jvm-test :cd true}
  {:name "io-multiformats" :gate :jvm-test :cd true}
  {:name "io-ipld" :gate :jvm-test :cd true}
  {:name "org-ietf-deflate" :gate :jvm-test :cd true}
  {:name "kotobase-block-codec" :gate :jvm-test :cd true}
  {:name "chain" :gate :jvm-test :cd true}
  {:name "org-chainagnostic-cacao" :gate :jvm-test :cd true}
  {:name "tech-ipfs-specs-ipns" :gate :jvm-test :cd true}
  {:name "kotoba-delta" :gate :nbb-test :classpath "src:test" :entry "run-tests.cljs" :cd true}

  ;; ISCO-08 2652（Musicians, Singers *and Composers*）の3層。ADR-2608081000 で
  ;; 作曲の商売層を分けたときに、この職能を検査するものが1本も無いことに気づいた。
  ;;
  ;; 3 本とも :jvm-test。sakkyokuka と isco-2652 は ongaku を git dep で引くので、
  ;; :nbb-test（classpath はノードへ送った repo tree の中だけ）では sibling repo の
  ;; ソースに届かない。deps.edn 経由ならノードの egress で解決される
  ;; （2026-08-05 に到達可能な 10 ノード全部で repo1.maven.org / github.com が 200）。
  ;; ongaku と sakkyokuka は nbb でも走るが、両ランタイムを CI で二重に回すのは
  ;; まだ要らない（両方 green であることは landing 時に手で確かめている）。
  {:name "ongaku" :gate :jvm-test :cd true}
  {:name "sakkyokuka" :gate :jvm-test :cd true}
  {:name "cloud-itonami-isco-2652" :gate :jvm-test :cd true}

  ;; gftd-audio-actor（作曲家リツ、network-isekai の music+sfx 生成 actor）。
  ;; 2026-08-07 まで **suite が 1 度も走っていなかった** —— deps の座標二重化で
  ;; tools.deps が classpath を組めず、しかも gate が無いので誰も気付かなかった。
  ;; 直したので、二度と黙って腐らないようここに載せる。
  {:name "cloud-itonami-gftd-audio-actor" :gate :jvm-test :cd true}
  ;; 残る 6 つの asset actor（ADR-2607123000 の 7 modality）。横断調査の結果、
  ;; **7 本すべてが同じ座標二重化で classpath を組めず、suite が 1 度も走って
  ;; いなかった**。修正して初めて計 156 tests が動いた（avatar 29 / illust 24 /
  ;; motion 24 / rig 28 / sculpt 24 / voice 27、audio は別途 30）。
  ;; 直しただけでは再発を防げないので 7 本とも gate に載せる。
  {:name "cloud-itonami-gftd-avatar-actor" :gate :jvm-test :cd true}
  {:name "cloud-itonami-gftd-illust-actor" :gate :jvm-test :cd true}
  {:name "cloud-itonami-gftd-motion-actor" :gate :jvm-test :cd true}
  {:name "cloud-itonami-gftd-rig-actor" :gate :jvm-test :cd true}
  {:name "cloud-itonami-gftd-sculpt-actor" :gate :jvm-test :cd true}
  {:name "cloud-itonami-gftd-voice-actor" :gate :jvm-test :cd true}

  ;; :include-ext = ノードへ送る tree を必要な path だけに絞る（trees+blobs API 経由）。
  ;; この repo の full tarball は 1.6GB（assets/動画・画像）で、EDN を parse するだけの
  ;; gate に毎回転送するのは論外。:min-files は「絞り込みが壊れて 0 件 → trivially pass」を
  ;; 防ぐ床（gate 側の --min と二重に掛ける）。
  {:name "org-spirit-in-physics-comics" :gate :nbb-script
   :script "gates/docs-edn-check.cljs" :script-args ["--min" "50"]
   :include-ext [".edn"] :min-files 50 :cd true}

  ;; superproject 自身。GitHub Actions の docs-edn-verify と同じ不変条件を、
  ;; Actions に依存しない経路で持つ（2026-07-26: com-junkawasaki と gftdcojp の
  ;; Actions は課金停止で job が起動せず、この repo の検証が全部止まった。
  ;; kotoba-lang は動いていたので、止まったのは「アカウント単位」）。
  ;;
  ;; :org を明示するのは superproject が west project ではないから（他の entry は
  ;; west.yml の remote から org を引く）。:cd false — 自分の pin は無い。
  ;;
  ;; :include-ext — ノードへ送る tree を .edn だけに絞る。転送は git mirror から
  ;; の archive なので、対象が 1,882 件でも取得は sha ごと 1 回で済む（API 経由
  ;; だった頃は blob ごとに 1 call で、5,000/h の予算を 1 tick で 4 割使った）。
  ;;
  ;; :sub 90-docs/adr — 検査範囲を ADR plane に絞る。ADR-2607171600 の EDN-only
  ;; 規約が実際に効いているのはここで、実測でも 1,552 件すべて parse 可能。
  ;; 範囲外には古い壊れた EDN が 25 件ある（90-docs/deployment/ 13、90-docs/gates/ 8、
  ;; 90-docs/ 直下ほか 4 — Unmatched delimiter / 奇数個の map form など、2026-08
  ;; 付けの計画文書群）。これらは規約成立前の遺物で、gate をそこまで広げると
  ;; 「最初から赤で誰も直さない」になる。範囲を明示して、直ったら広げる。
  ;; club-shinshi-app は kotoba-lang/kaiyu を **vendor** している（deps では
  ;; なく写し。理由は ADR-2607078100 と同じ: この repo の CI と本番 deploy は
  ;; repo 単体を checkout するので、west sibling も :git/sha も解決しない）。
  ;;
  ;; 誰も検査しない vendor は、名前が紛らわしいだけの fork でしかない。しかも
  ;; 壊れ方が静かで、library が dwell の境界を変えて babiniku と kotobase が
  ;; 追従し、shinshi だけ古いまま —— **3 サイトの分布が比較できなくなるのに、
  ;; どの suite も緑のまま**。共有語彙が防ぐはずだったものそのもの。
  ;;
  ;; gate は header に書かれた sha を GitHub から引いて突き合わせる（隣の
  ;; checkout ではなく「header が主張する版」と比べるのが要点）。
  ;; :include-ext は .cljc だけ送る。この repo は動画/画像込みで巨大。
  {:name "club-shinshi-app" :gate :nbb-script
   :script "gates/vendored-kaiyu-parity.cljs" :script-args []
   :include-ext [".cljc"] :min-files 2 :cd true}

  {:name "root" :org "com-junkawasaki" :gate :nbb-script
   :script "gates/docs-edn-check.cljs" :script-args ["--sub" "90-docs/adr" "--min" "1400"]
   :include-ext [".edn"] :min-files 1500 :cd false}

  ;; superproject の parity 台帳 gate。**:id が必要**（:name は org / tip 解決に使う
  ;; repo 名のままにする必要があるため）。
  ;;
  ;; 検証内容: engine parity 台帳の軸が「不在」を主張するとき、その probe が主張を
  ;; 支える範囲を探しているか。2026-08-04〜06 に台帳は 5 回「無い」と書いて 5 回とも
  ;; 誤った（profiler / navigation ×2 / prefab / steam-distribution）—— 毎回手で訂正し、
  ;; 訂正の次の反復で同じ種類の誤りが再発した。CLAUDE.md には既に「結論する前に検索
  ;; せよ」が 2 箇所あるので、**足りないのは規則ではなく機械検査**。
  ;;
  ;; :include-ext に **.cljs が要る** — この gate は検証ロジックを複製せず
  ;; scripts/verify-parity-probes.cljs をノード上で呼ぶので、それが tree に無いと
  ;; 動かない（gate 側が存在を確認して FAIL する）。
  ;; :min-files は「絞り込みが壊れて 0 件 → trivially pass」を防ぐ床で、gate に渡す
  ;; --min（probe を持つ軸の下限）と二重に掛ける。
  {:id "root-parity-probe-policy"
   :name "root" :org "com-junkawasaki" :gate :nbb-script
   :script "gates/parity-probe-check.cljs" :script-args ["--min" "30"]
   :include-ext [".edn" ".cljs"] :min-files 200 :cd false}

  ;; superproject の 2 本目の gate。**:id が必要**（:name は org / tip 解決に使う
  ;; repo 名のままにしないといけないので、識別子を分ける。無いと state の
  ;; [:repos "root"] と gate-name を上の entry と奪い合う）。
  ;;
  ;; 検証内容は manifest/repository-rules.edn（workspace authority、ADR-2607299000）
  ;; に対する子 repo 宣言の適合。GitHub Actions の kotoba-repository-roles.yml と
  ;; **同じ verifier を呼ぶ**（gate script は入力を用意するだけでロジックを複製
  ;; しない）。この不変条件を fleet 側にも置くのは、Actions が課金停止で
  ;; 止まった実績があるため — 同じ理由で上の docs-edn gate が置かれている。
  ;;
  ;; :include-ext に ".cljs" が要る。verifier 本体（scripts/verify-repository-roles.cljs）
  ;; と compat shim（scripts/nbb_compat*）をノードへ送るため。2,100 ファイル程度で
  ;; argv 上限 20,000 に対して充分収まる。
  ;;
  ;; 対象子 repo は authority の :checked-repos から引く。全て public なので
  ;; ノードは token 無しで raw.githubusercontent から取れる（ノードに credential を
  ;; 置かない不変条件はそのまま）。
  {:name "root" :id "root-repository-roles" :org "com-junkawasaki" :gate :nbb-script
   :script "gates/repository-roles-check.cljs" :script-args ["--min" "20"]
   :include-ext [".edn" ".cljs"] :min-files 1500 :cd false}

  ;; superproject の 3 本目。manifest が宣言することと GitHub の実態の乖離を見る。
  ;; 検査ロジックは kotoba-lang/manifest-reality（純 .cljc、IO なし）が正本で、
  ;; gate は west.yml / repos.edn を渡して呼ぶだけ — repository-roles gate と
  ;; 同じ理由（Actions 側と fleet 側で別実装を持つと片方だけ通る状態が生まれる）。
  ;;
  ;; **GitHub 突合は既定で走らない。** unregistered / orphan / duplicate /
  ;; credential-shaped は API を約 4,000 コール使い、5,000/h の予算を 1 tick で
  ;; ほぼ使い切る。ここが毎 tick 走らせるのはファイルだけで完結する検査
  ;; （構造 / org 整合 / stale path key）に限る。突合を足すときは日次の別 entry に
  ;; して --with-reality を付ける。
  ;;
  ;; :include-ext に ".yml" が要る（manifest/west.yml）。".edn" と併せて ~1,900 件で、
  ;; docs-edn gate と同じ桁。**キャッシュキーに filter が入る**ので他 gate の
  ;; tarball を掴む事故（2026-07-29）は起きない。
  {:name "root" :id "root-manifest-reality" :org "com-junkawasaki" :gate :nbb-script
   :script "gates/manifest-reality-check.cljs"
   :include-ext [".edn" ".yml"] :min-files 1500 :cd false}

  ;; superproject の 4 本目。west pin guard の policy 層（Actions の
  ;; west-pin-verify.yml の 1 本目の job と同じ verifier）。
  ;;
  ;; **これを fleet に置くのは、GitHub Actions が実際に実行されていないから。**
  ;; 2026-07-30 実測: com-junkawasaki/root の 16 workflow すべてが最新 run で
  ;; failure、かつ job の steps が 1 件も記録されておらず log も存在しない
  ;; （= job が起動していない。gates.edn 冒頭が記録している 2026-07-26 の
  ;; 課金停止と同じ症状）。pin 退行の保護が、あると思われていて実際は
  ;; どこからも走っていなかった。
  ;;
  ;; port したのは policy 層だけ。west-pin-verify.yml の 2 本目（変更 pin の
  ;; server-side 到達性検証）は GitHub API 認証を要し、ノードに credential を
  ;; 置かない不変条件 3 と両立しない。そちらは既に operator 側にある —
  ;; tick.cljs が CD の pin 前進前に verify-west-pins.cljs を通している
  ;; （不変条件 5）。欠けていたのは認証の要らない policy 層だけ。
  ;;
  ;; :include-ext ".cljs" — policy test 本体と scripts/nbb_compat shim を送るため。
  ;; ".edn" は deps/manifest 読みのため。:min-files は他の root gate と同じ床。
  {:name "root" :id "root-west-pin-policy" :org "com-junkawasaki" :gate :nbb-script
   :script "gates/west-pin-policy-check.cljs"
   :include-ext [".edn" ".cljs"] :min-files 1500 :cd false}

  ;; 法規制の datom 射影（ADR-2608080000）。正本は各 actor の facts.cljc で、
  ;; 90-docs/regulatory/permits.datoms.edn はその射影。actor 側が法令・所管庁を
  ;; 直したのに射影を作り直していないと、datom 面が古い規制を返し続ける ——
  ;; 古い値も「それらしい」ので読み手には見分けが付かない。
  ;; :include-ext に .cljc が要るのは、生成器が actor の facts.cljc を読むため。
  {:name "root" :id "root-permit-index" :org "com-junkawasaki" :gate :nbb-script
   :script "gates/permit-index-check.cljs"
   :include-ext [".edn" ".cljs" ".cljc"] :min-files 1500 :cd false}

  ;; Projection contracts are rebuilt from the exact Git-tip snapshot shipped
  ;; by the fleet operator. The archive has no .git directory, so this gate
  ;; uses snapshot mode: current input/schema/loader hashes plus logical and
  ;; physical outputs are verified; source-commit ancestry remains the local
  ;; pre-push/agent gate's responsibility.
  {:name "root" :id "root-projection-rebuild" :org "com-junkawasaki"
   :gate :nbb-script
   :script "gates/projection-check.cljs"
   :include-ext [".edn" ".cljs"] :min-files 1500 :cd false}

  ;; 学習コーパス面（ADR-2608057000）。**索引に載っている行を再採点して照合する**
  ;; （`--verify-index`）— committed 済みの値を読むだけの検査では、内部整合を保った
  ;; まま手編集された corpus.datoms.edn を検出できない。加えて coverage の申告 vs
  ;; 実体・hazard⇔:excluded・shard の被覆・annex key の整合という独立な不変条件を見る。
  ;;
  ;; **全再生成の bytes 一致にしていない**のは、並行セッションが毎日 ADR を足すため
  ;; —— 新しい文書が 1 件 landed した瞬間に赤になり、以後ずっと赤のままになる。
  ;; 載っている行の正しさ（改竄検出）と、索引が最新かどうか（運用）は別の問題。
  ;;
  ;; :include-ext に ".md" が要る —— 生成器は 90-docs 配下の .md も採点対象に
  ;; するので、md を送らないと再生成の件数が減って **正しい corpus が STALE と
  ;; 報告される**（gate が嘘をつく方向の失敗）。
  {:name "root" :id "root-training-corpus" :org "com-junkawasaki"
   :gate :nbb-script
   :script "gates/training-corpus-check.cljs"
   :include-ext [".edn" ".cljs" ".md"] :min-files 1500 :cd false}

  ;; 資本 pool 面（ADR-2608062300）。`capital-pools.edn` が `budget-supply.edn` の
  ;; `:supply/pools` から**今も**導かれることを再導出して照合する。
  ;;
  ;; **projection contract（`:canonical-edn-v1`）で代替しない。** あれが捕まえるのは
  ;; 生成物の手編集だけで、budget-supply.edn だけが動いた場合を捕まえない ——
  ;; T2 を release する編集は budget-supply.edn 側にしか現れないので、実運用で最初に
  ;; 起きるドリフトがちょうど死角に入る。加えて budget-supply.edn は tx-data では
  ;; ない（entity の vector でなく 1 個の map）ので project-edn の入力になれない。
  ;;
  ;; **全再生成の bytes 一致にしていない**のは root-training-corpus と同じ理由 ——
  ;; `gftd allocate pools md` の demand は canvas index からの live scoring で、
  ;; canvas ledger は毎日動く。bytes 一致にすると翌日に赤くなる。demand に依存しない
  ;; 不変条件だけを再導出するのは妥協ではなく、capital-pools.edn が答えている問い
  ;; （今いくら配れて、それはどこへ出せるか）が構造的に demand に依存しないため
  ;; （配分先を決めるのは ADR が宣言した eligibility であって需要ではない）。
  {:name "root" :id "root-capital-pools" :org "com-junkawasaki"
   :gate :nbb-script
   :script "gates/capital-pools-check.cljs"
   :include-ext [".edn" ".cljs"] :min-files 1500 :cd false}

  ;; net-kotobase（kotobase.net の本体、private）。**network-awai org の GitHub
  ;; Actions は 2026-08-03T01:10Z 以降 1 本も起動していない**（実測: 全 workflow
  ;; failure、job は steps 0 件で 1-10 秒で終了。同 org の cloud-itonami /
  ;; network-isekai も同じ、local-murakumo は 07-20 から）。com-junkawasaki と
  ;; gftdcojp が 2026-07-26 に落ちたのと同じ症状で、ADR-2607300900 が決めた
  ;; 「Actions ではなく fleet」をこの org にも適用する。
  ;;
  ;; gate が持ってこられるのは **hermetic な半分だけ**（ノードは tailnet のみで
  ;; npm registry にも kotobase.net にも届かず、credential も持たない）:
  ;;   enterprise-isolation.yml 全体 / metadata.yml 全体 / worker.yml の syntax 半分 /
  ;;   sdk.yml の python leg。持ってこられないもの（npm ci 系・live smoke・deploy・
  ;;   b2-dr-drill）は ADR-2608036600 に理由付きで列挙した。
  ;;
  ;; **green の意味は「hermetic subset が通った」であって「出荷可」ではない。**
  ;; 出荷判断は docs/MURAKUMO-CI.md の `murakumo-worker-check.cljc deploy-ready`
  ;; （pnpm/npm を要するので現状は operator 側）のまま。
  ;;
  ;; :include-ext を付けないのは full tarball が 3.2MB だから（max-ship 200MB）。
  ;; ノードは bb / node / python3 / git を要求する（gate が不在なら 91 で fail —
  ;; 「道具が無い」は合格ではない）。実測 pass: judah / asher / levi。
  {:name "net-kotobase" :gate :nbb-script
   :script "gates/net-kotobase-hermetic-check.cljs"
   :script-args ["--min-surfaces" "8" "--min-syntax" "20"] :cd true}

  ;; network-awai/cloud-itonami の公開サイト面（`{org}.itonami.cloud/{repo}`、
  ;; ADR-2607301300 → ADR-2608057000）。
  ;;
  ;; ADR-2607301300 は STRICT job `sites` を `.github/workflows/ci.yml` に入れて
  ;; いたが、**この org の Actions は net-kotobase と同じく 2026-08-03 以降 job を
  ;; 起動していない** —— 落ちるのではなく走らないので、repo は green に見えたまま
  ;; 何も検査されていなかった。
  ;;
  ;; repo 自身の `test-sites`（registry canonical + built bundle を実 import）を
  ;; そのまま呼ぶ。**どちらも standalone で動く**（west sibling も source repo も
  ;; 要らない）。`score-sites` / `build-sites --check` は west レイアウトが要るので
  ;; 入れない —— continue-on-error の飾りにしない。
  ;;
  ;; :include-ext を付けないのは、レジストリの `--check` が `public/sites/**` の
  ;; **実ファイル一覧**と `public/` `functions/` の top-level エントリ名から決まる
  ;; ため。拡張子で絞ると tree が痩せて file list が変わり、**痩せたことに気付かない
  ;; まま STALE になる**。full tarball は 27MB（max-ship 200MB）。
  ;;
  ;; --min-reserved は「ship された tree が痩せていないか」の床（実測 38）。
  ;; --min-checks は「host モードの検査が消えていないか」の床（実測 27）。
  ;; どちらも上限ではなく、0 件で緑になるのを防ぐためのもの。
  ;;
  ;; **落ちることを確認済み**（2026-08-05）: registry.json を 1 語書き換えると
  ;; A が STALE で落ち、sites-core.js の org asset root を壊すと（registry は
  ;; 無傷のまま）B が `org host root -> org face asset` で落ちる。無改変で exit 0。
  {:name "cloud-itonami" :org "network-awai" :gate :nbb-script
   :script "gates/cloud-itonami-sites-check.cljs"
   :script-args ["--min-checks" "27" "--min-reserved" "30"] :cd true}

  ;; kotoba-lang/compiler の JDK-free 経路（compiler ADR-0202）。
  ;;
  ;; **ここに置く理由は 2 つある。** ①ADR-2607300900 の決定（CI は Actions では
  ;; なく fleet）。kotoba-lang org の Actions は今日は動いているが、他 3 org は
  ;; org 単位で止まった実績があり、動いている org も同じ理由で止まりうる。
  ;; ②**`.github/workflows/` に書けない** — このワークスペースの token は
  ;; `gist, read:org, repo` だけで `workflow` scope が無い（実測 2026-08-03）。
  ;; Actions 側に step を足す経路が塞がっているので、fleet が唯一の登録先。
  ;;
  ;; 検査は repo 自身の verifier（`test/nbb/classpath.cljs`）を `--hermetic-only`
  ;; で呼ぶだけ。gate 側にロジックを複製しない。**JVM を PATH から隠して回し、
  ;; stub が 1 度でも呼ばれたら fail する** — 「JDK 無しで通った」だけでなく
  ;; 「JVM 経路に一度も落ちなかった」まで見る。stale な lock は `bin/kotoba` を
  ;; `clojure -Spath` に落とすので、その退行がここに出る（実測: PR #500 が
  ;; merge された時点で既に stale だった。open 中に deps.edn の pin が 2 本進んだ
  ;; ためで、**pin が動く頻度からしてこれは通常の腐り方**）。
  ;;
  ;; :cd false — この gate が green でも意味するのは「JDK-free の不変条件が
  ;; 保たれている」だけで、compiler の CI が通ったことではない（browser matrix /
  ;; wasm-tools / cargo / clojure -M:test はノードの egress が無く載らない）。
  ;; 狭い slice を根拠に pin を前進させない。
  ;;
  ;; :include-ext [".edn" ".cljs"] — resolver 本体・その test・lock・deps.edn。
  ;; 実測 84 件なので :min-files 60 を床にする（filter が壊れて空 tree を
  ;; 「合格」にしないため）。
  {:name "compiler" :id "compiler-jdk-free" :gate :nbb-script
   :script "gates/kotoba-compiler-jdk-free-check.cljs"
   :include-ext [".edn" ".cljs"] :min-files 60 :cd false}

  ;; etzhayyim/global-legislation-datoms の corpus 投影（ADR-2608041800）。
  ;; 世界の法令 95,194 件 + 依存辺 646,468 本を 42 シャードに投影したもので、
  ;; 全文 3.43GB 自体は 4 つの DataLad dataset 側にあり、ここは sha256 で
  ;; 名指しするだけ。
  ;;
  ;; **:jvm-test ではなく :nbb-script にしてある。** 当初の理由は「ノードに外向き
  ;; HTTPS が無いので maven 依存の Datascript を解決できない」だったが、**それは誤り**
  ;; だった —— 2026-08-05 に到達可能な 10 ノード全部で測ったところ repo1.maven.org は
  ;; 200 を返す（誤前提の出所は fleet-ci README の、zebulun 1 台に対する 2026-07-26 の
  ;; 実測）。したがって :jvm-test へ移すことは**可能**。
  ;; それでもこの gate を残す理由は別にある: sha256 照合・シャード件数・辺の向きは
  ;; Datascript を起動しなくても検査でき、`clojure -M:test` より速く、
  ;; **手編集されたシャード**という Actions では捕まえられなかった事象を捕まえる。
  ;; Datascript に実際に載ることの検査は repo 側の local contract が持っている。
  ;;
  ;; **この gate は Actions 版より強い。** 主眼は「宣言されたシャードの sha256 と
  ;; バイト数が manifest 通りか」で、これは *内部整合を保ったまま手編集された
  ;; シャード* を捕まえる — Actions 経路では構造的に不可能だった検査（あちらは
  ;; committed 済みの値を読むだけで、再生成が走らないので git diff も無反応）。
  ;; 加えて quality-report の床、JP シャードの identity 一意性 / text address の形 /
  ;; **辺の向き**（日本国憲法に amends が入っていたら from-to 反転）、
  ;; corpus→catalog のライセンス join、schema の属性宣言を見る。
  ;;
  ;; ここで検査され**ない**もの（不在から推測させない）: EU/UK/US シャードは
  ;; sha256 + 件数だけで意味検査はしない（646,468 辺を edamame で読むと数分かかる
  ;; 一方、改竄検出は sha256 で足りる）。また data/corpus/** を locked source から
  ;; **再導出はしない** — それには 4 dataset の index/ が要る。
  ;;
  ;; :include-ext [".edn"] — 検査対象は全部 EDN（tree 71 件、gzip 後 ~40MB で
  ;; max-ship-mb 200 の内側）。:min-files 50 は絞り込みが壊れて空 tree を
  ;; 「違反 0 件 = 合格」にしないための床。
  ;;
  ;; :cd true — この gate が green なら投影は健全なので west pin を前進させてよい。
  {:name "global-legislation-datoms" :gate :nbb-script
   :script "gates/legislation-corpus-check.cljs"
   :include-ext [".edn"] :min-files 50 :cd true}

  ;; ── 既存の GitHub Actions workflow をそのまま fleet で回す ──────────────
  ;; オーナー指示（2026-08-05）「すでにある workflow をそのままで murakumo で
  ;; 使えるように設計統合」。gate に書き直すのではなく `.github/workflows/*.yml`
  ;; を読んで実行する（`gates/github_workflow_run.cljs`）。
  ;;
  ;; 実測 2026-08-05、workspace の実在 2,584 本に対して:
  ;;   runnable 2,284 (88%) / unsupported 300 (12%) / unparsable 0
  ;; 非対応の内訳は npm 229・npx 51・curl 40・cargo 34（ノードに外向き HTTPS が
  ;; 無い）と、pages/artifact 系 action・GitHub 式言語。**skip して green には
  ;; しない** — 受理できない workflow は実行せず理由付きで exit 1。
  ;;
  ;; `uses:` は 11,443 回中 11,136 回（97.3%）が 5 つに集中しており、いずれも
  ;; fleet では前提が既に満たされている（checkout は tick が tree を配る、
  ;; setup-* はノードが provision 済み、cache は ~/.m2 が永続）ので no-op にする。
  ;; それ以外の action は no-op にせず workflow ごと拒否する。
  ;;
  ;; :include-ext に ".yml" が要る（workflow 本体）。対象 repo の内容次第で
  ;; テストが読むファイルも要るので、repo ごとに足す。
  ;;
  ;; :cd false — workflow が green でも「その repo の CI が通った」以上の意味は
  ;; 無く、pin を進める根拠には別途 fleet gate を置く方がよい。
  ;; ── 第2ランタイム（nbb）で同じスイートを回す ──────────────────────────
  ;; ADR-2608060500。kotobase の block 圧縮を作る過程で欠陥が 4 件出て、
  ;; **うち 3 件は JVM では原理的に見えなかった**:
  ;;   - org-ietf-deflate が cljs と JVM で違う（どちらも valid な）DEFLATE を
  ;;     吐いていた。同順位の Huffman ノードが hash-map の列挙順で決まって
  ;;     いたため。round-trip テストは両方とも通る。圧縮バイトを
  ;;     content-address した瞬間に致命傷になる。
  ;;   - `(count uint8-array)` は cljs で ICounted を投げる（byte[] は通る）。
  ;;   - `ipld.link/link-cid` が deftype のフィールドを直読みしており、nbb では
  ;;     nil を返す = link を含むノードを 1 つも encode できない。
  ;; JVM スイートは 3 件とも green のままだった。fleet-ci に第2ランタイムを
  ;; 回すものが無かったので、次の 1 件も同じように見逃す。
  ;;
  ;; :gate :nbb-test ではなく script なのは classpath の解決のため。:nbb-test は
  ;; gates.edn に literal な `--classpath` を書くので、git 依存を持つ repo では
  ;; `~/.gitlibs/libs/<lib>/<sha>/src` を手で並べることになり、pin が動くたびに
  ;; 黙って古い依存に対してスイートが走る状態に腐る。script は repo の deps.edn
  ;; から推移閉包を組み直す。
  ;;
  ;; :ship-git-deps true — その classpath の実体を operator が ~/.gitlibs に置く
  ;; （既定では :jvm-test にしか付かない）。
  ;;
  ;; nbb のバージョンは script 側で固定してある。実測 2026-08-06、同一ソースで
  ;; 1.4.210 は通り 1.4.208 は "Protocol not found: IEquiv" で死ぬ（deftype 内の
  ;; カスタムプロトコルが動かない）ので、固定しないと言語側の失敗をコードの
  ;; 失敗として報告する、しかもマシンによって結果が変わる。
  ;;
  ;; :include-ext に ".json" が要る（package.json — io-multiformats の CID
  ;; ハッシュに @noble/hashes が要り、無いと ipld.core の require が load 時に死ぬ）。
  {:name "org-ietf-deflate" :id "nbb-cross-runtime-deflate" :gate :nbb-script
   :script "gates/nbb-cross-runtime.cljs" :ship-git-deps true
   :include-ext [".cljs" ".cljc" ".clj" ".edn" ".json"] :min-files 5 :cd true}
  {:name "io-ipld" :id "nbb-cross-runtime-io-ipld" :gate :nbb-script
   :script "gates/nbb-cross-runtime.cljs" :ship-git-deps true
   :include-ext [".cljs" ".cljc" ".clj" ".edn" ".json"] :min-files 5 :cd true}
  {:name "kotobase-block-codec" :id "nbb-cross-runtime-block-codec" :gate :nbb-script
   :script "gates/nbb-cross-runtime.cljs" :ship-git-deps true
   :include-ext [".cljs" ".cljc" ".clj" ".edn" ".json"] :min-files 5 :cd true}

  {:name "cloud-itonami-assoc-0126-idn-gapki" :id "gh-workflow-assoc-gapki"
   :gate :nbb-script
   :script "gates/github_workflow_run.cljs" :script-args ["--run-workflows"]
   :include-ext [".yml" ".edn" ".clj" ".cljc"] :min-files 5 :cd false}

  ;; kotoba-lang/shell の in-app provider bridge。scaffold された .ipa/.apk が
  ;; 自前で持つ provider 実装（Swift / Java）と、Clojure 側の宣言
  ;; `bridge-provider-commands` の3者が一致していることを検査する。
  ;;
  ;; 片側だけ足す/消すと silent に壊れる: 宣言にあって実装が無い command は
  ;; その platform でだけ `unknown-command` になり（policy 上は許可されている
  ;; ので「許可されているのに動かない」）、実装があって宣言に無い command は
  ;; policy asset の capabilities に載らず capability 単位の allow が効かなく
  ;; なる。どちらもコードを読む限り自然に見える変更なので機械で押さえる。
  ;;
  ;; この repo の GitHub Actions（ci.yml）は 2026-08-04 を最後に無効化されて
  ;; おり、それ以降の commit は gate を通っていない。実 xcodebuild/gradle と
  ;; 実機起動までは fleet ノードに Xcode/Android SDK が要るのでまだ移せて
  ;; いない —— ここが埋めているのは「両 native 半分の対称性」だけで、ビルドの
  ;; 再現ではない。
  ;;
  ;; 落ちることを実測済み（2026-08-07）: Java 側の `case "notify/show"` を1つ
  ;; 潰したコピーで exit 1 + 差分の名指し、空 tree でも exit 1（絞り込みミスを
  ;; 「0対0で一致」と報告しない）、無改変で exit 0。
  {:name "shell" :id "shell-native-bridge-parity" :gate :nbb-script
   :script "gates/shell-native-bridge-parity.cljs"
   :include-ext [".clj" ".swift" ".java"] :min-files 5 :cd true}

  ;; kotobase-peer の Merkle block size class が、client 封緘の padding bucket に
  ;; 実際に載るかを検査する（ADR-2608070400 D6）。
  ;;
  ;; 2 つの定数は別 repo・別 owner が別の理由で決めている: size class は sync 粒度
  ;; （kotobase-peer）、bucket は長さ秘匿（kotoba-lang/pqh の ISO/IEC 7816-4）。
  ;; **両者の整合を見るものが無かった。** 実測 2026-08-07 で 4 class すべてが
  ;; 病的だった —— class が 2 冪の上にちょうど乗ると、pick-bucket が要求する
  ;; len+1+16 が 17 バイト超過して次の bucket へ落ちる:
  ;;   16384 -> 65536 (+300%) / 32768 -> 65536 (+100%) / 65536, 131072 -> bucket 無し
  ;; 両 repo を直して（pqh 86c453f = 階段を 7 段へ、kotobase-peer 587e3f9 =
  ;; class を 17 下げる）今は 0.0-0.1%。
  ;;
  ;; **bucket 階段を :script-args に置くのは意図的。** 正本は pqh 側だが、この
  ;; gate は kotobase-peer の tree に対して走るので別 repo の定数を tree から
  ;; 読めない。script に埋めると pqh が動いたときに誰も気づかないので、値を
  ;; review 対象として gates.edn に置く（pqh 側の変更が diff に出る）。
  ;;
  ;; 落ちることを実測済み（2026-08-07）: 修正前の実 tree で exit 1（4/4 を名指し）、
  ;; bucket 直下に揃えた tree で exit 0、size-classes 定数が読めない tree で
  ;; exit 1（読めなかったことを pass にしない）。
  {:name "kotobase-peer" :id "kotobase-peer-block-sizing-pad" :gate :nbb-script
   :script "gates/block-sizing-pad-alignment-check.cljs"
   :script-args ["--buckets" "1024,4096,16384,32768,65536,131072,262144"
                 "--max-overhead" "25"]
   :include-ext [".cljc"] :min-files 20 :cd false}]}
