;; gates.edn — fleet-ci の gate matrix（tick.cljs の唯一の対象リスト）。
;;
;; ADR-2607178000 の runner は対象 14 repo とノード（zebulun/asher）を
;; スクリプト内にハードコードしていた。ここを data にして「1行足せば対象が増える」
;; 状態にする（ノードは指定しない — 実行先は nodes.edn の capability から
;; tick.cljs が選ぶ）。
;;
;; :gate kinds
;;   :jvm-test   deps.edn の :test alias（cognitect test-runner）を clojure -M:test で回す
;;               → node cap :jvm 必須
;;   :nbb-test   nbb のテストエントリを回す（:classpath / :entry）
;;               → node cap :node 必須
;;   :nbb-script gates/ 配下の nbb script をノードに配って repo tree に対して回す
;;               → node cap :node 必須
;;
;; org は west.yml の remote から解決するのでここには書かない（drift 防止）。
{:policy "fleet-ci/tip-verify/v1"
 :gate-timeout-ms 1800000            ;; 1 gate 30 分（clojure の初回 maven 解決を含む）
 :status-context-prefix "fleet-ci/murakumo"
 ;; receipt を署名する弱権限鍵（kagi item 名）。fleet-keys.edn には**入っていない** —
 ;; pin 前進も governance quorum も持たない（漏れても append-only の fleet-ci.edn に
 ;; 偽の行を足せるだけ）。machine ごとに別 identity を enroll する運用なので、
 ;; 鍵を machine 間でコピーしない（ADR-2607178000 の murakumo-ci は別マシンの identity）。
 :signer-kagi "fleet-agent-murakumo-ci-tip"
 :landing {:repo "com-junkawasaki/root"
           :branch "main"
           :receipts "manifest/fleet-ci.edn"
           :west "manifest/west.yml"
           :db "manifest/fleet-db.edn"}
 ;; CD: gate が green かつ west pin が tip より遅れているとき pin を前進させる。
 ;; 対象は :cd true の repo のみ（opt-in — 静かな pin 前進を全 repo に広げない）。
 :cd {:pin-advance-on-green true}
 :repos
 [{:name "kagami" :gate :jvm-test :cd true}
  {:name "nekko" :gate :jvm-test :cd true}
  {:name "bonsai" :gate :jvm-test :cd true}
  {:name "langgraph" :gate :jvm-test :cd true}
  {:name "kagitaba" :gate :jvm-test :cd true}
  {:name "org-ietf-ed25519" :gate :jvm-test :cd true}
  {:name "org-ietf-cbor" :gate :jvm-test :cd true}
  {:name "io-multiformats" :gate :jvm-test :cd true}
  {:name "io-ipld" :gate :jvm-test :cd true}
  {:name "chain" :gate :jvm-test :cd true}
  {:name "org-chainagnostic-cacao" :gate :jvm-test :cd true}
  {:name "tech-ipfs-specs-ipns" :gate :jvm-test :cd true}
  {:name "kotoba-delta" :gate :nbb-test :classpath "src:test" :entry "run-tests.cljs" :cd true}
  ;; :include-ext = ノードへ送る tree を必要な path だけに絞る（trees+blobs API 経由）。
  ;; この repo の full tarball は 1.6GB（assets/動画・画像）で、EDN を parse するだけの
  ;; gate に毎回転送するのは論外。:min-files は「絞り込みが壊れて 0 件 → trivially pass」を
  ;; 防ぐ床（gate 側の --min と二重に掛ける）。
  {:name "org-spirit-in-physics-comics" :gate :nbb-script
   :script "gates/docs-edn-check.cljs" :script-args ["--min" "50"]
   :include-ext [".edn"] :min-files 50 :cd true}]}
