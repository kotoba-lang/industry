<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  fleet-ci tip-driven tick（scripts/fleet-ci/tick.cljs）の standing runner。

  install:
    cp scripts/fleet-ci/com.gftd.fleet-ci-tip-tick.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gftd.fleet-ci-tip-tick.plist
  uninstall:
    launchctl bootout gui/$(id -u)/com.gftd.fleet-ci-tip-tick
  1回だけ手で走らせる:
    launchctl kickstart -p gui/$(id -u)/com.gftd.fleet-ci-tip-tick

  * StartInterval 300s = 5 分ごとに tip を見る。変化が無い repo は gate を回さない
    （なので通常の tick は GitHub API 15 回程度で終わる）。
  * 前の tick が走っている間は tick.cljs 側の lock で skip する（重複起動しない）。
  * RunAtLoad false: bootstrap 直後に走らせない（意図しない一斉 gate を避ける）。
  * StandardOut/Err は **構造化ログとは別ファイル**（ADR-2607178000 addendum の
    二重書き込み事故の回避）。正本のログは ~/.itonami/fleet-ci-tick.log。
  * 署名鍵は kagi（compartment personal）から読む → ユーザーの GUI session で
    動かす必要があるため LaunchDaemon ではなく LaunchAgent（gui/<uid>）。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gftd.fleet-ci-tip-tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/nbb</string>
    <string>/Users/junkawasaki/github/com-junkawasaki/scripts/fleet-ci/tick.cljs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/junkawasaki/github/com-junkawasaki</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>FLEET_ROOT</key>
    <string>/Users/junkawasaki/github/com-junkawasaki</string>
    <key>HOME</key>
    <string>/Users/junkawasaki</string>
    <!-- launchd では kagi が Keychain の unlock prompt を出せずに timeout する
         （gh の keyring は読める）。receipt の署名鍵だけ mode 600 の PEM から読む
         — ADR-2607178000 §3 が同じ場所・同じ理由で認めている経路。鍵は grant
         fleet-ci/* のみで pin 前進も governance quorum も持たない。 -->
    <key>FLEET_CI_SIGNER_PEM</key>
    <string>/Users/junkawasaki/.itonami/fleet-ci-signer-tip.pem</string>
    <!-- gh の token も keyring から読めないので owner ごとの fine-grained PAT を
         mode 600 ファイルから読む（dir は 700）。ファイルが無い owner は preflight /
         WARN で明示される。必要な権限は scripts/fleet-ci/README.md 参照。 -->
    <key>FLEET_CI_GH_TOKEN_DIR</key>
    <string>/Users/junkawasaki/.itonami/fleet-ci-gh-tokens</string>
  </dict>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/junkawasaki/.itonami/fleet-ci-tip-tick.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/junkawasaki/.itonami/fleet-ci-tip-tick.stdout.log</string>
  <!-- ProcessType は Standard。**Background にしてはいけない**: 実測(2026-07-25)、
       ProcessType=Background + Nice=5 で bootstrap した job は、他セッションの JVM が
       CPU を占めている状況で 15 分間 CPU 0.09 秒しか進まず（macOS の background
       throttling）、最初のログ 1 行すら出さなかった。CI の tick は数分で終わる前景仕事。 -->
  <key>ProcessType</key>
  <string>Standard</string>
</dict>
</plist>
