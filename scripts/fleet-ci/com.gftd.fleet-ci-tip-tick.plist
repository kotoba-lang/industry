<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  fleet-ci tip-driven tick（scripts/fleet-ci/tick.cljs）の standing runner。

  install:
    cp scripts/fleet-ci/com.gftd.fleet-ci-tip-tick.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gftd.fleet-ci-tip-tick.plist
  uninstall:
    launchctl bootout gui/$(id -u)/com.gftd.fleet-ci-tip-tick
  1回だけ手で走らせる:
    launchctl kickstart -p gui/$(id -u)/com.gftd.fleet-ci-tip-tick

  * StartInterval 300s = 5 分ごとに tip を見る。変化が無い repo は gate を回さない
    （なので通常の tick は GitHub API 15 回程度で終わる）。
  * 前の tick が走っている間は tick.cljs 側の lock で skip する（重複起動しない）。
  * RunAtLoad false: bootstrap 直後に走らせない（意図しない一斉 gate を避ける）。
  * StandardOut/Err は **構造化ログとは別ファイル**（ADR-2607178000 addendum の
    二重書き込み事故の回避）。正本のログは ~/.gftd/fleet-ci-tick.log。
  * 署名鍵は kagi（compartment personal）から読む → ユーザーの GUI session で
    動かす必要があるため LaunchDaemon ではなく LaunchAgent（gui/<uid>）。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gftd.fleet-ci-tip-tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/nbb</string>
    <string>/Users/junkawasaki/github/com-junkawasaki/scripts/fleet-ci/tick.cljs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/junkawasaki/github/com-junkawasaki</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>FLEET_ROOT</key>
    <string>/Users/junkawasaki/github/com-junkawasaki</string>
    <key>HOME</key>
    <string>/Users/junkawasaki</string>
  </dict>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/junkawasaki/.gftd/fleet-ci-tip-tick.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/junkawasaki/.gftd/fleet-ci-tip-tick.stdout.log</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
