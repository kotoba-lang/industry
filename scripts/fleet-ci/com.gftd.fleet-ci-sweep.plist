<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.gftd.fleet-ci-sweep — fleet ノードのディスク回収を 1 日 1 回走らせる。

  なぜ常駐させるか: 満杯のノードは gate を **走らせる前に** 殺す。tar が
  "No space left on device" で落ちるので、CI は赤にすらならず何の signal も出ない。
  2026-07-30 に asher が実際にこの状態で（空き 117MiB）、dan / issachar / naphtali も
  数百 MiB まで詰まっていた。手で気づけるものではないので定期実行にする。

  install:
    cp scripts/fleet-ci/com.gftd.fleet-ci-sweep.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gftd.fleet-ci-sweep.plist
    launchctl kickstart -p gui/$(id -u)/com.gftd.fleet-ci-sweep     # 1 回手動起動

  uninstall:
    launchctl bootout gui/$(id -u)/com.gftd.fleet-ci-sweep

  credential: 不要。ノードへの ssh 鍵だけで、kagi も GitHub token も使わない
  （sweep は receipt を作らないので署名しない）。launchd 下で Keychain が
  使えない問題（ADR-2607178000）はここには当たらない。

  04:17 local — 他の cron（01:17 / 02:41 / 04:30 / 06:00 / 06:17 / 07:43）を避ける。

  ProcessType は Standard。Background にすると macOS の throttling で進まない
  （fleet-ci tick の plist と同じ理由、実測済み）。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gftd.fleet-ci-sweep</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/nbb</string>
    <string>/Users/junkawasaki/github/com-junkawasaki/scripts/fleet-ci/sweep.cljs</string>
    <!-- 既定は dry-run。常駐で実際に回収させるので明示する。 -->
    <string>--apply</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/junkawasaki/github/com-junkawasaki</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>17</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Standard</string>

  <key>StandardOutPath</key>
  <string>/Users/junkawasaki/.itonami/fleet-ci-sweep.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/junkawasaki/.itonami/fleet-ci-sweep.log</string>
</dict>
</plist>
