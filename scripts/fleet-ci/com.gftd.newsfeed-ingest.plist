<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.gftd.newsfeed-ingest.plist — newsfeed の日次 ingest（ADR-2608031900）。

  なぜ launchd か: この workspace の定期実行は既に launchd に寄っている
  （com.gftd.fleet-ci-tip-tick / com.gftd.fleet-ci-sweep）。別の scheduler を
  持ち込むと「どこで何が回っているか」が 2 箇所に割れる。

  なぜ operator マシンで回すか（fleet ノードでなく）:
  ingest は B2 への書き込み権を要る。fleet-ci の不変条件は「秘密情報をノードに
  配らない」（ノードはテストを実行するだけ）なので、credential を要る仕事は
  operator 側に置く。ノードに B2 キーを配ると fleet-ci の設計が崩れる。

  頻度: 1 日 1 回。feed の更新は速いもので数時間おきで、それ以上叩いても
  新規 article は出ない（実測 2026-08-03: 27 source / 1,569 article）。
  ledger は append-only + id dedup なので、取りこぼしても次回で回収される。

  StartCalendarInterval を使う（StartInterval ではなく）: 毎日同じ時刻に回れば
  「昨日の分が入っているか」を人が確認できる。5:23 は fleet-ci-sweep (4:17) と
  ずらしてある — 同時刻に走らせるとどちらの負荷か切り分けられない。

  導入:
    cp scripts/fleet-ci/com.gftd.newsfeed-ingest.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gftd.newsfeed-ingest.plist
    launchctl kickstart -p gui/$(id -u)/com.gftd.newsfeed-ingest   ; 1 回だけ試す
  停止:
    launchctl bootout gui/$(id -u)/com.gftd.newsfeed-ingest
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gftd.newsfeed-ingest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <!-- 実体は scripts/newsfeed-ingest.cljs。plist にロジックを書かない
         （launchctl は編集のたびに bootout/bootstrap が要り、直せなくなる）。 -->
    <string>exec /opt/homebrew/bin/nbb /Users/junkawasaki/github/com-junkawasaki/scripts/newsfeed-ingest.cljs</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>5</integer>
    <key>Minute</key><integer>23</integer>
  </dict>

  <!-- bootstrap 直後に走らせない。意図しない一斉実行を避ける（fleet-ci と同じ）。 -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/newsfeed-ingest.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/newsfeed-ingest.err</string>
</dict>
</plist>
