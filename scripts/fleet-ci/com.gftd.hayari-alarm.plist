<?xml version="1.0" encoding="UTF-8"?>
<!--
  hayari の無人ループが止まったら人に見せる（ADR-2608110300 段階 3）。

  **ループが走るマシンではなく、人が座っているマシンに常駐させる。**
  死んだループは自分の死を報告できないので、警報は別プロセスから出る必要がある。

  判定は gates/hayari-tick-alive.cljs を呼んで exit code を見るだけ（閾値を
  複製しない）。鳴らすのは healthy↔unhealthy の遷移時のみ —— 毎回鳴らす通知は
  無視されるようになる。

    install: cp scripts/fleet-ci/com.gftd.hayari-alarm.plist ~/Library/LaunchAgents/
             launchctl load ~/Library/LaunchAgents/com.gftd.hayari-alarm.plist
    stop:    launchctl unload ~/Library/LaunchAgents/com.gftd.hayari-alarm.plist
    watch:   tail -f /tmp/hayari-alarm.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.gftd.hayari-alarm</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-lc</string>
    <string>exec nbb --classpath "$HOME/github/com-junkawasaki/scripts/fleet-ci" "$HOME/github/com-junkawasaki/scripts/fleet-ci/hayari-alarm.cljs"</string>
  </array>
  <!-- 30 分。ループは 15 分間隔なので、これ以上細かく見ても新しい事実は出ない。 -->
  <key>StartInterval</key>    <integer>1800</integer>
  <key>RunAtLoad</key>        <true/>
  <key>StandardOutPath</key>  <string>/tmp/hayari-alarm.log</string>
  <key>StandardErrorPath</key><string>/tmp/hayari-alarm.log</string>
  <key>ProcessType</key>      <string>Background</string>
</dict>
</plist>
