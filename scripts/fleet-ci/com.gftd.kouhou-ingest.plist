<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.gftd.kouhou-ingest — 官公庁・公益 press の日次取り込み（ADR-2608110200）。

  ADR-2608110200 は ingest と store を landing させたが定期実行に配線せず、
  `manifest/observatories.edn` はそれを正直に書いていた（「まだ足していない」）。
  結果 2026-08-11 の 1 パス以降 7 日間 1 件も取り込まれていない。これはその配線。

  StartCalendarInterval を使う（StartInterval ではなく）: 毎日同じ時刻に回れば
  「昨日の分が入っているか」を人が確認できる。6:41 は newsfeed-ingest (5:23) と
  fleet-ci-sweep (4:17) からずらしてある — 同時刻に走らせるとどちらの負荷か
  切り分けられない。

  KOUHOU_PUBLISH は script 側で 0 に固定している。**外向きの発信を無人の定期
  実行に混ぜない**（phase 0 = observe）。app-aozora への publish は別判断。

  導入:
    cp scripts/fleet-ci/com.gftd.kouhou-ingest.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gftd.kouhou-ingest.plist
    launchctl kickstart -p gui/$(id -u)/com.gftd.kouhou-ingest   ; 1 回だけ試す
  停止:
    launchctl bootout gui/$(id -u)/com.gftd.kouhou-ingest
  見る:
    tail -40 /tmp/kouhou-ingest.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gftd.kouhou-ingest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <!-- 実体は scripts/kouhou-ingest.cljs。plist にロジックを書かない
         （launchctl は編集のたびに bootout/bootstrap が要り、直せなくなる）。 -->
    <string>exec /opt/homebrew/bin/nbb /Users/junkawasaki/github/com-junkawasaki/scripts/kouhou-ingest.cljs</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>41</integer>
  </dict>

  <!-- bootstrap 直後に走らせない。意図しない一斉実行を避ける。 -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/kouhou-ingest.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/kouhou-ingest.err</string>

  <key>WorkingDirectory</key>
  <string>/Users/junkawasaki/github/com-junkawasaki</string>
</dict>
</plist>
