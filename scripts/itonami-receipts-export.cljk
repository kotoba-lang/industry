#!/usr/bin/env kbb
;; Fold the two live ledgers into the receipts file `itonami-actor-pnl` reads.
;;
;;   kbb --backend sci --classpath ".:scripts/nbb_compat" scripts/itonami-receipts-export.cljk \
;;     [--out manifest/itonami-receipts.edn] [--offline]
;;
;; ## Why this exists
;;
;; The ladder reported `no receipt store: murakumo.infer.credits is not called
;; from production` for every actor. Measured 2026-08-31, that was false and had
;; been for some time: `api.murakumo.cloud/infer/runs` answers 200 with 772 runs,
;; 119 of which are spend entries. The receipt store is live. What was missing
;; was anything that read it.
;;
;; ## The join is the hard part, and it does not currently join
;;
;; Also measured 2026-08-31, and it is the finding that matters more than the
;; plumbing:
;;
;;   accounts that spent credits    5   dougaka 1666, did:key:z6MkCustomer2 50,
;;                                      did:key:z6MkVaOUd… 50, shinshi 40.8,
;;                                      isekai-pages 5
;;   actors in the ladder          32
;;   overlap                        0   by DID, by repo name, by seller name
;;
;; The things spending metered credits are not actors, and the actors are not
;; spending metered credits. So margin is not blocked on a missing exporter --
;; it is blocked on the fact that **the actor population has no measured cost at
;; all**. This file makes that visible instead of leaving it as a sentence in a
;; refusal message.
;;
;; Nothing is attributed by guessing. An actor claims its spend account by
;; declaring `:actor/murakumo-account`, the way it claims its revenue by
;; declaring `:actor/x402-seller`. An account nobody claims is reported
;; unattributed and its credits are NOT folded into anyone.
(ns itonami-receipts-export
  (:require ["fs" :as fs]
            ["path" :as p]
            [clojure.edn :as edn]
            [clojure.string :as str]))

(defn- argv [] (vec (drop 2 (js->clj (.-argv js/process)))))
(defn- opt [flag d] (let [a (argv) i (.indexOf a flag)] (if (neg? i) d (nth a (inc i) d))))
(defn- flag? [f] (some #{f} (argv)))

(def root (opt "--root" "."))
(def out-file
  "Relative paths land under --root; an absolute one is taken as given.

  path/join silently absorbs an absolute second argument -- joining a repo root
  with an absolute /tmp path yields the /tmp path UNDER the repo. Measured
  2026-08-31 by finding the output file inside the repository."
  (opt "--out" "manifest/itonami-receipts.edn"))

(defn- out-path [root f] (if (str/starts-with? f "/") f (p/join root f)))
(def runs-url (opt "--runs" "https://api.murakumo.cloud/infer/runs?since=0"))
(def stats-url (opt "--stats" "https://x402.nexus/stats"))
(def offline? (flag? "--offline"))

(defn- refuse! [msg]
  (.write (.-stderr js/process) (str "REFUSING: " msg "\n"))
  (.exit js/process 2))

(defn- slurp* [f] (try (fs/readFileSync f "utf8") (catch :default _ nil)))

(defn- actors
  "Every actor.edn under orgs/, with whatever identities it declares.

  Reads the file as text and pulls the two declarations out, rather than
  parsing: an actor.edn that will not parse must still be counted in the
  denominator. A file skipped for being unreadable and a file with nothing to
  declare are different, and collapsing them would shrink the population
  silently."
  []
  (let [orgs (p/join root "orgs")]
    (when-not (fs/existsSync orgs) (refuse! (str "no orgs tree at " orgs)))
    (for [org (js->clj (fs/readdirSync orgs))
          repo (try (js->clj (fs/readdirSync (p/join orgs org))) (catch :default _ []))
          :let [f (p/join orgs org repo "actor.edn")]
          :when (fs/existsSync f)
          :let [t (or (slurp* f) "")
                grab (fn [k] (second (re-find (re-pattern (str k "\\s+\"([^\"]+)\"")) t)))]]
      {:repo repo :org org :file f
       :seller (grab ":actor/x402-seller")
       :account (grab ":actor/murakumo-account")
       :readable? (some? (slurp* f))})))

(defn- fetch-json [url & [token]]
  (-> (js/fetch url (clj->js (if token {:headers {"authorization" (str "Bearer " token)}} {})))
      (.then (fn [r] (if (.-ok r) (.json r) (throw (js/Error. (str "HTTP " (.-status r)))))))
      (.then (fn [j] (js->clj j :keywordize-keys true)))))

(def admin-token
  "Set NEXUS_ADMIN_TOKEN to attribute revenue per seller.

  Without it the aggregate at /stats is all there is, and dividing an aggregate
  across sellers would be inventing an attribution. So revenue is reported as
  UNMEASURED rather than as zero -- the distinction this whole file exists for.
  With it, a seller that has earned nothing is recorded as a measured 0.0,
  which is a different claim from silence."
  (aget (.-env js/process) "NEXUS_ADMIN_TOKEN"))

(defn- revenue-for
  "-> Promise<{seller usd}> for the declared sellers, or nil without a token."
  [sellers]
  (if (or (str/blank? (str admin-token)) (empty? sellers))
    (js/Promise.resolve nil)
    (-> (js/Promise.all
         (into-array
          (map (fn [s]
                 (-> (fetch-json (str "https://x402.nexus/admin/settlements/" s) admin-token)
                     (.then (fn [r] [s (or (get-in r [:summary :usd-total])
                                           (get r :usd-total) 0.0)]))
                     (.catch (fn [_] [s nil]))))
               sellers)))
        (.then (fn [pairs] (into {} (remove #(nil? (second %)) (js->clj pairs))))))))

(defn- spend-by-account
  "The run ledger folded into {account credits}. Only `:spend` rows count --
  `:shares` is the earn side and folding it here would report contributors as
  spenders."
  [runs]
  (reduce (fn [acc r]
            (reduce (fn [a [who amt]]
                      (update a (name who) (fnil + 0) (js/Number amt)))
                    acc (:spend r)))
          {} runs))

(defn- declared-accounts
  "The workspace's account -> repo map, from manifest/murakumo-accounts.edn.

  A repo does not have to be an actor to spend. `dougaka` has no `actor.edn`
  and should not grow one to record a billing fact, so the mapping lives in the
  manifest and this reads both: an actor may still declare
  `:actor/murakumo-account` itself."
  []
  (let [f (p/join root "manifest/murakumo-accounts.edn")]
    (if-not (fs/existsSync f)
      {}
      ;; Keyed by repo NAME, because that is what `itonami-actor-pnl` joins on.
      ;; The manifest records the full path, which is unambiguous for a reader;
      ;; emitting the path here would produce a receipts file whose keys match
      ;; nothing, and a cost side that reads as absent rather than as wrong.
      (try (into {} (map (fn [a] [(:account a) (last (str/split (str (:repo a)) #"/"))]))
                 (:accounts (edn/read-string (slurp* f))))
           (catch :default e
             (refuse! (str "manifest/murakumo-accounts.edn unreadable: " (.-message e))))))))

(defn -main []
  (if offline?
    (refuse! "--offline: the ledgers are the whole input; there is nothing to fold")
    (-> (js/Promise.all #js [(fetch-json runs-url) (fetch-json stats-url)])
        (.then
         (fn [[runs stats]]
           (let [rows (if (vector? runs) runs (or (:runs runs) (:items runs) []))
                 _ (when (empty? rows) (refuse! (str "run ledger empty or unreadable: " runs-url)))
                 spend (spend-by-account rows)
                 as (vec (actors))
                 ;; Two sources, one map. An actor may claim its own account;
                 ;; a repo that is not an actor is claimed by the manifest.
                 claimed-acct (merge (declared-accounts)
                                     (into {} (keep (fn [a] (when (:account a) [(:account a) (:repo a)])) as)))
                 claimed-sell (into {} (keep (fn [a] (when (:seller a) [(:seller a) (:repo a)])) as))
                 attributed (reduce (fn [m [acct cr]]
                                      (if-let [repo (get claimed-acct acct)]
                                        (assoc-in m [repo :kumo] cr) m))
                                    {} spend)
                 unattributed (remove #(contains? claimed-acct (key %)) spend)
                 settle (:settlements stats)
                 sellers (vec (keys claimed-sell))]
             (println (str "RUNS\t" (count rows) " ledger rows, " (count spend)
                           " accounts have spent"))
             (println (str "ACTORS\t" (count as)
                           "\tmurakumo-account declared=" (count claimed-acct)
                           "\tx402-seller declared=" (count claimed-sell)))
             (println (str "SETTLEMENTS\t" (:count settle) " distinct tx, $"
                           (:usd-total settle)
                           (when (pos? (or (:duplicates settle) 0))
                             (str "\t(store holds " (:recorded settle) " rows, "
                                  (:duplicates settle) " duplicate)"))))
             (println (str "ATTRIBUTED\t" (count attributed) " of " (count spend)
                           " spending accounts"))
             ;; A spender need not be an actor. `itonami-actor-pnl` walks the
             ;; actor population, so a cost attributed to a repo outside it is
             ;; real and still will not appear there -- said here rather than
             ;; left for someone to notice the number never showing up.
             (let [actor-names (set (map :repo as))
                   outside (remove actor-names (keys attributed))]
               (when (seq outside)
                 (println (str "OUTSIDE-THE-LADDER\t" (str/join ", " outside)
                               "\t(attributed, but not in the actor population)"))))
             (when (seq unattributed)
               (println "UNATTRIBUTED\tcredits spent by accounts no actor claims:")
               (doseq [[a cr] (sort-by (comp - val) (vec unattributed))]
                 (println (str "  " (.toFixed (js/Number cr) 1) "\t" a))))
             (-> (revenue-for sellers)
                 (.then
                  (fn [rev]
                    (let [final (reduce (fn [m [s usd]]
                                          (if-let [repo (get claimed-sell s)]
                                            (assoc-in m [repo :revenue] usd) m))
                                        attributed (or rev {}))]
                      (if rev
                        (doseq [[s usd] (sort rev)]
                          (println (str "REVENUE\t" s "\t$" (.toFixed (js/Number usd) 4)
                                        "\t(measured; zero is a measurement)")))
                        (println (str "REVENUE\tUNMEASURED -- /stats is an aggregate across "
                                      "sellers and dividing it would invent an attribution. "
                                      "Set NEXUS_ADMIN_TOKEN to read per-seller.")))
                      (fs/mkdirSync (p/dirname (out-path root out-file)) #js {:recursive true})
                      (fs/writeFileSync (out-path root out-file) (with-out-str (prn final)))
                      (println (str "OUT\t" out-file
                                    (when (empty? final)
                                      "\t(empty: nothing could be attributed to a declared identity)"))))))))))
        (.catch (fn [e] (refuse! (str "ledger unreachable: " (.-message e))))))))

(-main)