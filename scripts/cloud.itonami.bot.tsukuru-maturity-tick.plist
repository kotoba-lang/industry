<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cloud.itonami.bot.tsukuru-maturity-tick</string>

  <!-- Wrapped in `tamaki exec`, like cloud.itonami.bot.itonami-maturity-tick: every
       firing gets an AgentRun identity and a durable append-only lifecycle
       alongside the real argv and exit code. `exec` (not `local`) is correct
       because this tick is deterministic with no model in the loop —
       recording it as agent work would claim an agent did work it did not do. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/junkawasaki/github/com-junkawasaki/orgs/etzhayyim/tamaki/bin/tamaki</string>
    <string>exec</string>
    <string>tsukuru maturity tick (ADR-2800003200): probe the remaining blocked conditions and re-verify the landed guarantees</string>
    <string>--project</string>
    <string>/Users/junkawasaki/github/com-junkawasaki</string>
    <string>--</string>
    <string>/opt/homebrew/bin/nbb</string>
    <string>--classpath</string>
    <string>.:scripts/nbb_compat</string>
    <string>scripts/tsukuru-maturity-tick.cljs</string>
  </array>

  <!-- nbb resolves `--classpath .` against the working directory. -->
  <key>WorkingDirectory</key>
  <string>/Users/junkawasaki/github/com-junkawasaki</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>KAGI_HOME</key>
    <string>/Users/junkawasaki/.kagi</string>
  </dict>

  <!-- 6h, matching cloud.itonami.bot.itonami-maturity-tick. What this watches changes on
       human timescales (a seed restored, an NDA read, an upstream authorization
       fixed), so a shorter interval would only add idle probes.

       NOTE on credentials under launchd: the custody probe needs B2 keys, and
       launchd cannot answer a Keychain unlock prompt (the wall fleet-ci hit,
       ADR-2607178000). That probe will record :unknown rather than :ok when the
       keys do not resolve — which is the point of having a distinct :unknown
       state. Run the tick by hand for a full custody verification. -->
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/junkawasaki/.itonami/tsukuru-maturity-tick.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/junkawasaki/.itonami/tsukuru-maturity-tick.stdout.log</string>
</dict>
</plist>
