<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  cloud.itonami.bot.isekai-game-dev — isekai.network ゲーム制作 bot の loop
  (ADR-2608291600)

  Install:
    cp scripts/cloud.itonami.bot.isekai-game-dev.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/cloud.itonami.bot.isekai-game-dev.plist
    launchctl kickstart -k gui/$(id -u)/cloud.itonami.bot.isekai-game-dev

  Unload:
    launchctl bootout gui/$(id -u)/cloud.itonami.bot.isekai-game-dev

  Interval: 21600s (6h). 1 反復 = tick（決定論・数秒〜数十秒）+ 候補がある周だけ
  claude -p /isekai-game-dev（最長 1h）。lock file（~/.itonami/isekai-game-dev.lock）が
  重なりを防ぐ。候補が無い周・測れなかった周（:not-measured は :no-candidates とは
  別の事実）はモデルを起こさない（loop 側で判定）。

  姉妹 loop cloud.itonami.bot.kami-lib-update と同間隔だが、両方とも各自の lock で保護されて
  いるので同時発火しても互いを壊さない（launchd の StartInterval にオフセット指定は
  無い）。

  EnvironmentVariables に HOME / USER / LOGNAME / SHELL / PATH が無いと
  `claude -p` が "Not logged in" で静かに失敗する（ADR-2608080500）。削らない。
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>COM_JUNKAWASAKI_ROOT</key>
		<string>/Users/junkawasaki/github/com-junkawasaki</string>
		<key>HOME</key>
		<string>/Users/junkawasaki</string>
		<key>LOGNAME</key>
		<string>junkawasaki</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>SHELL</key>
		<string>/bin/zsh</string>
		<key>USER</key>
		<string>junkawasaki</string>
	</dict>
	<key>Label</key>
	<string>cloud.itonami.bot.isekai-game-dev</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/nbb</string>
		<string>--classpath</string>
		<string>.:scripts/nbb_compat</string>
		<string>scripts/isekai-game-dev-loop.cljs</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/junkawasaki/.itonami/isekai-game-dev.stdout.log</string>
	<key>StandardOutPath</key>
	<string>/Users/junkawasaki/.itonami/isekai-game-dev.stdout.log</string>
	<key>StartInterval</key>
	<integer>21600</integer>
	<key>WorkingDirectory</key>
	<string>/Users/junkawasaki/github/com-junkawasaki</string>
</dict>
</plist>
