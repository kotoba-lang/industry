<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cloud.itonami.bot.ma-business-advance</string>

  <!-- ローカル Claude loop（superproject ADR-2608291400）。姉妹の
       cloud.itonami.bot.itonami-os-connect と同じ 2 段構え:
         1) scripts/ma-business-tick.cljs が割れた床を測る（決定論）
         2) 割れた床が在るときだけ claude -p "/ma-business-advance" を起こす

       M&A マッチングは 6 repo にまたがるので、repo 単位の bot（repo-bots /
       itonami-os-connect）の視野に「事業」として入らない。この loop だけが
       構成表 manifest/ma-business.edn を入力に、事業を 1 つの対象として進める。

       1 反復 = 床 1 つ。床は現在 5 つで、うち 1 つ（standard-form）は repo ごとに
       複数回の反復を要する。日次で足りるので 86400。

       止め方:
         launchctl bootout gui/$(id -u)/cloud.itonami.bot.ma-business-advance
       次の 1 手だけ見る（モデルを起こさない）:
         nbb --classpath ".:scripts/nbb_compat" scripts/ma-business-loop.cljs --dry-run -->

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/nbb</string>
    <string>--classpath</string>
    <string>.:scripts/nbb_compat</string>
    <string>scripts/ma-business-loop.cljs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/junkawasaki/github/com-junkawasaki</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>COM_JUNKAWASAKI_ROOT</key>
    <string>/Users/junkawasaki/github/com-junkawasaki</string>
    <key>HOME</key>
    <string>/Users/junkawasaki</string>
    <key>USER</key>
    <string>junkawasaki</string>
    <key>LOGNAME</key>
    <string>junkawasaki</string>
    <key>SHELL</key>
    <string>/bin/zsh</string>
  </dict>

  <key>StartInterval</key>
  <integer>86400</integer>
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/junkawasaki/.itonami/ma-business.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/junkawasaki/.itonami/ma-business.stdout.log</string>
</dict>
</plist>
