#!/usr/bin/env kbb
;; audit-manifest-lexicon-drift.cljs -- manifest が宣言した lexicon と、
;; flat west workspace に実在する契約 JSON との drift を測る。
;;
;;   kbb --backend sci scripts/audit-manifest-lexicon-drift.cljk [--strict]
;;
;; 2026-08-25 に `scripts/audit-manifest-lexicon-drift.py` から移した。Python は
;; CLAUDE.md の runtime 優先順位（kotoba wasm > clojurewasm > ClojureScript > nbb）
;; のどこにも無く、運用 script の host は nbb と定められている（ADR-2607173000）。
;;
;; ## NSID の判定はここに無い
;;
;; この監査の軸は「その文字列は NSID か」という 1 つの述語で、3 箇所が呼ぶ
;; （宣言の検証・wire JSON の identity・ルート登録簿）。Python ではそれが
;; 正規表現リテラルとしてこのファイルの中にだけ在った。
;;
;; 正本は `scripts/kotoba/lexicon_nsid_core.kotoba` に移してあり、ここは
;; **その kernel をコンパイル済み artifact 経由で呼ぶだけ**。2 実装が別々に
;; 直る余地を残さないため、cljs 側に書き写していない（CLAUDE.md:「同じ判断を
;; 2 実装が別々に持ち片方だけ直る状態にしない」）。
;;
;; artifact `scripts/kotoba/lexicon_nsid_core.mjs` は kernel から
;; `amu compile --target js` で生成する。source と食い違っていないことは
;; `scripts/test-audit-manifest-lexicon-drift.cljk` が sha256 で見る。
;;
;; ## fuel
;;
;; Kotoba の instance は生涯 fuel を持つので、`nsid?` は **1 呼び出し 1
;; instance** で呼ぶ。共有すると数十件目で `fuel-exhausted` になる（実測
;; 2026-08-25、corpus 20 件のうち 3 件目で止まった）。

(ns audit-manifest-lexicon-drift
  (:require [clojure.string :as str]
            ["node:fs" :as fs]
            ["node:path" :as path]
))

(def ^:private args (vec *command-line-args*))
(def ^:private strict? (some #{"--strict"} args))

(def ^:private super-root
  (or (some-> (.-env js/process) (aget "COM_JUNKAWASAKI_SUPER_ROOT")) (.cwd js/process)))
(def ^:private west-root
  (or (some-> (.-env js/process) (aget "COM_JUNKAWASAKI_WEST_ROOT")) super-root))
(def ^:private west-manifest (path/join super-root "manifest" "west.yml"))
(def ^:private root-registry (path/join super-root "manifest" "lexicon-root-ownership.edn"))
(def ^:private root-compat-lexicons
  (path/join west-root "orgs" "etzhayyim" "root" "00-contracts" "lexicons"))

(defn- file? [p] (try (.isFile (fs/statSync p)) (catch :default _ false)))
(defn- dir? [p] (try (.isDirectory (fs/statSync p)) (catch :default _ false)))
(defn- slurp* [p] (try (fs/readFileSync p "utf8") (catch :default _ nil)))

;; ---------------------------------------------------------------------------
;; NSID -- 正本は scripts/kotoba/lexicon_nsid_core.kotoba
;; ---------------------------------------------------------------------------

(def ^:private kernel (atom nil))

(def ^:private kernel-artifact
  ;; kernel は **道具の一部**であって、監査される木の一部ではない。
  ;; `super-root` から引くと、別の木を指して走らせたときに見つからない
  ;; （実測 2026-08-25、tmp の木に対するテスト 3 本がこれで exit 2 になった --
  ;; 黙って通らなかったのは refusal 経路が効いていたから）。
  (path/join (.cwd js/process) "scripts" "kotoba" "lexicon_nsid_core.mjs"))

(defn- load-kernel! []
  (-> (js/import (str "file://" kernel-artifact))
      (.then (fn [m] (reset! kernel m) m))))

(defn nsid?
  "その文字列は NSID か。判定は Kotoba kernel が持つ。

  kernel は `:i64` を返し、JS artifact ではそれが **BigInt** になる。
  `(= 1 (js/BigInt 1))` は cljs で false なので、`js/Number` に落としてから
  比べる。最初の版はこれを落として、有効な NSID 7 件すべてを invalid と
  報告した -- 走りはするし、例外も出ないし、数字が並ぶ（実測 2026-08-25）。"
  [s]
  (let [m @kernel
        inst ((.-instantiateKotoba m) #js {})]
    (= 1 (js/Number ((aget inst "nsid?") s)))))

;; ---------------------------------------------------------------------------
;; west.yml から etzhayyim actor の path を読む
;; ---------------------------------------------------------------------------

(defn west-etzhayyim-paths
  ([] (west-etzhayyim-paths west-manifest))
  ([p]
   (if-not (file? p)
     []
     (->> (str/split-lines (or (slurp* p) ""))
          (keep #(second (re-find #"^\s+path:\s+(orgs/etzhayyim/com-etzhayyim-[^\s#]+)\s*$" %)))
          distinct sort vec))))

(defn find-manifests []
  (vec (keep (fn [rel]
               (let [repo (path/join west-root rel)
                     jsonld (path/join repo "manifest.jsonld")
                     edn (path/join repo "manifest.edn")]
                 (cond (file? jsonld) jsonld (file? edn) edn :else nil)))
             (west-etzhayyim-paths))))

;; ---------------------------------------------------------------------------
;; 契約 JSON の候補パス
;; ---------------------------------------------------------------------------

(defn contract-paths [manifest nsid]
  (let [parts (str/split nsid #"\.")
        leaf (last parts)
        owner (path/dirname manifest)
        qualified (str/join "." (take-last 2 parts))
        prefix-dirs (butlast parts)]
    [(path/join owner "wire" "lex" (str leaf ".json"))
     (path/join owner "wire" "lexicons" (str leaf ".json"))
     (path/join owner "wire" "lexicons" (str qualified ".json"))
     (path/join owner "wire" "contracts" "lexicons" (str leaf ".json"))
     (apply path/join owner "lexicons" (concat prefix-dirs [(str leaf ".json")]))
     (apply path/join root-compat-lexicons (concat prefix-dirs [(str leaf ".json")]))]))

(defn resolve-contract [manifest nsid]
  (let [candidates (contract-paths manifest nsid)]
    (or (first (filter file? candidates)) (first candidates))))

;; ---------------------------------------------------------------------------
;; EDN を字句だけ見る -- reader を通さないのは Python 版と同じ理由で、
;; manifest が読めない形でも監査は続けたいから。
;; ---------------------------------------------------------------------------

(def ^:private ws #{" " "\t" "\r" "\n" ","})
(def ^:private delims #{"[" "]" "{" "}" "(" ")"})
(def ^:private escapes {"n" "\n" "r" "\r" "t" "\t"})

(defn- read-string-token
  "`text` の `i`（開き引用符の次）から文字列を読む。`[value next-index]`。"
  [text i]
  (let [n (count text)]
    (loop [j i out []]
      (cond
        (>= j n) [(apply str out) j]
        (= (.charAt text j) "\"") [(apply str out) (inc j)]
        (and (= (.charAt text j) "\\") (< (inc j) n))
        (let [e (.charAt text (inc j))]
          (recur (+ j 2) (conj out (get escapes e e))))
        :else (recur (inc j) (conj out (.charAt text j)))))))

(defn- read-symbol-token [text i]
  (let [n (count text)
        stop (into ws (conj delims "\"" ";"))]
    (loop [j i]
      (if (or (>= j n) (contains? stop (.charAt text j)))
        [(subs text i j) j]
        (recur (inc j))))))

(defn tokens
  "EDN を字句に割る。reader を通さないのは Python 版と同じ理由 -- manifest が
  壊れた形でも監査を続けたいから。返すのは `[kind value]` の列。"
  [text]
  (let [n (count text)]
    (loop [i 0 acc []]
      (if (>= i n)
        acc
        (let [c (.charAt text i)]
          (cond
            (contains? ws c) (recur (inc i) acc)
            (= c ";") (let [nl (.indexOf text "\n" i)]
                        (if (neg? nl) acc (recur nl acc)))
            (= c "\"") (let [[v j] (read-string-token text (inc i))]
                         (recur j (conj acc ["string" v])))
            (contains? delims c) (recur (inc i) (conj acc ["delimiter" c]))
            :else (let [[v j] (read-symbol-token text i)]
                    (recur j (conj acc ["symbol" v])))))))))

(defn vector-strings-after
  "`index`（`[` の位置）から対応する `]` までに現れる、NSID である文字列。"
  [toks index]
  (let [n (count toks)]
    (loop [i index depth 0 acc []]
      (if (>= i n)
        acc
        (let [[kind value] (nth toks i)]
          (cond
            (and (= kind "delimiter") (= value "[")) (recur (inc i) (inc depth) acc)
            (and (= kind "delimiter") (= value "]"))
            (if (= 1 depth) acc (recur (inc i) (dec depth) acc))
            (and (pos? depth) (= kind "string") (nsid? value))
            (recur (inc i) depth (conj acc value))
            :else (recur (inc i) depth acc)))))))

(def ^:private lexicon-keys
  #{"lexicons" "lexiconNamespaces" ":lexicons" ":lexiconNamespaces"
    ":actor/lexicons" ":actor/lexiconNamespaces"})

(defn edn-nsids [text]
  (let [toks (tokens text)]
    (->> (range (max 0 (dec (count toks))))
         (mapcat (fn [i]
                   (let [[kind value] (nth toks i)]
                     (if (and (contains? #{"string" "symbol"} kind)
                              (contains? lexicon-keys value)
                              (= ["delimiter" "["] (nth toks (inc i))))
                       (vector-strings-after toks (inc i))
                       []))))
         distinct vec)))

(defn declared-nsids [manifest]
  (if (str/ends-with? manifest ".edn")
    (edn-nsids (or (slurp* manifest) ""))
    (let [data (try (js->clj (js/JSON.parse (or (slurp* manifest) "")))
                    (catch :default _ nil))]
      (->> ["lexicons" "lexiconNamespaces"]
           (mapcat (fn [k] (get data k [])))
           (keep (fn [v] (cond (string? v) v
                               (and (map? v) (string? (get v "id"))) (get v "id")
                               :else nil)))
           distinct vec))))

;; ---------------------------------------------------------------------------

(defn- collect-ids
  "EAVT ベクタの中の `*/id` 値のうち NSID であるもの。"
  [value acc]
  (cond
    (map? value)
    (reduce (fn [a [k child]]
              (collect-ids child
                           (if (and (string? k) (str/ends-with? k "/id")
                                    (string? child) (nsid? child))
                             (conj a child) a)))
            acc value)
    (sequential? value) (reduce (fn [a c] (collect-ids c a)) acc value)
    :else acc))

(defn lexicon-file-nsid
  "map の `id`、あるいは一意に決まる EAVT の identity。曖昧なら stem に落とす。"
  [p prefix]
  (let [stem (str/replace (path/basename p) #"\.json$" "")
        fallback (str prefix "." stem)
        data (try (js->clj (js/JSON.parse (or (slurp* p) ""))) (catch :default _ ::bad))]
    (cond
      (= data ::bad) fallback
      (and (map? data) (string? (get data "id"))) (get data "id")
      (sequential? data) (let [ids (collect-ids data #{})]
                           (if (= 1 (count ids)) (first ids) fallback))
      :else fallback)))

(defn root-owned-nsids
  ([] (root-owned-nsids root-registry))
  ([p]
   (if-not (file? p)
     #{}
     (let [toks (tokens (or (slurp* p) ""))]
       (or (first
            (keep (fn [i]
                    (when (and (= ["symbol" ":registry/lexicons"] (nth toks i))
                               (= ["delimiter" "["] (nth toks (inc i))))
                      (set (vector-strings-after toks (inc i)))))
                  (range (max 0 (dec (count toks))))))
           #{})))))

;; ---------------------------------------------------------------------------

(defn audit []
  (let [manifests (find-manifests)
        state (atom {:declared #{} :missing [] :invalid [] :owned-dirs {}})]
    (doseq [manifest manifests
            nsid (declared-nsids manifest)]
      (if-not (nsid? nsid)
        (swap! state update :invalid conj [manifest nsid])
        (let [contract (resolve-contract manifest nsid)
              d (path/dirname contract)]
          (swap! state (fn [st]
                         (cond-> (-> st
                                     (update :declared conj nsid)
                                     (update-in [:owned-dirs d] (fnil conj #{}) nsid))
                           (not (file? contract))
                           (update :missing conj [manifest nsid contract])))))))
    (let [{:keys [declared missing invalid owned-dirs]} @state
          root-owned (root-owned-nsids)
          orphans (reduce
                   (fn [acc [d nsids]]
                     (if-not (dir? d)
                       acc
                       (let [prefix (str/join "." (butlast (str/split (first (sort nsids)) #"\.")))
                             files (->> (try (vec (fs/readdirSync d)) (catch :default _ []))
                                        (filter #(str/ends-with? % ".json"))
                                        sort)]
                         (reduce (fn [a f]
                                   (let [n (lexicon-file-nsid (path/join d f) prefix)]
                                     (if (or (contains? declared n) (contains? root-owned n))
                                       a (conj a n))))
                                 acc files))))
                   #{} owned-dirs)]
      {:manifests manifests :declared declared :missing missing
       :invalid invalid :orphans orphans :root-owned root-owned})))

(defn -main []
  (-> (load-kernel!)
      (.then
       (fn [_]
         (let [{:keys [manifests declared missing invalid orphans root-owned]} (audit)]
           (println (str "West actor manifests scanned: " (count manifests)))
           (println (str "Lexicons declared: " (count declared)))
           (println (str "Root-owned contracts: " (count root-owned)))
           (println (str "Invalid NSIDs: " (count invalid)))
           (println (str "Undeclared orphan lexicons: " (count orphans)))
           (doseq [[manifest nsid expected] missing]
             (println (str "MISSING " nsid ": " manifest " -> " expected)))
           (doseq [n (sort orphans)] (println (str "ORPHAN " n)))
           (println (str "Manifest declarations missing wire JSON: " (count missing)))
           (when (and strict? (or (seq missing) (seq invalid) (seq orphans)))
             (set! (.-exitCode js/process) 1)))))
      (.catch (fn [e]
                (println "REFUSING: the NSID kernel could not be loaded --" (.-message e))
                (println "This audit cannot answer, which is not the same as clean.")
                (set! (.-exitCode js/process) 2)))))

(-main)
