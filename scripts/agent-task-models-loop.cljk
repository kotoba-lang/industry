#!/usr/bin/env kbb
;; scripts/agent-task-models-loop.cljk — ローカル Claude loop の入口。
;; LaunchAgent `cloud.itonami.bot.agent-task-models` が 6 時間ごとにこれを起こす。
;;
;; 2 段構え（姉妹 loop rule-kaizen / adr-inventory と同じ）:
;;   1. `scripts/agent-task-models-tick.cljk` が 1 分類 × 全候補 model を測る（決定論。
;;      候補 model を被測定物として呼ぶが、agent は起こさない）
;;   2. finding（routing のずれ / 候補が答えられない）があるときだけ `claude -p /agent-task-models`
;;
;; 正本: manifest/agent-task-models.edn、ADR-2609172000。手順の正本は skill。ここには書かない。
;;
;; 不変条件:
;;   - finding が 0 ならモデルを起こさない。測るだけの周は毎周ある（それが監視）。
;;   - :insufficient-scan ならモデルを起こさない。
;;   - 共有 checkout を書き換えない。git merge --ff-only はしない。
;;   - ledger は追記のみ。成否は次周の tick が測る。
;;   - exit 0 常に。
;;
;; claude の起動引数は `claude-args` に 1 か所。無人で回すときに姉妹 loop が付けている
;; permission 関連の flag は owner が同じ vector に足す（この file を書いた agent には
;; その flag を書く許可が無かった。2026-09-17）。
;;
;; usage:
;;   kbb --backend sci scripts/agent-task-models-loop.cljk [--dry-run] [--report-only]

(require '[clojure.edn :as edn]
         '[clojure.string :as str])

(def fs (js/require "node:fs"))
(def os (js/require "node:os"))
(def cp (js/require "node:child_process"))

(def home (.homedir os))
(def root (or (aget (.-env js/process) "COM_JUNKAWASAKI_ROOT")
              (str home "/github/com-junkawasaki")))
(def ledger-file (str home "/.itonami/agent-task-models.ledger.edn"))
(def dry-run? (boolean (some #{"--dry-run"} *command-line-args*)))
(def report-only? (boolean (some #{"--report-only"} *command-line-args*)))

(def claude-args ["-p" "/agent-task-models"])

(defn log! [& xs]
  (println (str (.toISOString (js/Date.)) " " (str/join " " (map str xs)))))

(defn- sh [cmd args opts]
  (try
    (let [r (.spawnSync cp cmd (clj->js args)
                        (clj->js (merge {:encoding "utf8" :cwd root :maxBuffer (* 64 1024 1024)} opts)))]
      {:code (aget r "status") :out (str (aget r "stdout")) :err (str (aget r "stderr"))})
    (catch :default e {:code nil :out "" :err (str e)})))

(defn- append-ledger! [m]
  (try (.appendFileSync fs ledger-file (str (pr-str m) "\n"))
       (catch :default e (log! "ledger 追記に失敗:" (str e)))))

(defn- parse-tick
  "tick の stdout の最後の `TICK<TAB><edn>` 行を読む。無ければ nil。"
  [out]
  (some->> (str/split-lines out)
           (filter #(str/starts-with? % "TICK\t"))
           last
           (#(subs % 5))
           (#(try (edn/read-string %) (catch :default _ nil)))))

(defn -main []
  (let [started (.toISOString (js/Date.))]
    (sh "git" ["fetch" "origin" "--quiet"] {})
    (let [{:keys [code]} (sh "git" ["merge-base" "--is-ancestor" "HEAD" "origin/main"] {})]
      (when (not= 0 code)
        (log! "この checkout は origin/main から分岐している。この周は何もしない。")
        (append-ledger! {:at started :outcome :skipped :why :diverged-from-main})
        (js/process.exit 0)))

    (let [{:keys [code out err]}
          (sh "kbb" (cond-> ["--backend" "sci" "--classpath" "scripts/model-eval"
                             "scripts/agent-task-models-tick.cljk"]
                      report-only? (conj "--report-only"))
              {:timeout (* 3 3600 1000)})
          _ (println out)
          _ (when (seq (str/trim (or err ""))) (log! "tick stderr:" (subs (str/trim err) 0 (min 800 (count (str/trim err))))))
          tick (parse-tick out)
          next (:next tick)]
      (cond
        (nil? tick)
        (do (log! "tick の出力が読めない（exit" code "）。この周は何もしない")
            (append-ledger! {:at started :outcome :skipped :why :no-tick-output :exit code}))

        (= :insufficient-scan (:outcome tick))
        (do (log! "走査が不十分。モデルを起こさない")
            (append-ledger! {:at started :outcome :skipped :why :insufficient-scan :tick (dissoc tick :remaining)}))

        (nil? next)
        (do (log! "finding は 0 件（分類" (some-> (:class tick) name) "を" (:measured tick) "行測った）。無い仕事にモデルを起こさない")
            (append-ledger! {:at started :outcome :measured-only :class (:class tick) :measured (:measured tick)}))

        dry-run?
        (do (log! "--dry-run: 次の finding は" (name (:kind next)) (name (:class next))
                  "current=" (:current next) "winner=" (or (:winner next) (:model next)))
            (append-ledger! {:at started :outcome :dry-run :next next :remaining (count (:remaining tick))}))

        :else
        (let [{:keys [code out err]} (sh "claude" claude-args {:timeout 3600000})]
          (println out)
          (when (seq (str/trim (or err ""))) (log! "stderr:" (str/trim err)))
          (log! "claude 終了コード:" code)
          (append-ledger! {:at started
                           :finished (.toISOString (js/Date.))
                           :outcome (if (= 0 code) :ran :failed)
                           :exit code
                           :next-was next
                           :remaining-before (count (:remaining tick))
                           :note "成否は次周の tick が測る"}))))
    (js/process.exit 0)))

(-main)
