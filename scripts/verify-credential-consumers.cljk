#!/usr/bin/env nbb
;; A credential class that is minted and accepted by nobody.
;;
;;   nbb scripts/verify-credential-consumers.cljk [--findings] [<orgs dir>]
;;
;; Measured 2026-08-31 (ADR-2608311600): ADR-2608291200 minted a per-caller
;; operator credential for api.murakumo.cloud -- `mro_`, 15 minutes, scoped to
;; named actions -- and measured the whole passkey chain live against real
;; services. The consumer was never written. `/rpc/verify-operator` had ZERO
;; callers, so the credential existed, verified, expired, and authorised
;; nothing, while the shared secret it was built to replace stayed the only key
;; to the most destructive routes on that API.
;;
;; Nothing was wrong with either half. What was missing is the question this
;; asks: **does anything call the verifier?** An issuer cannot answer it about
;; itself, and a consumer that does not exist raises no error anywhere.
;;
;; ## Absence needs coverage, or it is not a measurement
;;
;; "No caller found" is only meaningful against a known search space. A repo
;; that west manages but nobody checked out contains no callers as far as any
;; grep is concerned. So this reports how many repos it actually opened, and
;; refuses a clean verdict when it could not read the issuer at all.
;;
;; Exit is three-valued:
;;   0  every verifier has at least one consumer
;;   1  every verifier was checked, at least one has none
;;   2  the issuer's surface could not be read -- REFUSING to report either way.
(ns verify-credential-consumers
  (:require [clojure.string :as str]
            ["fs" :as fs]
            ["path" :as path]
            ["child_process" :as cp]))

(def issuer
  {:name "kotobase-authn"
   :source "net-kotobase/control-plane/authn/src/authn/worker.cljs"
   ;; A CONSUMER IS SOMEBODY ELSE. The issuer's whole repository is excluded,
   ;; not just the file that declares the route.
   ;;
   ;; Measured 2026-08-31 while writing this: excluding only the source file
   ;; made /rpc/verify-operator look like it had three consumers -- its own
   ;; ADR, its own README, and its own compiled bundle. The detector reported
   ;; `clean` about a credential nothing outside the issuer accepts, which is
   ;; the direction that HIDES the finding.
   :repo "net-kotobase/control-plane"
   ;; The verification surface is READ from the issuer rather than listed here.
   ;; A hardcoded list goes stale in the direction that hides a new credential
   ;; class the day it is added, which is the failure this exists to catch.
   :rpc-pattern #"\"(/rpc/verify-[a-z-]+)\""})

(defn- sh [args]
  (try {:ok true :out (str (cp/execSync (str/join " " (map pr-str args))
                                        #js {:encoding "utf8"
                                             :stdio #js ["pipe" "pipe" "pipe"]
                                             :maxBuffer (* 64 1024 1024)}))}
       (catch :default e
         ;; grep exits 1 for "no matches", which is an ANSWER, not a failure.
         {:ok (= 1 (aget e "status")) :out (str (or (aget e "stdout") ""))})))

(defn- verifiers
  "The issuer's own list, or nil when its source cannot be read."
  [orgs]
  (let [p (path/join orgs (:source issuer))]
    (when (fs/existsSync p)
      (let [src (str (fs/readFileSync p "utf8"))]
        (->> (re-seq (:rpc-pattern issuer) src) (map second) distinct sort vec)))))

(defn- repos-scanned [orgs]
  (let [r (sh ["find" orgs "-maxdepth" "2" "-mindepth" "2" "-type" "d"])]
    (if-not (:ok r) 0 (count (remove str/blank? (str/split-lines (:out r)))))))

(defn- all-references
  "ONE pass over the tree: `path -> [rpc …]` for every `/rpc/verify-*` mention.

  Three separate `grep -r` walks over 4,000 repos did not finish in nine
  minutes. The cost is the walk, not the pattern, so the walk happens once and
  the results are bucketed here. Extensions are restricted for the same
  reason -- and the restriction is stated rather than silent, because a
  consumer written in a language not listed below would be invisible and would
  read as an absent consumer."
  [orgs]
  (let [r (sh (concat ["grep" "-roE" "--binary-files=without-match"
                       "--exclude-dir=node_modules" "--exclude-dir=.git"
                       "--exclude-dir=dist" "--exclude-dir=out"
                       "--exclude-dir=release" "--exclude-dir=target"]
                      (for [e ["cljs" "cljc" "clj" "js" "mjs" "cjs" "ts" "edn" "json" "md"]]
                        (str "--include=*." e))
                      ["--" "/rpc/verify-[a-z-]+" orgs]))]
    (when (:ok r)
      (reduce (fn [acc line]
                (let [i (str/last-index-of line ":/rpc/")]
                  (if-not i
                    acc
                    (update acc (subs line (inc i)) (fnil conj #{}) (subs line 0 i)))))
              {}
              (remove str/blank? (str/split-lines (:out r)))))))

(defn -main [& args]
  (let [findings? (boolean (some #{"--findings"} args))
        orgs (or (first (remove #(str/starts-with? % "--") args)) "orgs")
        vs (verifiers orgs)]
    (if (nil? vs)
      (do (println (str "REFUSED\tthe issuer's source is not readable at "
                        (path/join orgs (:source issuer))
                        " -- cannot tell an unconsumed credential from an unread one"))
          2)
      (let [n-repos (repos-scanned orgs)
            refs (or (all-references orgs) ::unread)
            issuer-repo (str (path/join orgs (:repo issuer)) "/")
            rows (vec (for [v vs]
                        {:rpc v
                         :callers (if (= ::unread refs)
                                    ::unread
                                    (vec (remove #(str/starts-with? % issuer-repo)
                                                 (get refs v #{}))))}))
            unread? (= ::unread refs)
            orphans (when-not unread? (filter #(empty? (:callers %)) rows))]
        (println (str "SCANNED\t" (count rows) "\tverification endpoints declared by "
                      (:name issuer) ", across " n-repos " checked-out repos"))
        (doseq [r rows]
          (println (str "  " (cond unread? "?   " (seq (:callers r)) "ok  " :else "NONE")
                        " " (:rpc r) "  consumers="
                        (if unread? "unmeasured" (count (:callers r))))))
        (doseq [o orphans]
          (let [detail (str (:name issuer) " exposes " (:rpc o)
                            " and nothing in " n-repos
                            " checked-out repos calls it: a credential class that is"
                            " minted, verifiable, and accepted by nobody")]
            (when findings?
              (println (str "FINDING\thigh\t" (str/replace (:rpc o) #"^/" "") "\t" detail)))))
        (println)
        (cond
          unread?
          (do (println "  REFUSING: the tree could not be searched") 2)

          (zero? (count rows))
          (do (println "  REFUSING: the issuer declared no verification endpoints, which is not a clean result") 2)
          (seq orphans) (do (println (str "  " (count orphans) " unconsumed credential class(es)")) 1)
          :else (do (println "  clean") 0))))))

(let [code (apply -main *command-line-args*)]
  (set! (.-exitCode js/process) code))
