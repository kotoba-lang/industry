#!/usr/bin/env kbb
;; A shadow-cljs build that puts a library on its source path but not that
;; library's own dependency cannot compile at all.
;;
;;   kbb --backend sci scripts/verify-shadow-cljs-provider-paths.cljk [--findings] [<orgs dir>]
;;
;; Measured 2026-08-31: net-kotobase/control-plane's protocols-worker and
;; network-awai/app-aozora-engine BOTH stopped at `The required namespace
;; "sha2.core" is not available, it was required by "kotobase/cid.cljs"`, i.e.
;; neither could be rebuilt from its own main. The cause was one library
;; growing a dependency and its consumers' source paths not following. Nothing
;; noticed, because a build nobody ran is indistinguishable from a build that
;; works -- and both of those repos deploy live Workers.
;;
;; This reads the DEFAULT BRANCH copy, not the working tree. A west checkout
;; sits at its pin and is routinely behind; judging main by a stale checkout
;; reports repairs that already landed (it did, the first time this was run).
;;
;; Exit is three-valued:
;;   0  every build read and none broken
;;   1  every build read, at least one broken
;;   2  builds whose default-branch copy could not be read -- REFUSING to call
;;      a tree clean when part of it was never opened.
(ns verify-shadow-cljs-provider-paths
  (:require [clojure.string :as str]
            ["fs" :as fs]
            ["path" :as path]
            ["child_process" :as cp]))

(def pairs
  "requiring library on the source path -> the provider it needs, and the
  namespace whose absence stops the build. Add a row when a build breaks this
  way; the point is that the SECOND occurrence is caught by a machine."
  [{:requirer "kotobase-client" :provider "org-nist-sha2" :namespace "sha2.core"
    :required-by "kotobase/cid.cljs"}
   {:requirer "shitsuke" :provider "kotoba-kir" :namespace "kotoba.kir"
    :required-by "shitsuke/kotoba_oracle.cljc"}])

(def remotes ["origin" "net-kotobase" "network-awai" "kotoba-lang"
              "cloud-itonami" "com-junkawasaki" "gftdcojp" "etzhayyim"
              "jk-luxury" "kotobase"])

(defn- sh [args]
  (try {:ok true :out (str (cp/execSync (str/join " " (map pr-str args))
                                        #js {:encoding "utf8"
                                             :stdio #js ["pipe" "pipe" "pipe"]
                                             :maxBuffer (* 16 1024 1024)}))}
       (catch :default _ {:ok false})))

(defn- find-builds [orgs]
  (let [r (sh ["find" orgs "-maxdepth" "4" "-name" "shadow-cljs.edn"
               "-not" "-path" "*/node_modules/*"])]
    (if-not (:ok r) nil (remove str/blank? (str/split-lines (:out r))))))

(defn- repo-of [orgs f]
  (let [rel (str/split (path/relative orgs f) #"/")]
    (when (>= (count rel) 2)
      {:repo (path/join orgs (first rel) (second rel))
       :rel (str/join "/" (drop 2 rel))})))

(defn- default-branch-copy
  "The file as the repo's default branch has it, or nil when that cannot be
  resolved. nil is UNREAD -- never `absent`, and never `fine`."
  [repo rel]
  (some (fn [r]
          (let [ref (str r "/main")]
            (when (:ok (sh ["git" "-C" repo "rev-parse" "--verify" "-q" ref]))
              ;; `${ref}:${rel}` is built here and not in a shell string on
              ;; purpose: zsh reads `:s` and `:t` after a variable as history
              ;; modifiers, and `scripts/` and `tools/` are the two commonest
              ;; top-level directories in this workspace.
              (let [g (sh ["git" "-C" repo "show" (str ref ":" rel)])]
                (when (:ok g) {:ref ref :src (:out g)})))))
        remotes))

(defn- on-source-path? [src lib]
  (boolean (re-find (re-pattern (str "\"[^\"]*/" lib "/(src|test)\"")) src)))

(defn -main [& args]
  (let [findings? (boolean (some #{"--findings"} args))
        orgs (or (first (remove #(str/starts-with? % "--") args)) "orgs")
        builds (find-builds orgs)]
    (if (nil? builds)
      (do (println "REFUSED\tcould not enumerate shadow-cljs.edn under " orgs) 2)
      (let [results (for [f builds
                          :let [{:keys [repo rel]} (repo-of orgs f)]
                          :when repo]
                      (if-let [{:keys [ref src]} (default-branch-copy repo rel)]
                        {:read? true :file f :ref ref
                         :broken (vec (for [{:keys [requirer provider namespace required-by]} pairs
                                            :when (and (on-source-path? src requirer)
                                                       (not (str/includes? src provider)))]
                                        {:requirer requirer :provider provider
                                         :namespace namespace :required-by required-by}))}
                        {:read? false :file f}))
            results (vec results)
            read-ok (filter :read? results)
            unread (remove :read? results)
            broken (filter #(seq (:broken %)) read-ok)]
        (println (str "SCANNED\t" (count read-ok) "\tof " (count results)
                      " shadow-cljs.edn on their default branch"
                      " (unreadable: " (count unread) ")"))
        (doseq [b broken, m (:broken b)]
          (let [key (str (path/relative orgs (:file b)) "::" (:namespace m))
                detail (str (path/relative orgs (:file b)) " puts " (:requirer m)
                            " on its source path but not " (:provider m)
                            "; the build stops at \"" (:namespace m)
                            " is not available, it was required by " (:required-by m) "\"")]
            (println (str "  BROKEN " detail))
            (when findings? (println (str "FINDING\thigh\t" key "\t" detail)))))
        (cond
          (seq unread)
          (do (println (str "\n  REFUSING to report a clean tree: "
                            (count unread) " build(s) whose default branch could not be read."))
              2)
          (seq broken) (do (println (str "\n  " (count broken) " build(s) cannot compile")) 1)
          :else (do (println "\n  clean") 0))))))

(let [code (apply -main *command-line-args*)]
  (set! (.-exitCode js/process) code))
