#!/usr/bin/env kbb
;; publisher-census-datalake-export.cljs — 世界の発行者（ブログ / 媒体 / 掲示板）の
;; センサスを R2 Data Catalog へ渡す JSON にする。lei / watchlist / hyakka の
;; exporter と同型で、**spec を自分でデータの隣に書く**（loader と drift しない形）。
;;
;;   kbb --backend sci scripts/publisher-census-datalake-export.cljk [--repo <path>] [--out-dir <dir>]
;;   python3 scripts/datalake-sync.py --spec <out-dir>/publishers.spec.json --in-dir <out-dir>
;;
;; ## 何を載せて、何を載せないか
;;
;; 載せるのは **service（ホスト）** —— domain / software / protocol / 規模。
;; これは組織の metadata である。
;;
;; **account 行（174,592 件）は載せない。** CLAUDE.md が repo-wide mandatory として
;; 書いているとおり、account が join できる先は `:service/host` → `:service/domain`
;; だけで、その join は service さえ在れば成立する。個人識別子を全 query の作業集合に
;; 常駐させない。account を引きたいなら repo 側の read-only adapter を通す。
;;
;; ## `:service/source` を潰さない
;;
;; 同じ列に見えて出所が違う 2 系統が在る（CLAUDE.md 明記）:
;;
;;   :self-reported  NodeInfo。ホストが自分で名乗った値。software / 規模を持つ
;;   :observed       PDS をアカウント側から数えたもの。software は nil
;;
;; **合算した数を「発行者の数」として出さない。** source を列として残し、
;; coverage 表が内訳を持つ。
;;
;; ## 分類は語彙であって導出ではない
;;
;; software から category（blog / social / forum / media）への写像は、repo の
;; 中身から導出できない —— `concept-vocabulary.edn` が「端末 と terminal は同じ」を
;; 手で持つのと同じ理由で、ここで**宣言**する。
;;
;; 語彙に無い software は `unknown` であって、いちばん近い箱に入れない。
;; その件数は coverage 表と stdout の両方に出る —— **未分類を 0 に見せない。**
;;
;; ## 測れなかったことを clean と書かない
;;
;;   0  書けた
;;   2  REFUSED — services が 1 件も読めなかった / corpus が無い
;;
;; 空の表を実測として公開しないための床。

(ns publisher-census-datalake-export
  (:require [clojure.string :as str]
            [clojure.edn :as edn]
            ["node:fs" :as fs]
            ["node:path" :as path]))

(def argv (vec (drop 2 (js->clj (.-argv js/process)))))
(defn- opt [flag d]
  (let [i (.indexOf argv flag)] (if (neg? i) d (nth argv (inc i) d))))

(def repo-root (opt "--repo" "orgs/kotoba-lang/global-accounts-datoms"))
(def out-dir   (opt "--out-dir" "/tmp/publisher-census"))

(defn- refuse! [msg]
  (println (str "REFUSED\t" msg))
  (println "Refusing to write an export: the measurement did not run.")
  (.exit js/process 2))

;; ── 語彙（宣言。導出ではない） ───────────────────────────────────────────────
;;
;; 出所: `:service/software` の実分布（344 種、26,406 host）に対して、上位の
;; 実装がどの発行形態かで割った。tail は意図的に unknown に落ちる。

(def software->category
  {;; 長文の発行 —— 「ブロガー」
   "wordpress" "blog" "ghost" "blog" "writefreely" "blog" "plume" "blog"
   "sutty-distributed-press" "blog" "micro.blog" "blog"
   ;; 短文・相互接続 —— fediverse のマイクロブログ族
   "mastodon" "social" "gotosocial" "social" "misskey" "social" "pleroma" "social"
   "akkoma" "social" "sharkey" "social" "friendica" "social" "snac" "social"
   "hometown" "social" "iceshrimp" "social" "iceshrimp.net" "social"
   "cherrypick" "social" "mitra" "social" "wafrn" "social" "hollo" "social"
   "bonfire" "social" "hubzilla" "social"
   ;; スレッド型の集約 —— 「掲示板」
   "lemmy" "forum" "piefed" "forum" "kbin" "forum" "mbin" "forum"
   ;; 音声・映像・画像 —— 「メディア」
   "peertube" "media" "owncast" "media" "pixelfed" "media" "funkwhale" "media"
   "castopod" "media"
   ;; 予定・書誌
   "gancio" "events" "mobilizon" "events" "bookwyrm" "books"})

(defn category-of [software]
  (or (get software->category (some-> software str/lower-case)) "unknown"))

;; ── 読み込み ────────────────────────────────────────────────────────────────

(def service-files
  [["nodeinfo"      "data/corpus/nodeinfo/services.edn"]
   ["directory.plc" "data/corpus/directory.plc/services.edn"]])

(defn- read-services [[label rel]]
  (let [p (path/join repo-root rel)]
    (if-not (fs/existsSync p)
      {:label label :path p :services [] :skipped (str "missing: " p)}
      (try
        {:label label :path p
         :services (filter map? (edn/read-string (str (fs/readFileSync p "utf8"))))
         :skipped nil}
        (catch :default e
          {:label label :path p :services [] :skipped (.-message e)})))))

(defn- row [s]
  {"service_id"             (str (:service/id s))
   "domain"                 (str (:service/domain s))
   "directory"              (str (:service/directory s))
   "software"               (some-> (:service/software s) str)
   "software_version"       (some-> (:service/software-version s) str)
   "protocol"               (some-> (:service/protocol s) name)
   "category"               (category-of (:service/software s))
   "source"                 (some-> (:service/source s) name)
   "observed_at"            (some-> (:service/observed-at s) str)
   "open_registrations"     (boolean (:service/open-registrations? s))
   "local_posts"            (or (:service/local-posts s) 0)
   "users_total"            (or (:service/users-total s) 0)
   "users_active_month"     (or (:service/users-active-month s) 0)
   "users_active_halfyear"  (or (:service/users-active-halfyear s) 0)})

(defn -main []
  (when-not (fs/existsSync repo-root)
    (refuse! (str "corpus repo not checked out: " repo-root)))
  (let [reads (mapv read-services service-files)
        services (mapcat :services reads)
        skipped (filter :skipped reads)]
    (when (zero? (count services))
      (refuse! (str "no services readable from " (count service-files) " file(s): "
                    (str/join "; " (map #(str (:label %) " " (:skipped %)) reads)))))
    (fs/mkdirSync out-dir #js {:recursive true})
    (let [rows (mapv row services)
          by-cat (frequencies (map #(get % "category") rows))
          by-src (frequencies (map #(get % "source") rows))
          unknown (get by-cat "unknown" 0)]
      (fs/writeFileSync (path/join out-dir "publisher_service.json")
                        (js/JSON.stringify (clj->js rows)))
      ;; 語彙そのものを lake に載せる。分類の根拠を後から監査できるようにする
      ;; ため —— category 列だけを載せると、なぜその箱なのかが lake の外に残る。
      (fs/writeFileSync
       (path/join out-dir "publisher_category.json")
       (js/JSON.stringify
        (clj->js (mapv (fn [[sw cat]] {"software" sw "category" cat})
                       (sort software->category)))))
      ;; coverage —— 分母と、読めなかったもの。
      (fs/writeFileSync
       (path/join out-dir "publisher_coverage.json")
       (js/JSON.stringify
        (clj->js [{"services_total" (count rows)
                   "categories_declared" (count (distinct (vals software->category)))
                   "software_distinct" (count (distinct (keep #(get % "software") rows)))
                   "unclassified" unknown
                   "by_category" (pr-str (sort-by (comp - val) by-cat))
                   "by_source" (pr-str by-src)
                   "files_read" (count (remove :skipped reads))
                   "files_skipped" (count skipped)
                   "skipped_detail" (pr-str (mapv #(str (:label %) ": " (:skipped %)) skipped))
                   "accounts_excluded" "account rows are deliberately not exported (CLAUDE.md: personal identifiers stay out of the shared query working set)"}])))
      (fs/writeFileSync
       (path/join out-dir "publishers.spec.json")
       (js/JSON.stringify
        (clj->js {"_comment" "Written by scripts/publisher-census-datalake-export.cljk, next to its data, so exporter and spec cannot drift."
                  "namespace" "cloud_itonami"
                  "tables"
                  [{"file" "publisher_service.json" "table" "publisher_service"
                    "int_columns" ["local_posts" "users_total"
                                   "users_active_month" "users_active_halfyear"]}
                   {"file" "publisher_category.json" "table" "publisher_category"
                    "int_columns" []}
                   {"file" "publisher_coverage.json" "table" "publisher_coverage"
                    "int_columns" ["services_total" "categories_declared"
                                   "software_distinct" "unclassified"
                                   "files_read" "files_skipped"]}]})
        nil 2))
      (println (str "SERVICES\t" (count rows)))
      (println (str "FILES\t" (count (remove :skipped reads)) " read, " (count skipped) " skipped"))
      (doseq [r skipped] (println (str "  SKIPPED\t" (:label r) "\t" (:skipped r))))
      (println (str "BY-SOURCE\t" (pr-str by-src)))
      (doseq [[c n] (sort-by (comp - val) by-cat)]
        (println (str "  " (.padEnd c 10) n (when (= c "unknown") "\t← 語彙に無い software。近い箱に入れていない"))))
      (println (str "UNCLASSIFIED\t" unknown " of " (count rows)
                    " (" (.toFixed (* 100.0 (/ unknown (count rows))) 1) "%)"))
      (println (str "OUT\t" out-dir))
      (.exit js/process 0))))

(-main)
