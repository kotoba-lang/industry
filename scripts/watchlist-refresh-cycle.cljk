#!/usr/bin/env kbb
;; watchlist-refresh-cycle.cljs — 制裁リスト snapshot を上流から取り直し、
;; 検査を通し、着地させ、3 つの投影（git / R2 objects / Iceberg）を揃える。
;;
;;   kbb --backend sci scripts/watchlist-refresh-cycle.cljk [--dry-run] [--max-drop-pct 10] [--skip-datalake]
;;
;; ## なぜ要るか
;;
;; snapshot は 2026-07-19 から 2026-08-26 まで 38 日古いままだった。
;; `scripts/refresh_lists.cljs` は在って動いていた —— 誰も回していなかっただけ。
;; `watchlist-snapshot-freshness` gate が古さを**赤くする**側で、これが**緑に
;; 戻す**側。片方だけでは意味がない: 直せない赤は劇場で、見えない古さは嘘。
;;
;; ## 押す前に必ず通す 2 つの関門
;;
;; 1. **件数の ratchet。** ある source の entity 数が前回より `--max-drop-pct`
;;    以上減ったら、commit も push もせずに中止する。上流が schema を変えると
;;    parser は例外を投げずに **黙って少ない list を返す** —— それは fetch 失敗
;;    より危険で、「制裁対象ではない」という答えが増えるからである。
;; 2. **両ランタイムの suite。** JVM と nbb の両方。`.cljc` を片方でしか測らない
;;    ことが実際に欠陥を通した（watchlist.match/char-code を見よ）。
;;
;; ## 部分的な成功は部分的だと報告する
;;
;; 段は 8 つあり、各段の結果を表で出す。R2 や Iceberg が資格情報で落ちても、
;; refresh と検査と着地は成功しているなら成功と書く —— **全部を失敗に丸めると、
;; 次に読む人がどこから再開すればよいか分からなくなる。** 逆に、どれか 1 つでも
;; 落ちていれば exit は非ゼロにする。
;;
;; ## launchd 下の既知の制約
;;
;; Keychain は launchd から読めないことがある（ADR-2607178000）。その場合
;; datalake の段だけが落ち、他は通る —— それを「全部だめ」と書かないのが上の
;; 方針の理由。token をファイルに書き出して回避しない（資格情報の平文コピーを
;; 増やす）。

(ns watchlist-refresh-cycle
  (:require ["node:child_process" :as cp]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]
            [cljs.reader :as edn]
            [clojure.string :as str]))

(def argv (vec (drop 2 (js->clj (.-argv js/process)))))
(defn- flag [n] (let [i (.indexOf (clj->js argv) n)]
                  (when (and (>= i 0) (< (inc i) (count argv))) (nth argv (inc i)))))
(defn- has? [n] (>= (.indexOf (clj->js argv) n) 0))

(def dry-run? (has? "--dry-run"))
(def skip-datalake? (has? "--skip-datalake"))
(def max-drop-pct (js/parseFloat (or (flag "--max-drop-pct") "10")))
(def root (or (flag "--root") (path/resolve (path/dirname *file*) "..")))
(def child (path/join root "orgs" "kotoba-lang" "watchlist-screen"))
(def bucket (or (flag "--bucket") "watchlist-snapshots"))

(defn- sh
  "Run a command, capturing both streams. Returns {:status :out :err}.

   stderr is KEPT, not reduced to the status code -- a step that records only
   the exit code cannot say why, even when the reason is in the output."
  [cmd args opts]
  (let [r (cp/spawnSync cmd (clj->js args)
                        (clj->js (merge {:encoding "utf8" :maxBuffer (* 64 1024 1024)} opts)))]
    {:status (or (.-status r) 1) :out (str (.-stdout r)) :err (str (.-stderr r))}))

(def steps (atom []))
(defn- record! [name ok? detail]
  (swap! steps conj {:step name :ok ok? :detail detail})
  (println (str (if ok? "OK   " "FAIL ") name (when (seq detail) (str "  -- " detail)))))

(defn- counts-in [dir]
  (into {} (keep (fn [f]
                   (when-let [s (second (re-matches #"(.+)\.manifest\.edn" f))]
                     (let [m (edn/read-string (fs/readFileSync (path/join dir f) "utf8"))]
                       [s {:count (:manifest/entity-count m) :sha (:manifest/sha256 m)}])))
                 (fs/readdirSync dir))))

(defn- die! [msg]
  (println "ABORT:" msg)
  (println (str "STEPS\t" (count (filter :ok @steps)) "/" (count @steps) "\tok"))
  (js/process.exit 1))

(defn -main []
  (when-not (fs/existsSync child) (die! (str "no checkout at " child)))
  (let [wt (path/join (fs/mkdtempSync (path/join (os/tmpdir) "watchlist-cycle-")) "wt")
        branch (str "agent/watchlist-refresh-" (subs (.toISOString (js/Date.)) 0 10))
        cleanup! (fn [] (sh "git" ["-C" child "worktree" "remove" wt "--force"] {})
                        (sh "git" ["-C" child "branch" "-D" branch] {}))]
    ;; 1. a worktree of origin/main, outside the superproject. Never the shared
    ;;    checkout: another session switching branches there would silently roll
    ;;    back an uncommitted refresh.
    (sh "git" ["-C" child "fetch" "origin"] {})
    (let [r (sh "git" ["-C" child "worktree" "add" "-b" branch wt "origin/main"] {})]
      (when-not (zero? (:status r)) (die! (str "worktree add failed: " (:err r))))
      (record! "worktree" true wt))

    (let [lists (path/join wt "resources" "watchlist" "lists")
          before (counts-in lists)
          cp-out (sh "clojure" ["-Spath"] {:cwd wt})
          classpath (str/trim (:out cp-out))]
      (when-not (zero? (:status cp-out)) (cleanup!) (die! (str "kbb -Spath failed: " (:err cp-out))))

      ;; 2. refresh from upstream
      (let [r (sh "nbb" ["-cp" classpath "scripts/refresh_lists.cljs"] {:cwd wt})]
        (print (:out r))
        (when-not (zero? (:status r)) (cleanup!) (die! (str "refresh failed: " (:err r))))
        (record! "refresh" true (str/replace (str/trim (:out r)) "\n" " | ")))

      ;; 3. the ratchet. An upstream schema change makes the parser return a
      ;;    SMALLER list without throwing, and a smaller sanctions list means
      ;;    more "not designated" answers. That must not land unattended.
      (let [after (counts-in lists)
            drops (keep (fn [[s {:keys [count]}]]
                          (let [old (get-in before [s :count])]
                            (when (and old count (pos? old))
                              (let [pct (* 100.0 (/ (- old count) old))]
                                (when (> pct max-drop-pct)
                                  (str s ": " old " -> " count " (-" (.toFixed pct 1) "%)"))))))
                        after)]
        (if (seq drops)
          (do (record! "count-ratchet" false (str/join "; " drops))
              (cleanup!)
              (die! (str "entity count dropped more than " max-drop-pct "% -- refusing to land. "
                         "Check the upstream schema before overriding.")))
          (record! "count-ratchet" true
                   (str/join " " (map (fn [[s {:keys [count]}]]
                                        (str s "=" (get-in before [s :count]) "->" count))
                                      (sort-by key after))))))

      ;; 4. both suites, before anything is pushed
      (let [j (sh "clojure" ["-M:test"] {:cwd wt})]
        (when-not (zero? (:status j)) (cleanup!) (die! (str "JVM suite failed:\n" (:out j))))
        (record! "jvm-suite" true (last (remove str/blank? (str/split-lines (:out j))))))
      (let [n (sh "nbb" ["-cp" (str "test:" classpath) "test/run.cljs"] {:cwd wt})]
        (when-not (zero? (:status n)) (cleanup!) (die! (str "nbb suite failed:\n" (:out n))))
        (record! "nbb-suite" true (last (remove str/blank? (str/split-lines (:out n))))))

      (when dry-run?
        (cleanup!)
        (println "DRY RUN -- stopping before commit. Nothing was pushed or published.")
        (println (str "STEPS\t" (count (filter :ok @steps)) "/" (count @steps) "\tok"))
        (js/process.exit 0))

      ;; 5. land
      (let [st (sh "git" ["-C" wt "status" "--porcelain" "resources"] {})]
        (if (str/blank? (:out st))
          (record! "commit" true "no change in resources -- nothing to land")
          (let [msg (str "chore(data): scheduled watchlist refresh\n\n"
                         "Written by scripts/watchlist-refresh-cycle.cljk. Counts and source\n"
                         "hashes are in resources/watchlist/lists/*.manifest.edn; the count\n"
                         "ratchet (max " max-drop-pct "% drop) and both test suites passed\n"
                         "before this commit was made.\n")]
            (sh "git" ["-C" wt "add" "resources"] {})
            (let [c (sh "git" ["-C" wt "commit" "-m" msg] {})]
              (when-not (zero? (:status c)) (cleanup!) (die! (str "commit failed: " (:err c)))))
            (let [p (sh "git" ["-C" wt "push" "origin" branch] {})]
              (when-not (zero? (:status p)) (cleanup!) (die! (str "push failed: " (:err p)))))
            (let [m (sh "gh" ["api" "repos/kotoba-lang/watchlist-screen/merges"
                              "-f" "base=main" "-f" (str "head=" branch)
                              "-f" "commit_message=Merge scheduled watchlist refresh"
                              "--jq" ".sha"] {})]
              (when-not (zero? (:status m)) (cleanup!) (die! (str "merge failed: " (:err m))))
              (record! "commit" true (str "merged " (subs (str/trim (:out m)) 0 12)))
              ;; 6. the pin, or the fleet gate keeps reading the old tip
              (let [pin (sh "nbb" [(path/join root "scripts" "west-pin-put.cljk")
                                   "watchlist-screen" (str/trim (:out m))] {:cwd root})]
                (record! "west-pin" (zero? (:status pin))
                         (str/trim (or (last (remove str/blank? (str/split-lines (:out pin)))) (:err pin))))))))
        (sh "git" ["-C" child "fetch" "origin"] {})
        (sh "git" ["-C" child "merge" "--ff-only" "origin/main"] {}))

      ;; 7. R2 objects
      (let [r (sh "nbb" ["-cp" classpath "scripts/publish_r2.cljs" "--bucket" bucket] {:cwd wt})]
        (record! "r2-objects" (zero? (:status r))
                 (str/trim (or (last (remove str/blank? (str/split-lines (:out r))))
                               (:err r)))))

      ;; 8. Iceberg. Last on purpose: it is the step most likely to fail on a
      ;;    credential under launchd, and everything above it is already safe.
      (if skip-datalake?
        (record! "iceberg" true "skipped by --skip-datalake")
        (let [out (fs/mkdtempSync (path/join (os/tmpdir) "watchlist-dl-"))
              e (sh "nbb" ["-cp" (path/join wt "src")
                           (path/join root "scripts" "watchlist-datalake-export.cljk")
                           "--repo" wt "--out-dir" out] {:cwd root})]
          (if-not (zero? (:status e))
            (record! "iceberg" false (str "export failed: " (:err e)))
            (let [s (sh "python3" [(path/join root "scripts" "datalake-sync.py")
                                   "--spec" (path/join out "watchlist.spec.json")
                                   "--in-dir" out] {:cwd root})]
              (record! "iceberg" (zero? (:status s))
                       (str/trim (or (last (remove str/blank? (str/split-lines (:out s)))) (:err s))))))))

      (cleanup!)
      (let [ok (count (filter :ok @steps))]
        (println (str "STEPS\t" ok "/" (count @steps) "\tok"))
        (js/process.exit (if (= ok (count @steps)) 0 1))))))

(-main)
