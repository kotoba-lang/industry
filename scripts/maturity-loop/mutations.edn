  ;; 経由で赤くなるところを見たもの。

  {:repo "orgs/kotoba-lang/physics"
   :label "布と粒子 —— 見た目では気づけない保存量と記帳"
   :cmd ["clojure" "-M:test"]
   :green-marker "0 failures, 0 errors"
   :mutations
   [{:id :physics/xpbd-lambda-not-accumulated
     :why "XPBD の λ をステップ内で累積すること。毎パス現在の違反量から作り直すと compliance が「パスごとの緩和係数」になり、反復を重ねれば違反はゼロに寄る —— **柔らかいと宣言した布が、solver 設定を変えただけで剛体に近づく**。実装当時、docstring が iteration-independence を主張する一方で実装はそれを持っていなかった"
     :file "src/kotoba/physics/cloth.cljc"
     :find "(assoc lambdas k (+ lambda dlambda))"
     :replace "lambdas"
     :must-fail ["compliance-softens-without-depending-on-the-iteration-count"]}

    {:id :physics/cloth-mass-weighting
     :why "拘束が 2 粒子を**質量重み付きで**逆向きに動かすこと。**この mutation は最初 噛まなかった** —— 重心のテストが「拘束が全部満たされた格子・重力なし」から始めており、projection の補正が常に 0 で、重み付けが何であれ重心は動きようがなかった。テストが何も測らずに緑だった典型で、この harness が見つけた（2026-08-24）。1 粒子をずらす fixture を足して初めて噛む。なおその fixture の最初の版も誤りで、position だけ動かすと Verlet では速度を与えたことになり、正しい実装でも重心が等速で動いた（0.2514→0.3208）—— previous も一緒に動かす"
     :file "src/kotoba/physics/cloth.cljc"
     :find "(update-in [i :particle/position] v- (vs n (* wi dlambda)))"
     :replace "(update-in [i :particle/position] v- (vs n (* 0.5 dlambda)))"
     :must-fail ["a-free-cloth-does-not-move-its-own-centre-of-mass"]}

    {:id :physics/emission-drops-the-remainder
     :why "放出はレートであってフレーム当たりの個数ではないこと。秒 30 個・60fps はフレーム 0.5 個で、端数を捨てる実装は**永久に 0 個**放出する —— バグではなく「調整の問題」に見えるので数週間残る"
     :file "src/kotoba/physics/particles.cljc"
     :find "(+ (:particles/pending sys) (* (:particles/rate sys) dt))"
     :replace "(* (:particles/rate sys) dt)"
     :must-fail ["emission-is-a-rate-not-a-per-frame-count"]}]}

