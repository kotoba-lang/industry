   ;; この repo の宣言は 3 面に割れている: `actor-manifest.jsonld`（surface と
   ;; capability と governance rule）、`.well-known/did.json`（配信される名乗り）、
   ;; `src/graph_sos_intel/murakumo.cljc`（gate と cell）。**どの面も他の面を
   ;; 見ていない**ので、面と面のあいだの事実はどこにも属さず、片方だけ動いても
   ;; 誰も気づかない。
   ;;
   ;; 実測 2026-09-03: 9 個の cell は手書きに見えて、実際は manifest の
   ;; xrpc nsid 3 + requiredCollections 2 + requiredLoops 4 から機械的に導ける
   ;; （legacy-cell は同じ名前の `.` を `-` にしたもの）。導出できることを検査
   ;; すると、**どちら側が動いても**赤くなる。
   ;;
   ;; 一致を pin しているものと、**不一致**を pin しているものが混ざっている
   ;; （2 つの DID は今も食い違っている）。どちらも観測された値として同じやり方で
   ;; pin するので、赤は「壊れた」ではなく「動いた」を意味する。
   ;;
   ;; 走らないテストの側: `actor-manifest.test.ts` は package.json を持たず
   ;; `npx --yes vitest` が network に届く環境でしか走らない。オフラインでは
   ;; 何も検査しないまま「テストが在る」ように見えるので、その literal が
   ;; manifest と一致していることだけは、こちら側で offline に保つ。
   :cmd ["nbb" "--classpath" "src:test" "run_tests.cljs"]
   :green-marker "graph-sos-intel actor: all green"
   :mutations
   ;; 14 件とも 2026-09-03 に赤くなるところを見た。推測で足したものは無い。
   [;; ── gate（緩む方向）──────────────────────────────────────────────
    {:id :gsi/presence-counts-as-attestation
     :why (str "「キーが在れば attest 済み」に緩める。`{:no-probing-baseline false}` は "
               "『測ったうえで満たしていない』という最も強い否定なのに通る。"
               "いま守っているのは `gate-value` の `or` である —— そこで false が "
               "nil に潰れる。`boolean` を `some?` に変えても**この検査は赤くならない**")
     :file "src/graph_sos_intel/murakumo.cljc"
     :find "(remove #(boolean (gate-value attestations %)))"
     :replace "(remove #(or (contains? attestations %) (boolean (gate-value attestations %))))"
     :must-fail ["an-attestation-that-is-explicitly-false-does-not-count-as-attested"]}

    {:id :gsi/string-attestation-shape-dropped
     :why (str "attestation の受け口を 1 形だけ落とす。その形で attest している"
               "呼び出し側**だけ**が黙って全部 blocked になる —— 安全側に倒れるので"
               "誰も気づかない")
     :file "src/graph_sos_intel/murakumo.cljc"
     :find "      (get attestations (name gate))\n"
     :replace ""
     :must-fail ["every-attestation-shape-is-accepted"]}

    {:id :gsi/blocked-plan-carries-records
     :why (str "『plan は作るが実行しない』形にすると、blocked でも計算済みの record が"
