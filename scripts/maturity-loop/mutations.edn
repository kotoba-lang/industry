     :find "id = \"go_emotions\"\nlane = \"hf\"\nrole = \"distillation_input\""
     :replace "id = \"go_emotions\"\nlane = \"hf\"\nrole = \"training_label\""
     :must-fail ["the-emotion-expert-trains-only-on-hume-distilled-labels"]}

    {:id :llm-dataset/world-source-loses-its-teacher
     :why "world expert の supervision は teacher の出力なので、その ToS が唯一の
