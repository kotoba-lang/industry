     :file "corpus/manifest.toml"
     :find "teacher = \"marble\""
     :replace "teacher = \"\""
     :must-fail ["the-world-expert-names-its-teacher"]}

    {:id :llm-dataset/ingest-writes-outside-the-modality-dir
     :why "out_dir（書く場所）と mix の path（読む場所）は別々に同じ道を計算して
           いる。一致させているものが無かった"
     :file "scripts/corpus/_manifest.py"
     :find "d = DATASET_ROOT / \"corpus\" / source[\"modality\"] / source[\"id\"]"
     :replace "d = DATASET_ROOT / \"corpus\" / source[\"id\"]"
     :must-fail ["the-mix-path-agrees-with-the-ingest-output-directory"]}

    {:id :llm-dataset/mix-hardcodes-the-role
     :why "manifest では distillation_input のままなのに、学習が読む mix では
