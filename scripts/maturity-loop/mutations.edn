     :replace "         {:status :blocked\n          :effects []\n          :records (vec (records-for spec input))}"
     :must-fail ["a-blocked-plan-carries-no-records-at-all"]}

    {:id :jp-ashiba/unknown-cell-plans-silently
     :why "打ち間違えた cell 名が nil spec のまま進むと、required-gates が nil ＝ missing 無し ＝ **:ready** になる。effect は 0 件なので実害は出ないが、status だけ見る呼び出し側には『gate を通った』と見える。throw を外すだけでその状態になる"
     :file "src/jp_ashiba/murakumo.cljc"
     :find "    (when-not spec\n      (throw (ex-info \"unknown cell\" {:cell cell-key})))"
     :replace "    (when-not spec nil)"
     :must-fail ["an-unknown-cell-throws-instead-of-planning-nothing"]}

    {:id :jp-ashiba/safe-rkey-keeps-path-separators
