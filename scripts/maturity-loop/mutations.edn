;; mutations.edn — 「その拒否は、今も落ちるのか」を繰り返し確かめるための宣言。
;;
;; なぜ要るか。CLAUDE.md は fleet gate について
;; 「**gate は「落ちること」を確かめてから landed とする。落ちない gate は劇場**」
;; と書いている。原則は書かれているが、それを**時間をまたいで保つ機構**が無かった。
;; テストは静かに噛まなくなる —— 実装が変わって経路が通らなくなっても、テストは
;; 緑のままだからである。
;;
;; 2026-08-05 の 1 セッションで、これが 2 回起きた:
;;
;;   1. prolly-tree の inclusion proof を書いたとき、最初の版は descent 規則を
;;      壊しても落ちなかった。木が well-formed なら CID 連鎖だけで inclusion は
;;      健全なので、descent 検査は「本物の拒否」ではなかった。手で木を細工した
;;      shadow-path テストを足して初めて赤くなった。
;;   2. codebase を .cljc にしたとき、cljs テストが f32/f64/i64 の decode を一度も
;;      通っていなかった。`Double/longBitsToDouble` に戻しても cljs は WARNING を
;;      出すだけで通過した（その経路が実行されないので）。
;;
;; どちらも mutation を手で当てて初めて分かった。手でやる限り、次に忘れる。
;;
;; ## 各 mutation の意味
;;
;;   :find / :replace   その1箇所を壊す最小の編集。**壊し方は「JVM 専用に戻す」
;;                      「検査を外す」など、実際に起こりうる退行の形にする** ——
;;                      構文を壊すだけの mutation は「コンパイルが通らない」しか
;;                      証明しない。
;;   :must-fail         この mutation で**必ず赤くなるテスト名**。名前まで見るのは、
;;                      別の理由で赤くなったのを「噛んだ」と誤読しないため。
;;
;; ここに載っているのは **2026-08-05 に実際に赤くなるところを見た** ものだけ。
;; 推測で足さない —— 落ちるのを見ていない mutation を載せると、この仕組み自体が
;; 劇場になる。

{:policy "maturity-loop/mutation/v1"

 ;; 対象 repo は west の pin から解決し、**使い捨て worktree** に checkout して
 ;; そこを壊す。共有 checkout は絶対に触らない —— このマシンは多数の agent
 ;; セッションが並行しており、共有 tree を書き換える定期ジョブは他人の作業を
 ;; 壊す（実測: 2026-08-05 の 1 日で west.yml の pin 退行が 3 回、別々の
 ;; セッションから発生している）。
 :isolation :worktree

 :suites
 [{:repo "orgs/kotoba-lang/langgraph"
   :label "langgraph runtime claims, superstep semantics, thread custody"
   ;; 最初の 4 件は docs/operator-quickstart.md が host 作者に伝える 4 つの
   ;; 実行時の事実（API からは見えない）を守る。prose は黙って腐るので各主張に
   ;; assertion を付け、その assertion 自身がここに在る —— 噛まなくなった
   ;; assertion は prose と同じ速さで腐るから。全て 2026-08-06 に赤くなるのを見た。
   ;; 残り 12 件（2026-08-12）は quickstart とは無関係な、当時どのテストも
   ;; 見ていなかった不変条件。区切りのコメントを参照。
   :cmd ["clojure" "-M:test"]
   :green-marker "0 failures, 0 errors"
   :mutations
   [{:id :langgraph/tick-not-resume-to-completion
     :why "§5.1 `run*` が :done thread で新しい tick を始めること —— 「終わった thread は no-op」に変えると、supervisor が終了するようになった代わりに long-lived agent の次のターンが回らなくなる（実際に起こりうる「冪等にしました」型の退行）"
     :file "src/langgraph/graph.cljc"
     :find "        resume? (and latest\n                     (= :interrupted (:status latest))"
     :replace "        resume? (and latest\n                     (contains? #{:interrupted :done} (:status latest))"
     :must-fail ["run*-is-one-tick-not-resume-to-completion"]}

    {:id :langgraph/claim-table
     :why "§5.2 の表（今 claim するのは mem-checkpointer だけ）が実装と一致していること。backend が protocol を得たら表を直せ、という向きの mutation —— 退行ではなく改良で doc が古くなる方を捕まえる"
     :file "src/langgraph/checkpoint.cljc"
     :find "     (reify Checkpointer\n       (-put! [_ tid {:keys [step state frontier status] :as ckpt}]"
     :replace "     (reify\n       ClaimableCheckpointer\n       (-claim-resume! [_ _ _] true)\n       Checkpointer\n       (-put! [_ tid {:keys [step state frontier status] :as ckpt}]"
     :must-fail ["which-checkpointers-claim"]}

    {:id :langgraph/recursion-limit-throws
     :why "§5.3 再帰上限が throw であって :status ではないこと —— status に「改善」すると、:status しか見ない supervisor は park せず黙って進む"
     :file "src/langgraph/graph.cljc"
     :find "        (> step recursion-limit)\n        (throw (ex-info \"Recursion limit reached\"\n                        {:limit recursion-limit :state state :frontier frontier}))"
     :replace "        (> step recursion-limit)\n        {:state state :events events :status :limit :frontier frontier}"
     :must-fail ["recursion-limit-throws-and-is-not-a-status" "recursion-limit"]}

    {:id :langgraph/history-ascending
     :why "§4 list-checkpoints が :step 昇順であること。この mutation は最初の版のテストを赤くしなかった —— 1 tick しか回しておらず checkpoint が 1 件だったので、順序の assertion が空虚に真だった。full cycle を回すよう直して初めて噛んだ"
     :file "src/langgraph/checkpoint.cljc"
     :find "                (map #(->ckpt (pull dbv '[*] %)))\n                (sort-by :step)\n                vec)"
     :replace "                (map #(->ckpt (pull dbv '[*] %)))\n                reverse\n                vec)"
     :must-fail ["checkpoint-history-is-readable-without-running-the-graph"
                 "interrupt-and-resume-datomic"]}

    ;; ── 以下 12 件は 2026-08-12（成熟度 loop / axis-test）に追加 ────────────
    ;; どれも当時の suite が**一度も見ていなかった**不変条件。それを主張だけで
    ;; 言わないために、各 mutation を追加後の suite と**追加前の suite の両方**へ
    ;; 当てて測った: 12 件とも新 suite だけが赤くなり、旧 suite は緑のままだった。
    ;; 13 件目の候補（mermaid が CompiledGraph を unwrap すること）は逆の結果 ——
    ;; agent-test/viz-smoke が既に赤くなったので、その test ごと採らなかった。

    {:id :langgraph/fan-in-runs-twice
     :why "扇入 —— 同じ superstep の 2 つのノードが同じ後続を指したとき、frontier が重複を潰さないと後続が 2 回走る。ノードは副作用を持つ（model 呼び出し・決済）ので、これは「遅くなる」ではなく「1 論理ステップに対して効果が 2 回」"
     :file "src/langgraph/graph.cljc"
     :find "              next-frontier (vec (distinct next-frontier))"
     :replace "              next-frontier (vec next-frontier)"
     :must-fail ["a-fan-in-node-runs-once-per-superstep-not-once-per-inbound-edge"]}

    {:id :langgraph/interrupt-after-saves-the-old-frontier
     :why "interrupt-after は「そのノードが走った後」に停める。保存する frontier を次のものではなく現在のものにすると、resume でそのノードがもう一度走る —— 人間がその結果を見ている間に、その処理を 2 度実行することになる"
     :file "src/langgraph/graph.cljc"
     :find "            (do (save! checkpointer thread-id\n                       {:step (inc step) :state state' :frontier next-frontier\n                        :status :interrupted})\n                {:state state' :events events' :status :interrupted\n                 :frontier next-frontier})"
     :replace "            (do (save! checkpointer thread-id\n                       {:step (inc step) :state state' :frontier frontier\n                        :status :interrupted})\n                {:state state' :events events' :status :interrupted\n                 :frontier frontier})"
     :must-fail ["interrupt-after-parks-past-the-node-that-tripped-it"]}

    {:id :langgraph/path-map-not-applied
     :why "path-map は router の語彙（\"continue\"/\"stop\"）を node 名へ翻訳する。翻訳を飛ばすと生の文字列が node 表に届き、END も END として認識されない"
     :file "src/langgraph/graph.cljc"
     :find "          out (if path-map (map #(get path-map % %) out) out)"
     :replace "          out out"
     :must-fail ["a-path-map-translates-router-output-and-may-name-end"]}

    {:id :langgraph/non-map-update-replaces-state
     :why "map 以外を返すノード（routing だけを決める guard、logging）の戻り値を新しい state として採ると、蓄積してきた channel が全部消える。しかも :done が返るので静かに壊れる"
     :file "src/langgraph/graph.cljc"
     :find "                       state' (if (map? updates)\n                                (apply-updates channels state updates)\n                                state)"
     :replace "                       state' (if (map? updates)\n                                (apply-updates channels state updates)\n                                (or updates state))"
     :must-fail ["a-node-that-returns-a-non-map-leaves-the-state-alone"]}

    {:id :langgraph/no-entry-point-is-silent
     :why "entry point を書き忘れた graph は frontier が空 —— loop の最初の分岐が :done を返す。何も走らなかった実行を成功として返すのは、投げるより悪い"
     :file "src/langgraph/graph.cljc"
     :find "        (when (empty? entry)\n          (throw (ex-info \"No entry point — call set-entry-point\" {})))"
     :replace "        (when false\n          (throw (ex-info \"No entry point — call set-entry-point\" {})))"
     :must-fail ["a-graph-with-no-entry-point-refuses-to-run"]}

    {:id :langgraph/unknown-node-guard-removed
     :why "存在しない node への edge（typo、消したノードに残った edge）を検出する guard。外すと nil を Runnable として呼ぶことになる"
     :file "src/langgraph/graph.cljc"
     :find "                       _ (when-not f (throw (ex-info \"Unknown node\" {:node node})))"
     :replace "                       _ nil"
     :must-fail ["an-edge-to-a-node-that-was-never-added-is-refused"]}

    {:id :langgraph/every-channel-seeded-with-nil
     :why ":default を宣言していない channel を nil で seed すると、「まだ誰も書いていない」と「誰かが nil を書いた」の区別が全 graph で消える"
     :file "src/langgraph/graph.cljc"
     :find "               (if (contains? spec :default) (assoc m k (:default spec)) m))"
     :replace "               (assoc m k (:default spec)))"
     :must-fail ["only-channels-that-declare-a-default-are-seeded"]}

    {:id :langgraph/update-state-overwrites-what-the-human-saw
     :why "datomic checkpointer は thread/step で 1 行を addressing する。人間の編集を同じ step に書くと upsert になり、**承認した時に人間が見せられていた state が消える**。監査が訊くのはまさにそれ。inc 1 つで、他に誰も見ていない"
     :file "src/langgraph/graph.cljc"
     :find "                                  :step (inc (:step latest))"
     :replace "                                  :step (:step latest)"
     :must-fail ["a-human-edit-does-not-overwrite-the-checkpoint-it-edits"]}

    {:id :langgraph/list-checkpoints-ignores-thread
     :why "thread の境界は where 節 1 本でしかない —— 落としても型も arity も文句を言わない。落ちると list-checkpoints が他人の thread の行を返す"
     :file "src/langgraph/checkpoint.cljc"
     :find "               es (q '[:find [?e ...]\n                       :in $ ?tid\n                       :where [?e :checkpoint/thread ?tid]]"
     :replace "               es (q '[:find [?e ...]\n                       :in $ ?tid\n                       :where [?e :checkpoint/thread _]]"
     :must-fail ["checkpoints-are-scoped-to-the-thread-that-wrote-them"]}

    {:id :langgraph/get-latest-ignores-thread
     :why "同上を -get-latest 側で。scope の無い max はその thread が到達していない step を指し、そこに行が無いので latest を取り違える"
     :file "src/langgraph/checkpoint.cljc"
     :find "               step (q '[:find (max ?s) .\n                         :in $ ?tid\n                         :where [?e :checkpoint/thread ?tid]\n                                [?e :checkpoint/step ?s]]"
     :replace "               step (q '[:find (max ?s) .\n                         :in $ ?tid\n                         :where [?e :checkpoint/thread _]\n                                [?e :checkpoint/step ?s]]"
     :must-fail ["checkpoints-are-scoped-to-the-thread-that-wrote-them"]}

    {:id :langgraph/mermaid-id-not-sanitised
     :why "node 名は Clojure の keyword なのでハイフンが普通（:call-model）。Mermaid の識別子ではないので、そのまま出すと図が壊れる。label は元の名前のままでなければならない（sanitise した名前では grep できない）"
     :file "src/langgraph/viz.cljc"
     :find "    :else (str/replace (name n) #\"[^A-Za-z0-9_]\" \"_\")))"
     :replace "    :else (name n)))"
     :must-fail ["node-ids-are-sanitised-and-labels-are-not"]}

    {:id :langgraph/mermaid-drops-conditional-edges
     :why "router は関数なので静的な図が言えるのは「分岐が在る」ことだけ。それを描かないと、conditional しか持たないノードが行き止まりに見える —— 実際とは逆"
     :file "src/langgraph/viz.cljc"
     :find "               (for [[from _] conditional]\n                 (str \"  \" (node-id from) \" -.->|condition| END\")))]"
     :replace "               nil)]"
     :must-fail ["a-conditional-edge-is-drawn-as-one"]}

    ;; 以下 3 件（2026-08-19）は「mock が実在しない wire contract を模していて、
    ;; 同じだけ間違った古い client と話が合っていたので緑だった」という 1 件の
    ;; 欠陥に対する gate。壊す向きが 3 つあり、3 つとも別々の主張を持つ。
    {:id :langgraph/decode-edn-attr-always-reads
     :why "kotoba substrate 側。wildcard pull は pr-str した値を **既に parse した** 形で返すので、無条件に edn/read-string すると String でない値に当たって ClassCastException。これが 2026-08-19 まで実際に壊れていた向きで、mock が entity_edn を返していたため誰も見ていなかった"
     :file "src/langgraph/checkpoint.cljc"
     :find "  (if (string? v) (edn/read-string v) v))"
     :replace "  (edn/read-string v))"
     :must-fail ["state-round-trips-identically-through-both-substrates" "put-and-get-latest"]}

    {:id :langgraph/decode-edn-attr-never-reads
     :why "in-memory substrate 側。langchain.db は書いたときの EDN 文字列をそのまま返すので、読まないと :state が文字列のまま出てくる。上の mutation と対で、decode-edn-attr が **両方向** を持っていることを示す —— 片側だけ赤くなる gate は、その fn が条件分岐である理由を検査していない"
     :file "src/langgraph/checkpoint.cljc"
     :find "  (if (string? v) (edn/read-string v) v))"
     :replace "  v)"
     :must-fail ["state-round-trips-identically-through-both-substrates" "interrupt-and-resume-datomic"]}

    {:id :langgraph/mock-answers-with-entity-edn
     :why "mock 自身の忠実度。datomic.pull がこの名前の field を返すことは一度も無く、返していたのはこの mock だけだった。実装ではなく test を壊す mutation なのは、この反復で直したのが **test が模していた contract** だからで、result_edn が load-bearing でなくなった瞬間に tests は再び fiction に対して緑になる"
     :file "test/langgraph/kotoba_checkpoint_test.cljc"
     :find ":result_edn (wildcard-result-edn (or entity {}))"
     :replace ":entity_edn (wildcard-result-edn (or entity {}))"
     :must-fail ["state-round-trips-identically-through-both-substrates" "put-and-get-latest"]}]}

  {:repo "orgs/kotoba-lang/prolly-tree"
   :label "prolly-tree inclusion proof"
   :cmd ["clojure" "-M:test"]
   :green-marker "0 failures, 0 errors"
   :mutations
   [{:id :prolly/cid-chain
     :why "パスの各ブロックが、直前の段が要求した CID にハッシュすること"
     :file "src/prolly_tree/core.cljc"
     :find "      (let [node (try (verified-node expected (first blocks))"
     :replace "      (let [node (try (ipld/decode (first blocks))"
     :must-fail ["a-well-formed-block-that-lies-about-the-value-is-refused"]}

    {:id :prolly/descent
     :why "「木のどこかにある」ではなく「木が k について言っていること」であること"
     :file "src/prolly_tree/core.cljc"
     :find "            \"internal\" (when (some? more)\n                         (recur (descend-cid (get node \"children\") k) more))"
     :replace "            \"internal\" (when (some? more)\n                         (recur (or (some (fn [c]\n                                            (when (= (ipld/cid (first more)) (child-cid c))\n                                              (child-cid c)))\n                                          (get node \"children\"))\n                                    \"no-such-child\")\n                                more))"
     :must-fail ["a-shadow-path-to-a-second-copy-of-the-key-is-refused"]}

    {:id :prolly/path-ends-at-the-leaf
     :why "leaf に着いたらパスが終わっていること —— 余分なブロックを黙って無視する verifier は、提出されたものと検証したものが違う"
     :file "src/prolly_tree/core.cljc"
     :find "            \"leaf\" (when (nil? more)"
     :replace "            \"leaf\" (when true"
     :must-fail ["a-truncated-or-padded-path-is-refused"]}

    {:id :prolly/value-is-wrapped
     :why "「不在」と「値が nil で存在」が区別できること —— 裸で返す verifier はこの 2 つを同じ nil にするので、呼び手は証明が成立しなかったのか値が nil だったのか判別できない"
     :file "src/prolly_tree/core.cljc"
     :find "                               {:value (second entry)}))"
     :replace "                               (second entry)))"
     :must-fail ["proof-carries-a-nil-value-without-becoming-a-refusal"]}]}

  {:repo "orgs/kotoba-lang/inga"
   :label "inga two-root state + metered emission"
   :cmd ["clojure" "-M:test"]
   :green-marker "0 failures, 0 errors"
   :mutations
   [{:id :inga/actors-in-root
     :why "actor 木が state root に commit されていること（されていなければ actor 木は作って捨てているだけ）"
     :file "src/inga/state.cljc"
     :find "   \"actors\" (some-> actors-cid ipld/link)"
     :replace "   \"actors\" nil"
     :must-fail ["actors-are-covered-by-the-root"]}

    {:id :inga/emit-retract
     :why "投影が現在値であって履歴でないこと（arrangement は quad store なので assert だけだと値が 2 つ生える）"
     :file "src/inga/state.cljc"
     :find "  (vec (concat\n        (for [[p k] actor-fields :when (some? (get prev k))]\n          {:op :retract :s address :p p :o (get prev k)})\n        (for [[p k] actor-fields :when (some? (get next k))]"
     :replace "  (vec (concat\n        (for [[p k] actor-fields :when (some? (get next k))]"
     :must-fail ["default-emit-projects-the-current-state-not-its-history"
                 "actor-delete-removes-from-both-roots"]}

    {:id :inga/emission-charged
     :why "emission が課金されること（無料だと fuel 台帳が実際の仕事量と食い違う）"
     :file "src/inga/state.cljc"
     :find "                   :expansion-cost-fn\n                   (fn [s o] (reduce + 0 (map cost-fn (emitted-ops emit-fn s o))))"
     :replace "                   :expansion-cost-fn (fn [_ _] 0)"
     :must-fail ["emission-is-charged-not-free"
                 "an-op-whose-emission-does-not-fit-is-not-applied-at-all"]}

    {:id :inga/emission-applied
     :why "投影が root に入ること（入らなければ非決定的な emission でも replica は割れない）"
     :file "src/inga/state.cljc"
     :find "      (if-not emit-fn\n        state'\n        (update state' :db #(reduce apply-datom-op % (emit-fn o prev next))))"
     :replace "      state'"
     :must-fail ["emission-is-deterministic-or-replicas-split"]}

    {:id :inga/hydrate-returns-both-roots
     :why "cold reader が CID だけから両方の根を受け取ること —— actor を黙って落とす hydrate は、例外ではなく「actor が 0 件の state」を返すので呼び手から見て正常に見える"
     :file "src/inga/state.cljc"
     :find "       #?(:clj {:db (arr/restore get-fn datoms-cid decrypt-fn)\n                :actors actors :prev prev}"
     :replace "       #?(:clj {:db (arr/restore get-fn datoms-cid decrypt-fn)\n                :actors {} :prev prev}"
     :must-fail ["a-cold-reader-with-only-the-cid-gets-both-halves"]}]}

  {:repo "orgs/kotoba-lang/codebase"
   :label "codebase portable evaluation"
   ;; cljs 側でしか意味が無い mutation なので、JVM ではなく cljs suite を回す。
   ;; JVM だけ回すと `Double/longBitsToDouble` は当然通ってしまい、この
   ;; mutation は「噛まない」ではなく「間違ったものを測っている」ことになる。
   :cmd ["npm" "run" "test:eval-cljs"]
   :green-marker "ran a definition from its CID alone"
   :npm-install true
   :mutations
   [{:id :codebase/f64-portable
     :why "評価層が ClojureScript で動くこと（f32/f64/i64 の decode を含めて）"
     :file "src/kotoba/codebase/typed_eval.cljc"
     :find "(defn- f64-from-bits [payload]\n  #?(:clj (Double/longBitsToDouble (long payload))\n     :cljs (let [view (js/DataView. (js/ArrayBuffer. 8))]\n             (.setBigInt64 view 0 (js/BigInt payload))\n             (.getFloat64 view 0))))"
     :replace "(defn- f64-from-bits [payload]\n  (Double/longBitsToDouble (long payload)))"
     ;; cljs suite はテスト名を出さず throw で落ちるので、名前ではなく
     ;; 「緑マーカーが出ないこと」で判定する。:must-fail が空なのはその宣言。
     :must-fail []}

    {:id :codebase/coerce-refuses-a-path
     :why "cljs には fallback する先の filesystem が無いこと —— path を黙って通すと、backend seam を作った意味そのものが消える（呼び手が自分の ICodebaseStore を渡さなくても動いたように見えてしまう）"
     :file "src/kotoba/codebase/backend.cljc"
