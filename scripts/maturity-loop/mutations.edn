   ;; 観るまで分からない。
   ;;
   ;; この repo の pin は west entry 名が `cloud-itonami-mangaka-data`、path の
   ;; basename が `mangaka-data` で食い違う。run.cljs の `pinned-sha` は 2026-08-19
   ;; まで `- name:` で引いていたので、**この suite を足しても skip されて何も
   ;; 検査されなかった**（同じ食い違いが 4,208 entry 中 60 件ある）。
   ;;
   ;; annex の実体は既定で不在（symlink が dangling する）。それは custody の話で
   ;; あって参照整合性の破れではないので、テスト側は lstat で「dataset が宣言して
   ;; いるか」を見る。fleet の worktree でも実体は無いままなので、この suite は
   ;; `annex-get` を要求しない。
   :cmd ["nbb" "--classpath" "test" "run_tests.cljs"]
   :green-marker "mangaka-data corpus: all green"
   ;; 全て 2026-08-19 に実際に赤くなるところを見た。
   :mutations
   [{:id :mangaka-data/ref-renamed-without-updating-the-scenario
     :why "character ref のファイル名を変えて scenario の :ref を直し忘れる形。生成器は参照先を見つけられないまま進み、その cast だけ ref 無しで描かれる"
     :file "ghosthacker/resources/scenarios/scenario-gh-arc0-0-p03.edn"
     :find ":ref \"saki.png\"" :replace ":ref \"saki-v2.png\""
     :must-fail ["scenario-cast-refs-are-declared-in-the-dataset"]}

    {:id :mangaka-data/beat-claims-a-panel-size-the-layout-does-not-have
     :why "**scenario 冒頭のコメントが実障害として記録している形。** wide のつもりで撮った shot が half のコマに入ると、cover-crop の上下トリムで顔が切れる。値としてはどちらも legal なので、突き合わせない限り誰も気づかない"
     :file "ghosthacker/resources/scenarios/scenario-gh-arc0-0-p00.edn"
     :find "{:beat/id 2 :panels [2] :panel-size \"wide\""
     :replace "{:beat/id 2 :panels [2] :panel-size \"half\""
     :must-fail ["scenario-beats-target-panels-that-exist-at-the-size-they-claim"]}

    {:id :mangaka-data/beat-targets-a-panel-that-does-not-exist
     :why "layout からコマを 1 つ削ったのに beat の索引を詰め忘れる形。範囲外の索引は nil を返すだけなので、そのコマが黙って落ちる"
     :file "ghosthacker/resources/scenarios/scenario-gh-arc0-0-p00.edn"
     :find "{:beat/id 3 :panels [3]" :replace "{:beat/id 3 :panels [4]"
     :must-fail ["scenario-beats-target-panels-that-exist-at-the-size-they-claim"]}

    {:id :mangaka-data/image-slot-used-but-not-declared
     :why "cast を並べ替えて本文の @ImageN を直し忘れる形。生成器は宣言されていない slot を渡され、その beat だけ別人が描かれるか誰も描かれない"
     :file "ghosthacker/resources/scenarios/scenario-gh-arc0-0-p00.edn"
     :find "@Image1 (Yuto) sits up in bed" :replace "@Image2 (Yuto) sits up in bed"
     :must-fail ["scenario-image-slots-are-declared-and-used"]}

    {:id :mangaka-data/style-profile-renamed-without-updating-the-mapping
     :why "profile key を改名して :genre->style を直し忘れる形。resolve は nil を返して **:default へ黙って落ちる**ので、その genre の作品だけ作画スタイルが入れ替わる"
     :file "style-registry.edn"
     :find "\"バトル\"              :shonen-action-ink}"
     :replace "\"バトル\"              :shonen-action}"
     :must-fail ["style-registry-resolves-every-profile-it-names"]}

    {:id :mangaka-data/one-language-loses-a-shot
     :why "翻訳ジョブが 1 行落とす形。その言語版だけカットが 1 つ短くなる —— 気づくにはその言語の回を最後まで観るしかない"
     :file "ghosthacker/episode-11-shotlist-v2.zh.edn"
     :find " {:type \"dialogue\", :speaker \"shiro\", :text \"进去看看。这里不对劲。\", :shiro_emo \"normal\", :pico_emo \"confused\", :sfx nil, :fx nil}\n"
     :replace ""
     :must-fail ["localized-shotlists-share-one-spine"]}

    {:id :mangaka-data/translation-job-emitted-an-empty-line
     :why "翻訳が空文字を返す形。EDN としては正しく本数も合っているので、台詞が 1 つ消えていることは再生するまで分からない"
     :file "ghosthacker/episode-12-shotlist-v2.fr.edn"
     :find ":text \"D'abord le Zombie ! Réveil Sauvage !\"" :replace ":text \"\""
     :must-fail ["localized-shotlists-are-actually-localized"]}

    {:id :mangaka-data/enumeration-narrowed-so-json-is-never-read
     :why "**この suite の沈黙対策そのものを撃つ。** 列挙を絞ると JSON は 1 件も読まれず、違反 0 件で緑になる —— 『測れなかった』が『問題なし』と同じ顔をする形。件数の床がそれを捕まえることを確かめている"
     :file "test/mangaka_data/corpus_test.cljs"
     :find "#js [\"ls-files\"]" :replace "#js [\"ls-files\" \"*.edn\"]"
     :must-fail ["every-declared-json-document-parses"]}]}

  {:repo "orgs/cloud-itonami/app-animeka"
   :label "app-animeka: does README.md still describe the trees this repo has"
   ;; This repo carries four trees (lg/ Python, lg-clj/ clj port, kotoba/ TS,
   ;; appview/ Cloudflare) and only lg-clj runs. README.md and
   ;; docs/operator-quickstart.md say so with numbers, and the numbers have
   ;; assertions beside them (smoke_test.cljc, "cross-tree claims").
   ;;
   ;; The four mutations below were measured against the suite **before and
   ;; after** those assertions landed, on 2026-08-19: all four bite now, and
   ;; all four left the previous suite green. Nothing else in the repo reads
   ;; lg/langgraph.json or the appview wrangler config, so without these tests
   ;; every one of them is a silent change.
   ;;
   ;; Note the direction. Three of these are the doc going stale because the
   ;; repo got WORSE; the fourth (a wrangler alias becoming relative) is the
   ;; repo getting BETTER. Both must be red, because in both cases README.md
   ;; now says something untrue.
   :cmd ["bb" "lg-clj/run_tests.clj"]
   :green-marker "0 failures, 0 errors"
   :mutations
   [{:id :animeka/declared-graph-the-cljc-tree-does-not-implement
     :why "langgraph.json でグラフ名を変え、cljc 側の追随を忘れる形。dispatch は 27 本のまま緑なので、**config と実装が別の集合を指していること**は誰も見ない"
     :file "lg/langgraph.json"
     :find "    \"publish_episode\":       \"./lg_animeka/graphs/publish_episode.py:GRAPH\""
     :replace "    \"publish_episodes\":      \"./lg_animeka/graphs/publish_episode.py:GRAPH\""
     :must-fail ["cljc-tree-implements-exactly-the-declared-graph-set"
                 "python-tree-is-a-stub-not-a-runtime-in-this-repo"]}

    {:id :animeka/declaration-points-at-a-module-named-something-else
     :why "宣言のキーとモジュール名がずれる形。JSON としては正しく本数も 27 のままなので、**その 1 本だけ import に失敗する**ことは起動するまで分からない"
     :file "lg/langgraph.json"
     :find "    \"health\":            \"./lg_animeka/graphs/health.py:GRAPH\","
     :replace "    \"health\":            \"./lg_animeka/graphs/health_graph.py:GRAPH\","
     :must-fail ["cljc-tree-implements-exactly-the-declared-graph-set"]}

    {:id :animeka/a-declared-graph-quietly-disappears
     :why "宣言が 1 本落ちる形。README.md が引用している 27 という数の床を撃つ —— 数を書いた散文は、数が動いても何も言わない"
     :file "lg/langgraph.json"
     :find "    \"health\":            \"./lg_animeka/graphs/health.py:GRAPH\",\n"
     :replace ""
     :must-fail ["python-tree-is-a-stub-not-a-runtime-in-this-repo"
                 "cljc-tree-implements-exactly-the-declared-graph-set"]}

    {:id :animeka/an-appview-alias-becomes-resolvable
     :why "**改良で doc が古くなる方**。alias を相対パスに直すのは appview を直す第一歩で、退行ではない。それでも README.md の『clone からはビルドできない』は嘘になるので赤くする"
     :file "appview/etzhayyim-wasm-animeka-an1m3k4x/wrangler.jsonc"
     :find "\"pg\": \"/Users/junkawasaki/etzhayyimcojp/etzhayyim-apps-etzhayyimcojp/node_modules/.pnpm/pg@8.20.0/node_modules/pg/lib/index.js\""
     :replace "\"pg\": \"./node_modules/pg/lib/index.js\""
     :must-fail ["appview-cannot-be-built-from-this-repo"]}]}

  {:repo "orgs/cloud-itonami/fm"
   :label "fm —— seed が README の約束を果たすか、設計文書どうしが一致するか"
   ;; 14 兄弟目。中身は seed script 1 本と設計文書 3 本で、mangaka-data と同じく
   ;; 「テストする対象が無い」ように見える repo である。実際には 4 つのファイルが
   ;; 互いに主張し合っており、**どれが破れても何も throw しない**:
   ;;
   ;;   README.md ── 6 つの公開ドメインと 6 つの collection を約束する
   ;;   seed.ts   ── 165 レコードを PDS に書く（その約束を果たすはずのもの）
   ;;   PROJECT.jsonld / actors/*.yaml ── 同じ 9 体の actor を二重に記述する
   ;;
   ;; テストは **実物の seed.ts を走らせる**（Node 26 が型を落とすのでそのまま
   ;; 実行できる）。`fetch` を捕獲器に差し替えてあるのでネットワークには 1 本も
   ;; 出ず、assertion は「実際に書かれるはずのレコード」をそのまま見る。写しを
   ;; 置くと写しの方だけが正しいまま実物が腐るので、写しは持たない。
   ;;
   ;; putRecord は **rkey での upsert** なので、衝突は前のレコードを黙って消す。
   ;; 要求は 165 本出て全部 200 が返り、seed は満額の件数を報告する ——
   ;; **消えた分はどこにも数えられない**。それが :rkey-truncated が撃つ形。
   :cmd ["nbb" "--classpath" "test" "run_tests.cljs"]
   :green-marker "fm seed + blueprint: all green"
   ;; 9 件とも 2026-08-19 に実際に赤くなるところを見た。8 つのテストは全て
   ;; いずれかの mutation に名指しされている（名指しの無いテストを残さない）。
   :mutations
   [{:id :fm/domain-dropped-from-synthetic-kinds
     :why "synthetic の種類を 1 つ間引く形。seed は変わらず『165 件書いた』と報告し、`coverage world --domain government_fund` だけが空を返す —— この repo の存在理由そのものが、成功に見える失敗として消える"
     :file "seed.ts"
     :find "  { slug: 'government', title: 'Development Finance Fund', fundKind: 'government_fund', strategy: 'development-finance', managerType: 'development-finance-manager', regulator: 'Ministry of Finance', sponsorPrefix: 'Public Investment Agency', currency: 'USD', metricType: 'aum', baseAum: 6200000000, baseCommitment: 0 },\n"
     :replace ""
     :must-fail ["every-public-domain-the-readme-names-is-actually-seeded"]}

    {:id :fm/rkey-truncated-for-a-pds-limit
     :why "**退行ではなく『対応』の形。** rkey 長の制限に合わせて切り詰めるのは自然な変更だが、prefix が共通なので全 id が同じ rkey に落ちる。upsert なので要求は全部 200、seed の件数報告も満額のまま、PDS には collection あたり 1 件しか残らない"
     :file "seed.ts"
     :find ".slice(0, 512);"
     :replace ".slice(0, 24);"
     :must-fail ["rkeys-are-unique-so-no-record-silently-overwrites-another"]}

    {:id :fm/fund-renamed-without-updating-the-metric
     :why "fund の id を改名して METRICS 側を直し忘れる形。孤児の metric が PDS に残り、fund グラフを辿った側が nil に当たる"
     :file "seed.ts"
     :find "    fundId: 'swf-norway-gpfg',\n    name: 'Government Pension Fund Global',"
     :replace "    fundId: 'swf-norway-gpfg-2026',\n    name: 'Government Pension Fund Global',"
     :must-fail ["every-reference-resolves-to-a-record-the-seed-also-writes"]}

    {:id :fm/collection-renamed-without-updating-the-readme
     :why "collection を改名して README を直し忘れる形。読む側は改名を知らないので、そこだけ永久に空に見える。**捕獲の床も同時に撃つ** —— investee が 0 件になると、その集合を歩く検査は空振りして緑になれてしまう"
     :file "seed.ts"
     :find "await putRecord('com.etzhayyim.apps.fund.investee', investee.investeeId, {"
     :replace "await putRecord('com.etzhayyim.apps.fund.portfolio', investee.investeeId, {"
     :must-fail ["readme-promises-the-collections-the-seed-actually-writes"]}

    {:id :fm/actor-regenerated-in-only-one-document
     :why "actor を作り直して suffix が変わり、2 つの設計文書のうち片方だけ更新する形。blueprint が実在しない actor を名指ししたまま composition の実装まで進む"
     :file "actors/fund-management-actor-map.yaml"
     :find "psn-isco-1211-treasury-manager-7df4q796"
     :replace "psn-isco-1211-treasury-manager-9kk2wq31"
     :must-fail ["the-blueprint-and-the-actor-map-name-the-same-actors"]}

    {:id :fm/called-ratio-exceeds-the-commitment
     :why "呼び出し比率を触って約束額を超えさせる形。金額としては不能だが型はどちらもただの number なので、突き合わせない限り NAV / metric の入力になる"
     :file "seed.ts"
     :find "calledAmount: Math.floor((650000000 + series * 55000000) * 0.7),"
     :replace "calledAmount: Math.floor((650000000 + series * 55000000) * 1.3),"
     :must-fail ["called-capital-never-exceeds-the-commitment"]}

    {:id :fm/duplicate-investor-id
     :why "投資家の id をコピペして直し忘れる形。rkey が同じになるので後の 1 件が前を上書きし、commitment の参照先も 1 つ消える"
     :file "seed.ts"
     :find "    investorId: 'lp-calpers',"
     :replace "    investorId: 'lp-abu-dhabi',"
     :must-fail ["ids-are-unique-within-each-collection"]}

    {:id :fm/seed-script-renamed-in-the-project-file
     :why "PROJECT.jsonld が指す seed script のパスが実体からずれる形。JSON としては正しいので、その宣言を読んで実行しようとするまで分からない"
     :file "PROJECT.jsonld"
     :find "\"etzhayyim:seedScript\": \"seed.ts\""
     :replace "\"etzhayyim:seedScript\": \"seed-v2.ts\""
     :must-fail ["the-project-file-points-at-a-seed-script-that-exists"]}

    {:id :fm/synthetic-volume-cut-so-collections-go-thin
     :why "**この suite の沈黙対策そのものを撃つ。** synthetic の本数を削ると全 collection が薄くなる。重複も孤児参照も『0 件』になるので、床が無ければ全検査が中身を見ないまま緑になる。件数の床がそれを捕まえることを確かめている"
     :file "seed.ts"
     :find "i < 24; i += 1"
     :replace "i < 2; i += 1"
     :must-fail ["every-public-domain-the-readme-names-is-actually-seeded"]}]}]}
