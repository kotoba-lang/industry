  {:repo "orgs/kotoba-lang/codebase"
   :label "codebase portable evaluation"
   ;; cljs 側でしか意味が無い mutation なので、JVM ではなく cljs suite を回す。
   ;; JVM だけ回すと `Double/longBitsToDouble` は当然通ってしまい、この
   ;; mutation は「噛まない」ではなく「間違ったものを測っている」ことになる。
   :cmd ["npm" "run" "test:eval-cljs"]
   :green-marker "ran a definition from its CID alone"
   :npm-install true
   :mutations
   [{:id :codebase/f64-portable
     :why "評価層が ClojureScript で動くこと（f32/f64/i64 の decode を含めて）"
     :file "src/kotoba/codebase/typed_eval.cljc"
     :find "(defn- f64-from-bits [payload]\n  #?(:clj (Double/longBitsToDouble (long payload))\n     :cljs (let [view (js/DataView. (js/ArrayBuffer. 8))]\n             (.setBigInt64 view 0 (js/BigInt payload))\n             (.getFloat64 view 0))))"
     :replace "(defn- f64-from-bits [payload]\n  (Double/longBitsToDouble (long payload)))"
     ;; cljs suite はテスト名を出さず throw で落ちるので、名前ではなく
     ;; 「緑マーカーが出ないこと」で判定する。:must-fail が空なのはその宣言。
     :must-fail []}

    {:id :codebase/coerce-refuses-a-path
     :why "cljs には fallback する先の filesystem が無いこと —— path を黙って通すと、backend seam を作った意味そのものが消える（呼び手が自分の ICodebaseStore を渡さなくても動いたように見えてしまう）"
     :file "src/kotoba/codebase/backend.cljc"
     ;; 括弧の釣り合いを保つ形で壊す。プレフィックスだけ差し替えると構文エラーに
     ;; なり、「コンパイルが通らない」しか証明しない mutation になる（README の
     ;; 「壊し方は実際に起こりうる退行の形にする」に反する）。
     :find "  (if (store? root)\n    root\n    #?(:clj (filesystem root)\n       :cljs (throw (ex-info \"codebase: no filesystem backend on this platform — pass an ICodebaseStore value\"\n                             {:problem :codebase/no-default-backend\n                              :given (type root)})))))"
     :replace "  (if (store? root)\n    root\n    #?(:clj (filesystem root)\n       :cljs root)))"
     :must-fail []}]}

