               "拾って書ける —— gate を通っていない書き込みが gate の出力から作れる")
     :file "src/graph_sos_intel/murakumo.cljc"
     :find "         {:status :blocked\n          :effects []}"
     :replace "         {:status :blocked\n          :records (vec (records-for spec input))\n          :effects []}"
     :must-fail ["blocked-plans-do-not-carry-records"]}

