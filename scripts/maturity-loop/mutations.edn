     :replace "         {:status :blocked\n          :records (vec (records-for spec input))\n          :effects []}"
     :must-fail ["blocked-plans-do-not-carry-records"]}

    {:id :marine-insurance/effects-stop-being-attributed-to-this-actor
     :why "effect の :actor が他人になると、この gate を通った書き込みが別 actor の名前で台帳に載る"
     :file "src/marine_insurance/murakumo.cljc"
     :find "   :actor actor-did\n   :collection collection"
     :replace "   :actor \"did:web:someone-else.example\"\n   :collection collection"
