;; mutations.edn — 「その拒否は、今も落ちるのか」を繰り返し確かめるための宣言。
;;
;; なぜ要るか。CLAUDE.md は fleet gate について
;; 「**gate は「落ちること」を確かめてから landed とする。落ちない gate は劇場**」
;; と書いている。原則は書かれているが、それを**時間をまたいで保つ機構**が無かった。
;; テストは静かに噛まなくなる —— 実装が変わって経路が通らなくなっても、テストは
;; 緑のままだからである。
;;
;; 2026-08-05 の 1 セッションで、これが 2 回起きた:
;;
;;   1. prolly-tree の inclusion proof を書いたとき、最初の版は descent 規則を
;;      壊しても落ちなかった。木が well-formed なら CID 連鎖だけで inclusion は
;;      健全なので、descent 検査は「本物の拒否」ではなかった。手で木を細工した
;;      shadow-path テストを足して初めて赤くなった。
;;   2. codebase を .cljc にしたとき、cljs テストが f32/f64/i64 の decode を一度も
;;      通っていなかった。`Double/longBitsToDouble` に戻しても cljs は WARNING を
;;      出すだけで通過した（その経路が実行されないので）。
;;
;; どちらも mutation を手で当てて初めて分かった。手でやる限り、次に忘れる。
;;
;; ## 各 mutation の意味
;;
;;   :find / :replace   その1箇所を壊す最小の編集。**壊し方は「JVM 専用に戻す」
;;                      「検査を外す」など、実際に起こりうる退行の形にする** ——
;;                      構文を壊すだけの mutation は「コンパイルが通らない」しか
;;                      証明しない。
;;   :must-fail         この mutation で**必ず赤くなるテスト名**。名前まで見るのは、
;;                      別の理由で赤くなったのを「噛んだ」と誤読しないため。
;;
;; ここに載っているのは **2026-08-05 に実際に赤くなるところを見た** ものだけ。
;; 推測で足さない —— 落ちるのを見ていない mutation を載せると、この仕組み自体が
;; 劇場になる。

{:policy "maturity-loop/mutation/v1"

 ;; 対象 repo は west の pin から解決し、**使い捨て worktree** に checkout して
 ;; そこを壊す。共有 checkout は絶対に触らない —— このマシンは多数の agent
 ;; セッションが並行しており、共有 tree を書き換える定期ジョブは他人の作業を
 ;; 壊す（実測: 2026-08-05 の 1 日で west.yml の pin 退行が 3 回、別々の
 ;; セッションから発生している）。
 :isolation :worktree

 :suites
 [{:repo "orgs/cloud-itonami/smishing"
   :label "smishing read-document —— 実装 0 の repo で、唯一の実行物が本当に動くか"
   ;; この repo は実装を 1 行も持たない。残っているのは記述と宣言だけで、その
   ;; 文書は `*.md.edn`（tx-data）なので **GitHub でも editor でも本文が読めない**。
   ;; docs/read-document.cljs が唯一の読み口で、壊れると
   ;; NOT-MIGRATED-CHARTER-VIOLATION の本文 —— **この repo が存在する理由** ——
   ;; が誰にも読めなくなる。
   ;;
   ;; それまで docs/verify-docs-claims.cljs は `:read-document-tool-present`
   ;; （ファイルが在る）しか測っておらず、tool が出力を丸ごと間違えても 25 claim
   ;; すべてが緑で通った。ADR-2608136000 の 8 問目そのものなので、test は
   ;; **tool を子プロセスで走らせ、exit と出力の両方**を見る。
   ;;
   ;; 6 件とも 2026-09-08 に、当てて赤くなるところを実際に見てから登録した。
   :cmd ["nbb" "test/read_document_test.cljs"]
   :green-marker "read-document: OK"
   :mutations
   [{:id :rd/threshold-raised-to-240
     :note "face-tracker から本文判定の閾値を写して戻す（実際に一度起きた退行の形）。
            この repo の本文は 218 字しかないので、240 にすると本文が metadata に落ちる"
     :file "docs/read-document.cljs"
     :find "(>= (count s) 120)"
     :replace "(>= (count s) 240)"
     :must-fail ["body-threshold-is-exactly-120-characters"
                 "list-mode-separates-body-from-metadata"
                 "body-is-printed-without-its-attribute-name"]}

    ;; ── ここが、この suite が fixture を持つ理由 ──────────────────
    {:id :rd/newline-clause-dropped
     :note "本文判定を長さだけにする。**この repo の実データでは 1 件も分類が動かない**
            —— 本文は 218 字/複数行、metadata の最長は 87 字/1 行なので 87 < 120。
            実データだけで書いた test はこの節を永久に測らず緑を出す。
            test が自分で作る 200 字/1 行の fixture だけがこれを見る"
     :file "docs/read-document.cljs"
     :find "(and (str/includes? s \"\\n\") (>= (count s) 120))"
     :replace "(>= (count s) 120)"
     :must-fail ["body-requires-a-newline-not-only-length"]}

    {:id :rd/attribute-name-dropped
     :note "metadata を属性名なしで出す。どの attr の値かが読めなくなる。
            **境界 test 2 件も巻き込む** —— 本文と metadata を見分ける観測点は
            この接頭辞しか無いので、接頭辞を消すと両者が原理的に区別できなくなる。
            正しい巻き込みなので弱い方の test に寄せて消さず、:also に宣言する"
     :file "docs/read-document.cljs"
     :find "(println (str k \": \" s))"
     :replace "(println s)"
     :must-fail ["metadata-is-printed-with-its-attribute-name"]
     :also ["body-threshold-is-exactly-120-characters"
            "body-requires-a-newline-not-only-length"]}

    {:id :rd/sort-reversed
     :note "短い順にする。本文が先頭に来なくなる"
     :file "docs/read-document.cljs"
     :find "(sort-by (fn [[_ s]] (- (count s))))"
     :replace "(sort-by (fn [[_ s]] (count s)))"
     :must-fail ["longest-attribute-is-printed-first"]}

    ;; ── 「測れなかった」が「測って問題が無かった」と同じ値になる側 ──
    {:id :rd/unreadable-argument-exits-0
     :note "読めない引数を成功として返す。失敗が成功と同じ exit になる"
     :file "docs/read-document.cljs"
     :find "一覧は引数なしで実行する。\"))\n              (.exit js/process 1))"
     :replace "一覧は引数なしで実行する。\"))\n              (.exit js/process 0))"
     :must-fail ["unreadable-argument-exits-1"]}

    {:id :rd/refusal-exits-0
     :note "repo 外の REFUSED を 0 で返す。**測れなかった実行が緑になる**"
     :file "docs/read-document.cljs"
     :find "REFUSED: git ls-files が実行できない（この repo の中で実行しているか）\")\n  (.exit js/process 3))"
     :replace "REFUSED: git ls-files が実行できない（この repo の中で実行しているか）\")\n  (.exit js/process 0))"
     :must-fail ["outside-a-repository-it-refuses-with-3"]}]}

  {:repo "orgs/cloud-itonami/app-bpmn"
   :label "app-bpmn cross-plane —— README が散文で述べている食い違いを、散文の外で保つ"
   ;; この repo の README は冒頭で「三つの面は互いに一致していない」と言い、
   ;; その一致していなさを 1 つずつ散文で述べている。散文は自分が真でなくなった
   ;; ことに気づかない —— 実測 2026-09-03、測定から 9 日で **ファイル数と
   ;; `svelte/` の行の両方が既に嘘になっていた**（Svelte→cljs 移行で tree が
   ;; 動いたのに、それを述べた段落は動かなかった）。
   ;;
   ;; 検査対象は面と面の**あいだ**にある事実なので、どの面にも属さない:
   ;; `kotoba/test/bpmn.test.ts` は adapter を見ることができず、adapter には
   ;; test が 1 本も無い。
   ;;
   ;; 一致を pin しているものと、**不一致**を pin しているものが混ざっている。
   ;; どちらも「観測された値」として同じやり方で pin する —— だから赤は
   ;; 「壊れた」ではなく「動いた」を意味し、修理された場合も赤くなる。
   ;; どちらであるかは失敗メッセージが名乗る。
   :cmd ["nbb" "test/cross_plane_test.cljs"]
   :green-marker "cross-plane: OK"
   :mutations
   ;; ── 事実が動く側（exit 1）。7 件とも 2026-09-03 に赤くなるところを見た ──
   [{:id :bpmn/route-dropped
     :note "kotoba が export しているのに XRPC から呼べない操作ができる"
     :file "xrpc-adapter/src/index.ts"
     :find "  [`${NSID_BASE}.analyzeProcess`]: { method: \"POST\", handler: (e, input) => bpmnRwFree.analyzeProcess(e, input as any) },\n"
     :replace ""
     :must-fail ["xrpc-routes-cover-every-kotoba-export"]}

    {:id :bpmn/route-added-that-nothing-exports
     :note "route 表だけが増え、実体の無い NSID が公開される"
     :file "xrpc-adapter/src/index.ts"
     :find "  [`${NSID_BASE}.getActivityLog`]:"
     :replace "  [`${NSID_BASE}.purgeEverything`]: { method: \"POST\", handler: (e, input) => bpmnRwFree.getActivityLog(e, input as any) },\n  [`${NSID_BASE}.getActivityLog`]:"
     :must-fail ["xrpc-routes-add-nothing-kotoba-does-not-export"]}

    {:id :bpmn/namespaces-unified
     :note "**修理の側の赤**。split が消えたら README ごと更新させる"
     :file "xrpc-adapter/src/index.ts"
     :find "const NSID_BASE = \"com.etzhayyim.bpmn\";"
     :replace "const NSID_BASE = \"com.etzhayyim.apps.bpmn\";"
     :must-fail ["the-two-planes-still-do-not-share-a-namespace"]}

    {:id :bpmn/kotoba-export-removed
     :note "13 操作の集合そのものが動く"
     :file "kotoba/src/index.ts"
     :find "export { deployProcess, listProcesses, validateXml, compileJsonToXml, compileBpmn, analyzeProcess } from \"./process.js\";"
     :replace "export { deployProcess, listProcesses, validateXml, compileJsonToXml, compileBpmn } from \"./process.js\";"
     :must-fail ["kotoba-exports-are-the-thirteen-operations"]}

    {:id :bpmn/kotoba-compiler-grows-a-branch
     :note "2 つの JSON 語彙が重なり始める —— 黙って task になる範囲が変わる"
     :file "kotoba/src/process.ts"
     :find "        } else if (flowType === \"gateway\") {"
     :replace "        } else if (flowType === \"startEvent\") {\n          xml += `    <bpmn2:startEvent id=\"${flowId}\" name=\"${flowName}\"/>\\n`;\n        } else if (flowType === \"gateway\") {"
     :must-fail ["appview-step-types-compile-to-plain-task-on-the-kotoba-slice"]}

    {:id :bpmn/appview-implements-a-missing-op
     :note "appview が 10 of 13 でなくなる"
     :file "appview/etzhayyim-wasm-bpmn-bx7qm9p4/src/app.ts"
     :find "    sdk.app.command(nsid(\"com.etzhayyim.apps.bpmn.listProcesses\"),"
     :replace "    sdk.app.command(nsid(\"com.etzhayyim.apps.bpmn.analyzeProcess\"),\n      async () => ({ ok: true }));\n    sdk.app.command(nsid(\"com.etzhayyim.apps.bpmn.listProcesses\"),"
     :must-fail ["operations-the-appview-never-implemented"]}

    {:id :bpmn/manifest-points-at-nothing
     :note "actor manifest の component.path が tree から外れる"
     :file "appview/etzhayyim-wasm-bpmn-bx7qm9p4/kotodama.jsonld"
     :find "\"component\": { \"path\": \"src/app.ts\" },"
     :replace "\"component\": { \"path\": \"src/gone.ts\" },"
     :must-fail ["actor-manifest-component-path-exists-in-the-tree"]}

    ;; ── 測れなくなる側（exit 2）。ここが本題である ──
    ;;
    ;; CLAUDE.md の 6 問の 1 と 2 —— 「入力が無いとき / そもそも実行できないとき
    ;; 何を返すか」。pass を返すなら欠陥である。下の 3 件は、検査器が読む対象を
    ;; それぞれ別の壊し方で奪い、**0 でも 1 でもない 2** が返ることを確かめる。
    ;; `:must-fail ["REFUSED"]` は、通常の失敗と拒否を出力から区別するため。
    {:id :bpmn/region-anchor-renamed
     :note "走査範囲の目印が消える。**黙って全ファイルに広がってはならない**"
     :file "appview/etzhayyim-wasm-bpmn-bx7qm9p4/src/app.ts"
     :find "  const elements: string[] = [];"
     :replace "  const emitted: string[] = [];"
     :must-fail ["REFUSED"]}

    {:id :bpmn/extractor-drops-below-floor
     :note ["抽出器が読む**その文字列**を壊す。"
            "⚠ 最初は `const flowType =` の側を壊して咬まなかった —— 比較の "
            "`flowType === \"...\"` は無傷なので、壊れたのは TypeScript であって "
            "抽出器の入力ではなかった。壊したものと報告されたものを一致させる。"]
     :file "kotoba/src/process.ts"
     :find "} else if (flowType === \"gateway\") {"
     :replace "} else if (flowType === `gateway`) {"
     :must-fail ["REFUSED"]}

    {:id :bpmn/nsid-base-renamed
     :note "route 表の起点が消え、routes が 0 件になる"
     :file "xrpc-adapter/src/index.ts"
     :find "const NSID_BASE = \"com.etzhayyim.bpmn\";"
     :replace "const NSID_ROOT = \"com.etzhayyim.bpmn\";"
     :must-fail ["REFUSED"]}]}

  {:repo "orgs/cloud-itonami/org-un-isic"
   :label "org-un-isic ingest catalog —— 出所の pin と、それが何であるかの測定"
   ;; catalog.edn は 2 つの別々の腐り方をする。
   ;;
   ;;   pin の側は、committed なファイルが再生成されて digest が追随しない形。
   ;;   catalog を信じた consumer は、矛盾するはずだった bytes に触らない。
   ;;
   ;;   測定の側はもっと速く腐る。428 クラスのうち 381 が UN の ISIC Rev.4 と
   ;;   一致し、残り 47 はこれこれ、と書いてある。data/classes のタイトルを
   ;;   1 つ編集すればその数字は全部古くなるが、ファイルは自信のある過去形で
   ;;   主張し続ける。参照表 2 つは意図的に commit されていないので offline で
   ;;   verdict を導き直すことはできない —— できるのは、**測った対象が動いたら
   ;;   verdict を無効にする**ことで、それが :titles-digest である。
   ;;
   ;; そして正確さではなく誠実さの側の不変条件が 1 つ。出所が不明な表は不明と
   ;; 言い続けなければならない。unpinned な表の隣にもっともらしい URL を書くのは
   ;; data/PROVENANCE.edn がまさに記録している誤りで、その記録の言葉では
   ;; 「disputed な表に authoritative に見える pin を与えるのは、それが埋める
   ;; ように見える穴より悪い」。
   ;;
   ;; 10 件とも pin 431ef166 で landing 前に実際に赤くなるところを見た。
   ;; anchor は一意、噛んだ invariant は名前まで一致、無改変で exit 0。
   ;; さらに拒否床 6 件（入力が読めない / dataset が空 / :sources が空 /
   ;; EDN が 1 form でない）が **exit 2** を返すことも確認した —— 0 でも 1 でも
   ;; ない値でなければ、「測れなかった」が「測って問題が無かった」と同じ顔をする。
   ;;
   ;; その拒否床が test 自身の穴を 1 つ見つけている: `read-string` は最初の
   ;; form だけ読んで残りを捨てるので、map が早く閉じて後ろにゴミが続く EDN が
   ;; **clean として通っていた**。CLAUDE.md が heredoc の `\"` について記述して
   ;; いるのと同じ形。read-edn は text を vector で包んで全部を消費させる。
   ;;
   ;; ここに無いもの: 5 つのアドレスが今も 200 を返すかは検査しない。それは
   ;; この repo についての主張ではないので、落ちても意味が読めない。記録した日に
   ;; 取得して確かめてある。
   :cmd ["nbb" "test/catalog_test.cljs"]
   :green-marker "catalog-check: OK"
   :mutations
   [{:id :isic/titles-digest-stale
     :why "data/classes のタイトルが 1 つ変われば :what-data-classes-is の 381/20/27 は全部古い。参照表が repo に無いので verdict は導き直せない —— 測った対象が動いたことを検出するのが :titles-digest の全仕事"
     :file "data/classes/0111.json"
     :find "\"nameEn\": \"Growing of cereals"
     :replace "\"nameEn\": \"GROWING of cereals"
     :must-fail ["catalog-titles-digest-matches-tree"]}

    {:id :isic/class-count-drift
     :why "手で書かれた件数。dataset の実ファイル数と突き合わせられるので、もう一つの手書き数字と比べる必要が無い"
     :file "catalog.edn"
     :find ":files 428"
     :replace ":files 427"
     :must-fail ["catalog-class-count-matches-tree"]}

    {:id :isic/verdicts-stop-partitioning
     :why "3 つの verdict が dataset を分割していなければ、結論は主張しているより少ない範囲しか覆っていない。どのクラスも必ずどれか 1 つに入る"
     :file "catalog.edn"
     :find ":title-matches-isic-exactly 381"
     :replace ":title-matches-isic-exactly 380"
     :must-fail ["catalog-verdicts-partition-the-dataset"]}

    {:id :isic/finding-names-a-vanished-code
     :why "dataset を去ったクラスについての finding。修理対象の 47 件は下流が読む actionable な一覧なので、実在しないコードが混じると repair が空振りする"
     :file "catalog.edn"
     :find "\"6619\" \"8410\" \"9101\"]"
     :replace "\"6619\" \"8410\" \"9999\"]"
     :must-fail ["catalog-finding-codes-exist-in-tree"]}

    {:id :isic/finding-count-drifts-from-its-list
     :why "要約の数字と、その数字が要約している一覧が別々に編集される形。片方だけ直すのが自然な壊れ方"
     :file "catalog.edn"
     :find ":title-matches-nace-not-isic 20"
     :replace ":title-matches-nace-not-isic 21"
     :must-fail ["catalog-finding-count-matches-list" "catalog-verdicts-partition-the-dataset"]}

    {:id :isic/same-address-cited-twice
     :why "provenance catalog を実際より豊かに見せる最も安い方法。ingest の指標は URL の出現回数を数えるので、これを塞がないと catalog は水増しの道具になる"
     :file "catalog.edn"
     :find ":ramon-retired true"
     :replace ":also \"https://ec.europa.eu/eurostat/web/nace\"\n   :ramon-retired true"
     :must-fail ["catalog-cites-each-address-once"]}

    {:id :isic/mirrored-digest-stops-matching-bytes
     :why "committed なファイルが再生成されて digest が追随しない形。catalog を信じた consumer は矛盾する bytes に触らない"
     :file "catalog.edn"
     :find ":sha256 \"fc408f57bd3a4f33c35a4f384ec0010283dd72774892c8d48ae1330a8caeb57f\""
     :replace ":sha256 \"fc408f57bd3a4f33c35a4f384ec0010283dd72774892c8d48ae1330a8caeb57e\""
     :must-fail ["catalog-mirrored-digest-matches-committed-bytes" "catalog-agrees-with-rev5-upstream-record"]}

    {:id :isic/rev5-record-drifts-from-catalog
     :why "同じ pin を 2 つのファイルが持つと、片方だけ更新される機会が 2 つできる。逆向き —— upstream.edn 側を動かしても catalog が気づく"
     :file "data/rev5/upstream.edn"
     :find " :sha256 \"fc408f57"
     :replace " :sha256 \"aa408f57"
     :must-fail ["catalog-agrees-with-rev5-upstream-record"]}

    {:id :isic/unpinned-table-given-a-plausible-address
     :why "この repo が丸ごと戒めになっている誤りそのもの。digest 無しでもっともらしい URL を書けば、出所不明の表が出所を持っているように読める"
     :file "catalog.edn"
     :find ":source-url :unknown :sha256 :unknown :fetched-at :unknown"
     :replace ":source-url \"https://unstats.un.org/unsd/publication/seriesm/seriesm_4rev4e.pdf\" :sha256 :unknown :fetched-at :unknown"
     :must-fail ["catalog-unpinned-table-declares-unknown-provenance" "catalog-addresses-are-declared-sources"]}

    {:id :isic/fetched-source-loses-its-digest
     :why "取得したと書いてある source から digest が消える形。:pending は「これから測る」に見えるが、比較の再現性はその時点で失われている"
     :file "catalog.edn"
     :find ":sha256 \"9f8598cd9460a3ced11743b881f01eb1259d711664e1526a9d0c24e577fb80df\""
     :replace ":sha256 :pending"
     :must-fail ["catalog-fetched-source-carries-a-digest"]}]}

  {:repo "orgs/cloud-itonami/tsukuru-manufacturing-artifacts"
   :label "tsukuru artifact catalog vs the dataset it describes"
   ;; index/catalog.datoms.edn says of itself "This file is hand-maintained
   ;; today", and until 2026-08-29 nothing read it. The mutations below are the
   ;; ways it drifts: a byte count edited by hand, an object replaced without
   ;; the catalog following, a row removed, coverage left overclaiming, a
   ;; qualification quietly upgraded, an allowlist narrowed underneath it.
   ;;
   ;; All seven were replayed at pin afb6825e on 2026-08-29 before landing —
   ;; each anchor unique, each bite naming the invariant it claims, base green
   ;; before and after. The last is the refusal floor itself: an empty
   ;; allowlist must exit **2**, not 1 and not 0, so "could not measure" never
   ;; reads as the OK a clean run prints.
   ;;
   ;; NOT covered here: `raw-is-annexed-not-committed` fires on a plain blob
