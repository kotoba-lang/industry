     :find "\"role\": s.get(\"role\", \"training_label\"),"
     :replace "\"role\": \"training_label\","
     :must-fail ["the-mix-carries-each-source-role-unchanged"]}

    {:id :llm-dataset/source-omits-its-licence-flag
     :why "両 gate の既定は False なので安全側には倒れるが、それは宣言ではなく
           偶然。licence は誰かが主張したものでなければならない"
     :file "corpus/manifest.toml"
     :find "license = \"Apache-2.0\"\ncommercial_ok = true\nnote = \"Reddit comments"
     :replace "license = \"Apache-2.0\"\nnote = \"Reddit comments"
