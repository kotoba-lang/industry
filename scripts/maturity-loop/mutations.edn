     :file "src/association_facts.kotoba"
     :find "(string=? f \"supersedes-url\") (option-some-of [:option :string] \"https://jicpa.or.jp/specialized_field/2-22-0-2-20190618.pdf\")"
     :replace "(string=? f \"supersedes-url\") (option-none-of [:option :string])"
