#!/bin/zsh
# 週次 fabric actor pulse（launchd com.junkawasaki.fabric-actor-cadence）。
#
# 2026-08-30: JVM (`clojure -M -m publish-fabric-actor-status`) から nbb へ
# 切替。旧経路は superproject root の deps.edn（Clojure マニフェストではない
# workspace メタデータ）を tools.deps が読みにいって落ちていた — 実測、
# 2026-08-10 以降この job は 1 行も走らずに終わっていた
# （/tmp/fabric-actor-cadence.err、NullPointerException）。nbb は deps.edn を
# 読まないので、この障害クラスごと消える。実体は
# scripts/publish_fabric_actor_status.cljs。
#
# cacao 鋳造は aozora bots と同じ cljs 実装（org-chainagnostic-cacao/src の
# cacao.core + authority + org-ietf-ed25519 + org-ietf-cbor）を使う。
set -euo pipefail
ROOT=/Users/junkawasaki/github/com-junkawasaki
export FABRIC_ROOT="$ROOT"
CLASSPATH="$ROOT/scripts:$ROOT/orgs/kotoba-lang/org-chainagnostic-cacao/src:$ROOT/orgs/kotoba-lang/authority/src:$ROOT/orgs/kotoba-lang/org-ietf-ed25519/src:$ROOT/orgs/kotoba-lang/org-ietf-cbor/src"
exec /opt/homebrew/bin/nbb --classpath "$CLASSPATH" "$ROOT/scripts/publish_fabric_actor_status.cljs"
