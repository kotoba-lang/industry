# Installed by install.cljs, which substitutes @HOME@ / @NBB@ / @USER@ / @ROOT@.
# Do not install this file directly.
[Unit]
Description=endpoint-health — ask our own endpoints whether they work
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@ROOT@
# :slot/anonymous — this resident holds NO write key. It reads public endpoints
# and writes two files under @HOME@. If it ever needs a credential to publish,
# it becomes :slot/attested (ADR-2608111721) and must move to a host that does
# not execute gate code sent from a repository.
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=@NBB@ --classpath @UPTIME@ @ROOT@/scripts/endpoint-health-resident.cljs --root @ROOT@ --home @HOME@ --window-hours 24
# A GPU probe can take minutes; a wedged ComfyUI must not wedge the timer.
TimeoutStartSec=1200
StandardOutput=append:@HOME@/tick.log
StandardError=append:@HOME@/tick.log

[Install]
WantedBy=multi-user.target
