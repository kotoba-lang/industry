<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  fleet-sync DETECTION tick (scripts/fleet-sync-tick.cljs).

  ADR-2608040100 measured four of six plane-pair checkers existing and ZERO of them
  scheduled: the balancing loop's 8.0-day period was just how long it happened to be
  between two hand-run reconciles. This plist is what turns that period into a
  setting.

  install:
    cp scripts/com.gftd.fleet-sync-tick.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gftd.fleet-sync-tick.plist
  uninstall:
    launchctl bootout gui/$(id -u)/com.gftd.fleet-sync-tick
  run once now:
    launchctl kickstart -p gui/$(id -u)/com.gftd.fleet-sync-tick

  * `check` only (fleet-db <-> west.yml drift, read against MAIN not the local
    checkout). The full fleet probe is a separate, much slower job -- see
    com.gftd.fleet-sync-probe.plist.
  * StartInterval 3600 = hourly. Measured 2026-08-03: 15 manifest entries drifted in
    the hour after a reconcile, so hourly is the coarsest interval that still keeps
    the reported drift small enough to act on.
  * This job NEVER writes to main. It detects and records; absorbing is an explicit
    action. See the script's header for why.
  * RunAtLoad false, ProcessType Standard (NOT Background: measured on this machine
    2026-07-25, a Background+Nice job got 0.09s of CPU in 15 minutes while other
    sessions held the CPU).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gftd.fleet-sync-tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/nbb</string>
    <string>/Users/junkawasaki/github/com-junkawasaki/scripts/fleet-sync-tick.cljs</string>
    <string>check</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/junkawasaki/github/com-junkawasaki</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>FLEET_ROOT</key>
    <string>/Users/junkawasaki/github/com-junkawasaki</string>
    <key>HOME</key>
    <string>/Users/junkawasaki</string>
  </dict>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/junkawasaki/.gftd/fleet-sync/tick.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/junkawasaki/.gftd/fleet-sync/tick.stdout.log</string>
  <key>ProcessType</key>
  <string>Standard</string>
</dict>
</plist>
