<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gftd.docs-edn-repair</string>

  <!-- ローカル Claude loop（superproject ADR-2608080500）。姉妹の
       com.gftd.itonami-os-connect と同じ 2 段構え:
         1) scripts/docs-edn-repair-tick.cljs が「読めない文書」を測る（決定論）
         2) 候補があるときだけ claude -p "/docs-edn-repair" を起こす

       仕事は有限で、7 件（2026-08-08 時点）を直し切れば tick が空を返して
       モデルは起きなくなる。ただし loop 自体は残す —— 生成器が新しく壊した
       文書を、次に誰かが気付くまで待たずに拾うため。

       tamaki で包んでいないのは itonami-os-connect と同じ理由（exec も local も
       この loop の事実と違う mode。嘘の lifecycle を event store に書かない）。

       止め方:
         launchctl bootout gui/$(id -u)/com.gftd.docs-edn-repair
       候補だけ見る（モデルを起こさない）:
         nbb --classpath ".:scripts/nbb_compat" scripts/docs-edn-repair-loop.cljs --dry-run -->

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/nbb</string>
    <string>--classpath</string>
    <string>.:scripts/nbb_compat</string>
    <string>scripts/docs-edn-repair-loop.cljs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/junkawasaki/github/com-junkawasaki</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>COM_JUNKAWASAKI_ROOT</key>
    <string>/Users/junkawasaki/github/com-junkawasaki</string>
    <!-- claude の認証は HOME/USER/LOGNAME が無いと解決せず「Not logged in」に
         なる（itonami-os-connect が 2026-08-06 に実測）。launchd の gui ドメインは
         通常これらを渡すが、渡らなかったときの失敗が「静かに毎周 :failed」という
         形になるので明示する。 -->
    <key>HOME</key>
    <string>/Users/junkawasaki</string>
    <key>USER</key>
    <string>junkawasaki</string>
    <key>LOGNAME</key>
    <string>junkawasaki</string>
    <key>SHELL</key>
    <string>/bin/zsh</string>
  </dict>

  <!-- 8h。1 反復（worktree + 再構成 + 3 検証 + 着地 + 後片付け）は数十分。
       姉妹 loop より長いのは、候補が 7 件しかなく急ぐ理由が無いのと、
       再構成は同じ文書を 2 セッションが同時に触ると衝突するため。 -->
  <key>StartInterval</key>
  <integer>28800</integer>
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/junkawasaki/.gftd/docs-edn-repair.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/junkawasaki/.gftd/docs-edn-repair.stdout.log</string>
</dict>
</plist>
