;; itonami-app-resident — the launchd job `cloud.itonami.app.local` runs THIS,
;; and this runs the resident that serves http://localhost:1338: the nbb
;; signin-server (`src/cloud/itonami/app/signin_server.cljk`) on the kbb
;; engine. The plist's WorkingDirectory is the app checkout, so `src`, `data`
;; and `target` resolve from there.
;;
;; ## What it ran before, and why that stopped (2026-09-15)
;;
;; Until today this spawned `clojure -M:server` -- the JVM application. The
;; 2026-09-11 rename of every Clojure source to `.cljk` (ADR-2609111500,
;; fix-forward, no mirror) took `cloud/itonami/app/server.clj` off the JVM's
;; classpath, so the JVM exited 1 with `Could not locate …server.clj` and
;; launchd (`KeepAlive`, `ThrottleInterval` 10) restarted it every ten
;; seconds -- measured in target-server-live.log, for four days. Meanwhile
;; 1338 was served by a signin-server somebody had started by hand from the
;; checkout, with no supervisor: the sign-in fix of that day (app #356) needed
;; a manual restart to reach it. This launcher now runs that server, under
;; launchd, so a fix lands by `launchctl kickstart`.
;;
;; The installed plist had also drifted from the versioned one: it still ran
;; `~/.gftd/bin/itonami-app-resident.cljs` (a symlink into this workspace)
;; on `kbb --backend sci`; the versioned copy names this file directly.
;;
;; ## Why it exists again, and why it is HERE
;;
;; Rewritten 2026-09-09, and put under version control the same day. The
;; original lived only in the home directory, so its loss was invisible until
;; the next restart — a single point of failure with no history and no
;; reviewer. This file is the only copy; the plist beside it
;; (`scripts/cloud.itonami.app.local.plist`) points here directly, and is the
;; copy to reinstall from.
;;
;; ## The classpath and cljk roots the server needs
;;
;; signin_server.cljk requires webauthn, cacao, kotoba-oracle (osaho,
;; kotoba-hir, sha2), the page renderer (css, html, jp-go-dds, hanmen,
;; cloud-kotoba-dds) and text; `scripts/nbb_compat` and `target` carry the
;; oracle's generated pieces. The list below is what the hand-started server
;; ran with (read off its process, 2026-09-15) -- COPIED, not derived, because
;; nothing in the app declares it for nbb; when a require moves, this list
;; moves with it and the server says `Could not find namespace` by name.
;;
;; ## Secrets, by name
;;
;;   MURAKUMO_API_KEY    ~/.itonami/itonami-murakumo-api-key (0600). A file rather
;;                       than kagi because launchd cannot unlock kagi.
;;   OPENROUTER_API_KEY  login Keychain, service `gftd.openrouter`, by exact
;;                       name. One known item, never an enumeration.
;;
;; A missing one is reported in full rather than passed over — but it is NOT
;; fatal here. Exiting would hand `KeepAlive` a crash loop, and a server
;; running with one provider denied is still a server.

(ns itonami-app-resident
  (:require ["node:child_process" :as cp]
            ["node:fs" :as fs]
            ["node:path" :as path]))

(def workspace-root "/Users/junkawasaki/github/com-junkawasaki")
(def app-root (path/join workspace-root "orgs" "cloud-itonami" "cloud-itonami-app"))
(def server-file "src/cloud/itonami/app/signin_server.cljk")

;; west siblings the signin-server requires (see the header)
(def sibling-repos
  ["osaho" "kotoba-hir" "org-nist-sha2" "css" "html" "text"
   "fs" "fs-filesystem" "fs-async-filesystem"
   "jp-go-digital-design-system" "hanmen" "cloud-kotoba-dds"
   ;; the browser contract web.cljk inlines (shinkansen.interaction/runtime)
   ;; and the action vocabulary cloud-kotoba-dds.bots names — the #/bots
   ;; rail is built on both since 2026-09-16 (cloud-itonami-app PR #361)
   "shinkansen"
   "webauthn" "org-chainagnostic-cacao"])

(defn- sibling [r] (path/join workspace-root "orgs" "kotoba-lang" r))

(def classpath
  (.join (clj->js (into ["src" "target" "resources" "scripts/nbb_compat"]
                        (map #(path/join (sibling %) "src")
                             ;; the three fs repos are cljk roots but not on the classpath
                             (remove #{"fs" "fs-filesystem" "fs-async-filesystem"} sibling-repos))))
         ":"))

(def cljk-roots
  ;; a cljk root must carry a cljk-origin.edn manifest; shinkansen is .cljc
  ;; only (classpath, not a root) — measured 2026-09-16: listing it here
  ;; made the engine refuse to start (ENOENT .../shinkansen/cljk-origin.edn)
  (js/JSON.stringify (clj->js (into [app-root] (map sibling (remove #{"shinkansen"} sibling-repos))))))
(def murakumo-key-file
  (str (or (aget js/process.env "HOME") "") "/.itonami/itonami-murakumo-api-key"))
(def openrouter-keychain-service "gftd.openrouter")

(defn- log [& parts]
  (println (apply str "itonami-app-resident: " parts)))

(defn- from-file [path]
  (try (let [value (.trim (fs/readFileSync path "utf8"))]
         (when (seq value) value))
       (catch :default _ nil)))

(defn- from-keychain [service]
  (try (let [{:keys [status stdout]}
             (js->clj (cp/spawnSync "/usr/bin/security"
                                    #js ["find-generic-password" "-s" service "-w"]
                                    #js {:encoding "utf8"})
                      :keywordize-keys true)]
         (when (zero? status)
           (let [value (.trim (str stdout))]
             (when (seq value) value))))
       (catch :default _ nil)))

(defn -main []
  (let [murakumo (from-file murakumo-key-file)
        openrouter (from-keychain openrouter-keychain-service)
        present (cond-> ["CLOUD_ITONAMI_WORKSPACE_ROOT"]
                  murakumo (conj "MURAKUMO_API_KEY")
                  openrouter (conj "OPENROUTER_API_KEY"))
        absent (cond-> []
                 (nil? murakumo) (conj (str "MURAKUMO_API_KEY (" murakumo-key-file ")"))
                 (nil? openrouter) (conj (str "OPENROUTER_API_KEY (Keychain "
                                              openrouter-keychain-service ")")))]
    ;; Names only. A launcher that prints a value writes it into
    ;; target-server-live.log, which is neither 0600 nor rotated.
    (log "exporting " (.join (clj->js present) ", ") " into the server process")
    (when (seq absent)
      (log "WARNING not found, so its provider will fail `authenticated` and be"
           " denied before any turn: " (.join (clj->js absent) ", ")))
    ;; `js/process.env` is a host object, not a map: `js->clj` hands it back
    ;; unchanged and `assoc` then throws. Copy it and set properties.
    (let [env (js/Object.assign #js {} js/process.env)
          _ (aset env "CLOUD_ITONAMI_WORKSPACE_ROOT" workspace-root)
          _ (when murakumo (aset env "MURAKUMO_API_KEY" murakumo))
          _ (when openrouter (aset env "OPENROUTER_API_KEY" openrouter))
          _ (aset env "NBB_CLJK_ROOTS" cljk-roots)
          _ (log "starting " server-file " on the kbb engine (cwd " app-root ")")
          child (cp/spawn "/opt/homebrew/bin/kbb"
                          #js ["--backend" "sci" "--classpath" classpath server-file]
                          #js {:stdio "inherit" :env env :cwd app-root})]
      ;; launchd stops a job with SIGTERM. Forward it, so the server gets the
      ;; same signal it would have got directly and this wrapper is not the
      ;; reason a shutdown becomes a kill.
      (doseq [signal ["SIGTERM" "SIGINT" "SIGHUP"]]
        (.on js/process signal (fn [] (.kill child signal))))
      (.on child "exit"
           (fn [code signal]
             (log "server exited code=" code " signal=" signal)
             (set! (.-exitCode js/process) (or code 1)))))))

(-main)
