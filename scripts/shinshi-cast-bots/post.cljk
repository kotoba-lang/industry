(ns post
  "One posting round for the club-shinshi cast bots: each cast member
   composes an in-character post (murakumo-main; deterministic fallback
   from her own profile when the LLM is unreachable) and publishes it

     1. to shinshi.club — an app.bsky.feed.post row in RECORDLOG
        vertex_repo_record (the same write char-posts.cljs does; the
        appview's listAuthorFeed serves it as her feed), embedding her
        latest scene image when she has one;
     2. to aozora.app — CACAO-signed createRecord under her own did:key.
        BLOCKED today (ADR-2608291500); attempted anyway and the receipt
        carries the raw upstream error.

   The shinshi.club write is verified by reading the uri back (a write
   that could not be verified is not reported as posted).

   usage (classpath as in register.cljs):
     kbb --backend sci --classpath \"$CP\" scripts/shinshi-cast-bots/post.cljk \\
        [--slug <slug>] [--limit N] [--dry-run] [--skip-aozora] [--skip-llm]

   Exit: cast-core contract (0 handled / 1 local failure / 2 refused)."
  (:require [cast-core :as core]
            [cast-d1 :as d1]
            [cacao.core :as cacao]
            [clojure.string :as str]
            ["node:child_process" :as cp]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]))

(def argv (vec *command-line-args*))
(defn- flag? [f] (boolean (some #{f} argv)))
(defn- flag-val [f]
  (let [i (first (keep-indexed (fn [i s] (when (= s f) i)) argv))]
    (when i (nth argv (inc i) nil))))

(def dry? (flag? "--dry-run"))
(def skip-aozora? (flag? "--skip-aozora"))
(def skip-llm? (flag? "--skip-llm"))

(def murakumo-base
  (or (aget (.-env js/process) "MURAKUMO_API_BASE") "https://api.murakumo.cloud"))

;; ── compose ──────────────────────────────────────────────────────────────

(defn- clamp [s n] (if (> (count s) n) (str (subs s 0 (dec n)) "…") s))

(defn llm-compose
  "-> Promise<{:text s :composer :murakumo-main} | nil>. Never throws."
  [{:keys [profile series]}]
  (if skip-llm?
    (js/Promise.resolve nil)
    (let [{:keys [charName personality speechStyle scenario occupation hobbies]} profile
          sys (str "あなたは club-shinshi のオリジナルキャラクター「" charName "」です。"
                   "シリーズ: " series "。性格: " (str/join "、" (or personality [])) "。"
                   (when speechStyle (str "話し方: " speechStyle "。"))
                   (when occupation (str "職業: " occupation "。"))
                   (when (seq hobbies) (str "趣味: " (str/join "、" hobbies) "。"))
                   (when scenario (str "設定: " scenario))
                   "これはフィクションのキャラクター投稿です。実在の出来事・数値・宣伝文句を作らない。"
                   "出力は投稿本文のみ。240文字以内の日本語。ハッシュタグは付けない。")
          ctrl (js/AbortController.)
          _ (js/setTimeout #(.abort ctrl) 90000)]
      (-> (js/fetch (str murakumo-base "/v1/chat/completions")
                    (clj->js {:method "POST"
                              :headers {"content-type" "application/json"}
                              :signal (.-signal ctrl)
                              :body (js/JSON.stringify
                                     (clj->js {:model "murakumo-main"
                                               :max_tokens 400
                                               :temperature 0.9
                                               :chat_template_kwargs {:enable_thinking false}
                                               :messages [{:role "system" :content sys}
                                                          {:role "user"
                                                           :content "今日のあなたらしい短い投稿を1つ書いて。"}]}))}))
          (.then (fn [resp] (.json resp)))
          (.then (fn [j]
                   (let [t (some-> (aget j "choices") (aget 0) (aget "message") (aget "content") str str/trim)]
                     (when (and t (not (str/blank? t)))
                       {:text (clamp (str/replace t #"\s*\n+\s*" " ") 280)
                        :composer :murakumo-main}))))
          (.catch (fn [_] nil))))))

(defn compose [{:keys [profile] :as m}]
  (-> (llm-compose m)
      (.then (fn [r]
               (or r {:text (clamp (core/fallback-post-text profile) 280)
                      :composer :fallback})))))

;; ── shinshi.club write ───────────────────────────────────────────────────

(defn post-record [{:keys [text blob char-name created-at]}]
  (cond-> {:$type "app.bsky.feed.post"
           :text text
           :createdAt created-at
           :langs ["ja"]
           :labels {:$type "com.atproto.label.defs#selfLabels"
                    :values [{:val "nsfw"}]}}
    blob (assoc :embed {:$type "app.bsky.embed.images"
                        :images [{:image {:$type "blob" :ref {:$link blob}}
                                  :alt (or char-name "")}]})))

(defn record-insert [{:keys [slug rkey created-at] :as item}]
  (let [did (core/actress-did slug)
        uri (str "at://" did "/app.bsky.feed.post/" rkey)
        vj (js/JSON.stringify (clj->js (post-record item)))]
    {:uri uri
     :sql (str "INSERT OR REPLACE INTO vertex_repo_record "
               "(uri, cid, collection, rkey, repo, value_json, created_at, indexed_at) VALUES ('"
               (d1/sql-escape uri) "','','app.bsky.feed.post','" (d1/sql-escape rkey) "','"
               (d1/sql-escape did) "','" (d1/sql-escape vj) "','" created-at "','" created-at "');")}))

(defn write-shinshi!
  "items -> {:written n :verified n :ok? bool}; nil-safe, honest."
  [items]
  (if dry?
    {:written 0 :verified 0 :ok? true :dry true}
    (let [tmp (path/join (os/tmpdir) (str "shinshi-cast-posts-" (.now js/Date) ".sql"))
          ins (mapv record-insert items)]
      (fs/writeFileSync tmp (str/join "\n" (map :sql ins)))
      (if-not (d1/d1-exec-file! core/recordlog-db tmp)
        {:written 0 :verified 0 :ok? false}
        (let [uris (mapv :uri ins)
              rows (d1/d1-query core/recordlog-db
                                (str "SELECT uri FROM vertex_repo_record WHERE uri IN ("
                                     (d1/sql-in uris) ")"))]
          {:written (count ins)
           :verified (if rows (count rows) -1)
           :ok? (= (count ins) (count (or rows [])))})))))

;; ── aozora write ─────────────────────────────────────────────────────────

(defn- sh [cmd args]
  (let [r (cp/spawnSync cmd (clj->js args) #js {:encoding "utf8"})]
    {:status (.-status r) :out (or (.-stdout r) "") :err (or (.-stderr r) "")}))

(def user (or (aget (.-env js/process) "USER") "fabric-operator"))

(defn seed-of
  "Read-only Keychain lookup — creation belongs to register.cljs."
  [handle]
  (let [got (sh "security" ["find-generic-password" "-a" user "-s"
                            (core/seed-service handle) "-w"])]
    (when (zero? (:status got))
      (js/Uint8Array.from (js/Buffer.from (str/trim (:out got)) "base64")))))

(defn mint [seed]
  (let [now (js/Date.)]
    (:cacao-b64 (cacao/mint {:seed seed :aud core/pds-aud
                             :domain core/pds-domain
                             :iat (.toISOString now)
                             :exp (.toISOString (js/Date. (+ (.getTime now) 300000)))
                             :nonce (str (random-uuid))
                             :resources ["atproto://account/session"]}))))

(defn xrpc [nsid body token]
  (-> (js/fetch (str core/pds "/xrpc/" nsid)
                (clj->js {:method "POST"
                          :headers (cond-> {"content-type" "application/json"}
                                     token (assoc "authorization" (str "Bearer " token)))
                          :body (js/JSON.stringify (clj->js body))}))
      (.then (fn [resp]
               (.then (.text resp)
                      (fn [text]
                        (let [v (try (js->clj (js/JSON.parse text)) (catch :default _ {}))]
                          {:status (.-status resp) :body v
                           :ok (and (< (.-status resp) 400) (not (get v "error")))})))))))

(defn aozora-post!
  "-> Promise<receipt-string>. BLOCKED/no-seed are not local failures."
  [{:keys [slug text created-at]}]
  (if (or dry? skip-aozora?)
    (js/Promise.resolve "aozora=skipped")
    (let [handle (core/handle slug)
          seed (seed-of handle)]
      (if-not seed
        (js/Promise.resolve "aozora=no-seed(run register.cljs first)")
        (-> (xrpc "com.atproto.server.createSession" {:cacao (mint seed)} nil)
            (.then (fn [{:keys [ok body status] :as sess}]
                     (if-not ok
                       (js/Promise.resolve
                        (str "aozora=BLOCKED createSession " status " " (get body "error")))
                       (let [did (get body "did") token (get body "accessJwt")]
                         (-> (xrpc "com.atproto.repo.createRecord"
                                   {:repo did :collection "app.bsky.feed.post"
                                    :record {:$type "app.bsky.feed.post"
                                             :text text :createdAt created-at}} token)
                             (.then (fn [{:keys [ok body status]}]
                                      (if ok
                                        (str "aozora=posted " (get body "uri"))
                                        (str "aozora=BLOCKED createRecord " status " "
                                             (get body "error") ": " (get body "message"))))))))))
            (.catch (fn [e] (str "aozora=LOCAL-FAILURE " (.-message e)))))))))

;; ── main ─────────────────────────────────────────────────────────────────

(defn -main []
  (let [members (d1/cast-members)]
    (if (nil? members)
      (do (println "REFUSED: catalog unanswerable (D1)") (.exit js/process 2))
      (let [want (flag-val "--slug")
            limit (some-> (flag-val "--limit") js/parseInt)
            members (cond->> (remove #(core/opted-out? (:slug %)) members)
                      want (filter #(= want (:slug %)))
                      limit (take limit))
            members (vec members)]
        (if (empty? members)
          (do (println "REFUSED: no cast selected") (.exit js/process 2))
          (let [blobs (or (d1/latest-scene-blobs (mapv :slug members)) {})
                epoch (js/Math.floor (/ (.now js/Date) 1000))]
            (-> (reduce
                 (fn [p m]
                   (.then p
                          (fn [acc]
                            (.then (compose m)
                                   (fn [{:keys [text composer]}]
                                     (conj acc (assoc m
                                                      :text text :composer composer
                                                      :rkey (str "cast-" epoch)
                                                      :blob (get blobs (:slug m))
                                                      :char-name (get-in m [:profile :charName])
                                                      :created-at (core/whole-second-iso))))))))
                 (js/Promise.resolve []) members)
                (.then
                 (fn [items]
                   (let [{:keys [written verified ok? dry]} (write-shinshi! items)]
                     (-> (reduce
                          (fn [p item]
                            (.then p (fn [acc]
                                       (.then (aozora-post! item)
                                              (fn [r] (conj acc [item r]))))))
                          (js/Promise.resolve []) items)
                         (.then
                          (fn [pairs]
                            (doseq [[{:keys [slug text composer rkey]} aoz] pairs]
                              (println (str/join "\t"
                                                 [(if dry "dry-run"
                                                      (if ok? "posted-shinshi" "SHINSHI-WRITE-FAILED"))
                                                  slug (name composer)
                                                  (str "at://" (core/actress-did slug)
                                                       "/app.bsky.feed.post/" rkey)
                                                  aoz
                                                  (clamp text 60)])))
                            (println (str "shinshi.club: written=" written
                                          " verified=" verified
                                          (when dry " (dry-run)")))
                            (when (some (fn [[_ r]] (str/includes? r "BLOCKED")) pairs)
                              (println "BLOCKED: aozora writes rejected upstream — see ADR-2608291500."))
                            (let [local (+ (if (and (not dry) (not ok?)) 1 0)
                                           (count (filter (fn [[_ r]]
                                                            (str/includes? r "LOCAL-FAILURE"))
                                                          pairs)))]
                              (.exit js/process (core/exit-code (count pairs) local))))))))))))))))

(-main)
