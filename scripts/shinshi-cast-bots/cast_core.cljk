(ns cast-core
  "Strings, naming rules and the exit contract for the club-shinshi cast
   bots — the per-actor itonami bots that speak as the 12 original-series
   flagship characters, plus the producer bot that mints new actors.

   Roster: NOT a hardcoded character list. The cast is derived per run from
   the live catalog (D1 `ai-gftd-shinshi`): for each of the 12 original
   series, the flagship is the actress with the most scenes, ties broken by
   slug ascending. Deterministic given the catalog, and it follows the
   catalog as the producer grows it (the two-name-horizon lesson from
   scripts/hermes-bots-aozora — coverage must be derived, not enumerated).

   The 12 series keys/names mirror char-factory.cljs `collections` and
   shinshi.common.video-publish/ORIGINAL-SERIES (both in club-shinshi-app).
   Three copies exist upstream already; this one is the slug-suffix ->
   series-name map the D1 derivation needs. If a 13th series is ever added,
   add it in char-factory first, then here.

   Identity: Ed25519 seed -> did:key per bot (the aozora account model).
   Seed custody: macOS Keychain, service `aozora.app/actor-seed/<handle>` —
   the same namespace the hermes bots and fabric actors use, so
   secrets-location-map needs no new section.

   aozora posting is BLOCKED today by the kotobase Biscuit-required cutover
   (ADR-2608291500). register/post attempt anyway and print BLOCKED with
   the raw upstream error; when the aozora PDS migrates to Biscuit the same
   commands start succeeding with no change here.

   Exit contract (shared by every script in this directory):
     0 — every bot handled (posted, registered, or upstream-BLOCKED with a
         banner: the run happened and said what it saw)
     1 — at least one bot failed for a reason that is OURS (bad seed,
         keychain refusal, D1 write refused, unexpected local error)
     2 — REFUSED: could not read the roster / catalog at all. Not the same
         as 'no bots' — a run that saw nothing must not read as clean."
  (:require [clojure.string :as str]))

;; ── aozora (same values as scripts/hermes-bots-aozora/aozora_core.cljk) ──
(def pds "https://pds.aozora.app")
(def pds-aud "did:web:pds.aozora.app")
(def pds-domain "pds.aozora.app")

;; ── shinshi ──
(def shinshi-origin "https://shinshi.club")
(def shinshi-did-prefix "did:web:sh1n5h1x.gftd.ai:")
(def shinshi-db "ai-gftd-shinshi")
(def recordlog-db "ai-gftd-pds-recordlog")

(def series
  "slug-suffix key -> display name. Mirrors char-factory.cljs collections."
  [["neon-tokyo" "Neon Tokyo"]
   ["seaside"    "Seaside Days"]
   ["campus"     "Campus Life"]
   ["office"     "After Office"]
   ["sakura"     "Sakura Court"]
   ["gothic"     "Gothic Rose"]
   ["fitness"    "Fitness Club"]
   ["cafe"       "Cafe Corner"]
   ["fantasy"    "Astral Realm"]
   ["idol"       "Stage Lights"]
   ["winter"     "Snow Resort"]
   ["noir"       "Midnight Bar"]])

(def producer-name "shinshi-producer")

(defn handle [slug-or-name] (str slug-or-name ".aozora.app"))
(defn seed-service [h] (str "aozora.app/actor-seed/" h))
(defn actress-did [slug] (str shinshi-did-prefix slug))
(defn actress-url [slug] (str shinshi-origin "/video/actress/" slug))
(defn blob-url [k] (str shinshi-origin "/b/" k))

(defn whole-second-iso
  "aozora's createRecord breaks on sub-second createdAt (yukkuri
   aozora.cljc: server-side null .length). Whole seconds everywhere."
  []
  #?(:cljs (str (subs (.toISOString (js/Date.)) 0 19) "Z")
     :clj (str (subs (.toString (java.time.Instant/now)) 0 19) "Z")))

(defn cast-display-name [char-name series-name]
  (str char-name "（" series-name "）"))

(defn cast-description [char-name series-name slug]
  (str char-name " — club-shinshi original series「" series-name "」の公式キャラクター。"
       "投稿はすべてフィクションで、AI が本人として綴ります。"
       "プロフィールと動画: " (actress-url slug)))

(defn cast-registration-text [char-name slug]
  (str "はじめまして、" char-name "です。aozora.app にもお部屋ができました。"
       "続きは " (actress-url slug) " で待ってるね。"))

(defn producer-description []
  (str "club-shinshi のプロデューサー bot。新しいオリジナルキャラクターを"
       "決定論的な公式工場（char-factory）から迎え入れ、カタログに登録します。"
       "実在人物・既存 IP は扱いません。Source: scripts/shinshi-cast-bots/ in com-junkawasaki/root."))

(defn intro-text
  "Debut post for a newly minted actress (same voice as tools/char-posts.cljs)."
  [char-name]
  (str "はじめまして、" char-name "です。あなたのことが気になって、ずっと待ってたの。"
       "よかったら、少しお話ししない…？ 💬"))

(defn fallback-post-text
  "Deterministic in-character post used when the LLM is unreachable. Built
   only from the character's own profile fields — nothing invented."
  [{:keys [charName occupation series scenario]}]
  (str (or scenario (str series "で、" charName "が今日もあなたを待っています。"))
       (when occupation (str " " occupation "のお仕事、今日もがんばったよ。"))
       " 会いに来てくれたらうれしいな。"))

(defn opted-out? [nm]
  (let [raw #?(:cljs (or (aget (.-env js/process) "SHINSHI_CAST_OPT_OUT") "")
               :clj (or (System/getenv "SHINSHI_CAST_OPT_OUT") ""))]
    (contains? (->> (str/split raw #",") (map str/trim) (remove str/blank?) set)
               nm)))

(defn exit-code
  "n = bots considered, local-failures = failures that are ours (upstream
   BLOCKED does not count). Empty roster is REFUSED."
  [n local-failures]
  (cond (zero? n) 2
        (pos? local-failures) 1
        :else 0))
