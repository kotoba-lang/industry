(ns roster
  "Print the derived cast roster — the measurement face of the cast bots.

   usage (from the superproject root, or anywhere with GFTD_ROOT set):
     kbb --backend sci --classpath scripts/shinshi-cast-bots scripts/shinshi-cast-bots/roster.cljk [--json]

   Exit: 0 roster printed; 2 REFUSED (D1 unanswerable)."
  (:require [cast-core :as core]
            [cast-d1 :as d1]
            [clojure.string :as str]))

(defn -main []
  (let [json? (some #{"--json"} *command-line-args*)
        members (d1/cast-members)]
    (if (nil? members)
      (do (println "REFUSED: catalog unanswerable (D1)") (.exit js/process 2))
      (let [slugs (mapv :slug members)
            blobs (or (d1/latest-scene-blobs slugs) {})
            rows (mapv (fn [{:keys [slug series scenes profile]}]
                         {:slug slug :series series :scenes scenes
                          :char-name (:charName profile)
                          :handle (core/handle slug)
                          :did (core/actress-did slug)
                          :blob (get blobs slug)
                          :url (core/actress-url slug)})
                       members)]
        (if json?
          (println (js/JSON.stringify (clj->js {:cast rows :producer {:name core/producer-name
                                                                      :handle (core/handle core/producer-name)}})))
          (do
            (doseq [{:keys [slug series scenes char-name handle blob]} rows]
              (println (str/join "\t" [slug (or char-name "?") series (str "scenes=" scenes)
                                       handle (if blob "has-image" "no-image")])))
            (println (str core/producer-name "\t(producer)\t-\t-\t"
                          (core/handle core/producer-name)))))
        (.exit js/process 0)))))

(-main)
