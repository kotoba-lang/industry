(ns produce
  "The producer bot: grow the club-shinshi cast by minting NEW original
   characters from the official deterministic factory
   (club-shinshi-app tools/char-factory.cljs) and landing them in D1.

   The factory is the sole authority on who a character is — this script
   never invents a character itself. It runs the factory for the first
   2000 deterministic indices, keeps only slugs the live catalog does not
   already have, applies exactly those actress/profile INSERTs, and adds
   one debut post (rkey `intro`, same voice as tools/char-posts.cljs) so
   the newcomer has a feed on shinshi.club from day one. Scene images and
   catalog videos are NOT generated here — the existing pipelines
   (char-images.cljs, the catalog-video loop / shinshi-video-actor) pick
   up unfilled characters on their own.

   Everything applied is verified by counting the rows back; a shortfall
   is a local failure, not a success with a caveat.

   usage:
     kbb --backend sci --classpath scripts/shinshi-cast-bots scripts/shinshi-cast-bots/produce.cljk \\
        [--count N] [--dry-run]     # default N=12, one per series-sized batch

   Exit: cast-core contract (0 / 1 local failure / 2 refused)."
  (:require [cast-core :as core]
            [cast-d1 :as d1]
            [clojure.string :as str]
            ["node:child_process" :as cp]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]))

(def argv (vec *command-line-args*))
(defn- flag? [f] (boolean (some #{f} argv)))
(defn- flag-val [f]
  (let [i (first (keep-indexed (fn [i s] (when (= s f) i)) argv))]
    (when i (nth argv (inc i) nil))))

(def dry? (flag? "--dry-run"))
(def n (or (some-> (flag-val "--count") js/parseInt) 12))
(def factory-horizon "2000")

(defn cap [w] (if (empty? w) w (str (str/upper-case (subs w 0 1)) (subs w 1))))
(defn char-name [slug]
  (->> (take 2 (str/split slug #"-")) (map cap) (str/join " ")))

(defn run-factory!
  "-> {:index [slug...] :actress-lines [..] :profile-lines [..]} or nil."
  []
  (let [scratch (path/join (os/tmpdir) (str "shinshi-produce-" (.now js/Date)))
        out (path/join scratch "factory")
        r (cp/spawnSync "nbb" #js ["tools/char-factory.cljs" factory-horizon out]
                        #js {:encoding "utf8" :cwd d1/appview-dir
                             :maxBuffer (* 64 1024 1024)})]
    (if-not (zero? (.-status r))
      (do (println (str "REFUSED: char-factory failed — " (str/trim (str (.-stderr r)))))
          nil)
      (let [files (sort (js->clj (fs/readdirSync out)))
            slurp-all (fn [prefix]
                        (->> files
                             (filter #(str/starts-with? % prefix))
                             (mapcat #(str/split-lines (fs/readFileSync (path/join out %) "utf8")))
                             (remove str/blank?) vec))
            index (->> (js->clj (js/JSON.parse (fs/readFileSync (path/join out "index.json") "utf8"))
                               :keywordize-keys true)
                       (mapv :slug))]
        {:index index
         :actress-lines (slurp-all "actress-")
         :profile-lines (slurp-all "profile-")}))))

(defn intro-insert [slug now]
  (let [did (core/actress-did slug)
        uri (str "at://" did "/app.bsky.feed.post/intro")
        record {:$type "app.bsky.feed.post"
                :text (core/intro-text (char-name slug))
                :createdAt now
                :langs ["ja"]
                :labels {:$type "com.atproto.label.defs#selfLabels"
                         :values [{:val "nsfw"}]}}
        vj (js/JSON.stringify (clj->js record))]
    (str "INSERT OR REPLACE INTO vertex_repo_record "
         "(uri, cid, collection, rkey, repo, value_json, created_at, indexed_at) VALUES ('"
         (d1/sql-escape uri) "','','app.bsky.feed.post','intro','"
         (d1/sql-escape did) "','" (d1/sql-escape vj) "','" now "','" now "');")))

(defn -main []
  (let [existing (d1/existing-slugs)
        factory (when existing (run-factory!))]
    (cond
      (nil? existing)
      (do (println "REFUSED: catalog unanswerable (D1)") (.exit js/process 2))

      (nil? factory)
      (.exit js/process 2)

      :else
      (let [{:keys [index actress-lines profile-lines]} factory
            new-slugs (vec (take n (remove existing index)))]
        (if (empty? new-slugs)
          (do (println (str "nothing-to-produce: the catalog already holds the first "
                            factory-horizon " factory characters"))
              (.exit js/process 0))
          (let [wanted (set new-slugs)
                a-sql (filterv (fn [l] (some #(str/includes? l (str "VALUES ('" % "','")) wanted))
                               actress-lines)
                p-sql (filterv (fn [l] (some #(str/includes? l (str ":" % "/ai.gftd.apps.shinshi.modelProfile")) wanted))
                               profile-lines)
                now (core/whole-second-iso)
                i-sql (mapv #(intro-insert % now) new-slugs)]
            (if (or (not= (count a-sql) (count new-slugs))
                    (not= (count p-sql) (count new-slugs)))
              (do (println (str "LOCAL-FAILURE: factory SQL lines did not match slugs — actress="
                                (count a-sql) " profile=" (count p-sql)
                                " expected=" (count new-slugs)))
                  (.exit js/process 1))
              (if dry?
                (do (doseq [s new-slugs]
                      (println (str "would-produce\t" s "\t" (core/actress-url s))))
                    (.exit js/process 0))
                (let [tmp (path/join (os/tmpdir) (str "shinshi-produce-sql-" (.now js/Date)))
                      _ (fs/mkdirSync tmp #js {:recursive true})
                      af (path/join tmp "actress.sql")
                      rf (path/join tmp "recordlog.sql")]
                  (fs/writeFileSync af (str/join "\n" a-sql))
                  (fs/writeFileSync rf (str/join "\n" (concat p-sql i-sql)))
                  (let [ok-a (d1/d1-exec-file! core/shinshi-db af)
                        ok-r (d1/d1-exec-file! core/recordlog-db rf)
                        landed (when (and ok-a ok-r)
                                 (d1/d1-query core/shinshi-db
                                              (str "SELECT COUNT(*) AS c FROM actress WHERE slug IN ("
                                                   (d1/sql-in new-slugs) ")")))
                        c (some-> landed first :c)]
                    (doseq [s new-slugs]
                      (println (str "produced\t" s "\t" (char-name s) "\t" (core/actress-url s))))
                    (println (str "verified: actress-rows=" (or c "unanswered")
                                  "/" (count new-slugs)
                                  " — images/videos pending (char-images + catalog-video loop)"))
                    (.exit js/process
                           (if (= c (count new-slugs)) 0 1))))))))))))

(-main)
