<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gftd.rule-kaizen</string>

  <!-- ローカル Claude loop（superproject ADR-2608261200）。姉妹の
       com.gftd.adr-inventory と同じ 2 段構え:
         1) scripts/rule-kaizen-tick.cljs が候補を測る（決定論）
         2) 候補があるときだけ claude -p /rule-kaizen を起こす

       1 反復 = 1 finding。決定の中身を疑う仕事なので毎日 1 件。

       止め方:
         launchctl bootout gui/$(id -u)/com.gftd.rule-kaizen
       候補だけ見る（モデルを起こさない）:
         nbb --classpath ".:scripts/nbb_compat" scripts/rule-kaizen-loop.cljs --dry-run

       この plist の着地だけでは LaunchAgents へ bootstrap しない。 -->

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/nbb</string>
    <string>--classpath</string>
    <string>.:scripts/nbb_compat</string>
    <string>scripts/rule-kaizen-loop.cljs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/junkawasaki/github/com-junkawasaki</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>COM_JUNKAWASAKI_ROOT</key>
    <string>/Users/junkawasaki/github/com-junkawasaki</string>
    <key>HOME</key>
    <string>/Users/junkawasaki</string>
    <key>USER</key>
    <string>junkawasaki</string>
    <key>LOGNAME</key>
    <string>junkawasaki</string>
    <key>SHELL</key>
    <string>/bin/zsh</string>
  </dict>

  <key>StartInterval</key>
  <integer>86400</integer>
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/junkawasaki/.itonami/rule-kaizen.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/junkawasaki/.itonami/rule-kaizen.stdout.log</string>
</dict>
</plist>
