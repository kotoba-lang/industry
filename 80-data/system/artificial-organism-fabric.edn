{:fabric/id :com-junkawasaki/artificial-organism
 :fabric/version 1
 :fabric/language :kotoba
 :fabric/invariants
 [:content-addressed-inputs
  :capability-before-execution
  :wasm-only-untrusted-code
  :signed-fast-forward-code-promotion
  :tests-before-canary
  :human-gate-for-financial-scale-up
  :bounded-autonomy
  :append-only-evidence]

 :layers
 [{:layer/id :language
   :repos ["orgs/kotoba-lang/kotoba"]
   :provides [:kotoba-source :compiler :wasm-component]}
  {:layer/id :decision-runtime
   :repos ["orgs/kotoba-lang/aiueos" "orgs/kotoba-lang/kototama"]
   :provides [:capability-decision :policy-audit :wasm-host]}
  {:layer/id :compute
   :repos ["orgs/kotoba-lang/murakumo" "orgs/network-awai/cloud-murakumo"]
   :provides [:placement :llm-kaizen :distributed-worker :run-ledger]}
  {:layer/id :storage
   :repos ["orgs/kotoba-lang/kotobase" "orgs/kotoba-lang/kotobase-peer"
           "orgs/kotoba-lang/kotobase-protocols" "orgs/kotoba-lang/bonsai"
           "orgs/kotoba-lang/nekko" "orgs/net-kotobase/control-plane"]
   :provides [:datoms :content-addressed-objects :git-projection :actor-journal]}
  {:layer/id :settlement
   :repos ["orgs/kotoba-lang/engi" "orgs/network-awai/nexus-x402"]
   :provides [:mutual-credit :x402 :receipt :spend-policy]}
  {:layer/id :social
   :repos ["orgs/network-awai/app-aozora"]
   :provides [:actor-account :pds :social-post :appview]}]

 ;; 2026-08-13 (ADR-2608137200): every :repo below was the pre-rename /
 ;; pre-org-transfer path. 9 of them did not exist on disk at all and 4 pointed
 ;; at a west-UNDECLARED duplicate checkout, so `:repo/exists? false` was the
 ;; normal reading of this file. Each right-hand side is the `path:` west
 ;; declares for the SAME GitHub repository id -- the mapping was taken from the
 ;; id, never from name similarity. `:org` is left as recorded: it names the
 ;; business owner of the product, not the GitHub org that now holds the repo.
 :products
 [{:product/id :itonami :org :gftdcojp :repo "orgs/network-awai/cloud-itonami"}
  {:product/id :manimani :org :gftdcojp :repo "orgs/network-awai/local-manimani"}
  {:product/id :isekai :org :gftdcojp :repo "orgs/network-awai/network-isekai"}
  {:product/id :shinshi :org :jk-luxury :repo "orgs/network-awai/club-shinshi"}
  {:product/id :yukkuri :org :gftdcojp :repo "orgs/cloud-itonami/yukkuri"}
  {:product/id :dougaka :org :gftdcojp :repo "orgs/cloud-itonami/ai-gftd-dougaka"}
  {:product/id :animeka :org :gftdcojp :repo "orgs/cloud-itonami/animeka"}
  {:product/id :mangaka :org :gftdcojp :repo "orgs/cloud-itonami/mangaka"}
  {:product/id :babiniku :org :jk-luxury :repo "orgs/network-awai/net-babiniku"}]

 :flow
 [{:from :kotoba-source :to :compiler :contract :compile}
  {:from :compiler :to :capability-decision :contract :request-capabilities}
  {:from :capability-decision :to :wasm-host :contract :host-caps}
  {:from :wasm-host :to :distributed-worker :contract :job}
  {:from :distributed-worker :to :content-addressed-objects :contract :artifact-cids}
  {:from :content-addressed-objects :to :run-ledger :contract :evidence}
  {:from :run-ledger :to :receipt :contract :metering}
  {:from :receipt :to :x402 :contract :settlement}
  {:from :actor-journal :to :git-projection :contract :signed-ref}
  {:from :git-projection :to :llm-kaizen :contract :bounded-change-request}
  {:from :llm-kaizen :to :kotoba-source :contract :pull-request}
  {:from :actor-account :to :social-post :contract :create-record}
  {:from :social-post :to :appview :contract :firehose-index}]

 :kaizen
 {:code-host "https://git.kotobase.net"
  :git-engine :bonsai
  :identity-engine :nekko
  :model-gateway "https://api.murakumo.cloud/v1"
  :promotion [:observe :propose :test :review :canary :promote]
  :deny [:direct-main-write :unsigned-ref :unbounded-loop :secret-exfiltration
         :policy-bypass :unapproved-financial-scale-up]
  :rollback :last-signed-content-addressed-head}

 :public-health
 {:local-report "80-data/system/artificial-organism-health.edn"
  :public-projection "https://murakumo.cloud/health/fabric.json"
  :dimensions [:checkout :git :ci :runtime :storage :compute :settlement :social :freshness]
  :activity {:ci {:event-id "fe1b3ba8-e8ea-4b03-9d82-92cd279af39b"
                  :state-url "https://murakumo.cloud/api/kaizen/events/fe1b3ba8-e8ea-4b03-9d82-92cd279af39b"}
             :spend {:stats-url "https://x402.nexus/stats"}
             :posts {:count 9
                     :receipt "80-data/system/artificial-organism-actors.json"
                     :cadence-receipt "80-data/system/artificial-organism-actor-cadence.json"
                     :schedule "launchd weekly Sunday 12:00 Asia/Tokyo"
