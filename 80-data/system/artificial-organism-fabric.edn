                     :latest-cid "bafyreia6k5m4shq47vux6c2t5btkt3lymqe7kpfhluf34iafh6nbrr6s3q"}}
  :live-probes [{:id :murakumo :url "https://murakumo.cloud/organism/pulse.json"}
                {:id :aozora-pds :url "https://pds.aozora.app/xrpc/com.atproto.server.describeServer"}
