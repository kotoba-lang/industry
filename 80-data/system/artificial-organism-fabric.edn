                {:id :animeka-actor :url "https://pds.aozora.app/xrpc/com.atproto.identity.resolveHandle?handle=animeka-organism.aozora.app"}]}

 :gaps
  [{:gap/id :git-signed-push :severity :critical :status :complete
   :now "live ordinary git push through git-remote-kotobase proves canonical nekko sigrefs, owner-rooted delegated CACAO chains, temporal/resource-narrowing validation, durable nonce replay fencing and repo-configured 2-of-2 distinct-signer quorum before transactional CAS; under-quorum, replay and force pushes are rejected, while two fast-forward pushes and readback pass"
   :target "bonsai fast-forward policy + nekko sigref/CACAO gate + receive-pack-compatible push"}
  {:gap/id :git-object-integrity :severity :high :status :complete
   :now "Worker recomputes Git SHA-1 over canonical object bytes, rejects mismatch, stores deflated loose object, and records SHA-256 content identity"
   :target "verify object bytes and project canonical Kotoba CID alongside Git OID"}
  {:gap/id :git-storage-scale :severity :high :status :complete
   :now "ref promotion requires CACAO-authorized Kotobase Datom transact plus authenticated read-back; canonical Git object bytes are stored under CIDv1 raw/sha2-256 keys in the kotobase.protocols.blocks space, D1 records Git OID to Kotoba CID, and deflated Git loose objects are reconstructable delivery cache. Live R2 bytes, CID digest and Git SHA-1 all rehash consistently"
   :target "Kotobase transactional refs + content-addressed block storage; KV only edge cache"}
  {:gap/id :kaizen-cicd :severity :critical :status :complete
   :now "live witness fe1b3ba8-e8ea-4b03-9d82-92cd279af39b proves signed main ref -> D1 outbox -> Cloudflare Queue -> Murakumo fleet claim -> exact content-addressed checkout -> git fsck + permission-sandboxed tests -> signed same-SHA canary ref -> canary-live result"
   :target "repo event -> bounded change request -> Murakumo job -> tests -> signed canary promotion"}
  {:gap/id :wasm-product-cutover :severity :high :status :complete
   :now "all nine products publish Kotoba source, package lock, deny-by-default HostCaps policy, content SHA-256 and native WebAssembly execution evidence; root verifier passes 9/9 and itonami's full kernel gate passes 45 tests/1144 assertions. isekai's legacy frozen app compiler remains separately labeled and is not used as cutover evidence"
