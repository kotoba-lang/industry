# direnv entrypoint for this superproject.
# VALUES DO NOT BELONG IN THIS FILE — it is tracked by git and every bot
# profile / clone of com-junkawasaki/root can read its whole history.
# The 2026-09-16 repowide audit found two live Hume API keys exported here;
# they were moved out (rotation still required — old values persist in git
# history). Machine-local secrets live in ~/.secrets/direnv-root.sh (600).
# Add per-machine exports to that file, never to this one.
if [ -f "$HOME/.secrets/direnv-root.sh" ]; then
  source "$HOME/.secrets/direnv-root.sh"
fi
