;; Authoritative manifest, in the shape ADR-2607140900 D1 requires of every
;; KAMI Genre Benchmark sample.
;;
;; Honesty note carried from that ADR: the reference genre describes the load
;; and production workflow being aimed at, not a claim that this is finished.
;; Measured numbers go in `:sample/measurements`; the only ones there are the
;; simulation figures, because no frame has been rendered yet.
{:sample/id "boutique-stack"
 :sample/name "Boutique Stack"
 :sample/dimension :3d
 :sample/genre :shop-tycoon
 :sample/reference-category
 "Stack-and-carry shop management, in the shape the genre settled into on
  mobile: restock by hand, man the till, spend the takings on departments and
  staff. Original IP throughout."

 :sample/tier
 {:playable {:target-fps 60
             :device "mid-range mobile, WebGL 2.0 fallback path"
             :agents-max 40}
  :showcase {:target-fps 60
             :device "desktop WebGPU"
             :agents-max 120
             :notes "full shop, every department open, carried stacks visible"}
  :meltdown {:notes "customer spawn rate and department count forced upward to
                     find the frame-pacing knee; never the default for a
                     played shop"
             :agents-max 800}}

 :sample/capabilities
 {:required #{:instanced-mesh :skinned-mesh :input-pointer :deterministic-rng}
  :optional #{:audio :haptics :cloud-save}
  :absent #{:multiplayer :networked-authority :navmesh}}

 :sample/scenarios
 [{:scenario/id :restock
   :scenario/what "Carry stock from a crate to a rack."
   :scenario/gate "Stock is conserved: moving a garment never mints or loses
                   one."
   :scenario/status :passing}
  {:scenario/id :progression
   :scenario/what "Play a shop until every department is open."
   :scenario/gate "A greedy manager reaches the last department inside the
                   shift, and each department opens at a distinct minute."
   :scenario/status :passing
   :scenario/measured "bs-flagship: outerwear at minute 10, shoes at minute 15
                       of a 20-minute shift"}
  {:scenario/id :leak
   :scenario/what "Serve more customers than the shop loses."
   :scenario/gate "Walkouts stay below served, split by cause so the two are
                   not confused."
   :scenario/status :passing
   :scenario/measured "677 served, 25 lost (3%) — 15 to bare shelves, 10 to
                       the queue"}
  {:scenario/id :dead-content
   :scenario/what "Every hireable role is worth hiring at some point."
   :scenario/gate "The manager buys each role on a full shift."
   :scenario/status :passing
   :scenario/measured "3 stockers, 2 cashiers. A one-till shop fails this —
                       the player alone covers a single till."}
  {:scenario/id :determinism
   :scenario/what "Same shop, same seed, same tick count, three runtimes."
   :scenario/gate "`sim/digest` is equal across headless nbb, browser and the
                   packaged mobile shell."
   :scenario/status :partial
   :scenario/measured "headless nbb only; browser and shell not yet run"}]

 :sample/budgets
 {:frame-ms {:p50 8 :p95 16 :p99 24}
  :draw-calls {:max 12 :note "instanced per mesh; carried stacks batch with
                              their garment type"}
  :instances {:typical 400 :max 3000}
  :heap-mb {:max 96}
  :status :declared
  :note "Declared targets, not measurements. No frame has been rendered."}

 :sample/measurements
 [{:measurement/what "20-minute shift, greedy manager, seed 20260808"
   :measurement/where "headless nbb"
   :measurement/served 677
   :measurement/lost 25
   :measurement/revenue 67052
   :measurement/digest 791045350
   :measurement/date "2026-08-08"}]

 :sample/attribution
 {:origin "Original work for network-isekai."
  :inspiration "The mobile shop-tycoon genre as a category."
  :assets "Meshes not yet produced; `art/meshes` describes what the renderer
           expects to load."}

 :sample/license "See the network-isekai repository license."

 :sample/entrypoints
 {:logic "isekai.games.boutique-stack.sim"
  :render "isekai.games.boutique-stack.render-ir/scene"
  :shops "resources/shops/*.edn"
  :headless "run-tests.cljs, shift.cljs"}

 :sample/shell
 {:manifest "shell/app.edn"
  :status :unbuilt
  :note "iOS/Android packaging is configured but has never been executed —
         see docs/publishing.md in the kingdom-cascade directory, which
         covers the same kotoba-shell path."}

 :sample/known-gaps
 [{:gap/what "No sinks after everything is maxed: a 20-minute shift ends with
              ~39k idle cash and nothing to spend it on."
   :gap/why "Three departments and three upgrades is the whole economy. Real
             progression needs more departments, decoration, or a prestige
             loop."}
  {:gap/what "No cleaning or mess mechanic, though the genre usually has one."
   :gap/why "Scoped out; it would add a third loss mode and a fourth role."}]}
