  "../../../../../orgs/kotoba-lang/expr/src"
  "../../../../../orgs/kotoba-lang/fsm/src"
  "../../../../../orgs/kotoba-lang/gpu/src"
  "../../../../../orgs/kotoba-lang/host/src"
  "../../../../../orgs/kotoba-lang/html/src"
  "../../../../../orgs/kotoba-lang/jp-go-digital-design-system/src"
  "../../../../../orgs/kotoba-lang/jp-go-digital-design-system/resources"
  "../../../../../orgs/kotoba-lang/level/src"
  "../../../../../orgs/kotoba-lang/netsync/src"
  "../../../../../orgs/kotoba-lang/org-w3-webgpu/src"
  "../../../../../orgs/kotoba-lang/physics/src"
  "../../../../../orgs/kotoba-lang/physics/resources"
  "../../../../../orgs/kotoba-lang/pipelines/src"
