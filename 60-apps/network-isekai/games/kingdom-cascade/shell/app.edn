;; kotoba-shell application manifest for Kingdom Cascade.
;;
;; Consumed by `kotoba-shell app scaffold / build / package`
;; (kotoba-lang/shell, pin fae4ee4 — see ADR-2608072000).
;;
;; STATUS: written, never executed. No `app scaffold` has been run against
;; this file. See docs/publishing.md for exactly what that means and what is
;; still unknown.
{:app/id "network.isekai.kingdom-cascade"
 :app/name "Kingdom Cascade"
 :app/version "0.1.0"
 :app/build 1
 :app/description "Swap-and-match puzzle. Break the cellar open."

 ;; The web bundle the shell wraps. shadow-cljs output, same bundle the
 ;; browser build on isekai.network serves.
 :app/web-root "../web/dist"
 :app/entry "index.html"

 :ios
 {:ios/product-name "KingdomCascade"
  :ios/bundle-id "network.isekai.kingdom-cascade"
  ;; Set both, always. Info.plist falls back to $(PRODUCT_NAME) when
  ;; CFBundleName is unset, which in a scaffolded app means the shell's own
  ;; default — the app shows its real name inside itself while the home
  ;; screen and the permission sheets say "KotobaShell". Fixed upstream in
  ;; fae4ee4; setting these is how a consumer stays fixed.
  :ios/bundle-name "Kingdom Cascade"
  :ios/display-name "Kingdom Cascade"
  :ios/deployment-target "16.0"
  :ios/orientations [:portrait]
  :ios/status-bar :light-content
  ;; `app package` refuses with `team-id-required` until this is real. That
  ;; refusal is the feature: an unsigned .ipa builds fine and installs on
  ;; nothing, and the exit code is the only place that difference is visible.
  :apple/team-id nil}

 :android
 {:android/application-id "network.isekai.kingdom_cascade"
  :android/label "Kingdom Cascade"
  :android/min-sdk 26
  :android/target-sdk 34
  :android/orientations [:portrait]
  ;; `app package` refuses with `keystore-required` until Gradle can find a
  ;; keystore. Play rejects an unsigned .aab, and it too builds with exit 0.
  :android/keystore nil
  :android/keystore-alias nil}

 ;; Capability policy. Deny-by-default is the shell's posture; this list is
 ;; the whole of what the game is allowed to reach.
 ;;
 ;; `app scaffold` writes this to a JSON asset that the Swift and Java
 ;; bridges re-evaluate in-process, so the CLI and the shipped app decide
 ;; identically — a policy that only the CLI enforces is not a policy. If the
 ;; asset cannot be read the bridge denies everything, which is the correct
 ;; direction to fail for a packaging accident.
 :policy
 {:allow #{;; Progress, level unlocks, settings. The only thing the game
           ;; genuinely needs to keep.
           [:storage/get] [:storage/set] [:storage/delete]
           ;; Daily-life timers. Read-only.
           [:clock/now]}
  :deny #{;; Named rather than merely absent. A match-3 game has no business
          ;; touching any of these, and writing them down means a later
          ;; "just for analytics" addition has to delete a line someone chose.
          [:http/fetch]
          [:fs/read] [:fs/write] [:fs/list]
          [:keychain/get] [:keychain/set]
          [:notify/show]
          [:clipboard/read] [:clipboard/write]
          [:contacts/list] [:calendar/list] [:webauthn/assert]}}

 ;; Recorded so nobody re-derives it from the provider catalog, which claims
 ;; all three for iOS and Android. That claim is true of the CLI and false of
 ;; the build — the shipped bridge carries the 10 portable commands only.
 :notes
 {:macos-only-commands [:contacts :calendar :webauthn]
  :bridge-commands 10}}
