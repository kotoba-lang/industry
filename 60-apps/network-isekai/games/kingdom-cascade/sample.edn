;; Authoritative manifest for this game, in the shape ADR-2607140900 D1
;; requires of every KAMI Genre Benchmark sample: one source serving all four
;; roles — a playable game on isekai.network, a genre template to fork, a
;; reference project to open in Studio, and a regression benchmark.
;;
;; Honesty note carried from that same ADR: "AAA" and the reference genre name
;; below describe the load and production workflow being aimed at, not a claim
;; that this is finished. Measured numbers go in `:sample/measurements`, which
;; is empty because none have been measured yet.
{:sample/id "kingdom-cascade"
 :sample/name "Kingdom Cascade"
 :sample/dimension :2d
 :sample/genre :match-3-puzzle
 :sample/reference-category
 "Swap-and-match puzzle with obstacle clearing, in the shape the genre
  settled into on mobile. Original IP throughout — no title, character, art,
  level, string or specific rule is taken from any commercial game."

 :sample/tier
 {:playable {:target-fps 60
             :device "mid-range mobile, WebGL 2.0 fallback path"
             :board-max [9 11]}
  :showcase {:target-fps 60
             :device "desktop WebGPU"
             :board-max [11 13]
             :notes "full cascade effects, no quality reduction"}
  :meltdown {:notes "board scaled up and cascade depth forced, to find the
                     frame-pacing knee; never the default for a played level"
             :board-max [40 40]}}

 :sample/capabilities
 {:required #{:sprite2d :input-pointer :deterministic-rng}
  :optional #{:audio :haptics :cloud-save}
  :absent #{:multiplayer :networked-authority :3d}}

 :sample/scenarios
 [{:scenario/id :deal
   :scenario/what "Deal a level and settle the opening board."
   :scenario/gate "No match is present when the player gets control."}
  {:scenario/id :cascade
   :scenario/what "Resolve a swap through blasts, matches and settling."
   :scenario/gate "Reaches a fixed point; the runaway guard is never hit."}
  {:scenario/id :determinism
   :scenario/what "Same level, same seed, same move list, three runtimes."
   :scenario/gate "`core/digest` is equal across headless nbb, browser and
                   the packaged mobile shell."
   :scenario/status :partial
   :scenario/measured "headless nbb only; browser and shell not yet run"}
  {:scenario/id :solvability
   :scenario/what "Play a level to a terminal state with the built-in hint."
   :scenario/gate "Terminates in :won or :lost — never deadlocks."}]

 :sample/budgets
 {:frame-ms {:p50 8 :p95 16 :p99 24}
  :draw-calls {:max 4 :note "one atlas page, batched per layer"}
  :sprites {:typical 200 :max 1600}
  :heap-mb {:max 64}
  :status :declared
  :note "Declared targets, not measurements. `:sample/measurements` stays
         empty until a real device profile has been recorded."}

 :sample/measurements []

 :sample/attribution
 {:origin "Original work for network-isekai."
  :inspiration "The mobile match-3 genre as a category."
  :assets "Atlas art not yet produced; `art/atlas` describes the layout the
           renderer expects."}

 :sample/license "See the network-isekai repository license."

 :sample/entrypoints
 {:logic "isekai.games.kingdom-cascade.core"
  :render "isekai.games.kingdom-cascade.render-ir/scene"
  :levels "resources/levels/*.edn"
  :headless "run-tests.cljs, play.cljs"}

 :sample/shell
 {:manifest "shell/app.edn"
  :status :unbuilt
  :note "iOS/Android packaging is configured but has never been executed —
         see docs/publishing.md."}}
