;; Kingdom Cascade — level 1, "Cellar Steps".
;;
;; A plain 8x8 with two bands of crates. Teaches the one thing a first level
;; has to teach: a match *next to* a crate breaks the crate, you never match
;; on top of one.
;;
;; Glyphs: `.` ground  `*` spawner  `c` crate  `s` stone  `i` ice  `f` frost
;;         `#` outside the play area
{:level/id "kc-001"
 :level/name "Cellar Steps"
 :level/chapter 1
 :level/preset :royal-cellar
 ;; Budget tuned against `levels.cljs`: the crate bands all fall to one good
 ;; swap, so the crates alone are not a level. The coin goal is what the 12
 ;; moves are actually for.
 :level/moves 12
 :level/seed 20260808
 :level/colors [:coin :gem :clover :goblet]
 :level/goals [{:goal/kind :block :goal/block :crate :goal/count 8}
               {:goal/kind :collect :goal/color :coin :goal/count 40}]
 :level/grid ["........"
              "........"
              "..cccc.."
              "........"
              "..cccc.."
              "........"
              "........"
              "........"]}
