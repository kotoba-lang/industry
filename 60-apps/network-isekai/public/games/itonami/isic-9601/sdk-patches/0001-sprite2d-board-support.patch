+(defn prim-bounds
+  "Axis-aligned bounds `[x0 y0 x1 y1]` of one EDN primitive in sprite-local units, or nil
+   for a primitive that draws nothing. Mirrors what `kami.sprite2d/draw-shape!` paints:
+   every primitive except `:arc` is centred on `:dx`/`:dy`."
+  [[kind o]]
+  (let [dx (:dx o 0) dy (:dy o 0)
+        box (fn [hw hh] [(- dx hw) (- dy hh) (+ dx hw) (+ dy hh)])]
+    (cond
+      (= kind :circle)  (let [r (:r o 10)] (box r r))
+      (= kind :ellipse) (box (:rx o 10) (:ry o 10))
+      (= kind :rect)    (box (/ (:w o 10) 2) (/ (:h o 10) 2))
+      (= kind :image)   (box (/ (:w o 100) 2) (/ (:h o 100) 2))
+      ;; a stroked arc reaches r plus half its stroke width in every direction; treating
+      ;; it as the full circle over-covers the open side, which is the safe direction for
+      ;; a tap target
+      (= kind :arc)     (let [e (+ (:r o 10) (/ (:w o 8) 2))] (box e e))
+      ;; text advance without a canvas to measure with: 0.58em per character is a
+      ;; reasonable mean for the sans stack the painter uses. Approximate, and only ever
+      ;; used for hit-testing -- never for drawing.
+      (= kind :text)    (let [sz (:size o 24)
+                              n  (count (str (:text o "")))]
+                          (box (* 0.29 sz n) (* 0.6 sz)))
+      :else nil)))
+
+(defn sprite-bounds
+  "Union of a sprite's primitive bounds, `[x0 y0 x1 y1]` in sprite-local units, or nil for
+   a sprite that draws nothing. Pure geometry -- ignores `:anim`, which displaces a part
+   for a few pixels per frame and would make a tap target twitch."
+  [sprite]
+  (let [bs (keep prim-bounds sprite)]
+    (when (seq bs)
+      [(reduce min (map #(nth % 0) bs))
+       (reduce min (map #(nth % 1) bs))
+       (reduce max (map #(nth % 2) bs))
+       (reduce max (map #(nth % 3) bs))])))
+
+(defn hit-boxes
+  "The draw list, each op given its screen-space `:box [x0 y0 x1 y1]`. Ops whose sprite
+   draws nothing are dropped. Order is painter order (far first), so the LAST match under
+   a point is the topmost one."
+  [scene snap W H]
+  (let [k (scale-k scene W H)]
+    (->> (draw-list scene snap W H)
+         (keep (fn [op]
+                 (when-let [b (sprite-bounds (:sprite op))]
+                   (assoc op :box [(+ (:sx op) (* k (nth b 0)))
+                                   (+ (:sy op) (* k (nth b 1)))
+                                   (+ (:sx op) (* k (nth b 2)))
+                                   (+ (:sy op) (* k (nth b 3)))]))))
+         vec)))
+
+(defn pick
+  "Which entity is under screen point [mx my]? Returns the topmost draw op (with `:box`),
+   or nil. Optional `pad` grows every box by that many screen px, for finger-sized targets.
+
+   This is the piece a board game cannot be built without and the package did not have:
+   `draw-list` maps world→screen, and nothing mapped back. Every tap-driven game on this
+   painter therefore had to re-derive the camera transform itself, which is exactly the
+   duplication `world->screen` was added to prevent -- and re-derive it as a *guess*,
+   since sprite extents were not exposed at all."
+  ([scene snap W H p] (pick scene snap W H p 0))
+  ([scene snap W H [mx my] pad]
+   (->> (hit-boxes scene snap W H)
+        (filter (fn [op]
+                  (let [b (:box op)]
+                    (and (>= mx (- (nth b 0) pad)) (<= mx (+ (nth b 2) pad))
+                         (>= my (- (nth b 1) pad)) (<= my (+ (nth b 3) pad))))))
+        last)))
+
 (defn tree-scatter
   "Deterministic background tree scatter [[x y r]…] — the same seeded positions kami.sprite2d paints,
    as pure data so both Canvas2D and GPU renderers share one source."
