-      (let [s1 (bit-and (+ (* 1103515245 s) 12345) 0x7fffffff)
-            s2 (bit-and (+ (* 1103515245 s1) 12345) 0x7fffffff)
-            s3 (bit-and (+ (* 1103515245 s2) 12345) 0x7fffffff)
-            x (- (* (/ s1 0x7fffffff) (* 2 spread)) spread)
-            y (- (* (/ s2 0x7fffffff) (* 2 spread)) spread)
-            r (+ 70 (* (/ s3 0x7fffffff) 120))]
-        (recur (inc i) s3 (conj acc [x y r]))))))
+;; board support (2026-08-08): hit-testing for tap-driven games
+(def prim-bounds   impl/prim-bounds)
+(def sprite-bounds impl/sprite-bounds)
+(def hit-boxes     impl/hit-boxes)
+(def pick          impl/pick)
diff --git a/test/sprite2d_board_test.clj b/test/sprite2d_board_test.clj
new file mode 100644
index 0000000..8e5fe5f
--- /dev/null
+++ b/test/sprite2d_board_test.clj
@@ -0,0 +1,163 @@
+(ns sprite2d-board-test
+  "Layout tests for the board-game additions (2026-08-08): the `:fixed`/`:fit` camera
+   modes, sprite bounds, and `pick`. Pure — no canvas, same as `sprite2d-layout-test`.
+
+   These exist because the package was built for a top-down world with an avatar to
+   follow, and a board game (a shop floor, a world map) has neither: no `\"player\"`
+   entity to anchor on, a known extent that should be framed whole, and interaction that
+   is entirely 'what did the finger land on'."
+  (:require [clojure.test :refer [deftest is]]
+            [kotoba.sprite2d.layout :as layout]))
+
+(def W 800.0)
+(def H 600.0)
+
+(def machine
+  [[:rect {:dx 0 :dy 0 :w 120 :h 80 :fill [0.2 0.4 0.9]}]
+   [:circle {:dx 0 :dy 0 :r 26 :fill [0.9 0.9 1]}]
+   [:text {:dx 0 :dy 60 :text "¥240" :size 20 :fill [1 1 1]}]])
+
+(def board-scene
+  {:render/sprite2d {:camera {:mode :fixed :x 500 :y 300}}
+   :sprites {:washer machine}})
+
+(def snap [{:tag "washer" :pos [500 300 0]}])
+
+;; --------------------------------------------------------------------------
+;; camera modes
+;; --------------------------------------------------------------------------
+
+(deftest fixed-camera-needs-no-player
+  ;; the whole point: a board has no avatar, and the default mode would silently
+  ;; anchor at world origin, putting the board off screen with no error anywhere
+  (is (= [500 300] (layout/camera board-scene snap)))
+  (is (= [500 300] (layout/camera board-scene []))))
+
+(deftest default-camera-still-follows-the-player
+  (let [scene {:render/sprite2d {}}
+        s [{:tag "player" :pos [90 -40 0]}]]
+    (is (= [90 -40] (layout/camera scene s)))))
+
+(deftest side-camera-is-unchanged
+  (let [scene {:render/sprite2d {:camera {:mode :side :y 120 :x-offset -50}}}
+        s [{:tag "player" :pos [400 999 0]}]]
+    (is (= [350 120] (layout/camera scene s)))))
+
+(deftest fixed-camera-centres-the-entity-on-screen
+  (let [op (first (layout/draw-list board-scene snap W H))]
+    (is (== (:sx op) (/ W 2.0)))
+    (is (== (:sy op) (/ H 2.0)))))
+
+(deftest fit-camera-anchors-at-the-rect-centre
+  (let [scene {:render/sprite2d {:camera {:mode :fit :rect [0 0 1000 400]}}
+               :sprites {:washer machine}}]
+    (is (= [500.0 200.0] (layout/camera scene [])))))
+
+(deftest fit-scale-frames-the-whole-rect
+  (let [scene {:render/sprite2d {:camera {:mode :fit :rect [0 0 1000 400] :pad 0.0}}
+               :sprites {:washer machine}}
+        k (layout/scale-k scene W H)]
+    ;; 800/1000 = 0.8 wide, 600/400 = 1.5 tall -> width is the binding constraint
+    (is (== k 0.8))
+    ;; and the rect really does fit: its corners land inside the viewport
+    (let [[sx sy _] (layout/world->screen scene [] W H)]
+      (is (>= (sx 0) 0.0)) (is (<= (sx 1000) W))
+      (is (>= (sy 400) 0.0)) (is (<= (sy 0) H)))))
+
+(deftest fit-scale-adapts-to-the-viewport
+  ;; the reason :fit exists — a fixed :scale can only be right for one screen size
+  (let [scene {:render/sprite2d {:camera {:mode :fit :rect [0 0 1000 400]}}}]
+    (is (< (layout/scale-k scene 400.0 300.0)
+           (layout/scale-k scene 1600.0 1200.0)))))
+
+(deftest scale-k-two-arg-form-is-untouched
+  (let [scene {:render/sprite2d {:scale 0.4}}]
+    (is (== (layout/scale-k scene 900.0) 0.4))
+    ;; and the 3-arg form agrees when no :fit camera is configured
+    (is (== (layout/scale-k scene 900.0 600.0) 0.4))))
+
+;; --------------------------------------------------------------------------
+;; bounds
+;; --------------------------------------------------------------------------
+
+(deftest prim-bounds-are-centred-like-the-painter
+  ;; :rect/:image/:text/:circle all draw centred on :dx/:dy in kami.sprite2d
+  (is (= [-60.0 -40.0 60.0 40.0]
+         (mapv double (layout/prim-bounds [:rect {:w 120 :h 80}]))))
+  (is (= [-26 -26 26 26] (layout/prim-bounds [:circle {:r 26}])))
+  (is (= [-10.0 -5.0 10.0 5.0]
+         (mapv double (layout/prim-bounds [:ellipse {:rx 10 :ry 5}]))))
+  (is (= [-50.0 -50.0 50.0 50.0]
+         (mapv double (layout/prim-bounds [:image {:w 100 :h 100}])))))
+
+(deftest prim-bounds-offset-follows-dx-dy
+  (is (= [70 -30 130 30] (layout/prim-bounds [:circle {:dx 100 :dy 0 :r 30}]))))
+
+(deftest unknown-primitive-has-no-bounds
+  (is (nil? (layout/prim-bounds [:nope {}])))
+  (is (nil? (layout/sprite-bounds [[:nope {}]])))
+  (is (nil? (layout/sprite-bounds []))))
+
+(deftest sprite-bounds-union-covers-every-part
+  (let [b (layout/sprite-bounds machine)]
+    ;; the rect is the widest part; the text sits below it and extends the bottom
+    (is (== (nth b 0) -60.0))
+    (is (== (nth b 2) 60.0))
+    (is (== (nth b 1) -40.0))
+    (is (> (nth b 3) 40.0) "the :text part below the body extends the box downward")))
+
+(deftest anim-does-not-move-the-hit-box
+  ;; a tap target that twitches with the idle animation is unusable
+  (let [still  [[:circle {:r 20}]]
+        moving [[:circle {:r 20 :anim {:bob [8 0.1]}}]]]
+    (is (= (layout/sprite-bounds still) (layout/sprite-bounds moving)))))
+
+;; --------------------------------------------------------------------------
+;; pick
+;; --------------------------------------------------------------------------
+
+(deftest pick-finds-the-entity-under-the-point
+  (let [hit (layout/pick board-scene snap W H [(/ W 2.0) (/ H 2.0)])]
+    (is (= "washer" (:tag hit)))
+    (is (some? (:box hit)))))
+
+(deftest pick-misses-outside-the-sprite
+  (is (nil? (layout/pick board-scene snap W H [5.0 5.0]))))
+
+(deftest pick-respects-the-camera-transform
+  ;; move the camera and the same world entity must be found somewhere else on screen
+  (let [scene (assoc-in board-scene [:render/sprite2d :camera] {:mode :fixed :x 400 :y 300})
+        op (first (layout/draw-list scene snap W H))]
+    ;; entity is 100 world units east of the camera, so it is drawn right of centre
+    (is (> (:sx op) (/ W 2.0)))
+    ;; the pick must follow the drawn position, not the screen centre
+    (is (nil? (layout/pick scene snap W H [(/ W 2.0) (/ H 2.0)]))
+        "screen centre is no longer on the sprite")
+    (is (= "washer" (:tag (layout/pick scene snap W H [(:sx op) (:sy op)])))
+        "the drawn position is")))
+
+(deftest pick-pad-grows-the-target
+  ;; the sprite is 120x80 world units at k=0.34*800/900≈0.302 -> ~36x24 screen px:
+  ;; a point 30px right of centre is outside it, and inside it with a 30px pad
+  (let [x (+ (/ W 2.0) 30.0) y (/ H 2.0)]
+    (is (nil? (layout/pick board-scene snap W H [x y])))
+    (is (= "washer" (:tag (layout/pick board-scene snap W H [x y] 30.0))))))
+
+(deftest pick-returns-the-topmost-of-overlapping-entities
+  ;; painter order is far-first (higher world y drawn first), so the entity with the
+  ;; LOWER world y is on top and must win the pick
+  (let [scene {:render/sprite2d {:camera {:mode :fixed :x 0 :y 0}}
+               :sprites {:far [[:circle {:r 100 :fill [1 0 0]}]]
+                         :near [[:circle {:r 100 :fill [0 1 0]}]]}}
+        s [{:tag "far" :pos [0 200 0]} {:tag "near" :pos [0 -200 0]}]
+        dl (layout/draw-list scene s W H)]
+    (is (= ["far" "near"] (mapv :tag dl)) "painter order: far drawn first")
+    ;; a point on the near entity
+    (let [op (second dl)]
+      (is (= "near" (:tag (layout/pick scene s W H [(:sx op) (:sy op)])))))))
+
+(deftest hit-boxes-drop-sprites-that-draw-nothing
+  (let [scene {:render/sprite2d {:camera {:mode :fixed :x 0 :y 0}}
+               :sprites {:ghost [] :real [[:circle {:r 10}]]}}
+        s [{:tag "ghost" :pos [0 0 0]} {:tag "real" :pos [0 -10 0]}]]
+    (is (= ["real"] (mapv :tag (layout/hit-boxes scene s W H))))))
