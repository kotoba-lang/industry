+(defn fit-distance
+  "How far the eye must sit from the target for a sphere of `radius` about it to fit the
+   frame, given `fov-deg` (VERTICAL, degrees — the executor's `[:globals :fov]`) and the
+   viewport `aspect` (width/height).
+
+   A rig states `:distance` as a constant, which can only be right for one viewport: the
+   horizontal field of view is the vertical one widened by the aspect, so a scene framed
+   on a 16:9 desktop spills off both sides of a portrait phone, and nothing reports it —
+   the buildings are simply not there. The binding constraint is whichever half-angle is
+   smaller, which on a portrait screen is the horizontal one.
+
+   `margin` is a fraction of headroom (default 0.12, so the sphere fills ~88% of the
+   frame)."
+  ([radius fov-deg aspect] (fit-distance radius fov-deg aspect 0.12))
+  ([radius fov-deg aspect margin]
+   (let [half-v (/ (* (double fov-deg) (/ #?(:clj Math/PI :cljs js/Math.PI) 180.0)) 2.0)
+         tan-v  (#?(:clj Math/tan :cljs js/Math.tan) half-v)
+         half-h (#?(:clj Math/atan :cljs js/Math.atan) (* (double aspect) tan-v))
+         half   (min half-v half-h)
+         s      (#?(:clj Math/sin :cljs js/Math.sin) half)]
+     (if (< s 1e-6)
+       (* 1000.0 (double radius))
+       (/ (* (double radius) (+ 1.0 (double margin))) s)))))
+
+(defn fit-rig
+  "A camera rig whose `:distance` is solved so a sphere of `radius` about the target fits
+   the viewport. Everything else (`:azimuth`, `:height`, `:look-height`) is the scene's
+   own framing choice and is passed through untouched.
+
+   Use it when the subject has a known extent and must be *seen whole* — a board, a map, a
+   turntable — which is precisely when a hard-coded `:distance` is wrong on every screen
+   but the one it was tuned on."
+  ([rig radius fov-deg aspect] (fit-rig rig radius fov-deg aspect 0.12))
+  ([rig radius fov-deg aspect margin]
+   (assoc (merge default-rig rig)
+          :distance (fit-distance radius fov-deg aspect margin))))
+
 (defn valid?
   "A cheap structural check — enough to catch obvious authoring mistakes."
   [ir]
diff --git a/src/kami/webgpu/pick.cljc b/src/kami/webgpu/pick.cljc
new file mode 100644
index 0000000..8d3bfdb
--- /dev/null
+++ b/src/kami/webgpu/pick.cljc
@@ -0,0 +1,146 @@
+(ns kami.webgpu.pick
+  "Screen point → instance. The inverse of the frame the executor draws, as pure `.cljc`.
+
+   The render-IR maps world→screen, and until now nothing mapped back. Anything the player
+   points at — a building on a map, a machine on a shop floor, an object to inspect — had
+   to be resolved by the app re-deriving the camera transform itself. That derivation is
+   not obvious (the projection convention, the up vector, and above all the fact that an
+   instance's `:pos` is its **ground** point while its box is centred half a height above)
+   so every app that tried would get a subtly different answer from the one on screen, and
+   the error shows up as 'the tap target is slightly off', which reads as a UI bug rather
+   than as duplicated math.
+
+   Both backends consume the same IR, so both get the same picking from here: this
+   namespace touches no GPU API and knows nothing about WebGPU or WebGL2.
+
+   The conventions below are not chosen, they are **matched** to `kami.webgpu`'s executor:
+
+     camera   `[:globals :eye]` → `[:globals :target]`, up `[0 1 0]`,
+              `:fov` in DEGREES (default 60), `:near` 0.5, `:far` 4000, aspect = W/H
+     instance `model = translate(pos + up*h/2) · rotateY(yaw) · scale(w,h,d)`
+              so `:pos` is where the box SITS, not where its centre is
+
+   If the executor's convention changes, `pick-agrees-with-projection` in the test suite
+   fails — it projects each instance's own centre with the same matrices the executor
+   builds and requires the pick at that pixel to return that instance."
+  (:require [kami.webgpu.ir :as ir]
+            [kotoba.render.camera :as cam]))
+
+(def default-fov-deg
+  "`kami.webgpu` reads `[:globals :fov]` in degrees and falls back to 60."
+  60.0)
+
+(defn- v3- [[ax ay az] [bx by bz]] [(- ax bx) (- ay by) (- az bz)])
+(defn- v3+ [[ax ay az] [bx by bz]] [(+ ax bx) (+ ay by) (+ az bz)])
+(defn- v3* [[x y z] s] [(* x s) (* y s) (* z s)])
+(defn- dot3 [[ax ay az] [bx by bz]] (+ (* ax bx) (* ay by) (* az bz)))
+(defn- cross3 [[ax ay az] [bx by bz]]
+  [(- (* ay bz) (* az by)) (- (* az bx) (* ax bz)) (- (* ax by) (* ay bx))])
+(defn- norm3 [v]
+  (let [l (Math/sqrt (double (dot3 v v)))]
+    (if (< l 1e-12) v (v3* v (/ 1.0 l)))))
+
+(defn camera-of
+  "The camera the executor would build for this frame, as data. `:eye`/`:target` come from
+   the IR; the rest are the executor's documented defaults unless the frame overrides
+   them."
+  [ir-map W H]
+  (let [g (:globals ir-map)]
+    {:eye    (or (:eye g) [0.0 0.0 0.0])
+     :target (or (:target g) [0.0 0.0 0.0])
+     :up     [0.0 1.0 0.0]
+     :fov    (double (or (:fov g) default-fov-deg))
+     :near   (double (or (:near g) 0.5))
+     :far    (double (or (:far g) 4000.0))
+     :aspect (/ (double W) (double (max 1 H)))}))
+
+(defn ray
+  "World-space ray `{:origin :dir}` through screen pixel `[mx my]` (origin top-left, y
+   down — the DOM's convention, which is what a pointer event gives you)."
+  [ir-map [mx my] W H]
+  (let [{:keys [eye target up fov aspect]} (camera-of ir-map W H)
+        ndx (- (* 2.0 (/ (double mx) (double W))) 1.0)
+        ndy (- 1.0 (* 2.0 (/ (double my) (double H))))
+        th  (Math/tan (/ (cam/deg->rad fov) 2.0))
+        f   (norm3 (v3- target eye))
+        s   (norm3 (cross3 f up))
+        u   (cross3 s f)]
+    {:origin eye
+     :dir (norm3 (v3+ f (v3+ (v3* s (* ndx th aspect))
+                             (v3* u (* ndy th)))))}))
+
+(defn instance-box
+  "An instance's world-space oriented box: `{:center [x y z] :half [hx hy hz] :yaw θ}`.
+
+   `:center` is NOT `:pos` — the executor lifts the cuboid by half its height so that
+   `:pos` is the point it stands on. Getting this wrong puts every hit box half a
+   building underground, which is exactly the kind of near-miss that looks like a
+   tolerance problem."
+  [inst]
+  (let [[w h d] (ir/instance-size (:size inst))
+        [x y z] (:pos inst)]
+    {:center [x (+ y (* 0.5 h)) z]
+     :half [(* 0.5 w) (* 0.5 h) (* 0.5 d)]
+     :yaw (or (:yaw inst) 0.0)}))
+
+(defn ray-box
+  "Distance along `ray` to the near face of an oriented box, or nil for a miss. Slab test
+   in the box's own frame; a ray starting inside the box returns 0."
+  [{:keys [origin dir]} {:keys [center half yaw]}]
+  (let [c (Math/cos (- (double yaw)))
+        s (Math/sin (- (double yaw)))
+        ;; into box-local: translate then rotate by -yaw about Y
+        rot (fn [[x y z]] [(- (* c x) (* s z)) y (+ (* s x) (* c z))])
+        o (rot (v3- origin center))
+        r (rot dir)
+        slab (fn [oi ri hi]
+               (if (< (Math/abs (double ri)) 1e-12)
+                 (when (<= (Math/abs (double oi)) hi) [-1e30 1e30])
+                 (let [t1 (/ (- (- hi) oi) ri)
+                       t2 (/ (- hi oi) ri)]
+                   [(min t1 t2) (max t1 t2)])))
+        xs (slab (nth o 0) (nth r 0) (nth half 0))
+        ys (slab (nth o 1) (nth r 1) (nth half 1))
+        zs (slab (nth o 2) (nth r 2) (nth half 2))]
+    (when (and xs ys zs)
+      (let [tmin (max (nth xs 0) (nth ys 0) (nth zs 0))
+            tmax (min (nth xs 1) (nth ys 1) (nth zs 1))]
+        (when (and (<= tmin tmax) (>= tmax 0.0))
+          (max tmin 0.0))))))
+
+(defn pick
+  "Which instance is under screen pixel `[mx my]`? Returns
+   `{:index i :instance inst :t distance :point [x y z]}` for the nearest hit, or nil.
+
+   `opts`:
+     `:filter` — predicate on an instance; only matching instances are considered. Ground
+                 planes, roads and decoration are instances too, and a map that lets you
+                 tap the road is a map whose buildings are hard to hit."
+  ([ir-map p W H] (pick ir-map p W H nil))
+  ([ir-map p W H {:keys [filter] :as _opts}]
+   (let [r (ray ir-map p W H)
+         keep? (or filter (constantly true))]
+     (->> (map-indexed vector (:instances ir-map))
+          (keep (fn [[i inst]]
+                  (when (keep? inst)
+                    (when-let [t (ray-box r (instance-box inst))]
+                      {:index i :instance inst :t t
+                       :point (v3+ (:origin r) (v3* (:dir r) t))}))))
+          (sort-by :t)
+          first))))
+
+(defn project
+  "World point → screen pixel `[x y]`, or nil when it is behind the camera. The forward
+   direction of `pick`, built from the same matrices the executor uses — this is what
+   makes 'the pick agrees with what was drawn' a testable statement rather than a hope."
+  [ir-map [wx wy wz] W H]
+  (let [{:keys [eye target up fov aspect near far]} (camera-of ir-map W H)
+        view (cam/look-at-rh eye target up)
+        proj (cam/perspective-rh (cam/deg->rad fov) aspect near far)
+        vp (cam/mat4-mul proj view)
+        m (fn [row] (+ (* (nth vp row) wx) (* (nth vp (+ row 4)) wy)
+                       (* (nth vp (+ row 8)) wz) (nth vp (+ row 12))))
+        cx (m 0) cy (m 1) cw (m 3)]
+    (when (> cw 1e-9)
+      [(* (+ (/ cx cw) 1.0) 0.5 W)
+       (* (- 1.0 (/ cy cw)) 0.5 H)])))
diff --git a/test/kami/webgpu/pick_test.clj b/test/kami/webgpu/pick_test.clj
new file mode 100644
index 0000000..57532e6
--- /dev/null
+++ b/test/kami/webgpu/pick_test.clj
@@ -0,0 +1,201 @@
+(ns kami.webgpu.pick-test
+  "Tests for screen→instance picking.
+
+  The load-bearing one is `pick-agrees-with-projection`: it projects every instance's own
+  centre with the same view/projection the executor builds, then requires the pick at that
+  pixel to return that instance. That is what makes picking *correct* rather than merely
+  plausible — a picker with the wrong up vector, the wrong depth convention, or (the easy
+  one) no half-height lift still returns hits, just the wrong ones, near the edges."
+  (:require [clojure.test :refer [deftest is]]
+            [kami.webgpu.ir :as ir]
+            [kami.webgpu.pick :as pick]))
+
+(def W 800)
+(def H 600)
+
+(defn frame [instances eye target]
+  (-> (ir/render-ir (ir/sky [0.5 0.7 0.9] [0.3 -1 0.2] [1 1 1]) instances eye target)))
+
+(def one (frame [(ir/instance [0 0 0] [0.8 0.2 0.2] [10 10 10])] [0 20 40] [0 0 0]))
+
+;; --------------------------------------------------------------------------
+;; the box an instance occupies
+;; --------------------------------------------------------------------------
+
+(deftest instance-pos-is-the-ground-not-the-centre
+  ;; the executor's model matrix lifts the cuboid by h/2, so :pos is where it stands
+  (let [b (pick/instance-box (ir/instance [3 0 -4] [1 1 1] [2 8 6]))]
+    (is (= [3 4.0 -4] (:center b)))
+    (is (= [1.0 4.0 3.0] (:half b)))))
+
+(deftest legacy-two-axis-size-still-works
+  (let [b (pick/instance-box (ir/instance [0 0 0] [1 1 1] [4 10]))]
+    (is (= [2.0 5.0 2.0] (:half b)) "[w h] means a square footprint")))
+
+;; --------------------------------------------------------------------------
+;; the ray
+;; --------------------------------------------------------------------------
+
+(deftest ray-through-screen-centre-looks-at-the-target
+  (let [r (pick/ray one [(/ W 2.0) (/ H 2.0)] W H)
+        expect [0.0 -20.0 -40.0]
+        len (Math/sqrt (double (reduce + (map * expect expect))))
+        unit (mapv #(/ % len) expect)]
+    (is (every? (fn [[a b]] (< (Math/abs (double (- a b))) 1e-9))
+                (map vector (:dir r) unit))
+        "centre pixel is exactly the eye→target direction")))
+
+(deftest ray-origin-is-the-eye
+  (is (= [0 20 40] (:origin (pick/ray one [10.0 10.0] W H)))))
+
+(deftest screen-right-is-world-right
+  ;; a ray through the right half of the screen must lean +x for this camera
+  (let [r (pick/ray one [(* 0.9 W) (/ H 2.0)] W H)]
+    (is (> (nth (:dir r) 0) 0.0)))
+  (let [r (pick/ray one [(* 0.1 W) (/ H 2.0)] W H)]
+    (is (< (nth (:dir r) 0) 0.0))))
+
+(deftest screen-up-is-world-up
+  ;; y grows downward in screen space; the top of the screen must look higher in the world
+  (let [top (pick/ray one [(/ W 2.0) (* 0.1 H)] W H)
+        bot (pick/ray one [(/ W 2.0) (* 0.9 H)] W H)]
+    (is (> (nth (:dir top) 1) (nth (:dir bot) 1)))))
+
+;; --------------------------------------------------------------------------
+;; ray vs box
+;; --------------------------------------------------------------------------
+
+(deftest ray-box-hit-and-miss
+  (let [box {:center [0 0 0] :half [1 1 1] :yaw 0}]
+    (is (= 4.0 (pick/ray-box {:origin [0 0 5] :dir [0 0 -1]} box)))
+    (is (nil? (pick/ray-box {:origin [0 5 5] :dir [0 0 -1]} box)))
+    (is (nil? (pick/ray-box {:origin [0 0 5] :dir [0 0 1]} box)) "pointing away")))
+
+(deftest ray-starting-inside-the-box-hits-at-zero
+  (is (= 0.0 (pick/ray-box {:origin [0 0 0] :dir [0 0 -1]}
+                           {:center [0 0 0] :half [1 1 1] :yaw 0}))))
+
+(deftest ray-parallel-to-a-slab
+  (let [box {:center [0 0 0] :half [1 100 1] :yaw 0}]
+    (is (some? (pick/ray-box {:origin [0 0 5] :dir [0 0 -1]} box)))
+    (is (nil? (pick/ray-box {:origin [0 500 5] :dir [0 0 -1]} box)))))
+
+(deftest yaw-rotates-the-hit-box
+  ;; A plank 20 long in z and 2 wide in x. A ray flying in along -x at z=8 clips it while
+  ;; it lies along z, and misses once it is turned a quarter turn to lie along x — the ray
+  ;; is then off the end of it. (Aiming through the origin instead proves nothing: every
+  ;; rotation of a box centred there still contains the origin.)
+  (let [flat {:center [0 0 0] :half [1 1 10] :yaw 0}
+        turned (assoc flat :yaw (/ Math/PI 2.0))
+        from-side {:origin [30 0 8] :dir [-1 0 0]}]
+    (is (some? (pick/ray-box from-side flat)))
+    (is (nil? (pick/ray-box from-side turned)))
+    ;; and the converse, so neither half can pass by accident
+    (let [along-z {:origin [8 0 30] :dir [0 0 -1]}]
+      (is (nil? (pick/ray-box along-z flat)))
+      (is (some? (pick/ray-box along-z turned))))))
+
+;; --------------------------------------------------------------------------
+;; pick
+;; --------------------------------------------------------------------------
+
+(deftest pick-hits-the-instance-under-the-centre-pixel
+  (let [h (pick/pick one [(/ W 2.0) (/ H 2.0)] W H)]
+    (is (some? h))
+    (is (= 0 (:index h)))))
+
+(deftest pick-misses-empty-sky
+  (is (nil? (pick/pick one [5.0 5.0] W H))))
+
+(deftest pick-returns-the-nearest-of-two-instances
+  (let [f (frame [(ir/instance [0 0 -60] [1 0 0] [10 10 10])
+                  (ir/instance [0 0 0]   [0 1 0] [10 10 10])]
+                 [0 5 60] [0 0 0])
+        h (pick/pick f [(/ W 2.0) (/ H 2.0)] W H)]
+    (is (= 1 (:index h)) "the near one wins, not the first in the vector")))
+
+(deftest pick-can-ignore-the-scenery
+  ;; a map you can tap the road on is a map whose buildings are hard to hit
+  (let [f (frame [(assoc (ir/instance [0 0 0] [0.3 0.3 0.3] [400 1 400]) :kind :ground)
+                  (assoc (ir/instance [0 1 0] [1 0 0] [8 8 8]) :kind :shop)]
+                 [0 40 60] [0 0 0])
+        centre [(/ W 2.0) (/ H 2.0)]]
+    (is (= :shop (get-in (pick/pick f centre W H) [:instance :kind])))
+    (is (= :ground (get-in (pick/pick f centre W H {:filter (fn [i] (= (:kind i) :ground))})
+                           [:instance :kind])))))
+
+(deftest pick-agrees-with-projection
+  ;; THE test. Project each instance's own centre through the same view/projection the
+  ;; executor builds, then pick at that pixel and require the same instance back.
+  (let [insts (for [x (range -3 4) z (range -3 4)]
+                (ir/instance [(* x 18) 0 (* z 18)] [0.6 0.6 0.7] [8 12 8]))
+        f (frame (vec insts) [0 90 120] [0 0 0])]
+    (doseq [[i inst] (map-indexed vector (:instances f))]
+      (let [c (:center (pick/instance-box inst))
+            p (pick/project f c W H)]
+        (when p
+          (when (and (< 0 (nth p 0) W) (< 0 (nth p 1) H))
+            (let [h (pick/pick f p W H)]
+              (is (= i (:index h))
+                  (str "instance " i " at " (pr-str c)
+                       " projects to " (pr-str p)
+                       " but picking there returned "
+                       (pr-str (:index h)))))))))))
+
+(deftest projection-puts-the-target-at-the-screen-centre
+  (let [p (pick/project one [0 0 0] W H)]
+    (is (< (Math/abs (double (- (nth p 0) (/ W 2.0)))) 1e-6))
+    (is (< (Math/abs (double (- (nth p 1) (/ H 2.0)))) 1e-6))))
+
+(deftest projection-rejects-points-behind-the-camera
+  (is (nil? (pick/project one [0 20 400] W H))))
+
+(deftest fov-override-is-honoured
+  ;; a frame that sets its own :fov must be picked with that fov, not the default
+  (let [wide (assoc-in one [:globals :fov] 100)
+        narrow (assoc-in one [:globals :fov] 20)
+        off [(* 0.72 W) (/ H 2.0)]]
+    ;; the same off-centre pixel sees more of the world at 100° than at 20°, so the ray
+    ;; leans further off-axis
+    (is (> (Math/abs (double (nth (:dir (pick/ray wide off W H)) 0)))
+           (Math/abs (double (nth (:dir (pick/ray narrow off W H)) 0)))))))
+
+;; --------------------------------------------------------------------------
+;; camera fit — the 3D twin of "frame a known extent on any screen"
+;; --------------------------------------------------------------------------
+
+(deftest fit-distance-frames-the-sphere
+  ;; the sphere's silhouette must land inside the frame, on both axes
+  (doseq [[w h] [[390 844] [900 1600] [1280 720] [1920 1080]]]
+    (let [radius 60.0 fov 46.0
+          aspect (/ (double w) (double h))
+          rig (ir/fit-rig {:height 40.0 :azimuth (/ Math/PI 2.0) :look-height 0.0}
+                          radius fov aspect)
+          {:keys [eye target]} (ir/rig->camera rig [0.0 0.0])
+          f {:globals {:eye eye :target target :fov fov} :instances []}]
+      ;; six extreme points of the bounding sphere about the target
+      (doseq [p [[radius 0 0] [(- radius) 0 0] [0 radius 0] [0 (- radius) 0]
+                 [0 0 radius] [0 0 (- radius)]]]
+        (let [sp (pick/project f p w h)]
+          (is (and sp (<= 0 (nth sp 0) w) (<= 0 (nth sp 1) h))
+              (str "sphere extreme " (pr-str p) " projects to " (pr-str sp)
+                   " inside " w "x" h)))))))
+
+(deftest fit-distance-grows-as-the-frame-narrows
+  ;; a portrait viewport sees a narrower slice at the same vertical fov
+  (is (> (ir/fit-distance 50.0 46.0 (/ 9.0 16.0))
+         (ir/fit-distance 50.0 46.0 (/ 16.0 9.0)))))
+
+(deftest fit-distance-scales-with-the-subject
+  (is (< (ir/fit-distance 10.0 46.0 1.0) (ir/fit-distance 100.0 46.0 1.0))))
+
+(deftest fit-distance-shrinks-as-the-lens-widens
+  (is (> (ir/fit-distance 50.0 20.0 1.0) (ir/fit-distance 50.0 90.0 1.0))))
+
+(deftest fit-rig-keeps-the-scenes-own-framing
+  (let [rig {:height 40.0 :azimuth 1.15 :look-height 3.0}
+        fitted (ir/fit-rig rig 50.0 46.0 0.5625)]
+    (is (= 40.0 (:height fitted)))
+    (is (= 1.15 (:azimuth fitted)))
+    (is (= 3.0 (:look-height fitted)))
+    (is (number? (:distance fitted)) "only :distance is solved")))
