;; Pixel-diff quiet-band for #1754 / ADR-2608108000.
;;
;; Measured 2026-08-12 in this container (Chromium + ANGLE/SwiftShader, WebGL 2.0
;; street path; DOM board path). Three back-to-back re-renders of the same inputs:
;;
;;   street cleared=0 @ 360×640  → max-delta 0, changed-pixels 0  (pairs A/B, A/C, B/C)
;;   board  goldens/board-state.edn @ 390×(fullPage) → max-delta 0, changed-pixels 0
;;
;; Backend actually used for goldens: `--backend webgl2` (WebGPU Dawn loses the
;; device after submit here — see render_street docstring). Auto would fall back
;; to the same WebGL2 path; we pin webgl2 so the golden does not depend on the
;; fallback log line.
;;
;; ADR note: SwiftShader stability is a property of THIS container, not of WebGL
;; in general. Driver-backed WebGL can wobble 1–2 LSB. Threshold 0 is correct for
;; the measured backend above; raise only after re-measuring on the backends you
;; actually gate.

{:threshold 0
 :measured-at "2026-08-12"
 :backends [{:path :street :backend "webgl2"
             :gpu "ANGLE (Google, Vulkan 1.3.0 (SwiftShader Device (Subzero)), SwiftShader driver)"
             :size [360 640]
             :samples 3
             :max-delta 0
             :changed-pixels 0}
            {:path :board :backend "dom-screenshot"
             :size [390 :fullPage]
             :samples 2
             :max-delta 0
             :changed-pixels 0}]
 :chosen-threshold 0
 :rationale "measured max-delta across re-renders was 0 on every backend used for goldens"}
