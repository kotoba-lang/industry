{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}}
 :aliases
 {;; Runs the world-map render-IR against the real KAMI 2D stack.
  ;; `kotoba-lang/sprite2d` must be checked out at its west path:
  ;;   west update --fetch smart sprite2d
  ;; Override the coordinate when working from a clone elsewhere:
  ;;   clojure -Sdeps '{:deps {kotoba-lang/sprite2d {:local/root "/path/to/sprite2d"}}}' -M:ir-test
  :ir-test
  {:extra-paths ["test"]
   :extra-deps {kotoba-lang/sprite2d {:local/root "../../../../../../orgs/kotoba-lang/sprite2d"}
                io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner" "-n" "world-ir-test"]}

  ;; The authoritative 3D view: the canonical render-IR both GPU backends consume.
  ;;   west update --fetch smart webgpu
  :gpu-test
  {:extra-paths ["test"]
   :extra-deps {io.github.kotoba-lang/webgpu {:local/root "../../../../../../orgs/kotoba-lang/webgpu"}
                io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner" "-n" "world3d-test"]}}}
