{
  "name": "itonami-isic-9601-game",
  "private": true,
  "version": "0.1.0",
  "description": "クリーニング営み — the cloud-itonami ISIC 9601 garment-care actor as an idle tycoon. Build tooling only; the game itself is the cljc in src/.",
  "scripts": {
    "play": "kbb --backend sci --classpath src bin/kuriningu.cljs play",
    "street": "kbb --backend sci --classpath src bin/kuriningu.cljs street",
    "render": "kbb --backend sci --classpath src bin/render.cljs",
    "test": "kbb --backend sci --classpath src test/logic_test.cljs",
    "test:state": "kbb --backend sci --classpath src test/state_test.cljs",
    "accept:state": "kbb --backend sci --classpath src bin/accept_state.cljs",
    "test:camera": "kbb --backend sci --classpath src:../../../../../../orgs/kotoba-lang/webgpu/src:../../../../../../orgs/kotoba-lang/render/src test/camera_test.cljs",
    "accept:camera": "kbb --backend sci --classpath src:../../../../../../orgs/kotoba-lang/webgpu/src:../../../../../../orgs/kotoba-lang/render/src bin/accept_camera.cljs",
    "test:annotate": "kbb --backend sci --classpath src:../../../../../../orgs/kotoba-lang/webgpu/src:../../../../../../orgs/kotoba-lang/render/src test/annotate_test.cljs",
    "accept:annotate": "kbb --backend sci --classpath src:../../../../../../orgs/kotoba-lang/webgpu/src:../../../../../../orgs/kotoba-lang/render/src bin/accept_annotate.cljs",
    "accept:board": "kbb --backend sci --classpath src bin/accept_board.cljs",
    "test:diff": "kbb --backend sci --classpath src:bin test/diff_test.cljs",
    "accept:visual": "kbb --backend sci --classpath src:bin:../../../../../../orgs/kotoba-lang/webgpu/src:../../../../../../orgs/kotoba-lang/render/src bin/accept_visual.cljs",
    "balance": "kbb --backend sci --classpath src test/balance.cljs",
    "build": "kbb --backend sci preview/build.cljk",
    "build:board": "kbb --backend sci preview/build_board.cljk",
    "render:webgpu": "kbb --backend sci --classpath src bin/render.cljs -- --view street --backend webgpu",
    "parity": "kbb --backend sci test/parity.cljk",
    "lint:squint": "kbb --backend sci test/squint_unary_minus.cljk"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "nbb": "1.3.201",
    "playwright": "1.55.1",
    "pngjs": "^7.0.0",
    "squint-cljs": "0.8.147"
  }
}
