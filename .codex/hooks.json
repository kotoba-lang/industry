{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "NBB=\"$CLAUDE_PROJECT_DIR/node_modules/.bin/nbb\"; [ -x \"$NBB\" ] || NBB=nbb; \"$NBB\" '/Users/junkawasaki/github/com-junkawasaki/.codex/hooks/git-push-main-sync-guard.cljk'",
            "timeout": 30,
            "statusMessage": "Checking branch is in sync with main before push…"
          },
          {
            "type": "command",
            "command": "NBB=\"$CLAUDE_PROJECT_DIR/node_modules/.bin/nbb\"; [ -x \"$NBB\" ] || NBB=nbb; \"$NBB\" --classpath \"$CLAUDE_PROJECT_DIR:$CLAUDE_PROJECT_DIR/scripts/nbb_compat\" '/Users/junkawasaki/github/com-junkawasaki/.codex/hooks/west-pin-verify-guard.cljk'",
            "timeout": 90,
            "statusMessage": "Verifying west.yml pins against upstream (server-side)…"
          },
          {
            "type": "command",
            "command": "NBB=\"$CLAUDE_PROJECT_DIR/node_modules/.bin/nbb\"; [ -x \"$NBB\" ] || NBB=nbb; \"$NBB\" '/Users/junkawasaki/github/com-junkawasaki/.codex/hooks/git-pull-west-sync-guard.cljk'",
            "timeout": 15,
            "statusMessage": "Checking git pull uses depth+west-update sequence…"
          },
          {
            "type": "command",
            "command": "NBB=\"$CLAUDE_PROJECT_DIR/node_modules/.bin/nbb\"; [ -x \"$NBB\" ] || NBB=nbb; \"$NBB\" '/Users/junkawasaki/github/com-junkawasaki/.codex/hooks/wrangler-deploy-main-sync-guard.cljk'",
            "timeout": 45,
            "statusMessage": "Checking the deploy source contains origin/main…"
          },
          {
            "type": "command",
            "command": "NBB=\"$CLAUDE_PROJECT_DIR/node_modules/.bin/nbb\"; [ -x \"$NBB\" ] || NBB=nbb; \"$NBB\" '/Users/junkawasaki/github/com-junkawasaki/.codex/hooks/deploy-local-root-pin-guard.cljk'",
            "timeout": 60,
            "statusMessage": "Checking :local/root deps match their west pins before deploy…"
          },
          {
            "type": "command",
            "command": "NBB=\"$CLAUDE_PROJECT_DIR/node_modules/.bin/nbb\"; [ -x \"$NBB\" ] || NBB=nbb; \"$NBB\" '/Users/junkawasaki/github/com-junkawasaki/.codex/hooks/branch-create-main-sync-guard.cljk'",
            "timeout": 30,
            "statusMessage": "Checking the checkout is in sync before creating a branch…"
          },
          {
            "type": "command",
            "command": "NBB=\"$CLAUDE_PROJECT_DIR/node_modules/.bin/nbb\"; [ -x \"$NBB\" ] || NBB=nbb; \"$NBB\" '/Users/junkawasaki/github/com-junkawasaki/.codex/hooks/docs-edn-parse-guard.cljk'",
            "timeout": 20,
            "statusMessage": "Checking changed 90-docs EDN parses…"
          }
        ]
      },
      {
        "matcher": "Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "nbb '/Users/junkawasaki/github/com-junkawasaki/.codex/hooks/duplication-warn.cljk'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$DELTA_CAPTURE\" = \"1\" ] || exit 0; NBB=\"$CLAUDE_PROJECT_DIR/node_modules/.bin/nbb\"; [ -x \"$NBB\" ] || NBB=nbb; \"$NBB\" '/Users/junkawasaki/github/com-junkawasaki/.codex/hooks/delta-capture-post-tool.cljk' || true",
            "timeout": 30,
            "statusMessage": "Recording edit into kotoba-delta op-log…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NBB=\"$CLAUDE_PROJECT_DIR/node_modules/.bin/nbb\"; [ -x \"$NBB\" ] || NBB=nbb; \"$NBB\" '/Users/junkawasaki/github/com-junkawasaki/.codex/hooks/session-start-branch-sync-check.cljk' 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Checking branch sync with origin/main…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "NBB=\"$CLAUDE_PROJECT_DIR/node_modules/.bin/nbb\"; [ -x \"$NBB\" ] || NBB=nbb; \"$NBB\" '/Users/junkawasaki/github/com-junkawasaki/.codex/hooks/session-start-spec-inventory.cljk' 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Listing external-spec repos in the workspace…"
          }
        ]
      }
    ]
  }
}
