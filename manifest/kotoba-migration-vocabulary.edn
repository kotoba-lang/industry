;; .kotoba を持つ repo の「役割」を宣言する —— **手書き。生成物ではない。**
;;
;; 索引本体（90-docs/kotoba-migration/kotoba-migration.datoms.edn）は
;; `scripts/gen-kotoba-migration-index.cljs` が生成する。ここに手で持つのは
;; **repo の中身から導出できないもの**だけ、という concept-vocabulary.edn と
;; 同じ分担にしてある。
;;
;; ## なぜ役割の宣言が要るのか
;;
;; 2026-08-12 実測（west pin の tree を読んだ値）: `.kotoba` を持つ repo は 1,187。ADR-2608120200
;; が「移行」として測っていたのは 23。差の大半は移行対象ですらなかった ——
;; **1,017 repo は `com-<vendor>` 系 origin-plane repo の `schema/` にある宣言**で、
;; cljc から切り出した決定核ではない。
;;
;; 「.kotoba を持つ repo が 1,187」と「移行中の repo が 1,187」は違う話で、
;; 前者しか数えられない状態では後者を誰も答えられない。
;;
;; ## 判定はディレクトリで行う（名前では行わない）
;;
;; 役割は scaffold が決めたディレクトリ規約に出ている。決定核は 157 repo、
;; schema 宣言は 1,017 repo。名前からの推測
;; （`iban_checksum` は決定核っぽい、`zoom` は schema っぽい）はしない ——
;; `com-unity-ads` の `schema/unity_ads.kotoba` と
;; `cloud-itonami-isic-6419` の `wasm/iban_checksum.kotoba` は名前の見た目では
;; 区別できるが、それは 2 件を見た人間の印象であって規則ではない。
;;
;; **一致しないものは `:unclassified` として数える。** 索引に出ないことを
;; 「そこに何も無い」の証拠に使わせないため（concept 索引の coverage と同じ）。

{:role-by-dir
 {"schema" {:role :schema-module
            :note (str "origin 面 repo が外部仕様の shape を宣言する。cljc の twin を"
                       " 持たないので『どちらが走っているか』という問い自体が立たない。")}
  "src" {:role :decision-core
         :note "library の判断を .kotoba に切り出したもの。cljc twin と並ぶ。"}
  "kotoba" {:role :decision-core
            :note (str "`kotoba/*_core.kotoba` 規約。com-cloudflare / murakumo /"
                       " crdt / inga がこの形。")}
  "wasm" {:role :decision-core
          :note "cloud-itonami の isic 系。出荷 wasm を伴うことが多い。"}
  "os" {:role :decision-core
        :note "aiueos の kernel object。57/59 が kernel ELF にリンクされる。"}
  "fabric" {:role :decision-core
            :note "cloud-itonami の guardian。"}
  "resources" {:role :package-source
               :note (str "provider の capability-kit wasm package の source。"
                          " 出荷物は同じ repo の `.wasm`。")}
  "providers" {:role :package-source}
  "lang" {:role :language-fixture
          :note "kotoba-lang 自身の文法・stdlib。移行の対象ではなく移行の道具。"}
  "examples" {:role :example}
  "test" {:role :conformance-fixture
          :note "`*_conformance.kotoba`。それ自体は移行対象ではない。"}
  "_archive" {:role :archived
              :note "kotoba-v2025 の Rust 時代。README が legacy と宣言している。"}}

 ;; 実行経路の検出をこの拡張子に限る。**散文は実行ではない** —— README が
 ;; `compile-source` と書いているだけの repo を「host が core を実行している」と
 ;; 数えないため（実測 2026-08-12 にこの取りこぼしを踏んだ）。
 :code-extensions #{".clj" ".cljc" ".cljs" ".js" ".mjs" ".cjs" ".ts" ".sh" ".py"}

 ;; 出荷物として認める拡張子。ここに無いものは artifact として数えない。
 :artifact-extensions #{".wasm" ".kir.edn" ".o" ".elf"}

 ;; artifact が source から出たことを何かが検査していると認める根拠。
 ;; どれも「ファイルが在る / 名前が一致する」という観測で、内容は見ない ——
 ;; 索引は所在を答えるものであって、gate の質を採点するものではない。
 :artifact-verification-signals
 {:provenance-record {:suffix ".provenance.edn"
                      :note "compiler が書く :kotoba.provenance/v1。inga が先例。"}
  :test-name-match {:pattern "(?i)(drift|provenance|digest|registry)"
                    :caveat (str "名前しか見ない。その test が何を検査しているかは"
                                 " 読まないので、これは gate が在ることの弱い根拠"
                                 " であって gate が正しいことの根拠ではない。")
                    :note (str "com-cloudflare の precompiled-kir-does-not-drift /"
                               " provider の wasm-package-registry-test。")}}}
