;; Workspace-wide authority for repository role / naming rules.
;;
;; Until 2026-07-29 two *incompatible* vocabularies shared one schema string
;; ("kotoba.repository-role-rules.v0") and neither had a workspace-level home:
;;
;;   - the stack-tier vocabulary's edge table lived only as a hardcoded map
;;     inside scripts/verify-repository-roles.cljs
;;   - the name-prefix vocabulary lived inside a leaf repo
;;     (kotoba-lang/loop-ux-kaizen/resources/repository-rules.edn)
;;
;; Both are declared here instead, explicitly discriminated by :vocabulary/id.
;; See ADR-2607299000.
;;
;; Per-repo declarations stay in each repo's resources/repository-rules.edn and
;; keep schema "kotoba.repository-role-rules.v0" — a reader of one repo alone
;; must still be able to see which contract that repo claims to satisfy.
;; This file is the authority those declarations are checked *against*.

{:schema "kotoba.repository-role-rules.workspace.v1"

 :workspace-policies
 {;; ADR-2609092600. The app plane, as four planes that are never mixed.
  ;;
  ;; `:policy/kind-values` has NO default on purpose: a manifest that declares
  ;; nothing stays a finding. Defaulting to :service would turn every
  ;; unclassified manifest green without publishing a single document.
  ;;
  ;; `:policy/location` is a TABLE, not a design. Swapping the bytes host does
  ;; not touch one character of any manifest -- that is the whole point of
  ;; keeping location outside the protocol keys.
  :app-plane
  {:policy/authority "90-docs/adr/2609092600-one-app-plane-identity-naming-location-kind.edn"
   :policy/builds-on "90-docs/adr/2608157000-app-links-are-content-addressed.edn"
   :policy/scope :application-surface
   :policy/manifest-name "kotoba.app.edn"
   :policy/identity-key :kotoba.app/bundle-cid
   :policy/link-key :kotoba.app/embed-url
   :policy/naming-key :kotoba.app/latest
   :policy/kind-key :kotoba.app/kind
   :policy/kind-values
   {:document {:content-address :required
               :why "serves one document"}
    :service {:content-address :not-applicable
              :why "a dynamic worker answers requests; it serves no single document"}
    :placement {:content-address :not-applicable
                :why "an actor placement manifest declares where code runs, not what is served"}}
   :policy/kind-default nil
   ;; `:entry` is a HOSTNAME, not a path. DNSLink is per-hostname
   ;; (`_dnslink.<host> TXT dnslink=/ipns/<k51>`), so a path apex can carry
   ;; exactly one dnslink and per-app naming does not resolve without a
   ;; router -- which would put a location-addressed hop back in the middle
   ;; of the naming plane. The layers below are already subdomain gateways
   ;; (`{cid}.ipfs.*`, `{k51}.ipns.*`, certificates measured), and one origin
   ;; per app is what keeps one app out of another's localStorage.
   :policy/location
   {:bytes "https://{cid}.ipfs.kotobase.net"
    :entry "https://{name}.itonami.app/"
    :naming-resolution :dnslink
    :dnslink-record "_dnslink.{name}.itonami.app"}
   ;; A name with a dot cannot be one DNS label, so it cannot be an entry
   ;; host; such a site stays on a path plane. Measured constraint, not style.
   :policy/entry-name-constraint :single-dns-label
   ;; A :document is ONE self-contained file. A page that fetches its runtime
   ;; by relative path is right for a directory served over HTTP and wrong for
   ;; a content address -- an address that cannot be fetched and run on its own
   ;; is an address for half an application.
   :policy/document-shape :single-self-contained-file
   :policy/document-builder "orgs/network-awai/cloud-itonami/scripts/gen-selfcontained-doc.cljs"
   :policy/document-verifier "orgs/network-awai/cloud-itonami/scripts/verify-selfcontained-doc.cljs"
   ;; A remote script means the CID does not cover what the app runs. The one
   ;; way past substitutes a local file ONLY when its sha256 matches the digest
   ;; named at the call site -- evidence that someone compared the two.
   :policy/remote-script :refused-unless-digest-verified
   ;; Publishing writes B2; the origin plane reads R2 `ipld/{cid}`. Until one of
   ;; the two permanent fixes is chosen, a new :document needs both.
   :policy/byte-stores {:archive :b2 :origin-plane :r2
                        :origin-plane-key "ipld/{cid}"
                        :publish-writes :archive-only
                        :consequence :document-200-on-bytes-plane-502-on-web-plane}
   ;; The key signing the live advertisement chain exists only as a write-only
   ;; Worker secret. Measured 2026-09-01, manifest/ipni-publisher.edn.
   :policy/public-announce {:route "POST /announce"
                            :worker "net-kotobase-private-ipni-drain"
                            :why-not-a-separate-worker :signing-key-is-write-only-there
                            :reads-private-bucket false}
   :policy/agent-work-plane "https://itonami.cloud"
   :policy/verifier "scripts/verify-app-content-address.cljs"
   :policy/verifier-states #{:addressed :exempt :document-not-addressed :located :unreadable}
   :policy/finding-keys #{"located-only" "document-not-addressed"}
   :policy/requires #{:content-address-for-documents
                      :declared-kind
                      :put-then-get-byte-comparison
                      :location-outside-protocol-keys}
   :policy/forbids #{:hostname-in-kotoba-namespaced-key
                     :path-as-identity
                     :second-bytes-plane
                     :entry-apex-as-alias-of-another
                     :entry-path-instead-of-hostname
                     :bulk-exemption}
   :policy/measured
   {:at "2026-09-09"
    :note "Numbers move. Re-measure; do not cite these."
    :scanned 518 :addressed 436 :located 82 :unreadable 0
    :entry-hosts-live ["genko" "daw" "nle" "rirekisho" "tsukuru" "inkan" "shirohan"]
    :bytes-host-probe {"https://{cid}.ipfs.kotobase.net" 200
                       "https://{cid}.ipfs.itonami.cloud" 200}
    :correction "The initial record called {cid}.ipfs.itonami.cloud broken. The host was fine; the block was in B2 and that plane reads R2."}}

  :live-service-durable-data
  {:policy/authority "90-docs/adr/2608159100-kotobase-net-default-durable-boundary.edn"
   :policy/scope :runtime-durable-plane
   :policy/authority-origin "https://kotobase.net"
   :policy/default-api-origin "https://kotobase.net"
   :policy/capability-origins
   {:datomic "https://datomic.kotobase.net"
    :sparql "https://sparql.kotobase.net"
    :cypher "https://cypher.kotobase.net"
    :gremlin "https://gremlin.kotobase.net"
    :graphql "https://graphql.kotobase.net"
    :s3 "https://s3.kotobase.net"
    :git "https://git.kotobase.net"
    :atproto "https://atproto.kotobase.net"
    :pinning "https://pinning.kotobase.net"
    :search "https://search.kotobase.net"}
   :policy/internal-capability-origins
   {:datoms "https://datoms.kotobase.net"}
   :policy/query-dialects #{:datalog :sql :cypher :sparql :graphql :gremlin}
   :policy/retired-origin-hostnames
   #{"https://graph-database.kotobase.net"
     "https://backend.kotobase.net"
     "https://graphdb.kotobase.net"}
   :policy/immutable-block-path "/ipld/:cid"
   :policy/datom-path-prefix "/api/"
   :policy/large-object-entry-origin "https://kotobase.net"
   :policy/requires #{:cid-verified-read
                      :cid-verified-write
                      :fresh-cacao-nonce
                      :recoverable-without-coordination-store}
   :policy/coordination-only #{:durable-object :d1 :kv}
   :policy/forbids #{:application-direct-r2-binding
                     :provider-origin-as-production-premise
                     :retired-origin-hostname-in-production
                     :query-implementation-name-as-capability
                     :durable-object-as-data-authority
                     :silent-production-fallback}
   :policy/excludes #{:git-edn-source-plane :datalad-large-artifact-plane
                      :explicit-localhost :explicit-mock :explicit-testnet}}

  ;; Admission for scaffold / deps edits — growth of :jvm-runtime-deps and
  ;; production `.clj` is forbidden; standing debt is measured elsewhere
  ;; (`verify-jvm-dependency-surface`). ADR-2608201300.
  :jvm-new-surface
  {:policy/authority "90-docs/adr/2608201300-jvm-new-surface-scaffold-guard.edn"
   :policy/detector "scripts/verify-jvm-dependency-surface.cljs"
   :policy/admission "scripts/jvm_new_surface_policy.cljs"
   :policy/hook ".claude/hooks/jvm-new-surface-guard.cljs"
   :policy/forbids #{:new-production-clj
                     :new-top-level-jvm-runtime-third-party}
   :policy/allows #{:edit-existing-clj
                    :new-test-clj
                    :workspace-git-deps
                    :local-root-deps
                    :alias-lint-test-build-coords
                    :portable-cljc-cljs-kotoba
                    :org.clojure/clojure}
   :policy/override-env "JVM_NEW_SURFACE_ALLOW"}}

 :vocabularies
 [{:vocabulary/id :stack-tier
   :vocabulary/authority "90-docs/adr/2607266000-kotoba-stack-responsibility-split-t0-t3.edn"
   :vocabulary/applies-to "kotoba language stack repositories (t0-t6)"
   :vocabulary/declaration-shape {:required [:name :tier :role]
                                  :optional [:must-not :depends-on]}
   :vocabulary/discriminator :name
   ;; Lifted verbatim from the `allowed-role-edges` map that was hardcoded in
   ;; scripts/verify-repository-roles.cljs. A repo of role K may declare a
   ;; production dependency only on repos whose role is in (get edges K).
   :vocabulary/allowed-role-edges
   {:contract  #{:contract :library :assurance}
    :library   #{:contract :library}
    :backend   #{:contract :library :backend}
    :compiler  #{:contract :library :backend :verifier}
    :verifier  #{:contract :backend}
    :runtime   #{:contract :library :backend :compiler :verifier :runtime :assurance}
    :provider  #{:contract :runtime :assurance}
    :assurance #{:contract :library :assurance}
    :placement #{:runtime :assurance}}}

  {:vocabulary/id :name-prefix
   :vocabulary/authority "90-docs/adr/2607299000-repository-rules-workspace-authority.edn"
   :vocabulary/originated-in "kotoba-lang/loop-ux-kaizen docs/adr/0001-loop-repository-taxonomy.md"
   :vocabulary/first-instantiation "90-docs/adr/2607220100-skill-action-loop-system-dynamics-scaffold.edn"
   :vocabulary/applies-to "any repo in this workspace whose name carries a role prefix"
   :vocabulary/declaration-shape {:required [:prefix :role :execution]
                                  :optional [:must :must-not :authority-library :composition]}
   ;; :execution answers "when does this thing run", which the vocabulary did
   ;; not previously say and which nothing else in the workspace recorded
   ;; either. Owner directive 2026-07-30.
   ;;
   ;;   :on-demand — wakes for a request and stops. An API or MCP call is the
   ;;     only reason it runs. It holds no loop and no clock, so serverless is
   ;;     the natural shape and residency would be waste.
   ;;   :resident  — carries its own loop and runs whether or not anyone is
   ;;     asking. It needs a clock and a scheduler.
   ;;   :none      — not a runnable thing at all; a library or a model.
   ;;
   ;; The distinction changes what a MISSING endpoint means. For an
   ;; :on-demand actor it means "not yet exposed" — unremarkable, since 1,326
   ;; of them have no deploy config at all. For a :resident actor it means the
   ;; loop is not running, which is a fault. Collapsing the two would report
   ;; hundreds of healthy unexposed actors as broken, or a dead organism as
   ;; fine.
   ;; :per-repo-evidence added 2026-08-04 (ADR-2608040150). A prefix that is a
   ;; KEY rather than a ROLE cannot carry one execution value — see the
   ;; cloud-itonami-lei- rule, where 154 members are inert records and 31 are
   ;; actors. Declaring one value for those would have been false for 154 or 31
   ;; of them whichever way it went. The value means: read :repo/kind from
   ;; manifest/repo-taxonomy.edn, which derives it from repo evidence
   ;; (ADR-2607289600), and do not infer it from the name.
   :vocabulary/execution-values #{:on-demand :resident :none :per-repo-evidence}
   :vocabulary/discriminator :prefix
   ;; Lifted verbatim from kotoba-lang/loop-ux-kaizen/resources/repository-rules.edn,
   ;; which originated the convention and remains its first example.
   :vocabulary/rules
   [{:prefix "loop-"
     :role :continuous-orchestrator
     ;; The observe→act cycle is the point; it runs unprompted.
     :execution :resident
     :must [:observe :evaluate :decide :act :record-evidence]
     :must-not [:own-domain-scoring-truth :bind-to-one-ci-provider]
     :examples ["loop-ux-kaizen" "loop-system-dynamics"]}
    {:prefix "skill-"
     :role :agent-instruction-package
     ;; Already implied by :must-not :require-resident-runner below — an
     ;; instruction package is read when an agent needs it, not run.
     :execution :on-demand
     :must [:define-agent-procedure :declare-inputs :declare-outputs]
     :must-not [:require-resident-runner :own-ci-state]
     :examples ["skill-ux-kaizen"]}
    ;; ── agent-host plugins (2026-08-31, ADR-2608318100) ────────────
    ;; action- adapts this workspace's work to GitHub's runner. plugin-
    ;; adapts it to an agent host (Hermes today) that loads code and calls
    ;; it as tools. Same shape, different runner, so the same must-nots
    ;; apply: the adapter carries no domain contract and no second copy of
    ;; a decision that already has one owner. The host dictates the
    ;; language, which is exactly why the decision must not live in it --
    ;; a reimplementation there is a second decider, and two answers that
    ;; agree until they do not (ADR-2608197300 sections 3 and 5).
    {:prefix "plugin-"
     :role :agent-host-plugin-adapter
     ;; Loaded when the host starts a turn; holds no loop of its own.
     :execution :on-demand
     :must [:expose-a-host-plugin-manifest
            :delegate-every-decision-to-its-owner
            :distinguish-could-not-answer-from-answered-no
            :ship-a-probe-that-verifies-an-install]
     :must-not [:own-domain-contract
                :reimplement-a-decider-in-the-host-language
                :require-resident-runner]
     :examples ["plugin-hermes"]
     ;; The first instance of this shape predates the prefix and lives in
     ;; the superproject rather than a repo: scripts/hermes-dashboard-auth-did.
     :prior-art ["com-junkawasaki/root scripts/hermes-dashboard-auth-did"]}
    {:prefix "action-"
     :role :github-action-adapter
     ;; Fires on a workflow event.
     :execution :on-demand
     :must [:expose-action-yml :pin-external-revisions :emit-check-result]
     :must-not [:own-domain-contract :hide-provider-neutral-core]
     :examples ["action-ux-kaizen"]}
    ;; ── governed executable actors (owner directive 2026-08-11) ─────
    ;; An executable actor must be discoverable from the repository name. A
    ;; bare metaphor may still name the actor itself, but the repository that
    ;; owns its advise → govern → decide → effect boundary carries actor-.
    {:prefix "actor-"
     :role :governed-executable-actor
     ;; actor- identifies the governed execution boundary, not one residency
     ;; class. A request-scoped researcher and a continuously monitoring
     ;; operational actor are both actors; residency must come from evidence.
     :execution :per-repo-evidence
     :execution-source
     {:primary {:file "README.edn" :attribute :repo/execution
                :values #{:on-demand :resident}}
      :fallback {:file "actor-manifest.jsonld"
                 :attribute :heartbeatRequired
                 :mapping {true :resident false :on-demand}}
      :legacy-default :on-demand}
     :must [:declare-an-actor-identity
            :separate-advisor-from-governor
            :bound-effects
            :record-an-audit-trail
            :state-source-and-consumer-boundaries]
     :must-not [:hide-an-executable-actor-behind-a-bare-name
                :hold-ambient-authority
                :mint-a-new-actor-identity-on-repository-rename]
     :examples ["actor-mikurabe" "actor-minidrama" "actor-utsushie"
                "actor-bunken" "actor-crew" "actor-isekai"]
     ;; Historical reusable IPC substrate, not an executable actor. Keeping the
     ;; exception explicit prevents the prefix from silently asserting a false
     ;; execution contract; it should receive a subject-plane name separately.
     :legacy-non-conformant ["kotoba-lang/actor-ipc"]}
    ;; ── end-user applications (owner directive 2026-08-03,
    ;;    ADR-2608035000) ─────────────────────────────────────────────
    ;; The prefix was already in use by 19 repositories before it was ever
    ;; declared here, which is exactly the drift ADR-2607299000 was written
    ;; to stop. Declaring it now, and naming the non-conformant set, is
    ;; preferable to a rule that silently reads as if all 28 satisfied it.
    {:prefix "app-"
     :role :end-user-application
     ;; An application is opened, used, and closed. It holds no loop of its
     ;; own: anything periodic belongs to a loop- orchestrator that the app
     ;; reads from, not to the app.
     :execution :on-demand
     :must [:present-a-user-surface
            :declare-its-capabilities
            :delegate-domain-truth]
     :must-not [:own-domain-model-truth
                :hold-ambient-authority
                :embed-a-second-renderer]
     ;; Where the shared behaviour lives. An app- repo that browses a set of
     ;; items states sort/filter/group/search/selection semantics by asking
     ;; mokuroku, the same way a loop- repo asks dynamics for scoring truth --
     ;; and draws the window by asking mokuroku-ui rather than assembling one
     ;; from kotoba-ui parts. The two are split so a host that renders some
     ;; other way can still use the kernel (byoubu / byoubu-ui precedent).
     :authority-library "mokuroku"
     :authority-view "mokuroku-ui"
     :composition {:domain-model "portable .cljc + bounded .kotoba profile"
                   :ui "kotoba-ui.core (+ appkit.core | uikit.core)"
                   :effects "capability-* packages, host-injected"}
     :examples ["app-files" "app-monitor" "app-photos" "app-music"]
     ;; Migrated from etzhayyim (ADR-2608035000 context). These are Google
     ;; Workspace / Microsoft Graph compatible API servers in TypeScript, Go
     ;; and Python -- they present no user surface of their own, they own
     ;; their domain model, and they are not built on mokuroku. They carry
     ;; the prefix for historical reasons only and are NOT claimed to satisfy
     ;; the contract above.
     :legacy-non-conformant
     ["kotoba-lang/app-briefing" "kotoba-lang/app-browser"
      "kotoba-lang/app-calendar" "kotoba-lang/app-comfyui"
      "kotoba-lang/app-contacts" "kotoba-lang/app-docs"
      "kotoba-lang/app-drive" "kotoba-lang/app-editor"
      "kotoba-lang/app-forms" "kotoba-lang/app-i18n"
      "kotoba-lang/app-mailer" "kotoba-lang/app-murakumo"
      "kotoba-lang/app-phone" "kotoba-lang/app-playwright"
      "kotoba-lang/app-reviewer" "kotoba-lang/app-search"
      "kotoba-lang/app-sheets" "kotoba-lang/app-slides"
      "kotoba-lang/app-wire"]
     ;; Carry the prefix and are plausibly real applications, but were not
     ;; examined when this rule was written. Recorded as unknown rather than
     ;; folded into either list, so nobody reads silence as a pass.
     :unassessed
     ["network-awai/app-aozora" "network-awai/app-aozora-svelte"
      "network-awai/app-hyakka"]}
    ;; ── capability authorities (owner directive 2026-08-04,
    ;;    ADR-2608040100 / ADR-2608040150) ────────────────────────────
    ;; 57 repositories carried this prefix before it was ever declared here —
    ;; the same drift as app-, and the largest undeclared role family in the
    ;; workspace. The contract itself was already decided by ADR-2607289500
    ;; ("capability を 1 authority = 1 public repository に分離する"); only its
    ;; name-prefix expression was missing.
    {:prefix "capability-"
     :role :capability-authority
     ;; A capability package is a contract plus its semantic definition. It is
     ;; imported and compiled against; nothing in it runs on its own. The
     ;; provider that satisfies it is a separate repo with its own execution.
     :execution :none
     :must [:declare-exactly-one-capability
            :ship-capability-edn
            :pin-a-semantic-definition-cid]
     ;; The one-capability-per-repo rule is the whole point of the split: an
     ;; import's immutable identity is the definition CID, and a repo holding
     ;; two capabilities cannot have one.
     :must-not [:declare-a-second-capability
                :hold-ambient-authority
                :depend-on-a-provider]
     :authority "90-docs/adr/2607289500-kotoba-refactor-agent-handoff-and-capability-repo-cid.edn"
     ;; This family does NOT declare through resources/repository-rules.edn.
     ;; It was first recorded as a 57-repo declaration gap on that assumption;
     ;; measuring it showed every one of the 57 already ships capability.edn,
     ;; which states the same contract in a typed form the generic file cannot
     ;; (definition CID, hash contract CID, imports, effects, default policy,
     ;; provider status). Writing 57 generic declarations would have added a
     ;; second, weaker source of truth for a contract that already had one.
     :declaration-file "capability.edn"
     :declaration-schema "kotoba.capability.repository.v1"
     ;; Derivable, like the origin plane: the repository name is the capability
     ;; id with '/' replaced by '-'. Holds for all 57 (measured 2026-08-04), so
     ;; the check is an equality, not a heuristic.
     :name-derivation {:from :capability/id
                       :rule "capability- + (str/replace id \"/\" \"-\")"
                       :example {"http/fetch" "capability-http-fetch"
                                 "gpu/draw-frame" "capability-gpu-draw-frame"
                                 "secret/use-scram-sha256" "capability-secret-use-scram-sha256"}}
     :verified-by "nbb scripts/verify-repository-roles.cljs --capability-audit"
     ;; Recorded because it bears directly on how much the NAME is allowed to
     ;; mean: ADR-2607289500 decides that a repository name (and a Radicle RID)
     ;; is a discovery alias only, and that identity is the semantic definition
     ;; CID. So `capability-http-fetch` is a search affordance, not a contract —
     ;; the derivation above checks the affordance, never substitutes for the CID.
     :identity :semantic-definition-cid
     :examples ["capability-http-fetch" "capability-gpu-draw-frame"
                "capability-identity-sign" "capability-ledger-append"]}
    ;; ── the itonami fleet's two execution classes (owner directive
    ;;    2026-07-30) ──────────────────────────────────────────────────
    ;; The prefix is written out in full because the auditor matches with
    ;; starts-with? on the repository basename, and these repos are named
    ;; cloud-itonami-isic-NNNN. Declaring "isic-" would have matched none of
    ;; the 459 and produced a rule that reads as governance while enforcing
    ;; nothing.
    {:prefix "cloud-itonami-isic-"
     :role :sector-agent
     ;; Agent-like, NOT resident: an isic actor exists to answer an API or MCP
     ;; request about its ISIC sector and then stop. There are 459 of them, and
     ;; making that many processes resident would cost continuously to sit idle.
     ;; Cloudflare Pages Functions is the shape already proven by
     ;; cloud-itonami-isic-6492, which serves /api/loan/* with no residency.
     :execution :on-demand
     :must [:answer-a-request :declare-its-isic-code]
     :must-not [:hold-a-loop :require-a-clock]
     :examples ["cloud-itonami-isic-6492" "cloud-itonami-isic-5820"]}
    ;; The rest of the itonami fleet, classified 2026-07-30 on the same
    ;; evidence: each family is keyed by a classification code or a
    ;; jurisdiction, each blueprint carries a :domain and a :governor and no
    ;; loop, and the one family member that is deployed (isic-6492, on Pages
    ;; Functions) answers a request and stops. None of them is resident, so
    ;; none of them should pay to sit idle. The :role differs because what an
    ;; actor is keyed BY is the useful thing to know about it.
    {:prefix "cloud-itonami-isco-"
     :role :occupation-agent
     :execution :on-demand
     :must [:answer-a-request :declare-its-isco-08-code]
     :must-not [:hold-a-loop :require-a-clock]
     :examples ["cloud-itonami-isco-0110"]}
    {:prefix "cloud-itonami-iso3166-"
     :role :jurisdiction-agent
     :execution :on-demand
     :must [:answer-a-request :declare-its-iso3166-code]
     :must-not [:hold-a-loop :require-a-clock]
     :examples ["cloud-itonami-iso3166-ago"]}
    {:prefix "cloud-itonami-municipality-"
     :role :municipal-agent
     :execution :on-demand
     :must [:answer-a-request :declare-its-municipality]
     :must-not [:hold-a-loop :require-a-clock]
     :examples ["cloud-itonami-municipality-are-abu-dhabi"]}
    {:prefix "cloud-itonami-assoc-"
     :role :association-compliance-agent
     :execution :on-demand
     :must [:answer-a-request :declare-its-association]
     :must-not [:hold-a-loop :require-a-clock]
     :examples ["cloud-itonami-assoc-6411-jpn-boj"]}
    {:prefix "cloud-itonami-marketplace-"
     :role :marketplace-service
     ;; Measured rather than inferred: seven of these are deployed Workers and
     ;; each answers /health and its own REST surface per request.
     :execution :on-demand
     :must [:answer-a-request]
     :must-not [:hold-a-loop]
     :examples ["cloud-itonami-marketplace-order"]}
    {:prefix "cloud-itonami-commitment-"
     :role :commitment-service
     ;; Deployed on Pages with Functions under /api/commitment/*.
     :execution :on-demand
     :must [:answer-a-request]
     :must-not [:hold-a-loop]
     :examples ["cloud-itonami-commitment-ledger"]}
    ;; Smaller code systems, same shape. Separate prefixes because the auditor
    ;; matches with starts-with? and these share no common one.
    {:prefix "cloud-itonami-cofog-"
     :role :classification-agent :execution :on-demand
     :must [:answer-a-request] :must-not [:hold-a-loop]}
    {:prefix "cloud-itonami-unspsc-"
     :role :classification-agent :execution :on-demand
     :must [:answer-a-request] :must-not [:hold-a-loop]}
    {:prefix "cloud-itonami-gtin-"
     :role :classification-agent :execution :on-demand
     :must [:answer-a-request] :must-not [:hold-a-loop]}
    {:prefix "cloud-itonami-jsic-"
     :role :classification-agent :execution :on-demand
     :must [:answer-a-request] :must-not [:hold-a-loop]}
    {:prefix "cloud-itonami-crowdfunding-"
     :role :crowdfunding-service
     ;; A five-part service split by stage — pledge, collection, fulfillment,
     ;; payout, campaign — the same request-per-stage shape as marketplace.
     :execution :on-demand
     :must [:answer-a-request] :must-not [:hold-a-loop]
     :examples ["cloud-itonami-crowdfunding-pledge"]}
    {:prefix "cloud-itonami-partners"
     :role :franchise-recruitment-service
     ;; ScreeningAdvisor with a sealed LLM behind an independent
     ;; PartnerGovernor: it screens an application when one arrives and stops.
     ;; The territory grant itself waits on a human, permanently, so nothing
     ;; here runs unprompted.
     :execution :on-demand
     :must [:answer-a-request] :must-not [:hold-a-loop]
     :examples ["cloud-itonami-partners"]}
    {:prefix "cloud-itonami-esim"
     :role :provisioning-service
     ;; Landed in west after the first classification pass and surfaced as
     ;; unclassified, which is what that state is for. Same evidence as the
     ;; other service families: a governor, no loop, a request to answer.
     :execution :on-demand
     :must [:answer-a-request] :must-not [:hold-a-loop]
     :examples ["cloud-itonami-esim"]}
    {:prefix "cloud-itonami-hygiene-"
     :role :commercialization-service
     :execution :on-demand
     :must [:answer-a-request] :must-not [:hold-a-loop]
     :examples ["cloud-itonami-hygiene-access"]}
    ;; ── keyed by LEI, but NOT one role (measured 2026-08-04,
    ;;    ADR-2608040150) ────────────────────────────────────────────────
    ;; 185 repositories, the largest single unclassified block in the workspace.
    ;; The obvious reading — "another code-keyed agent family, like assoc- and
    ;; isic-" — is wrong, and the blueprint says so: an assoc- blueprint carries
    ;; :itonami.blueprint/domain and :itonami.blueprint/governor, while a lei-
    ;; blueprint carries :company/legal-name, :company/lei, :company/jurisdiction
    ;; and :company/website. It is a legal-entity RECORD, not an actor spec.
    ;;
    ;; Cross-referencing manifest/repo-taxonomy.edn (evidence-derived, not name
    ;; glob) settles it: of the 185, 154 are :repo/kind "organisation-record"
    ;; and 31 are "actor". The prefix names what the repo is KEYED BY, not what
    ;; it IS — so it gets no single :execution.
    {:prefix "cloud-itonami-lei-"
     :role :legal-entity-keyed
     :execution :per-repo-evidence
     :execution-source {:file "manifest/repo-taxonomy.edn"
                        :attribute :repo/kind
                        :measured-2026-08-04 {"organisation-record" 154 "actor" 31}
                        :mapping {"organisation-record" :none "actor" :on-demand}}
     :must [:declare-its-lei]
     ;; No :must-not :hold-a-loop here. That claim is true of the records
     ;; trivially and of the actors by the fleet's shape, but asserting it for a
     ;; set this heterogeneous without measuring each would be governance
     ;; theatre — the thing ADR-2607299000 exists to stop.
     :examples ["cloud-itonami-lei-06btx5uwzd0gq5n5y745"]
     :note "joins market-intel and cloud-itonami-lei datasets on :company/lei"}
    {:prefix "person-"
     :role :artificial-organism-actor
     ;; Resident and autonomous: it holds an operating identity, a mailbox and
     ;; capabilities, and carries out business under activity → decision →
     ;; effect → audit whether or not anyone is asking. The model it embodies
     ;; is kotoba-lang/ao, which is deliberately runner-free and clock-free —
     ;; the actor supplies both.
     :execution :resident
     ;; The organism model these actors embody. Referenced, not vendored: `ao`
     ;; is deliberately runner-free and clock-free, so an actor supplies both
     ;; and holds a pin to the model rather than a copy of it.
     :authority-library "ao"
     :must [:hold-an-identity :run-its-own-loop :record-an-audit-trail]
     :examples ["person-awai-ryo" "person-isekai-hajime"]}
    {:prefix nil
     :role :library
     ;; Nothing to run. kotoba-lang/ao is the clearest case: "model only, no
     ;; CLI, no runner, no storage, no clock — every function takes now-ms from
     ;; its caller."
     :execution :none
     ;; The subject plane. A bare name is the LAST plane tried, not the default
     ;; one: it is what remains after origin, role and family have all failed to
     ;; apply (ADR-2608040100 :plane-order). 537 repositories in kotoba-lang
     ;; carry a bare name, and a bare name that is really an actor or a service
     ;; is a role-plane repo that skipped its prefix.
     :must [:provide-reusable-contract]
     :must-not [:be-an-actor-or-service-without-a-role-prefix]
     ;; A metaphor name is allowed — `kuro` (黒, terminal model) and `kobo`
     ;; (工房, workbench) were deliberately chosen over descriptive names. What
     ;; is NOT allowed is a metaphor with no other way in: on 2026-08-03 both
     ;; repos existed for 34 days and "is a terminal implemented?" was still
     ;; answered "no", because the name said nothing and nothing else did
     ;; either. The fix is not renaming, it is a second route.
     :opaque-name-requires
     [{:route :readme-self-identification
       :rule "the README's first line states what the repository is, in plain
              terms, before any metaphor or history"}
      {:route :concept-index
       :rule "the subject is registered in manifest/concept-vocabulary.edn so
              `nbb scripts/concept-lookup.cljs <word>` reaches it — in both
              English and Japanese"
       :authority "90-docs/adr/2608039980"}]
     :examples ["design-quality" "hinshitsu" "browser-agent" "ao"]
     :opaque-examples ["kuro" "kobo" "byoubu" "sekisho" "madoguchi" "shitsuke"]}]
   :vocabulary/composition
   {:authority "loop-*"
    :adapters ["action-*" "skill-*"]
    :libraries ["design-quality" "hinshitsu" "browser-agent" "browser-use"]}
   :vocabulary/github
   {:required-permissions {:contents :read}
    :pull-request-gate true
    :schedule-supported true
    :baseline-promotion :explicit-human-action
    :missing-evidence :fail-closed}}

  ;; ── origin plane (owner directive 2026-08-04, ADR-2608040100) ─────────
  ;; 1,191 repositories carry an origin prefix and none of it was declared.
  ;;
  ;; The correction this vocabulary encodes: `com-` is NOT a category meaning
  ;; "commercial company". It is what stripe.com reverses to. The prefix is a
  ;; mechanical function of the authority's real domain, which means a
  ;; misfiling is a lookup that never happened, not a judgement that went the
  ;; wrong way — and therefore machine-checkable.
  {:vocabulary/id :origin
   :vocabulary/authority "90-docs/adr/2608040100-origin-plane-is-reverse-dns-of-the-real-domain.edn"
   :vocabulary/applies-to "any repo implementing a specification or product that some other party owns"
   :vocabulary/data "manifest/origin-domains.edn"
   :vocabulary/discriminator :origin/domain
   ;; Reverse the registrable domain's labels and join with '-'. The repo name
   ;; must equal that, or begin with it followed by '-' and a subject.
   :vocabulary/derivation
   {:input :registrable-domain
    :steps [:drop-www :split-on-dot :reverse :join-with-hyphen]
    :match "name = prefix, or name starts-with (str prefix \"-\")"
    ;; One-way on purpose. A name cannot be parsed back into a domain because a
    ;; single label may contain no hyphen while the subject contains several
    ;; (com-yang-ming-api). Deriving forward is total; parsing backward is not.
    :direction :domain->prefix-only}
   ;; Not a fixed value set. Whatever TLD the authority actually uses is the
   ;; prefix, which is why no new category had to be invented for government or
   ;; treaty bodies — irs.gov simply reverses to gov-irs.
   :vocabulary/tld-values :open
   :vocabulary/observed-tlds
   {"com" 1054 "org" 119 "io" 13 "tech" 2 "jp" 2 "net" 1 "edu" 1 "dev" 1 "ws" 2}
   ;; "ws" declared 2026-08-15 (ADR-2608153000): valueflo.ws -> ws-valueflo-*.
   ;; Declared because the observed set is what makes a name VISIBLE to the
   ;; audit at all. Until this line existed, ws-valueflo-vocabulary and
   ;; ws-valueflo-algorithms appeared in NEITHER the conformant nor the
   ;; misfiled list -- they were classified out of the origin plane and
   ;; silently dropped. The docstring in verify-repository-roles.cljs says an
   ;; unseen TLD "is reported as an undeclared prefix, which surfaces it for a
   ;; decision"; measured 2026-08-15, it was not reported at all. Adding the
   ;; TLD is the decision that mechanism was asking for. The remaining gap --
   ;; that an unknown TLD is dropped rather than surfaced -- is recorded as
   ;; :gap/unknown-tld-is-dropped-not-surfaced below.
   ;; Pin the domain as of registration. An authority that moves its domain does
   ;; NOT trigger a rename: the name is a discovery alias, not identity
   ;; (ADR-2607289500), and chasing a move would churn west pins and every
   ;; inbound reference for nothing. Already live: IPFS moved ipfs.io ->
   ;; ipfs.tech and correctly occupies both io-ipfs and tech-ipfs-*.
   :vocabulary/on-domain-migration :pin-at-registration-do-not-rename
   ;; Absence of a recorded domain is UNVERIFIED, never CONFORMANT.
   :vocabulary/missing-evidence :report-unverified}

  ;; ── org identity: the authority path is <org>/<name>, not <name> ──────
  ;; Owner directive 2026-08-05 (ADR-2608040170): "family = reverse domain +
  ;; subdomain". That merges the family plane into the origin plane -- a family
  ;; is the same reverse-DNS operation one label deeper -- and raises the
  ;; question the owner then asked: org-kotoba-lang-kami-engine is correct but
  ;; long.
  ;;
  ;; It is long because it says the org TWICE. GitHub already gives us the first
  ;; path segment. So:
  ;;
  ;;   the NAME carries reverse-DNS only for the part the ORG segment does not
  ;;   already say.
  ;;
  ;;   kotoba-lang/kami-engine     org = kotoba-lang.org, name = kami + engine
  ;;   kotoba-lang/org-ietf-x509   authority is external, so the name carries it all
  ;;
  ;; kami-engine is therefore already correct and needs no rename. Measured
  ;; 2026-08-12: all eight org domains resolve, and three orgs are ALREADY named
  ;; in reverse-DNS form, which is why cloud-itonami/cloud-itonami-isic-6492
  ;; states itonami.cloud twice.
  {:vocabulary/id :org-domain
   :vocabulary/authority "90-docs/adr/2608040170-authority-path-is-org-plus-name.edn"
   :vocabulary/applies-to "the org segment of every repository path"
   :vocabulary/dns-checked-at "2026-08-05"
   :vocabulary/rules
   [{:org "cloud-itonami"   :domain "itonami.cloud"    :reversed "cloud-itonami"   :org-name-is-reversed true}
    {:org "com-junkawasaki" :domain "junkawasaki.com"  :reversed "com-junkawasaki" :org-name-is-reversed true}
    {:org "network-awai"    :domain "awai.network"     :reversed "network-awai"    :org-name-is-reversed true}
    {:org "net-kotobase"    :domain "kotobase.net"     :reversed "net-kotobase"    :org-name-is-reversed true}
    {:org "kotoba-lang"     :domain "kotoba-lang.org"  :reversed "org-kotoba-lang" :org-name-is-reversed false
     :note "org name is the registrable label without the TLD"}
    {:org "etzhayyim"       :domain "etzhayyim.com"    :reversed "com-etzhayyim"   :org-name-is-reversed false}
    {:org "gftdcojp"        :domain "gftd.co.jp"       :reversed "jp-co-gftd"      :org-name-is-reversed false
     :note "compressed form: gftd+co+jp run together"}
    {:org "jk-luxury"       :domain "jk.luxury"        :reversed "luxury-jk"       :org-name-is-reversed false
     :note "the only org whose name is in forward order"}]
   ;; An existing family's established form wins over the elision rule. Joining
   ;; 459 cloud-itonami-isic-* siblings as a bare isic-NNNN would put two forms
   ;; in one family, which is worse than the redundancy. The elision binds
   ;; families created from here on.
   :vocabulary/existing-family-form-wins true
   :vocabulary/redundant-but-not-wrong ["cloud-itonami-*" "com-etzhayyim-*"]}

  ;; ── product family plane (owner directive 2026-08-04, ADR-2608040100) ──
  ;; 169 repositories in five families, none declared. kami-* alone is 96 —
  ;; larger than every declared role prefix in this file combined.
  {:vocabulary/id :product-family
   :vocabulary/authority "90-docs/adr/2608040100-origin-plane-is-reverse-dns-of-the-real-domain.edn"
   :vocabulary/applies-to "repos owned by one authority that ship as a set"
   :vocabulary/discriminator :family
   ;; A family prefix is only earned by a set. One repo with a family prefix is
   ;; a bare-name library wearing a costume, and it makes the prefix look like a
   ;; taxonomy when it is a single name.
   :vocabulary/rules
   [;; The largest family in the workspace by an order of magnitude, and it was
    ;; the last one anybody thought to declare — every rule written for it named
    ;; a sub-prefix (isic- / assoc- / marketplace- / …) and none named the family
    ;; those sub-prefixes hang off. Declaring it gives the ~200 members that
    ;; match no role sub-prefix a correct plane instead of dropping them into
    ;; subject, where a fleet actor plainly does not belong (ADR-2608040150).
    {:family "cloud-itonami-" :count 1200 :owner "cloud-itonami"
     :note "role sub-prefixes inside this family are declared in :name-prefix and
            win by :plane-order; the family plane catches the remainder"}
    {:family "kami-"     :count 96 :owner "kami-engine"
     :authority "90-docs/adr/2607102200-kami-render-stack-deps-authority-rename.edn"
     :note "the 3D stack; CLAUDE.md makes it mandatory for all 3D in the workspace"}
    {:family "kotoba-"   :count 32 :owner "kotoba"}
    ;; SERVING family: 15 hosts under kotobase.net. Under "family = reverse
    ;; domain + subdomain" the prefix should BE that domain reversed, so the
    ;; correct form is net-kotobase-* and the current kotobase-* is missing its
    ;; TLD. Recorded, not renamed: 25 members (ADR-2608040180).
    {:family "kotobase-" :count 24 :owner "kotobase"
     :served-domain "kotobase.net" :implied-prefix "net-kotobase-"
     :note "storage/query providers; kotobase-storage-* is a sub-set keyed by backend"}
    ;; ── families evidenced by the surface index, 2026-08-05 ─────────────
    ;; Found by matching served hosts, not by DNS: gftd.ai is a wildcard and
    ;; oil.cloud / artifact.app belong to other people, so resolution proves
    ;; nothing. Each of these serves real hosts, which under the rule means the
    ;; prefix should be the reversed domain. None of them is, yet.
    ;; No :served-domain on purpose. open- is not a subdomain of etzhayyim.com;
    ;; it is a shared LABEL PREFIX across sibling subdomains, so declaring the
    ;; registrable domain would match all 196 etzhayyim hosts instead of its 13.
    ;; Left to the label-prefix fallback.
    {:family "open-" :count 12 :owner nil
     :implied-prefix "com-etzhayyim-open-" :registrable-domain "etzhayyim.com"
     :hosts 13
     :note "open-banking/-gas/-denki/-rail/-ports/-network/-cofog/-airplane
            .etzhayyim.com are live. The family is a shared LABEL PREFIX across
            sibling subdomains, not a subdomain of its own."}
    ;; RESOLVED 2026-08-05: the four aozora-* repos were renamed to app-aozora-*,
    ;; so one domain no longer carries two naming schemes. This family is done;
    ;; the other five in :gap/serving-family-prefix-lacks-its-tld are not.
    {:family "app-aozora-" :count 6 :owner nil
     :served-domain "aozora.app" :implied-prefix "app-aozora-"
     :hosts 5
     :renamed-2026-08-05 ["aozora-appview -> app-aozora-appview"
                          "aozora-design-system -> app-aozora-design-system"
                          "aozora-engine -> app-aozora-engine"
                          "aozora-yoro-ui -> app-aozora-yoro-ui"]}
    ;; RENAMED 2026-08-05: the four suffixed members are now cloud-murakumo-*.
    ;; The stem kotoba-lang/murakumo is NOT renamed -- cloud-murakumo would
    ;; collide with network-awai/cloud-murakumo, turning the recorded 19
    ;; cross-org duplicate names into 20.
    {:family "cloud-murakumo-" :count 4 :owner nil
     :served-domain "murakumo.cloud" :implied-prefix "cloud-murakumo-"
     :hosts 2
     :stem-held "kotoba-lang/murakumo"}
    ;; RENAMED 2026-08-05: all five are now ai-gftd-dougaka*.
    {:family "ai-gftd-dougaka" :count 5 :owner nil
     :served-domain "dougaka.gftd.ai" :implied-prefix "ai-gftd-dougaka"
     :hosts 1}
    ;; CORRECTED 2026-08-05 (ADR-2608040200). --family-audit derived
    ;; com-etzhayyim-bpmn- from the served host bpmn.etzhayyim.com. Wrong: all
    ;; three repos implement BPMN 2.0, an OMG standard, and kotoba-lang/org-omg-bpmn
    ;; already exists beside org-omg-cmmn / -dmn / -sysmlv2 / -uml. :plane-order
    ;; puts origin ahead of family, so the authority is omg.org.
    ;;
    ;; The general lesson: SERVING a host does not make you the AUTHORITY for the
    ;; subject. bpmn.etzhayyim.com is a deployment of BPMN tooling, not the
    ;; publisher of the BPMN spec. One level up from ADR-2608040180's
    ;; "resolving is not owning". --family-audit only sees served hosts, so its
    ;; derivation must not be adopted where the subject has an external authority.
    {:family "bpmn-" :count 3 :owner nil
     :served-host "bpmn.etzhayyim.com"
     :authority "omg.org" :implied-prefix "org-omg-bpmn-"
     :blocked-by "bpmn-engine-ts names itself -ts while its README says
                  'BPMN 2.0 execution engine for Rust' -- resolve that first"
     :hosts 1}
    {:family "kura-"     :count 6  :owner "kura"}
    {:family "kotodama-" :count 5  :owner "kotodama"}]
   ;; Owner directive 2026-08-05: family = reverse domain + subdomain. A family
   ;; claim now costs something real and checkable, the same property that made
   ;; the origin plane work. What counts as the receipt depends on whether the
   ;; family serves anything:
   ;;
   ;;   SERVING family  -> a real subdomain. open-*.etzhayyim.com is live for
   ;;                      seven of them; aozora.app has pds/appview/live.
   ;;   LIBRARY family  -> a declared owning repo, because a subdomain that
   ;;                      serves nothing is a formality. kami- has no
   ;;                      kami.* anywhere and does not need one: it is a
   ;;                      kotoba library family owned by kami-engine.
   :vocabulary/justification
   {:serving :real-subdomain
    :library :declared-owning-repo
    :measured-2026-08-05
    {"cloud-itonami-" "itonami.cloud"  "cloud-murakumo" "murakumo.cloud"
     "app-aozora" "aozora.app"         "net-kotobase" "kotobase.net"
     "ai-gftd-" "gftd.ai"              "open-" "open-*.etzhayyim.com"
     "kami-" :library-family-owned-by-kami-engine
     "cloud-kyusai" :no-domain-kyusai-cloud-does-not-resolve}}
   :vocabulary/must [:share-one-owning-authority :ship-as-a-set]
   :vocabulary/must-not [:be-a-family-of-one :shadow-a-role-prefix]
   ;; Measured, not asserted: these carry a family-shaped prefix but have fewer
   ;; than three members, so whether they are a family or two bare names that
   ;; happen to share a word is undecided. Named rather than folded in.
   ;; murakumo- resolved 2026-08-05: it serves murakumo.cloud, so it is a family
   ;; (declared above). sdk- has no served host and no owning repo, so under the
   ;; rule it is not a family at all.
   :vocabulary/undecided
   [{:family "sdk-" :count 3 :note "sdk-auth / sdk-mock / sdk-py — no served host,
      no owning repo; reads as a role, not an owner. Not a family under the rule."}]}]

 ;; ── plane order ────────────────────────────────────────────────────────
 ;; The single rule that makes the four planes a system rather than four
 ;; overlapping conventions: ONE NAME CARRIES ONE PLANE, and the plane is chosen
 ;; by the first of these that applies. Written down because the drift this file
 ;; keeps discovering is never "the wrong rule was followed" — it is "two rules
 ;; were available and nothing said which won" (ADR-2608040100).
 :plane-order
 [{:plane :origin        :when "the subject is someone else's spec or product"
   :vocabulary :origin}
  {:plane :role          :when "the repo's execution role is fixed (actor/loop/app/capability/person/skill/action)"
   :vocabulary :name-prefix}
  {:plane :family        :when "it belongs to a set owned by one authority here"
   :vocabulary :product-family}
  {:plane :subject       :when "none of the above — a reusable library, bare-named"
   :vocabulary :name-prefix :rule-index :prefix-nil}]

 ;; Two planes may use the same subject word — `webrtc` (our library) and
 ;; org-w3-webrtc-signaling (the spec) are both correct, and ADR-2607050900
 ;; already called the ipns/did pair exemplary for exactly this. The condition
 ;; is that each README states the boundary against its nearest neighbour.
 ;; What is forbidden is the SAME subject twice on the SAME plane.
 :cross-plane-collision
 {:allowed true
  :requires :readme-states-boundary-against-nearest-neighbour
  :precedent "90-docs/adr/2607050900-kotoba-lang-naming-audit.edn"
  :examples [{:subject "webrtc"
              :subject-plane "kotoba-lang/webrtc"
              :origin-plane "kotoba-lang/org-w3-webrtc-signaling"}
             {:subject "dns"
              :subject-plane "kotoba-lang/dns"
              :origin-plane "kotoba-lang/org-ietf-dns"}
             {:subject "arxiv"
              :subject-plane "kotoba-lang/arxiv"
              :origin-plane "kotoba-lang/com-arxiv-api"}]}
 :same-plane-collision
 {:allowed false
  :examples [{:subject "ros"
              :duplicates ["kotoba-lang/com-ros-robotics" "kotoba-lang/com-ros2-nav"
                           "kotoba-lang/org-ros" "kotoba-lang/org-ros-urdf"]
              :resolution "ros.org derives org-ros; the two com- entries are misfiled"}
             {:subject "w3c"
              :duplicates ["kotoba-lang/com-w3c-specs" "kotoba-lang/org-w3-*"]
              :resolution "w3.org derives org-w3; com-w3c-specs collides with a 40-strong conformant family"}]}

 ;; Naming constraints that hold for every repo in the workspace regardless of
 ;; vocabulary. Lifted from CLAUDE.md "Repo naming" / ADR-2607102200 addendum 14.
 :naming
 {:forbidden-suffixes
  [{:suffix "-clj"
    :since "2026-07-10"
    :authority "90-docs/adr/2607102200-kami-render-stack-deps-authority-rename.edn"
    :reason "language is not the package identity"
    :instead "short domain name, or a role suffix when the short name is taken"
    :examples ["kami-engine-guest" "kami-mangaka-scene-author"]}]}

 ;; The repositories whose declarations are verified against this authority.
 ;; Listed here rather than hardcoded in each consumer: the GitHub workflow and
 ;; the fleet-ci gate previously would each have carried their own copy, which
 ;; is exactly the drift that let five repos go unchecked (ADR-2607299000).
 ;; All are public, so a verifier may fetch their two files without any token.
 :checked-repos
 [{:org "kotoba-lang" :vocabulary :stack-tier
   :names ["kotoba" "amu" "kotoba-kir" "artifact" "kgraph" "grammar"
           "kotoba-wasm" "kotoba-native" "kotoba-component" "kotoba-verifier"
           "kototama-native" "provider" "provider-postgres" "fleet"
           "kotoba-core-contracts" "kotoba-lang" "security" "codebase" "mesh"
           "provider-transport" "kototama-component"]}
  {:org "kotoba-lang" :vocabulary :name-prefix
   :names ["loop-ux-kaizen" "loop-system-dynamics"]}]

 ;; Responsibility edges that exist in production but are not permitted by
 ;; :vocabulary/allowed-role-edges. An entry here does NOT bless the edge — it
 ;; makes it visible and dated. The verifier prints EXCEPTION for each and keeps
 ;; going; without an entry the edge is a hard failure. Every entry must name
 ;; what would resolve it. Delete the entry when the edge is gone.
 :exceptions
 [;; Found 2026-08-19, and found only because the declaration was corrected.
