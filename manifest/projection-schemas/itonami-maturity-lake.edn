;; columnar lake manifest の schema（ADR-2608070400 D8 / ADR-2608039700）。
;;
;; ここに載るのは列と chunk の *メタデータ* だけ。値は
;; 90-docs/lake/itonami-maturity/ の chunk EDN にあり、:lake/sha256 で結ぶ。
;; bytes を datom 面に載せないのは ADR-2608039970 の規則。
;;
;; :lake/min :lake/max は zone map。範囲クエリはこれで chunk を枝刈りしてから
;; :lake/path を開く。実測 2026-08-08: :leverage/meadows-score の [0.5,0.7]
;; 範囲で 4 chunk 中 3 を skip、175.2ms/1,291,951B → 8.0ms/55,236B（答えは同一）。
;;
;; :lake/min :lake/max が :db.type/double なのは、整数の列でも同じ属性で扱う
;; ため（loader の value-type? は :db.type/double を number? で見る）。列ごとに
;; 属性を分けると join できなくなる。
[{:db/ident :lake/entity-id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "identity。<dataset>/column/<slug> または <dataset>/chunk/<slug>/<index>"}
 {:db/ident :lake/kind
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":column か :chunk"}
 {:db/ident :lake/dataset
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "元 dataset 名。:source/dataset と同じ値で他の面と join できる"}
 {:db/ident :lake/attribute
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "列にした属性（keyword を文字列化したもの）"}
 {:db/ident :lake/rows
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "列なら総行数、chunk ならその chunk の行数"}
 {:db/ident :lake/chunk-count
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "列が持つ chunk 数"}
 {:db/ident :lake/rows-per-chunk
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "row-group の大きさ。最適点はデータ量の関数（capability-bench/run-lake-chunk）"}
 {:db/ident :lake/index
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "列内での chunk の位置。値の昇順"}
 {:db/ident :lake/min
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "zone map の下端（この chunk 内の最小値）"}
 {:db/ident :lake/max
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "zone map の上端（この chunk 内の最大値）"}
 {:db/ident :lake/path
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "chunk EDN の repo 相対パス。この面には値そのものは載らない"}
 {:db/ident :lake/sha256
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "chunk EDN の sha256。manifest と bytes を結ぶ唯一の紐"}]
