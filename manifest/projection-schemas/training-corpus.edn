;; manifest/projection-schemas/training-corpus.edn — ADR-2608056000 の projection
;; contract が固定する属性スキーマ。`manifest/project-edn.cljs` は **schema に無い
;; 属性を拒否する**ので、生成器が新しい属性を出したら contract 検証が落ちる
;; （＝スキーマの黙った拡張ができない）。
;;
;; 3 種類の entity が同じ面に載る。共通の identity は `:corpus/entity-id`:
;;   文書     `:corpus/entity-id` = repo 相対パス
;;   shard    `:corpus/entity-id` = "shard/<tier>-v1"
;;   coverage `:corpus/entity-id` = "coverage"

[#:db{:ident :corpus/adr-id :valueType :db.type/string :cardinality :db.cardinality/one}
 #:db{:ident :corpus/annex-key :valueType :db.type/string :cardinality :db.cardinality/one}
 #:db{:ident :corpus/bytes :valueType :db.type/long :cardinality :db.cardinality/one}
 #:db{:ident :corpus/consent :valueType :db.type/keyword :cardinality :db.cardinality/one}
 #:db{:ident :corpus/coverage :valueType :db.type/boolean :cardinality :db.cardinality/one}
 #:db{:ident :corpus/entity-id :valueType :db.type/string :cardinality :db.cardinality/one
      :unique :db.unique/identity}
 ;; hazard は 1 文書に複数出る。cardinality/one にすると最後の 1 件しか残らず
 ;; 「なぜ除外されたか」の集計が黙って過少報告になる。
 #:db{:ident :corpus/hazard :valueType :db.type/keyword :cardinality :db.cardinality/many}
 #:db{:ident :corpus/id :valueType :db.type/string :cardinality :db.cardinality/one}
 #:db{:ident :corpus/kind :valueType :db.type/keyword :cardinality :db.cardinality/one}
 #:db{:ident :corpus/parse :valueType :db.type/keyword :cardinality :db.cardinality/one}
 #:db{:ident :corpus/repo :valueType :db.type/string :cardinality :db.cardinality/one}
 #:db{:ident :corpus/score :valueType :db.type/double :cardinality :db.cardinality/one}
 #:db{:ident :corpus/score-currency :valueType :db.type/double :cardinality :db.cardinality/one}
 #:db{:ident :corpus/score-evidence :valueType :db.type/double :cardinality :db.cardinality/one}
 #:db{:ident :corpus/score-provenance :valueType :db.type/double :cardinality :db.cardinality/one}
 #:db{:ident :corpus/score-self-containment :valueType :db.type/double :cardinality :db.cardinality/one}
 #:db{:ident :corpus/score-specificity :valueType :db.type/double :cardinality :db.cardinality/one}
 #:db{:ident :corpus/score-structure :valueType :db.type/double :cardinality :db.cardinality/one}
 #:db{:ident :corpus/sha256 :valueType :db.type/string :cardinality :db.cardinality/one}
 #:db{:ident :corpus/status :valueType :db.type/string :cardinality :db.cardinality/one}
 #:db{:ident :corpus/tier :valueType :db.type/keyword :cardinality :db.cardinality/one}
 #:db{:ident :coverage/bronze :valueType :db.type/long :cardinality :db.cardinality/one}
 #:db{:ident :coverage/excluded :valueType :db.type/long :cardinality :db.cardinality/one}
 #:db{:ident :coverage/gold :valueType :db.type/long :cardinality :db.cardinality/one}
 #:db{:ident :coverage/parse-failed :valueType :db.type/long :cardinality :db.cardinality/one}
 #:db{:ident :coverage/policy-id :valueType :db.type/string :cardinality :db.cardinality/one}
 #:db{:ident :coverage/policy-sha256 :valueType :db.type/string :cardinality :db.cardinality/one}
 #:db{:ident :coverage/scanned :valueType :db.type/long :cardinality :db.cardinality/one}
 #:db{:ident :coverage/scored :valueType :db.type/long :cardinality :db.cardinality/one}
 #:db{:ident :coverage/silver :valueType :db.type/long :cardinality :db.cardinality/one}
 #:db{:ident :coverage/skipped :valueType :db.type/long :cardinality :db.cardinality/one}
 #:db{:ident :coverage/skipped-oversize :valueType :db.type/long :cardinality :db.cardinality/one}
 #:db{:ident :coverage/skipped-unreadable :valueType :db.type/long :cardinality :db.cardinality/one}
 #:db{:ident :shard/annex-key :valueType :db.type/string :cardinality :db.cardinality/one}
 #:db{:ident :shard/bytes :valueType :db.type/long :cardinality :db.cardinality/one}
 ;; :unverified = 宛先を宣言しただけ。annex に入って special remote へ複製された
 ;; ことを別途 `scripts/annex-custody-verify.cljs` が確認して初めて custody になる。
 #:db{:ident :shard/custody :valueType :db.type/keyword :cardinality :db.cardinality/one}
 #:db{:ident :shard/dataset :valueType :db.type/string :cardinality :db.cardinality/one}
 #:db{:ident :shard/documents :valueType :db.type/long :cardinality :db.cardinality/one}
 #:db{:ident :shard/id :valueType :db.type/string :cardinality :db.cardinality/one}
 #:db{:ident :shard/path :valueType :db.type/string :cardinality :db.cardinality/one}
 #:db{:ident :shard/sha256 :valueType :db.type/string :cardinality :db.cardinality/one}
 #:db{:ident :shard/tier :valueType :db.type/keyword :cardinality :db.cardinality/one}
 #:db{:ident :source/dataset :valueType :db.type/string :cardinality :db.cardinality/one}]
