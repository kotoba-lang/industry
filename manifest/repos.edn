;; repos.edn — west manifest 運用の source of truth（人が編集するのはここ）。
;; scripts/gen-west-manifest.bb がこれを読んで manifest/west.yml を生成する。
;;   - project の一覧と pin(revision) は git の事実(working tree HEAD)から採る。
;;   - ポリシー(remote 定義・既定・グループ・DataLad 連携)はこの EDN で宣言する。
;;
;; 方針: コード repo は全て west 管理。plain な git submodule は廃止(0 件)。
;;       大容量データの DataLad dataset だけは west project にしつつ git-annex(B2)で
;;       実体を扱う(:datalad で印を付け、既定では取得しない opt-in グループに隔離)。
{;; org 名 -> git remote の url-base
 :remotes
 {"com-junkawasaki" "git@github.com:com-junkawasaki"
  "kotoba-lang"     "git@github.com:kotoba-lang"
  "gftdcojp"        "git@github.com:gftdcojp"
  "etzhayyim"       "https://github.com/etzhayyim"}

 ;; org の役割分担（taxonomy の権威は ADR-2606302300）。生成器はこのキーを読まない（doc 用宣言。
  ;;   :manifest-workflow / :kotoba 等と同じく人間が読むポリシーメタ）。新規 repo の所属判定は
  ;;   この role/scope に従う: language-substrate→kotoba-lang, agent+公益→etzhayyim,
  ;;   human+ビジネス→gftdcojp, cross-cutting 基盤 -clj→com-junkawasaki。
 :orgs
 {"kotoba-lang"     {:role :language-substrate   ; kotoba 言語 — 純CLJC 言語/コアライブラリ群。全 org が消費
                     :scope :platform}
  "etzhayyim"       {:role :agent-centric        ; com-etzhayyim-* organism actors (UNSPSC/ISCO/COFOG)
                     :scope :public-interest}    ; 公益
  "gftdcojp"        {:role :human-centric        ; ai-gftd-* 製品/サービス, apps, talent
                     :scope :business}           ; ビジネス
  "com-junkawasaki" {:role :transitional-foundation ; 汎用 -clj 基盤ライブラリ + cloud 制御面 + data project
                     :scope :private-foundation  ; 言語コアは kotoba-lang へ移動済み (:path-overrides)
                     :note "汎用基盤 -clj も最終的に kotoba-lang へ全移行（ADR-2606302300, 決定 2026-06-30）。当 org は data(spirit-in-physics 等) のみへ縮退予定（cloud-manimani / local-murakumo(旧 cloud-murakumo(-fleet)) は 2026-07-02 gftdcojp へ transfer 済み、local-murakumo は 2026-07-04 に再改名 ADR-2607041302）"}}

