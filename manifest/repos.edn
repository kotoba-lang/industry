;; repos.edn — west manifest 運用の source of truth（人が編集するのはここ）。
;; scripts/gen-west-manifest.bb がこれを読んで manifest/west.yml を生成する。
;;   - project の一覧と pin(revision) は git の事実(working tree HEAD)から採る。
;;   - ポリシー(remote 定義・既定・グループ・DataLad 連携)はこの EDN で宣言する。
;;
;; 方針: コード repo は全て west 管理。plain な git submodule は廃止(0 件)。
;;       大容量データの DataLad dataset だけは west project にしつつ git-annex(B2)で
;;       実体を扱う(:datalad で印を付け、既定では取得しない opt-in グループに隔離)。
{;; org 名 -> git remote の url-base
 :remotes
 {"com-junkawasaki" "git@github.com:com-junkawasaki"
  "gftdcojp"        "git@github.com:gftdcojp"
  "etzhayyim"       "https://github.com/etzhayyim"}

 ;; 全 project 共通の既定
 :defaults
 {:revision    "main"
  :clone-depth 1}            ; CLAUDE.md の shallow 既定に準拠

 ;; west update --group-filter で選択取得。datalad は既定で無効化(opt-in)。
 :group-filter ["+com-junkawasaki" "+gftdcojp" "+etzhayyim" "-datalad"]

 ;; DataLad dataset(git-annex + B2)。west project にはするが既定では取得しない。
 ;;   実体取得/破棄は `west annex-get` / `west annex-drop`(B2 creds は環境変数)。
 :datalad
 {"orgs/gftdcojp/m365-archive"
  {:annex-remote "b2"
   :group        "datalad"   ; このグループのみ → group-filter の -datalad で既定 off
   :note "M365 アーカイブ。実体は B2、git には annex キーのみ。"}}

 ;; B2 (S3 互換) special remote 設定(非機密)。
 ;; 認証は scripts/b2-creds.bb が下記 :credentials の順で解決する(env→1Password→Keychain)。
 ;; 参照先(op:// パス / keychain service)は秘密ではないのでここに置く。実値(key/secret)は
 ;; 解決時のみ取得し、リポジトリには一切置かない。★ の値を自分の保管先に合わせて編集する。
 :b2
 {:endpoint "s3.us-west-004.backblazeb2.com"
  :type     "S3"
  :credentials
  {:order [:env :1password :keychain]   ; 揃ったソースを採用(env > 1Password > Keychain)
   ;; env: この名前の環境変数を直接使う(CI 等)
   :env {:key-id "B2_KEY_ID" :app-key "B2_APP_KEY" :bucket "B2_BUCKET"}
   ;; 1Password: op read の参照。★ vault/item/field を自分のものに。
   ;;   (このマシンの実体は Keychain 側。op を使う環境では vault/item を作って参照する)
   :1password {:key-id  "op://gftdcojp/com-junkawasaki.b2_annex/keyID"          ; ★
               :app-key "op://gftdcojp/com-junkawasaki.b2_annex/applicationKey" ; ★
               :bucket  "op://gftdcojp/com-junkawasaki.b2_annex/bucket"}        ; ★
   ;; Apple Keychain(単一アイテム方式): service=b2:<bucket> の generic-password 1 件に
   ;;   account=KEY_ID / password=APP_KEY を格納し、bucket は service 名の "b2:" 以降から導く。
   ;;   登録例:
   ;;     security add-generic-password -s b2:gftdcojp-m365-annex -a <KEY_ID> -w <APP_KEY>
   :keychain {:service  "b2:gftdcojp-m365-annex"   ; ★ keychain service(= b2:<bucket>)
              :combined true}}}                     ; account=key-id, password=app-key

 ;; kotoba-server pod（kotobase.net）接続ポリシー（非機密）。詳細は CLAUDE.md
 ;; 「Actors」節 / ai-gftd-itonami ADR-0002。認証は CACAO（SIWE/Ed25519 did:key、
 ;; kotoba-auth DelegationChain）で、**actor ごとに鍵を発行**し自分の鍵由来 IPNS
 ;; graph を所有 → 自己 mint。owner hand-off も共有 token も使わない。秘密鍵は
 ;; repo に置かず `.<actor>/identity.edn`（gitignore）に永続。ここは非機密の
 ;; 参照先・規約のみ。
 :kotoba
 {:endpoint "https://kotobase.net"
  :xrpc     "ai.gftd.apps.kotobase.datomic.*"   ; transact / q / pull / entid
  :auth     :cacao-self-issued                  ; actor が自分の did:key で自己発行
  :capabilities {:read  ["datom:read"]
                 :write ["datom:transact" "tx:create"]}
  :identity
  {:per-actor     true                          ; 1 actor = 1 Ed25519 鍵
   :path-template ".<actor>/identity.edn"       ; 例 .itonami/identity.edn（gitignore）
   :persist       :load-or-create               ; 初回生成→保存→再読込
   :graph         :key-derived-ipns             ; graph = 鍵由来 IPNS 名（k51qzi5uqu5d…）
   :note "秘密鍵は git にコミットしない。手本 ai-gftd-itonami/src/itonami/cacao.clj"}}

 ;; manifest/west.yml への変更の起こし方（非機密ポリシー）。west.yml は生成物
 ;; （repos.edn ＋ 各子repo HEAD → gen-west-manifest.bb、手書き禁止 / --check）。
 ;; superproject も shallow なので local 3-way merge は信頼できない（merge-base が
 ;; graft 境界外で "unrelated histories" / ancestry 誤判定）。詳細は
 ;; ADR-2606272237 / CLAUDE.md「## Git operations」。生成器(gen-west-manifest.bb)は
 ;; このキーを読まない（ドキュメント用の宣言）。
 :manifest-workflow
 {:canonical    :api-single-entry            ; 登録/rename/pin前進すべて API でサーバ側 commit
  :method       "tip の west.yml + blob SHA を取得 → 当該 entry の行だけ編集 → blob SHA 一致で PUT(branch,sha)"
  :conflict     :impossible-by-optimistic-lock ; tip がずれれば 409 → 取得し直してリトライ（marker 解決が出ない）
  :verify       :pin-eq-child-head           ; commit 前に pin == 子repo HEAD を確認
  :never        [:local-shallow-edit         ; ローカルで shallow 編集/merge を戦わない
                 :hand-edit-conflict-markers ; west.yml の <<<<<<< を手編集しない（手書き禁止）
                 :force-push]
  :if-must-merge {:resolve   :regenerate     ; 衝突は marker でなく再生成で解く
                  :steps     "superset 側採用 → west update で子を目的 pin に → gen-west-manifest.bb → --check"
                  :pin-regression-trap "再生成はローカル working HEAD で pin する。子が遅れていると黙ってロールバック → 再生成前に必ず west update"
                  :ancestry  "固定 depth で賭けず compare API で merge-base を狙い撃ち取得"}
  :after-api    :recheck-canonical           ; API 手編集は生成器を通らない → 落ち着いたら --check で一致確認
  :child-repos  :plain-git                    ; 子repo は普通の git(branch/PR/push)。west は pin を記録するだけ
  :note "正経路は API single-entry。実例 PR #61/#62/#86、kenchi-actor→kenchi-clj rename(34988dd)。"}

 ;; ネスト submodule を持つ project は west に再帰取得させる。
 ;; (未指定でも生成スクリプトが各 repo の .gitmodules を検出して自動付与する。
 ;;  ここは明示的に強制したい場合の上書き用。)
 :force-recurse-submodules
 #{}

 ;; 新規 project の追加口（SSoT）。west.yml にまだ path が無い repo をここに列挙すると
 ;; 生成時に既存 path 群と union される（一度 west.yml に載れば自動追従、distinct で重複排除）。
 ;; clone 済みの working tree（orgs/<org>/<repo>）が存在し HEAD を持つこと。
 :extra-projects
 #{"orgs/com-junkawasaki/freeboard"
  "orgs/com-junkawasaki/kasane"      ; ADR-2606272100: Adobe(AI/PSD/PDF) 純cljc+EDN ライブラリ
  "orgs/com-junkawasaki/org-arxiv-kotoba" ; ADR-0023: arXiv organism actor + yorishiro automation
  "orgs/etzhayyim/com-etzhayyim-sng"      ; ADR-2606290000: e-methane Sabatier SNG standalone actor
  "orgs/gftdcojp/ai-gftd-router"}}   ; ADR-2606272330: gftd.ai 生成スタジオの製品面(router/gateway)
