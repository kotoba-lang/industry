   :note "The language. The exit is the .kotoba migration (ADR-2607279200), not a library."}
  {:coordinate "org.clojure/clojurescript" :ecosystem :maven :disposition :structural
   :note "The compiler for the second-ranked runtime in CLAUDE.md's order. Not a dependency to remove."}
  {:coordinate "thheller/shadow-cljs" :ecosystem :maven :disposition :structural
   :note "Build tool. Produces JS but spawns a JVM to do it; the exit is amu's js target, not a rewrite."}
  {:coordinate "com.github.clj-easy/graal-build-time" :ecosystem :maven :disposition :structural
   :note "Native-image support for the kotoba CLI. Disappears with the JVM bootstrap, not before."}
  {:coordinate "react" :ecosystem :npm :disposition :structural
   :note "Reagent's render backend. CLAUDE.md ADR-2608260900 retires .tsx/.svelte AUTHORING, not this dependency; reagent apps keep it after migration."}
  {:coordinate "react-dom" :ecosystem :npm :disposition :structural :note "As react."}
  {:coordinate "nbb" :ecosystem :npm :disposition :structural
