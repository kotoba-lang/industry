 ;; own scope line. `:dependency-substitution/scope "orgs/kotoba-lang"` is
 ;; true and reads as completeness; the detector that counts the same debt
 ;; workspace-wide is `scripts/verify-jvm-dependency-surface.cljs`, and its
 ;; `jvm-runtime-deps` class disagrees with this file in two ways.
 {:measured-by "nbb --classpath '.:scripts/nbb_compat' scripts/verify-jvm-dependency-surface.cljs --findings orgs"
  :reporting-repos 75
  :in-this-ledgers-scope 18
  :outside-it 57
  :outside-by-org {:cloud-itonami 35 :network-awai 16 :com-junkawasaki 3
                   :etzhayyim 2 :gftdcojp 1}

