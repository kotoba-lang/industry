   :provider "12D3KooWGmq2x23J59LmqyBT5ik8pK9gEz7N3Y4vdJidezf7Usz3"
   :context "ayatori-public-arrangement-v1"
   :rotation true
   :ingestion {:index "https://cid.contact"
