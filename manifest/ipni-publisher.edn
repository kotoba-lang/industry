;; manifest/ipni-publisher.edn — the IPNI publisher identity for this workspace.
;;
;; ADR-2608160300 recorded that nothing can be announced without a
;; /p2p/{peer-id}, and named this file as the artifact that unblocks the rest
;; of the line. Owner instruction 2026-08-26 ("できるように整えていって") is the
;; authorization; the two decisions it recorded are answered below.
;;
;; This file carries PUBLIC values only. The seed is in kagi, by name.
{;; The identity that SIGNS the live head. Read off the wire, not asserted:
 ;; GET https://ipni.kotobase.net/ipni/v1/head -> {"pubkey":{"/":{"bytes": …}}},
 ;; identity-multihash that protobuf key, base58btc it. Measured 2026-08-31.
 ;;
 ;; This field was stale by two rotations until then. It named the 2026-08-27
 ;; key while the head had been signed by another since 2026-08-30, and a
 ;; fourth identity was never recorded at all -- see :identity-history. The
 ;; file that exists to say which key publishes did not know which key was
 ;; publishing, and nothing compared the two. `scripts/verify-ipni-publisher-record.cljs`
 ;; now does.
 :ipni.publisher/peer-id "12D3KooWGxKwrwhqzVDKynC6PzP3vSWC5F3JjjmaqWyTE91YBt7X"

 ;; The same Ed25519 key seen through the IPNS naming plane. Recorded so the
 ;; two derivations can be cross-checked without holding the seed: decoding
 ;; this name yields the public key the peer-id is built from.
 ;;
 ;; Derivation (verified 2026-08-31 by reproducing the PREVIOUS recorded pair
 ;; from its own peer-id before applying it to this one -- a derivation that
 ;; cannot reproduce a known-good pair may not be used to write a new one):
 ;;   multihash = 0x00 <len> <protobuf pubkey>       (identity)
 ;;   peer-id   = base58btc(multihash)
 ;;   ipns-name = "k" + base36(0x01 0x72 <multihash>) (CIDv1, libp2p-key)
 :ipni.publisher/ipns-name "k51qzi5uqu5ditqo6wh890it27iac9968e2q9jhijcqhnmfok6bmbiceqvodra"

 ;; Custody. Taken one item at a time by this identifier -- never enumerated.
 :ipni.publisher/seed-kagi-item "kotobase-ipni-publisher"
 :ipni.publisher/seed-kagi-compartment "net-kotobase"
 :ipni.publisher/seed-keychain-ref
 "keychain://com.junkawasaki.kotobase.ipni/publisher-seed-v2"
 :ipni.publisher/custody
 {:primary :kagi
  :secondary :apple-keychain
  :cloud-sync {:at "2026-08-27"
               :result :failed
               :remote-seq-still 5
               :reason :snapshot-transaction-http-500
               :local-encrypted-vault-bytes 9213145}}

 ;; Identity history, as the indexer sees it -- a LIST, not a single
 ;; :previous. It was a single rotation record and rotation happened again
 ;; twice; a field shaped `current + previous` cannot hold a third, so the
 ;; third and fourth were simply not written down.
 ;;
 ;; Measured 2026-08-31 from GET https://cid.contact/providers, filtered to
 ;; rows whose Publisher.Addrs contain ipni.kotobase.net. Every row has
 ;; Publisher.ID == AddrInfo.ID, which is the cost: each rotation minted a
 ;; new PROVIDER identity too, and a retrieval client resolves content to a
 ;; provider. The three older provider identities are the ones whose seeds
 ;; this file records as unrecoverable.
 :ipni.publisher/identity-history
 [{:peer-id "12D3KooWDscME2qEggsQYHg6d5d1Ms3Vq9duK6U15yQ64ksay2of"
   :ipns-name "k51qzi5uqu5dhontjj0tl8ezexhwh8aa265bj839qekj77b6o4fo10y3wzdeyu"
   :last-advertisement "2026-08-26T07:26:14Z"
   :provider-multiaddr "/dns4/kotobase.net/tcp/443/https"
   :custody :unrecoverable
   :recorded-at "2026-08-27"}
  {:peer-id "12D3KooWHu8JYZpEkaewiMsR2FSGYwMqsVXthdnzFyh9TQdxsRTk"
   :last-advertisement "2026-08-27T07:44:42Z"
   :provider-multiaddr "/dns4/kotobase.net/tcp/443/https"
   :custody :unverified
   :recorded-at "2026-08-31"
   :note "never recorded until the 2026-08-31 audit; no rotation entry was written for it"}
  {:peer-id "12D3KooWGmq2x23J59LmqyBT5ik8pK9gEz7N3Y4vdJidezf7Usz3"
   :ipns-name "k51qzi5uqu5dirbsrgpb1iyrwbzlqgjoq006b7hda5nr2ah4cxez8atsxwc00c"
   :last-advertisement "2026-08-27T08:13:07Z"
   :provider-multiaddr "/dns4/kotobase.net/tcp/443/https"
   :custody :unverified
   :recorded-at "2026-08-27"
   :note "this file's :ipni.publisher/peer-id until 2026-08-31"}
  {:peer-id "12D3KooWGxKwrwhqzVDKynC6PzP3vSWC5F3JjjmaqWyTE91YBt7X"
   :ipns-name "k51qzi5uqu5ditqo6wh890it27iac9968e2q9jhijcqhnmfok6bmbiceqvodra"
   :last-advertisement "2026-08-30T13:38:50Z"
   :provider-multiaddr "/dns4/ipfs.kotobase.net/tcp/443/https"
   :custody :unverified
