;; manifest/ipni-publisher.edn — the IPNI publisher identity for this workspace.
;;
;; ADR-2608160300 recorded that nothing can be announced without a
;; /p2p/{peer-id}, and named this file as the artifact that unblocks the rest
;; of the line. Owner instruction 2026-08-26 ("できるように整えていって") is the
;; authorization; the two decisions it recorded are answered below.
;;
;; This file carries PUBLIC values only. The seed is in kagi, by name.
{:ipni.publisher/peer-id "12D3KooWGmq2x23J59LmqyBT5ik8pK9gEz7N3Y4vdJidezf7Usz3"

 ;; The same Ed25519 key seen through the IPNS naming plane. Recorded so the
 ;; two derivations can be cross-checked without holding the seed: decoding
 ;; this name yields the public key the peer-id is built from.
 :ipni.publisher/ipns-name "k51qzi5uqu5dirbsrgpb1iyrwbzlqgjoq006b7hda5nr2ah4cxez8atsxwc00c"

 ;; Custody. Taken one item at a time by this identifier -- never enumerated.
 :ipni.publisher/seed-kagi-item "kotobase-ipni-publisher"
 :ipni.publisher/seed-kagi-compartment "net-kotobase"
 :ipni.publisher/seed-keychain-ref
 "keychain://com.junkawasaki.kotobase.ipni/publisher-seed-v2"
 :ipni.publisher/custody
 {:primary :kagi
  :secondary :apple-keychain
  :cloud-sync {:at "2026-08-27"
               :result :failed
               :remote-seq-still 5
               :reason :snapshot-transaction-http-500
               :local-encrypted-vault-bytes 9213145}}

 ;; Rotation record. The 2026-08-26 key was absent from both the 2026-08-27
 ;; local vault and cloud snapshot seq 5, so retaining its public identifier
 ;; would claim custody that no process could prove. The old advertisements
 ;; remain immutable and crawlable; the new provider appends to their shared
 ;; publisher DAG and signs every new advertisement with this identity.
 :ipni.publisher/identity-rotation
 {:at "2026-08-27"
  :reason :prior-seed-unrecoverable
  :previous-peer-id "12D3KooWDscME2qEggsQYHg6d5d1Ms3Vq9duK6U15yQ64ksay2of"
  :previous-ipns-name "k51qzi5uqu5dhontjj0tl8ezexhwh8aa265bj839qekj77b6o4fo10y3wzdeyu"
  :local-vault :absent
  :cloud-vault {:seq 5 :result :absent}
  :migration :append-cross-provider-chain}

 ;; Decision 1 of ADR-2608160300: ONE key for the workspace, not one per
 ;; surface. Twelve keys is a key set managed by enumeration whether anyone
 ;; admits it or not, and the safety floor is explicit that credentials are
 ;; taken one at a time by known identifier. Same reasoning as the appview
 ;; catalog's one-name-not-four-hundred.
 :ipni.publisher/scope :one-key-for-the-workspace

 ;; Decision 2: IPNI is a PUBLISHING DISCIPLINE for every surface that puts a
 ;; CID into the world, not a feature of pinning. Measured 2026-08-26: 435 of
 ;; 510 kotoba.app.edn manifests carry a bundle CID, and none of them is a
 ;; pin -- they are archive objects. Making IPNI a pinning feature would put
 ;; the largest addressed corpus in the workspace permanently out of reach of
 ;; the discovery plane.
 :ipni.publisher/discipline :every-surface-that-publishes-cids

 ;; Where the indexer GETs the advertisement chain. Anonymous by construction:
 ;; cid.contact crawls without credentials, so a publisher behind auth can
 ;; never be read (pinning.kotobase.net answers 401 and always will).
 :ipni.publisher/publisher-origin "https://ipni.kotobase.net"

 ;; Where the bytes are. `kotobase.net` became advertisable on 2026-08-26:
 ;; the path gateway now answers a block request with the block, and the
 ;; bytes it returns were fetched and re-hashed to the CID that was asked
 ;; for. A subdomain gateway is for website origin isolation, not for block
 ;; retrieval, so ipfs.kotobase.net being broken does not block this.
 :ipni.publisher/retrieval-candidates
 [{:host "kotobase.net"
   :multiaddr "/dns4/kotobase.net/tcp/443/https"
   :status :ready
   :verified
   {:at "2026-08-26"
    :worker-version "4ce297ca-035c-4f41-b887-39879b68ce95"
    :how "GET /ipfs/{cid}?format=raw and Accept: application/vnd.ipld.raw both answered 200 application/vnd.ipld.raw; the returned bytes were re-hashed and reproduced the requested CID for a 4,778-byte and a 944,524-byte object; HEAD answered 200 where it used to answer 404"}}
  {:host "ipfs.kotobase.net"
   :multiaddr "/dns4/ipfs.kotobase.net/tcp/443/https"
   :status :broken-but-not-on-the-ipni-path}]

 ;; Measured 2026-08-26. Two were fixed the same day; the third turned out
 ;; not to be on this path at all. An advertisement naming an address that
 ;; cannot serve a verifiable block is worse than no advertisement: the
 ;; indexer answers, the fetch fails, and the failure is attributed to IPFS
 ;; rather than to us. So these were measured before anything was signed.
 :ipni.publisher/blockers
 [{:blocker :raw-format-ignored
   :measured "2026-08-26"
   :status :fixed
   :detail "GET /ipfs/{cid}?format=raw and Accept: application/vnd.ipld.raw returned the content-type the object was PUT with (text/html for isic-5110, application/octet-stream for the cloud.itonami.app bundle). Fixed in net-kotobase/control-plane 6886225e and deployed; both now answer application/vnd.ipld.raw."
   :owner "net-kotobase/control-plane"}
  {:blocker :head-unsupported
   :measured "2026-08-26"
   :status :fixed
   :detail "HEAD /ipfs/{cid} answered 404 while GET of the same URL answered 200, so a probing client concluded the object was absent. Same commit; HEAD now carries the status and headers of the GET with no body, and is not counted as a free serve."
   :owner "net-kotobase/control-plane"}
  {:blocker :subdomain-gateway-unreachable
   :measured "2026-08-26"
   :status :not-on-this-path
   :detail "ipfs.kotobase.net/ipfs/{cid} 301s to {cid}.ipfs.kotobase.net, which answers 502 after ~28s -- TLS and DNS are fine (the certificate does carry *.ipfs.kotobase.net), the Worker simply cannot reach the archive store the control plane writes to. Block retrieval uses the path gateway, so this does not block advertising; it is a real defect of that host and is recorded here so it is not rediscovered."
   :owner "net-kotobase/ipfs"}]

 ;; Published 2026-08-26. Two advertisements: one CID to prove the path,
 ;; then the corpus. The chain links back -- an indexer walks BACK from a
 ;; head, so a second advertisement with no PreviousID orphans the first.
