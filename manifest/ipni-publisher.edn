 ;; Measured 2026-08-26. Two were fixed the same day; the third turned out
 ;; not to be on this path at all. An advertisement naming an address that
 ;; cannot serve a verifiable block is worse than no advertisement: the
 ;; indexer answers, the fetch fails, and the failure is attributed to IPFS
 ;; rather than to us. So these were measured before anything was signed.
 :ipni.publisher/blockers
 [{:blocker :raw-format-ignored
   :measured "2026-08-26"
   :status :fixed
   :detail "GET /ipfs/{cid}?format=raw and Accept: application/vnd.ipld.raw returned the content-type the object was PUT with (text/html for isic-5110, application/octet-stream for the cloud.itonami.app bundle). Fixed in net-kotobase/control-plane 6886225e and deployed; both now answer application/vnd.ipld.raw."
   :owner "net-kotobase/control-plane"}
  {:blocker :head-unsupported
   :measured "2026-08-26"
   :status :fixed
   :detail "HEAD /ipfs/{cid} answered 404 while GET of the same URL answered 200, so a probing client concluded the object was absent. Same commit; HEAD now carries the status and headers of the GET with no body, and is not counted as a free serve."
   :owner "net-kotobase/control-plane"}
  {:blocker :subdomain-gateway-unreachable
   :measured "2026-08-26"
   :status :not-on-this-path
   :detail "ipfs.kotobase.net/ipfs/{cid} 301s to {cid}.ipfs.kotobase.net, which answers 502 after ~28s -- TLS and DNS are fine (the certificate does carry *.ipfs.kotobase.net), the Worker simply cannot reach the archive store the control plane writes to. Block retrieval uses the path gateway, so this does not block advertising; it is a real defect of that host and is recorded here so it is not rediscovered."
   :owner "net-kotobase/ipfs"}]

