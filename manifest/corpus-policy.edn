;; manifest/corpus-policy.edn — 学習コーパスの**手書きの唯一の面**（ADR-2608056000）。
;;
;; ここに書くのは repo の中身から導出できないものだけ:
;;   - 何を軸として測るか、その重み
;;   - tier の閾値
;;   - hazard パターン（何を「訓練に入れてはいけない」と見なすか）
;;   - consent scope（誰に見せてよい本文か）
;;   - bytes plane の宛先（DataLad dataset）
;;
;; **スコアそのもの・索引・shard は生成物**（`scripts/gen-training-corpus.cljs`）。
;; 手で書かない。手書きの索引は必ず腐る（`gen-concept-index.cljs` と同じ理由）。
;;
;; ## なぜ LLM judge を使わないか
;;
;; `90-docs/design-quality/` の実測（ADR-2607132300）: 3-judge panel が 4 ライブラリを
;; 軒並み 4.0–5.0/5 と採点した裏で、tap-target・dvh fallback・safe-area・theme-color の
;; 4 つの具体的欠落を 3 体とも一つも指摘しなかった。**採点が学習データの選別を決める**
;; 以上、再現しない採点器は「劇場」ではなく汚染源になる。ここは全軸 regex/構造ベースで、
;; 同じ入力に同じ数値を返す。
;;
;; ## 合成は幾何平均
;;
;; tamaki ADR-0002 の lineage vitality と同じ理由 —— **弱い次元を他の次元で埋めさせない**。
;; 算術平均だと「証拠ゼロだが具体的な数字だけ多い文書」が通ってしまう。

{:policy/id "training-corpus/v1"
 :policy/adr "adr-2608056000-training-corpus-edn-datalad-scored-documents"

 ;; ---------------------------------------------------------------------------
 ;; 走査対象。**glob ではなくディレクトリ + 拡張子**で書く（glob は「何が入って
 ;; いないか」を読み手が言えない）。
 :scan
 {:roots [{:root/path "90-docs/adr"      :root/kind :adr      :root/ext [".edn"]}
          {:root/path "90-docs"          :root/kind :doc-md   :root/ext [".md"]}
          {:root/path "manifest"         :root/kind :manifest :root/ext [".edn"]}]
  ;; 生成物は入れない —— 生成器の出力を学習して生成器を書き直す循環を作らない。
  :exclude-paths ["90-docs/corpus/corpus.datoms.edn"
                  "90-docs/concept/concept.datoms.edn"
                  "90-docs/surface/surface.datoms.edn"
                  "manifest/west.yml"
                  "manifest/schema.edn"
                  "manifest/fleet-db.edn"
                  "manifest/fleet-db.ledger.edn"
                  "manifest/fleet-ci.edn"
                  "manifest/repo-maturity.edn"
                  "manifest/repo-taxonomy.edn"]
  ;; **自分の sha256 を含むファイルを採点しない。** projection contract は
  ;; corpus.datoms.edn の sha256 を pin する。それを採点対象に入れると
  ;; 「contract を書く → corpus が変わる → contract が stale → contract を直す →
  ;; corpus が変わる」の循環になり、**固定点が存在しない**（実測 2026-08-05、
  ;; contract を足した瞬間に発見）。schema は corpus の内容に依存しないので対象のまま。
  :exclude-prefixes ["manifest/projections/"]
  :max-bytes 4194304}   ;; 1 文書 4 MiB 超は :oversize として skip（数を申告する）

 ;; ---------------------------------------------------------------------------
 ;; 軸と重み。合計は正規化されるので絶対値に意味は無い（比だけが効く）。
 :axes
 [{:axis/id :evidence        :axis/weight 3.0
   :axis/doc "実測・検証の痕跡。この workspace の文書規約が最も強く要求するもの。"}
  {:axis/id :specificity     :axis/weight 2.0
   :axis/doc "具体的識別子（path / sha / URL / 単位付き数値）の密度。"}
  {:axis/id :structure       :axis/weight 2.0
   :axis/doc "必須属性・見出し構造が揃っているか。"}
  {:axis/id :provenance      :axis/weight 1.5
   :axis/doc "誰がいつ決めたか、何に関連するか。"}
  {:axis/id :currency        :axis/weight 1.5
   :axis/doc "現在値か（accepted > proposed > superseded）。"}
  {:axis/id :self-containment :axis/weight 1.0
   :axis/doc "単体で読めるか。ポインタだけの文書は学習素材にならない。"}]

 ;; ε: 幾何平均で log(0) を避ける床。0 の軸があれば composite はここまで落ちる。
 :epsilon 0.02
 ;; 決定論のため小数を丸める桁数（浮動小数の末尾差で sha256 が揺れるのを防ぐ）。
 :round-digits 4

 ;; ---------------------------------------------------------------------------
 ;; 軸ごとのパラメータ
 ;; ⚠ 正規表現は **JS の RegExp** として組む（nbb = ClojureScript on Node）。
;; JS は `(?m)` `(?i)` のインライン修飾子を受け付けないので、フラグは
;; `:re/flags` に分けて書く。行頭は `(^|\n)` で表す。
 :evidence-markers
 {:regexes [{:id :measured      :re "実測|実際に|measured|verified"}
            {:id :verification  :re "(^|\\n)#+\\s*(Verification|検証|Evidence)"}
            {:id :tests         :re "\\b\\d+\\s+(tests?|assertions?)\\b|tests? green|Ran \\d+ tests"}
            {:id :code-block    :re "```"}
            {:id :file-line     :re "[A-Za-z0-9_./-]+\\.(clj[cs]?|cljs|edn|md|yml|kotoba|py|rs|ts|js):\\d+"}
            {:id :commit-sha    :re "\\b[0-9a-f]{7,40}\\b"}
            {:id :counterexample :re "落ちる|fail|失敗|誤り|gap|欠落"}]
  ;; distinct なマーカー種の数 / この値 で 0..1（種類の多様性を見る。同じ語の連呼を数えない）
  :saturation 6}

 :specificity
 {:regexes [{:id :path  :re "[A-Za-z0-9_-]+/[A-Za-z0-9_./-]+\\.[a-z]{2,6}"}
            {:id :url   :re "https?://[^\\s\")]+"}
            {:id :hex   :re "\\b[0-9a-f]{12,}\\b"}
            {:id :unit  :re "\\b\\d[\\d,._]*\\s*(件|行|回|台|ms|s|MB|GB|KiB|MiB|KB|%|USD|JPY|tokens?)\\b"}
            {:id :ident :re "[a-z][a-z0-9-]*/[a-z][a-z0-9-]*"}]
  ;; 1 KiB あたりのヒット数がこの値に達したら 1.0
  :saturation-per-kib 10.0}

 :structure
 {:adr-required-attrs [:adr/id :adr/title :adr/status :adr/body :adr/date]
  :md-heading-re "(^|\\n)#\\s+"
  :md-section-re "(^|\\n)##\\s+"
  :md-sections-saturation 3}

 :provenance
 {:adr-attrs [:adr/deciders :adr/date :adr/related :adr/last_verified]
  :md-date-re "\\b20\\d{2}[-/年]\\d{1,2}[-/月]\\d{1,2}"}

 :currency
 {:status-scores {"accepted" 1.0 "implemented" 1.0 "active" 0.9
                  "proposed" 0.6 "draft" 0.5 "superseded" 0.3
                  "rejected" 0.2 "deprecated" 0.2}
  ;; status 文字列は自由記述（例 "accepted, implemented (mangaka-side); …"）なので
  ;; **前方一致ではなく含有**で最初にヒットした語を採る。順序が意味を持つ。
  :match-order ["superseded" "rejected" "deprecated" "proposed" "draft"
                "accepted" "implemented" "active"]
  :unknown 0.5}

 :self-containment
 {:min-bytes 800        ;; これ未満は線形に減点（ポインタ文書）
  :ideal-bytes 3000     ;; ここで 1.0
  :decay-bytes 200000}  ;; これを超えると緩やかに減点（1 文書としては大きすぎる）

 ;; ---------------------------------------------------------------------------
 ;; tier。hazard があれば score に関係なく :excluded。
 :tiers
 [{:tier/id :gold   :tier/min-score 0.70}
  {:tier/id :silver :tier/min-score 0.50}
  {:tier/id :bronze :tier/min-score 0.0}]

 ;; ---------------------------------------------------------------------------
 ;; hazard —— 「訓練に入れてはいけない」の構造的定義。
 ;;
 ;; ⚠ **これは秘密が無いことの証明ではない。** 形が既知のものだけを弾く構造検査で、
 ;; 意味的な機密（未公開の交渉内容・他者の個人情報の散文記述）は検出しない。
 ;; 公開先を広げる判断は、この検査の合格を根拠にしてはならない。
 :hazards
 [{:hazard/id :private-key      :hazard/re "-----BEGIN [A-Z ]*PRIVATE KEY-----"}
  {:hazard/id :openai-key       :hazard/re "\\bsk-[A-Za-z0-9]{20,}"}
  {:hazard/id :github-token     :hazard/re "\\bgh[pousr]_[A-Za-z0-9]{30,}"}
  {:hazard/id :aws-key          :hazard/re "\\bAKIA[0-9A-Z]{16}\\b"}
  {:hazard/id :google-key       :hazard/re "\\bAIza[0-9A-Za-z_-]{30,}"}
  {:hazard/id :slack-token      :hazard/re "\\bxox[abpsr]-[A-Za-z0-9-]{10,}"}
  {:hazard/id :b2-app-key       :hazard/re "\\bK00[0-9A-Za-z+/]{28,}"}
  {:hazard/id :inline-password  :hazard/re "(password|passphrase|secret)\\s*[:=]\\s*[\"'][^\"'\\s]{8,}[\"']"
   :hazard/re-flags "i"}]
 ;; 個人メールアドレスがこの数を超えて出てくる文書は :pii-email-cluster として除外。
 ;; owner 自身のアドレスは deciders 欄に必ず出るので数に入れない。
 :pii
 {:email-re "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}"
  :allow ["root@junkawasaki.com" "noreply@anthropic.com"]
  :max-distinct 3}

 ;; ---------------------------------------------------------------------------
 ;; consent scope。**既定は :workspace-internal** —— 公開は明示した path だけ。
 ;; 「公開 repo に置いてあるから公開してよい」ではない（ADR-2608039700:
 ;; 公開 repo + 暗号化 annex は本文の秘匿であって metadata の秘匿ではない）。
 :consent
 {:default :workspace-internal
  :rules [{:path-prefix "90-docs/adr/" :consent :workspace-internal}
          {:path-prefix "manifest/"    :consent :workspace-internal}]}

 ;; ---------------------------------------------------------------------------
 ;; bytes plane。**shard は git に入れない**（ADR-2608039700: large EDN shard は annex）。
 ;; ここが宛先の宣言で、実際に custody があるかは**この面が申告しない** ——
 ;; 証明は `scripts/annex-custody-verify.cljs`（off-machine copy の存在 +
 ;; remote から読み戻しての checksum）だけが持つ。索引は自分の保管を自称しない。
 ;;
 ;; **宛先は com-junkawasaki 自前の dataset**（オーナー判断 2026-08-05）。当初は
 ;; 既存の `gftdcojp/gftd-llm-dataset` を指していたが、あれは外部コーパス
 ;; （HF / CommonCrawl / Hume）を license gate 付きで集める **別 org の** dataset で、
 ;; こちらは com-junkawasaki の `:workspace-internal` な文書。custody は所有に従わせる。
 :bytes-plane
 {:dataset/id "com-junkawasaki/training-corpus"
  :dataset/path "orgs/com-junkawasaki/training-corpus"
  :dataset/subdir "corpus/workspace-docs"
  :annex/backend "SHA256"
  :annex/special-remote "b2"
  :shard/tiers [:gold :silver]
  ;; 生成した shard を置くローカル作業ディレクトリ（git 管理外）。
  :build/out-dir ".corpus-shards"}

 ;; ---------------------------------------------------------------------------
 ;; query plane への露出。`manifest/edn-query.cljs` がこの値で datom に印を付ける。
 :query
 {:source/dataset "training-corpus"
  :join-keys [{:key :corpus/adr-id :joins "adr/id"}
              {:key :corpus/repo   :joins "repo/path (repo-taxonomy)"}]}}
