[{:db/id -1
  :manifest.west-triple-sync/id :com-junkawasaki.root/west-triple-sync
  :manifest.west-triple-sync/version 1
  :manifest.west-triple-sync/updated "2026-07-19"
  :manifest.west-triple-sync/adr "2607173200"
  :manifest.west-triple-sync/purpose "Keep GitHub remotes, local orgs/*/* checkouts, and west.yml pins consistent and current for a managed project set — without wholesale west regen or mass clone."
  :manifest.west-triple-sync/planes
  [{:id :github :role "content upstream (default branch commits)"}
   {:id :west :role "path + pin projection (repos.edn :extra-projects + gen-west-manifest --entry)"}
   {:id :local :role "working tree under orgs/<org>/<repo>"}]
  :manifest.west-triple-sync/invariant
  "For each managed P: GitHub repo exists; west has path+revision reachable from default branch; if local exists it matches pin after apply (or pin advances to pushed HEAD); if any deps.edn :local/root targets P then local(P) exists."
  :manifest.west-triple-sync/scopes
  [{:id :blocking
    :includes "projects from west-orphan-audit :local-root-broken"
    :default true
    :note "Highest priority — fresh checkout breakers"}
   {:id :managed
    :includes "west paths that already have a local checkout"
    :note "Daily pin/local freshness; does not clone the whole fleet"}
   {:id :names
    :includes "explicit --names a,b,c (basename or orgs/org/name)"
    :note "Surgical repairs"}]
  :manifest.west-triple-sync/never
  ["wholesale gen-west-manifest commit"
   "re-register path-override old paths"
   "register orgs/personal/*"
   "force checkout over dirty WIP"
   "force-push / rebase to align pins"
   "clone all west projects by default"
   "pin unpushed local HEAD"]
  :manifest.west-triple-sync/workflow
  [{:step :discover
    :commands ["nbb scripts/west-orphan-audit.cljs --edn"
               "enumerate west paths ∩ local dirs"
               "optional: gh compare pin...default-branch for freshness"]
    :outputs [:local-root-broken :true-orphan-git :path-override-leftover
              :missing-local-for-managed :stale-pins]}
   {:step :plan-actions
    :ops [:clone :register :west-update :fetch-ff :pin-entry :report-retarget]
    :ordering [:clone-or-west-update :register :fetch-ff :pin-entry :verify]}
   {:step :apply
    :guard "require --apply; skip dirty trees; skip missing GitHub; skip unpushed HEAD for pin"
    :register ["surgical insert into manifest/repos.edn :extra-projects"
               "preserve escaped quotes when inserting into the EDN blob string"
               "nbb scripts/gen-west-manifest.cljs --entry <name>"]
    :clone ["git clone <url> orgs/<org>/<name>  ;; full history — shallow retired 2026-07-21, ADR-2607211600"]
    :align ["git fetch origin"
            "git merge --ff-only origin/<default> when clean"
            "gen-west-manifest --entry when HEAD is on origin"]}
   {:step :verify
    :commands ["nbb scripts/west-orphan-audit.cljs --blocking"
               "nbb scripts/verify-west-pins.cljs --only <names>"
               "nbb scripts/gen-west-manifest.cljs --check  ;; when full canonical check needed"]
    :exit "0 only when blocking edges are gone for the scope and pins verify"}]
  :manifest.west-triple-sync/commands
  {:plan "nbb scripts/west-triple-sync.cljs plan [--scope blocking|managed|names] [--names a,b]"
   :apply "nbb scripts/west-triple-sync.cljs apply --scope <s> [--names a,b] [--no-pin-advance]"
   :verify "nbb scripts/west-triple-sync.cljs verify [--scope blocking|managed|names] [--names a,b]"}
  :manifest.west-triple-sync/classification-ref "scripts/west-orphan-audit.cljs / manifest/cleanup-workflow.edn :west-orphan"
  :manifest.west-triple-sync/fleet
  "west.yml writes via --entry are absorbed into fleet-db by CI fleet-projection-verify (ADR-2607160005). Do not hand-edit fleet-db/ledger/head."}]
