[{:manifest.cleanup-workflow/purpose "Run cleanup for unmerged branches, PRs, worktrees, stashes, and merge conflicts without losing owner WIP.", :manifest.cleanup-workflow/commands "{:repo-discovery [\"find . -path './orgs/personal/takeout' -prune -o -path './orgs/personal/drive' -prune -o -name .git -prune -print\" \"git worktree list --porcelain\" \"git branch --show-current\" \"git stash list\" \"git status --short --branch\"], :github-pr [\"gh pr list --state open --json number,title,headRefName,baseRefName,url,mergeable,statusCheckRollup\" \"gh pr create --base main --head <branch> --title cleanup --body cleanup\" \"gh pr view <number> --json number,state,mergeable,statusCheckRollup,url\" \"gh api -X PUT repos/<owner>/<repo>/pulls/<number>/merge -f merge_method=merge\"], :shallow-merge-base [\"BASE=$(gh api repos/<owner>/<repo>/compare/main...<branch> --jq .merge_base_commit.sha)\" \"git fetch --depth 1 origin \\\"$BASE\\\"\"], :west-regenerate [\"nbb scripts/gen-west-manifest.cljs\" \"nbb scripts/gen-west-manifest.cljs --check\"], :conflict-inspection [\"git diff --name-only --diff-filter=U\" \"rg -n '<<<<<<<|=======|>>>>>>>' <paths>\" \"git diff --stat -- <paths>\" \"git diff -- <paths>\"]}", :manifest.cleanup-workflow/workflow "[{:step :inspect, :goal \"Build an inventory before changing anything.\", :actions [:run-repo-discovery :list-open-prs :identify-dirty-files :identify-untracked-repos :identify-stashes]} {:step :classify, :goal \"Separate mergeable work from WIP and invalid targets.\", :outcomes [{:case :branch-has-unmerged-work, :next :prepare-clean-pr} {:case :stash-only, :next :report-or-apply-carefully} {:case :remote-missing-or-empty-placeholder, :next :report-blocked} {:case :generated-file-dirty, :next :regenerate-or-preserve}]} {:step :prepare-clean-pr, :goal \"Avoid stale branch conflicts by replaying needed commits onto current main.\", :actions [{:type :prefer, :commands [\"git fetch --depth 1 origin main\" \"git switch -c cleanup-<date> origin/main\"]} {:type :replay, :commands [\"git cherry-pick <needed-commit>\" \"or apply the small diff manually if shallow ancestry causes add/add conflicts\" \"do not switch to rebase to solve stale branch conflicts\"]} {:type :commit, :commands [\"git add <resolved-files>\" \"git commit -m cleanup  ;; Co-Authored-By trailer は実行中のハーネス既定の規約に従う\"]}]} {:step :resolve-conflicts, :goal \"Resolve conflicts deliberately, file class by file class.\", :rules [{:files [\"manifest/west.yml\"], :resolution \"Do not edit markers. Resolve source files first, then run nbb scripts/gen-west-manifest.cljs and --check.\"} {:files [\"manifest/repos.edn\" \"deps.edn\" \"*.edn\"], :resolution \"Keep both logically distinct additions. Validate with clojure.edn/babashka readers when practical.\"} {:files [\"*.md\" \"CLAUDE.md\" \"manifest/README.md\"], :resolution \"Preserve current main policy, add only the missing new procedure/reference text.\"} {:files [\"stash pop conflicts\"], :resolution \"If pop would overwrite dirty files, abort is correct. Leave stash intact, inspect stash patch, then decide whether to apply manually or ask.\"}]} {:step :verify, :goal \"Run narrow verification before pushing.\", :actions [\"rg -n '<<<<<<<|=======|>>>>>>>' <changed-files> || true\" \"nbb scripts/gen-west-manifest.cljs --check\" \"run domain-specific scripts touched by the change, e.g. nbb scripts/kotoba-boundary-audit.cljs\"]} {:step :publish-and-merge, :goal \"Create PR, inspect checks, merge only when mergeable.\", :actions [\"git push origin <branch>\" \"gh pr create --base main --head <branch> --title cleanup --body cleanup\" \"gh pr view <number> --json mergeable,statusCheckRollup\" \"If checks fail because jobs did not start due to billing/spending limit, note that it is external to code.\" \"Merge through gh pr merge or GitHub API if local worktree layout blocks gh pr merge.\"]} {:step :final-report, :goal \"Leave a clear inventory of what remains.\", :actions [\"gh pr list --state open --json number,title,headRefName,baseRefName,url\" \"git worktree list --porcelain\" \"git branch --show-current\" \"git stash list\" \"git status --short -- <relevant-paths>\" \"Report untracked placeholder repos, preserved stashes, and any remote branches intentionally left.\"]}]", :manifest.cleanup-workflow/skill "{:name \"git-cleanup-conflict\", :path \"~/.codex/skills/git-cleanup-conflict/SKILL.md\", :reference-md \"manifest/cleanup-workflow.md\"}", :manifest.cleanup-workflow/id :com-junkawasaki.root/cleanup-workflow, :manifest.cleanup-workflow/west-conflict "{:generated-file \"manifest/west.yml\", :source-files [\"manifest/repos.edn\" \"scripts/gen-west-manifest.cljs\" \"child repo HEADs\"], :never [\"hand-edit conflict markers in manifest/west.yml\" \"accept a generated west.yml side without validating child repo HEADs\" \"force-push a stale manifest branch\"], :resolution [\"Resolve manifest/repos.edn and generator changes first.\" \"Ensure child repos are checked out at the intended pins.\" \"Run nbb scripts/gen-west-manifest.cljs.\" \"Run nbb scripts/gen-west-manifest.cljs --check.\" \"Review only the intended entries changed in manifest/west.yml.\"]}", :manifest.cleanup-workflow/stash-pop "{:safe-default \"Run git stash pop only when the working tree files touched by the stash are clean.\", :if-overwrite-error [{:action :do-not-drop-stash, :reason \"Git keeps the stash entry on failed pop; preserve it.\"} {:action :inspect-current-diff, :commands [\"git diff --stat -- <paths>\" \"git diff -- <paths>\"]} {:action :inspect-stash, :commands [\"git stash show --stat stash@{0}\" \"git show 'stash@{0}' -- <paths>\"]} {:action :choose-resolution, :options [:apply-manually-if-independent :commit-current-work-first :stash-current-work-with-new-message :ask-if-pin-or-generated-output-would-regress]}]}", :manifest.cleanup-workflow/version 2, :db/id -1, :manifest.cleanup-workflow/principles "[{:id :preserve-wip, :rule \"Never discard owner WIP. Preserve dirty files and untracked repos with stash or explicit report.\"} {:id :no-force-push, :rule \"Do not use force-push or history rewrite on shared branches.\"} {:id :no-rebase, :rule \"Do not use rebase as the default conflict or divergence resolver. If a branch cannot fast-forward, create a clean branch/worktree from current origin/main and replay only the needed commits or patch.\"} {:id :main-first, :rule \"Prefer a branch created from current origin/main over fighting a stale shallow branch.\"} {:id :generated-west, :rule \"manifest/west.yml is generated. Resolve conflicts by choosing a side for source files, then regenerate; do not hand-edit conflict markers.\"} {:id :structured-before-text, :rule \"Use EDN/source-of-truth files and generators before ad hoc line edits.\"} {:id :worktree-per-agent, :rule \"Agents work in per-task worktrees outside the superproject root (sparse checkout for speed); the main superproject checkout is integration/read-only. See CLAUDE.md § 並行エージェント運用.\"} {:id :no-stash-accumulation, :rule \"Park WIP as commits on a session branch, not in stash. Stash is only an emergency preserve for someone else's uncommitted WIP found in the shared checkout, and must be retired via :retirement afterwards.\"}]", :manifest.cleanup-workflow/triggers ["cleanup" "stash pop" "PR/merge が残っている" "merge conflict を丁寧に解く" "worktree/branch/stash を整理する"], :manifest.cleanup-workflow/retirement "{:purpose \"Drain accumulated stashes and local branches without losing work. Verified 2026-07-02: 20 stashes + 8 branches drained, 2 unlanded items rescued.\", :snapshot {:rule \"Concurrent sessions shift stash indices. Snapshot `git stash list --format='%H %gs'` once; before every drop, re-resolve each SHA to its current index.\"}, :classify {:method :content-containment, :rule \"Judge by content, not patch-id or shallow ancestry. Exclude generated files (manifest/west.yml) — stashed generated content is disposable. For each remaining file, test whether every added line of the stash diff exists in current main's version.\", :outcomes [{:case :all-lines-present, :verdict :landed, :action :archive-and-drop} {:case :only-comment-lines-missing, :verdict :landed-reworded, :action :archive-and-drop} {:case :later-round-of-same-series-landed, :verdict :superseded, :action :archive-and-drop} {:case :substantive-lines-missing, :verdict :unlanded, :action :rescue-to-branch}]}, :archive {:location \".git/stash-archive-<date>/\", :rule \"Before dropping anything, export each stash as `git diff <sha>^ <sha>` patch (plus stash^3 untracked list when present) and an index.txt of `SHA | message`. Branch archives (diff vs main + commit log) go under branches/. Makes retirement reversible without relying on reflog/gc.\"}, :rescue {:rule \"Rescue unlanded content to a pushed branch, never back into a stash. Build in a sparse worktree outside the superproject; apply with `git apply -3 --include=<path>`; merge stays owner's call.\", :commands [\"git worktree add --no-checkout -b stash-rescue-<date> /tmp/root-stash-rescue origin/main\" \"git sparse-checkout set --no-cone <paths> && git checkout\" \"git apply -3 --include='<path>' <archive>/<sha>.patch\" \"git commit && git push origin stash-rescue-<date>\"]}, :branches {:rule \"Same discipline per branch: ancestor-of-main → delete; else content containment; unrelated-history branches → remote-preservation check (tip commit exists in successor repo via gh api). Archive first, then `git branch -D`.\", :deepen-first \"git fetch --shallow-since=<date> origin main  ;; do not trust shallow ancestry\", :never-delete [\"git-annex\" \"branches another session is actively using\"]}}", :manifest.cleanup-workflow/updated "2026-07-02"}]