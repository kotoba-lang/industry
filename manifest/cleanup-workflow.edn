[{:manifest.cleanup-workflow/purpose "Run cleanup for unmerged branches, PRs, worktrees, stashes, and merge conflicts without losing owner WIP.", :manifest.cleanup-workflow/commands "{:repo-discovery [\"find . -path './orgs/personal/takeout' -prune -o -path './orgs/personal/drive' -prune -o -name .git -prune -print\" \"git worktree list --porcelain\" \"git branch --show-current\" \"git stash list\" \"git status --short --branch\"], :github-pr [\"gh pr list --state open --json number,title,headRefName,baseRefName,url,mergeable,statusCheckRollup\" \"gh pr create --base main --head <branch> --title cleanup --body cleanup\" \"gh pr view <number> --json number,state,mergeable,statusCheckRollup,url\" \"gh api -X PUT repos/<owner>/<repo>/pulls/<number>/merge -f merge_method=merge\"], :west-orphan-audit [\"nbb scripts/west-orphan-audit.cljs\" \"nbb scripts/west-orphan-audit.cljs --blocking\" \"nbb scripts/west-orphan-audit.cljs --all\"], :merge-base [\"BASE=$(gh api repos/<owner>/<repo>/compare/main...<branch> --jq .merge_base_commit.sha)\" \"git fetch origin \\\"$BASE\\\"  ;; full history default (ADR-2607211600) resolves this directly; API compare is a defense-in-depth cross-check\"], :west-regenerate [\"nbb scripts/gen-west-manifest.cljs\" \"nbb scripts/gen-west-manifest.cljs --check\"], :conflict-inspection [\"git diff --name-only --diff-filter=U\" \"rg -n '<<<<<<<|=======|>>>>>>>' <paths>\" \"git diff --stat -- <paths>\" \"git diff -- <paths>\"]}", :manifest.cleanup-workflow/workflow "[{:step :inspect, :goal \"Build an inventory before changing anything.\", :actions [:run-repo-discovery :list-open-prs :identify-dirty-files :identify-untracked-repos :identify-stashes :run-west-orphan-audit]} {:step :classify, :goal \"Separate mergeable work from WIP and invalid targets.\", :outcomes [{:case :branch-has-unmerged-work, :next :prepare-clean-pr} {:case :stash-only, :next :report-or-apply-carefully} {:case :remote-missing-or-empty-placeholder, :next :report-blocked} {:case :generated-file-dirty, :next :regenerate-or-preserve}]} {:step :prepare-clean-pr, :goal \"Avoid stale branch conflicts by replaying needed commits onto current main.\", :actions [{:type :prefer, :commands [\"git fetch origin main\" \"git switch -c cleanup-<date> origin/main\"]} {:type :replay, :commands [\"git cherry-pick <needed-commit>\" \"or apply the small diff manually if it turns into add/add conflicts\" \"do not switch to rebase to solve stale branch conflicts\"]} {:type :commit, :commands [\"git add <resolved-files>\" \"git commit -m cleanup  ;; Co-Authored-By trailer は実行中のハーネス既定の規約に従う\"]}]} {:step :resolve-conflicts, :goal \"Resolve conflicts deliberately, file class by file class.\", :rules [{:files [\"manifest/west.yml\"], :resolution \"Do not edit markers. Resolve source files first, then run nbb scripts/gen-west-manifest.cljs and --check.\"} {:files [\"manifest/repos.edn\" \"deps.edn\" \"*.edn\"], :resolution \"Keep both logically distinct additions. Validate with clojure.edn/babashka readers when practical.\"} {:files [\"*.md\" \"CLAUDE.md\" \"manifest/README.md\"], :resolution \"Preserve current main policy, add only the missing new procedure/reference text.\"} {:files [\"stash pop conflicts\"], :resolution \"If pop would overwrite dirty files, abort is correct. Leave stash intact, inspect stash patch, then decide whether to apply manually or ask.\"}]} {:step :verify, :goal \"Run narrow verification before pushing.\", :actions [\"rg -n '<<<<<<<|=======|>>>>>>>' <changed-files> || true\" \"nbb scripts/gen-west-manifest.cljs --check\" \"run domain-specific scripts touched by the change, e.g. nbb scripts/kotoba-boundary-audit.cljs\"]} {:step :publish-and-merge, :goal \"Create PR, inspect checks, merge only when mergeable.\", :actions [\"git push origin <branch>\" \"gh pr create --base main --head <branch> --title cleanup --body cleanup\" \"gh pr view <number> --json mergeable,statusCheckRollup\" \"If checks fail because jobs did not start due to billing/spending limit, note that it is external to code.\" \"Merge through gh pr merge or GitHub API if local worktree layout blocks gh pr merge.\"]} {:step :final-report, :goal \"Leave a clear inventory of what remains.\", :actions [\"gh pr list --state open --json number,title,headRefName,baseRefName,url\" \"git worktree list --porcelain\" \"git branch --show-current\" \"git stash list\" \"git status --short -- <relevant-paths>\" \"Report untracked placeholder repos, preserved stashes, west-orphan summary (blocking + true-orphan-git), and any remote branches intentionally left.\"]}]", :manifest.cleanup-workflow/skill "{:name \"git-cleanup-conflict\", :path \"~/.codex/skills/git-cleanup-conflict/SKILL.md\", :reference-md \"manifest/cleanup-workflow.md\"}", :manifest.cleanup-workflow/id :com-junkawasaki.root/cleanup-workflow, :manifest.cleanup-workflow/west-conflict "{:generated-file \"manifest/west.yml\", :source-files [\"manifest/repos.edn\" \"scripts/gen-west-manifest.cljs\" \"child repo HEADs\"], :never [\"hand-edit conflict markers in manifest/west.yml\" \"accept a generated west.yml side without validating child repo HEADs\" \"force-push a stale manifest branch\"], :resolution [\"Resolve manifest/repos.edn and generator changes first.\" \"Ensure child repos are checked out at the intended pins.\" \"Run nbb scripts/gen-west-manifest.cljs.\" \"Run nbb scripts/gen-west-manifest.cljs --check.\" \"Review only the intended entries changed in manifest/west.yml.\"]}", :manifest.cleanup-workflow/stash-pop "{:safe-default \"Run git stash pop only when the working tree files touched by the stash are clean.\", :if-overwrite-error [{:action :do-not-drop-stash, :reason \"Git keeps the stash entry on failed pop; preserve it.\"} {:action :inspect-current-diff, :commands [\"git diff --stat -- <paths>\" \"git diff -- <paths>\"]} {:action :inspect-stash, :commands [\"git stash show --stat stash@{0}\" \"git show 'stash@{0}' -- <paths>\"]} {:action :choose-resolution, :options [:apply-manually-if-independent :commit-current-work-first :stash-current-work-with-new-message :ask-if-pin-or-generated-output-would-regress]}]}", :manifest.cleanup-workflow/unlanded "{:purpose \"Find child repos whose work has not landed on their default branch. Answers 'どの repo に merge されていない/PR が無い WIP が残っているか'.\", :script \"nbb scripts/cleanup.cljs --unlanded\", :variants [\"nbb scripts/cleanup.cljs            ;; full survey incl. quiet repos\" \"nbb scripts/cleanup.cljs --unlanded  ;; only repos with un-landed work\" \"nbb scripts/cleanup.cljs --subrepos  ;; superproject only (fast)\"], :ladder [{:marker :untracked, :rank 1, :meaning \"not committed at all — on no branch, on no remote\", :hazard \"a single `git checkout` in the shared west checkout destroys it; git protects nothing\"} {:marker :dirty, :rank 2, :meaning \"tracked but uncommitted\", :hazard \"survives branch switches only by accident\"} {:marker :unpushed, :rank 3, :meaning \"local branch ahead of origin/<branch>, or no upstream at all\", :hazard \"exists only on this machine\"} {:marker :nopr, :rank 4, :meaning \"pushed, not reachable from the default branch, and no open PR\", :hazard \"not on any review path; rots silently\"}], :caps {:pr-lookup 20, :rule \"PR lookup is one API round-trip per branch. Repos with more than 20 pushed-but-unlanded branches (measured: kotoba-lang/webgpu ~80, kotoba-lang/slides ~90) report `nopr=?(N branches, PR照会を打切り)` instead. NEVER silently drop the cap — a truncated survey that looks complete is worse than a slow one.\"}, :incident-2026-07-25 \"orgs/gftdcojp/cloud-itonami held the whole Workspace suite (Directory/Mail/Drive/backup/domain-proof/projection-outbox, ~4000 lines + tests + its own ADR) as UNTRACKED files in the shared west checkout, on a rescue/wip-20260718 branch 1381 commits behind origin/main. On no branch, on no remote, not deployed (live itonami.cloud answered 502 api-route-html-leak). The pre-fix survey printed only `dirty=57`, indistinguishable from a one-line edit elsewhere. Landed as gftdcojp/cloud-itonami PR #488 by replaying onto current origin/main in a clean worktree.\", :two-gaps-closed [\"`git status` alone under-reports danger: split untracked from dirty and rank by how little git protects it.\" \"PRs must be queried per child repo slug. The old script ran `gh pr list` only against com-junkawasaki/root, so a child repo with pushed-but-un-PR'd branches looked clean.\"], :beyond-merge \"Un-landed is not the same as un-deployed. cloud-itonami's live Pages Function was serving a build that predated the merged source; `git log` cannot see that. After landing, probe the live surface (e.g. curl the endpoint) before calling it done.\", :never [\"treat `dirty=N` as a sufficient description of a repo's risk\" \"conclude a child repo is clean because the superproject has no open PR for it\" \"claim a survey is complete while the PR-lookup cap silently truncated it\"]}", :manifest.cleanup-workflow/land "{:purpose \"Actually land the WIP that :unlanded finds -- archive -> commit -> PR -> merge. cleanup.cljs stays read-only; this is the write side.\", :script \"nbb scripts/cleanup-land.cljs\", :variants [\"nbb scripts/cleanup-land.cljs                      ;; dry-run plan (default)\" \"nbb scripts/cleanup-land.cljs --apply\" \"nbb scripts/cleanup-land.cljs --apply --names a,b\" \"nbb scripts/cleanup-land.cljs --apply --max 20\"], :rule \"NEVER merge all UNLANDED work as one class. Split by whether it can break main, not by how dangerous it is to lose.\", :classes [{:id :additive, :what \"untracked files only\", :action \"commit -> PR -> MERGE\", :why \"no such path exists on the default branch, so no existing line is rewritten; not landing it is the greater risk since it lives on no branch and no remote\"} {:id :review, :what \"changes to tracked files\", :action \"commit -> PR, NEVER auto-merge\", :why \"a stale base silently rolls main back. Measured: the cloud-itonami working tree was 1381 commits behind main; applying its legal/terms.md would have reverted owner-approved public legal pages to a 2026-07-18 DRAFT.\"} {:id :branches, :what \"existing local branches\", :action \"push if unpushed; open a PR if pushed with none; NEVER auto-merge\", :why \"abandoned experiments, deliberate forks and force-pushed histories all look alike\"}], :write-path \"GitHub git API: blob -> tree(base_tree=default branch) -> commit -> ref. Not local worktrees -- at ~100-repo scale per-repo full checkouts are impractical, and the shared checkout is often parked on a stale branch. Same server-side single-commit shape CLAUDE.md mandates for manifest/west.yml.\", :traps [{:id :renamed-repo, :symptom \"reads succeed, writes fail; presents as commits mysteriously failing\", :cause \"GitHub redirects GETs and -f-style POSTs but returns HTTP 307 to --input POSTs, and gh does not follow it\", :fix \"resolve every slug through `gh api repos/<slug> --jq .full_name` before writing\", :measured \"kotoba-lang/kotoba-git is now kotoba-lang/bonsai; the local remote URL still said the old name\"} {:id :jq-scalar-is-not-json, :symptom \"every commit fails while success paths report normally\", :cause \"a bare token such as a commit sha parsed as JSON yields nil\", :fix \"use a string-returning helper for --jq scalars, a JSON-parsing one only for JSON\"}], :skipped-but-reported [\"credential-looking paths (.env, *.pem, *.key, identity.edn, *secret*, .kagi/)\" \"build junk (node_modules, .cpcache, target, dist, *.log)\" \"files over 2 MB\" \"git-annex / DataLad datasets\"], :preserves [\"executable bits (100755) -- otherwise bin/* lands unusable\" \"the local working tree: nothing is ever deleted, archive to .git/stash-archive-<date>/ first, then add\"], :never [\"merge :review or :branches automatically\" \"drop or delete local WIP\" \"silently skip a file -- every skip is reported by class\"]}", :manifest.cleanup-workflow/version 6, :db/id -1, :manifest.cleanup-workflow/principles "[{:id :preserve-wip, :rule \"Never discard owner WIP. Preserve dirty files and untracked repos with stash or explicit report.\"} {:id :no-force-push, :rule \"Do not use force-push or history rewrite on shared branches.\"} {:id :no-rebase, :rule \"Do not use rebase as the default conflict or divergence resolver. If a branch cannot fast-forward, create a clean branch/worktree from current origin/main and replay only the needed commits or patch.\"} {:id :main-first, :rule \"Prefer a branch created from current origin/main over fighting a stale branch.\"} {:id :generated-west, :rule \"manifest/west.yml is generated. Resolve conflicts by choosing a side for source files, then regenerate; do not hand-edit conflict markers.\"} {:id :structured-before-text, :rule \"Use EDN/source-of-truth files and generators before ad hoc line edits.\"} {:id :worktree-per-agent, :rule \"Agents work in per-task worktrees outside the superproject root (sparse checkout for speed); the main superproject checkout is integration/read-only. See CLAUDE.md § 並行エージェント運用.\"} {:id :no-stash-accumulation, :rule \"Park WIP as commits on a session branch, not in stash. Stash is only an emergency preserve for someone else's uncommitted WIP found in the shared checkout, and must be retired via :retirement afterwards.\"} {:id :west-registration-complete, :rule \"GitHub push alone is not done. A repo under orgs/ that other projects consume via :local/root (or that is an intentional fleet member) must land in manifest/repos.edn :extra-projects and west.yml via gen-west-manifest.cljs --entry. Run nbb scripts/west-orphan-audit.cljs; exit 1 means blocking :local/root edges.\"} {:id :classify-orphans-before-register, :rule \"Do not treat every local dir missing from west as a new project. Classify path-override leftovers, personal/*, worktree-scratch, true-orphan-git, true-orphan-nongit, and local-root-broken. Never re-register path-override old paths.\"}]", :manifest.cleanup-workflow/triggers ["cleanup" "stash pop" "PR/merge が残っている" "merge conflict を丁寧に解く" "worktree/branch/stash を整理する" "west 未登録" "orphan repo" "local only" ":local/root が壊れている" "fresh checkout で deps が解決しない" "どの repo に WIP が残っているか特定する" "merge されていない / PR が無い repo を特定する" "未 push の作業を洗い出す" "landed していない変更" "deploy されていない変更"], :manifest.cleanup-workflow/retirement "{:purpose \"Drain accumulated stashes and local branches without losing work. Verified 2026-07-02: 20 stashes + 8 branches drained, 2 unlanded items rescued.\", :snapshot {:rule \"Concurrent sessions shift stash indices. Snapshot `git stash list --format='%H %gs'` once; before every drop, re-resolve each SHA to its current index.\"}, :classify {:method :content-containment, :rule \"Judge by content, not patch-id. Exclude generated files (manifest/west.yml) — stashed generated content is disposable. For each remaining file, test whether every added line of the stash diff exists in current main's version.\", :outcomes [{:case :all-lines-present, :verdict :landed, :action :archive-and-drop} {:case :only-comment-lines-missing, :verdict :landed-reworded, :action :archive-and-drop} {:case :later-round-of-same-series-landed, :verdict :superseded, :action :archive-and-drop} {:case :substantive-lines-missing, :verdict :unlanded, :action :rescue-to-branch}]}, :archive {:location \".git/stash-archive-<date>/\", :rule \"Before dropping anything, export each stash as `git diff <sha>^ <sha>` patch (plus stash^3 untracked list when present) and an index.txt of `SHA | message`. Branch archives (diff vs main + commit log) go under branches/. Makes retirement reversible without relying on reflog/gc.\"}, :rescue {:rule \"Rescue unlanded content to a pushed branch, never back into a stash. Build in a sparse worktree outside the superproject; apply with `git apply -3 --include=<path>`; merge stays owner's call.\", :commands [\"git worktree add --no-checkout -b stash-rescue-<date> /tmp/root-stash-rescue origin/main\" \"git sparse-checkout set --no-cone <paths> && git checkout\" \"git apply -3 --include='<path>' <archive>/<sha>.patch\" \"git commit && git push origin stash-rescue-<date>\"]}, :branches {:rule \"Same discipline per branch: ancestor-of-main → delete; else content containment; unrelated-history branches → remote-preservation check (tip commit exists in successor repo via gh api). Archive first, then `git branch -D`.\", :deepen-first \"full history is the default (ADR-2607211600); merge-base --is-ancestor resolves directly, no deepening needed\", :never-delete [\"git-annex\" \"branches another session is actively using\"]}}", :manifest.cleanup-workflow/west-orphan "{:purpose \"Detect local/GitHub/west registration gaps that break fresh checkouts (especially :local/root consumers of unregistered commons).\", :script \"nbb scripts/west-orphan-audit.cljs\", :incident-2026-07-17 \"kotoba-lang/crm pushed to GitHub 2026-07-12; cloud-itonami-isic-5820/6201/6202 deps.edn use :local/root ../../kotoba-lang/crm; crm never entered west and often missing locally.\", :classes [{:id :local-root-broken, :blocking true, :action \"register missing project or retarget dep\"} {:id :true-orphan-git, :action \"register intentional fleet member or retire; never silent-delete\"} {:id :path-override-leftover, :action \"do not re-register old path; optional leftover dir cleanup after containment\"} {:id :worktree-scratch, :action \"remove only after unpushed-WIP check\"} {:id :personal, :action \"out of west scope\"} {:id :true-orphan-nongit, :action \"report; register only if it becomes a real repo\"}], :completion-gate \"GitHub remote exists AND west pin exists AND consumer :local/root resolves under a west path; west-orphan-audit --blocking exit 0\", :repair \"nbb scripts/west-triple-sync.cljs plan|apply|verify (ADR-2607173200, manifest/west-triple-sync-workflow.edn)\", :never [\"register path-override old names\" \"treat personal/* as west projects\" \"claim cleanup done while local-root-broken remains\"]}", :manifest.cleanup-workflow/updated "2026-07-25"}]