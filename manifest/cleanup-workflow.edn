{:id :com-junkawasaki.root/cleanup-workflow
 :version 1
 :updated "2026-06-29"
 :purpose "Run cleanup for unmerged branches, PRs, worktrees, stashes, and merge conflicts without losing owner WIP."

 :triggers
 ["cleanup"
  "stash pop"
  "PR/merge が残っている"
  "merge conflict を丁寧に解く"
  "worktree/branch/stash を整理する"]

 :principles
 [{:id :preserve-wip
   :rule "Never discard owner WIP. Preserve dirty files and untracked repos with stash or explicit report."}
  {:id :no-force-push
   :rule "Do not use force-push or history rewrite on shared branches."}
  {:id :main-first
   :rule "Prefer a branch created from current origin/main over fighting a stale shallow branch."}
  {:id :generated-west
   :rule "manifest/west.yml is generated. Resolve conflicts by choosing a side for source files, then regenerate; do not hand-edit conflict markers."}
  {:id :structured-before-text
   :rule "Use EDN/source-of-truth files and generators before ad hoc line edits."}]

 :commands
 {:repo-discovery
  ["find . -path './orgs/personal/takeout' -prune -o -path './orgs/personal/drive' -prune -o -name .git -prune -print"
   "git worktree list --porcelain"
   "git branch --show-current"
   "git stash list"
   "git status --short --branch"]

  :github-pr
  ["gh pr list --state open --json number,title,headRefName,baseRefName,url,mergeable,statusCheckRollup"
   "gh pr create --base main --head <branch> --title cleanup --body cleanup"
   "gh pr view <number> --json number,state,mergeable,statusCheckRollup,url"
   "gh api -X PUT repos/<owner>/<repo>/pulls/<number>/merge -f merge_method=merge"]

  :shallow-merge-base
  ["BASE=$(gh api repos/<owner>/<repo>/compare/main...<branch> --jq .merge_base_commit.sha)"
   "git fetch --depth 1 origin \"$BASE\""]

  :west-regenerate
  ["bb scripts/gen-west-manifest.bb"
   "bb scripts/gen-west-manifest.bb --check"]

  :conflict-inspection
  ["git diff --name-only --diff-filter=U"
   "rg -n '<<<<<<<|=======|>>>>>>>' <paths>"
   "git diff --stat -- <paths>"
   "git diff -- <paths>"]}

 :workflow
 [{:step :inspect
   :goal "Build an inventory before changing anything."
   :actions
   [:run-repo-discovery
    :list-open-prs
    :identify-dirty-files
    :identify-untracked-repos
    :identify-stashes]}

  {:step :classify
   :goal "Separate mergeable work from WIP and invalid targets."
   :outcomes
   [{:case :branch-has-unmerged-work
     :next :prepare-clean-pr}
    {:case :stash-only
     :next :report-or-apply-carefully}
    {:case :remote-missing-or-empty-placeholder
     :next :report-blocked}
    {:case :generated-file-dirty
     :next :regenerate-or-preserve}]}

  {:step :prepare-clean-pr
   :goal "Avoid stale branch conflicts by replaying needed commits onto current main."
   :actions
   [{:type :prefer
     :commands ["git fetch --depth 1 origin main"
                "git switch -c cleanup-<date> origin/main"]}
    {:type :replay
     :commands ["git cherry-pick <needed-commit>"
                "or apply the small diff manually if shallow ancestry causes add/add conflicts"]}
    {:type :commit
     :commands ["git add <resolved-files>"
                "git commit -m cleanup -m 'Co-Authored-By: Claude Opus 4.8 (1M context)'"]}]}

  {:step :resolve-conflicts
   :goal "Resolve conflicts deliberately, file class by file class."
   :rules
   [{:files ["manifest/west.yml"]
     :resolution "Do not edit markers. Resolve source files first, then run bb scripts/gen-west-manifest.bb and --check."}
    {:files ["manifest/repos.edn" "deps.edn" "*.edn"]
     :resolution "Keep both logically distinct additions. Validate with clojure.edn/babashka readers when practical."}
    {:files ["*.md" "CLAUDE.md" "manifest/README.md"]
     :resolution "Preserve current main policy, add only the missing new procedure/reference text."}
    {:files ["stash pop conflicts"]
     :resolution "If pop would overwrite dirty files, abort is correct. Leave stash intact, inspect stash patch, then decide whether to apply manually or ask."}]}

  {:step :verify
   :goal "Run narrow verification before pushing."
   :actions
   ["rg -n '<<<<<<<|=======|>>>>>>>' <changed-files> || true"
    "bb scripts/gen-west-manifest.bb --check"
    "run domain-specific scripts touched by the change, e.g. bb scripts/kotoba-boundary-audit.bb"]}

  {:step :publish-and-merge
   :goal "Create PR, inspect checks, merge only when mergeable."
   :actions
   ["git push origin <branch>"
    "gh pr create --base main --head <branch> --title cleanup --body cleanup"
    "gh pr view <number> --json mergeable,statusCheckRollup"
    "If checks fail because jobs did not start due to billing/spending limit, note that it is external to code."
    "Merge through gh pr merge or GitHub API if local worktree layout blocks gh pr merge."]}

  {:step :final-report
   :goal "Leave a clear inventory of what remains."
   :actions
   ["gh pr list --state open --json number,title,headRefName,baseRefName,url"
    "git worktree list --porcelain"
    "git branch --show-current"
    "git stash list"
    "git status --short -- <relevant-paths>"
    "Report untracked placeholder repos, preserved stashes, and any remote branches intentionally left."]}]

 :stash-pop
 {:safe-default "Run git stash pop only when the working tree files touched by the stash are clean."
  :if-overwrite-error
  [{:action :do-not-drop-stash
    :reason "Git keeps the stash entry on failed pop; preserve it."}
   {:action :inspect-current-diff
    :commands ["git diff --stat -- <paths>" "git diff -- <paths>"]}
   {:action :inspect-stash
    :commands ["git stash show --stat stash@{0}" "git show 'stash@{0}' -- <paths>"]}
   {:action :choose-resolution
    :options [:apply-manually-if-independent
              :commit-current-work-first
              :stash-current-work-with-new-message
              :ask-if-pin-or-generated-output-would-regress]}]}

 :west-conflict
 {:generated-file "manifest/west.yml"
  :source-files ["manifest/repos.edn" "scripts/gen-west-manifest.bb" "child repo HEADs"]
  :never ["hand-edit conflict markers in manifest/west.yml"
          "accept a generated west.yml side without validating child repo HEADs"
          "force-push a stale manifest branch"]
  :resolution
  ["Resolve manifest/repos.edn and generator changes first."
   "Ensure child repos are checked out at the intended pins."
   "Run bb scripts/gen-west-manifest.bb."
   "Run bb scripts/gen-west-manifest.bb --check."
   "Review only the intended entries changed in manifest/west.yml."]}

 :skill
 {:name "git-cleanup-conflict"
  :path "~/.codex/skills/git-cleanup-conflict/SKILL.md"
  :reference-md "manifest/cleanup-workflow.md"}}
