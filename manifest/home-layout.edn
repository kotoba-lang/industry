  :home-layout/home "/Users/junkawasaki"
  :home-layout/workspace-root "github/com-junkawasaki"
  :home-layout/policy
  {:projects "Git 管理対象の個人 project は github/com-junkawasaki/orgs/<org>/<repo> に集約する。"
   :large-data "既存の Git Annex 対象は通常ファイルへ戻さず、annex symlink と object store を維持する。"
   :secrets "wallet、token、credential は Git workspace に登録しない。project 内に残す必要がある secret file は明示的に ignore する。"
   :generated "venv、cache、log、生成 output は project ごとの .gitignore で誤 commit を防ぐ。"
   :deletion "由来が確認できないものは即時削除せず archive または Trash に退避する。"}
