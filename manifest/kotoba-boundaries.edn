;; Canonical ownership boundaries for the kotoba stack.
;;
;; Keep kotoba-lang focused on libraries, language/runtime substrate, data
;; structures, protocols, and test fixtures. Product/domain actors live in
;; etzhayyim. AT Protocol actors and PDS/AppView live in app-aozora. Hosting and
;; fleet placement live in murakumo.
{:owners
 {:library-and-language "orgs/kotoba-lang"
  :domain-actors        "orgs/etzhayyim/com-etzhayyim-*"
  :atproto-actors       "orgs/gftdcojp/app-aozora"
  :hosting              "orgs/kotoba-lang/murakumo"}

 :legacy
 {:kotoba-kotodama
  {:path "orgs/kotoba-lang/kotoba/crates/kotoba-kotodama"
   :status :migrate-out
   :rule "Rust config/inference crates may remain only if they are generic language/runtime substrate. Domain cells, Python UDFs, AT Protocol actors, and hosting code must move out."}}

 :compat-shims
 {"orgs/kotoba-lang/kotoba/crates/kotoba-kotodama/py/src/kotodama/primitives/murakumo_fleet.py"
  {:target "orgs/kotoba-lang/murakumo"
   :replacement "orgs/kotoba-lang/murakumo/py/murakumo_host/fleet.py"
   :remove-after "legacy Kotodama Zeebe worker imports murakumo_host.fleet directly"}}

:primitive-routes
{"shinka_murakumo.py" "orgs/etzhayyim/com-etzhayyim-shinka"
 "joucho_murakumo.py" "orgs/etzhayyim/com-etzhayyim-joucho"
 "yoro_social_murakumo.py" "orgs/gftdcojp/app-aozora"
 "test_shinka_murakumo.py" "orgs/etzhayyim/com-etzhayyim-shinka"
 "test_shinka_m2_complete.py" "orgs/etzhayyim/com-etzhayyim-shinka"
 "test_e2e_religious_corp.py" "orgs/etzhayyim/com-etzhayyim-shinka"
 "test_joucho_murakumo.py" "orgs/etzhayyim/com-etzhayyim-joucho"
 "test_yoro_m4.py" "orgs/gftdcojp/app-aozora"
 "test_yoro_m5.py" "orgs/gftdcojp/app-aozora"}

:primitive-route-kinds
{"yoro_social_murakumo.py" :atproto-actor
 "test_yoro_m4.py" :atproto-actor
 "test_yoro_m5.py" :atproto-actor}

;; clj-wgsl migration (90-docs/migration/clj-wgsl-ledger.edn): ownership of the
;; hand-authored WGSL shaders `include_str!`'d into native crates. The audit
;; (scripts/kotoba-boundary-audit.bb --clj-wgsl) scans include_str!(".wgsl") under
;; kami-render/src, kami-webgpu-rs/src, kami-genesis/src and classifies each:
;;   :cljc-authored  — generated from a CLJC canonical (parity-enforced by verify-clj-everywhere.sh)
;;   :port-target    — hand-authored today, scheduled to be CLJC-authored (Phase 2)
;;   :stay-rust-builtin (default) — native builtin pipeline; the wgpu recorder stays Rust
:wgsl-ownership
{:cljc-authored
 {"kami-webgpu-rs/src/lit_shader.wgsl"   "kami-webgpu/fixtures/lit-shader.wgsl"
  "kami-webgpu-rs/src/shadow_shader.wgsl" "kami-webgpu/fixtures/shadow-shader.wgsl"}
 :port-target
 {"kami-webgpu-rs/src/post.wgsl"                  {:phase 2.3 :ledger "kami-postfx"}
  "kami-genesis/src/wgsl/cartpole_step.wgsl"        {:phase 2.1 :ledger "kami-genesis"}
  "kami-genesis/src/wgsl/double_pendulum_step.wgsl" {:phase 2.1 :ledger "kami-genesis"}
  "kami-genesis/src/wgsl/planar_chain_step.wgsl"    {:phase 2.1 :ledger "kami-genesis"}}
 :default :stay-rust-builtin}

