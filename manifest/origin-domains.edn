   :repos ["kotoba-lang/com-epic-online-services" "kotoba-lang/com-epiconlineservices"]
   :note "the same product under two spellings of the same words; one is a
          duplicate registration, not a second subject"}]

 ;; ── domain migration ───────────────────────────────────────────────────
 ;; The rule pins the domain AS OF REGISTRATION and does not chase a move.
 ;; Recorded because it has already happened, not as a hypothetical.
 :migrations
