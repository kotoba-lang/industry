   :why "a class of system, not a specification anyone publishes"
   :candidates []}
  {:repo "kotoba-lang/com-can-bus"
   :why "Bosch published the original spec, ISO standardised it as 11898"
   :candidates ["bosch.com" "iso.org"]}
  {:repo "kotoba-lang/com-sic-codes"
   :why "US SIC was retired in favour of NAICS; no body maintains it today"
   :candidates ["census.gov" "osha.gov"]}
  {:repo "kotoba-lang/com-gb-standards"
   :why "Chinese GB standards moved between SAC and SAMR"
   :candidates ["sac.gov.cn" "samr.gov.cn"]}
  ;; From the 2026-08-05 DNS sweep: the first label does not resolve as a .com,
  ;; and looking further found no publishing authority either.
  {:repo "kotoba-lang/com-chatdev"
   :why "a research project (OpenBMB), distributed as a GitHub repo with no
         authority domain of its own"
   :candidates []}
  {:repo "kotoba-lang/com-cobot-assembly"
   :why "a manufacturing practice, not a specification anyone publishes"
   :candidates []}
  {:repo "kotoba-lang/com-serdes-phy"
   :why "a circuit block; the relevant specs sit under several bodies (OIF,
         JEDEC, IEEE) with no single owner for the subject as named"
