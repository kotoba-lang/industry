 ;; ── unresolvable ───────────────────────────────────────────────────────
 ;; Names that carry an origin prefix but have no single authority domain to
 ;; derive from. Recorded rather than guessed. These are not misfiled — the
 ;; origin plane simply does not apply, and each needs an owner decision
 ;; (move to the subject plane, or pick one of the competing authorities).
 :unresolvable
 [{:repo "kotoba-lang/com-rtos"
   :why "a class of system, not a specification anyone publishes"
   :candidates []}
  {:repo "kotoba-lang/com-can-bus"
   :why "Bosch published the original spec, ISO standardised it as 11898"
   :candidates ["bosch.com" "iso.org"]}
  {:repo "kotoba-lang/com-sic-codes"
   :why "US SIC was retired in favour of NAICS; no body maintains it today"
   :candidates ["census.gov" "osha.gov"]}
  {:repo "kotoba-lang/com-gb-standards"
   :why "Chinese GB standards moved between SAC and SAMR"
   :candidates ["sac.gov.cn" "samr.gov.cn"]}]

 ;; ── domain migration ───────────────────────────────────────────────────
 ;; The rule pins the domain AS OF REGISTRATION and does not chase a move.
 ;; Recorded because it has already happened, not as a hypothetical.
 :migrations
 [{:authority "IPFS"
   :from "ipfs.io" :to "ipfs.tech"
   :repos-under-old ["kotoba-lang/io-ipfs" "kotoba-lang/io-ipld"
                     "kotoba-lang/io-multiformats"]
   :repos-under-new ["kotoba-lang/tech-ipfs-specs-ipns"
                     "kotoba-lang/tech-ipfs-specs-http-gateway"]
   :disposition :keep-both
   :why "A repository name is a discovery alias, not identity — identity is the
         semantic definition CID (ADR-2607289500). Renaming five repositories to
         track a marketing domain move would churn west pins and every inbound
         reference to buy nothing. Both prefixes are correct as of their own
         registration date."}]

 ;; ── coverage ───────────────────────────────────────────────────────────
 ;; Stated so a reader never mistakes this file for a census. The verifier
 ;; prints these counts on every run.
 :coverage
 {:measured-at "2026-08-04"
  :measured-by "nbb scripts/verify-repository-roles.cljs --name-audit"
  :workspace {:repos 4078 :origin-plane 1432 :unverified 1333}
  :kotoba-lang {:repos 1995 :origin-plane 1193 :unverified 1094}
  :recorded-here 95
  :anchors 18
  :conformant 18
  :misfiled 77
  :unresolvable 4
  :note "1,333 origin-plane repositories have no domain recorded. They are
         reported UNVERIFIED, not CONFORMANT. Filling them in is mechanical but
         is 1,333 lookups; it is deliberately left as a stated gap rather than
         auto-populated from the name, which would assume the answer the check
         exists to test."
  :honest-reading "conformant=18 does NOT mean 18 of 1,432 names are right. It
                   means 18 have been CHECKED and passed. The 77 misfiled were
                   found by looking, and the same rate applied to the unverified
                   remainder would predict far more — which is the argument for
                   filling the file in, not for treating the count as a score."}}
