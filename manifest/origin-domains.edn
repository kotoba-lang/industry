 ;; prints these counts on every run.
 :coverage
 {:measured-at "2026-08-05"
  :measured-by "nbb scripts/verify-repository-roles.cljs --name-audit"
  :workspace {:repos 4078 :origin-plane 1432 :unverified 1313}
  :recorded-here 112
  :anchors 18
  :conformant 18
  :misfiled 94
  :unresolvable 7
  :note "1,313 origin-plane repositories have no domain recorded. They are
         reported UNVERIFIED, not CONFORMANT. It is deliberately not
         auto-populated from the name, which would assume the answer the check
         exists to test."
  :honest-reading "conformant=18 does NOT mean 18 of 1,432 names are right. It
                   means 18 have been CHECKED and passed. Every misfiling here
                   was found by looking; none was found by counting."
  ;; Why the remaining 1,313 cannot simply be batched: the repositories carry no
  ;; authority URL anywhere (measured — READMEs name the vendor in prose and link
  ;; nothing but github.com), so there is no in-repo evidence to extract. Each
  ;; needs an external lookup. What CAN be done mechanically is narrow the
  ;; worklist, which is what the DNS sweep below does.
  :why-not-batched :no-authority-url-inside-the-repositories
  ;; Entries recorded AFTER the run above. The counts are a dated measurement
  ;; and are not hand-incremented; the additions are named instead, so
  ;; recorded-here=112 stays true of 2026-08-05 rather than becoming a wrong
  ;; number about today.
  :added-after-last-measurement
  [{:date "2026-08-15"
    :repos ["kotoba-lang/ws-valueflo-vocabulary" "kotoba-lang/ws-valueflo-algorithms"]
    :domain "valueflo.ws"
    :dns-checked-at "2026-08-15"
    :adr "ADR-2608153000"}
   {:date "2026-08-15"
    :repos ["kotoba-lang/xyz-ucan"]
    :domain "ucan.xyz"
    :dns-checked-at "2026-08-15"
    :adr "ADR-2608159400"}]}

 ;; ── DNS sweep, 2026-08-05 ──────────────────────────────────────────────
 ;; A way to find candidates without asserting anything: for each com-* repo,
 ;; test whether its first label resolves as <label>.com.
 ;;
 ;; The asymmetry is the whole point. NON-resolution proves the naive reading is
 ;; wrong. RESOLUTION proves nothing — yang.com resolves and tells you nothing
 ;; about com-yang-ming-api — so the 1,029 that resolved were left UNVERIFIED
 ;; rather than quietly marked conformant.
 :dns-sweep
 {:date "2026-08-05"
  :method "dig +short NS <first-label>.com over all com-* repos"
  :tested 1054
  :resolved 1029
  :did-not-resolve 25
  :already-recorded 5
  :pursued 20
  :outcome {:recorded-as-misfiled 17 :moved-to-unresolvable 3 :conformant 0}
  :hit-rate "17 of 17 pursued-and-resolvable turned out misfiled"
  :note "Non-resolution was a perfect predictor here, which says the sweep found
         a genuine seam and not that 1,029 names are fine. Examples it caught:
         com-acorrd-standards (ACORD, and misspelled), com-b-pipe (Bloomberg
         B-PIPE), com-tensorrt (NVIDIA), com-pix-brazil (Banco Central do
         Brasil), com-omop-cdm (OHDSI)."}}
