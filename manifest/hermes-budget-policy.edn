;; manifest/hermes-budget-policy.edn — hermes cron fleet の 1 日あたり API 予算と、
;; 超えたときに何を先に止めるか。
;;
;; これは POLICY であって METER ではない。実際の残高と消費を答えるのは
;; OpenRouter の /api/v1/credits で、この file は「いくらまで」と「順番」だけを持つ。
;; 実行は scripts/hermes-budget-guard.cljs（launchd com.gftd.hermes-budget-guard、5 分毎）。
;;
;; 測って決めた数（2026-09-09）:
;;   blended 単価 ≈ $0.092 / 1M prompt token
;;     — 2 出所で突き合わせた: (a) credits の total_usage 差分 $0.367/min
;;       (b) 全 167 本の usage_audit.jsonl の token 合計。lifetime $2,333 / 24,762M と整合
;;   cap + cadence 適用後の見積り = 429M prompt/day ≈ $39/day
;;
;; ⚠ 単価をここに定数として書かない。上の数は「何を測ったか」の記録であって今日の値ではない。
;;   guard は token からドルを推定せず、credits が答えたドルだけを使う。
;;
;; TIER —— 数が大きいほど先に止まる。割り当ては「止めたときに空く額」順であって
;; 価値の順ではない（価値の signal をまだ持っていない）。オーナーが並べ替えるのが正しい。
;;   3 = 見積り消費の上位 50%（28 job）
;;   2 = 次の 35%（56 job）
;;   1 = 残り 15%（164 job）
;; 名簿に無い job は 3 として扱う（deny by default: 名指しされていない出費は最初に切る）。
{:budget/version 1

 ;; 1 日の上限（USD）。JST の 0:00 で日が変わる。
 :budget/usd-per-day 50.0

 ;; 消費の正本。guard はここが答えたドルだけを使い、token から推定しない。
 :budget/account "openrouter"
 :budget/credits-url "https://openrouter.ai/api/v1/credits"
 ;; Keychain の service 名を 1 件だけ名指しする（総当たり列挙はしない）。
 :budget/key-service "gftd.openrouter"
 :budget/day-zone "Asia/Tokyo"

 ;; ratio = (今日の消費 / :budget/usd-per-day)。>= で判定する。
 ;; ratio がちょうど :at のとき、その段は「効く」。境界は self-check が持つ。
 :budget/steps [{:at 0.60 :pause-from 3}
                {:at 0.80 :pause-from 2}
                {:at 1.00 :pause-from 1}]

 ;; どの段でも止めない job（"<profile>/<job-id>"）。今は空。
 ;; 空集合は「全部止めてよい」という決定であって、書き忘れではない。
 :budget/never-pause #{}

 ;; credits が読めなかった tick をこの回数続けたら、全段を止める。
 ;; 1 回の失敗では止めないが、1 回でも「予算内」とは答えない（exit 2）。
 :budget/unreadable-ticks-before-pause 3

