<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ob/mf-csv-export の自動消化 (mf-csv-check.bb 参照)。毎日18:00にチェックし、
     inbox/mf-cashflow.csv が置かれたら取込→コミット→このジョブ自体を自己解除する。
     期限 2026-06-19 以降は未着なら macOS 通知でリマインド。
     Install:  cp personal/bin/launchd/com.junkawasaki.mf-csv-check.plist ~/Library/LaunchAgents/
               launchctl bootout  gui/$(id -u)/com.junkawasaki.mf-csv-check 2>/dev/null
               launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.junkawasaki.mf-csv-check.plist
     Run now:  launchctl kickstart gui/$(id -u)/com.junkawasaki.mf-csv-check -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.junkawasaki.mf-csv-check</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/bb</string>
		<string>/Users/junkawasaki/github/com-junkawasaki/personal/bin/mf-csv-check.bb</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>18</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/tmp/com.junkawasaki.mf-csv-check.out</string>
	<key>StandardErrorPath</key>
	<string>/tmp/com.junkawasaki.mf-csv-check.err</string>
</dict>
</plist>
