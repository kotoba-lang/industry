<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- iCloud Drive + Apple Photos の継続同期 (icloud-photos-sync.bb 参照)。毎日 7:30 起動。
     cid(annex MD5)で重複回避。iCloud Drive=差分コピー、Photos=索引更新+ingest-policy。
     原本270GBの全取込は facts/photos-library.edn の :photos/ingest-policy を :full にした時のみ。
     Install:  cp personal/bin/launchd/com.junkawasaki.icloud-photos-sync.plist ~/Library/LaunchAgents/
               launchctl bootout  gui/$(id -u)/com.junkawasaki.icloud-photos-sync 2>/dev/null
               launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.junkawasaki.icloud-photos-sync.plist
     Run now:  launchctl kickstart gui/$(id -u)/com.junkawasaki.icloud-photos-sync -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.junkawasaki.icloud-photos-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/bb</string>
		<string>/Users/junkawasaki/github/com-junkawasaki/personal/bin/icloud-photos-sync.bb</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/tmp/com.junkawasaki.icloud-photos-sync.out</string>
	<key>StandardErrorPath</key>
	<string>/tmp/com.junkawasaki.icloud-photos-sync.err</string>
</dict>
</plist>
