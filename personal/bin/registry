#!/usr/bin/env python3
"""registry — query personal/accounts/registry.toml (tab-separated, bash-friendly).

USAGE:
    registry accounts                 # slug<TAB>email<TAB>provider
    registry takeout-jobs             # prefix<TAB>account<TAB>parts<TAB>note
    registry takeout-account PREFIX   # -> account slug (exit 1 if unknown)
    registry mail-accounts            # slug<TAB>provider<TAB>window (mail.sync=true only)
    registry email SLUG               # -> email address (exit 1 if unknown)
"""
import sys, os, tomllib

BASE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))  # personal/
PATH = os.path.join(BASE, "accounts", "registry.toml")


def load():
    with open(PATH, "rb") as f:
        return tomllib.load(f)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    reg = load()
    if cmd == "accounts":
        for slug, a in reg.get("accounts", {}).items():
            print(f"{slug}\t{a.get('email','')}\t{a.get('provider','')}")
    elif cmd == "takeout-jobs":
        for prefix, j in reg.get("takeout", {}).items():
            print(f"{prefix}\t{j['account']}\t{j.get('parts','?')}\t{j.get('note','')}")
    elif cmd == "takeout-account":
        prefix = sys.argv[2]
        j = reg.get("takeout", {}).get(prefix)
        if not j:
            sys.exit(1)
        print(j["account"])
    elif cmd == "mail-accounts":
        for slug, a in reg.get("accounts", {}).items():
            m = a.get("mail") or {}
            if m.get("sync"):
                print(f"{slug}\t{a.get('provider','')}\t{m.get('window','14d')}")
    elif cmd == "email":
        a = reg.get("accounts", {}).get(sys.argv[2])
        if not a:
            sys.exit(1)
        print(a["email"])
    else:
        sys.stderr.write(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
