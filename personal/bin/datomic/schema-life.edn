;; schema-life.edn — ADR-0010: goals / obligations / decisions / kpi / prov / person拡張.
;; Additive to schema.edn (load.clj should transact both files).

[;; ---------- goal (life DAG node; migrated from reverse_topo_pregel.py) ----------
 {:db/ident :goal/id             :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity :db/doc "e.g. \"15_remarriage\", \"00_nodoka_wellbeing\""}
 {:db/ident :goal/title          :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :goal/kind           :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":objective (maximize) | :guardrail (constraint; never traded off)"}
 {:db/ident :goal/domain         :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":relations :health :social :physics :fiction :infra :spirit :did"}
 {:db/ident :goal/tau            :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":week :month :year :decade :generation"}
 {:db/ident :goal/est-years      :db/valueType :db.type/double  :db/cardinality :db.cardinality/one}
 {:db/ident :goal/w-contribution :db/valueType :db.type/double  :db/cardinality :db.cardinality/one}
 {:db/ident :goal/depends-on     :db/valueType :db.type/ref     :db/cardinality :db.cardinality/many :db/doc "goal -> prerequisite goals (DAG edge)"}
 {:db/ident :goal/status         :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":active :done :deferred :dropped"}
 {:db/ident :goal/tier           :db/valueType :db.type/long    :db/cardinality :db.cardinality/one :db/doc "ADR-0014 辞書式優先: 0=wellbecoming床 1=孫・子供(のどか) 2=その他(省略時)"}
 {:db/ident :goal/wellness-dims  :db/valueType :db.type/keyword :db/cardinality :db.cardinality/many :db/doc "wellness 8次元: :physical :emotional :social :intellectual :spiritual :occupational :financial :environmental"}
 {:db/ident :goal/external-dependency :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/doc "外部依存 (相手・市場・裁判所など)"}
 {:db/ident :goal/fallback       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "代替経路"}

 ;; ---------- obligation (dated duty: court date, brief deadline, payment due, renewal) ----------
 {:db/ident :obligation/id       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :obligation/title    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :obligation/due      :db/valueType :db.type/instant :db/cardinality :db.cardinality/one}
 {:db/ident :obligation/severity :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":critical (irreversible loss) :high :normal"}
 {:db/ident :obligation/status   :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":open :done :waived"}
 {:db/ident :obligation/case     :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
 {:db/ident :obligation/goal     :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
 {:db/ident :obligation/source   :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one :db/doc "obligation -> email/blob it was extracted from (provenance)"}

 ;; ---------- decision (manimani ledger + human/agent calls; queryable judgment history) ----------
 {:db/ident :decision/id         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :decision/at         :db/valueType :db.type/instant :db/cardinality :db.cardinality/one}
 {:db/ident :decision/policy     :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":reply-llm :todo :waiting :done :archive :unsubscribe :investigate :snooze"}
 {:db/ident :decision/agent      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":human :llm-auto :llm-suggested"}
 {:db/ident :decision/input      :db/valueType :db.type/ref     :db/cardinality :db.cardinality/many :db/doc "decision -> emails/obligations it acted on"}
 {:db/ident :decision/note       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}

 ;; ---------- kpi (sensor time-series; living system output) ----------
 {:db/ident :kpi/id              :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity :db/doc "metric+at composite, e.g. \"nodoka.time/2026-W24\""}
 {:db/ident :kpi/metric          :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":nodoka.time :health.sleep :health.clinic :meeting.partners :mail.noise-ratio"}
 {:db/ident :kpi/value           :db/valueType :db.type/double  :db/cardinality :db.cardinality/one}
 {:db/ident :kpi/at              :db/valueType :db.type/instant :db/cardinality :db.cardinality/one}
 {:db/ident :kpi/goal            :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one :db/doc "kpi -> goal it measures"}

 ;; ---------- person extensions (entity resolution + attention policy) ----------
 ;; NOTE: :person/email (unique) stays for compat; :person/id becomes canonical,
 ;; :person/emails collects aliases (iCloud Hide-My-Email relays, jun784+tag@, corp addrs).
 {:db/ident :person/id              :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity :db/doc "canonical slug, e.g. \"nodoka\", \"mika\", \"takeshita-zelo\""}
 {:db/ident :person/emails          :db/valueType :db.type/string  :db/cardinality :db.cardinality/many :db/doc "all known addresses incl. relay aliases"}
 {:db/ident :person/relation        :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one  :db/doc ":self :family :co-parent :lawyer :accountant :counterparty :witness :vendor :friend :cold"}
 {:db/ident :person/attention-class :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one  :db/doc ":family :legal-deadline :money-anomaly :business :vendor-routine :cold-inbound (ADR-0010 L4)"}
 {:db/ident :person/canonical       :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one  :db/doc "alias person-entity -> canonical person (entity resolution)"}
 {:db/ident :person/note            :db/valueType :db.type/string  :db/cardinality :db.cardinality/one  :db/doc "curated context (people.edn)"}

 ;; ---------- dyad (relational power edge: self <-> person; ADR-0012) ----------
 {:db/ident :dyad/id               :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity :db/doc "e.g. \"jun~takeshita-zelo\""}
 {:db/ident :dyad/with             :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one :db/doc "dyad -> person (the other party)"}
 {:db/ident :dyad/self-dependence  :db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "0..1 自分→相手の依存 (代替不能性×重要度×時間切迫)"}
 {:db/ident :dyad/their-dependence :db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "0..1 相手→自分の依存"}
 {:db/ident :dyad/power-bases      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/many :db/doc "French&Raven: :expert :legitimate :reward :coercive :referent :informational"}
 {:db/ident :dyad/incentive        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "相手の報酬構造"}
 {:db/ident :dyad/alignment        :db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "-1..1 利害一致度 (報酬構造から導出)"}
 {:db/ident :dyad/info-asymmetry   :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":they-hold :we-hold :balanced"}
 {:db/ident :dyad/switching-cost   :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":low :mid :high :prohibitive"}
 {:db/ident :dyad/worst-case       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "関係最悪化時に起こること (minimax 入力)"}
 {:db/ident :dyad/lever            :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "非対称を是正する手 (家族辺は『信頼への投資』のみ)"}
 {:db/ident :dyad/note             :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}

 ;; ---------- hypothesis (falsifiable latent; ADR-0012) ----------
 {:db/ident :hypothesis/id         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :hypothesis/about      :db/valueType :db.type/ref     :db/cardinality :db.cardinality/many :db/doc "hypothesis -> person/dyad/case"}
 {:db/ident :hypothesis/text       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :hypothesis/confidence :db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "0..1 主観確信度"}
 {:db/ident :hypothesis/evidence   :db/valueType :db.type/ref     :db/cardinality :db.cardinality/many :db/doc "hypothesis -> email/blob"}
 {:db/ident :hypothesis/falsifier  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "何を観測すれば棄却されるか (情報利得アジェンダ)"}
 {:db/ident :hypothesis/status     :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":open :supported :refuted"}

 ;; ---------- engi (縁の手放し評価; ADR-0013) ----------
 {:db/ident :engi/id              :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :engi/target          :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "human label of the tie (service/account/person/domain)"}
 {:db/ident :engi/target-kind     :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":subscription :account :service :person :org :domain :corp"}
 {:db/ident :engi/person          :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one :db/doc "optional ref when target is a person"}
 {:db/ident :engi/decision        :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":keep :reduce :transfer :archive :sever :hold (ADR-0013)"}
 {:db/ident :engi/reason          :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :engi/legal-hold      :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one :db/doc "true = ADR-0005 係争保全、係争終結まで操作禁止"}
 {:db/ident :engi/monthly-cost-jpy :db/valueType :db.type/long   :db/cardinality :db.cardinality/one :db/doc "推定月額 (要実測は reason に明記)"}
 {:db/ident :engi/export-first    :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one :db/doc "sever/archive 前に warehouse 保全が必要"}
 {:db/ident :engi/status          :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":proposed :approved :sent (解約メール送信済) :done"}
 {:db/ident :engi/cancel-channel  :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":email (既定) :unsubscribe-link :web-only (メール不可と判明したもののみ) :phone"}
 {:db/ident :engi/cancel-email    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "解約依頼の宛先 (サポート/担当者)"}

 ;; ---------- prov (minimal embedded provenance; full detail in personal/prov/*.prov.jsonld) ----------
 {:db/ident :prov/derived-from :db/valueType :db.type/ref     :db/cardinality :db.cardinality/many :db/doc "fact -> source entity (email/blob/decision)"}
 {:db/ident :prov/activity     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one  :db/doc "e.g. \"mail-sync.sh@2026-06-11\", \"claude-extract/adr-0010\""}
 {:db/ident :prov/agent        :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one  :db/doc ":jun :launchd :claude :manimani"}]
