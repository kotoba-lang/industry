;; schema-facebook.edn — Facebook DYI export entities (ADR-0010 索引層).
;; 正本は personal/social/facebook/<acct>/<date>/export/** (git-annex → B2 暗号化)。
;; 索引 JSONL は同 .../index/*.jsonl。本スキーマは warehouse.load が再構築する
;; クエリ可能な正規化グラフ。fb* 名前空間で既存 person グラフと name 一致で連携。
[;; ---------- person 拡張: FB 表示名エイリアス (sender/friend → person 解決用) ----------
 {:db/ident :person/fb-name :db/valueType :db.type/string :db/cardinality :db.cardinality/many :db/doc "Facebook 表示名 (people.edn の curated alias)"}

 ;; ---------- fbprofile: プロフィール field/value ----------
 {:db/ident :fbprofile/id      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :fbprofile/account :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :fbprofile/field   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :fbprofile/value   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}

 ;; ---------- fbfriend: 友達/フォロワー/リクエスト ----------
 {:db/ident :fbfriend/id      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :fbfriend/account :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :fbfriend/name    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :fbfriend/rel     :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":friend :follower :following :request-received :request-rejected :post-audience"}
 {:db/ident :fbfriend/ts      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "つながり確定時刻 (YYYY-MM-DD HH:MM:SS)"}
 {:db/ident :fbfriend/person  :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one :db/doc "name 一致で people.edn の person に解決した場合"}

 ;; ---------- fbthread: メッセージスレッド ----------
 {:db/ident :fbthread/id            :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :fbthread/account       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :fbthread/box           :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":inbox :e2ee_cutover 等 (取込元フォルダ)"}
 {:db/ident :fbthread/title         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :fbthread/participants  :db/valueType :db.type/string  :db/cardinality :db.cardinality/many :db/doc "参加者名 (生文字列)"}
 {:db/ident :fbthread/message-count :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :fbthread/from          :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :fbthread/to            :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :fbthread/path          :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "倉庫内の正本HTMLパス"}

 ;; ---------- fbmsg: 個々のメッセージ (本文込) ----------
 {:db/ident :fbmsg/id     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :fbmsg/thread :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one :db/doc "-> fbthread"}
 {:db/ident :fbmsg/sender :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :fbmsg/person :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one :db/doc "sender を people.edn に解決した場合"}
 {:db/ident :fbmsg/text   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/fulltext true}
 {:db/ident :fbmsg/ts     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :fbmsg/media  :db/valueType :db.type/long    :db/cardinality :db.cardinality/one :db/doc "添付メディア数"}
 {:db/ident :fbmsg/box    :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":inbox :e2ee_cutover 等"}

 ;; ---------- fbpost: 投稿/シェア ----------
 {:db/ident :fbpost/id    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :fbpost/account :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :fbpost/ts    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :fbpost/text  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/fulltext true}
 {:db/ident :fbpost/links :db/valueType :db.type/string  :db/cardinality :db.cardinality/many}
 {:db/ident :fbpost/file  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}

 ;; ---------- fbact: 汎用アクティビティ (groups/events/pages/comments/...) ----------
 {:db/ident :fbact/id       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :fbact/account  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :fbact/category :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :fbact/ts       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :fbact/name     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :fbact/text     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :fbact/file     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}]
